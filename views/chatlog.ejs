<!doctype html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Messages | Blogify</title>
  <style>
    :root{--bg:#000;--surface:#000;--soft:#121212;--soft2:#1c1c1c;--text:#fff;--muted:#a8a8a8;--line:#262626;--blue:#0095f6;--green:#20b15a}
    *{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:var(--bg);color:var(--text)}body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased}button,input{font:inherit}
    .dm-page{min-height:100dvh;padding:0;background:#000}.dm-shell{width:100%;min-height:100dvh;margin:auto;background:#000;display:flex;flex-direction:column}
    .dm-header{position:sticky;top:0;z-index:20;background:rgba(0,0,0,.96);backdrop-filter:blur(18px);border-bottom:1px solid var(--line);padding:16px 18px 12px}.dm-title-row{display:flex;align-items:center;justify-content:space-between;gap:12px}.dm-title{margin:0;font-size:24px;font-weight:700;letter-spacing:-.4px}.dm-count{font-size:11px;color:var(--muted)}
    .dm-search-wrap{position:relative;margin-top:13px}.dm-search-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#8e8e8e;font-size:13px}.dm-search{width:100%;height:42px;border:0;outline:0;border-radius:10px;background:#262626;color:#fff;padding:0 14px 0 39px;font-size:14px}.dm-search::placeholder{color:#8e8e8e}.dm-search:focus{background:#2b2b2b;box-shadow:0 0 0 1px #3a3a3a}
    .dm-list{padding:4px 0 30px;overflow-y:auto;flex:1}.dm-row{width:100%;display:flex;align-items:center;gap:13px;padding:11px 16px;border:0;border-bottom:1px solid #111;background:#000;color:#fff;text-align:left;cursor:pointer;transition:background .12s}.dm-row:hover{background:#121212}.dm-row:active{background:#1b1b1b}
    .dm-avatar-wrap{position:relative;flex:none}.dm-avatar{width:56px;height:56px;border-radius:50%;object-fit:cover;background:#262626;display:block}.dm-online{position:absolute;right:1px;bottom:1px;width:14px;height:14px;border:2px solid #000;border-radius:50%;background:var(--green)}.dm-body{min-width:0;flex:1}.dm-top{display:flex;align-items:center;gap:8px;min-width:0}.dm-name{font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dm-time{margin-left:auto;color:#737373;font-size:11px;white-space:nowrap}.dm-preview{display:block;margin-top:4px;color:#a8a8a8;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dm-preview.unread{color:#fff;font-weight:600}.dm-unread{min-width:18px;height:18px;padding:0 5px;border-radius:99px;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:9px;font-weight:700;flex:none}.dm-empty{text-align:center;color:var(--muted);padding:100px 20px}.dm-empty i{display:block;font-size:38px;margin-bottom:14px;color:#fff}.dm-new{display:inline-flex;align-items:center;gap:7px;border:0;background:var(--blue);color:#fff;border-radius:8px;padding:9px 14px;font-weight:700;cursor:pointer;margin-top:14px}.dm-new:active{transform:scale(.98)}
    .share-overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);display:none;place-items:end center;z-index:100}.share-overlay.open{display:grid}.share-sheet{width:min(540px,100%);max-height:82dvh;overflow:auto;background:#121212;color:#fff;border:1px solid #262626;border-radius:18px 18px 0 0;padding:10px 16px max(16px,env(safe-area-inset-bottom));box-shadow:0 -10px 50px rgba(0,0,0,.5)}.sheet-handle{width:40px;height:4px;border-radius:99px;background:#555;margin:2px auto 15px}.sheet-head{display:flex;align-items:center;justify-content:space-between}.sheet-head h2{font-size:18px;margin:0}.sheet-close{border:0;background:transparent;color:#fff;font-size:25px;cursor:pointer}.share-row{display:flex;align-items:center;gap:11px;padding:11px 2px;border-bottom:1px solid #262626}.share-row img{width:48px;height:48px;border-radius:50%;object-fit:cover}.share-info{flex:1;min-width:0}.share-info strong{display:block;font-size:14px}.share-info small{color:var(--muted);font-size:11px}.share-send{border:0;background:var(--blue);color:#fff;border-radius:8px;padding:8px 13px;font-weight:700;cursor:pointer}.share-send:disabled{opacity:.55}
    @media(max-width:600px){.dm-page{min-height:calc(100dvh - 56px);padding-top:56px}.dm-shell{min-height:calc(100dvh - 56px)}.dm-header{padding:11px 14px 10px}.dm-title{font-size:22px}.dm-row{padding:9px 14px;gap:12px}.dm-avatar{width:56px;height:56px}.dm-preview{font-size:12.5px}}
    @media(min-width:601px) and (max-width:899px){.dm-page{padding:64px 18px 20px;background:#080808}.dm-shell{min-height:calc(100dvh - 84px);border:1px solid var(--line);border-radius:14px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.35)}}
    @media(min-width:900px){.dm-page{padding:70px 24px 30px;background:#080808}.dm-shell{min-height:calc(100dvh - 100px);width:min(760px,100%);border:1px solid var(--line);border-radius:14px;overflow:hidden;box-shadow:0 10px 40px rgba(0,0,0,.4)}.dm-header{padding-left:18px;padding-right:18px}.dm-row{padding-left:18px;padding-right:18px}}
  </style>
</head>
<body>
  <%- include('./partials/nave') %>
  <main class="dm-page"><section class="dm-shell">
    <header class="dm-header"><div class="dm-title-row"><h1 class="dm-title">Messages</h1><span id="count" class="dm-count">Loading…</span></div><div class="dm-search-wrap"><i class="fas fa-search dm-search-icon"></i><input id="search" class="dm-search" placeholder="Search" autocomplete="off" aria-label="Search messages"></div></header>
    <section id="logs" class="dm-list"><div class="dm-empty">Loading messages…</div></section>
  </section></main>
  <div class="share-overlay" id="shareModal"><div class="share-sheet"><div class="sheet-handle"></div><div class="sheet-head"><h2>Share profile</h2><button class="sheet-close" onclick="closeShare()">×</button></div><p style="color:var(--muted);font-size:13px">Choose a conversation.</p><div id="shareList"></div></div></div>
  <%- include('./partials/scripts') %><script src="/socket.io/socket.io.js"></script>
  <script>
    const CURRENT='<%=user._id%>',SHARE_ID='<%=typeof queryShare!=="undefined"&&queryShare?queryShare:""%>';let chats=[];const logs=document.getElementById('logs'),search=document.getElementById('search'),count=document.getElementById('count');const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));const other=c=>(c.participants||[]).find(p=>String(p._id)!==String(CURRENT))||c.participants?.[0];const img=v=>v&&String(v).trim()?String(v):'/imgs/default.png';
    function time(v){if(!v)return'';const d=new Date(v),n=new Date();return d.toDateString()===n.toDateString()?d.toLocaleTimeString([],{hour:'numeric',minute:'2-digit'}):d.toLocaleDateString([],{day:'numeric',month:'short'})}function preview(c){const m=c.lastMessage||{};if(m.deleted)return'Message unsent';if(m.mediaType==='audio')return'🎙️ Voice message';if(m.mediaType==='video')return'🎥 Video';if(m.mediaType==='image')return'📷 Photo';if(m.mediaType==='profile')return'👤 Shared profile';return m.text||'No messages yet'}
    function render(){const q=search.value.trim().toLowerCase();const rows=chats.filter(c=>{const o=other(c),m=c.lastMessage||{};return o&&(!q||(o.fullName||'').toLowerCase().includes(q)||(m.text||'').toLowerCase().includes(q))});count.textContent=rows.length+(rows.length===1?' conversation':' conversations');logs.innerHTML=rows.length?rows.map(c=>{const o=other(c),unread=Number(c.unreadCount||0);return `<button class="dm-row" data-user="${esc(o?._id||'')}"><span class="dm-avatar-wrap"><img class="dm-avatar" src="${esc(img(o?.profileImageURL))}" onerror="this.src='/imgs/default.png'" alt="${esc(o?.fullName||'User')}"><span class="dm-online" hidden></span></span><span class="dm-body"><span class="dm-top"><span class="dm-name">${esc(o?.fullName||'User')}</span><span class="dm-time">${time(c.lastMessageAt||c.lastMessage?.createdAt)}</span></span><span class="dm-preview ${unread?'unread':''}">${esc(preview(c))}</span></span>${unread?`<span class="dm-unread">${unread>99?'99+':unread}</span>`:''}</button>`}).join(''):'<div class="dm-empty"><i class="far fa-paper-plane"></i><div>'+(q?'No matching conversations.':'No messages yet.')+'</div></div>';logs.querySelectorAll('.dm-row').forEach(row=>row.onclick=()=>location.href='/messages?user='+encodeURIComponent(row.dataset.user))}
    async function load(){try{const r=await fetch('/messages/history',{credentials:'same-origin',headers:{Accept:'application/json'}}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to load messages');chats=d.conversations||[];render();if(SHARE_ID)openShare()}catch(e){logs.innerHTML='<div class="dm-empty">Unable to load messages.<br><button class="dm-new" onclick="load()">Try again</button></div>'}}
    async function openShare(){document.getElementById('shareModal').classList.add('open');const list=document.getElementById('shareList');list.innerHTML='';if(!chats.length){list.innerHTML='<div class="dm-empty">No conversations available.</div>';return}chats.forEach(c=>{const o=other(c);if(!o)return;const row=document.createElement('div');row.className='share-row';row.innerHTML=`<img src="${esc(img(o.profileImageURL))}" onerror="this.src='/imgs/default.png'" alt=""><span class="share-info"><strong>${esc(o.fullName||'User')}</strong><small>Send profile to this chat</small></span><button class="share-send">Send</button>`;row.querySelector('button').onclick=async()=>{const b=row.querySelector('button');b.disabled=true;b.textContent='Sending…';try{const r=await fetch('/messages/share-profile',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},credentials:'same-origin',body:JSON.stringify({recipientId:o._id,profileId:SHARE_ID})}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to share profile');b.textContent='Sent ✓';setTimeout(()=>location.href='/messages?user='+encodeURIComponent(o._id),450)}catch(e){b.disabled=false;b.textContent='Send';alert(e.message)}};list.appendChild(row)})}function closeShare(){document.getElementById('shareModal').classList.remove('open');if(SHARE_ID)history.replaceState({},'',location.pathname)}search.oninput=render;load();try{io({withCredentials:true}).on('message:new',load)}catch(e){}
  </script>
</body>
</html>
