<!doctype html><html lang="en"><head><%- include('./partials/head') %><title>Messages | Blogify</title><style>:root{--bg:#f4f6fb;--card:#fff;--text:#172033;--muted:#7b8498;--line:#e5e9f1;--soft:#f0f2f7;--brand:#635bff;--shadow:0 18px 50px rgba(20,28,45,.09)}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}.page{max-width:780px;margin:auto;padding:84px 12px 28px}.shell{background:var(--card);border:1px solid var(--line);border-radius:24px;overflow:hidden;box-shadow:var(--shadow)}.topbar{padding:18px;border-bottom:1px solid var(--line)}.title-row{display:flex;align-items:center;justify-content:space-between}.title{font-size:1.45rem;font-weight:900;margin:0}.count{font-size:.72rem;color:var(--muted)}.search{width:100%;margin-top:14px;padding:12px 14px;border:1px solid var(--line);border-radius:15px;background:var(--soft);color:var(--text);outline:0;font:inherit}.logs{min-height:220px}.chat{display:flex;align-items:center;gap:12px;padding:14px 16px;border:0;border-bottom:1px solid var(--line);background:var(--card);color:var(--text);width:100%;text-align:left;cursor:pointer}.chat:hover{background:var(--soft)}.avatar{width:56px;height:56px;border-radius:50%;object-fit:cover;background:#ddd}.body{min-width:0;flex:1}.top{display:flex;align-items:center;gap:10px}.name{font-weight:850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.time{margin-left:auto;font-size:.67rem;color:var(--muted)}.preview{display:block;color:var(--muted);font-size:.8rem;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.badge{min-width:22px;height:22px;border-radius:99px;background:var(--brand);color:#fff;display:grid;place-items:center;font-size:.68rem;font-weight:800}.empty{text-align:center;color:var(--muted);padding:70px 20px}.modal{position:fixed;inset:0;background:rgba(0,0,0,.52);display:none;place-items:center;padding:18px;z-index:90}.modal.open{display:grid}.modal-card{width:min(520px,100%);max-height:80vh;overflow:auto;background:var(--card);color:var(--text);border-radius:22px;padding:20px}.modal-head{display:flex;justify-content:space-between;align-items:center}.close{border:0;background:transparent;font-size:1.4rem;cursor:pointer}.share-row{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--line);border-radius:15px;margin-top:9px}.share-row img{width:48px;height:48px;border-radius:50%;object-fit:cover}.share-row .info{flex:1;min-width:0}.share-row strong{display:block}.share-row small{color:var(--muted)}.send{border:0;border-radius:10px;padding:9px 13px;background:var(--brand);color:#fff;font-weight:800;cursor:pointer}.send:disabled{opacity:.55}@media(max-width:600px){.page{padding:70px 7px 16px}.shell{border-radius:18px}.chat{padding:13px 12px}.avatar{width:52px;height:52px}}</style></head><body><%- include('./partials/nave') %><main class="page"><section class="shell"><header class="topbar"><div class="title-row"><h1 class="title">Messages</h1><span id="count" class="count">Loading…</span></div><input id="search" class="search" placeholder="Search conversations" autocomplete="off"></header><section id="logs" class="logs"><div class="empty">Loading conversations…</div></section></section></main><div class="modal" id="shareModal"><div class="modal-card"><div class="modal-head"><h2>Share profile</h2><button class="close" onclick="closeShare()">×</button></div><p style="color:var(--muted)">Choose a conversation to send this profile to.</p><div id="shareList">Loading…</div></div></div><%- include('./partials/scripts') %><script src="/socket.io/socket.io.js"></script><script>const CURRENT='<%=user._id%>',SHARE_ID='<%=typeof queryShare!=='undefined'&&queryShare?queryShare:''%>';let chats=[];const logs=document.getElementById('logs'),search=document.getElementById('search'),count=document.getElementById('count');function esc(v){const d=document.createElement('div');d.textContent=v??'';return d.innerHTML}function other(c){return(c.participants||[]).find(p=>String(p._id)!==String(CURRENT))||c.participants?.[0]}function time(v){if(!v)return'';const d=new Date(v),n=new Date();return d.toDateString()===n.toDateString()?d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}):d.toLocaleDateString([],{day:'numeric',month:'short'})}function preview(c){const m=c.lastMessage||{};if(m.mediaType==='video')return'🎥 Video';if(m.mediaType==='image')return'📷 Photo';if(m.mediaType==='profile')return'👤 Shared profile';return m.text||'No messages yet'}function render(){const q=search.value.trim().toLowerCase();const rows=chats.filter(c=>{const o=other(c),m=c.lastMessage||{};return o&&(!q||(o.fullName||'').toLowerCase().includes(q)||(m.text||'').toLowerCase().includes(q))});count.textContent=rows.length+(rows.length===1?' conversation':' conversations');logs.innerHTML=rows.length?rows.map(c=>{const o=other(c),unread=Number(c.unreadCount||0);return `<div class="chat" data-user="${esc(o?._id||'')}"><img class="avatar" src="${esc(o?.profileImageURL||'/imgs/default.png')}" onerror="this.src='/imgs/default.png'"><span class="body"><span class="top"><span class="name">${esc(o?.fullName||'User')}</span><span class="time">${time(c.lastMessageAt||c.lastMessage?.createdAt)}</span></span><span class="preview">${esc(preview(c))}</span></span>${unread?`<span class="badge">${unread>99?'99+':unread}</span>`:''}</div>`}).join(''):'<div class="empty">'+(q?'No matching conversations.':'No conversations yet.')+'</div>';logs.querySelectorAll('.chat').forEach(row=>row.onclick=()=>location.href='/messages?user='+encodeURIComponent(row.dataset.user))}async function load(){try{const r=await fetch('/messages/history',{credentials:'same-origin'}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to load chat history');chats=d.conversations||[];render();if(SHARE_ID)openShare()}catch(e){logs.innerHTML='<div class="empty">Unable to load chat history.<br><button onclick="load()">Try again</button></div>'}}async function openShare(){document.getElementById('shareModal').classList.add('open');const list=document.getElementById('shareList');list.innerHTML='';if(!chats.length){list.innerHTML='<div class="empty">No conversations available. Start a chat first.</div>';return}chats.forEach(c=>{const o=other(c);if(!o)return;const row=document.createElement('div');row.className='share-row';row.innerHTML=`<img src="${esc(o.profileImageURL||'/imgs/default.png')}" onerror="this.src='/imgs/default.png'"><span class="info"><strong>${esc(o.fullName||'User')}</strong><small>Send profile to this chat</small></span><button class="send">Send</button>`;row.querySelector('.send').onclick=async()=>{const b=row.querySelector('.send');b.disabled=true;b.textContent='Sending…';try{const r=await fetch('/messages/share-profile',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({recipientId:o._id,profileId:SHARE_ID})});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to share profile');b.textContent='Sent ✓';setTimeout(()=>location.href='/messages?user='+encodeURIComponent(o._id),500)}catch(e){b.disabled=false;b.textContent='Send';alert(e.message)}};list.appendChild(row)})}function closeShare(){document.getElementById('shareModal').classList.remove('open');if(SHARE_ID)history.replaceState({},'',location.pathname)}search.oninput=render;load();try{const socket=io({withCredentials:true});socket.on('message:new',load)}catch(e){} </script></body></html>