<!doctype html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Messages | Blogify</title>
  <style>
    :root{--bg:#fff;--text:#111;--muted:#737373;--line:#ededed;--soft:#f5f5f7;--brand:#635bff;--brand2:#7c3aed}
    *{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;background:var(--bg);color:var(--text)}body{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}button,input{font:inherit}
    .dm-page{min-height:calc(100dvh - 70px);padding:70px 0 0;background:#fff}.dm-shell{width:min(100%,860px);min-height:calc(100dvh - 70px);margin:auto;background:#fff}
    .dm-header{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.96);backdrop-filter:blur(18px);border-bottom:1px solid var(--line);padding:13px 18px 12px}.dm-title-row{display:flex;align-items:center;justify-content:space-between;gap:12px}.dm-title{margin:0;font-size:24px;font-weight:800;letter-spacing:-.6px}.dm-count{font-size:11px;color:var(--muted)}
    .dm-search-wrap{position:relative;margin-top:12px}.dm-search-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#999;font-size:13px}.dm-search{width:100%;height:42px;border:0;outline:0;border-radius:14px;background:var(--soft);padding:0 14px 0 39px;font-size:14px;transition:.15s}.dm-search:focus{background:#f0f0f3;box-shadow:0 0 0 3px rgba(99,91,255,.08)}
    .dm-list{padding:4px 0 34px}.dm-row{width:100%;display:flex;align-items:center;gap:13px;padding:10px 18px;border:0;border-bottom:1px solid #f4f4f4;background:#fff;text-align:left;cursor:pointer;transition:background .12s}.dm-row:hover{background:#fafafa}.dm-row:active{background:#f2f2f4}
    .dm-avatar-wrap{position:relative;flex:none}.dm-avatar{width:60px;height:60px;border-radius:50%;object-fit:cover;background:#eee;display:block}.dm-online{position:absolute;right:1px;bottom:2px;width:15px;height:15px;border:3px solid #fff;border-radius:50%;background:#31c45a}.dm-body{min-width:0;flex:1}.dm-top{display:flex;align-items:center;gap:8px;min-width:0}.dm-name{font-size:14px;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dm-time{margin-left:auto;color:#999;font-size:11px;white-space:nowrap}.dm-preview{display:block;margin-top:4px;color:#777;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dm-preview.unread{color:#111;font-weight:700}.dm-unread{min-width:20px;height:20px;padding:0 6px;border-radius:99px;background:var(--brand);color:#fff;display:grid;place-items:center;font-size:9px;font-weight:800;flex:none}.dm-empty{text-align:center;color:var(--muted);padding:100px 20px}.dm-empty i{display:block;font-size:36px;margin-bottom:14px;color:#c4c4c8}.dm-new{display:inline-flex;align-items:center;gap:7px;border:0;background:var(--brand);color:#fff;border-radius:12px;padding:10px 15px;font-weight:750;cursor:pointer;margin-top:14px}.dm-new:active{transform:scale(.98)}
    .share-overlay{position:fixed;inset:0;background:rgba(0,0,0,.42);display:none;place-items:end center;z-index:100}.share-overlay.open{display:grid}.share-sheet{width:min(540px,100%);max-height:82dvh;overflow:auto;background:#fff;border-radius:22px 22px 0 0;padding:10px 16px max(16px,env(safe-area-inset-bottom));box-shadow:0 -10px 50px rgba(0,0,0,.15)}.sheet-handle{width:40px;height:4px;border-radius:99px;background:#ddd;margin:2px auto 15px}.sheet-head{display:flex;align-items:center;justify-content:space-between}.sheet-head h2{font-size:18px;margin:0}.sheet-close{border:0;background:transparent;font-size:25px;cursor:pointer}.share-row{display:flex;align-items:center;gap:11px;padding:11px 2px;border-bottom:1px solid var(--line)}.share-row img{width:48px;height:48px;border-radius:50%;object-fit:cover}.share-info{flex:1;min-width:0}.share-info strong{display:block;font-size:14px}.share-info small{color:var(--muted);font-size:11px}.share-send{border:0;background:var(--brand);color:#fff;border-radius:10px;padding:8px 13px;font-weight:700;cursor:pointer}.share-send:disabled{opacity:.55}
    @media(max-width:600px){.dm-page{min-height:calc(100dvh - 56px);padding-top:56px}.dm-shell{min-height:calc(100dvh - 56px)}.dm-header{padding:11px 14px 10px}.dm-title{font-size:22px}.dm-row{padding:9px 14px;gap:12px}.dm-avatar{width:56px;height:56px}.dm-preview{font-size:12.5px}.dm-count{font-size:10px}}
    @media(min-width:601px) and (max-width:899px){.dm-page{padding:64px 18px 20px;background:#f7f7f8}.dm-shell{min-height:calc(100dvh - 84px);border:1px solid var(--line);border-radius:20px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.05)}}
    @media(min-width:900px){.dm-page{padding:84px 24px 30px;background:#f7f7f8}.dm-shell{min-height:calc(100dvh - 114px);border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:0 10px 40px rgba(0,0,0,.06)}.dm-header{padding-left:22px;padding-right:22px}.dm-row{padding-left:22px;padding-right:22px}.dm-avatar{width:58px;height:58px}}
    @media(min-width:1200px){.dm-shell{width:min(900px,100%)}}
  </style>
</head>
<body>
  <%- include('./partials/nave') %>
  <main class="dm-page">
    <section class="dm-shell">
      <header class="dm-header">
        <div class="dm-title-row"><h1 class="dm-title">Messages</h1><span id="count" class="dm-count">Loading…</span></div>
        <div class="dm-search-wrap"><i class="fas fa-search dm-search-icon"></i><input id="search" class="dm-search" placeholder="Search" autocomplete="off" aria-label="Search messages"></div>
      </header>
      <section id="logs" class="dm-list"><div class="dm-empty">Loading messages…</div></section>
    </section>
  </main>
  <div class="share-overlay" id="shareModal"><div class="share-sheet"><div class="sheet-handle"></div><div class="sheet-head"><h2>Share profile</h2><button class="sheet-close" onclick="closeShare()">×</button></div><p style="color:var(--muted);font-size:13px">Choose a conversation.</p><div id="shareList"></div></div></div>
  <%- include('./partials/scripts') %>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const CURRENT='<%=user._id%>',SHARE_ID='<%=typeof queryShare!=='undefined'&&queryShare?queryShare:''%>';
    let chats=[];const logs=document.getElementById('logs'),search=document.getElementById('search'),count=document.getElementById('count');
    const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
    const other=c=>(c.participants||[]).find(p=>String(p._id)!==String(CURRENT))||c.participants?.[0];
    const img=v=>v&&String(v).trim()?String(v):'/imgs/default.png';
    function time(v){if(!v)return'';const d=new Date(v),n=new Date();return d.toDateString()===n.toDateString()?d.toLocaleTimeString([],{hour:'numeric',minute:'2-digit'}):d.toLocaleDateString([],{day:'numeric',month:'short'})}
    function preview(c){const m=c.lastMessage||{};if(m.deleted)return'Message unsent';if(m.mediaType==='video')return'🎥 Video';if(m.mediaType==='image')return'📷 Photo';if(m.mediaType==='profile')return'👤 Shared profile';return m.text||'No messages yet'}
    function render(){const q=search.value.trim().toLowerCase();const rows=chats.filter(c=>{const o=other(c),m=c.lastMessage||{};return o&&(!q||(o.fullName||'').toLowerCase().includes(q)||(m.text||'').toLowerCase().includes(q))});count.textContent=rows.length+(rows.length===1?' conversation':' conversations');logs.innerHTML=rows.length?rows.map(c=>{const o=other(c),unread=Number(c.unreadCount||0);return `<button class="dm-row" data-user="${esc(o?._id||'')}"><span class="dm-avatar-wrap"><img class="dm-avatar" src="${esc(img(o?.profileImageURL))}" onerror="this.src='/imgs/default.png'"><span class="dm-online" hidden></span></span><span class="dm-body"><span class="dm-top"><span class="dm-name">${esc(o?.fullName||'User')}</span><span class="dm-time">${time(c.lastMessageAt||c.lastMessage?.createdAt)}</span></span><span class="dm-preview ${unread?'unread':''}">${esc(preview(c))}</span></span>${unread?`<span class="dm-unread">${unread>99?'99+':unread}</span>`:''}</button>`}).join(''):'<div class="dm-empty"><i class="far fa-paper-plane"></i><div>'+ (q?'No matching conversations.':'No messages yet.')+'</div></div>';logs.querySelectorAll('.dm-row').forEach(row=>row.onclick=()=>location.href='/messages?user='+encodeURIComponent(row.dataset.user))}
    async function load(){try{const r=await fetch('/messages/history',{credentials:'same-origin',headers:{Accept:'application/json'}}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to load messages');chats=d.conversations||[];render();if(SHARE_ID)openShare()}catch(e){logs.innerHTML='<div class="dm-empty">Unable to load messages.<br><button class="dm-new" onclick="load()">Try again</button></div>'}}
    async function openShare(){document.getElementById('shareModal').classList.add('open');const list=document.getElementById('shareList');list.innerHTML='';if(!chats.length){list.innerHTML='<div class="dm-empty">No conversations available.</div>';return}chats.forEach(c=>{const o=other(c);if(!o)return;const row=document.createElement('div');row.className='share-row';row.innerHTML=`<img src="${esc(img(o.profileImageURL))}" onerror="this.src='/imgs/default.png'"><span class="share-info"><strong>${esc(o.fullName||'User')}</strong><small>Send profile to this chat</small></span><button class="share-send">Send</button>`;row.querySelector('button').onclick=async()=>{const b=row.querySelector('button');b.disabled=true;b.textContent='Sending…';try{const r=await fetch('/messages/share-profile',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},credentials:'same-origin',body:JSON.stringify({recipientId:o._id,profileId:SHARE_ID})}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to share profile');b.textContent='Sent ✓';setTimeout(()=>location.href='/messages?user='+encodeURIComponent(o._id),450)}catch(e){b.disabled=false;b.textContent='Send';alert(e.message)}};list.appendChild(row)})}
    function closeShare(){document.getElementById('shareModal').classList.remove('open');if(SHARE_ID)history.replaceState({},'',location.pathname)}
    search.oninput=render;load();try{io({withCredentials:true}).on('message:new',load)}catch(e){}
  </script>
</body>
</html>
