<!doctype html><html lang="en"><head><%- include('./partials/head') %><title>Chats | Blogify</title><style>
:root{--bg:#f5f7fb;--card:#fff;--text:#182033;--muted:#758097;--line:#e7ebf2;--soft:#f0f2f7;--brand:#635bff;--danger:#ef4444}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}.chatlog{max-width:760px;margin:0 auto;padding:92px 14px 30px}.head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}.head h1{margin:0;font-size:1.45rem}.search{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:13px;background:var(--soft);color:var(--text);outline:0;margin-bottom:12px}.search:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(99,91,255,.1)}.logs{background:var(--card);border:1px solid var(--line);border-radius:20px;overflow:hidden}.chat{display:flex;align-items:center;gap:13px;padding:14px 16px;border:0;border-bottom:1px solid var(--line);background:var(--card);color:var(--text);width:100%;text-align:left;cursor:pointer}.chat:last-child{border-bottom:0}.chat:hover{background:var(--soft)}.avatar{width:54px;height:54px;border-radius:50%;object-fit:cover;background:#ddd;flex:none}.body{min-width:0;flex:1}.top{display:flex;justify-content:space-between;gap:10px}.name{font-weight:850}.time{font-size:.68rem;color:var(--muted);white-space:nowrap}.preview{margin-top:5px;color:var(--muted);font-size:.8rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.badge{min-width:21px;height:21px;padding:0 6px;border-radius:99px;background:var(--brand);color:#fff;display:grid;place-items:center;font-size:.68rem;font-weight:800}.empty{text-align:center;color:var(--muted);padding:65px 20px}.new{border:0;background:var(--brand);color:#fff;border-radius:11px;padding:10px 14px;font-weight:800;text-decoration:none}@media(max-width:600px){.chatlog{padding:76px 9px 20px}.chat{padding:13px}.avatar{width:50px;height:50px}}
</style></head><body><%- include('./partials/nave') %><main class="chatlog"><div class="head"><h1>Messages</h1></div><input class="search" id="search" placeholder="Search chats..." autocomplete="off"><section class="logs" id="logs"><div class="empty">Loading chats...</div></section></main><%- include('./partials/scripts') %><script>
const CURRENT='<%= user._id %>';let chats=[];const logs=document.getElementById('logs'),search=document.getElementById('search');function esc(v){const d=document.createElement('div');d.textContent=v??'';return d.innerHTML}function other(c){return(c.participants||[]).find(p=>String(p._id)!==String(CURRENT))||c.participants?.[0]}function time(v){if(!v)return'';const d=new Date(v),n=new Date();return d.toDateString()===n.toDateString()?d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}):d.toLocaleDateString([],{day:'numeric',month:'short'})}function render(){const q=search.value.trim().toLowerCase();const rows=chats.filter(c=>{const o=other(c);return !q||(o?.fullName||'').toLowerCase().includes(q)||(c.lastMessage?.text||'').toLowerCase().includes(q)});logs.innerHTML=rows.length?rows.map(c=>{const o=other(c),u=encodeURIComponent(o?._id||'');return `<button class="chat" data-user="${u}"><img class="avatar" src="${esc(o?.profileImageURL||'/imgs/default.png')}" onerror="this.src='/imgs/default.png'"><span class="body"><span class="top"><span class="name">${esc(o?.fullName||'User')}</span><span class="time">${time(c.lastMessageAt||c.updatedAt)}</span></span><span class="preview">${esc(c.lastMessage?.text||'No messages yet')}</span></span>${c.unreadCount?`<span class="badge">${c.unreadCount>99?'99+':c.unreadCount}</span>`:''}</button>`}).join(''):'<div class="empty"><i class="fas fa-comments" style="font-size:2.5rem;color:var(--brand)"></i><p>No conversations yet.</p></div>';logs.querySelectorAll('.chat').forEach(b=>b.onclick=()=>location.href='/messages?user='+b.dataset.user)}async function load(){try{const r=await fetch('/messages',{credentials:'same-origin'}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to load chats');chats=d.conversations||[];render()}catch(e){logs.innerHTML='<div class="empty">Unable to load messages.</div>'}}search.oninput=render;load();setInterval(load,10000);</script></body></html>