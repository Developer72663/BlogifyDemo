<!doctype html><html lang="en"><head><%- include('./partials/head') %><title>Messages | Blogify</title><style>:root{--bg:#f4f6fb;--card:#fff;--text:#172033;--muted:#7b8498;--line:#e5e9f1;--soft:#f0f2f7;--brand:#635bff;--shadow:0 18px 50px rgba(20,28,45,.09)}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}.page{max-width:780px;margin:auto;padding:84px 12px 28px}.shell{background:var(--card);border:1px solid var(--line);border-radius:24px;overflow:hidden;box-shadow:var(--shadow)}.topbar{padding:18px 18px 12px;border-bottom:1px solid var(--line);background:var(--card)}.title-row{display:flex;align-items:center;justify-content:space-between;gap:12px}.title{font-size:1.45rem;font-weight:900;margin:0}.count{font-size:.72rem;color:var(--muted)}.search-wrap{margin-top:14px;position:relative}.search{width:100%;padding:12px 14px 12px 40px;border:1px solid var(--line);border-radius:15px;background:var(--soft);color:var(--text);outline:0;font:inherit}.search:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(99,91,255,.1)}.search-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted)}.logs{min-height:220px}.chat{display:flex;align-items:center;gap:12px;padding:14px 16px;border:0;border-bottom:1px solid var(--line);background:var(--card);color:var(--text);width:100%;text-align:left;cursor:pointer;transition:.15s}.chat:hover{background:var(--soft)}.chat:last-child{border-bottom:0}.avatar-wrap{position:relative;flex:none}.avatar{width:56px;height:56px;border-radius:50%;object-fit:cover;background:#ddd}.dot{position:absolute;right:1px;bottom:1px;width:13px;height:13px;border:3px solid var(--card);border-radius:50%;background:#20b477}.body{min-width:0;flex:1}.top{display:flex;align-items:center;gap:10px}.name{font-weight:850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.time{margin-left:auto;font-size:.67rem;color:var(--muted);white-space:nowrap}.preview-row{display:flex;align-items:center;gap:6px;margin-top:5px;min-width:0}.preview{color:var(--muted);font-size:.8rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.unread .preview{color:var(--text);font-weight:750}.media-icon{font-size:.72rem;color:var(--brand);flex:none}.badge{min-width:22px;height:22px;padding:0 6px;border-radius:99px;background:var(--brand);color:#fff;display:grid;place-items:center;font-size:.68rem;font-weight:800;flex:none}.arrow{color:var(--muted);font-size:.8rem;margin-left:2px}.empty{text-align:center;color:var(--muted);padding:70px 20px}.empty i{font-size:2.7rem;color:var(--brand);margin-bottom:10px}.retry{border:0;border-radius:11px;padding:9px 14px;background:var(--brand);color:#fff;font-weight:800;cursor:pointer;margin-top:10px}.compose{border:0;background:var(--brand);color:#fff;border-radius:12px;padding:9px 12px;font-weight:800;cursor:pointer}.reply{display:none}@media(max-width:600px){.page{padding:70px 7px 16px}.shell{border-radius:18px}.topbar{padding:16px 13px 11px}.chat{padding:13px 12px}.avatar{width:52px;height:52px}.time{font-size:.62rem}.preview{font-size:.76rem}.arrow{display:none}}</style></head><body><%- include('./partials/nave') %><main class="page"><section class="shell"><header class="topbar"><div class="title-row"><h1 class="title">Messages</h1><span id="count" class="count">Loading…</span></div><div class="search-wrap"><i class="fas fa-search search-icon"></i><input id="search" class="search" placeholder="Search conversations" autocomplete="off"></div></header><section id="logs" class="logs"><div class="empty"><i class="fas fa-spinner fa-spin"></i><div>Loading conversations…</div></div></section></section></main><%- include('./partials/scripts') %><script src="/socket.io/socket.io.js"></script><script>const CURRENT='<%= user._id %>';let chats=[];let socket=null;const logs=document.getElementById('logs'),search=document.getElementById('search'),count=document.getElementById('count');function esc(v){const d=document.createElement('div');d.textContent=v??'';return d.innerHTML}function other(c){return(c.participants||[]).find(p=>String(p._id)!==String(CURRENT))||c.participants?.[0]}function time(v){if(!v)return'';const d=new Date(v),n=new Date();if(d.toDateString()===n.toDateString())return d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});return d.toLocaleDateString([],{day:'numeric',month:'short'})}function preview(c){const m=c.lastMessage||{};if(m.mediaType==='video')return '<i class="fas fa-video media-icon"></i> Video';if(m.mediaType==='image')return '<i class="fas fa-image media-icon"></i> Photo';return esc(m.text||'No messages yet')}function render(){const q=search.value.trim().toLowerCase();const rows=chats.filter(c=>{const o=other(c),m=c.lastMessage||{};return o&&(!q||(o.fullName||'').toLowerCase().includes(q)||(m.text||'').toLowerCase().includes(q))});count.textContent=rows.length+(rows.length===1?' conversation':' conversations');logs.innerHTML=rows.length?rows.map(c=>{const o=other(c),u=encodeURIComponent(o?._id||''),unread=Number(c.unreadCount||0);return `<div class="chat ${unread?'unread':''}" data-user="${u}" tabindex="0" role="button"><span class="avatar-wrap"><img class="avatar" src="${esc(o?.profileImageURL||'/imgs/default.png')}" onerror="this.src='/imgs/default.png'">${unread?'<span class="dot"></span>':''}</span><span class="body"><span class="top"><span class="name">${esc(o?.fullName||'User')}</span><span class="time">${time(c.lastMessageAt||c.lastMessage?.createdAt)}</span></span><span class="preview-row"><span class="preview">${preview(c)}</span></span></span>${unread?`<span class="badge">${unread>99?'99+':unread}</span>`:''}<i class="fas fa-chevron-right arrow"></i></div>`}).join(''):'<div class="empty"><i class="fas fa-comments"></i><div>'+ (q?'No matching conversations.':'No conversations yet.')+'</div></div>';logs.querySelectorAll('.chat').forEach(row=>{const open=()=>{if(row.dataset.user)location.href='/messages?user='+row.dataset.user};row.onclick=open;row.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open()}}})}async function load(){try{const r=await fetch('/messages/history',{credentials:'same-origin',headers:{Accept:'application/json'}}),d=await r.json().catch(()=>({}));if(!r.ok||!d.success)throw new Error(d.message||'Unable to load chat history');chats=Array.isArray(d.conversations)?d.conversations:[];render()}catch(e){console.error(e);count.textContent='';logs.innerHTML='<div class="empty"><i class="fas fa-exclamation-circle"></i><div>Unable to load chat history.</div><small>'+esc(e.message||'Please try again.')+'</small><br><button class="retry" onclick="load()">Try again</button></div>'}}search.oninput=render;load();setInterval(load,7000);try{socket=io({withCredentials:true});socket.on('message:new',()=>load())}catch(e){console.warn(e)}</script></body></html>