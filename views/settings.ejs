<!DOCTYPE html><html lang="en"><head><%- include("./partials/head") %><title>Settings | Blogify</title><style>.settings-shell{max-width:1180px;margin:auto;padding:42px 18px 70px}.settings-hero{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:26px}.settings-hero h1{font-size:clamp(2rem,4vw,3rem);font-weight:850;letter-spacing:-.05em;margin:0}.settings-hero p{margin:7px 0 0;color:var(--muted)}.settings-layout{display:grid;grid-template-columns:250px minmax(0,1fr);gap:20px}.settings-nav{position:sticky;top:80px;height:max-content;padding:10px;background:var(--surface);border:1px solid var(--border);border-radius:20px}.settings-nav button{width:100%;border:0;background:transparent;color:var(--muted);padding:12px 14px;border-radius:12px;text-align:left;font-weight:700;display:flex;align-items:center;gap:12px}.settings-nav button:hover,.settings-nav button.active{background:var(--soft);color:var(--primary)}.settings-nav i{width:20px;text-align:center}.settings-panel{background:var(--surface);border:1px solid var(--border);border-radius:22px;padding:30px;min-height:650px}.settings-section{display:none}.settings-section.active{display:block}.section-head{padding-bottom:20px;margin-bottom:22px;border-bottom:1px solid var(--border)}.section-head h2{font-size:1.45rem;font-weight:800;margin:0 0 5px}.section-head p{color:var(--muted);margin:0}.setting-row{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:17px 0;border-bottom:1px solid var(--border)}.setting-copy strong{display:block;font-weight:750}.setting-copy span{display:block;color:var(--muted);font-size:.82rem;margin-top:4px;line-height:1.45}.settings-card{border:1px solid var(--border);background:var(--soft);border-radius:16px;padding:18px;margin-bottom:14px}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.settings-field{margin-bottom:16px}.settings-field label{display:block;font-weight:700;font-size:.82rem;margin-bottom:7px}.settings-input,.settings-select,.settings-textarea{width:100%;background:var(--input);color:var(--text);border:1px solid var(--border);border-radius:11px;padding:11px 13px;outline:0}.settings-textarea{min-height:110px;resize:vertical}.settings-avatar{display:flex;align-items:center;gap:16px;padding:18px;background:var(--soft);border:1px solid var(--border);border-radius:16px;margin-bottom:22px}.settings-avatar img{width:76px;height:76px;border-radius:50%;object-fit:cover}.theme-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.theme-option{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:16px;padding:18px;text-align:left;font-weight:800}.theme-option.active{border:2px solid var(--primary);background:var(--soft)}.theme-option i{display:block;font-size:1.4rem;color:var(--primary);margin-bottom:12px}.mobile-settings-select{display:none;width:100%;padding:13px;border:1px solid var(--border);border-radius:13px;background:var(--surface);color:var(--text);margin-bottom:14px}.settings-actions{display:flex;gap:9px;margin-top:20px}.settings-btn{border:0;border-radius:11px;padding:10px 16px;font-weight:750}.settings-primary{background:var(--primary);color:#fff}.settings-secondary{background:var(--soft);color:var(--text);border:1px solid var(--border)}.settings-danger{background:#dc3545;color:#fff}.settings-switch{position:relative;width:48px;height:28px;flex:none}.settings-switch input{opacity:0;width:0;height:0}.settings-slider{position:absolute;inset:0;background:#9aa3b2;border-radius:30px}.settings-slider:before{content:"";position:absolute;width:22px;height:22px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}.settings-switch input:checked+.settings-slider{background:var(--primary)}.settings-switch input:checked+.settings-slider:before{transform:translateX(20px)}@media(max-width:800px){.settings-shell{padding:25px 12px 55px}.settings-layout{grid-template-columns:1fr}.settings-nav{display:none}.mobile-settings-select{display:block}.settings-panel{padding:20px}.settings-grid{grid-template-columns:1fr}.theme-grid{grid-template-columns:1fr}.settings-hero{align-items:start;flex-direction:column}}</style></head><body><%- include("./partials/nave") %><main class="settings-shell"><header class="settings-hero"><div><div class="text-uppercase small fw-bold text-primary" style="letter-spacing:.12em">Blogify account</div><h1>Settings</h1><p>Everything you need to control your profile, privacy and Blogify experience.</p></div><a href="/" class="settings-btn settings-secondary text-decoration-none">Back to Blogify</a></header><select id="mobileSettings" class="mobile-settings-select"><option value="profile">Profile</option><option value="privacy">Privacy</option><option value="social">Followers & Following</option><option value="notifications">Notifications</option><option value="blog">Blog & Writing</option><option value="comments">Comments</option><option value="appearance">Appearance</option><option value="security">Security</option><option value="blocked">Blocked Users</option><option value="account">Account</option><option value="about">About</option></select><div class="settings-layout"><aside class="settings-nav"><button data-section="profile"><i class="fas fa-user"></i>Profile</button><button data-section="privacy"><i class="fas fa-shield-halved"></i>Privacy</button><button data-section="social"><i class="fas fa-users"></i>Followers & Following</button><button data-section="notifications"><i class="fas fa-bell"></i>Notifications</button><button data-section="blog"><i class="fas fa-pen"></i>Blog & Writing</button><button data-section="comments"><i class="fas fa-comments"></i>Comments</button><button data-section="appearance"><i class="fas fa-palette"></i>Appearance</button><button data-section="security"><i class="fas fa-lock"></i>Security</button><button data-section="blocked"><i class="fas fa-user-slash"></i>Blocked Users</button><button data-section="account"><i class="fas fa-user-gear"></i>Account</button><button data-section="about"><i class="fas fa-circle-info"></i>About</button></aside><section class="settings-panel"><div id="profile" class="settings-section"><div class="section-head"><h2>Profile</h2><p>Keep your public profile information up to date.</p></div><div class="settings-avatar"><img id="profilePreview" src="<%= user.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'"><div><strong><%= user.fullName %></strong><div class="mt-2"><label class="text-primary fw-bold" style="cursor:pointer">Change photo<input id="profileImageInput" type="file" accept="image/*" hidden></label></div><small id="uploadStatus" class="text-muted d-block mt-1">Images up to 10MB</small></div></div><div class="settings-grid"><div class="settings-field"><label>Full name</label><input class="settings-input" id="fullName" value="<%= user.fullName %>"></div><div class="settings-field"><label>Location</label><input class="settings-input" id="location" value="<%= user.location || '' %>"></div><div class="settings-field" style="grid-column:1/-1"><label>Bio</label><textarea class="settings-textarea" id="bio"><%= user.bio || '' %></textarea></div><div class="settings-field" style="grid-column:1/-1"><label>Website</label><input class="settings-input" id="website" value="<%= user.website || '' %>"></div></div><button class="settings-btn settings-primary" id="saveProfile">Save profile</button></div><div id="privacy" class="settings-section"><div class="section-head"><h2>Privacy</h2><p>Control who can access your content and social activity.</p></div><div class="settings-card setting-row"><div class="setting-copy"><strong>Private account</strong><span>Your profile basics stay visible while posts and social lists are limited to approved followers.</span></div><label class="settings-switch"><input id="privateToggle" type="checkbox" <%= user.isPrivate?'checked':'' %>><span class="settings-slider"></span></label></div><div class="settings-card"><div class="setting-copy"><strong>Private-account rules</strong><span>Private blogs stay out of Home, Search, Tags and Trending for non-followers.</span></div></div><div class="settings-card setting-row"><div class="setting-copy"><strong>Follow requests</strong><span>Review pending requests from people who want to follow you.</span></div><a href="/follow/requests/page" class="settings-btn settings-secondary">Manage</a></div></div><div id="social" class="settings-section"><div class="section-head"><h2>Followers & Following</h2><p>See your social connections and manage requests.</p></div><div class="settings-card"><strong>Followers</strong><div class="text-muted"><%= user.followers?.length || 0 %> followers</div></div><div class="settings-card"><strong>Following</strong><div class="text-muted"><%= user.following?.length || 0 %> accounts</div></div><div class="settings-card setting-row"><div class="setting-copy"><strong>Follow requests</strong><span>Accept or reject pending private-account requests.</span></div><a href="/follow/requests/page" class="settings-btn settings-primary">Open requests</a></div></div><div id="notifications" class="settings-section"><div class="section-head"><h2>Notifications</h2><p>Choose which activity should notify you.</p></div><% const ns=user.notificationSettings||{}; const notif=[['emailOnComment','Comments','When someone comments on your blog.'],['emailOnNewFollower','New followers','When someone follows you.'],['emailOnFollowRequest','Follow requests','When someone requests to follow you.'],['emailOnRequestAccepted','Request accepted','When your follow request is accepted.'],['emailOnLike','Likes','When someone likes your blog.'],['emailOnMention','Mentions','When someone mentions you.'],['emailDigest','Email digest','Periodic activity summaries.']]; notif.forEach(([key,title,desc])=>{ %><div class="setting-row"><div class="setting-copy"><strong><%= title %></strong><span><%= desc %></span></div><label class="settings-switch"><input class="notif" data-key="<%= key %>" type="checkbox" <%= ns[key]!==false?'checked':'' %>><span class="settings-slider"></span></label></div><% }) %></div><div id="blog" class="settings-section"><div class="section-head"><h2>Blog & Writing</h2><p>Set your defaults for creating and publishing blogs.</p></div><div class="settings-field"><label>Default visibility</label><select id="defaultVisibility" class="settings-select"><option value="public">Public</option><option value="followers">Followers only</option></select></div><div class="settings-grid"><div class="settings-card setting-row"><div class="setting-copy"><strong>Allow likes</strong><span>Let readers like your blogs.</span></div><label class="settings-switch"><input id="allowLikes" type="checkbox" checked><span class="settings-slider"></span></label></div><div class="settings-card setting-row"><div class="setting-copy"><strong>Allow comments</strong><span>Let readers comment.</span></div><label class="settings-switch"><input id="blogComments" type="checkbox" checked><span class="settings-slider"></span></label></div></div><div class="settings-grid"><div class="settings-field"><label>Default category</label><input class="settings-input" id="defaultCategory" value="<%= user.blogSettings?.defaultCategory || '' %>"></div><div class="settings-field"><label>Default tags</label><input class="settings-input" id="defaultTags" value="<%= (user.blogSettings?.defaultTags||[]).join(', ') %>"></div></div><button class="settings-btn settings-primary" id="saveBlog">Save blog settings</button></div><div id="comments" class="settings-section"><div class="section-head"><h2>Comments</h2><p>Manage conversation and moderation.</p></div><div class="setting-row"><div class="setting-copy"><strong>Allow comments</strong><span>Enable comments across your blogs.</span></div><label class="settings-switch"><input id="commentAllow" type="checkbox" <%= user.commentSettings?.allowComments!==false?'checked':'' %>><span class="settings-slider"></span></label></div><div class="setting-row"><div class="setting-copy"><strong>Moderate comments</strong><span>Review comments before publishing them.</span></div><label class="settings-switch"><input id="moderateComments" type="checkbox" <%= user.commentSettings?.moderateComments?'checked':'' %>><span class="settings-slider"></span></label></div><div class="setting-row"><div class="setting-copy"><strong>Reply notifications</strong><span>Notify you when someone replies to your comment.</span></div><label class="settings-switch"><input id="notifyReplies" type="checkbox" checked><span class="settings-slider"></span></label></div><button class="settings-btn settings-primary mt-3" id="saveComments">Save comment settings</button></div><div id="appearance" class="settings-section"><div class="section-head"><h2>Appearance</h2><p>Choose how Blogify looks on your device.</p></div><div class="theme-grid"><button class="theme-option" data-theme="light"><i class="fas fa-sun"></i>Light<small class="d-block text-muted mt-1">Bright interface</small></button><button class="theme-option" data-theme="dark"><i class="fas fa-moon"></i>Dark<small class="d-block text-muted mt-1">Dark interface</small></button><button class="theme-option" data-theme="system"><i class="fas fa-desktop"></i>System<small class="d-block text-muted mt-1">Follow device</small></button></div></div><div id="security" class="settings-section"><div class="section-head"><h2>Security</h2><p>Keep your Blogify account protected.</p></div><div class="settings-card setting-row"><div class="setting-copy"><strong>Password</strong><span>Use a strong, unique password for your account.</span></div><a href="/user/change-password" class="settings-btn settings-secondary">Change password</a></div></div><div id="blocked" class="settings-section"><div class="section-head"><h2>Blocked Users</h2><p>People you have blocked cannot interact with you.</p></div><div id="blockedList"></div></div><div id="account" class="settings-section"><div class="section-head"><h2>Account</h2><p>Manage your account lifecycle.</p></div><div class="settings-card"><strong>Delete account</strong><p class="text-muted mb-3">This action may permanently remove your account and content.</p><button class="settings-btn settings-danger" id="deleteAccount">Delete account</button></div></div><div id="about" class="settings-section"><div class="section-head"><h2>About Blogify</h2><p>Blogify settings and account preferences.</p></div><div class="settings-card"><strong>Blogify</strong><p class="text-muted mb-0">A place to write, discover and connect through stories.</p></div></div></section></div></main><%- include("./partials/scripts") %><script>(()=>{const b=[...document.querySelectorAll('.settings-nav button')],s=[...document.querySelectorAll('.settings-section')],m=document.getElementById('mobileSettings');function show(id){s.forEach(x=>x.classList.toggle('active',x.id===id));b.forEach(x=>x.classList.toggle('active',x.dataset.section===id));if(m)m.value=id;history.replaceState(null,'','#'+id)}function init(){const id=location.hash.slice(1);show(s.some(x=>x.id===id)?id:'profile')}b.forEach(x=>x.addEventListener('click',()=>show(x.dataset.section)));m?.addEventListener('change',e=>show(e.target.value));init();document.querySelectorAll('.theme-option').forEach(x=>x.addEventListener('click',()=>{const t=x.dataset.theme;localStorage.setItem('blogify-theme',t);document.documentElement.dataset.theme=t==='dark'||(t==='system'&&matchMedia('(prefers-color-scheme:dark)').matches)?'dark':'light';document.querySelectorAll('.theme-option').forEach(y=>y.classList.toggle('active',y===x))}));})();</script></body></html>