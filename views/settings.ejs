<!DOCTYPE html>
<html lang="en"><head><%- include("./partials/head") %><title>Settings | Blogify</title><style>:root{--bg:#f5f7fb;--card:#fff;--text:#172033;--muted:#718096;--line:#e4e8f0;--primary:#635bff;--soft:#efedff;--danger:#e5484d;--shadow:0 16px 45px rgba(20,30,55,.08)}[data-theme="dark"]{--bg:#0c1018;--card:#151b27;--text:#f4f7fb;--muted:#98a3b5;--line:#293241;--primary:#8d85ff;--soft:#292641;--danger:#ff6b70;--shadow:0 16px 45px rgba(0,0,0,.28)}*{box-sizing:border-box}.settings-page{min-height:100vh;background:var(--bg);color:var(--text);padding:100px 16px 60px}.shell{max-width:1180px;margin:auto}.hero{margin-bottom:22px}.hero h1{margin:0 0 5px;font-size:2.1rem;letter-spacing:-.04em}.hero p{margin:0;color:var(--muted)}.mobile-select{display:none;width:100%;padding:13px;border:1px solid var(--line);border-radius:13px;background:var(--card);color:var(--text);font:inherit;font-weight:700;margin-bottom:14px}.layout{display:grid;grid-template-columns:245px 1fr;gap:18px}.menu,.content{background:var(--card);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow)}.menu{padding:10px;height:max-content;position:sticky;top:82px}.menu-title{text-transform:uppercase;font-size:.68rem;color:var(--muted);font-weight:900;letter-spacing:.12em;padding:10px 12px}.tab{display:flex;gap:11px;align-items:center;width:100%;border:0;background:none;color:var(--muted);padding:11px 12px;border-radius:11px;text-align:left;font-weight:800;cursor:pointer}.tab:hover,.tab.active{background:var(--soft);color:var(--primary)}.tab i{width:20px;text-align:center}.content{padding:28px;min-height:650px}.section{display:none}.section.active{display:block}.head{border-bottom:1px solid var(--line);padding-bottom:18px;margin-bottom:20px}.head h2{margin:0 0 5px;font-size:1.35rem}.head p{margin:0;color:var(--muted);font-size:.88rem}.grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field{margin-bottom:15px}.full{grid-column:1/-1}.field label{display:block;font-size:.8rem;font-weight:850;margin-bottom:7px}.input,.select,.textarea{width:100%;border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:11px;padding:11px 12px;font:inherit;outline:0}.textarea{min-height:95px;resize:vertical}.card{background:var(--bg);border:1px solid var(--line);border-radius:15px;padding:16px;margin-bottom:11px}.row,.link-card{display:flex;align-items:center;justify-content:space-between;gap:18px}.copy strong{display:block;margin-bottom:3px}.copy span{display:block;color:var(--muted);font-size:.79rem;line-height:1.45}.switch{position:relative;width:48px;height:28px;flex:0 0 auto}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;background:#aab2c0;border-radius:30px;cursor:pointer}.slider:before{content:"";position:absolute;width:22px;height:22px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}.switch input:checked+.slider{background:var(--primary)}.switch input:checked+.slider:before{transform:translateX(20px)}.btn{border:0;border-radius:10px;padding:10px 15px;font-weight:850;cursor:pointer;text-decoration:none;display:inline-block}.primary{background:var(--primary);color:#fff}.secondary{background:var(--bg);color:var(--text);border:1px solid var(--line)}.danger{background:var(--danger);color:#fff}.avatar-box{display:flex;align-items:center;gap:16px;padding:16px;background:var(--bg);border:1px solid var(--line);border-radius:15px;margin-bottom:20px}.avatar{width:78px;height:78px;border-radius:50%;object-fit:cover;border:3px solid var(--card)}.upload{color:var(--primary);font-weight:850;cursor:pointer;font-size:.84rem}.upload input{display:none}.status{font-size:.75rem;color:var(--muted);margin-top:5px}.themes{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.theme{padding:18px;border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:13px;font-weight:850;cursor:pointer}.theme.active{border:2px solid var(--primary);background:var(--soft)}.theme i{display:block;color:var(--primary);font-size:1.4rem;margin-bottom:7px}.blocked{display:flex;align-items:center;gap:12px}.blocked img{width:42px;height:42px;border-radius:50%;object-fit:cover}.toast{position:fixed;right:20px;bottom:20px;background:var(--text);color:var(--card);padding:12px 16px;border-radius:11px;display:none;z-index:99;font-weight:800}@media(max-width:800px){.settings-page{padding:86px 11px 40px}.layout{grid-template-columns:1fr}.menu{display:none}.mobile-select{display:block}.content{padding:19px}.grid{grid-template-columns:1fr}.full{grid-column:auto}.themes{grid-template-columns:1fr}.hero h1{font-size:1.75rem}}</style></head><body><%- include("./partials/nave") %><main class="settings-page"><div class="shell"><div class="hero"><h1>Settings</h1><p>Manage your profile, privacy, content, notifications and account.</p></div><select id="mobileSection" class="mobile-select"><option value="profile">👤 Profile</option><option value="privacy">🔐 Privacy</option><option value="social">👥 Followers & Following</option><option value="notifications">🔔 Notifications</option><option value="blog">✍️ Blog & Writing</option><option value="comments">💬 Comments</option><option value="appearance">🎨 Appearance</option><option value="security">🔒 Security</option><option value="blocked">🚫 Blocked Users</option><option value="account">🗑️ Account</option><option value="about">ℹ️ About</option></select><div class="layout"><aside class="menu"><div class="menu-title">Settings</div><button class="tab" data-section="profile"><i class="fas fa-user"></i>Profile</button><button class="tab" data-section="privacy"><i class="fas fa-shield-alt"></i>Privacy</button><button class="tab" data-section="social"><i class="fas fa-users"></i>Followers & Following</button><button class="tab" data-section="notifications"><i class="fas fa-bell"></i>Notifications</button><button class="tab" data-section="blog"><i class="fas fa-pen"></i>Blog & Writing</button><button class="tab" data-section="comments"><i class="fas fa-comments"></i>Comments</button><button class="tab" data-section="appearance"><i class="fas fa-palette"></i>Appearance</button><button class="tab" data-section="security"><i class="fas fa-key"></i>Security</button><button class="tab" data-section="blocked"><i class="fas fa-user-slash"></i>Blocked Users</button><button class="tab" data-section="account"><i class="fas fa-user-cog"></i>Account</button><button class="tab" data-section="about"><i class="fas fa-info-circle"></i>About</button></aside><section class="content">
<div id="profile" class="section"><div class="head"><h2>Profile</h2><p>Control the information shown on your profile.</p></div><div class="avatar-box"><img id="profilePreview" class="avatar" src="<%= user.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'"><div><strong><%= user.fullName %></strong><div><label class="upload">Change profile photo<input id="profileImageInput" type="file" accept="image/*"></label></div><div id="uploadStatus" class="status">Image files up to 10MB.</div></div></div><div class="grid"><div class="field"><label>Full name</label><input class="input" id="fullName" value="<%= user.fullName %>" maxlength="100"></div><div class="field"><label>Location</label><input class="input" id="location" value="<%= user.location || '' %>" maxlength="120"></div><div class="field full"><label>Bio</label><textarea class="textarea" id="bio" maxlength="500"><%= user.bio || '' %></textarea></div><div class="field full"><label>Website</label><input class="input" id="website" value="<%= user.website || '' %>" type="url"></div></div><button class="btn primary" id="saveProfile">Save profile</button></div>
<div id="privacy" class="section"><div class="head"><h2>Privacy</h2><p>Choose who can see and interact with your account.</p></div><div class="card row"><div class="copy"><strong>Private account</strong><span>Avatar, name, bio and counts remain public; restricted content is available to approved followers.</span></div><label class="switch"><input id="privateToggle" type="checkbox" <%= user.isPrivate ? 'checked' : '' %>><span class="slider"></span></label></div><div class="card"><div class="copy"><strong>Private account rules</strong><span>Followers/following lists, posted blogs, direct blog views, likes and comments are restricted. Private blogs are excluded from home, search, tags and trending.</span></div></div><div class="card link-card"><div class="copy"><strong>Follow requests</strong><span>Review people waiting to follow you.</span></div><a class="btn secondary" href="/follow/requests/page">Manage requests</a></div></div>
<div id="social" class="section"><div class="head"><h2>Followers & Following</h2><p>Manage social connections and private-account requests.</p></div><div class="card"><div class="copy"><strong>Followers</strong><span><%= user.followers?.length || 0 %> followers</span></div></div><div class="card"><div class="copy"><strong>Following</strong><span><%= user.following?.length || 0 %> accounts you follow</span></div></div><div class="card link-card"><div class="copy"><strong>Follow requests</strong><span>Accept or reject pending requests.</span></div><a class="btn primary" href="/follow/requests/page">Open requests</a></div></div>
<div id="notifications" class="section"><div class="head"><h2>Notifications</h2><p>Choose which activity notifications you receive.</p></div><% const ns=user.notificationSettings||{}; const notif=[['emailOnComment','Comments','Notify me when someone comments.'],['emailOnNewFollower','New followers','Notify me when someone follows you.'],['emailOnFollowRequest','Follow requests','Notify me when someone requests to follow you.'],['emailOnRequestAccepted','Request accepted','Notify me when a follow request is accepted.'],['emailOnLike','Likes','Notify me when someone likes your blog.'],['emailOnMention','Mentions','Notify me when someone mentions you.'],['emailDigest','Email digest','Receive periodic activity summaries.']]; notif.forEach(([key,title,desc])=>{ %><div class="card row"><div class="copy"><strong><%= title %></strong><span><%= desc %></span></div><label class="switch"><input class="notif" data-key="<%= key %>" type="checkbox" <%= ns[key] !== false ? 'checked' : '' %>><span class="slider"></span></label></div><% }) %></div>
<div id="blog" class="section"><div class="head"><h2>Blog & Writing</h2><p>Set defaults for new blogs and your writing experience.</p></div><div class="field"><label>Default blog visibility</label><select id="defaultVisibility" class="select"><option value="public" <%= user.blogSettings?.defaultVisibility !== 'followers' ? 'selected' : '' %>>Public</option><option value="followers" <%= user.blogSettings?.defaultVisibility === 'followers' ? 'selected' : '' %>>Followers only</option></select></div><div class="grid"><div class="card row"><div class="copy"><strong>Allow likes</strong><span>Allow readers to like your blogs.</span></div><label class="switch"><input id="allowLikes" type="checkbox" <%= user.blogSettings?.allowLikes !== false ? 'checked' : '' %>><span class="slider"></span></label></div><div class="card row"><div class="copy"><strong>Allow comments</strong><span>Allow readers to comment.</span></div><label class="switch"><input id="blogComments" type="checkbox" <%= user.blogSettings?.allowComments !== false ? 'checked' : '' %>><span class="slider"></span></label></div><div class="card row"><div class="copy"><strong>Show view count</strong><span>Show blog views publicly.</span></div><label class="switch"><input id="showViewCount" type="checkbox" <%= user.blogSettings?.showViewCount !== false ? 'checked' : '' %>><span class="slider"></span></label></div><div class="card row"><div class="copy"><strong>Automatic drafts</strong><span>Keep writing progress as drafts.</span></div><label class="switch"><input id="autoDrafts" type="checkbox" <%= user.blogSettings?.autoDrafts !== false ? 'checked' : '' %>><span class="slider"></span></label></div></div><div class="grid"><div class="field"><label>Default category</label><input class="input" id="defaultCategory" value="<%= user.blogSettings?.defaultCategory || '' %>"></div><div class="field"><label>Default tags</label><input class="input" id="defaultTags" value="<%= (user.blogSettings?.defaultTags || []).join(', ') %>" placeholder="javascript, web, coding"></div></div><button class="btn primary" id="saveBlog">Save blog settings</button></div>
<div id="comments" class="section"><div class="head"><h2>Comments</h2><p>Control comments and moderation on your blogs.</p></div><div class="card row"><div class="copy"><strong>Allow comments</strong><span>Enable comments across your blogs.</span></div><label class="switch"><input id="commentAllow" type="checkbox" <%= user.commentSettings?.allowComments !== false ? 'checked' : '' %>><span class="slider"></span></label></div><div class="card row"><div class="copy"><strong>Moderate comments</strong><span>Review comments before they become visible.</span></div><label class="switch"><input id="moderateComments" type="checkbox" <%= user.commentSettings?.moderateComments === true ? 'checked' : '' %>><span class="slider"></span></label></div><div class="card row"><div class="copy"><strong>Reply notifications</strong><span>Notify me when someone replies to my comment.</span></div><label class="switch"><input id="notifyReplies" type="checkbox" <%= user.commentSettings?.notifyReplies !== false ? 'checked' : '' %>><span class="slider"></span></label></div><button class="btn primary" id="saveComments">Save comment settings</button></div>
<div id="appearance" class="section"><div class="head"><h2>Appearance</h2><p>Customize the Blogify interface.</p></div><div class="themes"><button class="theme" data-theme="light"><i class="fas fa-sun"></i>Light</button><button class="theme" data-theme="dark"><i class="fas fa-moon"></i>Dark</button><button class="theme" data-theme="system"><i class="fas fa-desktop"></i>System</button></div><div class="card row" style="margin-top:15px"><div class="copy"><strong>Compact layout</strong><span>Use a denser layout for lists and feeds.</span></div><label class="switch"><input id="compactLayout" type="checkbox" <%= user.interfaceSettings?.compactLayout ? 'checked' : '' %>><span class="slider"></span></label></div><div class="card row"><div class="copy"><strong>Reduce animations</strong><span>Reduce motion and transition effects.</span></div><label class="switch"><input id="reduceAnimations" type="checkbox" <%= user.interfaceSettings?.reduceAnimations ? 'checked' : '' %>><span class="slider"></span></label></div><button class="btn primary" id="saveInterface">Save interface settings</button></div>
<div id="security" class="section"><div class="head"><h2>Security</h2><p>Protect your account.</p></div><% if (user.googleId && !user.password) { %><div class="card"><div class="copy"><strong>Google Sign-In</strong><span>Your password is managed by Google.</span></div></div><% } else { %><div class="grid"><div class="field full"><label>Current password</label><input class="input" id="currentPassword" type="password"></div><div class="field"><label>New password</label><input class="input" id="newPassword" type="password" minlength="6"></div><div class="field"><label>Confirm password</label><input class="input" id="confirmPassword" type="password" minlength="6"></div></div><button class="btn primary" id="changePassword">Change password</button><% } %><div class="card" style="margin-top:15px"><div class="copy"><strong>Active sessions</strong><span>Current session can be ended with Logout. Multi-device session management requires session storage.</span></div></div></div>
<div id="blocked" class="section"><div class="head"><h2>Blocked Users</h2><p>Manage accounts you have blocked.</p></div><% if (user.blockedUsers?.length) { user.blockedUsers.forEach(person=>{ %><div class="card row"><div class="blocked"><img src="<%= person.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'"><div class="copy"><strong><%= person.fullName %></strong><span>Blocked account</span></div></div><button class="btn secondary unblock" data-id="<%= person._id %>">Unblock</button></div><% }) } else { %><div class="card"><div class="copy"><strong>No blocked users</strong><span>People you block will appear here.</span></div></div><% } %></div>
<div id="account" class="section"><div class="head"><h2>Account</h2><p>Manage your account lifecycle.</p></div><div class="card"><div class="copy"><strong><%= user.fullName %></strong><span><%= user.email %> · Member since <%= new Date(user.createdAt).toLocaleDateString() %></span></div></div><div class="card link-card"><div class="copy"><strong>Sign out</strong><span>End your current Blogify session.</span></div><a class="btn secondary" href="/user/logout">Logout</a></div><div class="card"><div class="copy"><strong>Export your data</strong><span>Data export can be connected to a dedicated export endpoint.</span></div></div><div class="card"><div class="copy"><strong style="color:var(--danger)">Delete account</strong><span>This permanently deletes your account and blogs.</span></div><button id="deleteAccount" class="btn danger">Delete account</button></div></div>
<div id="about" class="section"><div class="head"><h2>About Blogify</h2><p>Helpful information and legal pages.</p></div><div class="card"><div class="copy"><strong>Community Guidelines</strong><span>Keep Blogify welcoming and useful for everyone.</span></div></div><div class="card"><div class="copy"><strong>Privacy Policy</strong><span>Learn how Blogify handles account data.</span></div></div><div class="card"><div class="copy"><strong>Terms of Service</strong><span>Rules for using Blogify.</span></div></div><div class="card"><div class="copy"><strong>Blogify</strong><span>Settings center · Account preferences</span></div></div></div></section></div></div></main><div id="toast" class="toast"></div>
<script>const sections=['profile','privacy','social','notifications','blog','comments','appearance','security','blocked','account','about'];const $=id=>document.getElementById(id);const toast=(m,e=false)=>{const x=$('toast');x.textContent=m;x.style.display='block';x.style.background=e?'var(--danger)':'var(--text)';clearTimeout(window.__t);window.__t=setTimeout(()=>x.style.display='none',2800)};async function api(url,opts={}){const form=opts.body instanceof FormData;const r=await fetch(url,{credentials:'same-origin',...opts,headers:{...(form?{}:{'Content-Type':'application/json'}),...(opts.headers||{})}});const t=await r.text();let d={};try{d=t?JSON.parse(t):{}}catch{throw new Error(r.ok?'Server returned an invalid response':'Server error')};if(!r.ok||d.success===false)throw new Error(d.message||'Something went wrong');return d}function openSection(s,h=true){if(!sections.includes(s))s='profile';document.querySelectorAll('.section').forEach(x=>x.classList.toggle('active',x.id===s));document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.dataset.section===s));$('mobileSection').value=s;if(h)history.replaceState(null,'','#'+s)}openSection(location.hash.slice(1)||'<%= activeSection || "profile" %>',false);$('mobileSection').onchange=e=>openSection(e.target.value);document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>openSection(b.dataset.section));$('saveProfile').onclick=async()=>{try{await api('/user/profile/update',{method:'PUT',body:JSON.stringify({fullName:$('fullName').value,bio:$('bio').value,website:$('website').value,location:$('location').value})});toast('Profile saved')}catch(e){toast(e.message,true)}};$('profileImageInput').onchange=async e=>{const f=e.target.files[0];if(!f)return;if(!f.type.startsWith('image/'))return toast('Please select an image',true);if(f.size>10*1024*1024)return toast('Image must be 10MB or smaller',true);const form=new FormData();form.append('profileImage',f);$('uploadStatus').textContent='Uploading…';try{const d=await api('/user/profile/upload-image',{method:'POST',body:form});const u=d.imageURL+(d.imageURL.includes('?')?'&':'?')+'v='+Date.now();$('profilePreview').src=u;document.querySelectorAll('.profile-trigger img,.profile-summary img').forEach(i=>i.src=u);$('uploadStatus').textContent='Profile photo updated';toast('Profile photo updated')}catch(err){$('uploadStatus').textContent='Upload failed';toast(err.message,true)}e.target.value=''};$('privateToggle').onchange=async e=>{try{await api('/user/profile/settings/privacy',{method:'PATCH',body:JSON.stringify({isPrivate:e.target.checked})});toast(e.target.checked?'Private account enabled':'Public account enabled')}catch(err){e.target.checked=!e.target.checked;toast(err.message,true)}};document.querySelectorAll('.notif').forEach(x=>x.onchange=async e=>{try{await api('/user/profile/settings/notifications',{method:'PATCH',body:JSON.stringify({[e.target.dataset.key]:e.target.checked})});toast('Notification saved')}catch(err){e.target.checked=!e.target.checked;toast(err.message,true)}});async function saveGeneral(group,payload){try{await api('/user/profile/settings/general',{method:'PATCH',body:JSON.stringify({[group]:payload})});toast('Settings saved')}catch(e){toast(e.message,true)}}$('saveBlog').onclick=()=>saveGeneral('blogSettings',{defaultVisibility:$('defaultVisibility').value,allowLikes:$('allowLikes').checked,allowComments:$('blogComments').checked,showViewCount:$('showViewCount').checked,autoDrafts:$('autoDrafts').checked,defaultCategory:$('defaultCategory').value,defaultTags:$('defaultTags').value.split(',').map(x=>x.trim()).filter(Boolean)});$('saveComments').onclick=()=>saveGeneral('commentSettings',{allowComments:$('commentAllow').checked,moderateComments:$('moderateComments').checked,notifyReplies:$('notifyReplies').checked});$('saveInterface').onclick=()=>saveGeneral('interfaceSettings',{compactLayout:$('compactLayout').checked,reduceAnimations:$('reduceAnimations').checked});document.querySelectorAll('.theme').forEach(b=>b.onclick=async()=>{try{await api('/user/profile/settings/theme',{method:'PATCH',body:JSON.stringify({theme:b.dataset.theme})});localStorage.setItem('blogify-theme',b.dataset.theme);applyTheme(b.dataset.theme);toast('Theme saved')}catch(e){toast(e.message,true)}});function applyTheme(t){const dark=t==='dark'||(t==='system'&&matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.dataset.theme=dark?'dark':'light';document.querySelectorAll('.theme').forEach(b=>b.classList.toggle('active',b.dataset.theme===t))}applyTheme('<%= user.theme || "system" %>');$('changePassword')?.addEventListener('click',async()=>{if($('newPassword').value!==$('confirmPassword').value)return toast('Passwords do not match',true);try{await api('/user/profile/change-password',{method:'POST',body:JSON.stringify({currentPassword:$('currentPassword').value,newPassword:$('newPassword').value})});toast('Password changed successfully');$('currentPassword').value='';$('newPassword').value='';$('confirmPassword').value=''}catch(e){toast(e.message,true)}});document.querySelectorAll('.unblock').forEach(b=>b.onclick=async()=>{try{await api('/user/profile/settings/unblock/'+b.dataset.id,{method:'PATCH'});b.closest('.card').remove();toast('User unblocked')}catch(e){toast(e.message,true)}});$('deleteAccount').onclick=async()=>{if(!confirm('Delete your account and all your blogs? This cannot be undone.'))return;try{await api('/user/profile/delete-account',{method:'DELETE'});location.href='/'}catch(e){toast(e.message,true)}};</script></body></html>