<!doctype html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>Settings | Blogify</title>
  <style>
    :root{--sc:var(--surface,#fff);--ss:var(--soft,#f7f7f8);--sl:var(--border,#e5e7eb);--st:var(--text,#111827);--sm:var(--muted,#6b7280);--sp:var(--primary,#6366f1)}
    *{box-sizing:border-box}.settings-page{max-width:1120px;margin:auto;padding:30px 16px 80px;color:var(--st)}
    .head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:22px}.head h1{margin:0;font-size:clamp(1.8rem,4vw,2.4rem);letter-spacing:-.04em}.head p{margin:6px 0 0;color:var(--sm)}.actions{display:flex;gap:8px;flex-wrap:wrap}.link,.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid var(--sl);background:var(--sc);color:var(--st);padding:10px 13px;border-radius:11px;text-decoration:none;font-weight:750;cursor:pointer}.link:hover,.btn:hover{background:var(--ss)}.primary{background:var(--sp);border-color:var(--sp);color:#fff}.primary:hover{color:#fff;filter:brightness(.96)}
    .quick{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px}.quick a{padding:15px;border:1px solid var(--sl);border-radius:15px;background:var(--sc);color:var(--st);text-decoration:none}.quick i{display:inline-grid;place-items:center;width:38px;height:38px;border-radius:11px;background:var(--ss);color:var(--sp);margin-right:8px}.quick strong{display:block}.quick small{color:var(--sm);margin-left:47px;display:block;margin-top:-3px}
    .mobile{display:none;width:100%;padding:11px;border:1px solid var(--sl);border-radius:11px;background:var(--sc);color:var(--st);margin-bottom:16px}.layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:24px}.menu{position:sticky;top:16px;height:max-content}.label{padding:8px 12px;font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--sm);font-weight:850}.tab{width:100%;border:0;background:transparent;color:var(--sm);padding:11px 12px;border-radius:11px;text-align:left;font-weight:700;cursor:pointer}.tab:hover{background:var(--ss);color:var(--st)}.tab.active{background:var(--sp);color:#fff}.section{display:none}.section.active{display:block}.section h2{margin:0;font-size:1.4rem}.section-intro{color:var(--sm);font-size:.86rem;margin:5px 0 16px}.card{background:var(--sc);border:1px solid var(--sl);border-radius:16px;overflow:hidden;margin-bottom:14px}.row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 17px;border-bottom:1px solid var(--sl)}.row:last-child{border-bottom:0}.title{font-weight:800}.desc{font-size:.78rem;color:var(--sm);line-height:1.45;margin-top:4px}.field{padding:16px 17px}.field label{display:block;font-size:.8rem;font-weight:750;margin-bottom:7px}.grid{display:grid;grid-template-columns:1fr 1fr}.input{width:100%;padding:11px 12px;border:1px solid var(--sl);border-radius:10px;background:var(--sc);color:var(--st);outline:0}.input:focus{border-color:var(--sp);box-shadow:0 0 0 3px rgba(99,102,241,.12)}.switch{position:relative;width:44px;height:25px;flex:none}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;border-radius:20px;background:#9ca3af;cursor:pointer}.slider:before{content:"";position:absolute;width:19px;height:19px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}.switch input:checked+.slider{background:var(--sp)}.switch input:checked+.slider:before{transform:translateX(19px)}
    .profile{display:flex;align-items:center;gap:14px;padding:17px;border:1px solid var(--sl);border-radius:16px;background:var(--sc);margin-bottom:14px}.profile img{width:70px;height:70px;border-radius:50%;object-fit:cover}.photo{color:var(--sp);font-weight:800;cursor:pointer}.muted{color:var(--sm);font-size:.78rem}.theme{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.theme button{padding:16px 10px;border:1px solid var(--sl);border-radius:13px;background:var(--sc);color:var(--st);font-weight:800;cursor:pointer}.theme button.active{outline:2px solid var(--sp);background:var(--ss)}.theme i{display:block;color:var(--sp);font-size:1.3rem;margin-bottom:7px}.blocked{display:flex;align-items:center;gap:12px}.blocked img{width:44px;height:44px;border-radius:50%;object-fit:cover}.danger{background:#dc2626;color:#fff;border:0}.danger:hover{background:#b91c1c;color:#fff}.status{font-size:.8rem;color:var(--sm)}
    @media(max-width:850px){.layout{grid-template-columns:1fr}.menu{display:none}.mobile{display:block}.quick{grid-template-columns:1fr}.head{flex-direction:column}.actions{width:100%}.actions .link{flex:1}.grid{grid-template-columns:1fr}}
    @media(max-width:560px){.settings-page{padding:20px 12px 60px}.row{align-items:flex-start}.theme{grid-template-columns:1fr}.quick a{padding:13px}.head p{font-size:.85rem}}
  </style>
</head>
<body>
  <%- include("./partials/nave") %>
  <main class="settings-page">
    <header class="head">
      <div><h1>Settings</h1><p>Manage your Blogify account, privacy, notifications and writing experience.</p></div>
      <div class="actions"><a class="link" href="/user/profile"><i class="fas fa-user"></i> Profile</a><a class="link" href="/analytics"><i class="fas fa-chart-line"></i> Analytics</a><a class="link" href="/notifications"><i class="fas fa-bell"></i> Notifications</a></div>
    </header>
    <div class="quick">
      <a href="/user/profile"><i class="fas fa-id-card"></i><strong>My Profile</strong><small>View your public profile</small></a>
      <a href="/analytics"><i class="fas fa-chart-column"></i><strong>Creator Analytics</strong><small>Views, likes and comments</small></a>
      <a href="/notifications"><i class="fas fa-bell"></i><strong>Notification Center</strong><small>Read and manage activity</small></a>
    </div>
    <select id="mobileMenu" class="mobile"><option value="profile">Profile</option><option value="privacy">Privacy & Safety</option><option value="social">Followers & Following</option><option value="notifications">Notifications</option><option value="blog">Blog & Writing</option><option value="comments">Comments</option><option value="appearance">Appearance</option><option value="security">Security</option><option value="blocked">Blocked Users</option><option value="account">Account</option><option value="about">About</option></select>
    <div class="layout">
      <nav class="menu">
        <div class="label">Account</div><button class="tab" data-section="profile">Profile</button><button class="tab" data-section="privacy">Privacy & Safety</button><button class="tab" data-section="social">Followers</button><button class="tab" data-section="notifications">Notifications</button>
        <div class="label">Content</div><button class="tab" data-section="blog">Blog & Writing</button><button class="tab" data-section="comments">Comments</button>
        <div class="label">App</div><button class="tab" data-section="appearance">Appearance</button><button class="tab" data-section="security">Security</button><button class="tab" data-section="blocked">Blocked Users</button><button class="tab" data-section="account">Account</button><button class="tab" data-section="about">About</button>
      </nav>
      <section>
        <div id="profile" class="section"><h2>Profile</h2><p class="section-intro">Manage the information visitors see on your profile.</p>
          <div class="profile"><img id="profilePreview" src="<%= user.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'" alt="Profile"><div><div class="title"><%= user.fullName %></div><label class="photo">Change profile photo<input id="profileImageInput" type="file" accept="image/*" hidden></label><div id="uploadStatus" class="muted">JPG, PNG, WEBP and other image types</div></div></div>
          <div class="card"><div class="grid"><div class="field"><label>Full name</label><input id="fullName" class="input" value="<%= user.fullName %>"></div><div class="field"><label>Location</label><input id="location" class="input" value="<%= user.location || '' %>"></div></div><div class="field"><label>Bio</label><textarea id="bio" class="input" rows="4"><%= user.bio || '' %></textarea></div><div class="field"><label>Website</label><input id="website" class="input" value="<%= user.website || '' %>"></div><div class="field"><button id="saveProfile" class="btn primary">Save profile changes</button></div></div>
        </div>
        <div id="privacy" class="section"><h2>Privacy & Safety</h2><p class="section-intro">Control visibility and unwanted interactions.</p><div class="card"><div class="row"><div><div class="title">Private account</div><div class="desc">Only approved followers can see private social content.</div></div><label class="switch"><input id="privateToggle" type="checkbox" <%= user.isPrivate?'checked':'' %>><span class="slider"></span></label></div><div class="row"><div><div class="title">Follow requests</div><div class="desc">Review people waiting to follow you.</div></div><a class="btn" href="/follow/requests/page">Manage</a></div><div class="row"><div><div class="title">Blocked users</div><div class="desc">View and unblock accounts you have blocked.</div></div><button class="btn" data-open="blocked">Manage</button></div></div></div>
        <div id="social" class="section"><h2>Followers & Following</h2><p class="section-intro">Quick access to your social connections.</p><div class="card"><div class="row"><div><div class="title">Followers</div><div class="desc"><%= user.followers?.length || 0 %> people follow you.</div></div><a class="btn" href="/user/profile">View profile</a></div><div class="row"><div><div class="title">Following</div><div class="desc">You follow <%= user.following?.length || 0 %> accounts.</div></div><a class="btn" href="/user/profile">View profile</a></div></div></div>
        <div id="notifications" class="section"><h2>Notifications</h2><p class="section-intro">Choose what Blogify may send by email or web push.</p><% const ns=user.notificationSettings||{}; %><div class="card"><% [['pushEnabled','Web push'],['pushOnMessage','Messages'],['pushOnComment','Comments'],['pushOnReply','Replies'],['pushOnLike','Likes'],['pushOnFollow','New followers'],['pushOnFollowRequest','Follow requests'],['pushOnMention','Mentions'],['pushOnBlogPost','New blogs from followed users'],['emailOnComment','Email: comments'],['emailOnNewFollower','Email: new followers'],['emailOnFollowRequest','Email: follow requests'],['emailOnRequestAccepted','Email: accepted requests'],['emailOnLike','Email: likes'],['emailOnMention','Email: mentions'],['emailDigest','Email digest']].forEach(([key,title])=>{ %><div class="row"><div><div class="title"><%= title %></div><div class="desc">Enable or disable this notification type.</div></div><label class="switch"><input class="notif" data-key="<%= key %>" type="checkbox" <%= key==='pushEnabled' ? (ns[key]?'checked':'') : (ns[key]!==false?'checked':'') %>><span class="slider"></span></label></div><% }) %></div><a class="btn" href="/notifications">Open notification center</a></div>
        <div id="blog" class="section"><h2>Blog & Writing</h2><p class="section-intro">Set defaults for publishing.</p><div class="card"><div class="field"><label>Default visibility</label><select id="defaultVisibility" class="input"><option value="public" <%= user.blogSettings?.defaultVisibility==='public'?'selected':'' %>>Public</option><option value="followers" <%= user.blogSettings?.defaultVisibility==='followers'?'selected':'' %>>Followers only</option></select></div><div class="grid"><div class="field"><label>Default category</label><input id="defaultCategory" class="input" value="<%= user.blogSettings?.defaultCategory || '' %>"></div><div class="field"><label>Default tags</label><input id="defaultTags" class="input" value="<%= (user.blogSettings?.defaultTags||[]).join(', ') %>"></div></div><% [['allowLikes','Allow likes'],['allowComments','Allow comments'],['showViewCount','Show view count'],['autoDrafts','Auto-save drafts']].forEach(([id,title])=>{ %><div class="row"><div><div class="title"><%= title %></div></div><label class="switch"><input id="<%= id %>" type="checkbox" <%= user.blogSettings?.[id]!==false?'checked':'' %>><span class="slider"></span></label></div><% }) %><div class="field"><button id="saveBlog" class="btn primary">Save blog settings</button></div></div></div>
        <div id="comments" class="section"><h2>Comments</h2><p class="section-intro">Control conversations around your posts.</p><div class="card"><% [['commentAllow','Allow comments','commentSettings','allowComments',true],['moderateComments','Moderate comments','commentSettings','moderateComments',false],['notifyReplies','Reply notifications','commentSettings','notifyReplies',true]].forEach(([id,title,g,k,def])=>{ %><div class="row"><div><div class="title"><%= title %></div></div><label class="switch"><input id="<%= id %>" type="checkbox" <%= user[g]?.[k]===undefined ? (def?'checked':'') : (user[g][k]?'checked':'') %>><span class="slider"></span></label></div><% }) %><div class="field"><button id="saveComments" class="btn primary">Save comment settings</button></div></div></div>
        <div id="appearance" class="section"><h2>Appearance</h2><p class="section-intro">Choose light, dark or device-controlled appearance.</p><div class="card"><div class="field"><div class="theme"><button type="button" data-theme="light">☀️<br>Light</button><button type="button" data-theme="dark">🌙<br>Dark</button><button type="button" data-theme="system">🖥️<br>System</button></div></div><div class="row"><div><div class="title">Compact layout</div></div><label class="switch"><input id="compactLayout" type="checkbox" <%= user.interfaceSettings?.compactLayout?'checked':'' %>><span class="slider"></span></label></div><div class="row"><div><div class="title">Reduce animations</div></div><label class="switch"><input id="reduceAnimations" type="checkbox" <%= user.interfaceSettings?.reduceAnimations?'checked':'' %>><span class="slider"></span></label></div><div class="field"><button id="saveInterface" class="btn primary">Save interface settings</button></div></div></div>
        <div id="security" class="section"><h2>Security</h2><p class="section-intro">Protect access to your account.</p><div class="card"><div class="field"><label>Current password</label><input id="currentPassword" class="input" type="password" autocomplete="current-password"></div><div class="field"><label>New password</label><input id="newPassword" class="input" type="password" autocomplete="new-password" minlength="6"></div><div class="field"><button id="changePassword" class="btn primary">Change password</button></div></div></div>
        <div id="blocked" class="section"><h2>Blocked Users</h2><p class="section-intro">Unblock an account to allow normal interaction again.</p><div id="blockedList" class="card"><% if(user.blockedUsers?.length){ user.blockedUsers.forEach(b=>{ %><div class="row" id="blocked-<%= b._id %>"><div class="blocked"><img src="<%= b.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'" alt=""><div><div class="title"><%= b.fullName %></div><div class="desc">Blocked account</div></div></div><button class="btn" data-unblock="<%= b._id %>">Unblock</button></div><% }) }else{ %><div class="field status">You have not blocked anyone.</div><% } %></div></div>
        <div id="account" class="section"><h2>Account</h2><p class="section-intro">Manage your account and data.</p><div class="card"><div class="row"><div><div class="title">Visit profile</div><div class="desc">See what visitors see.</div></div><a class="btn" href="/user/profile">Visit</a></div><div class="row"><div><div class="title">Creator analytics</div></div><a class="btn" href="/analytics">Open</a></div><div class="row"><div><div class="title">Delete account</div><div class="desc">Permanently remove your account and blogs.</div></div><button id="deleteAccount" class="btn danger">Delete account</button></div></div></div>
        <div id="about" class="section"><h2>About Blogify</h2><p class="section-intro">Product information and quick links.</p><div class="card"><div class="row"><div><div class="title">Notifications</div></div><a class="btn" href="/notifications">Open</a></div><div class="row"><div><div class="title">Analytics</div></div><a class="btn" href="/analytics">Open</a></div></div></div>
      </section>
    </div>
  </main>
  <%- include("./partials/scripts") %>
  <script>
  (()=>{
    const $=id=>document.getElementById(id), sections=[...document.querySelectorAll('.section')],tabs=[...document.querySelectorAll('.tab')],mobile=$('mobileMenu');
    const notify=(msg,ok=true)=>{if(window.notify){ok?window.notify.success(msg):window.notify.error(msg)}else alert(msg)};
    const show=id=>{if(!sections.some(s=>s.id===id))id='profile';sections.forEach(s=>s.classList.toggle('active',s.id===id));tabs.forEach(t=>t.classList.toggle('active',t.dataset.section===id));if(mobile)mobile.value=id;history.replaceState(null,'','#'+id)};
    tabs.forEach(t=>t.onclick=()=>show(t.dataset.section));mobile?.addEventListener('change',e=>show(e.target.value));document.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>show(b.dataset.open));show(location.hash.slice(1)||'<%= activeSection || "profile" %>');
    async function request(url,options={}){const r=await fetch(url,{credentials:'same-origin',...options,headers:{'Content-Type':'application/json',...(options.headers||{})}});let d={};try{d=await r.json()}catch(e){}if(!r.ok||d.success===false)throw new Error(d.message||'Request failed');return d}
    $('saveProfile')?.addEventListener('click',async()=>{const b=$('saveProfile');b.disabled=true;try{await request('/profile/update',{method:'PUT',body:JSON.stringify({fullName:$('fullName').value,bio:$('bio').value,website:$('website').value,location:$('location').value})});notify('Profile updated successfully')}catch(e){notify(e.message,false)}finally{b.disabled=false}});
    $('profileImageInput')?.addEventListener('change',async e=>{const f=e.target.files?.[0];if(!f)return;const s=$('uploadStatus');s.textContent='Uploading...';const fd=new FormData();fd.append('profileImage',f);try{const r=await fetch('/profile/upload-image',{method:'POST',body:fd,credentials:'same-origin'});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Upload failed');$('profilePreview').src=d.imageURL;s.textContent='Profile photo updated';notify('Profile photo updated')}catch(err){s.textContent='Upload failed';notify(err.message,false)}});
    $('privateToggle')?.addEventListener('change',async e=>{try{await request('/profile/settings/privacy',{method:'PATCH',body:JSON.stringify({isPrivate:e.target.checked})});notify(e.target.checked?'Private account enabled':'Private account disabled')}catch(err){e.target.checked=!e.target.checked;notify(err.message,false)}});
    document.querySelectorAll('.notif').forEach(i=>i.addEventListener('change',async()=>{try{await request('/profile/settings/notifications',{method:'PATCH',body:JSON.stringify({[i.dataset.key]:i.checked})});notify('Notification preference saved')}catch(e){i.checked=!i.checked;notify(e.message,false)}}));
    $('saveBlog')?.addEventListener('click',async()=>{try{await request('/profile/settings/general',{method:'PATCH',body:JSON.stringify({blogSettings:{defaultVisibility:$('defaultVisibility').value,defaultCategory:$('defaultCategory').value,defaultTags:$('defaultTags').value.split(',').map(x=>x.trim()).filter(Boolean),allowLikes:$('allowLikes').checked,allowComments:$('allowComments').checked,showViewCount:$('showViewCount').checked,autoDrafts:$('autoDrafts').checked}})});notify('Blog settings saved')}catch(e){notify(e.message,false)}});
    $('saveComments')?.addEventListener('click',async()=>{try{await request('/profile/settings/general',{method:'PATCH',body:JSON.stringify({commentSettings:{allowComments:$('commentAllow').checked,moderateComments:$('moderateComments').checked,notifyReplies:$('notifyReplies').checked}})});notify('Comment settings saved')}catch(e){notify(e.message,false)}});
    $('saveInterface')?.addEventListener('click',async()=>{try{await request('/profile/settings/general',{method:'PATCH',body:JSON.stringify({interfaceSettings:{compactLayout:$('compactLayout').checked,reduceAnimations:$('reduceAnimations').checked}})});notify('Interface settings saved')}catch(e){notify(e.message,false)}});
    document.querySelectorAll('.theme button').forEach(b=>b.onclick=async()=>{try{await request('/profile/settings/theme',{method:'PATCH',body:JSON.stringify({theme:b.dataset.theme})});localStorage.setItem('blogify-theme',b.dataset.theme);applyTheme(b.dataset.theme);document.querySelectorAll('.theme button').forEach(x=>x.classList.toggle('active',x===b));notify('Theme saved')}catch(e){notify(e.message,false)}});
    function applyTheme(t){const dark=t==='dark'||(t==='system'&&matchMedia('(prefers-color-scheme:dark)').matches);document.documentElement.dataset.theme=dark?'dark':'light'}const saved=localStorage.getItem('blogify-theme')||'<%= user.theme || "system" %>';applyTheme(saved);document.querySelector(`.theme button[data-theme="${saved}"]`)?.classList.add('active');
    document.querySelectorAll('[data-unblock]').forEach(b=>b.addEventListener('click',async()=>{const id=b.dataset.unblock;if(!confirm('Unblock this user?'))return;b.disabled=true;try{await request('/profile/settings/unblock/'+encodeURIComponent(id),{method:'PATCH'});$('blocked-'+id)?.remove();if(!$('blockedList').querySelector('.row'))$('blockedList').innerHTML='<div class="field status">You have not blocked anyone.</div>';notify('User unblocked')}catch(e){b.disabled=false;notify(e.message,false)}}));
    $('changePassword')?.addEventListener('click',async()=>{const b=$('changePassword'),current=$('currentPassword').value,newPass=$('newPassword').value;if(!current||!newPass)return notify('Enter your current and new password',false);if(newPass.length<6)return notify('New password must be at least 6 characters',false);b.disabled=true;try{await request('/profile/change-password',{method:'POST',body:JSON.stringify({currentPassword:current,newPassword:newPass})});$('currentPassword').value='';$('newPassword').value='';notify('Password changed successfully')}catch(e){notify(e.message,false)}finally{b.disabled=false}});
    $('deleteAccount')?.addEventListener('click',async()=>{if(!confirm('Delete your Blogify account permanently? This cannot be undone.'))return;if(!confirm('Final confirmation: permanently delete your account and blogs?'))return;try{await request('/profile/delete-account',{method:'DELETE'});location.href='/'}catch(e){notify(e.message,false)}});
  })();
  </script>
</body>
</html>
