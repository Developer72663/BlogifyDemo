<!DOCTYPE html>
<html lang="en" data-theme="<%= user.theme === 'dark' ? 'dark' : 'light' %>">
<head>
    <%- include("./partials/head") %>
    <title>Settings | Blogify</title>
    <style>
        :root{--bg:#f6f7fb;--card:#fff;--text:#172033;--muted:#718096;--line:#e7eaf1;--primary:#635bff;--primary-soft:#efedff;--danger:#e5484d;--success:#159570;--shadow:0 18px 55px rgba(25,31,56,.08)}
        [data-theme="dark"]{--bg:#0c1018;--card:#151b27;--text:#f4f7fb;--muted:#98a3b5;--line:#283141;--primary:#8b83ff;--primary-soft:#25233f;--danger:#ff6b70;--success:#42c99f;--shadow:0 18px 55px rgba(0,0,0,.3)}
        *{box-sizing:border-box}.settings-page{min-height:100vh;background:var(--bg);color:var(--text);padding:104px 20px 60px;transition:.2s}
        .settings-shell{max-width:1180px;margin:auto}.settings-hero{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:26px}.settings-hero h1{font-size:2.2rem;margin:0 0 6px;font-weight:850;letter-spacing:-.04em}.settings-hero p{margin:0;color:var(--muted)}
        .mobile-section-select{display:none;width:100%;background:var(--card);border:1px solid var(--line);color:var(--text);border-radius:14px;padding:13px 15px;font-weight:700;margin-bottom:16px}
        .settings-layout{display:grid;grid-template-columns:245px minmax(0,1fr);gap:20px}.settings-menu,.settings-card{background:var(--card);border:1px solid var(--line);box-shadow:var(--shadow);border-radius:20px}.settings-menu{padding:10px;height:max-content;position:sticky;top:84px}.menu-label{padding:12px 13px 8px;text-transform:uppercase;font-size:.68rem;letter-spacing:.12em;color:var(--muted);font-weight:800}.settings-tab{display:flex;align-items:center;gap:11px;width:100%;padding:12px 13px;border:0;background:transparent;color:var(--muted);border-radius:12px;text-align:left;font-weight:750;cursor:pointer;transition:.18s}.settings-tab:hover{background:var(--primary-soft);color:var(--text)}.settings-tab.active{background:var(--primary-soft);color:var(--primary)}.settings-tab i{width:20px;text-align:center}.settings-card{padding:28px;min-height:560px}.settings-section{display:none}.settings-section.active{display:block;animation:fade .18s ease}@keyframes fade{from{opacity:.2;transform:translateY(4px)}to{opacity:1;transform:none}}
        .section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding-bottom:20px;border-bottom:1px solid var(--line);margin-bottom:22px}.section-head h2{margin:0 0 5px;font-size:1.35rem}.section-head p{margin:0;color:var(--muted);font-size:.9rem}.badge{font-size:.7rem;padding:6px 9px;border-radius:99px;background:var(--primary-soft);color:var(--primary);font-weight:800}
        .profile-top{display:flex;gap:18px;align-items:center;padding:18px;background:var(--bg);border:1px solid var(--line);border-radius:16px;margin-bottom:22px}.avatar{width:82px;height:82px;border-radius:50%;object-fit:cover;border:3px solid var(--card);box-shadow:0 5px 18px rgba(0,0,0,.12)}.profile-top h3{margin:0 0 4px}.profile-top p{margin:0;color:var(--muted);font-size:.88rem}.upload-btn{margin-top:9px;display:inline-flex;cursor:pointer;color:var(--primary);font-weight:800;font-size:.82rem}.upload-btn input{display:none}
        .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{margin-bottom:18px}.field.full{grid-column:1/-1}.field label{display:block;font-size:.82rem;font-weight:800;margin-bottom:7px}.input,.select,.textarea{width:100%;border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:11px;padding:12px 13px;outline:none;font:inherit;transition:.18s}.input:focus,.select:focus,.textarea:focus{border-color:var(--primary);box-shadow:0 0 0 3px color-mix(in srgb,var(--primary) 15%,transparent)}.textarea{resize:vertical;min-height:100px}.hint{font-size:.74rem;color:var(--muted);margin-top:5px}.actions{display:flex;gap:10px;margin-top:4px}.btn{border:0;border-radius:11px;padding:11px 16px;font-weight:800;cursor:pointer}.btn-primary{background:var(--primary);color:white}.btn-secondary{background:var(--bg);border:1px solid var(--line);color:var(--text)}.btn-danger{background:var(--danger);color:#fff}
        .option-list{display:grid;gap:10px}.option-row{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:17px;background:var(--bg);border:1px solid var(--line);border-radius:15px}.option-copy strong{display:block;margin-bottom:3px}.option-copy span{display:block;color:var(--muted);font-size:.82rem;line-height:1.45}.switch{position:relative;width:48px;height:28px;flex:0 0 auto}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;background:#aab2c0;border-radius:30px;cursor:pointer;transition:.2s}.slider:before{content:"";position:absolute;width:22px;height:22px;left:3px;top:3px;background:white;border-radius:50%;transition:.2s;box-shadow:0 2px 5px rgba(0,0,0,.2)}.switch input:checked+.slider{background:var(--primary)}.switch input:checked+.slider:before{transform:translateX(20px)}
        .theme-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.theme-choice{border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:14px;padding:18px 12px;text-align:center;cursor:pointer;font-weight:800}.theme-choice i{display:block;font-size:1.35rem;margin-bottom:8px;color:var(--primary)}.theme-choice.active{border:2px solid var(--primary);background:var(--primary-soft)}
        .security-box{padding:18px;background:var(--bg);border:1px solid var(--line);border-radius:15px;margin-bottom:14px}.security-box h3{font-size:1rem;margin:0 0 4px}.security-box p{margin:0 0 14px;color:var(--muted);font-size:.84rem}.danger{border:1px solid color-mix(in srgb,var(--danger) 35%,var(--line));background:color-mix(in srgb,var(--danger) 7%,var(--card));border-radius:15px;padding:18px;margin-top:24px}.danger h3{color:var(--danger);margin:0 0 5px}.danger p{color:var(--muted);font-size:.83rem;margin:0 0 14px}.toast-message{position:fixed;right:22px;bottom:22px;z-index:2000;padding:12px 16px;border-radius:12px;background:var(--text);color:var(--card);display:none;font-weight:700;box-shadow:var(--shadow)}
        @media(max-width:800px){.settings-layout{grid-template-columns:1fr}.settings-menu{display:none}.mobile-section-select{display:block}.settings-hero{align-items:flex-start}.settings-hero h1{font-size:1.8rem}.settings-card{padding:20px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.theme-grid{grid-template-columns:1fr}.option-row{align-items:flex-start}.settings-page{padding:88px 12px 40px}}
    </style>
</head>
<body>
    <%- include("./partials/nave") %>
    <main class="settings-page">
        <div class="settings-shell">
            <div class="settings-hero"><div><h1>Settings</h1><p>Control your Blogify account, privacy and experience.</p></div><span class="badge">Account preferences</span></div>
            <select class="mobile-section-select" id="mobileSectionSelect" aria-label="Settings section">
                <option value="profile">Profile</option><option value="appearance">Appearance</option><option value="privacy">Privacy</option><option value="notifications">Notifications</option><option value="security">Security</option><option value="account">Account</option>
            </select>
            <div class="settings-layout">
                <aside class="settings-menu">
                    <div class="menu-label">Settings</div>
                    <button class="settings-tab" data-section="profile"><i class="fas fa-user"></i> Profile</button>
                    <button class="settings-tab" data-section="appearance"><i class="fas fa-palette"></i> Appearance</button>
                    <button class="settings-tab" data-section="privacy"><i class="fas fa-shield-alt"></i> Privacy</button>
                    <button class="settings-tab" data-section="notifications"><i class="fas fa-bell"></i> Notifications</button>
                    <button class="settings-tab" data-section="security"><i class="fas fa-key"></i> Security</button>
                    <button class="settings-tab" data-section="account"><i class="fas fa-user-cog"></i> Account</button>
                </aside>

                <section class="settings-card">
                    <div id="profile" class="settings-section">
                        <div class="section-head"><div><h2>Profile</h2><p>Update the information people see on your profile.</p></div></div>
                        <div class="profile-top"><img class="avatar" id="profilePreview" src="<%= user.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'" alt="Profile"><div><h3><%= user.fullName %></h3><p><%= user.email %></p><label class="upload-btn">Change profile photo<input id="profileImageInput" type="file" accept="image/*"></label></div></div>
                        <div class="form-grid">
                            <div class="field"><label for="fullName">Full name</label><input class="input" id="fullName" value="<%= user.fullName %>" maxlength="100"></div>
                            <div class="field"><label for="location">Location</label><input class="input" id="location" value="<%= user.location || '' %>" placeholder="City, Country" maxlength="120"></div>
                            <div class="field full"><label for="bio">Bio</label><textarea class="textarea" id="bio" maxlength="500" placeholder="Tell readers about yourself"><%= user.bio || '' %></textarea><div class="hint"><span id="bioCount">0</span>/500 characters</div></div>
                            <div class="field full"><label for="website">Website</label><input class="input" id="website" type="url" value="<%= user.website || '' %>" placeholder="https://example.com"></div>
                        </div><div class="actions"><button class="btn btn-primary" id="saveProfile">Save profile</button></div>
                    </div>

                    <div id="appearance" class="settings-section">
                        <div class="section-head"><div><h2>Appearance</h2><p>Choose how Blogify looks on your devices.</p></div></div>
                        <div class="theme-grid">
                            <button class="theme-choice" data-theme-choice="light"><i class="fas fa-sun"></i>Light</button>
                            <button class="theme-choice" data-theme-choice="dark"><i class="fas fa-moon"></i>Dark</button>
                            <button class="theme-choice" data-theme-choice="system"><i class="fas fa-desktop"></i>System</button>
                        </div>
                        <div class="option-row" style="margin-top:16px"><div class="option-copy"><strong>Use system preference</strong><span>Automatically switch between light and dark when your device changes.</span></div><label class="switch"><input type="checkbox" id="systemThemeToggle"><span class="slider"></span></label></div>
                    </div>

                    <div id="privacy" class="settings-section">
                        <div class="section-head"><div><h2>Privacy</h2><p>Choose who can discover and interact with your content.</p></div></div>
                        <div class="option-list"><div class="option-row"><div class="option-copy"><strong>Private account</strong><span>Only people who follow you can access content that is restricted by your account privacy.</span></div><label class="switch"><input type="checkbox" id="privateToggle" <%= user.isPrivate ? 'checked' : '' %>><span class="slider"></span></label></div></div>
                    </div>

                    <div id="notifications" class="settings-section">
                        <div class="section-head"><div><h2>Notifications</h2><p>Pick which email updates you want to receive.</p></div></div>
                        <div class="option-list">
                            <div class="option-row"><div class="option-copy"><strong>Comments</strong><span>Notify me when someone comments on my blog.</span></div><label class="switch"><input class="notification-toggle" data-key="emailOnComment" type="checkbox" <%= user.notificationSettings?.emailOnComment !== false ? 'checked' : '' %>><span class="slider"></span></label></div>
                            <div class="option-row"><div class="option-copy"><strong>New followers</strong><span>Notify me when someone starts following me.</span></div><label class="switch"><input class="notification-toggle" data-key="emailOnNewFollower" type="checkbox" <%= user.notificationSettings?.emailOnNewFollower !== false ? 'checked' : '' %>><span class="slider"></span></label></div>
                            <div class="option-row"><div class="option-copy"><strong>Email digest</strong><span>Receive a periodic summary of important Blogify activity.</span></div><label class="switch"><input class="notification-toggle" data-key="emailDigest" type="checkbox" <%= user.notificationSettings?.emailDigest !== false ? 'checked' : '' %>><span class="slider"></span></label></div>
                        </div>
                    </div>

                    <div id="security" class="settings-section">
                        <div class="section-head"><div><h2>Security</h2><p>Protect your account with a strong password.</p></div></div>
                        <% if (user.googleId && !user.password) { %><div class="security-box"><h3>Google account</h3><p>Your account uses Google Sign-In. Password changes are managed by Google.</p></div><% } else { %>
                        <div class="form-grid"><div class="field full"><label>Current password</label><input class="input" id="currentPassword" type="password" autocomplete="current-password"></div><div class="field"><label>New password</label><input class="input" id="newPassword" type="password" minlength="6" autocomplete="new-password"></div><div class="field"><label>Confirm password</label><input class="input" id="confirmPassword" type="password" minlength="6" autocomplete="new-password"></div></div><div class="actions"><button class="btn btn-primary" id="changePassword">Update password</button></div><% } %>
                    </div>

                    <div id="account" class="settings-section">
                        <div class="section-head"><div><h2>Account</h2><p>Review your account information and permanent actions.</p></div></div>
                        <div class="security-box"><h3><%= user.fullName %></h3><p><%= user.email %> · Member since <%= new Date(user.createdAt).toLocaleDateString() %></p></div>
                        <div class="danger"><h3>Delete account</h3><p>This permanently deletes your account and your blogs. This action cannot be undone.</p><button class="btn btn-danger" id="deleteAccount">Delete my account</button></div>
                    </div>
                </section>
            </div>
        </div>
    </main>
    <div class="toast-message" id="settingsToast"></div>
    <script>
        const initialSection = '<%= activeSection || "profile" %>';
        const savedTheme = '<%= user.theme || "system" %>';
        const sections = ['profile','appearance','privacy','notifications','security','account'];
        const $ = (id) => document.getElementById(id);
        const toast = (message, error=false) => { const el=$('settingsToast'); el.textContent=message; el.style.display='block'; el.style.background=error?'#c92a31':'var(--text)'; clearTimeout(window.__toast); window.__toast=setTimeout(()=>el.style.display='none',2600); };
        const api = async (url, options={}) => { const response=await fetch(url,{headers:{'Content-Type':'application/json',...(options.headers||{})},...options}); const data=await response.json().catch(()=>({})); if(!response.ok||data.success===false) throw new Error(data.message||'Something went wrong'); return data; };

        function applyTheme(theme){
            const dark=theme==='dark'||(theme==='system'&&window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.dataset.theme=dark?'dark':'light'; localStorage.setItem('blogify-theme',theme);
            document.querySelectorAll('[data-theme-choice]').forEach(b=>b.classList.toggle('active',b.dataset.themeChoice===theme));
            $('systemThemeToggle').checked=theme==='system';
        }
        function openSection(name, push=true){
            if(!sections.includes(name)) name='profile';
            document.querySelectorAll('.settings-section').forEach(s=>s.classList.toggle('active',s.id===name));
            document.querySelectorAll('.settings-tab').forEach(b=>b.classList.toggle('active',b.dataset.section===name));
            $('mobileSectionSelect').value=name;
            if(push) history.replaceState(null,'','#'+name);
        }
        document.querySelectorAll('.settings-tab').forEach(b=>b.addEventListener('click',()=>openSection(b.dataset.section)));
        $('mobileSectionSelect').addEventListener('change',e=>openSection(e.target.value));
        document.querySelectorAll('[data-theme-choice]').forEach(b=>b.addEventListener('click',async()=>{try{const theme=b.dataset.themeChoice; await api('/user/profile/settings/theme',{method:'PATCH',body:JSON.stringify({theme})}); applyTheme(theme); toast('Appearance saved');}catch(e){toast(e.message,true);}}));
        $('systemThemeToggle').addEventListener('change',e=>{if(e.target.checked) document.querySelector('[data-theme-choice="system"]').click();});
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',()=>{if(localStorage.getItem('blogify-theme')==='system') applyTheme('system');});

        $('bio').addEventListener('input',()=>$('bioCount').textContent=$('bio').value.length); $('bioCount').textContent=$('bio').value.length;
        $('saveProfile').addEventListener('click',async()=>{try{await api('/user/profile/update',{method:'PUT',body:JSON.stringify({fullName:$('fullName').value,bio:$('bio').value,website:$('website').value,location:$('location').value})});toast('Profile saved successfully');}catch(e){toast(e.message,true);}});
        $('profileImageInput').addEventListener('change',async e=>{const file=e.target.files[0];if(!file)return;if(file.size>5*1024*1024){toast('Image must be under 5MB',true);return;}const form=new FormData();form.append('profileImage',file);try{const response=await fetch('/user/profile/upload-image',{method:'POST',body:form});const data=await response.json();if(!response.ok||!data.success)throw new Error(data.message||'Upload failed');$('profilePreview').src=data.imageURL;toast('Profile photo updated');}catch(err){toast(err.message,true);}});
        $('privateToggle').addEventListener('change',async e=>{try{await api('/user/profile/settings/privacy',{method:'PATCH',body:JSON.stringify({isPrivate:e.target.checked})});toast(e.target.checked?'Account is now private':'Account is now public');}catch(err){e.target.checked=!e.target.checked;toast(err.message,true);}});
        document.querySelectorAll('.notification-toggle').forEach(input=>input.addEventListener('change',async e=>{try{await api('/user/profile/settings/notifications',{method:'PATCH',body:JSON.stringify({[e.target.dataset.key]:e.target.checked})});toast('Notification preference saved');}catch(err){e.target.checked=!e.target.checked;toast(err.message,true);}}));
        if($('changePassword')) $('changePassword').addEventListener('click',async()=>{if($('newPassword').value!==$('confirmPassword').value){toast('New passwords do not match',true);return;}try{await api('/user/profile/change-password',{method:'POST',body:JSON.stringify({currentPassword:$('currentPassword').value,newPassword:$('newPassword').value})});$('currentPassword').value='';$('newPassword').value='';$('confirmPassword').value='';toast('Password updated successfully');}catch(e){toast(e.message,true);}});
        $('deleteAccount').addEventListener('click',async()=>{if(!confirm('Delete your account and all your blogs? This cannot be undone.'))return;try{await api('/user/profile/delete-account',{method:'DELETE'});window.location.href='/';}catch(e){toast(e.message,true);}});

        const hash=location.hash.slice(1); openSection(sections.includes(hash)?hash:initialSection,false); applyTheme(savedTheme); 
    </script>
</body>
</html>
