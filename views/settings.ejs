<!DOCTYPE html><html lang="en"><head><%- include("./partials/head") %><title>Settings | Blogify</title><style>
:root{--set-bg:var(--page);--set-card:var(--surface);--set-soft:var(--soft);--set-line:var(--border);--set-text:var(--heading);--set-muted:var(--muted)}
.settings-page{max-width:1080px;margin:auto;padding:34px 16px 70px}.settings-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}.settings-head h1{font-size:2.35rem;letter-spacing:-.055em;font-weight:850;margin:0}.settings-head p{color:var(--set-muted);margin:6px 0 0}.settings-back{border:1px solid var(--set-line);background:var(--set-card);color:var(--set-text);padding:9px 15px;border-radius:12px;text-decoration:none;font-weight:700}.settings-wrap{display:grid;grid-template-columns:210px 1fr;gap:26px}.settings-menu{display:flex;flex-direction:column;gap:4px}.menu-label{font-size:.68rem;text-transform:uppercase;letter-spacing:.12em;color:var(--set-muted);font-weight:800;padding:0 12px 8px}.menu-btn{border:0;background:transparent;color:var(--set-muted);padding:11px 12px;border-radius:10px;text-align:left;font-weight:650;display:flex;gap:11px;align-items:center}.menu-btn i{width:18px;text-align:center}.menu-btn:hover{background:var(--set-soft);color:var(--set-text)}.menu-btn.active{background:var(--primary);color:#fff}.settings-content{min-width:0}.settings-section{display:none}.settings-section.active{display:block}.section-title{margin-bottom:18px}.section-title h2{font-size:1.35rem;font-weight:820;margin:0}.section-title p{color:var(--set-muted);margin:5px 0 0;font-size:.88rem}.block{background:var(--set-card);border:1px solid var(--set-line);border-radius:16px;margin-bottom:14px;overflow:hidden}.row{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:17px 19px;border-bottom:1px solid var(--set-line)}.row:last-child{border-bottom:0}.row-title{font-weight:750;color:var(--set-text)}.row-desc{font-size:.79rem;color:var(--set-muted);margin-top:4px;line-height:1.45}.control{flex:none}.input{width:100%;background:var(--set-card);border:1px solid var(--set-line);color:var(--set-text);border-radius:10px;padding:11px 12px;outline:0}.input:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(99,102,241,.12)}.field{padding:18px 19px}.field label{display:block;font-weight:700;font-size:.8rem;margin-bottom:7px}.profile-card{display:flex;align-items:center;gap:16px;padding:20px;background:var(--set-card);border:1px solid var(--set-line);border-radius:16px;margin-bottom:14px}.profile-card img{width:72px;height:72px;border-radius:50%;object-fit:cover}.photo-btn{color:var(--primary);font-weight:750;cursor:pointer}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.btn-main{background:var(--primary);border:0;color:#fff;padding:10px 15px;border-radius:10px;font-weight:750}.btn-muted{background:var(--set-soft);border:1px solid var(--set-line);color:var(--set-text);padding:10px 15px;border-radius:10px;font-weight:750;text-decoration:none}.switch{position:relative;width:44px;height:25px}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;background:#9299a6;border-radius:20px;cursor:pointer}.slider:before{content:"";position:absolute;width:19px;height:19px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}.switch input:checked+.slider{background:var(--primary)}.switch input:checked+.slider:before{transform:translateX(19px)}.theme-choice{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.theme-choice button{border:1px solid var(--set-line);background:var(--set-card);color:var(--set-text);border-radius:13px;padding:18px 12px;text-align:center;font-weight:750}.theme-choice button i{display:block;font-size:1.35rem;margin-bottom:9px;color:var(--primary)}.theme-choice button.active{outline:2px solid var(--primary);background:var(--set-soft)}.mobile-menu{display:none;width:100%;margin-bottom:18px;padding:11px;border-radius:11px;background:var(--set-card);color:var(--set-text);border:1px solid var(--set-line)}.danger{border-color:#ef4444}.danger .row-title{color:#dc2626}.danger-btn{background:#dc2626;color:#fff;border:0;padding:9px 13px;border-radius:9px;font-weight:750}@media(max-width:760px){.settings-page{padding:24px 12px 55px}.settings-head{align-items:flex-start;gap:12px}.settings-head h1{font-size:1.9rem}.settings-back{font-size:.82rem}.settings-wrap{display:block}.settings-menu{display:none}.mobile-menu{display:block}.grid{grid-template-columns:1fr}.theme-choice{grid-template-columns:1fr}.row{padding:15px}.profile-card{align-items:flex-start}}
</style></head><body><%- include("./partials/nave") %><main class="settings-page"><header class="settings-head"><div><h1>Settings</h1><p>Manage your Blogify account and experience.</p></div><a class="settings-back" href="/">← Back</a></header><select id="mobileMenu" class="mobile-menu"><option value="profile">Profile</option><option value="privacy">Privacy</option><option value="social">Followers & Following</option><option value="notifications">Notifications</option><option value="blog">Blog & Writing</option><option value="comments">Comments</option><option value="appearance">Appearance</option><option value="security">Security</option><option value="blocked">Blocked Users</option><option value="account">Account</option><option value="about">About</option></select><div class="settings-wrap"><nav class="settings-menu"><div class="menu-label">Account</div><button class="menu-btn" data-section="profile"><i class="fas fa-user"></i>Profile</button><button class="menu-btn" data-section="privacy"><i class="fas fa-shield-halved"></i>Privacy</button><button class="menu-btn" data-section="social"><i class="fas fa-users"></i>Followers</button><button class="menu-btn" data-section="notifications"><i class="fas fa-bell"></i>Notifications</button><div class="menu-label mt-3">Content</div><button class="menu-btn" data-section="blog"><i class="fas fa-pen"></i>Blog & Writing</button><button class="menu-btn" data-section="comments"><i class="fas fa-comment"></i>Comments</button><div class="menu-label mt-3">App</div><button class="menu-btn" data-section="appearance"><i class="fas fa-palette"></i>Appearance</button><button class="menu-btn" data-section="security"><i class="fas fa-lock"></i>Security</button><button class="menu-btn" data-section="blocked"><i class="fas fa-user-slash"></i>Blocked</button><button class="menu-btn" data-section="account"><i class="fas fa-user-gear"></i>Account</button><button class="menu-btn" data-section="about"><i class="fas fa-circle-info"></i>About</button></nav><section class="settings-content">
<div id="profile" class="settings-section"><div class="section-title"><h2>Profile</h2><p>Your public identity on Blogify.</p></div><div class="profile-card"><img id="profilePreview" src="<%= user.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'"><div><div class="row-title"><%= user.fullName %></div><label class="photo-btn">Change profile photo<input id="profileImageInput" type="file" accept="image/*" hidden></label><small id="uploadStatus" class="d-block text-muted">JPG, PNG, WEBP and other image types</small></div></div><div class="block"><div class="grid"><div class="field"><label>Full name</label><input id="fullName" class="input" value="<%= user.fullName %>"></div><div class="field"><label>Location</label><input id="location" class="input" value="<%= user.location || '' %>"></div></div><div class="field"><label>Bio</label><textarea id="bio" class="input" rows="4"><%= user.bio || '' %></textarea></div><div class="field"><label>Website</label><input id="website" class="input" value="<%= user.website || '' %>"></div><div class="field"><button id="saveProfile" class="btn-main">Save changes</button></div></div></div>
<div id="privacy" class="settings-section"><div class="section-title"><h2>Privacy</h2><p>Choose who can see and interact with your content.</p></div><div class="block"><div class="row"><div><div class="row-title">Private account</div><div class="row-desc">Only approved followers can see your posts and social lists.</div></div><label class="switch"><input id="privateToggle" type="checkbox" <%= user.isPrivate?'checked':'' %>><span class="slider"></span></label></div><div class="row"><div><div class="row-title">Follow requests</div><div class="row-desc">Review people waiting to follow your private account.</div></div><a class="btn-muted" href="/follow/requests/page">Manage</a></div></div></div>
<div id="social" class="settings-section"><div class="section-title"><h2>Followers & Following</h2><p>Manage your social connections.</p></div><div class="block"><div class="row"><div><div class="row-title">Followers</div><div class="row-desc"><%= user.followers?.length || 0 %> people follow you.</div></div><a class="btn-muted" href="/user/profile">View</a></div><div class="row"><div><div class="row-title">Following</div><div class="row-desc">You follow <%= user.following?.length || 0 %> accounts.</div></div><a class="btn-muted" href="/user/profile">View</a></div></div></div>
<div id="notifications" class="settings-section"><div class="section-title"><h2>Notifications</h2><p>Control the activity you want to hear about.</p></div><div class="block"><% const ns=user.notificationSettings||{}; const notif=[['emailOnComment','Comments','When someone comments on your blog.'],['emailOnNewFollower','New followers','When someone follows you.'],['emailOnFollowRequest','Follow requests','When someone requests to follow you.'],['emailOnRequestAccepted','Accepted requests','When a request is accepted.'],['emailOnLike','Likes','When someone likes your blog.'],['emailOnMention','Mentions','When someone mentions you.'],['emailDigest','Email digest','Periodic activity summaries.']]; notif.forEach(([key,title,desc])=>{ %><div class="row"><div><div class="row-title"><%= title %></div><div class="row-desc"><%= desc %></div></div><label class="switch"><input class="notif" data-key="<%= key %>" type="checkbox" <%= ns[key]!==false?'checked':'' %>><span class="slider"></span></label></div><% }) %></div></div>
<div id="blog" class="settings-section"><div class="section-title"><h2>Blog & Writing</h2><p>Set defaults for your writing workflow.</p></div><div class="block"><div class="field"><label>Default visibility</label><select id="defaultVisibility" class="input"><option value="public">Public</option><option value="followers">Followers only</option></select></div><div class="grid"><div class="field"><label>Default category</label><input id="defaultCategory" class="input" value="<%= user.blogSettings?.defaultCategory || '' %>"></div><div class="field"><label>Default tags</label><input id="defaultTags" class="input" value="<%= (user.blogSettings?.defaultTags||[]).join(', ') %>"></div></div><div class="row"><div><div class="row-title">Allow likes</div><div class="row-desc">Readers can like your blogs.</div></div><label class="switch"><input id="allowLikes" type="checkbox" checked><span class="slider"></span></label></div><div class="row"><div><div class="row-title">Allow comments</div><div class="row-desc">Readers can comment on your blogs.</div></div><label class="switch"><input id="blogComments" type="checkbox" checked><span class="slider"></span></label></div><div class="field"><button id="saveBlog" class="btn-main">Save blog settings</button></div></div></div>
<div id="comments" class="settings-section"><div class="section-title"><h2>Comments</h2><p>Control conversations around your posts.</p></div><div class="block"><div class="row"><div><div class="row-title">Allow comments</div><div class="row-desc">Enable comments across your blogs.</div></div><label class="switch"><input id="commentAllow" type="checkbox" <%= user.commentSettings?.allowComments!==false?'checked':'' %>><span class="slider"></span></label></div><div class="row"><div><div class="row-title">Moderate comments</div><div class="row-desc">Review comments before they appear.</div></div><label class="switch"><input id="moderateComments" type="checkbox" <%= user.commentSettings?.moderateComments?'checked':'' %>><span class="slider"></span></label></div><div class="row"><div><div class="row-title">Reply notifications</div><div class="row-desc">Get notified when someone replies.</div></div><label class="switch"><input id="notifyReplies" type="checkbox" checked><span class="slider"></span></label></div><div class="field"><button id="saveComments" class="btn-main">Save comment settings</button></div></div></div>
<div id="appearance" class="settings-section"><div class="section-title"><h2>Appearance</h2><p>Choose the look that feels right for you.</p></div><div class="block"><div class="field"><div class="theme-choice"><button data-theme="light"><i class="fas fa-sun"></i>Light<small class="d-block text-muted">Always light</small></button><button data-theme="dark"><i class="fas fa-moon"></i>Dark<small class="d-block text-muted">Always dark</small></button><button data-theme="system"><i class="fas fa-desktop"></i>System<small class="d-block text-muted">Follow device</small></button></div></div></div></div>
<div id="security" class="settings-section"><div class="section-title"><h2>Security</h2><p>Protect access to your account.</p></div><div class="block"><div class="row"><div><div class="row-title">Password</div><div class="row-desc">Change your account password.</div></div><a class="btn-muted" href="/user/change-password">Change</a></div></div></div><div id="blocked" class="settings-section"><div class="section-title"><h2>Blocked Users</h2><p>Manage accounts you have blocked.</p></div><div class="block"><div id="blockedList" class="field text-muted">No blocked users loaded.</div></div></div><div id="account" class="settings-section"><div class="section-title"><h2>Account</h2><p>Manage your account lifecycle.</p></div><div class="block danger"><div class="row"><div><div class="row-title">Delete account</div><div class="row-desc">Permanently remove your account and content.</div></div><button id="deleteAccount" class="danger-btn">Delete account</button></div></div></div><div id="about" class="settings-section"><div class="section-title"><h2>About Blogify</h2><p>Information about this application.</p></div><div class="block"><div class="field"><div class="row-title">Blogify</div><div class="row-desc">Write, discover and connect through stories.</div></div></div></div>
</section></div></main><%- include("./partials/scripts") %><script>
(()=>{const buttons=[...document.querySelectorAll('.menu-btn')],sections=[...document.querySelectorAll('.settings-section')],mobile=document.getElementById('mobileMenu');function show(id){sections.forEach(s=>s.classList.toggle('active',s.id===id));buttons.forEach(b=>b.classList.toggle('active',b.dataset.section===id));if(mobile)mobile.value=id;history.replaceState(null,'','#'+id)}function init(){const id=location.hash.slice(1);show(sections.some(s=>s.id===id)?id:'profile')}buttons.forEach(b=>b.addEventListener('click',()=>show(b.dataset.section)));mobile?.addEventListener('change',e=>show(e.target.value));init();document.querySelectorAll('.theme-choice button').forEach(b=>b.addEventListener('click',()=>{const t=b.dataset.theme;localStorage.setItem('blogify-theme',t);document.documentElement.dataset.theme=t==='dark'||(t==='system'&&matchMedia('(prefers-color-scheme:dark)').matches)?'dark':'light';document.querySelectorAll('.theme-choice button').forEach(x=>x.classList.toggle('active',x===b))}));const current=localStorage.getItem('blogify-theme')||'system';document.querySelector(`.theme-choice button[data-theme="${current}"]`)?.classList.add('active')})();
</script></body></html>