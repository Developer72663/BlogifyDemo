<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title>Settings | Blogify</title>
  <style>
    :root{--set-card:var(--surface);--set-soft:var(--soft);--set-line:var(--border);--set-text:var(--heading);--set-muted:var(--muted)}
    .settings-page{max-width:1120px;margin:auto;padding:32px 16px 80px}.settings-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:24px}.settings-head h1{margin:0;font-size:2.3rem;font-weight:850;letter-spacing:-.05em}.settings-head p{margin:6px 0 0;color:var(--set-muted)}
    .top-actions{display:flex;gap:8px;flex-wrap:wrap}.settings-back,.quick-link{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--set-line);background:var(--set-card);color:var(--set-text);padding:9px 13px;border-radius:11px;text-decoration:none;font-weight:750}.quick-link:hover,.settings-back:hover{background:var(--set-soft);color:var(--set-text)}
    .quick-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:26px}.quick-card{display:flex;align-items:center;gap:12px;padding:15px;border:1px solid var(--set-line);background:var(--set-card);border-radius:15px;color:var(--set-text);text-decoration:none}.quick-card i{width:40px;height:40px;display:grid;place-items:center;border-radius:12px;background:var(--set-soft);color:var(--primary)}.quick-card strong{display:block}.quick-card small{display:block;color:var(--set-muted);margin-top:2px}
    .settings-wrap{display:grid;grid-template-columns:220px minmax(0,1fr);gap:25px}.settings-menu{display:flex;flex-direction:column;gap:4px;position:sticky;top:18px;height:max-content}.menu-label{font-size:.66rem;text-transform:uppercase;letter-spacing:.12em;color:var(--set-muted);font-weight:850;padding:8px 12px}.menu-btn{border:0;background:transparent;color:var(--set-muted);padding:11px 12px;border-radius:11px;text-align:left;font-weight:700;display:flex;gap:10px;align-items:center;cursor:pointer}.menu-btn i{width:18px;text-align:center}.menu-btn:hover{background:var(--set-soft);color:var(--set-text)}.menu-btn.active{background:var(--primary);color:#fff}.settings-section{display:none}.settings-section.active{display:block}.section-title{margin-bottom:17px}.section-title h2{margin:0;font-size:1.4rem;font-weight:850}.section-title p{margin:5px 0 0;color:var(--set-muted);font-size:.88rem}.block{background:var(--set-card);border:1px solid var(--set-line);border-radius:16px;overflow:hidden;margin-bottom:14px}.row{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:16px 18px;border-bottom:1px solid var(--set-line)}.row:last-child{border-bottom:0}.row-title{font-weight:800;color:var(--set-text)}.row-desc{font-size:.79rem;color:var(--set-muted);margin-top:4px;line-height:1.45}.field{padding:17px 18px}.field label{display:block;font-size:.8rem;font-weight:750;margin-bottom:7px}.input{width:100%;box-sizing:border-box;background:var(--set-card);border:1px solid var(--set-line);color:var(--set-text);border-radius:10px;padding:11px 12px;outline:0}.input:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(99,102,241,.12)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:0}.btn-main{background:var(--primary);border:0;color:#fff;padding:10px 15px;border-radius:10px;font-weight:800;cursor:pointer}.btn-muted{display:inline-flex;align-items:center;gap:6px;background:var(--set-soft);border:1px solid var(--set-line);color:var(--set-text);padding:9px 13px;border-radius:10px;font-weight:750;text-decoration:none;cursor:pointer}.btn-muted:hover{color:var(--set-text)}
    .profile-card{display:flex;align-items:center;gap:15px;padding:18px;background:var(--set-card);border:1px solid var(--set-line);border-radius:16px;margin-bottom:14px}.profile-card img{width:72px;height:72px;border-radius:50%;object-fit:cover}.photo-btn{color:var(--primary);font-weight:800;cursor:pointer}.switch{position:relative;width:44px;height:25px;flex:0 0 auto}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;background:#9299a6;border-radius:20px;cursor:pointer}.slider:before{content:"";position:absolute;width:19px;height:19px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}.switch input:checked+.slider{background:var(--primary)}.switch input:checked+.slider:before{transform:translateX(19px)}
    .theme-choice{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.theme-choice button{border:1px solid var(--set-line);background:var(--set-card);color:var(--set-text);border-radius:13px;padding:18px 12px;text-align:center;font-weight:800;cursor:pointer}.theme-choice button i{display:block;font-size:1.35rem;margin-bottom:8px;color:var(--primary)}.theme-choice button.active{outline:2px solid var(--primary);background:var(--set-soft)}.mobile-menu{display:none;width:100%;margin-bottom:18px;padding:11px;border-radius:11px;background:var(--set-card);color:var(--set-text);border:1px solid var(--set-line)}.danger{border-color:#ef4444}.danger .row-title{color:#dc2626}.danger-btn{background:#dc2626;color:#fff;border:0;padding:9px 13px;border-radius:9px;font-weight:800;cursor:pointer}.blocked-user{display:flex;align-items:center;gap:12px}.blocked-user img{width:42px;height:42px;border-radius:50%;object-fit:cover}.status{font-size:.78rem;color:var(--set-muted)}
    @media(max-width:850px){.settings-wrap{grid-template-columns:1fr}.settings-menu{display:none}.mobile-menu{display:block}.quick-grid{grid-template-columns:1fr}.settings-head{flex-direction:column}.top-actions{width:100%}.grid{grid-template-columns:1fr}}
    @media(max-width:560px){.settings-page{padding:22px 12px 60px}.settings-head h1{font-size:1.9rem}.top-actions a{flex:1;justify-content:center}.row{align-items:flex-start;padding:14px}.row .switch{margin-top:2px}.theme-choice{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <%- include("./partials/nave") %>
  <main class="settings-page">
    <header class="settings-head">
      <div><h1>Settings</h1><p>Manage your Blogify account, privacy, notifications and writing experience.</p></div>
      <div class="top-actions"><a class="settings-back" href="/user/profile"><i class="fas fa-user"></i> Visit Profile</a><a class="settings-back" href="/analytics"><i class="fas fa-chart-line"></i> Analytics</a><a class="settings-back" href="/notification"><i class="fas fa-bell"></i> Notifications</a></div>
    </header>

    <div class="quick-grid">
      <a class="quick-card" href="/user/profile"><i class="fas fa-id-card"></i><span><strong>My Profile</strong><small>View your public profile</small></span></a>
      <a class="quick-card" href="/analytics"><i class="fas fa-chart-column"></i><span><strong>Creator Analytics</strong><small>Views, likes and comments</small></span></a>
      <a class="quick-card" href="/notification"><i class="fas fa-bell"></i><span><strong>Notification Center</strong><small>Manage and read activity</small></span></a>
    </div>

    <select id="mobileMenu" class="mobile-menu">
      <option value="profile">Profile</option><option value="privacy">Privacy & Safety</option><option value="social">Followers & Following</option><option value="notifications">Notifications</option><option value="blog">Blog & Writing</option><option value="comments">Comments</option><option value="appearance">Appearance</option><option value="security">Security</option><option value="blocked">Blocked Users</option><option value="account">Account</option><option value="about">About</option>
    </select>

    <div class="settings-wrap">
      <nav class="settings-menu">
        <div class="menu-label">Account</div><button class="menu-btn" data-section="profile"><i class="fas fa-user"></i>Profile</button><button class="menu-btn" data-section="privacy"><i class="fas fa-shield-halved"></i>Privacy & Safety</button><button class="menu-btn" data-section="social"><i class="fas fa-users"></i>Followers</button><button class="menu-btn" data-section="notifications"><i class="fas fa-bell"></i>Notifications</button>
        <div class="menu-label">Content</div><button class="menu-btn" data-section="blog"><i class="fas fa-pen"></i>Blog & Writing</button><button class="menu-btn" data-section="comments"><i class="fas fa-comment"></i>Comments</button>
        <div class="menu-label">App</div><button class="menu-btn" data-section="appearance"><i class="fas fa-palette"></i>Appearance</button><button class="menu-btn" data-section="security"><i class="fas fa-lock"></i>Security</button><button class="menu-btn" data-section="blocked"><i class="fas fa-user-slash"></i>Blocked Users</button><button class="menu-btn" data-section="account"><i class="fas fa-user-gear"></i>Account</button><button class="menu-btn" data-section="about"><i class="fas fa-circle-info"></i>About</button>
      </nav>

      <section class="settings-content">
        <div id="profile" class="settings-section"><div class="section-title"><h2>Profile</h2><p>Manage the information visitors see on your profile.</p></div>
          <div class="profile-card"><img id="profilePreview" src="<%= user.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'"><div><div class="row-title"><%= user.fullName %></div><label class="photo-btn">Change profile photo<input id="profileImageInput" type="file" accept="image/*" hidden></label><small id="uploadStatus" class="d-block status">JPG, PNG, WEBP and other image types</small></div></div>
          <div class="block"><div class="grid"><div class="field"><label>Full name</label><input id="fullName" class="input" value="<%= user.fullName %>"></div><div class="field"><label>Location</label><input id="location" class="input" value="<%= user.location || '' %>"></div></div><div class="field"><label>Bio</label><textarea id="bio" class="input" rows="4"><%= user.bio || '' %></textarea></div><div class="field"><label>Website</label><input id="website" class="input" value="<%= user.website || '' %>"></div><div class="field"><button id="saveProfile" class="btn-main">Save profile changes</button></div></div>
        </div>

        <div id="privacy" class="settings-section"><div class="section-title"><h2>Privacy & Safety</h2><p>Control account visibility and keep unwanted users away.</p></div><div class="block"><div class="row"><div><div class="row-title">Private account</div><div class="row-desc">Only approved followers can see your private social content.</div></div><label class="switch"><input id="privateToggle" type="checkbox" <%= user.isPrivate?'checked':'' %>><span class="slider"></span></label></div><div class="row"><div><div class="row-title">Follow requests</div><div class="row-desc">Review people waiting to follow your private account.</div></div><a class="btn-muted" href="/follow/requests/page"><i class="fas fa-user-clock"></i> Manage</a></div><div class="row"><div><div class="row-title">Blocked users</div><div class="row-desc">View and unblock accounts you have blocked.</div></div><button class="btn-muted" data-open="blocked">Manage</button></div></div></div>

        <div id="social" class="settings-section"><div class="section-title"><h2>Followers & Following</h2><p>Quick access to your social connections.</p></div><div class="block"><div class="row"><div><div class="row-title">Followers</div><div class="row-desc"><%= user.followers?.length || 0 %> people follow you.</div></div><a class="btn-muted" href="/user/profile"><i class="fas fa-users"></i> View profile</a></div><div class="row"><div><div class="row-title">Following</div><div class="row-desc">You follow <%= user.following?.length || 0 %> accounts.</div></div><a class="btn-muted" href="/user/profile"><i class="fas fa-user-plus"></i> View profile</a></div></div></div>

        <div id="notifications" class="settings-section"><div class="section-title"><h2>Notifications</h2><p>Choose exactly what Blogify may send by email or web push.</p></div>
          <% const ns=user.notificationSettings||{}; const email=[['emailOnComment','Comments','When someone comments on your blog.'],['emailOnNewFollower','New followers','When someone follows you.'],['emailOnFollowRequest','Follow requests','When someone requests to follow you.'],['emailOnRequestAccepted','Accepted requests','When a follow request is accepted.'],['emailOnLike','Likes','When someone likes your blog.'],['emailOnMention','Mentions','When someone mentions you.'],['emailDigest','Email digest','Periodic activity summaries.']]; %>
          <div class="block"><div class="row"><div><div class="row-title">Web Push Notifications</div><div class="row-desc">Allow Blogify to send notifications when the browser supports push.</div></div><label class="switch"><input class="notif" data-key="pushEnabled" id="pushEnabled" type="checkbox" <%= ns.pushEnabled?'checked':'' %>><span class="slider"></span></label></div><% [['pushOnMessage','Messages'],['pushOnComment','Comments'],['pushOnReply','Replies'],['pushOnLike','Likes'],['pushOnFollow','New followers'],['pushOnFollowRequest','Follow requests'],['pushOnMention','Mentions'],['pushOnBlogPost','New blogs from followed users']].forEach(([key,title])=>{ %><div class="row"><div><div class="row-title"><%= title %></div><div class="row-desc">Receive this activity as a web push notification.</div></div><label class="switch"><input class="notif" data-key="<%= key %>" type="checkbox" <%= ns[key]!==false?'checked':'' %>><span class="slider"></span></label></div><% }) %></div>
          <div class="block"><% email.forEach(([key,title,desc])=>{ %><div class="row"><div><div class="row-title"><%= title %></div><div class="row-desc"><%= desc %></div></div><label class="switch"><input class="notif" data-key="<%= key %>" type="checkbox" <%= ns[key]!==false?'checked':'' %>><span class="slider"></span></label></div><% }) %></div>
          <a class="btn-muted" href="/notification"><i class="fas fa-bell"></i> Open notification center</a>
        </div>

        <div id="blog" class="settings-section"><div class="section-title"><h2>Blog & Writing</h2><p>Set defaults for publishing and protect your drafts.</p></div><div class="block"><div class="field"><label>Default visibility</label><select id="defaultVisibility" class="input"><option value="public" <%= user.blogSettings?.defaultVisibility==='public'?'selected':'' %>>Public</option><option value="followers" <%= user.blogSettings?.defaultVisibility==='followers'?'selected':'' %>>Followers only</option></select></div><div class="grid"><div class="field"><label>Default category</label><input id="defaultCategory" class="input" value="<%= user.blogSettings?.defaultCategory || '' %>"></div><div class="field"><label>Default tags</label><input id="defaultTags" class="input" value="<%= (user.blogSettings?.defaultTags||[]).join(', ') %>"></div></div><div class="row"><div><div class="row-title">Allow likes</div><div class="row-desc">Readers can like your blogs.</div></div><label class="switch"><input id="allowLikes" type="checkbox" <%= user.blogSettings?.allowLikes!==false?'checked':'' %>><span class="slider"></span></label></div><div class="row"><div><div class="row-title">Allow comments</div><div class="row-desc">Readers can comment on your blogs.</div></div><label class="switch"><input id="blogComments" type="checkbox" <%= user.blogSettings?.allowComments!==false?'checked':'' %>><span class="slider"></span></label></div><div class="row"><div><div class="row-title">Show view count</div><div class="row-desc">Display blog view counts to readers.</div></div><label class="switch"><input id="showViewCount" type="checkbox" <%= user.blogSettings?.showViewCount!==false?'checked':'' %>><span class="slider"></span></label></div><div class="row"><div><div class="row-title">Auto-save drafts</div><div class="row-desc">Keep unfinished writing safer while you work.</div></div><label class="switch"><input id="autoDrafts" type="checkbox" <%= user.blogSettings?.autoDrafts!==false?'checked':'' %>><span class="slider"></span></label></div><div class="field"><button id="saveBlog" class="btn-main">Save blog settings</button></div></div></div>

        <div id="comments" class="settings-section"><div class="section-title"><h2>Comments</h2><p>Control conversations around your posts.</p></div><div class="block"><div class="row"><div><div class="row-title">Allow comments</div><div class="row-desc">Enable comments across your blogs.</div></div><label class="switch"><input id="commentAllow" type="checkbox" <%= user.commentSettings?.allowComments!==false?'checked':'' %>><span class="slider"></span></label></div><div class="row"><div><div class="row-title">Moderate comments</div><div class="row-desc">Review comments before they appear.</div></div><label class="switch"><input id="moderateComments" type="checkbox" <%= user.commentSettings?.moderateComments?'checked':'' %>><span class="slider"></span></label></div><div class="row"><div><div class="row-title">Reply notifications</div><div class="row-desc">Get notified when someone replies to your comments.</div></div><label class="switch"><input id="notifyReplies" type="checkbox" <%= user.commentSettings?.notifyReplies!==false?'checked':'' %>><span class="slider"></span></label></div><div class="field"><button id="saveComments" class="btn-main">Save comment settings</button></div></div></div>

        <div id="appearance" class="settings-section"><div class="section-title"><h2>Appearance</h2><p>Choose light, dark or device-controlled appearance.</p></div><div class="block"><div class="field"><div class="theme-choice"><button data-theme="light"><i class="fas fa-sun"></i>Light<small class="d-block status">Always light</small></button><button data-theme="dark"><i class="fas fa-moon"></i>Dark<small class="d-block status">Always dark</small></button><button data-theme="system"><i class="fas fa-desktop"></i>System<small class="d-block status">Follow device</small></button></div></div></div><div class="block"><div class="row"><div><div class="row-title">Compact layout</div><div class="row-desc">Use a denser interface where supported.</div></div><label class="switch"><input id="compactLayout" type="checkbox" <%= user.interfaceSettings?.compactLayout?'checked':'' %>><span class="slider"></span></label></div><div class="row"><div><div class="row-title">Reduce animations</div><div class="row-desc">Reduce motion across supported interface components.</div></div><label class="switch"><input id="reduceAnimations" type="checkbox" <%= user.interfaceSettings?.reduceAnimations?'checked':'' %>><span class="slider"></span></label></div><div class="field"><button id="saveInterface" class="btn-main">Save interface settings</button></div></div></div>

        <div id="security" class="settings-section"><div class="section-title"><h2>Security</h2><p>Protect access to your account.</p></div><div class="block"><div class="row"><div><div class="row-title">Password</div><div class="row-desc">Change your account password.</div></div><a class="btn-muted" href="/user/change-password">Change password</a></div><div class="row"><div><div class="row-title">Active session</div><div class="row-desc">Your current authenticated session is active.</div></div><span class="status">Protected</span></div></div></div>

        <div id="blocked" class="settings-section"><div class="section-title"><h2>Blocked Users</h2><p>Accounts you have blocked cannot interact with you normally.</p></div><div class="block"><% if (user.blockedUsers?.length) { user.blockedUsers.forEach(b=>{ %><div class="row" id="blocked-<%= b._id %>"><div class="blocked-user"><img src="<%= b.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'"><div><div class="row-title"><%= b.fullName %></div><div class="row-desc">Blocked account</div></div></div><button class="btn-muted" onclick="unblockUser('<%= b._id %>')">Unblock</button></div><% }) } else { %><div class="field status">You have not blocked anyone.</div><% } %></div></div>

        <div id="account" class="settings-section"><div class="section-title"><h2>Account</h2><p>Manage your account lifecycle and data.</p></div><div class="block"><div class="row"><div><div class="row-title">Visit your profile</div><div class="row-desc">See exactly what other visitors see.</div></div><a class="btn-muted" href="/user/profile">Visit</a></div><div class="row"><div><div class="row-title">Creator analytics</div><div class="row-desc">Review views, likes, comments and engagement.</div></div><a class="btn-muted" href="/analytics">Open</a></div><div class="row"><div><div class="row-title">Delete account</div><div class="row-desc">Permanently remove your account and blog content.</div></div><button id="deleteAccount" class="danger-btn">Delete account</button></div></div></div>

        <div id="about" class="settings-section"><div class="section-title"><h2>About Blogify</h2><p>Help and product information.</p></div><div class="block"><div class="field"><div class="row-title">Blogify</div><div class="row-desc">Write, discover and connect through stories.</div></div><div class="row"><div><div class="row-title">Notifications</div><div class="row-desc">Open your notification center.</div></div><a class="btn-muted" href="/notification">Open</a></div><div class="row"><div><div class="row-title">Analytics</div><div class="row-desc">Open your creator dashboard.</div></div><a class="btn-muted" href="/analytics">Open</a></div></div></div>
      </section>
    </div>
  </main>
  <%- include("./partials/scripts") %>
  <script>
    (()=>{
      const sections=[...document.querySelectorAll('.settings-section')],buttons=[...document.querySelectorAll('.menu-btn')],mobile=document.getElementById('mobileMenu');
      const show=id=>{sections.forEach(s=>s.classList.toggle('active',s.id===id));buttons.forEach(b=>b.classList.toggle('active',b.dataset.section===id));if(mobile)mobile.value=id;history.replaceState(null,'','#'+id)};
      buttons.forEach(b=>b.addEventListener('click',()=>show(b.dataset.section)));mobile?.addEventListener('change',e=>show(e.target.value));document.querySelectorAll('[data-open]').forEach(b=>b.addEventListener('click',()=>show(b.dataset.open)));show(sections.some(s=>s.id===location.hash.slice(1))?location.hash.slice(1):'<%= activeSection || "profile" %>');
      const save=async(url,data,msg='Saved')=>{try{const r=await axios.patch(url,data);if(!r.data.success)throw new Error(r.data.message||'Unable to save');if(window.notify)notify.success(msg);return r.data}catch(e){if(window.notify)notify.error(e.response?.data?.message||e.message||'Unable to save');throw e}};
      document.getElementById('saveProfile')?.addEventListener('click',async()=>{const b=document.getElementById('saveProfile');b.disabled=true;try{await axios.put('/profile/update',{fullName:document.getElementById('fullName').value,bio:document.getElementById('bio').value,website:document.getElementById('website').value,location:document.getElementById('location').value});if(window.notify)notify.success('Profile updated successfully')}catch(e){if(window.notify)notify.error(e.response?.data?.message||'Unable to update profile')}finally{b.disabled=false}});
      document.getElementById('profileImageInput')?.addEventListener('change',async e=>{const f=e.target.files?.[0];if(!f)return;const status=document.getElementById('uploadStatus');status.textContent='Uploading...';const fd=new FormData();fd.append('profileImage',f);try{const r=await axios.post('/profile/upload-image',fd,{headers:{'Content-Type':'multipart/form-data'}});if(!r.data.success)throw new Error(r.data.message);document.getElementById('profilePreview').src=r.data.imageURL;status.textContent='Profile photo updated';if(window.notify)notify.success('Profile photo updated')}catch(err){status.textContent='Upload failed';if(window.notify)notify.error(err.response?.data?.message||err.message||'Upload failed')}});
      document.getElementById('privateToggle')?.addEventListener('change',e=>save('/profile/settings/privacy',{isPrivate:e.target.checked},e.target.checked?'Private account enabled':'Private account disabled'));
      document.querySelectorAll('.notif').forEach(i=>i.addEventListener('change',()=>save('/profile/settings/notifications',{[i.dataset.key]:i.checked},'Notification preference saved')));
      document.getElementById('saveBlog')?.addEventListener('click',()=>save('/profile/settings/general',{blogSettings:{defaultVisibility:document.getElementById('defaultVisibility').value,defaultCategory:document.getElementById('defaultCategory').value,defaultTags:document.getElementById('defaultTags').value.split(',').map(x=>x.trim()).filter(Boolean),allowLikes:document.getElementById('allowLikes').checked,allowComments:document.getElementById('blogComments').checked,showViewCount:document.getElementById('showViewCount').checked,autoDrafts:document.getElementById('autoDrafts').checked}},'Blog settings saved'));
      document.getElementById('saveComments')?.addEventListener('click',()=>save('/profile/settings/general',{commentSettings:{allowComments:document.getElementById('commentAllow').checked,moderateComments:document.getElementById('moderateComments').checked,notifyReplies:document.getElementById('notifyReplies').checked}},'Comment settings saved'));
      document.getElementById('saveInterface')?.addEventListener('click',()=>save('/profile/settings/general',{interfaceSettings:{compactLayout:document.getElementById('compactLayout').checked,reduceAnimations:document.getElementById('reduceAnimations').checked}},'Interface settings saved'));
      document.querySelectorAll('.theme-choice button').forEach(b=>b.addEventListener('click',async()=>{const t=b.dataset.theme;try{await save('/profile/settings/theme',{theme:t},'Theme saved');localStorage.setItem('blogify-theme',t);document.documentElement.dataset.theme=t==='dark'||(t==='system'&&matchMedia('(prefers-color-scheme:dark)').matches)?'dark':'light';document.querySelectorAll('.theme-choice button').forEach(x=>x.classList.toggle('active',x===b))}catch(e){}}));
      const current=localStorage.getItem('blogify-theme')||'<%= user.theme || "system" %>';document.querySelector(`.theme-choice button[data-theme="${current}"]`)?.classList.add('active');
      window.unblockUser=async id=>{if(!confirm('Unblock this user?'))return;try{const r=await axios.patch('/profile/settings/unblock/'+id);if(!r.data.success)throw new Error(r.data.message);document.getElementById('blocked-'+id)?.remove();if(window.notify)notify.success('User unblocked')}catch(e){if(window.notify)notify.error(e.response?.data?.message||'Unable to unblock user')}};
      document.getElementById('deleteAccount')?.addEventListener('click',async()=>{if(!confirm('Delete your Blogify account permanently? This cannot be undone.'))return;if(!confirm('Final confirmation: permanently delete your account and blogs?'))return;try{const r=await axios.delete('/profile/delete-account');if(!r.data.success)throw new Error(r.data.message);location.href='/'}catch(e){if(window.notify)notify.error(e.response?.data?.message||'Failed to delete account')}});
      document.getElementById('pushEnabled')?.addEventListener('change',async e=>{if(e.target.checked&&'Notification' in window&&Notification.permission==='denied'){e.target.checked=false;if(window.notify)notify.error('Browser push permission is blocked. Enable notifications in browser settings.')}});
    })();
  </script>
</body>
</html>
