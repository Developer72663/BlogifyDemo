<!DOCTYPE html>
<html lang="en">
<head>
<%- include("./partials/head") %><title>Blogify — Home</title>
<style>
:root{--ink:#17181c;--muted:#747780;--line:#e8e8eb;--surface:#fff;--soft:#f5f5f3}body{background:var(--page);color:var(--text)}.home-wrap{max-width:1180px;margin:auto;padding:28px 18px 70px}.intro{padding:34px 0 26px;border-bottom:1px solid var(--line)}.eyebrow{font-size:.74rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#666}.intro h1{font-size:clamp(2.2rem,5vw,4.6rem);line-height:.98;letter-spacing:-.055em;max-width:760px;margin:10px 0 16px;font-weight:850}.intro p{max-width:620px;color:var(--muted);font-size:1.05rem}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.btn-clean{border-radius:999px;padding:10px 18px;font-weight:700}.discover{display:grid;grid-template-columns:1fr 310px;gap:26px;margin-top:28px}.feed-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.search{display:flex;gap:8px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:8px;margin-bottom:20px}.search input{border:0;outline:0;background:transparent;min-width:0;flex:1;padding:8px 10px}.search select{border:1px solid var(--line);border-radius:9px;padding:0 10px;background:var(--surface);color:var(--text)}.story{display:grid;grid-template-columns:1fr 260px;gap:20px;padding:22px 0;border-bottom:1px solid var(--line)}.story:first-of-type{border-top:1px solid var(--line)}.story-media,.story-video{width:100%;height:165px;border-radius:14px;object-fit:cover;background:#111;display:block}.story-video{aspect-ratio:16/10}.story h3{font-size:1.25rem;line-height:1.18;margin:7px 0 8px;font-weight:800}.story h3 a{color:inherit;text-decoration:none}.excerpt{color:var(--muted);font-size:.91rem;line-height:1.5;margin:0 0 14px}.meta{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:.78rem}.avatar{width:28px;height:28px;border-radius:50%;object-fit:cover;background:#eee}.author{font-weight:700;color:#444}.tag{font-size:.7rem;background:#f0f0ee;border-radius:999px;padding:4px 8px;color:#555;text-decoration:none}.media-badge{display:inline-flex;align-items:center;gap:5px;font-size:.68rem;font-weight:800;padding:4px 8px;border-radius:999px;background:var(--soft);color:var(--text)}.side{position:sticky;top:20px;height:max-content}.side-card{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:20px;margin-bottom:16px}.write-card{background:#18191c;color:#fff;border:0}.write-card p{color:#bfc0c4}.topic{display:inline-block;background:var(--soft);border-radius:999px;padding:7px 11px;margin:0 5px 7px 0;color:#444;text-decoration:none;font-size:.78rem}.empty{border:1px dashed #d6d6d2;border-radius:18px;padding:55px 20px;text-align:center;color:var(--muted);background:var(--surface)}@media(max-width:850px){.discover{grid-template-columns:1fr}.side{position:static;display:grid;grid-template-columns:1fr 1fr;gap:12px}}@media(max-width:560px){.home-wrap{padding-left:14px;padding-right:14px}.story{grid-template-columns:1fr}.story-media,.story-video{height:210px;order:-1}.search{flex-wrap:wrap}.search input{flex-basis:100%}.side{display:block}}
</style></head>
<body><%- include("./partials/nave") %><main class="home-wrap">
<section class="intro"><div class="eyebrow">Blogify / Discover</div><h1>Read something that stays with you.</h1><p>A quieter, cleaner home for ideas, stories and writers. Find your next read or share something of your own.</p><div class="actions"><% if(locals.user){ %><a href="/blogs/add-new" class="btn btn-dark btn-clean"><i class="fas fa-pen me-1"></i>Write a story</a><a href="/post" class="btn btn-outline-dark btn-clean"><i class="fas fa-plus me-1"></i>Photo / Video</a><% } %><a href="#stories" class="btn btn-outline-secondary btn-clean">Explore stories</a></div></section>
<section class="discover" id="stories"><div><form class="search" method="GET"><input name="search" value="<%= search||'' %>" placeholder="Search stories or topics..."><select name="sort" onchange="this.form.submit()"><option value="newest" <%=(!sort||sort==='newest')?'selected':''%>>Newest</option><option value="oldest" <%=sort==='oldest'?'selected':''%>>Oldest</option><option value="title" <%=sort==='title'?'selected':''%>>A–Z</option><option value="trending" <%=sort==='trending'?'selected':''%>>Trending</option></select><button class="btn btn-dark btn-sm rounded-pill px-3">Search</button></form><div class="feed-head"><h2><%=search?'Search results':'Latest posts'%></h2></div>
<% if(!blogs||!blogs.length){ %><div class="empty"><h3>Nothing here yet</h3><p>Try another search or publish the first post.</p></div><% }else{ blogs.forEach(blog=>{ const mediaType=String(blog.mediaType||'').toLowerCase()||(blog.videoURL?'video':(blog.coverImageURL?'photo':'blog')); const videoUrl=blog.videoURL||blog.video?.secure_url||blog.media?.secure_url; const imageUrl=blog.coverImageURL||blog.imageURL||blog.image?.secure_url; %>
<article class="story"><div><div class="d-flex gap-2 flex-wrap"><span class="media-badge"><i class="fas <%=mediaType==='video'?'fa-video':mediaType==='photo'?'fa-image':'fa-file-lines'%>"></i> <%=mediaType==='video'?'Video':mediaType==='photo'?'Photo':'Blog'%></span></div><h3><a href="/blogs/<%=blog._id%>"><%=truncate(blog.title,80)%></a></h3><p class="excerpt"><%=truncate(blog.excerpt||(blog.body?blog.body.substring(0,170):''),150)%></p><div class="meta"><img class="avatar" src="<%=blog.createdBy?.avatarURL||blog.createdBy?.profileImageURL||'/imgs/default.png'%>" alt="" onerror="this.onerror=null;this.src='/imgs/default.png'"><span class="author"><%=blog.createdBy?.fullName||'Blogify writer'%></span><span>·</span><span><%=blog.viewCount||0%> views</span></div></div><div>
<% if(mediaType==='video'&&videoUrl){ %><video class="story-video" controls playsinline preload="metadata" controlsList="nodownload" src="<%=videoUrl%>" poster="<%=imageUrl||''%>"><source src="<%=videoUrl%>" type="video/mp4">Your browser does not support video playback.</video><% }else if(imageUrl){ %><img class="story-media" src="<%=imageUrl%>" alt="<%=blog.title%>" loading="lazy" onerror="this.style.visibility='hidden'"> <% }else{ %><div class="story-media d-flex align-items-center justify-content-center"><i class="fas fa-file-lines text-muted"></i></div><% } %></div></article>
<% }) } %></div><aside class="side"><div class="side-card write-card"><h3>Share something</h3><p>Create a story, photo or short video.</p><% if(locals.user){ %><div class="d-grid gap-2"><a href="/blogs/add-new" class="btn rounded-pill fw-bold">Create a blog</a><a href="/post" class="btn rounded-pill fw-bold">Post photo / video</a></div><% } %></div><div class="side-card"><h3>Explore topics</h3><a class="topic" href="/blogs/tags/technology">Technology</a><a class="topic" href="/blogs/tags/lifestyle">Lifestyle</a><a class="topic" href="/blogs/tags/programming">Programming</a><a class="topic" href="/blogs/tags/travel">Travel</a></div></aside></section></main><%- include("./partials/scripts") %></body></html>