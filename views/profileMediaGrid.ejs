<% const visible = (blogs || []).filter(blog => type === 'all' || blog.mediaType === type); %>
<% if (!visible.length) { %>
  <div class="empty"><i class="fas fa-photo-video" style="font-size:2rem;margin-bottom:10px"></i><div>No <%= type === 'all' ? 'posts' : type + 's' %> yet.</div></div>
<% } else { %>
  <div class="grid">
    <% visible.forEach(blog => { %>
      <article class="card post">
        <% if (blog.mediaType === 'video' && blog.videoURL) { %>
          <video class="media" controls preload="metadata" poster="<%= blog.mediaPreviewURL || '' %>" aria-label="<%= blog.title %> video"><source src="<%= blog.videoURL %>" type="video/mp4">Your browser does not support video playback.</video>
        <% } else if (blog.coverImageURL) { %>
          <a href="/blogs/<%= blog._id %>"><img class="media" src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" loading="lazy" onerror="this.style.display='none'"></a>
        <% } else if (blog.mediaType === 'photo') { %>
          <a href="/blogs/<%= blog._id %>"><div class="media" style="display:grid;place-items:center;font-size:3rem;color:#635bff"><i class="fas fa-image"></i></div></a>
        <% } %>
        <div class="post-body">
          <h3><%= blog.title %></h3>
          <% if (blog.excerpt || blog.body) { %><p><%= (blog.excerpt || blog.body || '').replace(/<[^>]*>/g,'').slice(0,180) %></p><% } %>
          <div class="meta"><span><%= blog.mediaType === 'video' ? 'Video' : blog.mediaType === 'photo' ? 'Photo' : 'Blog' %></span><span><%= new Date(blog.createdAt).toLocaleDateString() %></span></div>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>
