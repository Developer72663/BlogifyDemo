<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title>Edit Profile | Blogify</title>
  <style>
    body{background:#f6f7fb}.wrap{max-width:760px;margin:90px auto 50px;padding:0 14px}.card{background:#fff;border:1px solid #e7eaf1;border-radius:22px;box-shadow:0 15px 45px rgba(24,32,51,.07);padding:24px}.hero{text-align:center}.avatar-wrap{position:relative;width:140px;height:140px;margin:0 auto 14px}.avatar{width:140px;height:140px;border-radius:50%;object-fit:cover;border:5px solid #fff;box-shadow:0 8px 28px rgba(0,0,0,.14)}.camera{position:absolute;right:0;bottom:0;width:48px;height:48px;border:3px solid #fff;border-radius:50%;background:#635bff;color:#fff;display:grid;place-items:center;cursor:pointer;transition:.2s}.camera:hover{transform:scale(1.08)}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:20px 0}.stat{padding:15px;border:1px solid #e7eaf1;border-radius:14px;text-align:center}.stat strong{display:block;font-size:1.35rem;color:#635bff}.muted{color:#718096;font-size:.85rem}.section{padding:20px 0;border-top:1px solid #e7eaf1}.field{margin-bottom:15px}.field label{display:block;font-weight:800;margin-bottom:7px}.field input,.field textarea{width:100%;border:1px solid #dfe3eb;border-radius:12px;padding:12px 13px;font:inherit;outline:none}.field input:focus,.field textarea:focus{border-color:#635bff;box-shadow:0 0 0 3px rgba(99,91,255,.1)}.checks{display:grid;gap:12px}.check{display:flex;gap:10px;align-items:center}.actions{display:flex;justify-content:flex-end;gap:10px}.btn{border:0;border-radius:12px;padding:12px 18px;font-weight:800;cursor:pointer;text-decoration:none}.primary{background:#635bff;color:#fff}.secondary{background:#fff;border:1px solid #e7eaf1;color:#182033}.danger{color:#e5484d}.save.loading{pointer-events:none;min-width:155px}.save.loading .label{display:none}.spinner{width:18px;height:18px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;display:none;animation:spin .7s linear infinite}.save.loading .spinner{display:inline-block}.success-pop{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%) scale(.8);background:#fff;border-radius:22px;padding:30px 38px;text-align:center;box-shadow:0 20px 70px rgba(0,0,0,.22);opacity:0;pointer-events:none;transition:.25s;z-index:9999}.success-pop.show{opacity:1;transform:translate(-50%,-50%) scale(1)}.checkmark{width:62px;height:62px;border-radius:50%;background:#159570;color:#fff;display:grid;place-items:center;font-size:2rem;margin:0 auto 12px;animation:pop .4s ease}.uploading{position:fixed;inset:0;background:rgba(255,255,255,.72);backdrop-filter:blur(4px);display:none;place-items:center;z-index:9998}.uploading.show{display:grid}.loader-card{background:#fff;padding:25px;border-radius:20px;box-shadow:0 15px 55px rgba(0,0,0,.18);text-align:center}.loader-ring{width:48px;height:48px;border:4px solid #e9e8ff;border-top-color:#635bff;border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}@keyframes spin{to{transform:rotate(360deg)}}@keyframes pop{0%{transform:scale(.5)}100%{transform:scale(1)}}@media(max-width:600px){.wrap{margin-top:75px}.card{padding:18px}.actions{flex-direction:column}.actions .btn{width:100%}}
  </style>
</head>
<body>
  <%- include("./partials/nave") %>
  <main class="wrap"><section class="card">
    <div class="hero"><div class="avatar-wrap"><img id="preview" class="avatar" src="<%= user.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'" alt="Profile"><label class="camera" for="imageInput"><i class="fas fa-camera"></i></label></div><input id="imageInput" type="file" accept="image/jpeg,image/png,image/webp,image/gif" hidden><h2>Edit Profile</h2><p class="muted">Update your profile information and photo.</p></div>
    <div class="stats"><div class="stat"><strong><%= user.followers?.length || 0 %></strong><span class="muted">Followers</span></div><div class="stat"><strong><%= user.following?.length || 0 %></strong><span class="muted">Following</span></div><div class="stat"><strong>—</strong><span class="muted">Posts</span></div></div>
    <form id="profileForm"><div class="section">
      <div class="field"><label>Full name</label><input name="fullName" maxlength="100" required value="<%= user.fullName || '' %>"></div>
      <div class="field"><label>Email</label><input disabled value="<%= user.email || '' %>"></div>
      <div class="field"><label>Bio</label><textarea name="bio" maxlength="500" rows="4"><%= user.bio || '' %></textarea></div>
      <div class="field"><label>Website</label><input type="url" name="website" maxlength="500" value="<%= user.website || '' %>" placeholder="https://example.com"></div>
      <div class="field"><label>Location</label><input name="location" maxlength="120" value="<%= user.location || '' %>" placeholder="City, Country"></div>
    </div>
    <div class="section"><h4>Notification preferences</h4><div class="checks"><label class="check"><input type="checkbox" name="emailOnComment" <%= user.notificationSettings?.emailOnComment?'checked':'' %>> Email on comments</label><label class="check"><input type="checkbox" name="emailOnNewFollower" <%= user.notificationSettings?.emailOnNewFollower?'checked':'' %>> Email on new followers</label><label class="check"><input type="checkbox" name="emailOnLike" <%= user.notificationSettings?.emailOnLike?'checked':'' %>> Email on likes</label><label class="check"><input type="checkbox" name="emailDigest" <%= user.notificationSettings?.emailDigest?'checked':'' %>> Weekly email digest</label></div></div>
    <div class="actions"><a class="btn secondary" href="/user/profile">Cancel</a><button id="save" class="btn primary save" type="submit"><span class="spinner"></span><span class="label"><i class="fas fa-save"></i> Save changes</span></button></div></form>
  </section></main>
  <div id="uploading" class="uploading"><div class="loader-card"><div class="loader-ring"></div><strong>Uploading profile photo…</strong><div class="muted">Please wait</div></div></div>
  <div id="success" class="success-pop"><div class="checkmark">✓</div><strong>Profile updated!</strong><div class="muted">Opening your profile…</div></div>
  <%- include("./partials/scripts") %>
  <script>
    const input=document.getElementById('imageInput'),preview=document.getElementById('preview'),uploading=document.getElementById('uploading');
    input.addEventListener('change',async e=>{const file=e.target.files?.[0];if(!file)return;if(file.size>10*1024*1024){notify.error('Profile photo must be 10MB or smaller');input.value='';return}preview.src=URL.createObjectURL(file);uploading.classList.add('show');try{const fd=new FormData();fd.append('profileImage',file);const r=await fetch('/user/profile/upload-image',{method:'POST',body:fd,headers:{Accept:'application/json'}});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Upload failed');preview.src=d.imageURL;notify.success('Profile photo updated')}catch(err){notify.error(err.message||'Unable to upload photo')}finally{uploading.classList.remove('show');input.value=''}});
    document.getElementById('profileForm').addEventListener('submit',async e=>{e.preventDefault();const btn=document.getElementById('save');btn.classList.add('loading');btn.disabled=true;const fd=new FormData(e.currentTarget),data={fullName:fd.get('fullName'),bio:fd.get('bio'),website:fd.get('website'),location:fd.get('location')};try{const r=await fetch('/user/profile/update',{method:'PUT',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify(data)});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Update failed');const n={emailOnComment:fd.has('emailOnComment'),emailOnNewFollower:fd.has('emailOnNewFollower'),emailOnLike:fd.has('emailOnLike'),emailDigest:fd.has('emailDigest')};await fetch('/user/profile/settings/notifications',{method:'PATCH',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify(n)});document.getElementById('success').classList.add('show');setTimeout(()=>location.href='/user/profile',900)}catch(err){notify.error(err.message||'Unable to update profile');btn.classList.remove('loading');btn.disabled=false}});
  </script>
</body></html>
