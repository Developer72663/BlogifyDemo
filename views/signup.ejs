<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>Sign Up - Blogify</title>
  <style>
    :root{--a-bg:#f5f7ff;--a-card:#fff;--a-text:#111827;--a-muted:#64748b;--a-border:#e5e7eb;--a-primary:#6366f1;--a-primary2:#8b5cf6;--a-soft:#f8fafc}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    body{min-height:100dvh;background:radial-gradient(circle at 10% 10%,rgba(99,102,241,.14),transparent 32%),radial-gradient(circle at 90% 90%,rgba(139,92,246,.12),transparent 32%),var(--a-bg);color:var(--a-text);padding:82px 14px 24px}
    .auth-container{width:100%;min-height:calc(100dvh - 106px);display:grid;place-items:center}.auth-card{width:min(100%,450px);background:rgba(255,255,255,.95);border:1px solid rgba(255,255,255,.9);border-radius:24px;box-shadow:0 24px 70px rgba(30,41,59,.13);overflow:hidden;animation:rise .35s ease-out}.auth-card-body{padding:28px 28px 24px}
    .auth-brand{width:50px;height:50px;margin:0 auto 13px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(135deg,var(--a-primary),var(--a-primary2));color:#fff;font-size:1.25rem;font-weight:900;box-shadow:0 12px 28px rgba(99,102,241,.26)}.auth-header{text-align:center;margin-bottom:21px}.auth-header h2{margin:0 0 6px;font-size:1.6rem;letter-spacing:-.04em}.auth-header p{margin:0;color:var(--a-muted);font-size:.85rem}
    .form-group,.otp-container{margin-bottom:14px}.form-label{display:block;margin:0 0 6px;font-size:.8rem;font-weight:750}.form-control{width:100%;height:46px;padding:0 12px;border:1.5px solid var(--a-border);border-radius:12px;background:var(--a-card);color:var(--a-text);font:500 16px Inter,system-ui;outline:0;transition:.18s}.form-control:focus,.otp-box:focus{border-color:var(--a-primary);box-shadow:0 0 0 4px rgba(99,102,241,.12);outline:0}.form-control::placeholder{color:#9ca3af}.input-group{display:flex}.input-group .form-control{border-radius:12px 0 0 12px}.input-group .btn{width:48px;border:1.5px solid var(--a-border);border-left:0;border-radius:0 12px 12px 0;background:var(--a-card);color:#64748b;cursor:pointer;font-size:1rem}
    .otp-inputs{display:flex;justify-content:center;gap:7px;margin:7px 0 10px}.otp-box{width:44px;height:46px;border:1.5px solid var(--a-border);border-radius:11px;background:var(--a-card);color:var(--a-text);text-align:center;font:800 1.1rem Inter,system-ui}.btn-send-otp{width:100%;height:43px;border:1px solid var(--a-border);border-radius:12px;background:var(--a-soft);color:#475569;font:750 .82rem Inter,system-ui;cursor:pointer;transition:.18s}.btn-send-otp:hover:not(:disabled){border-color:#c7d2fe;background:#eef2ff;color:#4f46e5}.btn-send-otp:disabled{opacity:.6;cursor:not-allowed}
    .btn-signup{width:100%;height:47px;border:0;border-radius:13px;background:linear-gradient(135deg,var(--a-primary),var(--a-primary2));color:#fff;font:800 .88rem Inter,system-ui;cursor:pointer;box-shadow:0 10px 24px rgba(99,102,241,.22);transition:.18s}.btn-signup:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 14px 28px rgba(99,102,241,.28)}.btn-signup:disabled{opacity:.65;cursor:not-allowed}
    .divider{display:flex;align-items:center;gap:12px;margin:18px 0;color:#94a3b8;font-size:.7rem;font-weight:800}.divider:before,.divider:after{content:"";height:1px;flex:1;background:var(--a-border)}.btn-google{width:100%;height:46px;display:flex;align-items:center;justify-content:center;gap:10px;border:1.5px solid var(--a-border);border-radius:12px;background:var(--a-card);color:var(--a-text);font:750 .86rem Inter,system-ui;text-decoration:none;transition:.18s}.btn-google:hover{background:var(--a-soft);border-color:#cbd5e1;transform:translateY(-1px)}.btn-google img{width:19px;height:19px}.signin-link{text-align:center;margin:18px 0 0;color:var(--a-muted);font-size:.8rem}.signin-link a{margin-left:3px;color:var(--a-primary);font-weight:750;text-decoration:none}.signin-link a:hover{text-decoration:underline}
    .spinner-border{display:inline-block;width:15px;height:15px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;vertical-align:-3px;margin-right:7px;animation:spin .7s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
    html[data-theme="dark"] body{--a-bg:#080808;--a-card:#111;--a-text:#f5f5f5;--a-muted:#a3a3a3;--a-border:#292929;--a-soft:#181818;background:#080808}html[data-theme="dark"] .auth-card{background:rgba(17,17,17,.96);border-color:#292929;box-shadow:0 24px 70px rgba(0,0,0,.45)}
    @media(max-width:600px){body{padding:72px 10px 14px}.auth-container{min-height:calc(100dvh - 86px);align-items:start}.auth-card{border-radius:20px}.auth-card-body{padding:23px 17px 20px}.auth-header h2{font-size:1.45rem}.otp-inputs{gap:5px}.otp-box{width:calc((100% - 25px)/6);max-width:43px;height:44px}}
  </style>
</head>
<body>
  <%- include("./partials/nave") %>
  <main class="auth-container">
    <section class="auth-card" aria-labelledby="signupTitle">
      <div class="auth-card-body">
        <div class="auth-brand" aria-hidden="true">B</div>
        <header class="auth-header"><h2 id="signupTitle">Create your account</h2><p>Join Blogify and start sharing your ideas.</p></header>
        <a href="/user/auth/google" class="btn-google"><img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google">Continue with Google</a>
        <div class="divider"><span>OR</span></div>
        <form id="signupForm" novalidate>
          <div class="form-group"><label class="form-label" for="fullName">Full name</label><input type="text" id="fullName" name="fullName" class="form-control" placeholder="John Doe" autocomplete="name" required></div>
          <div class="form-group"><label class="form-label" for="email">Email address</label><input type="email" id="email" name="email" class="form-control" placeholder="you@example.com" autocomplete="email" required></div>
          <div class="form-group"><label class="form-label" for="password">Password</label><div class="input-group"><input type="password" id="password" name="password" class="form-control" placeholder="Create a password" autocomplete="new-password" required><button type="button" class="btn" id="togglePassword" aria-label="Show password">👁️</button></div></div>
          <div class="otp-container"><label class="form-label">Verification code</label><div class="otp-inputs" id="otpContainer"><input type="text" inputmode="numeric" maxlength="1" class="otp-box" data-index="0"><input type="text" inputmode="numeric" maxlength="1" class="otp-box" data-index="1"><input type="text" inputmode="numeric" maxlength="1" class="otp-box" data-index="2"><input type="text" inputmode="numeric" maxlength="1" class="otp-box" data-index="3"><input type="text" inputmode="numeric" maxlength="1" class="otp-box" data-index="4"><input type="text" inputmode="numeric" maxlength="1" class="otp-box" data-index="5"></div><button type="button" class="btn-send-otp" id="sendOtpBtn">Send OTP</button><input type="hidden" name="otp" id="hiddenOtp"></div>
          <button type="submit" class="btn-signup" id="submitBtn">Create Account</button>
        </form>
        <p class="signin-link">Already have an account?<a href="/user/signin">Sign in</a></p>
      </div>
    </section>
  </main>
  <%- include("./partials/scripts") %>
  <script>
    document.getElementById('togglePassword').addEventListener('click',function(){const p=document.getElementById('password');const show=p.type==='password';p.type=show?'text':'password';this.textContent=show?'🙈':'👁️';this.setAttribute('aria-label',show?'Hide password':'Show password')});
    const otpInputs=[...document.querySelectorAll('.otp-box')];function updateHiddenOtp(){document.getElementById('hiddenOtp').value=otpInputs.map(x=>x.value).join('')}otpInputs.forEach((input,i)=>{input.addEventListener('input',()=>{input.value=input.value.replace(/\D/g,'').slice(0,1);if(input.value&&i<otpInputs.length-1)otpInputs[i+1].focus();updateHiddenOtp()});input.addEventListener('keydown',e=>{if(e.key==='Backspace'&&!input.value&&i)otpInputs[i-1].focus()});input.addEventListener('paste',e=>{e.preventDefault();const v=(e.clipboardData.getData('text')||'').replace(/\D/g,'').slice(0,6);v.split('').forEach((c,j)=>{if(otpInputs[j])otpInputs[j].value=c});updateHiddenOtp();otpInputs[Math.min(v.length,6)-1]?.focus()})});
    document.getElementById('sendOtpBtn').addEventListener('click',async function(){const email=document.getElementById('email').value.trim();if(!email)return alert('Please enter your email first.');this.disabled=true;this.textContent='Sending OTP...';try{const r=await fetch('/user/send-otp',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email})});const d=await r.json();if(d.success){alert('OTP sent to '+email);this.textContent='Resend OTP';setTimeout(()=>this.disabled=false,30000)}else{alert(d.message||'Failed to send OTP');this.disabled=false;this.textContent='Send OTP'}}catch(e){alert('Failed to send OTP');this.disabled=false;this.textContent='Send OTP'}});
    document.getElementById('signupForm').addEventListener('submit',async function(e){e.preventDefault();const b=document.getElementById('submitBtn');b.disabled=true;b.innerHTML='<span class="spinner-border"></span>Creating account...';const data=Object.fromEntries(new FormData(this).entries());try{const r=await fetch('/user/signup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const d=await r.json();if(d.success){alert('Account created successfully!');location.href='/'}else{alert(d.message||'Unable to create account');b.disabled=false;b.textContent='Create Account'}}catch(e){alert('Something went wrong. Please try again.');b.disabled=false;b.textContent='Create Account'}});
  </script>
</body>
</html>
