<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || user.theme || 'system' %>">
<head>
  <%- include("./partials/head") %>
  <title><%= user.fullName %> | Blogify</title>
  <style>
    :root{--bg:#f6f7fb;--card:#fff;--text:#182033;--muted:#718096;--line:#e7eaf1;--primary:#635bff;--soft:#efedff;--danger:#e5484d;--media:#eef0f5;--shadow:0 16px 45px rgba(24,32,51,.08)}
    html[data-theme="dark"]{--bg:#0b0f17;--card:#121925;--text:#f3f5f9;--muted:#aab4c4;--line:#273142;--primary:#8b83ff;--soft:#29264b;--danger:#ff6b72;--media:#1b2432;--shadow:0 16px 45px rgba(0,0,0,.28)}
    @media(prefers-color-scheme:dark){html[data-theme="system"]{--bg:#0b0f17;--card:#121925;--text:#f3f5f9;--muted:#aab4c4;--line:#273142;--primary:#8b83ff;--soft:#29264b;--danger:#ff6b72;--media:#1b2432;--shadow:0 16px 45px rgba(0,0,0,.28)}}
    *{box-sizing:border-box}
    html,body{background:var(--bg);color:var(--text);transition:background-color .22s ease,color .22s ease}
    .profile-page{min-height:100vh;background:var(--bg);color:var(--text);padding:94px 16px 60px;transition:background .22s ease}
    .profile-shell{max-width:1120px;margin:auto}
    .profile-card,.content-card{background:var(--card);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow);transition:background .22s ease,border-color .22s ease}
    .profile-card{padding:30px}
    .profile-head{display:flex;gap:25px;align-items:center}
    .avatar{width:132px;height:132px;border-radius:50%;object-fit:cover;border:5px solid var(--card);box-shadow:0 8px 28px rgba(0,0,0,.12);flex-shrink:0}
    .identity{flex:1;min-width:0}.identity h1{margin:0 0 5px;font-size:2rem}.email{color:var(--muted);font-size:.86rem}.bio{margin:0 0 12px;line-height:1.6;max-width:700px}.meta{display:flex;flex-wrap:wrap;gap:12px;color:var(--muted);font-size:.84rem}.meta a{color:var(--primary)}
    .badge{display:inline-flex;gap:6px;border-radius:99px;padding:6px 10px;background:var(--soft);color:var(--primary);font-weight:800;font-size:.72rem}
    .actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end;position:relative}.btn{border:0;border-radius:11px;padding:10px 15px;font-weight:800;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:7px;transition:transform .15s ease,opacity .15s ease,background .2s ease}.btn:hover{transform:translateY(-1px)}.primary{background:var(--primary);color:#fff}.secondary{background:var(--card);border:1px solid var(--line);color:var(--text)}.success{background:#159570;color:#fff}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:28px;padding-top:22px;border-top:1px solid var(--line)}.stat{text-align:center;border:0;background:transparent;color:var(--text);cursor:pointer;padding:8px}.stat strong{display:block;font-size:1.25rem}.stat span{color:var(--muted);font-size:.78rem}
    .tabs{display:flex;gap:5px;margin:22px 0 15px;padding:5px;background:var(--card);border:1px solid var(--line);border-radius:15px}.tab{flex:1;border:0;background:transparent;padding:11px;border-radius:10px;color:var(--muted);font-weight:800;cursor:pointer}.tab.active{background:var(--soft);color:var(--primary)}
    .content-card{padding:24px}.panel{display:none}.panel.active{display:block}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.post{border:1px solid var(--line);border-radius:17px;overflow:hidden;background:var(--card);box-shadow:0 5px 20px rgba(24,32,51,.04)}.media{width:100%;height:260px;display:block;object-fit:cover;background:var(--media)}.post-body{padding:17px}.post h3{font-size:1.08rem;margin:0 0 8px}.post p{color:var(--muted);font-size:.85rem;line-height:1.5}.meta-row{display:flex;justify-content:space-between;color:var(--muted);font-size:.74rem;padding-top:12px;border-top:1px solid var(--line)}.empty{text-align:center;padding:55px 15px;color:var(--muted)}
    .modal{position:fixed;inset:0;background:rgba(0,0,0,.58);display:none;place-items:center;padding:18px;z-index:9999}.modal.open{display:grid}.modal-card{background:var(--card);color:var(--text);width:min(460px,100%);max-height:80vh;overflow:auto;border-radius:20px;padding:22px;border:1px solid var(--line)}.modal-head{display:flex;justify-content:space-between;align-items:center}.close{border:0;background:var(--soft);color:var(--text);border-radius:50%;width:34px;height:34px;cursor:pointer}.people{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px}.person{border:1px solid var(--line);border-radius:15px;padding:16px;text-align:center;text-decoration:none;color:var(--text);background:var(--card)}.person img{width:58px;height:58px;border-radius:50%;object-fit:cover}.person strong{display:block;margin-top:8px}.person small{color:var(--muted)}
    @media(max-width:760px){.profile-page{padding:82px 10px 40px}.profile-card{padding:20px}.profile-head{flex-direction:column;text-align:center}.meta{justify-content:center}.actions{justify-content:center}.grid,.people{grid-template-columns:1fr}.media{height:230px}.tabs{overflow:auto}.tab{min-width:105px}}
  </style>
</head>
<body>
  <%- include("./partials/nave") %>
  <main class="profile-page"><div class="profile-shell">
    <section class="profile-card">
      <div class="profile-head">
        <img class="avatar" src="<%= user.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'" alt="<%= user.fullName %>">
        <div class="identity">
          <span class="badge"><i class="fas <%= user.isPrivate?'fa-lock':'fa-globe' %>"></i><%= user.isPrivate?'Private account':'Public account' %></span>
          <h1><%= user.fullName %></h1>
          <% if(isOwnProfile && user.email){ %><div class="email"><%= user.email %></div><% } %>
          <% if(user.bio){ %><p class="bio"><%= user.bio %></p><% } %>
          <div class="meta">
            <% if(user.location){ %><span><i class="fas fa-map-marker-alt"></i> <%= user.location %></span><% } %>
            <% if(user.website){ %><a href="<%= user.website %>" target="_blank" rel="noopener noreferrer"><i class="fas fa-link"></i> Website</a><% } %>
          </div>
          <div class="actions" style="margin-top:14px">
            <% if(isOwnProfile){ %>
              <a class="btn primary" href="/user/profile/edit"><i class="fas fa-user-edit"></i>Edit profile</a>
              <a class="btn secondary" href="/user/profile/settings"><i class="fas fa-cog"></i>Settings</a>
            <% } else if(isLoggedIn){ %>
              <button id="followBtn" class="btn <%= followState==='following'?'success':'primary' %>" onclick="toggleFollow()"><i class="fas <%= followState==='following'?'fa-user-check':followState==='requested'?'fa-clock':'fa-user-plus' %>"></i><span><%= followState==='following'?'Following':followState==='requested'?'Requested':'Follow' %></span></button>
            <% } %>
          </div>
        </div>
      </div>
      <div class="stats">
        <button class="stat" onclick="openPeople('followers')"><strong id="followerCount"><%= followerCount %></strong><span>Followers</span></button>
        <button class="stat" onclick="openPeople('following')"><strong id="followingCount"><%= followingCount %></strong><span>Following</span></button>
        <button class="stat" onclick="openPanel('posts')"><strong><%= blogCount %></strong><span>Posts</span></button>
      </div>
    </section>

    <div class="tabs">
      <button class="tab active" data-tab="posts"> <i class="fas fa-th-large"></i> Posts</button>
      <button class="tab" data-tab="photos"><i class="fas fa-image"></i> Photos</button>
      <button class="tab" data-tab="videos"><i class="fas fa-video"></i> Videos</button>
    </div>

    <section class="content-card">
      <div id="posts" class="panel active"><%- include("./profileMediaGrid", { blogs, type: "all" }) %></div>
      <div id="photos" class="panel"><%- include("./profileMediaGrid", { blogs, type: "photo" }) %></div>
      <div id="videos" class="panel"><%- include("./profileMediaGrid", { blogs, type: "video" }) %></div>
    </section>
  </div></main>

  <div class="modal" id="peopleModal"><div class="modal-card"><div class="modal-head"><h3 id="peopleTitle">People</h3><button class="close" onclick="closePeople()">×</button></div><div id="peopleList" class="people"></div></div></div>
  <%- include("./partials/scripts") %>
  <script>
    const profileUserId='<%= user._id %>';
    const initialTheme='<%= theme || user.theme || "system" %>';
    document.documentElement.dataset.theme=initialTheme;
    document.querySelectorAll('.tab').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));btn.classList.add('active');document.getElementById(btn.dataset.tab).classList.add('active')}));
    function openPanel(name){document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===name));document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.id===name))}
    async function refreshCounts(){try{const [followers,following]=await Promise.all([fetch('/follow/'+profileUserId+'/followers?page=1',{headers:{Accept:'application/json'},credentials:'same-origin'}),fetch('/follow/'+profileUserId+'/following?page=1',{headers:{Accept:'application/json'},credentials:'same-origin'})]);const f=await followers.json(),g=await following.json();if(f.success)document.getElementById('followerCount').textContent=Number(f.total||0);if(g.success)document.getElementById('followingCount').textContent=Number(g.total||0)}catch(e){console.debug('Profile count refresh failed',e)}}
    async function toggleFollow(){const b=document.getElementById('followBtn');if(!b)return;b.disabled=true;try{const r=await fetch('/follow/'+profileUserId+'/follow',{method:'POST',headers:{Accept:'application/json'},credentials:'same-origin'});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to update follow');if(d.followerCount!=null)document.getElementById('followerCount').textContent=Number(d.followerCount);b.className='btn '+(d.following?'success':'primary');b.innerHTML='<i class="fas '+(d.following?'fa-user-check':d.requested?'fa-clock':'fa-user-plus')+'"></i><span>'+(d.following?'Following':d.requested?'Requested':'Follow')+'</span>';if(window.notify?.success)notify.success(d.message);setTimeout(refreshCounts,200)}catch(e){if(window.notify?.error)notify.error(e.message);else alert(e.message)}finally{b.disabled=false}}
    async function openPeople(type){const modal=document.getElementById('peopleModal'),list=document.getElementById('peopleList');document.getElementById('peopleTitle').textContent=type==='followers'?'Followers':'Following';list.innerHTML='<div class="empty">Loading…</div>';modal.classList.add('open');try{const r=await fetch('/follow/'+profileUserId+'/'+type+'?page=1',{headers:{Accept:'application/json'},credentials:'same-origin'});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to load list');const people=d[type]||[];list.innerHTML=people.length?people.map(p=>'<a class="person" href="/user/profile/'+encodeURIComponent(p._id)+'"><img src="'+(p.profileImageURL||'/imgs/default.png')+'" onerror="this.src=\'/imgs/default.png\'"><div><strong>'+escapeHtml(p.fullName)+'</strong><small>'+escapeHtml(p.bio||'')+'</small></div></a>').join(''):'<div class="empty">No people found.</div>'}catch(e){list.innerHTML='<div class="empty">'+escapeHtml(e.message)+'</div>'}}
    function closePeople(){document.getElementById('peopleModal').classList.remove('open')}function escapeHtml(s){return String(s||'').replace(/[&<>\'\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}document.getElementById('peopleModal').addEventListener('click',e=>{if(e.target.id==='peopleModal')closePeople()});
    refreshCounts();
  </script>
</body></html>