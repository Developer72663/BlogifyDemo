<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title><%= user.fullName %> | Blogify</title>
  <style>
    :root{--bg:#f6f7fb;--card:#fff;--text:#182033;--muted:#718096;--line:#e7eaf1;--primary:#635bff;--soft:#efedff;--danger:#e5484d;--shadow:0 16px 45px rgba(24,32,51,.08)}
    *{box-sizing:border-box}.profile-page{min-height:100vh;background:var(--bg);color:var(--text);padding:94px 16px 60px}.profile-shell{max-width:1120px;margin:auto}.profile-card,.content-card{background:var(--card);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.profile-card{padding:30px}.profile-head{display:flex;gap:25px;align-items:center}.avatar{width:132px;height:132px;border-radius:50%;object-fit:cover;border:5px solid var(--card);box-shadow:0 8px 28px rgba(0,0,0,.12);flex-shrink:0}.identity{flex:1;min-width:0}.identity h1{margin:0 0 5px;font-size:2rem}.email,.stat span,.blog p,.blog-meta,.person small{color:var(--muted)}.bio{margin:0 0 12px;line-height:1.6;max-width:700px}.meta{display:flex;flex-wrap:wrap;gap:12px;color:var(--muted);font-size:.84rem}.meta a{color:var(--primary)}.badge{display:inline-flex;gap:6px;border-radius:99px;padding:6px 10px;background:var(--soft);color:var(--primary);font-weight:800;font-size:.72rem}.actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end;position:relative}.btn{border:0;border-radius:11px;padding:10px 15px;font-weight:800;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:7px}.btn:disabled{opacity:.6;cursor:not-allowed}.primary{background:var(--primary);color:#fff}.secondary{background:var(--card);border:1px solid var(--line);color:var(--text)}.success{background:#159570;color:#fff}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:28px;padding-top:22px;border-top:1px solid var(--line)}.stat{text-align:center;border:0;background:transparent;color:var(--text);cursor:pointer;padding:8px;border-radius:12px}.stat:hover{background:var(--soft)}.stat strong{display:block;font-size:1.25rem}.tabs{display:flex;gap:5px;margin:22px 0 15px;padding:5px;background:var(--card);border:1px solid var(--line);border-radius:15px}.tab{flex:1;border:0;background:transparent;padding:11px;border-radius:10px;color:var(--muted);font-weight:800;cursor:pointer}.tab.active{background:var(--soft);color:var(--primary)}.content-card{padding:24px}.panel{display:none}.panel.active{display:block}.blog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.blog{position:relative;border:1px solid var(--line);border-radius:17px;overflow:visible;background:var(--card)}.blog-inner{overflow:hidden;border-radius:17px}.cover{width:100%;height:210px;object-fit:cover;background:var(--bg);display:block}.blog-body{padding:17px}.blog h3{font-size:1.08rem;margin:0 38px 8px 0}.blog p{font-size:.85rem;line-height:1.5}.blog-meta{display:flex;justify-content:space-between;font-size:.74rem;padding-top:12px;border-top:1px solid var(--line)}.post-more{position:absolute;right:12px;top:12px;width:38px;height:38px;border:1px solid var(--line);border-radius:50%;background:var(--card);color:var(--text);display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:5;box-shadow:0 5px 18px rgba(0,0,0,.12)}.post-more:hover{background:var(--soft);color:var(--primary)}.post-menu{position:absolute;right:12px;top:56px;width:180px;background:var(--card);border:1px solid var(--line);border-radius:14px;box-shadow:0 15px 35px rgba(0,0,0,.18);padding:6px;z-index:20;display:none}.post-menu.open{display:block;animation:menuIn .16s ease}.post-menu button{width:100%;border:0;background:transparent;color:var(--text);padding:11px 12px;border-radius:9px;text-align:left;font:inherit;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:9px}.post-menu button:hover{background:var(--soft)}.post-menu .delete-post{color:var(--danger)}@keyframes menuIn{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:translateY(0)}}.empty{text-align:center;padding:55px 15px;color:var(--muted)}.lock{background:var(--soft);border-radius:18px;padding:35px;text-align:center}.people{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.person{border:1px solid var(--line);border-radius:15px;padding:16px;text-align:center}.person img{width:58px;height:58px;border-radius:50%;object-fit:cover}.person strong{display:block;margin-top:8px}.toast{position:fixed;right:20px;bottom:20px;background:#182033;color:#fff;padding:12px 16px;border-radius:11px;display:none;z-index:10002}
    .profile-menu-wrap{position:relative}.profile-more{width:42px;height:42px;border:1px solid var(--line);border-radius:50%;background:var(--card);color:var(--text);cursor:pointer;box-shadow:0 5px 18px rgba(0,0,0,.1)}.profile-more:hover{background:var(--soft);color:var(--primary)}.profile-menu{position:absolute;right:0;top:50px;width:210px;background:var(--card);border:1px solid var(--line);border-radius:15px;box-shadow:0 18px 45px rgba(0,0,0,.2);padding:6px;z-index:50;display:none}.profile-menu.open{display:block;animation:menuIn .16s ease}.profile-menu button{width:100%;border:0;background:transparent;color:var(--text);padding:12px;border-radius:10px;text-align:left;font:inherit;font-weight:750;cursor:pointer;display:flex;align-items:center;gap:10px}.profile-menu button:hover{background:var(--soft)}.profile-menu .danger{color:var(--danger)}
    .share-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);backdrop-filter:blur(3px);z-index:11000;opacity:0;visibility:hidden;transition:.22s}.share-overlay.open{opacity:1;visibility:visible}.share-sheet{position:fixed;left:50%;bottom:0;transform:translate(-50%,105%);width:min(620px,100%);max-height:82vh;background:var(--card);color:var(--text);border-radius:24px 24px 0 0;z-index:11001;display:flex;flex-direction:column;transition:transform .32s cubic-bezier(.16,1,.3,1);box-shadow:0 -20px 60px rgba(0,0,0,.2)}.share-sheet.open{transform:translate(-50%,0)}.sheet-grip{width:42px;height:5px;border-radius:99px;background:var(--line);margin:10px auto 2px}.share-head{display:flex;align-items:center;justify-content:space-between;padding:13px 20px;border-bottom:1px solid var(--line)}.share-head h3{margin:0;font-size:1.05rem}.sheet-close{width:36px;height:36px;border:0;border-radius:50%;background:var(--soft);color:var(--text);cursor:pointer}.share-profile-card{display:flex;align-items:center;gap:12px;margin:16px 18px 8px;padding:12px;border:1px solid var(--line);border-radius:15px}.share-profile-card img{width:48px;height:48px;border-radius:50%;object-fit:cover}.share-profile-card strong{display:block}.share-search{margin:8px 18px 12px}.share-search input{width:100%;border:1px solid var(--line);border-radius:12px;padding:11px 13px;background:var(--bg);color:var(--text);outline:none}.recipient-list{overflow:auto;padding:0 18px 14px;display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.recipient{display:flex;align-items:center;gap:10px;padding:10px;border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:13px;cursor:pointer;text-align:left}.recipient:hover{background:var(--soft)}.recipient.selected{border-color:var(--primary);background:var(--soft)}.recipient img{width:42px;height:42px;border-radius:50%;object-fit:cover;flex:0 0 auto}.recipient-info{min-width:0;flex:1}.recipient-info strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.recipient-info small{color:var(--muted)}.check{width:23px;height:23px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;flex:0 0 auto}.recipient.selected .check{background:var(--primary);border-color:var(--primary);color:#fff}.share-footer{border-top:1px solid var(--line);padding:13px 18px;display:flex;gap:10px;align-items:center}.selected-count{flex:1;color:var(--muted);font-size:.84rem}.send-profile{border:0;border-radius:12px;background:var(--primary);color:#fff;font-weight:800;padding:11px 18px;cursor:pointer}.send-profile:disabled{opacity:.55;cursor:not-allowed}.share-empty{text-align:center;color:var(--muted);padding:40px 15px;grid-column:1/-1}
    .modal{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;place-items:center;padding:18px;z-index:10001}.modal.open{display:grid}.modal-card{background:var(--card);color:var(--text);width:min(460px,100%);border-radius:20px;padding:22px}.modal-head{display:flex;justify-content:space-between;align-items:center}.modal-close{border:0;background:transparent;color:var(--text);font-size:1.3rem;cursor:pointer}@media(max-width:760px){.profile-page{padding:82px 10px 40px}.profile-card{padding:20px}.profile-head{flex-direction:column;text-align:center}.meta{justify-content:center}.actions{justify-content:center}.blog-grid,.people{grid-template-columns:1fr}.cover{height:190px}.tabs{overflow:auto}.tab{min-width:105px}.post-menu{right:8px}.recipient-list{grid-template-columns:1fr}.share-sheet{max-height:90vh;border-radius:20px 20px 0 0}}
  </style>
</head>
<body>
  <%- include("./partials/nave") %>
  <main class="profile-page"><div class="profile-shell">
    <section class="profile-card">
      <div class="profile-head">
        <img class="avatar" src="<%= user.profileImageURL || '/imgs/default.png' %>" alt="<%= user.fullName %>" onerror="this.src='/imgs/default.png'">
        <div class="identity">
          <span class="badge"><i class="fas <%= user.isPrivate ? 'fa-lock' : 'fa-globe' %>"></i> <%= user.isPrivate ? 'Private account' : 'Public account' %></span>
          <h1><%= user.fullName %></h1>
          <% if(user.email && isOwnProfile){ %><p class="email"><%= user.email %></p><% } %>
          <% if(user.bio){ %><p class="bio"><%= user.bio %></p><% } %>
          <div class="meta">
            <% if(user.location){ %><span><i class="fas fa-map-marker-alt"></i> <%= user.location %></span><% } %>
            <% if(user.website){ %><a href="<%= user.website %>" target="_blank" rel="noopener noreferrer"><i class="fas fa-link"></i> Website</a><% } %>
          </div>
        </div>
        <div class="actions">
          <% if(isOwnProfile){ %>
            <a class="btn primary" href="/user/profile/edit"><i class="fas fa-edit"></i> Edit profile</a>
            <a class="btn secondary" href="/user/profile/settings"><i class="fas fa-cog"></i> Settings</a>
          <% } else if(isLoggedIn){ %>
            <button type="button" id="followBtn" class="btn <%= followState === 'following' ? 'success' : 'secondary' %>" onclick="toggleFollow()"><i class="fas <%= followState === 'following' ? 'fa-user-check' : followState === 'requested' ? 'fa-clock' : 'fa-user-plus' %>"></i> <span id="followText"><%= followState === 'following' ? 'Following' : followState === 'requested' ? 'Request sent' : 'Follow' %></span></button>
            <% const canMessage=!user.isPrivate || followState==='following'; %>
            <% if(canMessage){ %><a class="btn primary" href="/messages?user=<%= user._id %>"><i class="fas fa-comment-dots"></i> Message</a><% } %>
          <% } %>
          <% if(isLoggedIn && !isOwnProfile){ %>
            <div class="profile-menu-wrap">
              <button type="button" class="profile-more" id="profileMore" aria-label="More profile actions" aria-expanded="false" onclick="toggleProfileMenu(event)"><i class="fas fa-ellipsis-h"></i></button>
              <div class="profile-menu" id="profileMenu">
                <button type="button" onclick="openShareSheet()"><i class="fas fa-paper-plane"></i> Share profile</button>
                <button type="button" onclick="copyProfileLink()"><i class="fas fa-link"></i> Copy profile link</button>
                <button type="button" class="danger" onclick="openBlockConfirm()"><i class="fas fa-ban"></i> Block</button>
                <button type="button" class="danger" onclick="toast('Report feature is coming soon')"><i class="fas fa-flag"></i> Report</button>
                <button type="button" onclick="closeProfileMenu()"><i class="fas fa-times"></i> Cancel</button>
              </div>
            </div>
          <% } %>
        </div>
      </div>
      <div class="stats">
        <button class="stat" type="button" onclick="openPanel('followers')"><strong id="followerCount"><%= followerCount %></strong><span>Followers</span></button>
        <button class="stat" type="button" onclick="openPanel('following')"><strong id="followingCount"><%= followingCount %></strong><span>Following</span></button>
        <button class="stat" type="button" onclick="openPanel('blogs')"><strong><%= blogCount %></strong><span>Blogs</span></button>
      </div>
    </section>

    <nav class="tabs">
      <button class="tab active" data-panel="blogs" type="button" onclick="openPanel('blogs')"><i class="fas fa-book"></i> Blogs</button>
      <button class="tab" data-panel="followers" type="button" onclick="openPanel('followers')"><i class="fas fa-users"></i> Followers</button>
      <button class="tab" data-panel="following" type="button" onclick="openPanel('following')"><i class="fas fa-user-friends"></i> Following</button>
    </nav>

    <section class="content-card">
      <div id="blogs" class="panel active">
        <% if(contentLocked){ %>
          <div class="lock"><i class="fas fa-lock"></i><h3>This account is private</h3><p>Follow <%= user.fullName %> and wait for approval to see their blogs.</p></div>
        <% } else if(!blogs.length){ %>
          <div class="empty"><i class="fas fa-pen"></i><h3>No blogs published yet</h3></div>
        <% } else { %>
          <div class="blog-grid">
            <% blogs.forEach(blog=>{ %>
              <article class="blog" id="post-<%= blog._id %>">
                <% if(isOwnProfile){ %>
                  <button type="button" class="post-more" aria-label="Post options" aria-expanded="false" onclick="togglePostMenu('<%= blog._id %>', event)"><i class="fas fa-ellipsis-v"></i></button>
                  <div class="post-menu" id="post-menu-<%= blog._id %>">
                    <button type="button" onclick="editPost('<%= blog._id %>')"><i class="fas fa-edit"></i> Edit post</button>
                    <button type="button" class="delete-post" onclick="deletePost('<%= blog._id %>')"><i class="fas fa-trash"></i> Delete post</button>
                  </div>
                <% } %>
                <div class="blog-inner">
                  <% if(blog.mediaType==='video' && blog.videoURL){ %>
                    <video class="cover" controls preload="metadata" playsinline poster="<%= blog.coverImageURL || '' %>"><source src="<%= blog.videoURL %>" type="video/mp4">Your browser does not support video.</video>
                  <% } else if(blog.coverImageURL){ %>
                    <img class="cover" src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" onerror="this.src='/images/default-blog.png'">
                  <% } else { %><div class="cover"></div><% } %>
                  <div class="blog-body">
                    <h3><%= blog.title %></h3>
                    <p><%= blog.excerpt || (blog.body ? blog.body.substring(0,140) : '') %></p>
                    <div class="blog-meta"><span><i class="far fa-calendar"></i> <%= new Date(blog.createdAt).toLocaleDateString() %></span><span><i class="far fa-heart"></i> <%= blog.likes ? blog.likes.length : 0 %> · <i class="far fa-eye"></i> <%= blog.viewCount || 0 %></span></div>
                    <a class="btn primary" style="margin-top:12px;justify-content:center;width:100%" href="/blogs/<%= blog._id %>">Read post</a>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </div>
      <div id="followers" class="panel"><div id="followersContent" class="empty">Loading followers…</div></div>
      <div id="following" class="panel"><div id="followingContent" class="empty">Loading following…</div></div>
    </section>
  </div></main>

  <div class="toast" id="toast"></div>

  <div class="share-overlay" id="shareOverlay" onclick="closeShareSheet(event)"></div>
  <section class="share-sheet" id="shareSheet" aria-modal="true" role="dialog" aria-labelledby="shareTitle">
    <div class="sheet-grip"></div>
    <header class="share-head"><h3 id="shareTitle"><i class="fas fa-paper-plane me-2"></i>Share profile</h3><button class="sheet-close" type="button" onclick="closeShareSheet()" aria-label="Close"><i class="fas fa-times"></i></button></header>
    <div class="share-profile-card"><img src="<%= user.profileImageURL || '/imgs/default.png' %>" alt="" onerror="this.src='/imgs/default.png'"><div><strong><%= user.fullName %></strong><small>Send this profile in Blogify chat</small></div></div>
    <div class="share-search"><input id="recipientSearch" type="search" autocomplete="off" placeholder="Search people you have chatted with…" oninput="filterRecipients(this.value)"></div>
    <div class="recipient-list" id="recipientList"><div class="share-empty"><i class="fas fa-spinner fa-spin"></i><p>Loading your chats…</p></div></div>
    <footer class="share-footer"><span class="selected-count" id="selectedCount">0 selected</span><button class="send-profile" id="sendProfileBtn" type="button" disabled onclick="sendSharedProfile()"><i class="fas fa-paper-plane me-1"></i> Send profile</button></footer>
  </section>

  <div class="modal" id="blockModal" aria-modal="true" role="dialog">
    <div class="modal-card">
      <div class="modal-head"><h3>Block <%= user.fullName %>?</h3><button class="modal-close" onclick="closeBlockConfirm()"><i class="fas fa-times"></i></button></div>
      <p class="mt-3">They will no longer be able to message, follow, or interact with you through Blogify.</p>
      <div class="d-flex justify-content-end gap-2 mt-4"><button class="btn secondary" onclick="closeBlockConfirm()">Cancel</button><button class="btn" style="background:var(--danger);color:#fff" id="confirmBlockBtn" onclick="blockUser()">Block</button></div>
    </div>
  </div>

  <%- include("./partials/scripts") %>
  <script>
    const profileUserId='<%= user._id %>'; const isLoggedIn=<%= isLoggedIn ? 'true':'false' %>';
    let shareRecipients=[];const selectedRecipients=new Set();
    function toast(message){const el=document.getElementById('toast');if(!el)return;el.textContent=message;el.style.display='block';clearTimeout(window.__toast);window.__toast=setTimeout(()=>el.style.display='none',2800)}
    function openPanel(name){document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.id===name));document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.dataset.panel===name));if(name==='followers'||name==='following')loadPeople(name)}
    function togglePostMenu(id,event){event?.stopPropagation();document.querySelectorAll('.post-menu.open').forEach(m=>m.classList.remove('open'));const menu=document.getElementById('post-menu-'+id);const button=document.querySelector('#post-'+id+' .post-more');if(menu){const open=!menu.classList.contains('open');menu.classList.toggle('open',open);button?.setAttribute('aria-expanded',String(open));}}
    function toggleProfileMenu(event){event?.stopPropagation();const m=document.getElementById('profileMenu');const b=document.getElementById('profileMore');if(!m)return;const open=!m.classList.contains('open');m.classList.toggle('open',open);b?.setAttribute('aria-expanded',String(open))}
    function closeProfileMenu(){const m=document.getElementById('profileMenu');const b=document.getElementById('profileMore');m?.classList.remove('open');b?.setAttribute('aria-expanded','false')}
    document.addEventListener('click',e=>{if(!e.target.closest('.profile-menu-wrap'))closeProfileMenu();document.querySelectorAll('.post-menu.open').forEach(m=>m.classList.remove('open'))});
    async function editPost(id){location.href='/blogs/'+encodeURIComponent(id)+'/edit'}
    async function deletePost(id){document.querySelectorAll('.post-menu.open').forEach(m=>m.classList.remove('open'));if(!confirm('Delete this post? This action will remove it from your profile.'))return;const article=document.getElementById('post-'+id);try{const response=await fetch('/blogs/'+encodeURIComponent(id),{method:'DELETE',credentials:'same-origin',headers:{Accept:'application/json'}});const data=await response.json().catch(()=>({}));if(!response.ok||!data.success)throw new Error(data.message||'Failed to delete post');article?.remove();toast(data.message||'Post deleted successfully');if(!document.querySelectorAll('.blog-grid .blog').length)location.reload()}catch(error){toast(error.message||'Unable to delete post')}}
    async function toggleFollow(){if(!isLoggedIn){location.href='/user/signin';return}const button=document.getElementById('followBtn');if(!button)return;button.disabled=true;try{const response=await fetch('/follow/'+profileUserId+'/follow',{method:'POST',credentials:'same-origin',headers:{Accept:'application/json'}});const data=await response.json();if(!response.ok||!data.success)throw new Error(data.message||'Unable to follow');const text=document.getElementById('followText');if(data.following){button.className='btn success';button.querySelector('i').className='fas fa-user-check';text.textContent='Following'}else if(data.requested){button.className='btn secondary';button.querySelector('i').className='fas fa-clock';text.textContent='Request sent'}else{button.className='btn secondary';button.querySelector('i').className='fas fa-user-plus';text.textContent='Follow'}toast(data.message||'Follow status updated');refreshCounts()}catch(error){toast(error.message||'Unable to follow')}finally{button.disabled=false}}
    async function refreshCounts(){try{const [a,b]=await Promise.all([fetch('/follow/'+profileUserId+'/followers?page=1',{credentials:'same-origin',headers:{Accept:'application/json'}}),fetch('/follow/'+profileUserId+'/following?page=1',{credentials:'same-origin',headers:{Accept:'application/json'}})]);if(!a.ok||!b.ok)return;const followers=await a.json();const following=await b.json();if(followers.success)document.getElementById('followerCount').textContent=Number(followers.total||0);if(following.success)document.getElementById('followingCount').textContent=Number(following.total||0)}catch(e){console.debug('count refresh failed',e)}}
    async function loadPeople(type){const box=document.getElementById(type+'Content');if(!box)return;try{const response=await fetch('/follow/'+profileUserId+'/'+type,{credentials:'same-origin',headers:{Accept:'application/json'}});const data=await response.json();if(!response.ok||data.success===false){box.innerHTML='<div class="lock">Unable to load list.</div>';return}const list=data[type]||[];if(!list.length){box.className='empty';box.textContent='No '+type+' yet.';return}box.className='people';box.innerHTML=list.map(p=>`<div class="person"><img src="${escapeHtml(p.profileImageURL||'/imgs/default.png')}" alt="${escapeHtml(p.fullName||'User')}" onerror="this.src='/imgs/default.png'"><strong>${escapeHtml(p.fullName||'User')}</strong><small>${escapeHtml(p.bio||'')}</small><br><a class="btn secondary" href="/user/profile/${encodeURIComponent(p._id)}">View profile</a></div>`).join('')}catch(e){box.className='empty';box.textContent='Unable to load this list.'}}
    function escapeHtml(value){return String(value||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
    function copyProfileLink(){closeProfileMenu();const url=location.href;navigator.clipboard?.writeText(url).then(()=>toast('Profile link copied')).catch(()=>{const t=document.createElement('textarea');t.value=url;document.body.appendChild(t);t.select();document.execCommand('copy');t.remove();toast('Profile link copied')})}
    function openShareSheet(){closeProfileMenu();if(!isLoggedIn){location.href='/user/signin';return}selectedRecipients.clear();document.getElementById('shareOverlay').classList.add('open');document.getElementById('shareSheet').classList.add('open');document.body.style.overflow='hidden';document.getElementById('recipientSearch').value='';updateSelectionUI();loadShareRecipients()}
    function closeShareSheet(event){if(event&&event.target!==document.getElementById('shareOverlay'))return;document.getElementById('shareOverlay').classList.remove('open');document.getElementById('shareSheet').classList.remove('open');document.body.style.overflow=''}
    async function loadShareRecipients(){const list=document.getElementById('recipientList');list.innerHTML='<div class="share-empty"><i class="fas fa-spinner fa-spin"></i><p>Loading your chats…</p></div>';try{const response=await fetch('/messages/history',{credentials:'same-origin',headers:{Accept:'application/json'}});const data=await response.json().catch(()=>({}));if(!response.ok||!data.success)throw new Error(data.message||'Unable to load chats');const me='<%= isLoggedIn ? (typeof userId!=='undefined' ? userId : '') : '' %>';const map=new Map();(data.conversations||[]).forEach(c=>(c.participants||[]).forEach(p=>{if(String(p._id)!==String(profileUserId)&&String(p._id)!==String(me))map.set(String(p._id),p)}));shareRecipients=[...map.values()];renderRecipients(shareRecipients)}catch(e){list.innerHTML='<div class="share-empty"><i class="fas fa-comments"></i><p>Unable to load your chats.</p><button class="btn secondary" type="button" onclick="loadShareRecipients()">Retry</button></div>'}}
    function renderRecipients(items){const list=document.getElementById('recipientList');if(!items.length){list.innerHTML='<div class="share-empty"><i class="far fa-comment-dots fa-2x"></i><p>No saved chats found.</p><small>Start a chat first, then you can share this profile here.</small></div>';return}list.innerHTML=items.map(p=>{const id=String(p._id),sel=selectedRecipients.has(id);return `<button type="button" class="recipient ${sel?'selected':''}" onclick="toggleRecipient('${id}',event)"><img src="${escapeHtml(p.profileImageURL||'/imgs/default.png')}" alt="" onerror="this.src='/imgs/default.png'"><span class="recipient-info"><strong>${escapeHtml(p.fullName||'User')}</strong><small>Chat</small></span><span class="check">${sel?'✓':''}</span></button>`}).join('')}
    function filterRecipients(q){const query=String(q||'').trim().toLowerCase();renderRecipients(shareRecipients.filter(p=>String(p.fullName||'').toLowerCase().includes(query)))}
    function toggleRecipient(id,event){event?.preventDefault();if(selectedRecipients.has(id))selectedRecipients.delete(id);else selectedRecipients.add(id);updateSelectionUI();filterRecipients(document.getElementById('recipientSearch').value)}
    function updateSelectionUI(){const count=selectedRecipients.size;document.getElementById('selectedCount').textContent=count+(count===1?' selected':' selected');document.getElementById('sendProfileBtn').disabled=count===0}
    async function sendSharedProfile(){if(!selectedRecipients.size)return;const button=document.getElementById('sendProfileBtn');button.disabled=true;const ids=[...selectedRecipients];let sent=0;try{for(const recipientId of ids){const response=await fetch('/messages/share-profile',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({recipientId,profileId:profileUserId})});const data=await response.json().catch(()=>({}));if(!response.ok||!data.success)throw new Error(data.message||'Unable to share profile');sent++}toast(sent===1?'Profile shared successfully':`Profile shared with ${sent} people`);selectedRecipients.clear();updateSelectionUI();setTimeout(()=>closeShareSheet(),250)}catch(e){toast(e.message||'Unable to share profile')}finally{button.disabled=selectedRecipients.size===0}}
    function openBlockConfirm(){closeProfileMenu();document.getElementById('blockModal').classList.add('open');document.body.style.overflow='hidden'}function closeBlockConfirm(){document.getElementById('blockModal').classList.remove('open');if(!document.getElementById('shareSheet')?.classList.contains('open'))document.body.style.overflow=''}
    async function blockUser(){const button=document.getElementById('confirmBlockBtn');button.disabled=true;try{const response=await fetch('/messages/block/'+profileUserId,{method:'POST',credentials:'same-origin',headers:{Accept:'application/json'}});const data=await response.json().catch(()=>({}));if(!response.ok||!data.success)throw new Error(data.message||'Unable to block user');closeBlockConfirm();toast(data.message||'User blocked');setTimeout(()=>location.reload(),700)}catch(e){toast(e.message||'Unable to block user')}finally{button.disabled=false}}
    refreshCounts();document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeShareSheet();closeBlockConfirm();closeProfileMenu()}});
  </script>
</body>
</html>
