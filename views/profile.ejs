<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title><%= user.fullName %> | Blogify</title>
  <style>
    :root{--bg:#f6f7fb;--card:#fff;--text:#182033;--muted:#718096;--line:#e7eaf1;--primary:#635bff;--soft:#efedff;--shadow:0 16px 45px rgba(24,32,51,.08)}
    *{box-sizing:border-box}.profile-page{min-height:100vh;background:var(--bg);color:var(--text);padding:94px 16px 60px}.profile-shell{max-width:1120px;margin:auto}.profile-card,.content-card{background:var(--card);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.profile-card{padding:30px}.profile-head{display:flex;gap:25px;align-items:center}.avatar{width:132px;height:132px;border-radius:50%;object-fit:cover;border:5px solid var(--card);box-shadow:0 8px 28px rgba(0,0,0,.12)}.identity{flex:1;min-width:0}.identity h1{margin:0 0 5px;font-size:2rem;letter-spacing:-.035em}.identity .email{color:var(--muted);font-size:.86rem;margin:0 0 12px}.bio{margin:0 0 12px;line-height:1.6;max-width:700px}.meta{display:flex;flex-wrap:wrap;gap:12px;color:var(--muted);font-size:.84rem}.meta a{color:var(--primary);text-decoration:none}.badge{display:inline-flex;align-items:center;gap:6px;border-radius:99px;padding:6px 10px;background:var(--soft);color:var(--primary);font-weight:800;font-size:.72rem}.actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}.btn{border:0;border-radius:11px;padding:10px 15px;font-weight:800;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:7px}.primary{background:var(--primary);color:#fff}.secondary{background:var(--card);border:1px solid var(--line);color:var(--text)}.success{background:#159570;color:#fff}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:28px;padding-top:22px;border-top:1px solid var(--line)}.stat{text-align:center;border:0;background:transparent;color:var(--text);cursor:pointer}.stat strong{display:block;font-size:1.25rem}.stat span{color:var(--muted);font-size:.78rem}.tabs{display:flex;gap:5px;margin:22px 0 15px;padding:5px;background:var(--card);border:1px solid var(--line);border-radius:15px}.tab{flex:1;border:0;background:transparent;padding:11px;border-radius:10px;color:var(--muted);font-weight:800;cursor:pointer}.tab.active{background:var(--soft);color:var(--primary)}.content-card{padding:24px}.panel{display:none}.panel.active{display:block}.blog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.blog{border:1px solid var(--line);border-radius:17px;overflow:hidden;background:var(--card);display:flex;flex-direction:column}.cover{width:100%;height:210px;object-fit:cover;background:var(--bg)}.blog-body{padding:17px;display:flex;flex-direction:column;flex:1}.blog h3{font-size:1.08rem;margin:0 0 8px}.blog p{color:var(--muted);font-size:.85rem;line-height:1.5;flex:1}.blog-meta{display:flex;justify-content:space-between;color:var(--muted);font-size:.74rem;padding-top:12px;border-top:1px solid var(--line)}.empty{text-align:center;padding:55px 15px;color:var(--muted)}.empty i{font-size:2.8rem;margin-bottom:12px}.lock{background:var(--soft);border-radius:18px;padding:35px;text-align:center}.lock i{font-size:2.4rem;color:var(--primary);margin-bottom:12px}.people{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.person{border:1px solid var(--line);border-radius:15px;padding:16px;text-align:center}.person img{width:58px;height:58px;border-radius:50%;object-fit:cover}.person strong{display:block;margin-top:8px}.person small{color:var(--muted)}.toast{position:fixed;right:20px;bottom:20px;background:#182033;color:white;padding:12px 16px;border-radius:11px;display:none;z-index:20}@media(max-width:760px){.profile-page{padding:82px 10px 40px}.profile-card{padding:20px}.profile-head{flex-direction:column;text-align:center}.identity .email{margin-bottom:8px}.meta{justify-content:center}.actions{justify-content:center}.stats{margin-top:20px}.blog-grid,.people{grid-template-columns:1fr}.cover{height:190px}.tabs{overflow:auto}.tab{min-width:105px}}
  </style>
</head>
<body>
<%- include("./partials/nave") %>
<main class="profile-page"><div class="profile-shell">
  <section class="profile-card">
    <div class="profile-head">
      <img class="avatar" src="<%= user.profileImageURL || '/imgs/default.png' %>" alt="<%= user.fullName %>" onerror="this.src='/imgs/default.png'">
      <div class="identity">
        <div style="margin-bottom:9px"><span class="badge"><i class="fas <%= user.isPrivate ? 'fa-lock' : 'fa-globe' %>"></i> <%= user.isPrivate ? 'Private account' : 'Public account' %></span></div>
        <h1><%= user.fullName %></h1>
        <% if (user.email && isOwnProfile) { %><p class="email"><%= user.email %></p><% } %>
        <% if (user.bio) { %><p class="bio"><%= user.bio %></p><% } %>
        <div class="meta"><% if (user.location) { %><span><i class="fas fa-map-marker-alt"></i> <%= user.location %></span><% } %><% if (user.website) { %><a href="<%= user.website %>" target="_blank" rel="noopener"><i class="fas fa-link"></i> Website</a><% } %></div>
      </div>
      <div class="actions">
        <% if (isOwnProfile) { %><a class="btn primary" href="/user/profile/edit"><i class="fas fa-edit"></i> Edit profile</a><a class="btn secondary" href="/user/profile/settings"><i class="fas fa-cog"></i> Settings</a>
        <% } else if (isLoggedIn) { %><button id="followBtn" class="btn <%= followState === 'following' ? 'success' : 'secondary' %>" onclick="toggleFollow()"><i class="fas <%= followState === 'following' ? 'fa-user-check' : followState === 'requested' ? 'fa-clock' : 'fa-user-plus' %>"></i> <%= followState === 'following' ? 'Following' : followState === 'requested' ? 'Request sent' : 'Follow' %></button>
        <% } else { %><a class="btn primary" href="/user/signin"><i class="fas fa-user-plus"></i> Sign in to follow</a><% } %>
      </div>
    </div>
    <div class="stats"><button class="stat" onclick="openPanel('followers')"><strong><%= followerCount %></strong><span>Followers</span></button><button class="stat" onclick="openPanel('following')"><strong><%= followingCount %></strong><span>Following</span></button><button class="stat" onclick="openPanel('blogs')"><strong><%= blogCount %></strong><span>Blogs</span></button></div>
  </section>
  <nav class="tabs" aria-label="Profile sections"><button class="tab active" data-panel="blogs" onclick="openPanel('blogs')"><i class="fas fa-book"></i> Blogs</button><button class="tab" data-panel="followers" onclick="openPanel('followers')"><i class="fas fa-users"></i> Followers</button><button class="tab" data-panel="following" onclick="openPanel('following')"><i class="fas fa-user-friends"></i> Following</button></nav>
  <section class="content-card">
    <div id="blogs" class="panel active">
      <% if (contentLocked) { %><div class="lock"><i class="fas fa-lock"></i><h3>This account is private</h3><p>Follow <%= user.fullName %> and wait for approval to see their blogs and lists.</p></div>
      <% } else if (!blogs.length) { %><div class="empty"><i class="fas fa-pen"></i><h3>No blogs published yet</h3><% if(isOwnProfile){%><a class="btn primary" href="/blogs/add-new">Write your first blog</a><%}%></div>
      <% } else { %><div class="blog-grid"><% blogs.forEach(blog=>{%><article class="blog"><% if(blog.coverImageURL){%><img class="cover" src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" onerror="this.src='/images/default-blog.png'"> <% } else {%><div class="cover" style="display:flex;align-items:center;justify-content:center"><i class="fas fa-image fa-2x" style="color:var(--muted)"></i></div><%}%><div class="blog-body"><h3><%= blog.title %></h3><p><%= blog.excerpt || (blog.body ? blog.body.substring(0,140) : '') %></p><div class="blog-meta"><span><i class="far fa-calendar"></i> <%= new Date(blog.createdAt).toLocaleDateString() %></span><span><i class="far fa-heart"></i> <%= blog.likes ? blog.likes.length : 0 %> · <i class="far fa-eye"></i> <%= blog.viewCount || 0 %></span></div><a class="btn primary" style="margin-top:12px;justify-content:center" href="/blogs/<%= blog._id %>">Read blog</a></div></article><%})%></div><%}%>
    </div>
    <div id="followers" class="panel"><div id="followersContent" class="empty"><i class="fas fa-users"></i><p>Loading followers…</p></div></div>
    <div id="following" class="panel"><div id="followingContent" class="empty"><i class="fas fa-user-friends"></i><p>Loading following…</p></div></div>
  </section>
</div></main><div class="toast" id="toast"></div>
<%- include("./partials/scripts") %>
<script>
const profileUserId='<%= user._id %>',isLoggedIn=<%= isLoggedIn ? 'true':'false' %>;
function toast(m){const x=document.getElementById('toast');x.textContent=m;x.style.display='block';clearTimeout(window.__t);window.__t=setTimeout(()=>x.style.display='none',2800)}
function openPanel(name){document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('active',x.id===name));document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.dataset.panel===name));if(name==='followers'||name==='following')loadPeople(name)}
async function toggleFollow(){if(!isLoggedIn)return location.href='/user/signin';const btn=document.getElementById('followBtn');btn.disabled=true;try{const r=await fetch('/follow/'+profileUserId+'/follow',{method:'POST',credentials:'same-origin'});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to follow');btn.innerHTML=d.following?'<i class="fas fa-user-check"></i> Following':d.requested?'<i class="fas fa-clock"></i> Request sent':'<i class="fas fa-user-plus"></i> Follow';btn.className='btn '+(d.following?'success':'secondary');toast(d.message)}catch(e){toast(e.message)}finally{btn.disabled=false}}
async function loadPeople(type){const box=document.getElementById(type+'Content');box.innerHTML='<div class="empty"><p>Loading…</p></div>';try{const r=await fetch('/follow/'+profileUserId+'/'+type,{credentials:'same-origin'});const d=await r.json();if(!r.ok){box.innerHTML='<div class="lock"><i class="fas fa-lock"></i><h3>Private list</h3><p>'+d.message+'</p></div>';return}const list=d[type]||[];if(!list.length){box.innerHTML='<div class="empty"><i class="fas fa-user-friends"></i><p>No '+type+' yet.</p></div>';return}box.className='people';box.innerHTML=list.map(p=>`<div class="person"><img src="${p.profileImageURL||'/imgs/default.png'}" onerror="this.src='/imgs/default.png'"><strong>${escapeHtml(p.fullName||'User')}</strong><small>${escapeHtml(p.bio||'')}</small><div style="margin-top:10px"><a class="btn secondary" href="/user/profile/${p._id}">View profile</a></div></div>`).join('')}catch(e){box.innerHTML='<div class="empty"><p>Unable to load this list.</p></div>'}}
function escapeHtml(v){return String(v).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
</script></body></html>