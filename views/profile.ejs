<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title><%= user.fullName %> | Blogify</title>
  <style>
    :root{--bg:#f6f7fb;--card:#fff;--text:#182033;--muted:#718096;--line:#e7eaf1;--primary:#635bff;--soft:#efedff;--danger:#e5484d;--shadow:0 16px 45px rgba(24,32,51,.08)}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}button,a{font:inherit}.profile-page{min-height:100vh;padding:94px 16px 60px;background:var(--bg)}.profile-shell{max-width:1120px;margin:auto}.profile-card,.content-card{background:var(--card);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.profile-card{padding:30px}.profile-head{display:flex;gap:25px;align-items:center}.avatar{width:132px;height:132px;border-radius:50%;object-fit:cover;border:5px solid var(--card);box-shadow:0 8px 28px rgba(0,0,0,.12);flex:none}.identity{flex:1;min-width:0}.identity h1{margin:8px 0 5px;font-size:2rem;line-height:1.15}.email,.stat span,.blog p,.blog-meta,.person small{color:var(--muted)}.bio{margin:0 0 12px;line-height:1.6;max-width:700px}.meta{display:flex;flex-wrap:wrap;gap:12px;color:var(--muted);font-size:.84rem}.meta a{color:var(--primary);text-decoration:none}.badge{display:inline-flex;gap:6px;border-radius:99px;padding:6px 10px;background:var(--soft);color:var(--primary);font-weight:800;font-size:.72rem}.actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end;align-items:center;position:relative}.btn{border:0;border-radius:11px;padding:10px 15px;font-weight:800;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:7px}.btn:disabled{opacity:.6;cursor:not-allowed}.primary{background:var(--primary);color:#fff}.secondary{background:var(--card);border:1px solid var(--line);color:var(--text)}.success{background:#159570;color:#fff}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:28px;padding-top:22px;border-top:1px solid var(--line)}.stat{text-align:center;border:0;background:transparent;color:var(--text);cursor:pointer;padding:12px 8px;border-radius:14px}.stat:hover{background:var(--soft)}.stat strong{display:block;font-size:1.25rem}.tabs{display:flex;gap:5px;margin:22px 0 15px;padding:5px;background:var(--card);border:1px solid var(--line);border-radius:15px}.tab{flex:1;border:0;background:transparent;padding:12px;border-radius:10px;color:var(--muted);font-weight:800;cursor:pointer}.tab.active{background:var(--soft);color:var(--primary)}.content-card{padding:24px;min-height:220px}.panel{display:none}.panel.active{display:block}.blog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.blog{position:relative;border:1px solid var(--line);border-radius:17px;background:var(--card);overflow:visible}.blog-inner{overflow:hidden;border-radius:17px}.cover{width:100%;height:210px;object-fit:cover;background:var(--bg);display:block}.blog-body{padding:17px}.blog h3{font-size:1.08rem;margin:0 38px 8px 0}.blog p{font-size:.85rem;line-height:1.5}.blog-meta{display:flex;justify-content:space-between;gap:8px;font-size:.74rem;padding-top:12px;border-top:1px solid var(--line)}.post-more{position:absolute;right:12px;top:12px;width:40px;height:40px;border:1px solid var(--line);border-radius:50%;background:var(--card);color:var(--text);display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:30;box-shadow:0 5px 18px rgba(0,0,0,.12)}.post-menu{position:absolute;right:12px;top:58px;width:190px;background:var(--card);border:1px solid var(--line);border-radius:14px;box-shadow:0 15px 35px rgba(0,0,0,.18);padding:6px;z-index:100;display:none}.post-menu.open{display:block}.post-menu button,.profile-menu button{width:100%;border:0;background:transparent;color:var(--text);padding:11px 12px;border-radius:9px;text-align:left;font-weight:750;cursor:pointer;display:flex;align-items:center;gap:9px}.post-menu button:hover,.profile-menu button:hover{background:var(--soft)}.post-menu .delete-post,.profile-menu .danger{color:var(--danger)}.profile-menu-wrap{position:relative;z-index:500}.profile-more{width:44px;height:44px;border:1px solid var(--line);border-radius:50%;background:var(--card);color:var(--text);cursor:pointer;display:grid;place-items:center;box-shadow:0 5px 18px rgba(0,0,0,.1)}.profile-menu{position:absolute;right:0;top:52px;width:225px;background:var(--card);border:1px solid var(--line);border-radius:15px;box-shadow:0 18px 45px rgba(0,0,0,.2);padding:6px;z-index:1000;display:none}.profile-menu.open{display:block;animation:menuIn .15s ease}.empty{text-align:center;padding:55px 15px;color:var(--muted)}.lock{background:var(--soft);border-radius:18px;padding:35px;text-align:center;color:var(--muted)}.lock h3{color:var(--text)}.people{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.person{border:1px solid var(--line);border-radius:15px;padding:16px;text-align:center;background:var(--card)}.person img{width:62px;height:62px;border-radius:50%;object-fit:cover}.person strong{display:block;margin-top:8px;color:var(--text)}.toast{position:fixed;right:20px;bottom:20px;background:#182033;color:#fff;padding:12px 16px;border-radius:11px;display:none;z-index:20000}.share-overlay,.modal{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:11000;opacity:0;visibility:hidden;transition:.2s}.share-overlay.open,.modal.open{opacity:1;visibility:visible}.share-sheet{position:fixed;left:50%;bottom:0;transform:translate(-50%,105%);width:min(620px,100%);max-height:86vh;background:var(--card);color:var(--text);border-radius:24px 24px 0 0;z-index:11001;display:flex;flex-direction:column;transition:transform .3s cubic-bezier(.16,1,.3,1);box-shadow:0 -20px 60px rgba(0,0,0,.2)}.share-sheet.open{transform:translate(-50%,0)}.sheet-grip{width:42px;height:5px;border-radius:99px;background:var(--line);margin:10px auto 2px}.share-head{display:flex;align-items:center;justify-content:space-between;padding:13px 20px;border-bottom:1px solid var(--line)}.share-head h3{margin:0;font-size:1.05rem}.sheet-close{width:36px;height:36px;border:0;border-radius:50%;background:var(--soft);color:var(--text);cursor:pointer}.share-profile-card{display:flex;align-items:center;gap:12px;margin:16px 18px 8px;padding:12px;border:1px solid var(--line);border-radius:15px}.share-profile-card img{width:48px;height:48px;border-radius:50%;object-fit:cover}.share-profile-card strong{display:block}.share-profile-card small{color:var(--muted)}.share-search{margin:8px 18px 12px}.share-search input{width:100%;border:1px solid var(--line);border-radius:12px;padding:11px 13px;background:var(--bg);color:var(--text);outline:none}.recipient-list{overflow:auto;padding:0 18px 14px;display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.recipient{display:flex;align-items:center;gap:10px;padding:10px;border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:13px;cursor:pointer;text-align:left}.recipient.selected{border-color:var(--primary);background:var(--soft)}.recipient img{width:42px;height:42px;border-radius:50%;object-fit:cover}.recipient-info{min-width:0;flex:1}.recipient-info strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.recipient-info small{color:var(--muted)}.check{width:23px;height:23px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center}.recipient.selected .check{background:var(--primary);border-color:var(--primary);color:#fff}.share-footer{border-top:1px solid var(--line);padding:13px 18px;display:flex;gap:10px;align-items:center}.selected-count{flex:1;color:var(--muted);font-size:.84rem}.send-profile{border:0;border-radius:12px;background:var(--primary);color:#fff;font-weight:800;padding:11px 18px;cursor:pointer}.send-profile:disabled{opacity:.55}.share-empty{text-align:center;color:var(--muted);padding:40px 15px;grid-column:1/-1}.modal{display:grid;place-items:center;padding:18px;z-index:12000}.modal-card{background:var(--card);color:var(--text);width:min(460px,100%);border-radius:20px;padding:22px}.modal-head{display:flex;justify-content:space-between;align-items:center}.modal-close{border:0;background:transparent;color:var(--text);font-size:1.3rem;cursor:pointer}@keyframes menuIn{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:translateY(0)}}
    @media(max-width:760px){.profile-page{padding:82px 10px 40px}.profile-card{padding:20px}.profile-head{flex-direction:column;text-align:center}.meta{justify-content:center}.actions{justify-content:center;width:100%}.actions .btn{flex:1;justify-content:center}.profile-menu-wrap{position:static}.profile-menu{position:fixed;right:12px;top:74px;width:min(250px,calc(100vw - 24px))}.blog-grid,.people{grid-template-columns:1fr}.cover{height:190px}.tabs{overflow:auto}.tab{min-width:105px}.recipient-list{grid-template-columns:1fr}.share-sheet{max-height:92vh;border-radius:20px 20px 0 0}}
  </style>
</head>
<body>
  <%- include("./partials/nave") %>
  <main class="profile-page"><div class="profile-shell">
    <section class="profile-card">
      <div class="profile-head">
        <img class="avatar" src="<%= user.profileImageURL || '/imgs/default.png' %>" alt="<%= user.fullName %>" onerror="this.src='/imgs/default.png'">
        <div class="identity">
          <span class="badge"><i class="fas <%= user.isPrivate ? 'fa-lock' : 'fa-globe' %>"></i> <%= user.isPrivate ? 'Private account' : 'Public account' %></span>
          <h1><%= user.fullName %></h1>
          <% if(user.email && isOwnProfile){ %><p class="email"><%= user.email %></p><% } %>
          <% if(user.bio){ %><p class="bio"><%= user.bio %></p><% } %>
          <div class="meta"><% if(user.location){ %><span><i class="fas fa-map-marker-alt"></i> <%= user.location %></span><% } %><% if(user.website){ %><a href="<%= user.website %>" target="_blank" rel="noopener noreferrer"><i class="fas fa-link"></i> Website</a><% } %></div>
        </div>
        <div class="actions">
          <% if(isOwnProfile){ %>
            <a class="btn primary" href="/user/profile/edit"><i class="fas fa-edit"></i> Edit profile</a>
            <a class="btn secondary" href="/user/profile/settings"><i class="fas fa-cog"></i> Settings</a>
          <% } else if(isLoggedIn){ %>
            <button type="button" id="followBtn" class="btn <%= followState === 'following' ? 'success' : 'secondary' %>" onclick="toggleFollow()"><i class="fas <%= followState === 'following' ? 'fa-user-check' : followState === 'requested' ? 'fa-clock' : 'fa-user-plus' %>"></i><span id="followText"><%= followState === 'following' ? 'Following' : followState === 'requested' ? 'Request sent' : 'Follow' %></span></button>
            <% const canMessage=!user.isPrivate || followState==='following'; %>
            <% if(canMessage){ %><a class="btn primary" href="/messages?user=<%= user._id %>"><i class="fas fa-comment-dots"></i> Message</a><% } %>
            <div class="profile-menu-wrap">
              <button type="button" class="profile-more" id="profileMore" aria-label="More profile actions" aria-expanded="false"><i class="fas fa-ellipsis-h"></i></button>
              <div class="profile-menu" id="profileMenu">
                <button type="button" data-action="share"><i class="fas fa-paper-plane"></i> Share profile</button>
                <button type="button" data-action="copy"><i class="fas fa-link"></i> Copy profile link</button>
                <button type="button" class="danger" data-action="block"><i class="fas fa-ban"></i> Block</button>
                <button type="button" class="danger" data-action="report"><i class="fas fa-flag"></i> Report</button>
              </div>
            </div>
          <% } %>
        </div>
      </div>
      <div class="stats">
        <button class="stat" type="button" data-panel="followers"><strong id="followerCount"><%= followerCount %></strong><span>Followers</span></button>
        <button class="stat" type="button" data-panel="following"><strong id="followingCount"><%= followingCount %></strong><span>Following</span></button>
        <button class="stat" type="button" data-panel="blogs"><strong><%= blogCount %></strong><span>Blogs</span></button>
      </div>
    </section>
    <nav class="tabs" aria-label="Profile sections">
      <button class="tab active" data-panel="blogs" type="button"><i class="fas fa-book"></i> Blogs</button>
      <button class="tab" data-panel="followers" type="button"><i class="fas fa-users"></i> Followers</button>
      <button class="tab" data-panel="following" type="button"><i class="fas fa-user-friends"></i> Following</button>
    </nav>
    <section class="content-card">
      <div id="blogs" class="panel active">
        <% if(contentLocked){ %><div class="lock"><i class="fas fa-lock"></i><h3>This account is private</h3><p>Follow <%= user.fullName %> and wait for approval to see their blogs.</p></div>
        <% } else if(!blogs.length){ %><div class="empty"><i class="fas fa-pen"></i><h3>No blogs published yet</h3></div>
        <% } else { %><div class="blog-grid"><% blogs.forEach(blog=>{ %>
          <article class="blog" id="post-<%= blog._id %>">
            <% if(isOwnProfile){ %><button type="button" class="post-more" data-post-menu="<%= blog._id %>" aria-label="Post options"><i class="fas fa-ellipsis-v"></i></button><div class="post-menu" id="post-menu-<%= blog._id %>"><button type="button" data-edit-post="<%= blog._id %>"><i class="fas fa-edit"></i> Edit post</button><button type="button" class="delete-post" data-delete-post="<%= blog._id %>"><i class="fas fa-trash"></i> Delete post</button></div><% } %>
            <div class="blog-inner"><% if(blog.mediaType==='video' && blog.videoURL){ %><video class="cover" controls preload="metadata" playsinline poster="<%= blog.coverImageURL || '' %>"><source src="<%= blog.videoURL %>" type="video/mp4"></video><% } else if(blog.coverImageURL){ %><img class="cover" src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" onerror="this.src='/images/default-blog.png'"><% } else { %><div class="cover"></div><% } %><div class="blog-body"><h3><%= blog.title %></h3><p><%= blog.excerpt || (blog.body ? blog.body.substring(0,140) : '') %></p><div class="blog-meta"><span><i class="far fa-calendar"></i> <%= new Date(blog.createdAt).toLocaleDateString() %></span><span><i class="far fa-heart"></i> <%= blog.likes ? blog.likes.length : 0 %> · <i class="far fa-eye"></i> <%= blog.viewCount || 0 %></span></div><a class="btn primary" style="margin-top:12px;justify-content:center;width:100%" href="/blogs/<%= blog._id %>">Read post</a></div></div>
          </article>
        <% }) %></div><% } %>
      </div>
      <div id="followers" class="panel"><div id="followersContent" class="empty">Select Followers to load the list.</div></div>
      <div id="following" class="panel"><div id="followingContent" class="empty">Select Following to load the list.</div></div>
    </section>
  </div></main>
  <div class="toast" id="toast"></div>
  <div class="share-overlay" id="shareOverlay"></div>
  <section class="share-sheet" id="shareSheet" aria-modal="true" role="dialog" aria-labelledby="shareTitle"><div class="sheet-grip"></div><header class="share-head"><h3 id="shareTitle"><i class="fas fa-paper-plane me-2"></i>Share profile</h3><button class="sheet-close" type="button" id="closeShare"><i class="fas fa-times"></i></button></header><div class="share-profile-card"><img src="<%= user.profileImageURL || '/imgs/default.png' %>" alt="" onerror="this.src='/imgs/default.png'"><div><strong><%= user.fullName %></strong><small>Send this profile in Blogify chat</small></div></div><div class="share-search"><input id="recipientSearch" type="search" autocomplete="off" placeholder="Search people you have chatted with…"></div><div class="recipient-list" id="recipientList"><div class="share-empty"><i class="fas fa-spinner fa-spin"></i><p>Open Share profile to load chats.</p></div></div><footer class="share-footer"><span class="selected-count" id="selectedCount">0 selected</span><button class="send-profile" id="sendProfileBtn" type="button" disabled><i class="fas fa-paper-plane me-1"></i> Send profile</button></footer></section>
  <div class="modal" id="blockModal" aria-modal="true" role="dialog"><div class="modal-card"><div class="modal-head"><h3>Block <%= user.fullName %>?</h3><button class="modal-close" id="closeBlock"><i class="fas fa-times"></i></button></div><p class="mt-3">They will no longer be able to message, follow, or interact with you through Blogify.</p><div style="display:flex;justify-content:flex-end;gap:8px;margin-top:18px"><button class="btn secondary" id="cancelBlock">Cancel</button><button class="btn" style="background:var(--danger);color:#fff" id="confirmBlock">Block</button></div></div></div>
  <%- include("./partials/scripts") %>
  <script>
    const profileUserId=<%- JSON.stringify(String(user._id)) %>;
    const isLoggedIn=<%= isLoggedIn ? 'true' : 'false' %>;
    let shareRecipients=[];const selectedRecipients=new Set();let activePeoplePanel=null;
    const $=id=>document.getElementById(id);
    function toast(message){const el=$('toast');if(!el)return;el.textContent=message;el.style.display='block';clearTimeout(window.__toast);window.__toast=setTimeout(()=>el.style.display='none',2800)}
    function escapeHtml(value){return String(value??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]))}
    function openPanel(name){document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.id===name));document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.dataset.panel===name));document.querySelectorAll('.stat').forEach(t=>t.classList.toggle('active',t.dataset.panel===name));if(name==='followers'||name==='following')loadPeople(name)}
    document.querySelectorAll('.tab,.stat').forEach(el=>el.addEventListener('click',()=>openPanel(el.dataset.panel)));
    function closeMenus(except){document.querySelectorAll('.profile-menu.open,.post-menu.open').forEach(m=>{if(m!==except)m.classList.remove('open')})}
    $('profileMore')?.addEventListener('click',e=>{e.stopPropagation();const m=$('profileMenu');const open=!m.classList.contains('open');closeMenus(m);m.classList.toggle('open',open);$('profileMore').setAttribute('aria-expanded',String(open))});
    $('profileMenu')?.addEventListener('click',e=>{const b=e.target.closest('button[data-action]');if(!b)return;closeProfileMenu();const action=b.dataset.action;if(action==='share')openShareSheet();if(action==='copy')copyProfileLink();if(action==='block')openBlockConfirm();if(action==='report')toast('Report feature is coming soon')});
    function closeProfileMenu(){const m=$('profileMenu');m?.classList.remove('open');$('profileMore')?.setAttribute('aria-expanded','false')}
    document.querySelectorAll('[data-post-menu]').forEach(btn=>btn.addEventListener('click',e=>{e.stopPropagation();const m=$('post-menu-'+btn.dataset.postMenu);const open=!m.classList.contains('open');closeMenus(m);m.classList.toggle('open',open);btn.setAttribute('aria-expanded',String(open))}));
    document.querySelectorAll('[data-edit-post]').forEach(b=>b.addEventListener('click',()=>location.href='/blogs/'+encodeURIComponent(b.dataset.editPost)+'/edit'));
    document.querySelectorAll('[data-delete-post]').forEach(b=>b.addEventListener('click',()=>deletePost(b.dataset.deletePost)));
    document.addEventListener('click',e=>{if(!e.target.closest('.profile-menu-wrap')&&!e.target.closest('.post-more')&&!e.target.closest('.post-menu'))closeMenus()});
    async function deletePost(id){closeMenus();if(!confirm('Delete this post? This action cannot be undone.'))return;try{const r=await fetch('/blogs/'+encodeURIComponent(id),{method:'DELETE',credentials:'same-origin',headers:{Accept:'application/json'}});const d=await r.json().catch(()=>({}));if(!r.ok||!d.success)throw new Error(d.message||'Failed to delete post');$('post-'+id)?.remove();toast(d.message||'Post deleted successfully')}catch(e){toast(e.message||'Unable to delete post')}}
    async function toggleFollow(){if(!isLoggedIn){location.href='/user/signin';return}const b=$('followBtn');if(!b)return;b.disabled=true;try{const r=await fetch('/follow/'+encodeURIComponent(profileUserId)+'/follow',{method:'POST',credentials:'same-origin',headers:{Accept:'application/json'}});const d=await r.json().catch(()=>({}));if(!r.ok||!d.success)throw new Error(d.message||'Unable to update follow');const i=b.querySelector('i'),t=$('followText');if(d.following){b.className='btn success';i.className='fas fa-user-check';t.textContent='Following'}else if(d.requested){b.className='btn secondary';i.className='fas fa-clock';t.textContent='Request sent'}else{b.className='btn secondary';i.className='fas fa-user-plus';t.textContent='Follow'}toast(d.message||'Follow status updated');refreshCounts()}catch(e){toast(e.message||'Unable to update follow')}finally{b.disabled=false}}
    async function refreshCounts(){try{const [a,b]=await Promise.all([fetch('/follow/'+encodeURIComponent(profileUserId)+'/followers?page=1',{credentials:'same-origin',headers:{Accept:'application/json'}}),fetch('/follow/'+encodeURIComponent(profileUserId)+'/following?page=1',{credentials:'same-origin',headers:{Accept:'application/json'}})]);const fa=await a.json().catch(()=>({})),fb=await b.json().catch(()=>({}));if(a.ok&&fa.success)$('followerCount').textContent=Number(fa.total??fa.count??(fa.followers||[]).length);if(b.ok&&fb.success)$('followingCount').textContent=Number(fb.total??fb.count??(fb.following||[]).length)}catch(e){}}
    async function loadPeople(type){const box=$(type+'Content');if(!box)return;if(activePeoplePanel===type&&box.dataset.loaded==='1')return;activePeoplePanel=type;box.dataset.loaded='';box.className='empty';box.innerHTML='<i class="fas fa-spinner fa-spin fa-2x"></i><p>Loading '+type+'…</p>';try{const r=await fetch('/follow/'+encodeURIComponent(profileUserId)+'/'+type+'?page=1',{credentials:'same-origin',headers:{Accept:'application/json'}});const d=await r.json().catch(()=>({}));if(!r.ok||d.success===false)throw new Error(d.message||'Unable to load '+type);const list=Array.isArray(d[type])?d[type]:(Array.isArray(d.users)?d.users:[]);box.dataset.loaded='1';if(!list.length){box.className='empty';box.innerHTML='<i class="fas fa-users fa-2x"></i><p>No '+type+' yet.</p>';return}box.className='people';box.innerHTML=list.map(p=>`<article class="person"><img src="${escapeHtml(p.profileImageURL||'/imgs/default.png')}" alt="${escapeHtml(p.fullName||'User')}" onerror="this.src='/imgs/default.png'"><strong>${escapeHtml(p.fullName||'User')}</strong><small>${escapeHtml(p.bio||'')}</small><br><a class="btn secondary" style="margin-top:10px" href="/user/profile/${encodeURIComponent(p._id)}">View profile</a></article>`).join('')}catch(e){box.className='empty';box.innerHTML='<i class="fas fa-triangle-exclamation"></i><p>'+escapeHtml(e.message||'Unable to load this list.')+'</p><button class="btn secondary" type="button" onclick="activePeoplePanel=null;loadPeople(\''+type+'\')">Retry</button>'}}
    function copyProfileLink(){const url=location.href;const done=()=>toast('Profile link copied');if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(url).then(done).catch(()=>fallbackCopy(url,done))}else fallbackCopy(url,done)}
    function fallbackCopy(url,done){const t=document.createElement('textarea');t.value=url;t.style.position='fixed';t.style.opacity='0';document.body.appendChild(t);t.select();try{document.execCommand('copy');done()}catch(e){toast('Copy failed')}finally{t.remove()}}
    function openShareSheet(){if(!isLoggedIn){location.href='/user/signin';return}closeProfileMenu();selectedRecipients.clear();$('shareOverlay').classList.add('open');$('shareSheet').classList.add('open');document.body.style.overflow='hidden';$('recipientSearch').value='';updateSelectionUI();loadShareRecipients()}
    function closeShareSheet(){ $('shareOverlay').classList.remove('open');$('shareSheet').classList.remove('open');if(!$('blockModal').classList.contains('open'))document.body.style.overflow=''}
    $('shareOverlay')?.addEventListener('click',closeShareSheet);$('closeShare')?.addEventListener('click',closeShareSheet);
    async function loadShareRecipients(){const list=$('recipientList');list.innerHTML='<div class="share-empty"><i class="fas fa-spinner fa-spin"></i><p>Loading your chats…</p></div>';try{const r=await fetch('/messages/history',{credentials:'same-origin',headers:{Accept:'application/json'}});const d=await r.json().catch(()=>({}));if(!r.ok||!d.success)throw new Error(d.message||'Unable to load chats');const map=new Map();(d.conversations||[]).forEach(c=>(c.participants||[]).forEach(p=>{if(String(p._id)!==String(profileUserId))map.set(String(p._id),p)}));shareRecipients=[...map.values()];renderRecipients(shareRecipients)}catch(e){list.innerHTML='<div class="share-empty"><i class="fas fa-comments fa-2x"></i><p>Unable to load your chats.</p><button class="btn secondary" type="button" onclick="loadShareRecipients()">Retry</button></div>'}}
    function renderRecipients(items){const list=$('recipientList');if(!items.length){list.innerHTML='<div class="share-empty"><i class="far fa-comment-dots fa-2x"></i><p>No saved chats found.</p><small>Start a chat first, then share this profile here.</small></div>';return}list.innerHTML=items.map(p=>{const id=String(p._id),sel=selectedRecipients.has(id);return `<button type="button" class="recipient ${sel?'selected':''}" data-recipient="${escapeHtml(id)}"><img src="${escapeHtml(p.profileImageURL||'/imgs/default.png')}" alt="" onerror="this.src='/imgs/default.png'"><span class="recipient-info"><strong>${escapeHtml(p.fullName||'User')}</strong><small>Chat</small></span><span class="check">${sel?'✓':''}</span></button>`}).join('');list.querySelectorAll('[data-recipient]').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.recipient;selectedRecipients.has(id)?selectedRecipients.delete(id):selectedRecipients.add(id);updateSelectionUI();filterRecipients($('recipientSearch').value)}))}
    function filterRecipients(q){const x=String(q||'').trim().toLowerCase();renderRecipients(shareRecipients.filter(p=>String(p.fullName||'').toLowerCase().includes(x)))}$('recipientSearch')?.addEventListener('input',e=>filterRecipients(e.target.value));
    function updateSelectionUI(){const n=selectedRecipients.size;$('selectedCount').textContent=n+(n===1?' selected':' selected');$('sendProfileBtn').disabled=n===0}
    $('sendProfileBtn')?.addEventListener('click',sendSharedProfile);async function sendSharedProfile(){const ids=[...selectedRecipients];if(!ids.length)return;const b=$('sendProfileBtn');b.disabled=true;let sent=0;try{for(const recipientId of ids){const r=await fetch('/messages/share-profile',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({recipientId,profileId:profileUserId})});const d=await r.json().catch(()=>({}));if(!r.ok||!d.success)throw new Error(d.message||'Unable to share profile');sent++}toast(sent===1?'Profile shared successfully':`Profile shared with ${sent} people`);selectedRecipients.clear();updateSelectionUI();setTimeout(closeShareSheet,250)}catch(e){toast(e.message||'Unable to share profile');b.disabled=false}}
    function openBlockConfirm(){closeProfileMenu();$('blockModal').classList.add('open');document.body.style.overflow='hidden'}function closeBlockConfirm(){ $('blockModal').classList.remove('open');if(!$('shareSheet').classList.contains('open'))document.body.style.overflow=''}$('closeBlock')?.addEventListener('click',closeBlockConfirm);$('cancelBlock')?.addEventListener('click',closeBlockConfirm);
    $('confirmBlock')?.addEventListener('click',async()=>{const b=$('confirmBlock');b.disabled=true;try{const r=await fetch('/messages/block/'+encodeURIComponent(profileUserId),{method:'POST',credentials:'same-origin',headers:{Accept:'application/json'}});const d=await r.json().catch(()=>({}));if(!r.ok||!d.success)throw new Error(d.message||'Unable to block user');closeBlockConfirm();toast(d.message||'User blocked');setTimeout(()=>location.reload(),700)}catch(e){toast(e.message||'Unable to block user')}finally{b.disabled=false}});
    document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeProfileMenu();closeShareSheet();closeBlockConfirm()}});
    refreshCounts();
  </script>
</body>
</html>
