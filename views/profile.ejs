<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || user.theme || 'system' %>">
<head>
  <%- include("./partials/head") %>
  <title><%= user.fullName %> | Blogify</title>

  <style>
    :root {
      --bg: #f6f7fb;
      --card: #fff;
      --text: #182033;
      --muted: #718096;
      --line: #e7eaf1;
      --primary: #635bff;
      --soft: #efedff;
      --danger: #e5484d;
      --media: #eef0f5;
      --shadow: 0 16px 45px rgba(24, 32, 51, .08);
    }

    html[data-theme="dark"] {
      --bg: #0b0f17;
      --card: #121925;
      --text: #f3f5f9;
      --muted: #aab4c4;
      --line: #273142;
      --primary: #8b83ff;
      --soft: #29264b;
      --danger: #ff6b72;
      --media: #1b2432;
      --shadow: 0 16px 45px rgba(0, 0, 0, .28);
    }

    @media (prefers-color-scheme: dark) {
      html[data-theme="system"] {
        --bg: #0b0f17;
        --card: #121925;
        --text: #f3f5f9;
        --muted: #aab4c4;
        --line: #273142;
        --primary: #8b83ff;
        --soft: #29264b;
        --danger: #ff6b72;
        --media: #1b2432;
        --shadow: 0 16px 45px rgba(0, 0, 0, .28);
      }
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      background: var(--bg);
      color: var(--text);
      transition: background-color .22s ease, color .22s ease;
    }

    .profile-page {
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      padding: 94px 16px 60px;
    }

    .profile-shell {
      max-width: 1120px;
      margin: auto;
    }

    .profile-card,
    .content-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 24px;
      box-shadow: var(--shadow);
      transition: background .22s ease, border-color .22s ease;
    }

    .profile-card {
      padding: 30px;
    }

    .profile-head {
      display: flex;
      gap: 25px;
      align-items: center;
    }

    .avatar {
      width: 132px;
      height: 132px;
      border-radius: 50%;
      object-fit: cover;
      border: 5px solid var(--card);
      box-shadow: 0 8px 28px rgba(0, 0, 0, .12);
      flex-shrink: 0;
    }

    .identity {
      flex: 1;
      min-width: 0;
    }

    .identity h1 {
      margin: 0 0 5px;
      font-size: 2rem;
    }

    .email {
      color: var(--muted);
      font-size: .86rem;
    }

    .bio {
      margin: 0 0 12px;
      line-height: 1.6;
      max-width: 700px;
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      color: var(--muted);
      font-size: .84rem;
    }

    .meta a {
      color: var(--primary);
    }

    .badge {
      display: inline-flex;
      gap: 6px;
      border-radius: 99px;
      padding: 6px 10px;
      background: var(--soft);
      color: var(--primary);
      font-weight: 800;
      font-size: .72rem;
    }

    .actions {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
      justify-content: flex-start;
      position: relative;
    }

    .btn {
      border: 0;
      border-radius: 11px;
      padding: 10px 15px;
      font-weight: 800;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      transition:
        transform .15s ease,
        opacity .15s ease,
        background .2s ease;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn:disabled {
      opacity: .6;
      cursor: not-allowed;
      transform: none;
    }

    .primary {
      background: var(--primary);
      color: #fff;
    }

    .secondary {
      background: var(--card);
      border: 1px solid var(--line);
      color: var(--text);
    }

    .success {
      background: #159570;
      color: #fff;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 28px;
      padding-top: 22px;
      border-top: 1px solid var(--line);
    }

    .stat {
      text-align: center;
      border: 0;
      background: transparent;
      color: var(--text);
      cursor: pointer;
      padding: 8px;
      border-radius: 12px;
    }

    .stat:hover {
      background: var(--soft);
    }

    .stat strong {
      display: block;
      font-size: 1.25rem;
    }

    .stat span {
      color: var(--muted);
      font-size: .78rem;
    }

    .tabs {
      display: flex;
      gap: 5px;
      margin: 22px 0 15px;
      padding: 5px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 15px;
    }

    .tab {
      flex: 1;
      border: 0;
      background: transparent;
      padding: 11px;
      border-radius: 10px;
      color: var(--muted);
      font-weight: 800;
      cursor: pointer;
    }

    .tab.active {
      background: var(--soft);
      color: var(--primary);
    }

    .content-card {
      padding: 24px;
    }

    .panel {
      display: none;
    }

    .panel.active {
      display: block;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .post {
      border: 1px solid var(--line);
      border-radius: 17px;
      overflow: hidden;
      background: var(--card);
      box-shadow: 0 5px 20px rgba(24, 32, 51, .04);
    }

    .media {
      width: 100%;
      height: 260px;
      display: block;
      object-fit: cover;
      background: var(--media);
    }

    .post-body {
      padding: 17px;
    }

    .post h3 {
      font-size: 1.08rem;
      margin: 0 0 8px;
    }

    .post p {
      color: var(--muted);
      font-size: .85rem;
      line-height: 1.5;
    }

    .meta-row {
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: .74rem;
      padding-top: 12px;
      border-top: 1px solid var(--line);
    }

    .empty {
      text-align: center;
      padding: 55px 15px;
      color: var(--muted);
    }

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .58);
      display: none;
      place-items: center;
      padding: 18px;
      z-index: 9999;
    }

    .modal.open {
      display: grid;
    }

    .modal-card {
      background: var(--card);
      color: var(--text);
      width: min(460px, 100%);
      max-height: 80vh;
      overflow: auto;
      border-radius: 20px;
      padding: 22px;
      border: 1px solid var(--line);
    }

    .modal-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .close {
      border: 0;
      background: var(--soft);
      color: var(--text);
      border-radius: 50%;
      width: 34px;
      height: 34px;
      cursor: pointer;
      font-size: 1.2rem;
    }

    .people {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 14px;
    }

    .person {
      border: 1px solid var(--line);
      border-radius: 15px;
      padding: 16px;
      text-align: center;
      text-decoration: none;
      color: var(--text);
      background: var(--card);
    }

    .person img {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      object-fit: cover;
    }

    .person strong {
      display: block;
      margin-top: 8px;
    }

    .person small {
      color: var(--muted);
    }

    @media (max-width: 760px) {
      .profile-page {
        padding: 82px 10px 40px;
      }

      .profile-card {
        padding: 20px;
      }

      .profile-head {
        flex-direction: column;
        text-align: center;
      }

      .meta {
        justify-content: center;
      }

      .actions {
        justify-content: center;
      }

      .grid,
      .people {
        grid-template-columns: 1fr;
      }

      .media {
        height: 230px;
      }

      .tabs {
        overflow: auto;
      }

      .tab {
        min-width: 105px;
      }
    }
  </style>
</head>

<body>

  <%- include("./partials/nave") %>

  <main class="profile-page">

    <div class="profile-shell">

      <!-- ================= PROFILE HEADER ================= -->

      <section class="profile-card">

        <div class="profile-head">

          <img
            class="avatar"
            src="<%= user.profileImageURL || '/imgs/default.png' %>"
            onerror="this.src='/imgs/default.png'"
            alt="<%= user.fullName %>"
          >

          <div class="identity">

            <span class="badge">
              <i class="fas <%= user.isPrivate ? 'fa-lock' : 'fa-globe' %>"></i>
              <%= user.isPrivate ? 'Private account' : 'Public account' %>
            </span>

            <h1><%= user.fullName %></h1>

            <% if (isOwnProfile && user.email) { %>
              <div class="email">
                <%= user.email %>
              </div>
            <% } %>

            <% if (user.bio) { %>
              <p class="bio">
                <%= user.bio %>
              </p>
            <% } %>

            <div class="meta">

              <% if (user.location) { %>
                <span>
                  <i class="fas fa-map-marker-alt"></i>
                  <%= user.location %>
                </span>
              <% } %>

              <% if (user.website) { %>
                <a
                  href="<%= user.website %>"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <i class="fas fa-link"></i>
                  Website
                </a>
              <% } %>

            </div>

            <div class="actions" style="margin-top:14px">

              <% if (isOwnProfile) { %>

                <a
                  class="btn primary"
                  href="/user/profile/edit"
                >
                  <i class="fas fa-user-edit"></i>
                  Edit profile
                </a>

                <a
                  class="btn secondary"
                  href="/user/profile/settings"
                >
                  <i class="fas fa-cog"></i>
                  Settings
                </a>

              <% } else if (isLoggedIn) { %>

                <button
                  id="followBtn"
                  type="button"
                  class="btn <%= followState === 'following' ? 'success' : 'primary' %>"
                  onclick="toggleFollow()"
                >
                  <i class="fas <%= followState === 'following'
                    ? 'fa-user-check'
                    : followState === 'requested'
                      ? 'fa-clock'
                      : 'fa-user-plus'
                  %>"></i>

                  <span>
                    <%= followState === 'following'
                      ? 'Following'
                      : followState === 'requested'
                        ? 'Requested'
                        : 'Follow'
                    %>
                  </span>
                </button>

              <% } %>

            </div>

          </div>

        </div>

        <!-- ================= STATS ================= -->

        <div class="stats">

          <button
            type="button"
            class="stat"
            onclick="openPeople('followers')"
          >
            <strong id="followerCount">
              <%= followerCount %>
            </strong>

            <span>
              Followers
            </span>
          </button>

          <button
            type="button"
            class="stat"
            onclick="openPeople('following')"
          >
            <strong id="followingCount">
              <%= followingCount %>
            </strong>

            <span>
              Following
            </span>
          </button>

          <button
            type="button"
            class="stat"
            onclick="openPanel('posts')"
          >
            <strong>
              <%= blogCount %>
            </strong>

            <span>
              Posts
            </span>
          </button>

        </div>

      </section>

      <!-- ================= TABS ================= -->

      <div class="tabs">

        <button
          type="button"
          class="tab active"
          data-tab="posts"
        >
          <i class="fas fa-th-large"></i>
          Posts
        </button>

        <button
          type="button"
          class="tab"
          data-tab="photos"
        >
          <i class="fas fa-image"></i>
          Photos
        </button>

        <button
          type="button"
          class="tab"
          data-tab="videos"
        >
          <i class="fas fa-video"></i>
          Videos
        </button>

      </div>

      <!-- ================= CONTENT ================= -->

      <section class="content-card">

        <div
          id="posts"
          class="panel active"
        >
          <%- include("./profileMediaGrid", {
            blogs,
            type: "all"
          }) %>
        </div>

        <div
          id="photos"
          class="panel"
        >
          <%- include("./profileMediaGrid", {
            blogs,
            type: "photo"
          }) %>
        </div>

        <div
          id="videos"
          class="panel"
        >
          <%- include("./profileMediaGrid", {
            blogs,
            type: "video"
          }) %>
        </div>

      </section>

    </div>

  </main>

  <!-- ================= PEOPLE MODAL ================= -->

  <div
    class="modal"
    id="peopleModal"
  >

    <div class="modal-card">

      <div class="modal-head">

        <h3 id="peopleTitle">
          People
        </h3>

        <button
          type="button"
          class="close"
          onclick="closePeople()"
        >
          ×
        </button>

      </div>

      <div
        id="peopleList"
        class="people"
      ></div>

    </div>

  </div>

  <%- include("./partials/scripts") %>

  <script>
    /* =========================================================
       PROFILE DATA
       ========================================================= */

    const profileUserId = "<%= user._id %>";

    const initialTheme =
      "<%= theme || user.theme || 'system' %>";

    document.documentElement.dataset.theme =
      initialTheme;


    /* =========================================================
       TABS
       ========================================================= */

    document
      .querySelectorAll(".tab")
      .forEach((button) => {

        button.addEventListener("click", () => {

          document
            .querySelectorAll(".tab")
            .forEach((tab) => {
              tab.classList.remove("active");
            });

          document
            .querySelectorAll(".panel")
            .forEach((panel) => {
              panel.classList.remove("active");
            });

          button.classList.add("active");

          const panel =
            document.getElementById(
              button.dataset.tab
            );

          if (panel) {
            panel.classList.add("active");
          }

        });

      });


    /* =========================================================
       OPEN PANEL
       ========================================================= */

    function openPanel(name) {

      document
        .querySelectorAll(".tab")
        .forEach((button) => {

          button.classList.toggle(
            "active",
            button.dataset.tab === name
          );

        });

      document
        .querySelectorAll(".panel")
        .forEach((panel) => {

          panel.classList.toggle(
            "active",
            panel.id === name
          );

        });

    }


    /* =========================================================
       REFRESH FOLLOWER / FOLLOWING COUNTS
       ========================================================= */

    async function refreshCounts() {

      try {

        const [
          followersResponse,
          followingResponse
        ] = await Promise.all([

          fetch(
            `/follow/${profileUserId}/followers?page=1`,
            {
              headers: {
                Accept: "application/json"
              },
              credentials: "same-origin"
            }
          ),

          fetch(
            `/follow/${profileUserId}/following?page=1`,
            {
              headers: {
                Accept: "application/json"
              },
              credentials: "same-origin"
            }
          )

        ]);

        if (!followersResponse.ok ||
            !followingResponse.ok) {
          return;
        }

        const followers =
          await followersResponse.json();

        const following =
          await followingResponse.json();

        if (followers.success) {

          const count =
            Number(followers.total || 0);

          document.getElementById(
            "followerCount"
          ).textContent = count;

        }

        if (following.success) {

          const count =
            Number(following.total || 0);

          document.getElementById(
            "followingCount"
          ).textContent = count;

        }

      } catch (error) {

        console.debug(
          "Profile count refresh failed",
          error
        );

      }

    }


    /* =========================================================
       FOLLOW / UNFOLLOW
       ========================================================= */

    async function toggleFollow() {

      const button =
        document.getElementById("followBtn");

      if (!button) {
        return;
      }

      if (button.disabled) {
        return;
      }

      button.disabled = true;

      try {

        const response =
          await fetch(
            `/follow/${profileUserId}/follow`,
            {
              method: "POST",
              headers: {
                Accept: "application/json"
              },
              credentials: "same-origin"
            }
          );

        const data =
          await response.json();

        if (
          !response.ok ||
          !data.success
        ) {

          throw new Error(
            data.message ||
            "Unable to update follow"
          );

        }

        if (
          data.followerCount !== undefined &&
          data.followerCount !== null
        ) {

          document.getElementById(
            "followerCount"
          ).textContent =
            Number(data.followerCount);

        }

        if (data.following) {

          button.className =
            "btn success";

          button.innerHTML =
            '<i class="fas fa-user-check"></i>' +
            "<span>Following</span>";

        } else if (data.requested) {

          button.className =
            "btn primary";

          button.innerHTML =
            '<i class="fas fa-clock"></i>' +
            "<span>Requested</span>";

        } else {

          button.className =
            "btn primary";

          button.innerHTML =
            '<i class="fas fa-user-plus"></i>' +
            "<span>Follow</span>";

        }

        if (
          window.notify &&
          typeof window.notify.success === "function"
        ) {

          window.notify.success(
            data.message ||
            "Follow status updated"
          );

        }

        setTimeout(
          refreshCounts,
          200
        );

      } catch (error) {

        if (
          window.notify &&
          typeof window.notify.error === "function"
        ) {

          window.notify.error(
            error.message
          );

        } else {

          alert(error.message);

        }

      } finally {

        button.disabled = false;

      }

    }


    /* =========================================================
       FOLLOWERS / FOLLOWING MODAL
       ========================================================= */

    async function openPeople(type) {

      const modal =
        document.getElementById(
          "peopleModal"
        );

      const list =
        document.getElementById(
          "peopleList"
        );

      const title =
        document.getElementById(
          "peopleTitle"
        );

      title.textContent =
        type === "followers"
          ? "Followers"
          : "Following";

      list.innerHTML =
        '<div class="empty">Loading…</div>';

      modal.classList.add("open");

      try {

        const response =
          await fetch(
            `/follow/${profileUserId}/${type}?page=1`,
            {
              headers: {
                Accept: "application/json"
              },
              credentials: "same-origin"
            }
          );

        const data =
          await response.json();

        if (
          !response.ok ||
          !data.success
        ) {

          throw new Error(
            data.message ||
            "Unable to load list"
          );

        }

        const people =
          data[type] || [];

        if (!people.length) {

          list.innerHTML =
            '<div class="empty">' +
            "No people found." +
            "</div>";

          return;
        }

        list.innerHTML =
          people
            .map((person) => {

              const image =
                person.profileImageURL ||
                "/imgs/default.png";

              return `
                <a
                  class="person"
                  href="/user/profile/${encodeURIComponent(person._id)}"
                >

                  <img
                    src="${escapeHtml(image)}"
                    onerror="this.src='/imgs/default.png'"
                    alt="${escapeHtml(person.fullName)}"
                  >

                  <div>

                    <strong>
                      ${escapeHtml(person.fullName)}
                    </strong>

                    <small>
                      ${escapeHtml(person.bio || "")}
                    </small>

                  </div>

                </a>
              `;

            })
            .join("");

      } catch (error) {

        list.innerHTML =
          '<div class="empty">' +
          escapeHtml(error.message) +
          "</div>";

      }

    }


    /* =========================================================
       CLOSE PEOPLE MODAL
       ========================================================= */

    function closePeople() {

      document
        .getElementById("peopleModal")
        .classList.remove("open");

    }


    /* =========================================================
       MODAL OUTSIDE CLICK
       ========================================================= */

    document
      .getElementById("peopleModal")
      .addEventListener(
        "click",
        (event) => {

          if (
            event.target.id ===
            "peopleModal"
          ) {

            closePeople();

          }

        }
      );


    /* =========================================================
       ESCAPE MODAL
       ========================================================= */

    document.addEventListener(
      "keydown",
      (event) => {

        if (event.key === "Escape") {
          closePeople();
        }

      }
    );


    /* =========================================================
       HTML ESCAPE
       ========================================================= */

    function escapeHtml(value) {

      return String(value || "")
        .replace(
          /[&<>'"]/g,
          (character) => {

            const entities = {
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              "'": "&#39;",
              '"': "&quot;"
            };

            return entities[character];

          }
        );

    }


    /* =========================================================
       INITIAL COUNT SYNC
       ========================================================= */

    refreshCounts();

  </script>

</body>
</html>
