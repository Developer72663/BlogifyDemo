<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title><%= user.fullName %> | Blogify</title>

  <style>
    :root {
      --bg: #f6f7fb;
      --card: #fff;
      --text: #182033;
      --muted: #718096;
      --line: #e7eaf1;
      --primary: #635bff;
      --soft: #efedff;
      --danger: #e5484d;
      --shadow: 0 16px 45px rgba(24, 32, 51, .08);
    }

    * {
      box-sizing: border-box;
    }

    body.profile-menu-open {
      overflow: hidden;
    }

    .profile-page {
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      padding: 94px 16px 60px;
    }

    .profile-shell {
      max-width: 1120px;
      margin: auto;
    }

    .profile-card,
    .content-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 24px;
      box-shadow: var(--shadow);
    }

    .profile-card {
      padding: 30px;
    }

    .profile-head {
      display: flex;
      gap: 25px;
      align-items: center;
    }

    .avatar {
      width: 132px;
      height: 132px;
      border-radius: 50%;
      object-fit: cover;
      border: 5px solid var(--card);
      box-shadow: 0 8px 28px rgba(0, 0, 0, .12);
      flex-shrink: 0;
    }

    .identity {
      flex: 1;
      min-width: 0;
    }

    .identity h1 {
      margin: 0 0 5px;
      font-size: 2rem;
    }

    .email {
      color: var(--muted);
      font-size: .86rem;
    }

    .bio {
      margin: 0 0 12px;
      line-height: 1.6;
      max-width: 700px;
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      color: var(--muted);
      font-size: .84rem;
    }

    .meta a {
      color: var(--primary);
    }

    .badge {
      display: inline-flex;
      gap: 6px;
      border-radius: 99px;
      padding: 6px 10px;
      background: var(--soft);
      color: var(--primary);
      font-weight: 800;
      font-size: .72rem;
    }

    .actions {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
      justify-content: flex-end;
      position: relative;
    }

    .btn {
      border: 0;
      border-radius: 11px;
      padding: 10px 15px;
      font-weight: 800;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    .primary {
      background: var(--primary);
      color: #fff;
    }

    .secondary {
      background: var(--card);
      border: 1px solid var(--line);
      color: var(--text);
    }

    .success {
      background: #159570;
      color: #fff;
    }

    .more-btn {
      width: 42px;
      height: 42px;
      border: 1px solid var(--line);
      border-radius: 50%;
      background: var(--card);
      color: var(--text);
      cursor: pointer;
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .more-btn:hover {
      background: var(--soft);
    }

    /* =========================================================
       PROFILE INSTAGRAM-STYLE ACTION SHEET
       ========================================================= */

    .profile-menu-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .45);
      z-index: 9998;

      opacity: 0;
      visibility: hidden;
      pointer-events: none;

      transition:
        opacity .22s ease,
        visibility .22s ease;
    }

    .profile-menu-backdrop.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .profile-action-sheet {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;

      width: 100%;
      max-width: 100%;
      max-height: 82vh;

      overflow-y: auto;
      overscroll-behavior: contain;

      background: var(--card);
      color: var(--text);

      border-radius: 22px 22px 0 0;
      border: 1px solid var(--line);
      border-bottom: 0;

      box-shadow:
        0 -18px 55px rgba(0, 0, 0, .25);

      padding: 12px 10px calc(
        12px + env(safe-area-inset-bottom)
      );

      z-index: 9999;

      visibility: hidden;
      opacity: 0;
      pointer-events: none;

      transform: translate3d(0, 110%, 0);

      transition:
        transform .28s cubic-bezier(.22, 1, .36, 1),
        opacity .2s ease,
        visibility 0s linear .28s;
    }

    .profile-action-sheet.open {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;

      transform: translate3d(0, 0, 0);

      transition:
        transform .28s cubic-bezier(.22, 1, .36, 1),
        opacity .2s ease;
    }

    .profile-action-sheet::before {
      content: "";
      display: block;

      width: 42px;
      height: 5px;

      margin: 2px auto 10px;

      border-radius: 999px;
      background: var(--line);
    }

    .profile-action-sheet button {
      width: 100%;
      min-height: 52px;

      border: 0;
      outline: none;

      background: transparent;
      color: var(--text);

      display: flex;
      align-items: center;

      gap: 13px;

      padding: 14px;

      border-radius: 12px;

      font: inherit;
      font-weight: 700;

      cursor: pointer;
      text-align: left;

      -webkit-tap-highlight-color: transparent;
    }

    .profile-action-sheet button i {
      width: 22px;
      text-align: center;
      font-size: 1rem;
      flex-shrink: 0;
    }

    .profile-action-sheet button:hover,
    .profile-action-sheet button:active {
      background: var(--soft);
    }

    .profile-action-sheet button.danger {
      color: var(--danger);
    }

    .profile-action-sheet button.danger:hover,
    .profile-action-sheet button.danger:active {
      background: rgba(229, 72, 77, .08);
    }

    /* ========================================================= */

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 28px;
      padding-top: 22px;
      border-top: 1px solid var(--line);
    }

    .stat {
      text-align: center;
      border: 0;
      background: transparent;
      color: var(--text);
      cursor: pointer;
    }

    .stat strong {
      display: block;
      font-size: 1.25rem;
    }

    .stat span {
      color: var(--muted);
      font-size: .78rem;
    }

    .tabs {
      display: flex;
      gap: 5px;
      margin: 22px 0 15px;
      padding: 5px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 15px;
    }

    .tab {
      flex: 1;
      border: 0;
      background: transparent;
      padding: 11px;
      border-radius: 10px;
      color: var(--muted);
      font-weight: 800;
      cursor: pointer;
    }

    .tab.active {
      background: var(--soft);
      color: var(--primary);
    }

    .content-card {
      padding: 24px;
    }

    .panel {
      display: none;
    }

    .panel.active {
      display: block;
    }

    .blog-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .blog {
      border: 1px solid var(--line);
      border-radius: 17px;
      overflow: hidden;
      background: var(--card);
    }

    .cover {
      width: 100%;
      height: 210px;
      object-fit: cover;
      background: var(--bg);
    }

    .blog-body {
      padding: 17px;
    }

    .blog h3 {
      font-size: 1.08rem;
      margin: 0 0 8px;
    }

    .blog p {
      color: var(--muted);
      font-size: .85rem;
      line-height: 1.5;
    }

    .blog-meta {
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: .74rem;
      padding-top: 12px;
      border-top: 1px solid var(--line);
    }

    .empty {
      text-align: center;
      padding: 55px 15px;
      color: var(--muted);
    }

    .lock {
      background: var(--soft);
      border-radius: 18px;
      padding: 35px;
      text-align: center;
    }

    .people {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .person {
      border: 1px solid var(--line);
      border-radius: 15px;
      padding: 16px;
      text-align: center;
    }

    .person img {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      object-fit: cover;
    }

    .person strong {
      display: block;
      margin-top: 8px;
    }

    .person small {
      color: var(--muted);
    }

    .toast {
      position: fixed;
      right: 20px;
      bottom: 20px;

      background: #182033;
      color: #fff;

      padding: 12px 16px;
      border-radius: 11px;

      display: none;

      z-index: 10002;
    }

    .modal {
      position: fixed;
      inset: 0;

      background: rgba(0, 0, 0, .5);

      display: none;
      place-items: center;

      padding: 18px;

      z-index: 10001;
    }

    .modal.open {
      display: grid;
    }

    .modal-card {
      background: var(--card);
      color: var(--text);

      width: min(460px, 100%);

      border-radius: 20px;
      padding: 22px;
    }

    .modal-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .modal-close {
      border: 0;
      background: transparent;
      color: var(--text);
      font-size: 1.3rem;
      cursor: pointer;
    }

    .share-url {
      width: 100%;
      padding: 11px;

      border: 1px solid var(--line);
      border-radius: 10px;

      background: var(--bg);
      color: var(--text);

      margin: 12px 0;
    }

    .qr {
      font-size: 120px;
      text-align: center;
      line-height: 1;
    }

    @media (max-width: 760px) {
      .profile-page {
        padding: 82px 10px 40px;
      }

      .profile-card {
        padding: 20px;
      }

      .profile-head {
        flex-direction: column;
        text-align: center;
      }

      .meta {
        justify-content: center;
      }

      .actions {
        justify-content: center;
      }

      .blog-grid,
      .people {
        grid-template-columns: 1fr;
      }

      .cover {
        height: 190px;
      }

      .tabs {
        overflow: auto;
      }

      .tab {
        min-width: 105px;
      }

      .profile-action-sheet {
        max-height: 84vh;
        border-radius: 20px 20px 0 0;
      }

      .profile-action-sheet button {
        min-height: 54px;
        padding: 15px 14px;
      }
    }
  </style>
</head>

<body>

  <%- include("./partials/nave") %>

  <main class="profile-page">
    <div class="profile-shell">

      <section class="profile-card">

        <div class="profile-head">

          <img
            class="avatar"
            src="<%= user.profileImageURL || '/imgs/default.png' %>"
            alt="<%= user.fullName %>"
            onerror="this.src='/imgs/default.png'"
          >

          <div class="identity">

            <div>
              <span class="badge">
                <i class="fas <%= user.isPrivate ? 'fa-lock' : 'fa-globe' %>"></i>
                <%= user.isPrivate ? 'Private account' : 'Public account' %>
              </span>
            </div>

            <h1><%= user.fullName %></h1>

            <% if (user.email && isOwnProfile) { %>
              <p class="email"><%= user.email %></p>
            <% } %>

            <% if (user.bio) { %>
              <p class="bio"><%= user.bio %></p>
            <% } %>

            <div class="meta">

              <% if (user.location) { %>
                <span>
                  <i class="fas fa-map-marker-alt"></i>
                  <%= user.location %>
                </span>
              <% } %>

              <% if (user.website) { %>
                <a
                  href="<%= user.website %>"
                  target="_blank"
                  rel="noopener"
                >
                  <i class="fas fa-link"></i>
                  Website
                </a>
              <% } %>

            </div>

          </div>

          <div class="actions">

            <% if (isOwnProfile) { %>

              <a
                class="btn primary"
                href="/user/profile/edit"
              >
                <i class="fas fa-edit"></i>
                Edit profile
              </a>

              <a
                class="btn secondary"
                href="/user/profile/settings"
              >
                <i class="fas fa-cog"></i>
                Settings
              </a>

            <% } else if (isLoggedIn) { %>

              <button
                type="button"
                id="followBtn"
                class="btn <%= followState === 'following' ? 'success' : 'secondary' %>"
                onclick="toggleFollow()"
              >
                <i class="fas <%= followState === 'following'
                  ? 'fa-user-check'
                  : followState === 'requested'
                    ? 'fa-clock'
                    : 'fa-user-plus'
                %>"></i>

                <%= followState === 'following'
                  ? 'Following'
                  : followState === 'requested'
                    ? 'Request sent'
                    : 'Follow'
                %>
              </button>

              <%
                const canMessage =
                  !user.isPrivate ||
                  followState === 'following';
              %>

              <% if (canMessage) { %>

                <a
                  class="btn primary"
                  href="/messages?user=<%= user._id %>"
                >
                  <i class="fas fa-comment-dots"></i>
                  Message
                </a>

              <% } else { %>

                <button
                  type="button"
                  class="btn secondary"
                  onclick="toast('Follow this private account to message them.')"
                >
                  <i class="fas fa-lock"></i>
                  Message
                </button>

              <% } %>

              <!-- THREE DOT BUTTON -->

              <button
                type="button"
                class="more-btn"
                id="moreBtn"
                aria-label="More options"
                aria-expanded="false"
              >
                <i class="fas fa-ellipsis-h"></i>
              </button>

              <!-- BACKDROP -->

              <div
                class="profile-menu-backdrop"
                id="profileMenuBackdrop"
                aria-hidden="true"
              ></div>

              <!-- ACTION SHEET -->

              <div
                class="profile-action-sheet"
                id="profileMenu"
                aria-hidden="true"
              >

                <button
                  type="button"
                  onclick="profileAction('restrict')"
                >
                  <i class="fas fa-user-lock"></i>
                  <span>Restrict</span>
                </button>

                <button
                  type="button"
                  class="danger"
                  onclick="blockUser()"
                >
                  <i class="fas fa-ban"></i>
                  <span>Block</span>
                </button>

                <button
                  type="button"
                  onclick="profileAction('report')"
                >
                  <i class="fas fa-flag"></i>
                  <span>Report</span>
                </button>

                <button
                  type="button"
                  onclick="showAbout()"
                >
                  <i class="fas fa-info-circle"></i>
                  <span>About this account</span>
                </button>

                <button
                  type="button"
                  onclick="profileAction('shared')"
                >
                  <i class="fas fa-user-friends"></i>
                  <span>See shared activity</span>
                </button>

                <button
                  type="button"
                  onclick="profileAction('hide')"
                >
                  <i class="fas fa-eye-slash"></i>
                  <span>Hide your blog, photo &amp; videos</span>
                </button>

                <button
                  type="button"
                  onclick="removeFollower()"
                >
                  <i class="fas fa-user-minus"></i>
                  <span>Remove follower</span>
                </button>

                <button
                  type="button"
                  onclick="copyProfile()"
                >
                  <i class="fas fa-link"></i>
                  <span>Copy profile URL</span>
                </button>

                <button
                  type="button"
                  onclick="shareProfile()"
                >
                  <i class="fas fa-share"></i>
                  <span>Share this profile</span>
                </button>

                <button
                  type="button"
                  onclick="showQR()"
                >
                  <i class="fas fa-qrcode"></i>
                  <span>QR code</span>
                </button>

              </div>

            <% } %>

          </div>
        </div>

        <div class="stats">

          <button
            type="button"
            class="stat"
            onclick="openPanel('followers')"
          >
            <strong><%= followerCount %></strong>
            <span>Followers</span>
          </button>

          <button
            type="button"
            class="stat"
            onclick="openPanel('following')"
          >
            <strong><%= followingCount %></strong>
            <span>Following</span>
          </button>

          <button
            type="button"
            class="stat"
            onclick="openPanel('blogs')"
          >
            <strong><%= blogCount %></strong>
            <span>Blogs</span>
          </button>

        </div>

      </section>

      <nav class="tabs">

        <button
          type="button"
          class="tab active"
          data-panel="blogs"
          onclick="openPanel('blogs')"
        >
          <i class="fas fa-book"></i>
          Blogs
        </button>

        <button
          type="button"
          class="tab"
          data-panel="followers"
          onclick="openPanel('followers')"
        >
          <i class="fas fa-users"></i>
          Followers
        </button>

        <button
          type="button"
          class="tab"
          data-panel="following"
          onclick="openPanel('following')"
        >
          <i class="fas fa-user-friends"></i>
          Following
        </button>

      </nav>

      <section class="content-card">

        <div id="blogs" class="panel active">

          <% if (contentLocked) { %>

            <div class="lock">
              <i class="fas fa-lock"></i>

              <h3>This account is private</h3>

              <p>
                Follow <%= user.fullName %>
                and wait for approval to see their blogs and lists.
              </p>
            </div>

          <% } else if (!blogs.length) { %>

            <div class="empty">
              <i class="fas fa-pen"></i>
              <h3>No blogs published yet</h3>
            </div>

          <% } else { %>

            <div class="blog-grid">

              <% blogs.forEach(blog => { %>

                <article class="blog">

                  <% if (blog.coverImageURL) { %>

                    <img
                      class="cover"
                      src="<%= blog.coverImageURL %>"
                      alt="<%= blog.title %>"
                      onerror="this.src='/images/default-blog.png'"
                    >

                  <% } else { %>

                    <div class="cover"></div>

                  <% } %>

                  <div class="blog-body">

                    <h3>
                      <%= blog.title %>
                    </h3>

                    <p>
                      <%= blog.excerpt ||
                        (blog.body
                          ? blog.body.substring(0, 140)
                          : '')
                      %>
                    </p>

                    <div class="blog-meta">

                      <span>
                        <i class="far fa-calendar"></i>
                        <%= new Date(blog.createdAt).toLocaleDateString() %>
                      </span>

                      <span>
                        <i class="far fa-heart"></i>
                        <%= blog.likes ? blog.likes.length : 0 %>

                        ·

                        <i class="far fa-eye"></i>
                        <%= blog.viewCount || 0 %>
                      </span>

                    </div>

                    <a
                      class="btn primary"
                      style="margin-top:12px;justify-content:center"
                      href="/blogs/<%= blog._id %>"
                    >
                      Read blog
                    </a>

                  </div>

                </article>

              <% }) %>

            </div>

          <% } %>

        </div>

        <div id="followers" class="panel">
          <div
            id="followersContent"
            class="empty"
          >
            Loading followers…
          </div>
        </div>

        <div id="following" class="panel">
          <div
            id="followingContent"
            class="empty"
          >
            Loading following…
          </div>
        </div>

      </section>

    </div>
  </main>

  <!-- TOAST -->

  <div
    class="toast"
    id="toast"
  ></div>

  <!-- ABOUT MODAL -->

  <div
    class="modal"
    id="aboutModal"
  >

    <div class="modal-card">

      <div class="modal-head">

        <h3>
          About this account
        </h3>

        <button
          type="button"
          class="modal-close"
          onclick="closeModal('aboutModal')"
        >
          ×
        </button>

      </div>

      <p>
        <strong>
          <%= user.fullName %>
        </strong>
      </p>

      <p>
        Account:
        <%= user.isPrivate ? 'Private' : 'Public' %>
      </p>

      <p>
        Followers:
        <%= followerCount %>
        · Following:
        <%= followingCount %>
        · Blogs:
        <%= blogCount %>
      </p>

    </div>
  </div>

  <!-- QR MODAL -->

  <div
    class="modal"
    id="qrModal"
  >

    <div class="modal-card">

      <div class="modal-head">

        <h3>
          Profile QR code
        </h3>

        <button
          type="button"
          class="modal-close"
          onclick="closeModal('qrModal')"
        >
          ×
        </button>

      </div>

      <div class="qr">
        ▦
      </div>

      <p style="text-align:center">
        Scan or share this profile URL
      </p>

      <input
        class="share-url"
        readonly
        id="profileUrl"
      >

      <button
        type="button"
        class="btn primary"
        style="width:100%;justify-content:center"
        onclick="copyProfile()"
      >
        Copy profile URL
      </button>

    </div>
  </div>

  <%- include("./partials/scripts") %>

  <script>
    /* =========================================================
       PROFILE DATA
       ========================================================= */

    const profileUserId = '<%= user._id %>';
    const isLoggedIn = <%= isLoggedIn ? 'true' : 'false' %>;

    /* =========================================================
       PROFILE ACTION SHEET
       ========================================================= */

    const profileMenu =
      document.getElementById('profileMenu');

    const profileMenuBackdrop =
      document.getElementById('profileMenuBackdrop');

    const moreBtn =
      document.getElementById('moreBtn');

    function openProfileMenu() {

      if (!profileMenu) return;

      profileMenu.classList.add('open');

      profileMenuBackdrop?.classList.add('open');

      profileMenu.setAttribute(
        'aria-hidden',
        'false'
      );

      profileMenuBackdrop?.setAttribute(
        'aria-hidden',
        'false'
      );

      moreBtn?.setAttribute(
        'aria-expanded',
        'true'
      );

      document.body.classList.add(
        'profile-menu-open'
      );
    }

    function closeProfileMenu() {

      if (!profileMenu) return;

      profileMenu.classList.remove('open');

      profileMenuBackdrop?.classList.remove('open');

      profileMenu.setAttribute(
        'aria-hidden',
        'true'
      );

      profileMenuBackdrop?.setAttribute(
        'aria-hidden',
        'true'
      );

      moreBtn?.setAttribute(
        'aria-expanded',
        'false'
      );

      document.body.classList.remove(
        'profile-menu-open'
      );
    }

    function toggleProfileMenu() {

      if (!profileMenu) return;

      if (profileMenu.classList.contains('open')) {
        closeProfileMenu();
      } else {
        openProfileMenu();
      }
    }

    /*
     * IMPORTANT:
     * We attach the event listener here instead of using
     * onclick="toggleMenu(event)".
     *
     * This prevents conflicts with scripts.ejs.
     */

    moreBtn?.addEventListener(
      'click',
      function (event) {

        event.preventDefault();
        event.stopPropagation();

        toggleProfileMenu();
      }
    );

    profileMenu?.addEventListener(
      'click',
      function (event) {

        event.stopPropagation();
      }
    );

    profileMenuBackdrop?.addEventListener(
      'click',
      function () {

        closeProfileMenu();
      }
    );

    document.addEventListener(
      'keydown',
      function (event) {

        if (event.key === 'Escape') {
          closeProfileMenu();
        }
      }
    );

    /* =========================================================
       TOAST
       ========================================================= */

    function toast(message) {

      const element =
        document.getElementById('toast');

      if (!element) return;

      element.textContent = message;

      element.style.display = 'block';

      clearTimeout(window.__profileToast);

      window.__profileToast =
        setTimeout(function () {

          element.style.display = 'none';

        }, 2800);
    }

    /* =========================================================
       MENU ACTIONS
       ========================================================= */

    function profileAction(action) {

      closeProfileMenu();

      if (action === 'hide') {

        toast(
          'Content hidden for this session.'
        );

        return;
      }

      if (action === 'shared') {

        toast(
          'Shared activity selected.'
        );

        return;
      }

      toast(
        action.charAt(0).toUpperCase() +
        action.slice(1) +
        ' option selected.'
      );
    }

    /* =========================================================
       BLOCK USER
       ========================================================= */

    async function blockUser() {

      const confirmed =
        confirm(
          'Block this user? They will not be able to message or follow you.'
        );

      if (!confirmed) return;

      closeProfileMenu();

      try {

        const response =
          await fetch(
            '/messages/block/' +
            profileUserId,
            {
              method: 'POST',
              credentials: 'same-origin'
            }
          );

        const data =
          await response.json();

        if (!response.ok || !data.success) {

          throw new Error(
            data.message ||
            'Unable to block user'
          );
        }

        toast(
          data.message ||
          'User blocked.'
        );

        setTimeout(
          function () {
            location.href = '/home';
          },
          800
        );

      } catch (error) {

        toast(
          error.message ||
          'Unable to block user.'
        );
      }
    }

    /* =========================================================
       REMOVE FOLLOWER
       ========================================================= */

    async function removeFollower() {

      closeProfileMenu();

      try {

        const response =
          await fetch(
            '/follow/' +
            profileUserId +
            '/follow',
            {
              method: 'POST',
              credentials: 'same-origin'
            }
          );

        const data =
          await response.json();

        toast(
          data.message ||
          'Follower updated'
        );

        setTimeout(
          function () {
            location.reload();
          },
          700
        );

      } catch (error) {

        toast(
          'Unable to remove follower'
        );
      }
    }

    /* =========================================================
       COPY PROFILE URL
       ========================================================= */

    function copyProfile() {

      const url =
        location.href;

      if (
        navigator.clipboard &&
        navigator.clipboard.writeText
      ) {

        navigator.clipboard
          .writeText(url)
          .then(function () {

            closeProfileMenu();

            toast(
              'Profile URL copied'
            );

          })
          .catch(function () {

            fallbackCopyProfile(url);
          });

      } else {

        fallbackCopyProfile(url);
      }
    }

    function fallbackCopyProfile(url) {

      const input =
        document.getElementById(
          'profileUrl'
        );

      if (input) {

        input.value = url;

        input.focus();

        input.select();

      }

      closeProfileMenu();

      toast(
        'Copy the profile URL'
      );
    }

    /* =========================================================
       SHARE PROFILE
       ========================================================= */

    function shareProfile() {

      closeProfileMenu();

      location.href =
        '/messages/chatlog?share=' +
        encodeURIComponent(
          profileUserId
        );
    }

    /* =========================================================
       ABOUT
       ========================================================= */

    function showAbout() {

      closeProfileMenu();

      const modal =
        document.getElementById(
          'aboutModal'
        );

      modal?.classList.add('open');
    }

    /* =========================================================
       QR
       ========================================================= */

    function showQR() {

      closeProfileMenu();

      const input =
        document.getElementById(
          'profileUrl'
        );

      if (input) {
        input.value = location.href;
      }

      document
        .getElementById('qrModal')
        ?.classList.add('open');
    }

    /* =========================================================
       CLOSE MODALS
       ========================================================= */

    function closeModal(id) {

      document
        .getElementById(id)
        ?.classList.remove('open');
    }

    /* =========================================================
       PANELS
       ========================================================= */

    function openPanel(name) {

      document
        .querySelectorAll('.panel')
        .forEach(function (panel) {

          panel.classList.toggle(
            'active',
            panel.id === name
          );

        });

      document
        .querySelectorAll('.tab')
        .forEach(function (tab) {

          tab.classList.toggle(
            'active',
            tab.dataset.panel === name
          );

        });

      if (
        name === 'followers' ||
        name === 'following'
      ) {

        loadPeople(name);
      }
    }

    /* =========================================================
       FOLLOW
       ========================================================= */

    async function toggleFollow() {

      if (!isLoggedIn) {

        location.href =
          '/user/signin';

        return;
      }

      const button =
        document.getElementById(
          'followBtn'
        );

      if (!button) return;

      button.disabled = true;

      try {

        const response =
          await fetch(
            '/follow/' +
            profileUserId +
            '/follow',
            {
              method: 'POST',
              credentials: 'same-origin'
            }
          );

        const data =
          await response.json();

        if (
          !response.ok ||
          !data.success
        ) {

          throw new Error(
            data.message ||
            'Unable to follow'
          );
        }

        if (data.following) {

          button.innerHTML =
            '<i class="fas fa-user-check"></i> Following';

          button.className =
            'btn success';

        } else if (data.requested) {

          button.innerHTML =
            '<i class="fas fa-clock"></i> Request sent';

          button.className =
            'btn secondary';

        } else {

          button.innerHTML =
            '<i class="fas fa-user-plus"></i> Follow';

          button.className =
            'btn secondary';
        }

        toast(
          data.message ||
          'Follow status updated'
        );

      } catch (error) {

        toast(
          error.message ||
          'Unable to follow'
        );

      } finally {

        button.disabled = false;
      }
    }

    /* =========================================================
       LOAD FOLLOWERS / FOLLOWING
       ========================================================= */

    async function loadPeople(type) {

      const box =
        document.getElementById(
          type + 'Content'
        );

      if (!box) return;

      try {

        const response =
          await fetch(
            '/follow/' +
            profileUserId +
            '/' +
            type
          );

        const data =
          await response.json();

        if (!response.ok) {

          box.innerHTML =
            '<div class="lock">' +
            (data.message ||
              'Unable to load list.') +
            '</div>';

          return;
        }

        const list =
          data[type] || [];

        if (!list.length) {

          box.className = 'empty';

          box.innerHTML =
            'No ' +
            type +
            ' yet.';

          return;
        }

        box.className = 'people';

        box.innerHTML =
          list
            .map(function (person) {

              const name =
                String(
                  person.fullName ||
                  'User'
                )
                .replace(
                  /[<>&]/g,
                  ''
                );

              const bio =
                String(
                  person.bio || ''
                )
                .replace(
                  /[<>&]/g,
                  ''
                );

              const image =
                person.profileImageURL ||
                '/imgs/default.png';

              return `
                <div class="person">

                  <img
                    src="${image}"
                    alt="${name}"
                    onerror="this.src='/imgs/default.png'"
                  >

                  <strong>
                    ${name}
                  </strong>

                  <small>
                    ${bio}
                  </small>

                  <br>

                  <a
                    class="btn secondary"
                    href="/user/profile/${person._id}"
                  >
                    View profile
                  </a>

                </div>
              `;

            })
            .join('');

      } catch (error) {

        box.className = 'empty';

        box.innerHTML =
          'Unable to load this list.';
      }
    }

    /* =========================================================
       CLOSE MODAL WHEN CLICKING OUTSIDE
       ========================================================= */

    document
      .querySelectorAll('.modal')
      .forEach(function (modal) {

        modal.addEventListener(
          'click',
          function (event) {

            if (
              event.target === modal
            ) {

              modal.classList.remove(
                'open'
              );
            }
          }
        );

      });
  </script>

</body>
</html>
