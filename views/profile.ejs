<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || user.theme || 'system' %>">
<head>
  <%- include("./partials/head") %>
  <title><%= user.fullName %> | Blogify</title>
  <style>
    :root{--bg:#f6f7fb;--card:#fff;--text:#182033;--muted:#718096;--line:#e7eaf1;--primary:#635bff;--soft:#efedff;--danger:#e5484d;--media:#eef0f5}
    html[data-theme="dark"]{--bg:#0b0f17;--card:#121925;--text:#f3f5f9;--muted:#aab4c4;--line:#273142;--primary:#8b83ff;--soft:#29264b;--danger:#ff6b72;--media:#1b2432}
    @media(prefers-color-scheme:dark){html[data-theme="system"]{--bg:#0b0f17;--card:#121925;--text:#f3f5f9;--muted:#aab4c4;--line:#273142;--primary:#8b83ff;--soft:#29264b;--danger:#ff6b72;--media:#1b2432}}
    *{box-sizing:border-box}html,body{background:var(--bg);color:var(--text);transition:background-color .22s ease,color .22s ease}.profile-page{min-height:100vh;background:var(--bg);padding:90px 14px 50px;color:var(--text);transition:background .22s ease}.shell{max-width:1080px;margin:auto}
    .card{background:var(--card);border:1px solid var(--line);border-radius:22px;box-shadow:0 15px 45px rgba(24,32,51,.07);transition:background .22s ease,border-color .22s ease,box-shadow .22s ease}.head{padding:28px;display:flex;gap:24px;align-items:center}.avatar{width:128px;height:128px;border-radius:50%;object-fit:cover;border:5px solid var(--card);box-shadow:0 8px 26px rgba(0,0,0,.14)}.identity{flex:1;min-width:0}.identity h1{margin:7px 0;font-size:2rem}.muted{color:var(--muted)}.bio{line-height:1.55;margin:8px 0}.badge{display:inline-flex;padding:6px 10px;border-radius:999px;background:var(--soft);color:var(--primary);font-weight:800;font-size:.75rem}
    .actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:0;border-radius:11px;padding:10px 15px;font-weight:800;text-decoration:none;cursor:pointer;display:inline-flex;align-items:center;gap:7px;transition:transform .15s ease,opacity .15s ease,background .2s ease}.btn:hover{transform:translateY(-1px)}.primary{background:var(--primary);color:#fff}.secondary{background:var(--card);color:var(--text);border:1px solid var(--line)}.success{background:#159570;color:#fff}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);margin:0 28px}.stat{border:0;background:none;padding:18px;text-align:center;cursor:pointer;color:var(--text)}.stat strong{display:block;font-size:1.3rem}.stat span{font-size:.78rem;color:var(--muted)}
    .tabs{display:flex;gap:5px;padding:5px;margin:20px 0 14px}.tab{flex:1;border:0;background:transparent;padding:12px;border-radius:10px;font-weight:800;color:var(--muted);cursor:pointer}.tab.active{background:var(--soft);color:var(--primary)}.panel{display:none}.panel.active{display:block}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.post{overflow:hidden}.media{width:100%;height:260px;display:block;object-fit:cover;background:var(--media)}.post-body{padding:16px}.post h3{margin:0 0 7px}.post p{color:var(--muted);line-height:1.5;font-size:.88rem}.meta{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:10px;color:var(--muted);font-size:.75rem}.empty{text-align:center;padding:55px;color:var(--muted)}
    .modal{position:fixed;inset:0;background:rgba(0,0,0,.58);display:none;place-items:center;padding:16px;z-index:9999}.modal.open{display:grid}.modal-card{background:var(--card);color:var(--text);border-radius:20px;width:min(620px,100%);max-height:80vh;overflow:auto;padding:20px;border:1px solid var(--line)}.modal-head{display:flex;justify-content:space-between;align-items:center}.close{border:0;background:var(--soft);color:var(--text);border-radius:50%;width:34px;height:34px;cursor:pointer}.people{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:14px}.person{display:flex;align-items:center;gap:10px;border:1px solid var(--line);padding:10px;border-radius:13px;text-decoration:none;color:var(--text);background:var(--card)}.person img{width:46px;height:46px;border-radius:50%;object-fit:cover}.person strong{display:block}.person small{color:var(--muted)}
    @media(max-width:720px){.head{flex-direction:column;text-align:center;padding:22px}.actions{justify-content:center}.stats{margin:0 15px}.grid,.people{grid-template-columns:1fr}.media{height:230px}}
  </style>
</head>
<body>
  <%- include("./partials/nave") %>
  <main class="profile-page"><div class="shell">
    <section class="card head">
      <img class="avatar" src="<%= user.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'" alt="<%= user.fullName %>">
      <div class="identity">
        <span class="badge"><i class="fas <%= user.isPrivate?'fa-lock':'fa-globe' %>"></i>&nbsp;<%= user.isPrivate?'Private account':'Public account' %></span>
        <h1><%= user.fullName %></h1>
        <% if (isOwnProfile && user.email) { %><div class="muted"><%= user.email %></div><% } %>
        <% if (user.bio) { %><p class="bio"><%= user.bio %></p><% } %>
        <div class="muted"><% if(user.location){ %><span><i class="fas fa-map-marker-alt"></i> <%= user.location %></span><% } %><% if(user.website){ %> &nbsp; <a href="<%= user.website %>" target="_blank" rel="noopener">Website</a><% } %></div>
        <div class="actions" style="margin-top:14px">
          <% if(isOwnProfile){ %><a class="btn primary" href="/user/profile/edit"><i class="fas fa-user-edit"></i>Edit profile</a><a class="btn secondary" href="/user/profile/settings"><i class="fas fa-cog"></i>Settings</a><% } else { %><button id="followBtn" class="btn <%= followState==='following'?'success':'primary' %>" onclick="toggleFollow()"><i class="fas <%= followState==='following'?'fa-user-check':'fa-user-plus' %>"></i><span><%= followState==='following'?'Following':followState==='requested'?'Requested':'Follow' %></span></button><% } %>
        </div>
      </div>
    </section>
    <section class="card stats"><button class="stat" onclick="openPeople('followers')"><strong id="followerCount"><%= followerCount %></strong><span>Followers</span></button><button class="stat" onclick="openPeople('following')"><strong id="followingCount"><%= followingCount %></strong><span>Following</span></button><button class="stat"><strong><%= blogCount %></strong><span>Posts</span></button></section>
    <div class="tabs"><button class="tab active" data-tab="posts">Posts</button><button class="tab" data-tab="photos">Photos</button><button class="tab" data-tab="videos">Videos</button></div>
    <section class="card" style="padding:18px"><div id="posts" class="panel active"><%- include("./profileMediaGrid", { blogs, type: "all" }) %></div><div id="photos" class="panel"><%- include("./profileMediaGrid", { blogs, type: "photo" }) %></div><div id="videos" class="panel"><%- include("./profileMediaGrid", { blogs, type: "video" }) %></div></section>
  </div></main>
  <div class="modal" id="peopleModal"><div class="modal-card"><div class="modal-head"><h3 id="peopleTitle">People</h3><button class="close" onclick="closePeople()">×</button></div><div id="peopleList" class="people"></div></div></div>
  <%- include("./partials/scripts") %>
  <script>
    const profileUserId='<%= user._id %>';
    const initialTheme='<%= theme || user.theme || "system" %>';
    document.documentElement.dataset.theme=initialTheme;
    document.querySelectorAll('.tab').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));btn.classList.add('active');document.getElementById(btn.dataset.tab).classList.add('active')}));
    async function refreshCounts(){try{const [followers,following]=await Promise.all([fetch('/follow/'+profileUserId+'/followers?page=1',{headers:{Accept:'application/json'}}),fetch('/follow/'+profileUserId+'/following?page=1',{headers:{Accept:'application/json'}})]);const f=await followers.json(),g=await following.json();if(f.success)document.getElementById('followerCount').textContent=Number(f.total||0);if(g.success)document.getElementById('followingCount').textContent=Number(g.total||0)}catch(e){console.debug('Profile count refresh failed',e)}}
    async function toggleFollow(){const b=document.getElementById('followBtn');if(!b)return;b.disabled=true;try{const r=await fetch('/follow/'+profileUserId+'/follow',{method:'POST',headers:{Accept:'application/json'}});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to update follow');document.getElementById('followerCount').textContent=Number(d.followerCount||0);document.getElementById('followingCount').textContent=document.getElementById('followingCount').textContent;b.className='btn '+(d.following?'success':'primary');b.innerHTML='<i class="fas '+(d.following?'fa-user-check':'fa-user-plus')+'"></i><span>'+(d.following?'Following':d.requested?'Requested':'Follow')+'</span>';notify.success(d.message);setTimeout(refreshCounts,250)}catch(e){notify.error(e.message)}finally{b.disabled=false}}
    async function openPeople(type){const modal=document.getElementById('peopleModal'),list=document.getElementById('peopleList');document.getElementById('peopleTitle').textContent=type==='followers'?'Followers':'Following';list.innerHTML='<div class="empty">Loading…</div>';modal.classList.add('open');try{const r=await fetch('/follow/'+profileUserId+'/'+type+'?page=1');const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to load list');const people=d[type]||[];list.innerHTML=people.length?people.map(p=>'<a class="person" href="/user/profile/'+p._id+'"><img src="'+(p.profileImageURL||'/imgs/default.png')+'" onerror="this.src=\'/imgs/default.png\'"><div><strong>'+escapeHtml(p.fullName)+'</strong><small>'+escapeHtml(p.bio||'')+'</small></div></a>').join(''):'<div class="empty">No people found.</div>'}catch(e){list.innerHTML='<div class="empty">'+escapeHtml(e.message)+'</div>'}}
    function closePeople(){document.getElementById('peopleModal').classList.remove('open')}function escapeHtml(s){return String(s||'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}document.getElementById('peopleModal').addEventListener('click',e=>{if(e.target.id==='peopleModal')closePeople()});
    refreshCounts();
  </script>
</body></html>