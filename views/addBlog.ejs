<!DOCTYPE html><html lang="en"><head><%- include("./partials/head") %><title>Create | Blogify</title><style>
.creator{max-width:1100px;margin:auto;padding:30px 16px 70px}.creator-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}.creator h1{font-weight:850;letter-spacing:-.04em}.post-type-label{font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:10px}.mode-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px}.mode{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:16px;padding:18px;text-align:left;cursor:pointer;transition:.2s}.mode:hover{transform:translateY(-2px);border-color:var(--primary)}.mode.active{border:2px solid var(--primary);background:var(--soft)}.mode i{font-size:1.4rem;color:var(--primary);margin-bottom:9px}.mode strong{display:block}.mode small{display:block;color:var(--muted);margin-top:4px}.creator-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:18px}.panel{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:24px}.field{margin-bottom:19px}.field label{font-weight:750;margin-bottom:7px;display:block}.title-input{font-size:2rem;font-weight:800}.media-box{border:1px dashed var(--border);border-radius:15px;padding:18px;background:var(--soft)}.preview{width:100%;max-height:420px;object-fit:contain;border-radius:12px;margin-top:12px}.quill-wrap{border:1px solid var(--border);border-radius:12px;overflow:hidden}.ql-toolbar.ql-snow{border:0;border-bottom:1px solid var(--border);background:var(--soft)}.ql-container.ql-snow{border:0}.ql-editor{min-height:330px}.side{height:max-content}.publish-btn{width:100%;border:0;border-radius:12px;padding:12px;background:var(--primary);color:#fff;font-weight:800}.hint{font-size:.76rem;color:var(--muted)}@media(max-width:850px){.creator-grid{grid-template-columns:1fr}.mode-grid{grid-template-columns:1fr}.creator-head{align-items:flex-start;gap:12px}.title-input{font-size:1.55rem}}
</style></head><body><%- include("./partials/nave") %><main class="creator"><div class="creator-head"><div><div class="text-uppercase small text-muted fw-bold">Create</div><h1>Share something</h1><p class="text-muted mb-0">Choose what you want to post.</p></div><a href="/" class="btn btn-outline-secondary rounded-pill">Cancel</a></div><% if(locals.error){ %><div class="alert alert-danger rounded-4"><%= error %></div><% } %><form id="postForm" action="/blogs/add-new" method="POST" enctype="multipart/form-data"><div class="post-type-label">What do you want to post?</div><div class="mode-grid"><button type="button" class="mode active" data-type="blog" aria-pressed="true"><i class="fas fa-pen-to-square d-block"></i><strong>Write a Blog</strong><small>Long-form story with an optional cover image.</small></button><button type="button" class="mode" data-type="photo" aria-pressed="false"><i class="fas fa-image d-block"></i><strong>Post a Photo</strong><small>Share one photo with a caption.</small></button><button type="button" class="mode" data-type="video" aria-pressed="false"><i class="fas fa-circle-play d-block"></i><strong>Post a Video</strong><small>Upload a video. The server keeps only the first 60 seconds.</small></button></div><input type="hidden" name="mediaType" id="mediaType" value="blog"><div class="creator-grid"><section class="panel"><div class="field"><label for="title" id="titleLabel">Title</label><input id="title" name="title" class="form-control title-input" maxlength="200" required placeholder="Give your story a title..."></div><div class="field"><label for="mediaFile" id="mediaLabel">Cover image</label><div class="media-box"><input id="mediaFile" name="mediaFile" type="file" class="form-control" accept="image/*"><div id="mediaHint" class="hint mt-2">Images: JPG, PNG, WEBP and other browser-supported image formats.</div><div id="mediaPreview"></div></div></div><div class="field"><label for="excerpt" id="captionLabel">Short description / caption</label><textarea id="excerpt" name="excerpt" class="form-control" rows="3" maxlength="300" placeholder="Tell people what this post is about..."></textarea></div><div class="field"><label>Content / caption <span class="text-danger">*</span></label><div class="quill-wrap"><div id="editor"></div></div></div><input type="hidden" name="body" id="blogContent"><div class="field mb-0"><label for="metaDescription">SEO description</label><input id="metaDescription" name="metaDescription" class="form-control" maxlength="160"></div></section><aside class="panel side"><div class="field"><label>Status</label><label class="d-block p-2 border rounded-3"><input type="radio" name="status" value="published" checked> Publish now</label><label class="d-block p-2 border rounded-3 mt-2"><input type="radio" name="status" value="draft"> Save draft</label></div><div class="field"><label for="category">Category</label><select id="category" name="category" class="form-select"><option>General</option><option>Technology</option><option>Business</option><option>Lifestyle</option><option>Travel</option><option>Education</option><option>Entertainment</option></select></div><div class="field"><label for="tags">Tags</label><input id="tags" name="tags" class="form-control" placeholder="javascript, travel, life"><div class="hint mt-2">Maximum 10 tags.</div></div><div id="videoNotice" class="alert alert-info d-none small">Videos longer than 60 seconds are automatically trimmed by the backend to 60 seconds.</div><button class="publish-btn" id="submitBtn" type="submit"><i class="fas fa-paper-plane me-1"></i><span id="submitText">Publish blog</span></button></aside></div></form></main><%- include("./partials/scripts") %><script src="https://cdn.quilljs.com/1.3.6/quill.js"></script><script>
const q=new Quill('#editor',{theme:'snow',modules:{toolbar:[['bold','italic','underline'],[{header:[1,2,3,false]}],[{list:'ordered'},{list:'bullet'}],['blockquote','link','image'],['clean']]},placeholder:'Write your story or caption...'});const typeInput=document.getElementById('mediaType'),file=document.getElementById('mediaFile'),label=document.getElementById('mediaLabel'),hint=document.getElementById('mediaHint'),notice=document.getElementById('videoNotice'),title=document.getElementById('title'),submit=document.getElementById('submitText');document.querySelectorAll('.mode').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.mode').forEach(x=>{x.classList.remove('active');x.setAttribute('aria-pressed','false')});b.classList.add('active');b.setAttribute('aria-pressed','true');const t=b.dataset.type;typeInput.value=t;notice.classList.toggle('d-none',t!=='video');file.value='';document.getElementById('mediaPreview').innerHTML='';if(t==='video'){label.textContent='Video';file.accept='video/*';hint.textContent='Any supported video. Maximum upload size is 100MB. Videos longer than 60 seconds are trimmed on the server.';submit.textContent='Publish video';title.placeholder='Give your video a title...'}else if(t==='photo'){label.textContent='Photo';file.accept='image/*';hint.textContent='Choose the photo you want to share.';submit.textContent='Publish photo';title.placeholder='Give your photo a title...'}else{label.textContent='Cover image';file.accept='image/*';hint.textContent='Optional cover image for your blog.';submit.textContent='Publish blog';title.placeholder='Give your story a title...'}}));file.addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;const t=typeInput.value;if(t==='video'&&!f.type.startsWith('video/')){file.value='';return}if(t!=='video'&&!f.type.startsWith('image/')){file.value='';return}const url=URL.createObjectURL(f);document.getElementById('mediaPreview').innerHTML=t==='video'?'<video class="preview" controls src="'+url+'"></video>':'<img class="preview" src="'+url+'" alt="Preview">'});document.getElementById('postForm').addEventListener('submit',e=>{const html=q.root.innerHTML;if(!html||html==='<p><br></p>'){e.preventDefault();alert('Please add a caption or content.');return}document.getElementById('blogContent').value=html;submit.textContent='Publishing...';document.getElementById('submitBtn').disabled=true});
</script></body></html>