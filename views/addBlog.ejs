<!DOCTYPE html>
<html lang="en">
<head><%- include("./partials/head") %><title>Create | Blogify</title>
<style>
:root{--c-bg:var(--page);--c-card:var(--surface);--c-line:var(--border);--c-text:var(--text);--c-muted:var(--muted);--c-soft:var(--soft)}body{background:var(--c-bg);color:var(--c-text)}.compose{max-width:980px;margin:auto;padding:28px 16px 80px}.top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:22px}.top-kicker{font-size:.7rem;text-transform:uppercase;letter-spacing:.16em;font-weight:850;color:var(--c-muted)}.top h1{font-size:2.2rem;letter-spacing:-.05em;font-weight:850;margin:4px 0}.top p{margin:0;color:var(--c-muted)}.cancel{border:1px solid var(--c-line);color:var(--c-text);background:var(--c-card);padding:9px 15px;border-radius:11px;text-decoration:none;font-weight:700}.choose{background:var(--c-card);border:1px solid var(--c-line);border-radius:18px;padding:16px;margin-bottom:16px}.choose-title{font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;font-weight:850;color:var(--c-muted);margin-bottom:10px}.types{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.type{display:flex;align-items:center;gap:12px;text-align:left;border:1px solid var(--c-line);background:var(--c-card);color:var(--c-text);border-radius:14px;padding:14px;cursor:pointer;transition:.18s}.type:hover{transform:translateY(-1px)}.type i{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:var(--c-soft);color:var(--primary);font-size:1rem}.type strong{font-size:.9rem}.type small{display:block;color:var(--c-muted);font-size:.72rem;margin-top:3px}.type.active{border-color:var(--primary);background:var(--c-soft);box-shadow:0 0 0 2px color-mix(in srgb,var(--primary) 10%,transparent)}.card{background:var(--c-card);border:1px solid var(--c-line);border-radius:18px}.main{padding:22px}.field{margin-bottom:18px}.field:last-child{margin-bottom:0}.field label{display:block;font-size:.8rem;font-weight:780;margin-bottom:7px}.input,.select{width:100%;box-sizing:border-box;background:var(--c-card);color:var(--c-text);border:1px solid var(--c-line);border-radius:11px;padding:12px;outline:none}.input:focus,.select:focus{border-color:var(--primary);box-shadow:0 0 0 3px color-mix(in srgb,var(--primary) 10%,transparent)}.title{font-size:1.55rem!important;font-weight:800!important}.upload{border:1px dashed var(--c-line);background:var(--c-soft);border-radius:14px;padding:17px}.upload input{width:100%}.hint{font-size:.72rem;color:var(--c-muted);line-height:1.45;margin-top:7px}.preview{width:100%;max-height:390px;object-fit:contain;background:#111;border-radius:11px;margin-top:12px}.quill{border:1px solid var(--c-line);border-radius:11px;overflow:hidden}.ql-toolbar.ql-snow{border:0;border-bottom:1px solid var(--c-line);background:var(--c-soft)}.ql-container.ql-snow{border:0}.ql-editor{min-height:300px;color:var(--c-text)}.ql-editor.ql-blank:before{color:var(--c-muted)}
.side{padding:20px;margin-top:20px;border:1px solid var(--c-line);border-radius:18px;background:linear-gradient(145deg,var(--c-card),var(--c-soft));box-shadow:0 8px 24px color-mix(in srgb,var(--c-text) 5%,transparent)}.side-title{display:flex;align-items:center;gap:9px;font-size:1rem;font-weight:850;margin-bottom:15px;letter-spacing:-.01em}.side-title:before{content:'⚙';display:grid;place-items:center;width:32px;height:32px;border-radius:10px;background:var(--primary);color:#fff;font-size:.9rem}.option{padding:12px 13px;border:1px solid var(--c-line);border-radius:12px;margin-bottom:9px;background:color-mix(in srgb,var(--c-card) 86%,transparent);transition:border-color .18s,transform .18s,background .18s}.option:hover{border-color:var(--primary);transform:translateY(-1px);background:var(--c-card)}.option label{display:flex;gap:10px;align-items:center;margin:0;font-size:.82rem;font-weight:700;cursor:pointer}.option input{accent-color:var(--primary);width:16px;height:16px;margin:0}.side .field{margin-bottom:13px}.side .field label{font-size:.76rem;color:var(--c-muted);text-transform:uppercase;letter-spacing:.06em}.side .select,.side .input{background:var(--c-card);border-radius:12px;padding:11px 12px}.side .hint{padding-left:2px}.notice{font-size:.74rem;padding:10px 11px;border-radius:10px;background:var(--c-soft);color:var(--c-muted);line-height:1.45}.publish{width:100%;border:0;border-radius:11px;background:var(--primary);color:#fff;padding:13px;font-weight:800;margin-top:14px}.publish:disabled{opacity:.65}.error{padding:11px 13px;background:#fee2e2;color:#991b1b;border-radius:10px;margin-bottom:16px;font-size:.85rem}.blog-only{display:block}.media-only{display:none}.media-mode .blog-only{display:none}.media-mode .media-only{display:block}.media-mode .main{max-width:700px;margin:auto}.media-mode .side{max-width:700px;margin-left:auto;margin-right:auto}.media-mode .title{font-size:1.35rem!important}.mode-caption{font-size:.75rem;color:var(--c-muted);margin-top:3px}@media(max-width:700px){.compose{padding:18px 12px 60px}.types{grid-template-columns:1fr}.top h1{font-size:1.8rem}.top{gap:12px}.cancel{font-size:.8rem}.main{padding:16px}.side{padding:16px;margin-top:16px;border-radius:15px}.side-title{font-size:.92rem}.option{padding:11px 12px}}
</style></head>
<body><%- include("./partials/nave") %>
<main class="compose" id="compose">
<header class="top"><div><div class="top-kicker">Create on Blogify</div><h1 id="pageTitle">Create a blog</h1><p id="pageSubtitle">Write and publish a complete story.</p></div><a href="/" class="cancel">Cancel</a></header>
<% if(locals.error){ %><div class="error"><i class="fas fa-circle-exclamation me-1"></i><%= error %></div><% } %>
<form id="postForm" action="/blogs/add-new" method="POST" enctype="multipart/form-data">
<section class="choose"><div class="choose-title">What do you want to post?</div><div class="types"><button type="button" class="type active" data-type="blog" aria-pressed="true"><i class="fas fa-pen"></i><span><strong>Blog</strong><small>Full article with all details</small></span></button><button type="button" class="type" data-type="photo" aria-pressed="false"><i class="fas fa-image"></i><span><strong>Photo</strong><small>Image + optional details</small></span></button><button type="button" class="type" data-type="video" aria-pressed="false"><i class="fas fa-video"></i><span><strong>Video</strong><small>Video up to 60 seconds</small></span></button></div></section>
<input type="hidden" name="mediaType" id="mediaType" value="blog">
<section class="card main">
<div class="field blog-only"><label for="title">Blog title</label><input id="title" name="title" class="input title" maxlength="200" required placeholder="Start with a clear title..."></div>
<div class="field media-only"><label for="mediaFile" id="mediaLabel">Photo</label><div class="upload"><input id="mediaFile" name="mediaFile" type="file" accept="image/*"><div id="mediaHint" class="hint">Choose the photo you want to share.</div><div id="mediaPreview"></div></div></div>
<div class="field blog-only"><label for="coverFile">Cover image <span class="mode-caption">Optional</span></label><div class="upload"><input id="coverFile" name="mediaFile" type="file" accept="image/*"><div class="hint">Optional cover image for your blog.</div></div></div>
<div class="field media-only"><label for="mediaTitle">Title <span class="mode-caption">Optional</span></label><input id="mediaTitle" class="input" maxlength="200" placeholder="Add a title if you want..."></div>
<div class="field"><label for="excerpt" id="captionLabel">Description <span class="mode-caption" id="captionHint">Optional for photos and videos</span></label><textarea id="excerpt" name="excerpt" class="input" rows="3" maxlength="500" placeholder="Tell people about this post..."></textarea></div>
<div class="field media-only"><label for="location">Place / location <span class="mode-caption">Optional</span></label><input id="location" name="location" class="input" maxlength="200" placeholder="Add a place or location"></div>
<div class="field blog-only"><label>Blog content</label><div class="quill"><div id="editor"></div></div></div>
<input type="hidden" name="body" id="blogContent">
<div class="field blog-only"><label for="metaDescription">SEO description <span class="mode-caption">Optional</span></label><input id="metaDescription" name="metaDescription" class="input" maxlength="160" placeholder="Short search-engine description"></div>
<div class="side blog-only"><div class="side-title">Blog publishing details</div><div class="option"><label><input type="radio" name="status" value="published" checked> Publish now</label></div><div class="option"><label><input type="radio" name="status" value="draft"> Save as draft</label></div><div class="field" style="margin-top:14px"><label for="category">Category</label><select id="category" name="category" class="select"><option>General</option><option>Technology</option><option>Business</option><option>Lifestyle</option><option>Travel</option><option>Education</option><option>Entertainment</option></select></div><div class="field"><label for="tags">Tags</label><input id="tags" name="tags" class="input" placeholder="javascript, travel, life"><div class="hint">Use up to 10 tags.</div></div></div>
<div id="videoNotice" class="notice media-only" style="display:none"><i class="fas fa-scissors me-1"></i>Videos longer than 60 seconds are automatically trimmed to the first 60 seconds by the backend.</div>
<button class="publish" id="submitBtn" type="submit"><i class="fas fa-arrow-up-right-from-square me-1"></i><span id="submitText">Publish blog</span></button>
</section></form></main>
<%- include("./partials/scripts") %><script src="https://cdn.quilljs.com/1.3.6/quill.js"></script><script>
const compose=document.getElementById('compose'),form=document.getElementById('postForm'),editor=new Quill('#editor',{theme:'snow',modules:{toolbar:[['bold','italic','underline'],[{header:[1,2,3,false]}],[{list:'ordered'},{list:'bullet'}],['blockquote','link','image'],['clean']]},placeholder:'Write your story...'}),mediaType=document.getElementById('mediaType'),file=document.getElementById('mediaFile'),mediaLabel=document.getElementById('mediaLabel'),hint=document.getElementById('mediaHint'),notice=document.getElementById('videoNotice'),preview=document.getElementById('mediaPreview'),submitText=document.getElementById('submitText'),title=document.getElementById('title'),pageTitle=document.getElementById('pageTitle'),pageSubtitle=document.getElementById('pageSubtitle');
document.querySelectorAll('.type').forEach(btn=>btn.addEventListener('click',()=>{const t=btn.dataset.type;document.querySelectorAll('.type').forEach(x=>{x.classList.toggle('active',x===btn);x.setAttribute('aria-pressed',String(x===btn))});mediaType.value=t;file.value='';preview.innerHTML='';compose.classList.toggle('media-mode',t!=='blog');notice.style.display=t==='video'?'block':'none';if(t==='video'){mediaLabel.textContent='Video';file.accept='video/*';hint.textContent='Choose a video. Videos longer than 60 seconds are trimmed automatically.';pageTitle.textContent='Share a video';pageSubtitle.textContent='Add a video with an optional description and location.';submitText.textContent='Publish video'}else if(t==='photo'){mediaLabel.textContent='Photo';file.accept='image/*';hint.textContent='Choose the photo you want to share.';pageTitle.textContent='Share a photo';pageSubtitle.textContent='Add a photo with an optional description and location.';submitText.textContent='Publish photo'}else{pageTitle.textContent='Create a blog';pageSubtitle.textContent='Write and publish a complete story.';submitText.textContent='Publish blog'}}));
file.addEventListener('change',()=>{const f=file.files[0];if(!f)return;const t=mediaType.value;if(t==='video'&&!f.type.startsWith('video/')){file.value='';preview.innerHTML='';return}if(t==='photo'&&!f.type.startsWith('image/')){file.value='';preview.innerHTML='';return}const url=URL.createObjectURL(f);preview.innerHTML=t==='video'?'<video class="preview" controls playsinline src="'+url+'"></video>':'<img class="preview" src="'+url+'" alt="Selected photo">'});
form.addEventListener('submit',e=>{if(mediaType.value==='blog'){const html=editor.root.innerHTML;if(!html||html==='<p><br></p>'){e.preventDefault();alert('Please add your blog content.');return}document.getElementById('blogContent').value=html}else{if(!file.files.length){e.preventDefault();alert('Please select a '+mediaType.value+'.');return}document.getElementById('blogContent').value=document.getElementById('excerpt').value||''}document.getElementById('submitBtn').disabled=true;submitText.textContent='Publishing...'});
</script></body></html>