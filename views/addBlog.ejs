<!DOCTYPE html>
<html lang="en">
<head><%- include("./partials/head") %><title>Create | Blogify</title>
<style>
:root{--c-bg:var(--page);--c-card:var(--surface);--c-line:var(--border);--c-text:var(--text);--c-muted:var(--muted);--c-soft:var(--soft)}body{background:var(--c-bg);color:var(--c-text)}.compose{max-width:1080px;margin:auto;padding:30px 16px 80px}.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:25px}.top-kicker{font-size:.7rem;text-transform:uppercase;letter-spacing:.16em;font-weight:850;color:var(--c-muted)}.top h1{font-size:2.35rem;letter-spacing:-.055em;font-weight:850;margin:4px 0}.top p{margin:0;color:var(--c-muted)}.cancel{border:1px solid var(--c-line);color:var(--c-text);background:var(--c-card);padding:9px 15px;border-radius:11px;text-decoration:none;font-weight:700}.choose{margin-bottom:18px}.choose-title{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;font-weight:850;color:var(--c-muted);margin-bottom:9px}.types{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.type{display:flex;align-items:center;gap:12px;text-align:left;border:1px solid var(--c-line);background:var(--c-card);color:var(--c-text);border-radius:13px;padding:13px;cursor:pointer}.type i{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;background:var(--c-soft);color:var(--primary);font-size:1rem}.type strong{font-size:.88rem}.type small{display:block;color:var(--c-muted);font-size:.72rem;margin-top:2px}.type.active{border-color:var(--primary);box-shadow:0 0 0 2px color-mix(in srgb,var(--primary) 12%,transparent);background:var(--c-soft)}.layout{display:grid;grid-template-columns:minmax(0,1fr) 275px;gap:16px}.card{background:var(--c-card);border:1px solid var(--c-line);border-radius:16px}.main{padding:25px}.side{padding:18px;height:max-content;position:sticky;top:15px}.field{margin-bottom:18px}.field:last-child{margin-bottom:0}.field label{display:block;font-size:.8rem;font-weight:780;margin-bottom:7px}.title{font-size:1.8rem!important;font-weight:800!important;padding:13px 14px!important}.input,.select{width:100%;background:var(--c-card);color:var(--c-text);border:1px solid var(--c-line);border-radius:10px;padding:11px 12px;outline:none}.input:focus,.select:focus{border-color:var(--primary);box-shadow:0 0 0 3px color-mix(in srgb,var(--primary) 10%,transparent)}.upload{border:1px dashed var(--c-line);background:var(--c-soft);border-radius:13px;padding:17px}.upload input{width:100%}.hint{font-size:.72rem;color:var(--c-muted);line-height:1.45;margin-top:7px}.preview{width:100%;max-height:360px;object-fit:contain;background:#111;border-radius:10px;margin-top:12px}.quill{border:1px solid var(--c-line);border-radius:11px;overflow:hidden}.ql-toolbar.ql-snow{border:0;border-bottom:1px solid var(--c-line);background:var(--c-soft)}.ql-container.ql-snow{border:0}.ql-editor{min-height:300px;color:var(--c-text)}.ql-editor.ql-blank:before{color:var(--c-muted)}.side-title{font-size:.92rem;font-weight:820;margin-bottom:14px}.option{padding:12px;border:1px solid var(--c-line);border-radius:10px;margin-bottom:8px}.option label{display:flex;gap:9px;align-items:center;margin:0;font-size:.8rem}.side-sep{height:1px;background:var(--c-line);margin:18px 0}.notice{font-size:.74rem;padding:10px 11px;border-radius:10px;background:var(--c-soft);color:var(--c-muted);line-height:1.45}.publish{width:100%;border:0;border-radius:10px;background:var(--primary);color:#fff;padding:12px;font-weight:800;margin-top:15px}.publish:disabled{opacity:.65}.mobile-actions{display:none}.error{padding:11px 13px;background:#fee2e2;color:#991b1b;border-radius:10px;margin-bottom:16px;font-size:.85rem}@media(max-width:800px){.layout{grid-template-columns:1fr}.side{position:static}.types{grid-template-columns:1fr}.top h1{font-size:1.9rem}}@media(max-width:520px){.compose{padding:20px 12px 60px}.main{padding:17px}.title{font-size:1.45rem!important}.top{align-items:flex-start}.cancel{font-size:.8rem}}
</style></head>
<body><%- include("./partials/nave") %>
<main class="compose">
<header class="top"><div><div class="top-kicker">Create on Blogify</div><h1>Make something worth sharing.</h1><p>Choose a format, add your content, and publish.</p></div><a href="/" class="cancel">Cancel</a></header>
<% if(locals.error){ %><div class="error"><i class="fas fa-circle-exclamation me-1"></i><%= error %></div><% } %>
<form id="postForm" action="/blogs/add-new" method="POST" enctype="multipart/form-data">
<section class="choose"><div class="choose-title">Post format</div><div class="types"><button type="button" class="type active" data-type="blog" aria-pressed="true"><i class="fas fa-pen"></i><span><strong>Blog</strong><small>Write a full story</small></span></button><button type="button" class="type" data-type="photo" aria-pressed="false"><i class="fas fa-image"></i><span><strong>Photo</strong><small>Share an image</small></span></button><button type="button" class="type" data-type="video" aria-pressed="false"><i class="fas fa-video"></i><span><strong>Video</strong><small>Up to 60 seconds</small></span></button></div></section>
<input type="hidden" name="mediaType" id="mediaType" value="blog">
<div class="layout"><section class="card main"><div class="field"><label for="title">Title</label><input id="title" name="title" class="input title" maxlength="200" required placeholder="Start with a clear title..."></div><div class="field"><label id="mediaLabel" for="mediaFile">Cover image</label><div class="upload"><input id="mediaFile" name="mediaFile" type="file" accept="image/*"><div id="mediaHint" class="hint">Optional cover image. JPG, PNG, WEBP and other supported image formats.</div><div id="mediaPreview"></div></div></div><div class="field"><label for="excerpt" id="captionLabel">Description</label><textarea id="excerpt" name="excerpt" class="input" rows="3" maxlength="300" placeholder="A short description for your post..."></textarea></div><div class="field"><label>Content / caption</label><div class="quill"><div id="editor"></div></div></div><input type="hidden" name="body" id="blogContent"><div class="field"><label for="metaDescription">SEO description <span class="hint">Optional</span></label><input id="metaDescription" name="metaDescription" class="input" maxlength="160" placeholder="Short search-engine description"></div></section>
<aside class="card side"><div class="side-title">Publishing</div><div class="option"><label><input type="radio" name="status" value="published" checked> Publish now</label></div><div class="option"><label><input type="radio" name="status" value="draft"> Save as draft</label></div><div class="side-sep"></div><div class="field"><label for="category">Category</label><select id="category" name="category" class="select"><option>General</option><option>Technology</option><option>Business</option><option>Lifestyle</option><option>Travel</option><option>Education</option><option>Entertainment</option></select></div><div class="field"><label for="tags">Tags</label><input id="tags" name="tags" class="input" placeholder="javascript, travel, life"><div class="hint">Use up to 10 tags.</div></div><div id="videoNotice" class="notice" style="display:none"><i class="fas fa-scissors me-1"></i>Videos longer than 60 seconds are automatically trimmed to the first 60 seconds by the backend.</div><button class="publish" id="submitBtn" type="submit"><i class="fas fa-arrow-up-right-from-square me-1"></i><span id="submitText">Publish blog</span></button></aside></div></form></main>
<%- include("./partials/scripts") %><script src="https://cdn.quilljs.com/1.3.6/quill.js"></script><script>
const editor=new Quill('#editor',{theme:'snow',modules:{toolbar:[['bold','italic','underline'],[{header:[1,2,3,false]}],[{list:'ordered'},{list:'bullet'}],['blockquote','link','image'],['clean']]},placeholder:'Write your story, caption, or context...'});const mediaType=document.getElementById('mediaType'),file=document.getElementById('mediaFile'),mediaLabel=document.getElementById('mediaLabel'),hint=document.getElementById('mediaHint'),notice=document.getElementById('videoNotice'),title=document.getElementById('title'),preview=document.getElementById('mediaPreview'),submitText=document.getElementById('submitText');document.querySelectorAll('.type').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.type').forEach(x=>{x.classList.remove('active');x.setAttribute('aria-pressed','false')});btn.classList.add('active');btn.setAttribute('aria-pressed','true');const t=btn.dataset.type;mediaType.value=t;file.value='';preview.innerHTML='';notice.style.display=t==='video'?'block':'none';if(t==='video'){mediaLabel.textContent='Video';file.accept='video/*';hint.textContent='Any supported video up to 100MB. If longer than 60 seconds, the server keeps the first 60 seconds.';title.placeholder='Give your video a title...';submitText.textContent='Publish video'}else if(t==='photo'){mediaLabel.textContent='Photo';file.accept='image/*';hint.textContent='Choose the image you want to share.';title.placeholder='Give your photo a title...';submitText.textContent='Publish photo'}else{mediaLabel.textContent='Cover image';file.accept='image/*';hint.textContent='Optional cover image for your blog.';title.placeholder='Start with a clear title...';submitText.textContent='Publish blog'}}));file.addEventListener('change',()=>{const f=file.files[0];if(!f)return;const t=mediaType.value;if(t==='video'&&!f.type.startsWith('video/')){file.value='';return}if(t!=='video'&&!f.type.startsWith('image/')){file.value='';return}const url=URL.createObjectURL(f);preview.innerHTML=t==='video'?'<video class="preview" controls playsinline src="'+url+'"></video>':'<img class="preview" src="'+url+'" alt="Selected image">'});document.getElementById('postForm').addEventListener('submit',e=>{const html=editor.root.innerHTML;if(!html||html==='<p><br></p>'){e.preventDefault();alert('Please add content or a caption.');return}document.getElementById('blogContent').value=html;document.getElementById('submitBtn').disabled=true;submitText.textContent='Publishing...'});
</script></body></html>