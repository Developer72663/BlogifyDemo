<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title>Create | Blogify</title>
  <style>
    :root{--c-bg:var(--page);--c-card:var(--surface);--c-line:var(--border);--c-text:var(--text);--c-muted:var(--muted);--c-soft:var(--soft)}
    body{background:var(--c-bg);color:var(--c-text)}
    .compose{max-width:980px;margin:auto;padding:28px 16px 80px}.top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:22px}.top-kicker{font-size:.7rem;text-transform:uppercase;letter-spacing:.16em;font-weight:850;color:var(--c-muted)}.top h1{font-size:2.2rem;letter-spacing:-.05em;font-weight:850;margin:4px 0}.top p{margin:0;color:var(--c-muted)}.cancel{border:1px solid var(--c-line);color:var(--c-text);background:var(--c-card);padding:9px 15px;border-radius:11px;text-decoration:none;font-weight:700}
    .choose{background:var(--c-card);border:1px solid var(--c-line);border-radius:18px;padding:16px;margin-bottom:16px}.choose-title{font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;font-weight:850;color:var(--c-muted);margin-bottom:10px}.types{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.type{display:flex;align-items:center;gap:12px;text-align:left;border:1px solid var(--c-line);background:var(--c-card);color:var(--c-text);border-radius:14px;padding:14px;cursor:pointer;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}.type:hover{transform:translateY(-2px)}.type i{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:var(--c-soft);color:var(--primary);font-size:1rem}.type strong{font-size:.9rem}.type small{display:block;color:var(--c-muted);font-size:.72rem;margin-top:3px}.type.active{border-color:var(--primary);background:var(--c-soft);box-shadow:0 0 0 2px color-mix(in srgb,var(--primary) 10%,transparent)}
    .card{background:var(--c-card);border:1px solid var(--c-line);border-radius:18px}.main{padding:22px}.field{margin-bottom:18px}.field label{display:block;font-size:.8rem;font-weight:780;margin-bottom:7px}.input,.select{width:100%;box-sizing:border-box;background:var(--c-card);color:var(--c-text);border:1px solid var(--c-line);border-radius:11px;padding:12px;outline:none}.input:focus,.select:focus{border-color:var(--primary);box-shadow:0 0 0 3px color-mix(in srgb,var(--primary) 10%,transparent)}.title{font-size:1.55rem!important;font-weight:800!important}.upload{border:1px dashed var(--c-line);background:var(--c-soft);border-radius:14px;padding:17px}.upload input{width:100%;cursor:pointer}.hint{font-size:.72rem;color:var(--c-muted);line-height:1.45;margin-top:7px}.preview{width:100%;max-height:390px;object-fit:contain;background:#111;border-radius:11px;margin-top:12px}.body-editor{min-height:320px;resize:vertical;line-height:1.7}.publish{width:100%;border:0;border-radius:11px;background:var(--primary);color:#fff;padding:13px;font-weight:800;margin-top:14px;position:relative;overflow:hidden;transition:transform .18s ease,box-shadow .18s ease}.publish:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 8px 24px color-mix(in srgb,var(--primary) 25%,transparent)}.publish:disabled{opacity:.65}.error{padding:11px 13px;background:#fee2e2;color:#991b1b;border-radius:10px;margin-bottom:16px;font-size:.85rem}.blog-only{display:block}.media-only{display:none}.media-mode .blog-only{display:none}.media-mode .media-only{display:block}.notice{font-size:.74rem;padding:10px 11px;border-radius:10px;background:var(--c-soft);color:var(--c-muted);line-height:1.45;margin-bottom:14px}
    .uploading-overlay{position:fixed;inset:0;background:rgba(0,0,0,.48);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;z-index:10050}.uploading-overlay.open{display:flex}.uploading-card{width:min(420px,calc(100% - 32px));background:var(--c-card);color:var(--c-text);border:1px solid var(--c-line);border-radius:22px;padding:28px;text-align:center;box-shadow:0 20px 70px rgba(0,0,0,.28);animation:postPop .28s ease-out}.uploading-icon{width:64px;height:64px;margin:0 auto 14px;border-radius:50%;display:grid;place-items:center;background:var(--c-soft);color:var(--primary);font-size:1.45rem;animation:postPulse 1.4s ease-in-out infinite}.uploading-card h2{margin:0 0 6px;font-size:1.15rem}.uploading-card p{margin:0;color:var(--c-muted);font-size:.82rem}.upload-progress{height:7px;border-radius:999px;background:var(--c-soft);overflow:hidden;margin-top:18px}.upload-progress span{display:block;height:100%;width:35%;border-radius:inherit;background:var(--primary);animation:postProgress 1.25s ease-in-out infinite}.success-burst{position:fixed;inset:0;pointer-events:none;z-index:10060;display:none;align-items:center;justify-content:center}.success-burst.open{display:flex}.success-burst .check{width:74px;height:74px;border-radius:50%;background:var(--primary);color:#fff;display:grid;place-items:center;font-size:2rem;box-shadow:0 12px 35px color-mix(in srgb,var(--primary) 35%,transparent);animation:successPop .5s cubic-bezier(.22,1.4,.36,1)}@keyframes postPop{from{opacity:0;transform:translateY(12px) scale(.96)}to{opacity:1;transform:none}}@keyframes postPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}@keyframes postProgress{0%{transform:translateX(-120%)}100%{transform:translateX(310%)}}@keyframes successPop{0%{opacity:0;transform:scale(.2)}65%{opacity:1;transform:scale(1.12)}100%{transform:scale(1)}}
    @media(max-width:700px){.compose{padding:18px 12px 60px}.types{grid-template-columns:1fr}.top h1{font-size:1.8rem}.main{padding:16px}.uploading-card{padding:24px}}
  </style>
</head>
<body>
<%- include("./partials/nave") %>
<main class="compose" id="compose">
<header class="top"><div><div class="top-kicker">Create on Blogify</div><h1 id="pageTitle">Create a blog</h1><p id="pageSubtitle">Write and publish a complete story.</p></div><a href="/" class="cancel">Cancel</a></header>
<% if(locals.error){ %><div class="error"><i class="fas fa-circle-exclamation me-1"></i><%= error %></div><% } %>
<form id="postForm" action="/blogs/add-new" method="POST" enctype="multipart/form-data" novalidate>
<section class="choose"><div class="choose-title">What do you want to post?</div><div class="types">
<button type="button" class="type active" data-type="blog" aria-pressed="true"><i class="fas fa-pen"></i><span><strong>Blog</strong><small>Full article with details</small></span></button>
<button type="button" class="type" data-type="photo" aria-pressed="false"><i class="fas fa-image"></i><span><strong>Photo</strong><small>Image + optional details</small></span></button>
<button type="button" class="type" data-type="video" aria-pressed="false"><i class="fas fa-video"></i><span><strong>Video</strong><small>Video up to 60 seconds</small></span></button>
</div></section>
<input type="hidden" name="mediaType" id="mediaType" value="blog">
<section class="card main">
<div class="field"><label for="title" id="titleLabel">Blog title</label><input id="title" name="title" class="input title" maxlength="200" required placeholder="Start with a clear title..."></div>
<div class="field media-only"><label for="mediaFile" id="mediaLabel">Photo / video</label><div class="upload"><input id="mediaFile" name="mediaFile" type="file" accept="image/*" disabled><div id="mediaHint" class="hint">Choose the media you want to share.</div><div id="mediaPreview"></div></div></div>
<div class="field blog-only"><label for="coverFile">Cover image <span class="hint">Optional</span></label><div class="upload"><input id="coverFile" type="file" accept="image/*"><div class="hint">Optional image. It is sent as the main media file for a blog post.</div></div></div>
<div class="field"><label for="excerpt">Description <span class="hint">Optional for photos and videos</span></label><textarea id="excerpt" name="excerpt" class="input" rows="3" maxlength="500" placeholder="Tell people about this post..."></textarea></div>
<div class="field media-only"><label for="location">Place / location <span class="hint">Optional</span></label><input id="location" name="location" class="input" maxlength="200" placeholder="Add a place or location"></div>
<div class="field blog-only"><label for="bodyEditor">Blog content</label><textarea id="bodyEditor" class="input body-editor" maxlength="50000" required placeholder="Write your blog content here..."></textarea><div class="hint">Your content is sent directly as the <strong>body</strong> field required by the backend.</div></div>
<input type="hidden" name="body" id="blogContent">
<div class="field blog-only"><label for="metaDescription">SEO description <span class="hint">Optional</span></label><input id="metaDescription" name="metaDescription" class="input" maxlength="160" placeholder="Short search-engine description"></div>
<div class="side blog-only"><div class="field"><label for="category">Category</label><select id="category" name="category" class="select"><option>General</option><option>Technology</option><option>Business</option><option>Lifestyle</option><option>Travel</option><option>Education</option><option>Entertainment</option></select></div><div class="field"><label for="tags">Tags</label><input id="tags" name="tags" class="input" maxlength="300" placeholder="javascript, travel, life"><div class="hint">Use up to 10 tags.</div></div><div class="field"><label>Status</label><label><input type="radio" name="status" value="published" checked> Publish now</label><br><label><input type="radio" name="status" value="draft"> Save as draft</label></div></div>
<div id="videoNotice" class="notice media-only" style="display:none"><i class="fas fa-scissors me-1"></i>Videos longer than 60 seconds are trimmed by the backend.</div>
<button class="publish" id="submitBtn" type="submit"><i class="fas fa-arrow-up-right-from-square me-1"></i><span id="submitText">Publish blog</span></button>
</section></form></main>
<div class="uploading-overlay" id="uploadingOverlay" aria-live="polite" aria-hidden="true"><div class="uploading-card"><div class="uploading-icon"><i id="uploadingIcon" class="fas fa-cloud-arrow-up"></i></div><h2 id="uploadingTitle">Publishing your post…</h2><p id="uploadingMessage">Please keep this page open while Blogify uploads your post.</p><div class="upload-progress"><span></span></div></div></div>
<div class="success-burst" id="successBurst" aria-hidden="true"><div class="check"><i class="fas fa-check"></i></div></div>
<%- include("./partials/scripts") %>
<script>
(function(){
const form=document.getElementById('postForm'),compose=document.getElementById('compose'),mediaType=document.getElementById('mediaType'),mediaFile=document.getElementById('mediaFile'),coverFile=document.getElementById('coverFile'),bodyEditor=document.getElementById('bodyEditor'),body=document.getElementById('blogContent'),excerpt=document.getElementById('excerpt'),preview=document.getElementById('mediaPreview'),title=document.getElementById('title'),submitBtn=document.getElementById('submitBtn'),submitText=document.getElementById('submitText'),overlay=document.getElementById('uploadingOverlay'),uploadingTitle=document.getElementById('uploadingTitle'),uploadingMessage=document.getElementById('uploadingMessage'),uploadingIcon=document.getElementById('uploadingIcon'),successBurst=document.getElementById('successBurst');
function setMode(type){
 document.querySelectorAll('.type').forEach(btn=>{const active=btn.dataset.type===type;btn.classList.toggle('active',active);btn.setAttribute('aria-pressed',String(active));});
 mediaType.value=type;mediaFile.value='';preview.innerHTML='';
 const blog=type==='blog';mediaFile.disabled=blog;coverFile.disabled=!blog;compose.classList.toggle('media-mode',!blog);
 document.getElementById('videoNotice').style.display=type==='video'?'block':'none';
 document.getElementById('pageTitle').textContent=blog?'Create a blog':type==='photo'?'Share a photo':'Share a video';
 document.getElementById('pageSubtitle').textContent=blog?'Write and publish a complete story.':type==='photo'?'Add a photo with an optional description and location.':'Add a video with an optional description and location.';
 document.getElementById('titleLabel').textContent=blog?'Blog title':type==='photo'?'Photo title':'Video title';
 title.placeholder=blog?'Start with a clear title...':`Add a title for your ${type}...`;
 document.getElementById('mediaLabel').textContent=type==='video'?'Video':'Photo';
 document.getElementById('mediaHint').textContent=type==='video'?'Choose a video file. Videos longer than 60 seconds are trimmed automatically.':'Choose the photo you want to share.';
 mediaFile.accept=type==='video'?'video/*':'image/*';submitText.textContent=blog?'Publish blog':`Publish ${type}`;
}
function showPreview(file,type){if(!file){preview.innerHTML='';return}const url=URL.createObjectURL(file);preview.innerHTML=type==='video'?`<video class="preview" controls playsinline src="${url}"></video>`:`<img class="preview" src="${url}" alt="Selected photo">`;}
document.querySelectorAll('.type').forEach(btn=>btn.addEventListener('click',()=>setMode(btn.dataset.type)));
mediaFile.addEventListener('change',()=>{const file=mediaFile.files[0],type=mediaType.value;if(!file)return;if(type==='photo'&&!file.type.startsWith('image/')){mediaFile.value='';alert('Please choose an image file.');return}if(type==='video'&&!file.type.startsWith('video/')){mediaFile.value='';alert('Please choose a video file.');return}showPreview(file,type)});
form.addEventListener('submit',e=>{const type=mediaType.value;const t=title.value.trim();if(!t){e.preventDefault();title.focus();alert('Please enter a title.');return}if(type==='blog'){const value=bodyEditor.value.trim();if(!value){e.preventDefault();bodyEditor.focus();alert('Please add your blog content.');return}body.value=value;const cover=coverFile.files[0];if(cover){const dt=new DataTransfer();dt.items.add(cover);const transferInput=document.createElement('input');transferInput.type='file';transferInput.name='mediaFile';transferInput.files=dt.files;transferInput.style.display='none';form.appendChild(transferInput);}}else{if(!mediaFile.files.length){e.preventDefault();mediaFile.focus();alert(`Please select a ${type}.`);return}body.value=(excerpt.value.trim()||t)}
 e.preventDefault();
 submitBtn.disabled=true;
 const modeLabel=type==='blog'?'blog':type;
 uploadingTitle.textContent=type==='video'?'Uploading your video…':type==='photo'?'Uploading your photo…':'Publishing your blog…';
 uploadingMessage.textContent=type==='video'?'Video processing can take a little longer. Please keep this page open.':`Your ${modeLabel} is being published. Please keep this page open.`;
 uploadingIcon.className=type==='video'?'fas fa-video':type==='photo'?'fas fa-image':'fas fa-cloud-arrow-up';
 overlay.classList.add('open');overlay.setAttribute('aria-hidden','false');
 const formData=new FormData(form);
 fetch(form.action,{method:'POST',body:formData,credentials:'same-origin',headers:{'Accept':'application/json'}})
   .then(async response=>{let data=null;try{data=await response.json()}catch(_){ }if(!response.ok||!data?.success){throw new Error(data?.message||`Publishing failed (${response.status})`)}return data})
   .then(data=>{overlay.classList.remove('open');overlay.setAttribute('aria-hidden','true');successBurst.classList.add('open');setTimeout(()=>{window.location.href=data.redirect||'/';},650)})
   .catch(error=>{overlay.classList.remove('open');overlay.setAttribute('aria-hidden','true');submitBtn.disabled=false;submitText.textContent=type==='blog'?'Publish blog':`Publish ${type}`;alert(error.message||'Unable to publish. Please try again.');});
});
setMode('blog');
})();
</script>
</body></html>
