<!DOCTYPE html>
<html lang="en" data-theme="<%= (user && user.theme) || 'light' %>">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title><%= profileUser.fullName %> | Blogify</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"><style>:root{--bg:#f8f9fa;--surface:#fff;--surface2:#f1f5f9;--text:#0f172a;--muted:#64748b;--border:#e2e8f0;--primary:#6366f1;--danger:#ef4444}*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--text)}.profile-header{height:180px;background:linear-gradient(135deg,var(--primary),#8b5cf6)}.profile-card{max-width:900px;margin:-70px auto 0;padding:0 24px;position:relative}.profile-card-inner{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:28px;box-shadow:0 14px 45px rgba(15,23,42,.1)}.profile-top{display:flex;gap:22px;align-items:flex-start}.profile-avatar{width:120px;height:120px;border-radius:50%;object-fit:cover;border:4px solid var(--surface);margin-top:-65px;background:var(--surface2)}.profile-info{flex:1}.profile-name{font-size:1.75rem;margin:0 0 4px}.profile-handle,.profile-bio,.meta-item{color:var(--muted)}.profile-bio{line-height:1.6}.profile-meta{display:flex;gap:18px;flex-wrap:wrap}.profile-meta a{color:var(--primary);text-decoration:none}.profile-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.btn{padding:10px 18px;border-radius:11px;font-weight:700;border:1px solid var(--border);display:inline-flex;align-items:center;gap:7px;text-decoration:none;cursor:pointer}.primary{background:var(--primary);color:#fff;border-color:var(--primary)}.outline{background:transparent;color:var(--text)}.menu-wrap{position:relative;display:inline-block}.more-btn{width:42px;height:42px;border-radius:50%;border:1px solid var(--border);background:var(--surface);color:var(--text);cursor:pointer}.more-menu{display:none;position:absolute;right:0;top:48px;z-index:30;width:270px;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:7px;box-shadow:0 16px 45px rgba(15,23,42,.18)}.more-menu.open{display:block}.more-menu button,.more-menu a{width:100%;display:flex;gap:10px;align-items:center;padding:11px 12px;border:0;background:none;color:var(--text);text-decoration:none;border-radius:9px;text-align:left;cursor:pointer}.more-menu button:hover,.more-menu a:hover{background:var(--surface2)}.more-menu .danger{color:var(--danger)}.stats{display:flex;border-top:1px solid var(--border);margin-top:24px;padding-top:20px}.stat{flex:1;text-align:center;border-right:1px solid var(--border)}.stat:last-child{border:0}.stat strong{display:block;font-size:1.35rem}.stat span{color:var(--muted);font-size:.8rem}.profile-tabs{max-width:900px;margin:28px auto;padding:0 24px}.tabs{display:flex;border-bottom:2px solid var(--border)}.tab{padding:12px 18px;border:0;background:none;color:var(--muted);font-weight:700;cursor:pointer}.tab.active{color:var(--primary);border-bottom:2px solid var(--primary)}.tab-content{padding-top:20px}.blogs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px}.blog-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;text-decoration:none;color:inherit}.blog-cover{width:100%;height:180px;object-fit:cover;background:var(--surface2)}.blog-content{padding:16px}.blog-title{margin:0 0 8px}.blog-excerpt{color:var(--muted)}.blog-meta{display:flex;gap:14px;color:var(--muted);font-size:.78rem}.users-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px}.user-card{background:var(--surface);border:1px solid var(--border);border-radius:15px;padding:18px;text-align:center;text-decoration:none;color:inherit}.user-card img{width:62px;height:62px;border-radius:50%;object-fit:cover}.locked-message,.empty{text-align:center;padding:60px 20px;color:var(--muted)}.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:80;align-items:center;justify-content:center;padding:20px}.modal.open{display:flex}.modal-card{width:min(420px,100%);background:var(--surface);border-radius:18px;padding:22px}.modal-card select,.modal-card textarea{width:100%;margin:10px 0;padding:11px;border:1px solid var(--border);border-radius:10px;background:var(--surface);color:var(--text)}.modal-actions{display:flex;justify-content:flex-end;gap:10px}@media(max-width:700px){.profile-header{height:130px}.profile-card{margin-top:-50px;padding:0 10px}.profile-card-inner{padding:20px}.profile-top{flex-direction:column;align-items:center;text-align:center}.profile-avatar{width:100px;height:100px;margin-top:-65px}.profile-meta,.profile-actions{justify-content:center}.profile-tabs{padding:0 10px}.blogs-grid{grid-template-columns:1fr}.more-menu{right:-5px}}</style></head>
<body><%- include('./partials/nave') %><div class="profile-header"></div><section class="profile-card"><div class="profile-card-inner"><div class="profile-top"><img class="profile-avatar" src="<%= profileUser.profileImageURL || '/imgs/default.png' %>" alt="<%= profileUser.fullName %>" onerror="this.src='/imgs/default.png'"><div class="profile-info"><h1 class="profile-name"><%= profileUser.fullName %></h1><p class="profile-handle">@<%= profileUser.email ? profileUser.email.split('@')[0] : 'user' %> · <%= profileUser.isPrivate ? '🔒 Private' : '🌐 Public' %></p><% if(profileUser.bio){%><p class="profile-bio"><%= profileUser.bio %></p><%}%><div class="profile-meta"><%if(profileUser.website){%><a href="<%=profileUser.website%>" target="_blank" rel="noopener"><i class="fas fa-link"></i> Website</a><%}%><span class="meta-item"><i class="fas fa-calendar"></i> Joined <%=new Date(profileUser.createdAt).toLocaleDateString('en-US',{month:'long',year:'numeric'})%></span></div><div class="profile-actions"><%if(isOwner){%><a class="btn outline" href="/user/profile/edit"><i class="fas fa-pen"></i> Edit Profile</a><%}else if(user){%><form action="/follow/<%=profileUser._id%>/follow" method="POST"><button class="btn <%=isFollowing?'':'primary'%>" type="submit"><i class="fas <%=isFollowing?'fa-check':'fa-plus'%>"></i> <%=isFollowing?'Following':'Follow'%></button></form><a class="btn primary" href="/messages?user=<%=profileUser._id%>"><i class="fas fa-comment-dots"></i> Message</a><div class="menu-wrap"><button class="more-btn" type="button" onclick="toggleMenu()" aria-label="Profile options"><i class="fas fa-ellipsis-h"></i></button><div class="more-menu" id="profileMenu"><button onclick="safety('restrict')"><i class="fas fa-user-shield"></i> Restrict</button><button class="danger" onclick="safety('block')"><i class="fas fa-ban"></i> Block</button><button onclick="openReport()"><i class="fas fa-flag"></i> Report</button><button onclick="alert('About this account: joined '+new Date('<%=profileUser.createdAt%>').toLocaleDateString())"><i class="fas fa-info-circle"></i> About this account</button><button onclick="safety('hide')"><i class="fas fa-eye-slash"></i> Hide their blog, photos & videos</button><button onclick="removeFollower()"><i class="fas fa-user-minus"></i> Remove follower</button><button onclick="copyProfile()"><i class="fas fa-link"></i> Copy profile URL</button><button onclick="shareProfile()"><i class="fas fa-share"></i> Share this profile</button><button onclick="showQr()"><i class="fas fa-qrcode"></i> QR code</button></div></div><%}else{%><a class="btn primary" href="/user/signin"><i class="fas fa-sign-in-alt"></i> Sign in to interact</a><%}%></div></div></div><div class="stats"><div class="stat"><strong><%=stats.blogCount%></strong><span>Posts</span></div><div class="stat"><strong><%=stats.followerCount%></strong><span>Followers</span></div><div class="stat"><strong><%=stats.followingCount%></strong><span>Following</span></div></div></div></section><section class="profile-tabs"><div class="tabs"><button class="tab active" onclick="tab('blogs',this)">Posts</button><button class="tab" onclick="tab('followers',this)">Followers</button><button class="tab" onclick="tab('following',this)">Following</button></div><div id="blogs" class="tab-content"><%if(blogs&&blogs.length){%><div class="blogs-grid"><%blogs.forEach(blog=>{%><a href="/blogs/<%=blog._id%>" class="blog-card"><%if(blog.coverImageURL){%><img class="blog-cover" src="<%=blog.coverImageURL%>" alt="<%=blog.title%>"><%}else{%><div class="blog-cover"></div><%}%><div class="blog-content"><h3 class="blog-title"><%=blog.title%></h3><%if(blog.excerpt){%><p class="blog-excerpt"><%=blog.excerpt%></p><%}%><div class="blog-meta"><span>👁 <%=blog.viewCount||0%></span><span>♥ <%=blog.likes?blog.likes.length:0%></span><span><%=new Date(blog.createdAt).toLocaleDateString()%></span></div></div></a><%})%></div><%}else{%><div class="empty">No posts yet.</div><%}%></div><div id="followers" class="tab-content" style="display:none"><%if(showFollowersList){%><div class="users-grid"><%visibleFollowers.forEach(p=>{%><a class="user-card" href="/profile/<%=p._id%>"><img src="<%=p.profileImageURL||'/imgs/default.png'%>"><strong><%=p.fullName%></strong></a><%})%></div><%}else{%><div class="locked-message"><i class="fas fa-lock fa-2x"></i><h3>Followers list is private</h3><p>Follow this user to see the list.</p></div><%}%></div><div id="following" class="tab-content" style="display:none"><%if(showFollowingList){%><div class="users-grid"><%visibleFollowing.forEach(p=>{%><a class="user-card" href="/profile/<%=p._id%>"><img src="<%=p.profileImageURL||'/imgs/default.png'%>"><strong><%=p.fullName%></strong></a><%})%></div><%}else{%><div class="locked-message"><i class="fas fa-lock fa-2x"></i><h3>Following list is private</h3><p>Follow this user to see the list.</p></div><%}%></div></section><div class="modal" id="reportModal"><div class="modal-card"><h3>Report this account</h3><select id="reportReason"><option value="spam">Spam</option><option value="harassment">Harassment</option><option value="hate">Hate or abuse</option><option value="scam">Scam</option><option value="inappropriate">Inappropriate content</option><option value="impersonation">Impersonation</option><option value="other">Other</option></select><textarea id="reportDescription" rows="4" placeholder="Optional details"></textarea><div class="modal-actions"><button class="btn outline" onclick="closeReport()">Cancel</button><button class="btn primary" onclick="submitReport()">Submit report</button></div></div></div><script>const targetId='<%=profileUser._id%>';function tab(id,b){document.querySelectorAll('.tab-content').forEach(x=>x.style.display=x.id===id?'block':'none');document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active')}function toggleMenu(){document.getElementById('profileMenu').classList.toggle('open')}document.addEventListener('click',e=>{if(!e.target.closest('.menu-wrap'))document.getElementById('profileMenu')?.classList.remove('open')});async function safety(type){if(type==='block'&&!confirm('Block this account? They will no longer be able to interact with you.'))return;if(type==='hide'&&!confirm('Hide this user\'s blog, photos and videos?'))return;try{const r=await fetch('/safety/'+targetId+'/'+type,{method:'POST',headers:{'Content-Type':'application/json'}});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Action failed');if(type==='block'){alert('User blocked.');location.href='/';}else{alert(type==='restrict'?'User restricted.':'Their content is now hidden.');toggleMenu();}}catch(e){alert(e.message)}}async function removeFollower(){if(!confirm('Remove this user as a follower?'))return;try{const r=await fetch('/follow/'+targetId+'/remove-follower',{method:'POST'});if(!r.ok)throw new Error('Unable to remove follower');alert('Follower removed.');location.reload()}catch(e){alert(e.message)}}function openReport(){document.getElementById('reportModal').classList.add('open');toggleMenu()}function closeReport(){document.getElementById('reportModal').classList.remove('open')}async function submitReport(){try{const r=await fetch('/safety/'+targetId+'/report',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reason:document.getElementById('reportReason').value,description:document.getElementById('reportDescription').value})});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to report');closeReport();alert('Report submitted. Thank you.')}catch(e){alert(e.message)}}async function copyProfile(){const url=location.origin+'/profile/'+targetId;await navigator.clipboard.writeText(url);alert('Profile URL copied.')}function shareProfile(){location.href='/messages/chatlog?share='+encodeURIComponent(targetId)}function showQr(){const url=encodeURIComponent(location.origin+'/profile/'+targetId);window.open('https://api.qrserver.com/v1/create-qr-code/?size=260x260&data='+url,'_blank','noopener')}</script></body></html>