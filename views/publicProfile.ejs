<!DOCTYPE html>
<html lang="en" data-theme="<%= (user && user.theme) || (profileUser && profileUser.theme) || 'light' %>">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title><%= profileUser.fullName %> | Blogify</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"><style>:root{--bg:#f8f9fa;--surface:#fff;--surface2:#f1f5f9;--text:#0f172a;--muted:#64748b;--border:#e2e8f0;--primary:#6366f1;--success:#10b981}*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--text)}.profile-header{height:180px;background:linear-gradient(135deg,var(--primary),#8b5cf6)}.profile-card{max-width:900px;margin:-70px auto 0;padding:0 24px;position:relative}.profile-card-inner{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:28px;box-shadow:0 14px 45px rgba(15,23,42,.1)}.profile-top{display:flex;gap:22px;align-items:flex-start}.profile-avatar{width:120px;height:120px;border-radius:50%;object-fit:cover;border:4px solid var(--surface);margin-top:-65px;background:var(--surface2)}.profile-info{flex:1}.profile-name{font-size:1.75rem;margin:0 0 4px}.profile-handle,.profile-bio,.meta-item{color:var(--muted)}.profile-bio{line-height:1.6}.profile-meta{display:flex;gap:18px;flex-wrap:wrap}.profile-meta a{color:var(--primary);text-decoration:none}.profile-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.btn{padding:10px 18px;border-radius:11px;font-weight:700;border:1px solid var(--border);display:inline-flex;align-items:center;gap:7px;text-decoration:none;cursor:pointer}.primary{background:var(--primary);color:#fff;border-color:var(--primary)}.success{background:var(--success);color:#fff;border-color:var(--success)}.outline{background:transparent;color:var(--text)}.stats{display:flex;border-top:1px solid var(--border);margin-top:24px;padding-top:20px}.stat{flex:1;text-align:center;border-right:1px solid var(--border)}.stat:last-child{border:0}.stat strong{display:block;font-size:1.35rem}.stat span{color:var(--muted);font-size:.8rem}.profile-tabs{max-width:900px;margin:28px auto;padding:0 24px}.tabs{display:flex;border-bottom:2px solid var(--border)}.tab{padding:12px 18px;border:0;background:none;color:var(--muted);font-weight:700;cursor:pointer}.tab.active{color:var(--primary);border-bottom:2px solid var(--primary)}.tab-content{padding-top:20px}.blogs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px}.blog-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;text-decoration:none;color:inherit}.blog-cover{width:100%;height:180px;object-fit:cover;background:var(--surface2)}.blog-content{padding:16px}.blog-title{margin:0 0 8px}.blog-excerpt{color:var(--muted)}.blog-meta{display:flex;gap:14px;color:var(--muted);font-size:.78rem}.users-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px}.user-card{background:var(--surface);border:1px solid var(--border);border-radius:15px;padding:18px;text-align:center;text-decoration:none;color:inherit}.user-card img{width:62px;height:62px;border-radius:50%;object-fit:cover}.locked-message,.empty{text-align:center;padding:60px 20px;color:var(--muted)}@media(max-width:700px){.profile-header{height:130px}.profile-card{margin-top:-50px;padding:0 10px}.profile-card-inner{padding:20px}.profile-top{flex-direction:column;align-items:center;text-align:center}.profile-avatar{width:100px;height:100px;margin-top:-65px}.profile-meta,.profile-actions{justify-content:center}.profile-tabs{padding:0 10px}.blogs-grid{grid-template-columns:1fr}}</style></head>
<body><%- include('./partials/nave') %><div class="profile-header"></div><section class="profile-card"><div class="profile-card-inner"><div class="profile-top"><img class="profile-avatar" src="<%= profileUser.profileImageURL || '/imgs/default.png' %>" alt="<%= profileUser.fullName %>" onerror="this.src='/imgs/default.png'"><div class="profile-info"><h1 class="profile-name"><%= profileUser.fullName %></h1><p class="profile-handle">@<%= profileUser.email ? profileUser.email.split('@')[0] : 'user' %> · <%= profileUser.isPrivate ? '🔒 Private' : '🌐 Public' %></p><% if(profileUser.bio){%><p class="profile-bio"><%= profileUser.bio %></p><%}%><div class="profile-meta"><%if(profileUser.website){%><a href="<%=profileUser.website%>" target="_blank" rel="noopener"><i class="fas fa-link"></i> Website</a><%}%><span class="meta-item"><i class="fas fa-calendar"></i> Joined <%=new Date(profileUser.createdAt).toLocaleDateString('en-US',{month:'long',year:'numeric'})%></span></div><div class="profile-actions"><%if(isOwner){%><a class="btn outline" href="/user/profile/edit"><i class="fas fa-pen"></i> Edit Profile</a><%}else if(user){%><form action="/follow/<%=profileUser._id%>/follow" method="POST"><button class="btn <%=isFollowing?'success':'primary'%>" type="submit"><i class="fas <%=isFollowing?'fa-check':'fa-plus'%>"></i> <%=isFollowing?'Following':'Follow'%></button></form><%if(!profileUser.isPrivate||isFollowing){%><a class="btn primary" href="/messages?user=<%=profileUser._id%>"><i class="fas fa-comment-dots"></i> Message</a><%}else{%><button class="btn outline" type="button" onclick="alert('Follow this private account before sending a message.')"><i class="fas fa-lock"></i> Message</button><%}%><%}else{%><a class="btn primary" href="/user/signin"><i class="fas fa-sign-in-alt"></i> Sign in to interact</a><%}%></div></div></div><div class="stats"><div class="stat"><strong><%=stats.blogCount%></strong><span>Posts</span></div><div class="stat"><strong><%=stats.followerCount%></strong><span>Followers</span></div><div class="stat"><strong><%=stats.followingCount%></strong><span>Following</span></div></div></div></section><section class="profile-tabs"><div class="tabs"><button class="tab active" onclick="tab('blogs',this)">Posts</button><button class="tab" onclick="tab('followers',this)">Followers</button><button class="tab" onclick="tab('following',this)">Following</button></div><div id="blogs" class="tab-content"><%if(blogs&&blogs.length){%><div class="blogs-grid"><%blogs.forEach(blog=>{%><a href="/blogs/<%=blog._id%>" class="blog-card"><%if(blog.coverImageURL){%><img class="blog-cover" src="<%=blog.coverImageURL%>" alt="<%=blog.title%>"><%}else{%><div class="blog-cover"></div><%}%><div class="blog-content"><h3 class="blog-title"><%=blog.title%></h3><%if(blog.excerpt){%><p class="blog-excerpt"><%=blog.excerpt%></p><%}%><div class="blog-meta"><span>👁 <%=blog.viewCount||0%></span><span>♥ <%=blog.likes?blog.likes.length:0%></span><span><%=new Date(blog.createdAt).toLocaleDateString()%></span></div></div></a><%})%></div><%}else{%><div class="empty">No posts yet.</div><%}%></div><div id="followers" class="tab-content" style="display:none"><%if(showFollowersList){%><div class="users-grid"><%visibleFollowers.forEach(p=>{%><a class="user-card" href="/profile/<%=p._id%>"><img src="<%=p.profileImageURL||'/imgs/default.png'%>"><strong><%=p.fullName%></strong></a><%})%></div><%}else{%><div class="locked-message"><i class="fas fa-lock fa-2x"></i><h3>Followers list is private</h3><p>Follow this user to see the list.</p></div><%}%></div><div id="following" class="tab-content" style="display:none"><%if(showFollowingList){%><div class="users-grid"><%visibleFollowing.forEach(p=>{%><a class="user-card" href="/profile/<%=p._id%>"><img src="<%=p.profileImageURL||'/imgs/default.png'%>"><strong><%=p.fullName%></strong></a><%})%></div><%}else{%><div class="locked-message"><i class="fas fa-lock fa-2x"></i><h3>Following list is private</h3><p>Follow this user to see the list.</p></div><%}%></div></section><script>function tab(id,b){document.querySelectorAll('.tab-content').forEach(x=>x.style.display=x.id===id?'block':'none');document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active')}</script></body></html>