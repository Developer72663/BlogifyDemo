<!doctype html><html lang="en"><head><%- include('./partials/head') %><title>Messages | Blogify</title><style>body{background:var(--page);color:var(--text)}.messages{max-width:1100px;height:calc(100vh - 80px);min-height:620px;margin:auto;padding:18px;display:grid;grid-template-columns:290px 1fr;background:var(--surface)}.list{border:1px solid var(--border);border-radius:16px 0 0 16px;overflow:auto}.list-head{padding:18px;border-bottom:1px solid var(--border)}.list-head h1{font-size:1.25rem;margin:0 0 12px;font-weight:800}.search{width:100%;padding:9px 11px;border:1px solid var(--border);border-radius:10px;background:var(--input);color:var(--text)}.conversation{display:block;width:100%;border:0;border-bottom:1px solid var(--border);background:var(--surface);color:var(--text);text-align:left;padding:13px 15px;cursor:pointer}.conversation.active{background:var(--soft)}.chat{border:1px solid var(--border);border-left:0;border-radius:0 16px 16px 0;display:grid;grid-template-rows:auto 1fr auto;min-width:0}.chat-head{padding:15px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px}.avatar{width:40px;height:40px;border-radius:50%;object-fit:cover;background:#ddd}.status{font-size:.75rem;color:var(--muted)}.msgs{padding:20px;overflow:auto;display:flex;flex-direction:column;gap:8px}.bubble{max-width:min(72%,520px);padding:10px 13px;border-radius:15px;background:var(--soft);align-self:flex-start;word-break:break-word}.bubble.mine{background:var(--primary);color:#fff;align-self:flex-end}.time{font-size:.65rem;opacity:.65;margin-top:4px}.composer{display:flex;gap:8px;padding:13px;border-top:1px solid var(--border)}.composer input{flex:1;border:1px solid var(--border);border-radius:999px;padding:11px 15px;background:var(--input);color:var(--text)}.send{border:0;border-radius:50%;width:44px;background:var(--primary);color:#fff}.empty{text-align:center;color:var(--muted);margin:auto;padding:30px}.typing{font-size:.72rem;color:var(--muted);padding:0 20px 5px}.online{width:9px;height:9px;border-radius:50%;background:#20a464;display:inline-block}@media(max-width:700px){.messages{height:calc(100vh - 65px);min-height:0;padding:8px;display:block}.list{height:100%;border-radius:14px}.chat{display:none;height:100%;border:1px solid var(--border);border-radius:14px}.messages.chat-open .list{display:none}.messages.chat-open .chat{display:grid}.bubble{max-width:85%}}</style></head><body><%- include('./partials/nave') %><main class="messages" id="messages"><section class="list"><div class="list-head"><h1>Messages</h1><input class="search" id="search" placeholder="Search conversations..."></div><div id="conversationList"><div class="empty">Loading conversations...</div></div></section><section class="chat"><header class="chat-head"><button id="back" class="btn btn-sm btn-outline-secondary d-md-none">←</button><img id="chatAvatar" class="avatar" src="/imgs/default.png"><div><strong id="chatName">Select a conversation</strong><div class="status" id="chatStatus">Start a new conversation</div></div></header><div class="msgs" id="messagesList"><div class="empty">Choose someone to start messaging.</div></div><div class="typing" id="typing"></div><form class="composer" id="composer"><input id="messageInput" autocomplete="off" maxlength="5000" placeholder="Type a message..." disabled><button class="send" disabled>➤</button></form></section></main><%- include('./partials/scripts') %><script src="/socket.io/socket.io.js"></script><script>const state={conversations:[],current:null};const root=document.getElementById('messages'),list=document.getElementById('conversationList'),msgs=document.getElementById('messagesList'),input=document.getElementById('messageInput'),send=document.querySelector('.send'),nameEl=document.getElementById('chatName'),avatar=document.getElementById('chatAvatar'),typing=document.getElementById('typing');let socket=null,typingTimer=null;function esc(s){const d=document.createElement('div');d.textContent=s||'';return d.innerHTML}function renderList(){list.innerHTML=state.conversations.length?state.conversations.map(c=>{const other=c.participants.find(p=>String(p._id)!==String('<%= user?._id %>'))||c.participants[0];return `<button class="conversation ${String(c._id)===String(state.current)?'active':''}" data-id="${c._id}"><strong>${esc(other?.fullName||'User')}</strong><div class="status">${esc(c.lastMessage?.text||'No messages yet')}</div></button>`}).join(''):'<div class="empty">No conversations yet.</div>';list.querySelectorAll('.conversation').forEach(b=>b.onclick=()=>openConversation(b.dataset.id))}async function load(){const r=await fetch('/messages');const d=await r.json();if(d.success){state.conversations=d.conversations;renderList()}}async function openConversation(id){const c=state.conversations.find(x=>String(x._id)===String(id));if(!c)return;state.current=id;renderList();const other=c.participants.find(p=>String(p._id)!==String('<%= user?._id %>'))||c.participants[0];nameEl.textContent=other?.fullName||'User';avatar.src=other?.profileImageURL||'/imgs/default.png';input.disabled=false;send.disabled=false;root.classList.add('chat-open');const r=await fetch('/messages/'+id);const d=await r.json();msgs.innerHTML=(d.messages||[]).map(renderMessage).join('');msgs.scrollTop=msgs.scrollHeight;socket?.emit('conversation:join',id);socket?.emit('message:read',{conversationId:id})}function renderMessage(m){const mine=String(m.senderId?._id||m.senderId)===String('<%= user?._id %>');return `<div class="bubble ${mine?'mine':''}">${m.deleted?'Message deleted':esc(m.text)}<div class="time">${new Date(m.createdAt).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})} ${mine?(m.status==='read'?'✓✓':m.status==='delivered'?'✓✓':'✓'):''}</div></div>`}function addMessage(m){if(state.current&&String(m.conversationId)===String(state.current)){msgs.insertAdjacentHTML('beforeend',renderMessage(m));msgs.scrollTop=msgs.scrollHeight;socket.emit('message:read',{conversationId:state.current})}load()}document.getElementById('composer').onsubmit=e=>{e.preventDefault();const text=input.value.trim();if(!text||!state.current)return;socket.emit('message:send',{conversationId:state.current,text});input.value=''};input.oninput=()=>{if(!state.current)return;socket.emit('typing:start',{conversationId:state.current});clearTimeout(typingTimer);typingTimer=setTimeout(()=>socket.emit('typing:stop',{conversationId:state.current}),700)};document.getElementById('back').onclick=()=>root.classList.remove('chat-open');(async()=>{await load();socket=io();socket.on('message:new',addMessage);socket.on('typing:start',d=>{typing.textContent=String(d.userId)!==String('<%= user?._id %>')?'Typing...':''});socket.on('typing:stop',()=>typing.textContent='');socket.on('message:read',()=>load())})().catch(console.error);</script></body></html>