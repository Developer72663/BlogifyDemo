<!doctype html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Messages | Blogify</title>
  <style>
    :root{--bg:#fff;--surface:#fff;--input:#f2f2f4;--received:#efeff1;--sent:#3797f0;--text:#111;--muted:#737373;--line:#e3e3e6;--danger:#ed4956;--online:#22b15a;--shadow:0 16px 50px rgba(0,0,0,.12)}
    html[data-theme="dark"] body,body.dark,body.dark-mode,body[data-theme="dark"]{--bg:#000;--surface:#000;--input:#171717;--received:#262626;--text:#fff;--muted:#a8a8a8;--line:#292929;--shadow:0 16px 50px rgba(0,0,0,.45)}
    *{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:var(--bg);color:var(--text)}body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;overflow:hidden}button,input,textarea{font:inherit}button{-webkit-tap-highlight-color:transparent}
    .messages-page{width:100%;height:calc(100dvh - 78px);margin-top:38px;display:flex;justify-content:center;overflow:hidden;background:var(--bg)}
    .chat-shell{width:min(1080px,100%);height:100%;display:grid;grid-template-rows:64px minmax(0,1fr) auto;background:var(--bg);overflow:hidden}
    .chat-header{height:64px;display:flex;align-items:center;gap:7px;padding:7px 10px;border-bottom:1px solid var(--line);background:var(--surface);position:relative;z-index:60}
    .icon-btn{width:42px;height:42px;border:0;border-radius:50%;display:grid;place-items:center;background:transparent;color:var(--text);cursor:pointer;flex:none;font-size:17px}.icon-btn:hover{background:var(--input)}
    .chat-user{min-width:0;flex:1;display:flex;align-items:center;gap:9px;padding:2px 5px;border-radius:12px;cursor:pointer}.chat-user:hover{background:var(--input)}
    .avatar-wrap{position:relative;flex:none}.header-avatar{width:42px;height:42px;border-radius:50%;object-fit:cover;border:1px solid var(--line);background:var(--input)}.online-dot{display:none;position:absolute;right:0;bottom:0;width:11px;height:11px;border:2px solid var(--surface);border-radius:50%;background:var(--online)}.online-dot.show{display:block}.user-copy{min-width:0}.header-name{font-size:15px;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.header-status{font-size:11px;color:var(--muted);margin-top:2px}.header-status.online{color:var(--online)}
    .header-actions{position:relative}.user-menu{display:none;position:absolute;right:0;top:48px;width:185px;padding:6px;background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);z-index:100}.user-menu.open{display:block}.user-menu button{width:100%;height:42px;border:0;border-radius:9px;background:transparent;color:var(--text);display:flex;align-items:center;gap:10px;padding:0 11px;text-align:left;font-size:13px;cursor:pointer}.user-menu button:hover{background:var(--input)}.user-menu .danger{color:var(--danger)}
    .messages-area{min-height:0;overflow-y:auto;overflow-x:hidden;padding:12px 18px 24px;display:flex;flex-direction:column;background:var(--bg);scroll-behavior:smooth;overscroll-behavior:contain;scrollbar-width:thin}.messages-area::-webkit-scrollbar{width:5px}.messages-area::-webkit-scrollbar-thumb{background:var(--line);border-radius:20px}
    .date-divider{align-self:center;margin:12px 0 10px;padding:4px 9px;border-radius:999px;background:var(--input);color:var(--muted);font-size:9px;font-weight:650}
    .message-row{width:100%;display:flex;align-items:flex-end;margin:0 0 7px}.message-row.received{justify-content:flex-start;padding-right:18px}.message-row.sent{justify-content:flex-end;padding-left:18px}.message-content{min-width:0;max-width:min(72%,560px);display:flex;flex-direction:column}.message-row.sent .message-content{align-items:flex-end}.message-row.received .message-content{align-items:flex-start}.message-avatar{width:28px;height:28px;border-radius:50%;object-fit:cover;margin-right:7px;background:var(--input);border:1px solid var(--line);flex:none}.avatar-spacer{width:35px;flex:none}.sender-name{font-size:10px;font-weight:650;color:var(--muted);margin:0 0 3px 3px;max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .message-bubble{padding:9px 12px;border-radius:18px;font-size:14px;line-height:1.45;min-height:35px;word-break:break-word;overflow-wrap:anywhere;white-space:pre-wrap;max-width:100%;cursor:pointer}.received .message-bubble{background:var(--received);color:var(--text);border-bottom-left-radius:5px}.sent .message-bubble{background:var(--sent);color:#fff;border-bottom-right-radius:5px}.message-bubble.deleted{background:var(--input)!important;color:var(--muted)!important;border:1px solid var(--line);font-style:italic;cursor:default}.message-media{display:block;max-width:min(330px,70vw);max-height:390px;border-radius:14px;object-fit:cover;margin:1px}.message-media.video{background:#000}.voice-player{display:block;width:min(285px,70vw);height:42px}.message-meta{display:flex;align-items:center;gap:4px;padding:0 3px;margin-top:3px;color:var(--muted);font-size:9px;line-height:1.2}.sent .message-meta{justify-content:flex-end}.read-status{color:#3797f0;font-weight:700}.edited{opacity:.75}.reaction-list{display:flex;gap:3px;margin-top:-1px}.sent .reaction-list{justify-content:flex-end}.reaction-badge{min-width:24px;height:21px;padding:1px 6px;border-radius:999px;background:var(--surface);border:1px solid var(--line);box-shadow:0 2px 6px rgba(0,0,0,.1);display:grid;place-items:center;font-size:12px}
    .profile-card{width:min(270px,70vw);border:1px solid var(--line);background:var(--surface);border-radius:16px;overflow:hidden}.profile-card img{width:100%;height:135px;object-fit:cover}.profile-card-body{padding:10px}.profile-card-name{font-weight:750;font-size:13px}.profile-card-bio{font-size:11px;color:var(--muted);margin-top:3px}
    .empty-state{flex:1;display:grid;place-items:center;text-align:center;padding:30px}.empty-avatar{width:76px;height:76px;border-radius:50%;object-fit:cover;border:1px solid var(--line);margin-bottom:10px}.empty-inner{max-width:300px;color:var(--muted)}.empty-inner strong{display:block;color:var(--text);font-size:15px;margin-bottom:5px}.empty-inner p{font-size:12px;line-height:1.5;margin:0}
    .typing{height:18px;padding:0 18px;color:var(--muted);font-size:10px;display:flex;align-items:center}.typing:empty{visibility:hidden}.typing-dot{width:4px;height:4px;border-radius:50%;background:var(--muted);margin:0 2px;animation:b .9s infinite alternate}@keyframes b{to{opacity:.2;transform:translateY(-2px)}}
    .attachment-preview,.reply-bar,.record-bar{display:none;align-items:center;gap:8px;padding:7px 12px;background:var(--input);border-top:1px solid var(--line)}.attachment-preview.show,.reply-bar.show,.record-bar.show{display:flex}.attachment-thumb{width:44px;height:44px;border-radius:8px;overflow:hidden;background:#111;flex:none}.attachment-thumb img,.attachment-thumb video{width:100%;height:100%;object-fit:cover}.attachment-name,.reply-copy{flex:1;min-width:0}.attachment-name{font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.reply-line{width:3px;height:30px;background:#3797f0;border-radius:4px}.reply-title{font-size:11px;font-weight:700}.reply-text{font-size:10px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.record-info{flex:1;min-width:0}.record-title{font-size:11px;font-weight:750;color:var(--danger)}.record-time{font-size:10px;color:var(--muted);margin-top:2px}.record-actions{display:flex;gap:6px}.record-action{border:0;border-radius:10px;padding:8px 11px;background:var(--surface);color:var(--text);font-size:11px;font-weight:750;cursor:pointer}.record-action.stop{color:var(--danger);background:rgba(237,73,86,.12)}.record-action.send{color:#fff;background:#3797f0}.record-action:disabled{opacity:.5;cursor:not-allowed}.cancel{border:0;background:transparent;color:var(--muted);font-size:11px;padding:7px;cursor:pointer}
    .composer{min-height:62px;padding:7px 10px max(9px,env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--surface);display:flex;align-items:flex-end;gap:6px;position:relative;z-index:50}.composer-btn{width:41px;height:41px;border:0;border-radius:50%;background:transparent;color:var(--text);display:grid;place-items:center;cursor:pointer;flex:none}.composer-btn:hover{background:var(--input)}.composer-btn.recording{color:var(--danger);background:rgba(237,73,86,.13)}.input-box{flex:1;min-width:0;min-height:41px;border:1px solid var(--line);border-radius:22px;background:var(--input);display:flex;align-items:flex-end;padding:0 10px}.message-input{width:100%;min-height:39px;max-height:110px;resize:none;border:0;outline:0;background:transparent;color:var(--text);padding:9px 2px;line-height:1.4;overflow-y:auto}.message-input::placeholder{color:var(--muted)}.send-btn{width:41px;height:41px;border:0;border-radius:50%;background:#3797f0;color:#fff;display:none;place-items:center;cursor:pointer;flex:none}.send-btn:disabled{opacity:.45}#mediaInput{display:none}
    .overlay{position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:90;opacity:0;visibility:hidden;pointer-events:none;transition:.18s}.overlay.open{opacity:1;visibility:visible;pointer-events:auto}.action-sheet{position:fixed;left:50%;bottom:10px;transform:translate(-50%,20px);width:min(450px,calc(100vw - 18px));padding:8px;background:var(--surface);border-radius:19px;box-shadow:var(--shadow);z-index:91;opacity:0;visibility:hidden;pointer-events:none;transition:.2s}.action-sheet.open{opacity:1;visibility:visible;pointer-events:auto;transform:translate(-50%,0)}.reaction-row{display:flex;gap:4px;padding-bottom:8px;border-bottom:1px solid var(--line)}.reaction-btn{flex:1;height:42px;border:0;border-radius:12px;background:var(--input);font-size:18px;cursor:pointer}.sheet-btn{width:100%;height:42px;border:0;border-radius:10px;background:transparent;color:var(--text);display:flex;align-items:center;gap:10px;padding:0 11px;text-align:left;cursor:pointer;font-size:12px;font-weight:650}.sheet-btn:hover{background:var(--input)}.sheet-btn.danger{color:var(--danger)}.sheet-cancel{justify-content:center;background:var(--input);margin-top:3px}.toast{position:fixed;left:50%;bottom:78px;transform:translate(-50%,10px);background:#222;color:#fff;padding:8px 13px;border-radius:999px;font-size:10px;opacity:0;visibility:hidden;transition:.2s;z-index:200}.toast.show{opacity:1;visibility:visible;transform:translate(-50%,0)}
    @media(max-width:699px){.messages-page{margin-top:38px;height:calc(100dvh - 38px)}.chat-shell{border-radius:0}.chat-header{height:62px;min-height:62px;padding:6px 7px}.icon-btn{width:40px;height:40px}.header-avatar{width:40px;height:40px}.messages-area{padding:12px 8px 20px}.message-row.received{padding-right:10px}.message-row.sent{padding-left:10px}.message-content{max-width:84%}.message-bubble{font-size:14px;padding:8px 11px}.action-sheet{left:0;bottom:0;width:100%;border-radius:19px 19px 0 0;padding-bottom:max(8px,env(safe-area-inset-bottom));transform:translateY(20px)}.action-sheet.open{transform:translateY(0)}.record-bar{padding:8px 10px}.record-actions{gap:4px}.record-action{padding:8px 9px}}
    @media(min-width:700px){.messages-page{margin-top:42px;height:calc(100dvh - 54px);padding:0 12px 12px}.chat-shell{border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow)}}
    @media(min-width:900px){.messages-area{padding-left:48px;padding-right:48px}.message-content{max-width:62%}}
  </style>
</head>
<body>
  
  <main class="messages-page">
    <section class="chat-shell" aria-label="Conversation">
      <header class="chat-header">
        <button class="icon-btn" id="backButton" type="button" aria-label="Back"><i class="fas fa-arrow-left"></i></button>
        <div class="chat-user" id="profileButton" role="button" tabindex="0">
          <div class="avatar-wrap"><img id="headerAvatar" class="header-avatar" src="/imgs/default.png" alt="Profile"><span id="onlineDot" class="online-dot"></span></div>
          <div class="user-copy"><div id="headerName" class="header-name">Loading…</div><div id="headerStatus" class="header-status">Message</div></div>
        </div>
        <div class="header-actions">
          <button class="icon-btn" id="menuButton" type="button" aria-label="More options"><i class="fas fa-ellipsis-v"></i></button>
          <div class="user-menu" id="userMenu">
            <button id="profileMenu" type="button"><i class="fas fa-user"></i><span>Profile</span></button>
            <button id="muteMenu" type="button"><i class="fas fa-bell-slash"></i><span id="muteText">Mute</span></button>
            <button id="blockMenu" type="button" class="danger"><i class="fas fa-ban"></i><span>Block</span></button>
          </div>
        </div>
      </header>

      <div class="messages-area" id="messagesArea" aria-live="polite">
        <div class="empty-state" id="loadingState"><div class="empty-inner"><img id="emptyAvatar" class="empty-avatar" src="/imgs/default.png" alt="Profile"><strong id="emptyName">Loading conversation…</strong><p>Getting your messages ready.</p></div></div>
      </div>
      <div class="typing" id="typingIndicator"></div>
      <div class="attachment-preview" id="attachmentPreview"><div class="attachment-thumb" id="attachmentThumb"></div><div class="attachment-name" id="attachmentName"></div><button class="cancel" id="removeAttachment" type="button">×</button></div>
      <div class="reply-bar" id="replyBar"><div class="reply-line"></div><div class="reply-copy"><div class="reply-title">Replying to message</div><div class="reply-text" id="replyText"></div></div><button class="cancel" id="cancelReply" type="button">Cancel</button></div>
      <div class="record-bar" id="recordBar">
        <div class="record-info"><div class="record-title" id="recordTitle"><i class="fas fa-microphone"></i> Recording voice message</div><div class="record-time" id="recordTime">0:00</div></div>
        <div class="record-actions"><button class="record-action stop" id="stopRecord" type="button">Stop</button><button class="record-action send" id="sendRecord" type="button" style="display:none">Send</button><button class="record-action" id="cancelRecord" type="button">Cancel</button></div>
      </div>
      <form class="composer" id="composer">
        <button class="composer-btn" id="attachmentButton" type="button" aria-label="Add photo or video"><i class="fas fa-plus"></i></button>
        <input id="mediaInput" type="file" accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime">
        <div class="input-box"><textarea id="messageInput" class="message-input" rows="1" maxlength="5000" placeholder="Message…" autocomplete="off"></textarea></div>
        <button class="composer-btn" id="voiceButton" type="button" aria-label="Record voice message"><i class="fas fa-microphone"></i></button>
        <button class="send-btn" id="sendButton" type="submit" aria-label="Send message"><i class="fas fa-paper-plane"></i></button>
      </form>
    </section>
  </main>

  <div class="overlay" id="overlay"></div>
  <div class="action-sheet" id="actionSheet">
    <div class="reaction-row"><button class="reaction-btn" data-reaction="❤️">❤️</button><button class="reaction-btn" data-reaction="😂">😂</button><button class="reaction-btn" data-reaction="😮">😮</button><button class="reaction-btn" data-reaction="😢">😢</button><button class="reaction-btn" data-reaction="👍">👍</button><button class="reaction-btn" data-reaction="🔥">🔥</button></div>
    <button class="sheet-btn" id="replyAction"><i class="fas fa-reply"></i> Reply</button>
    <button class="sheet-btn" id="copyAction"><i class="fas fa-copy"></i> Copy</button>
    <button class="sheet-btn" id="editAction"><i class="fas fa-pen"></i> Edit</button>
    <button class="sheet-btn danger" id="unsendAction"><i class="fas fa-trash"></i> Unsend</button>
    <button class="sheet-btn sheet-cancel" id="closeSheet">Cancel</button>
  </div>
  <div class="toast" id="toast"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    (()=>{
      const myId=<%- JSON.stringify(String(user?._id||'')) %>;
      const targetUserId=<%- JSON.stringify(String(targetUserId||'')) %>;
      const $=id=>document.getElementById(id);
      const area=$("messagesArea"),input=$("messageInput"),send=$("sendButton"),voice=$("voiceButton");
      const recordBar=$("recordBar"),recordTime=$("recordTime"),stopRecord=$("stopRecord"),sendRecord=$("sendRecord"),cancelRecord=$("cancelRecord"),recordTitle=$("recordTitle");
      let socket=null,conversationId=null,target=null,replyTo=null,selectedMessage=null,mediaFile=null,recording=null,recordChunks=[],recordTimer=null,recordStarted=0,recordedVoice=null,typingTimer=null;
      const defaultAvatar='/imgs/default.png';
      const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const toast=msg=>{const t=$("toast");t.textContent=msg;t.classList.add('show');clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('show'),2200)};
      const avatar=u=>u?.profileImageURL||defaultAvatar;
      const sameId=(a,b)=>String(a||'')===String(b||'');
      function dateLabel(d){const x=new Date(d),n=new Date(),y=new Date(n);y.setDate(n.getDate()-1);if(x.toDateString()===n.toDateString())return'Today';if(x.toDateString()===y.toDateString())return'Yesterday';return x.toLocaleDateString([], {day:'numeric',month:'short',year:'numeric'});}
      function timeLabel(d){return new Date(d).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});}
      function scrollBottom(){requestAnimationFrame(()=>{area.scrollTop=area.scrollHeight});}
      function setTarget(u){target=u||{};$("headerName").textContent=target.fullName||'Messages';$("emptyName").textContent=target.fullName||'Conversation';$("headerAvatar").src=avatar(target);$("emptyAvatar").src=avatar(target);$("profileMenu").onclick=()=>location.href='/profile/'+target._id;$("profileButton").onclick=()=>location.href='/profile/'+target._id;updateOnline();}
      function updateOnline(){const online=target&&target.online===true;$("onlineDot").classList.toggle('show',online);$("headerStatus").textContent=online?'Active now':'Message';$("headerStatus").classList.toggle('online',online);}
      function renderMessages(messages){area.innerHTML='';let lastDate='';if(!messages?.length){area.innerHTML='<div class="empty-state"><div class="empty-inner"><img class="empty-avatar" src="'+esc(avatar(target))+'" alt=""><strong>Start a conversation</strong><p>Send a message or hold the microphone to record a voice message.</p></div></div>';return;}messages.forEach(m=>{lastDate=renderMessage(m,true,lastDate);});scrollBottom();}
      function renderMessage(m,append=false,lastDate=''){
        const date=dateLabel(m.createdAt);if(date!==lastDate){const divider=document.createElement('div');divider.className='date-divider';divider.textContent=date;area.appendChild(divider);}
        const mine=sameId(m.senderId?._id||m.senderId,myId),row=document.createElement('div');row.className='message-row '+(mine?'sent':'received');row.dataset.id=m._id;
        if(!mine){const img=document.createElement('img');img.className='message-avatar';img.src=avatar(m.senderId);img.onerror=()=>img.src=defaultAvatar;row.appendChild(img);}else{const spacer=document.createElement('div');spacer.className='avatar-spacer';row.appendChild(spacer);}
        const content=document.createElement('div');content.className='message-content';if(!mine&&m.senderId?.fullName){const n=document.createElement('div');n.className='sender-name';n.textContent=m.senderId.fullName;content.appendChild(n);}
        const bubble=document.createElement('div');bubble.className='message-bubble'+(m.deleted?' deleted':'');bubble.dataset.messageId=m._id;
        if(m.deleted)bubble.textContent='Message deleted';
        else if(m.mediaType==='audio'&&m.mediaUrl){const audio=document.createElement('audio');audio.className='voice-player';audio.controls=true;audio.preload='metadata';audio.src=m.mediaUrl;bubble.appendChild(audio);}
        else if(m.mediaType==='image'&&m.mediaUrl){const img=document.createElement('img');img.className='message-media';img.src=m.mediaUrl;img.alt='Image';bubble.appendChild(img);if(m.text)bubble.appendChild(document.createTextNode(m.text));}
        else if(m.mediaType==='video'&&m.mediaUrl){const v=document.createElement('video');v.className='message-media video';v.controls=true;v.playsInline=true;v.src=m.mediaUrl;bubble.appendChild(v);if(m.text)bubble.appendChild(document.createTextNode(m.text));}
        else if(m.mediaType==='profile'&&m.profileShareId){bubble.innerHTML='<div class="profile-card"><img src="'+esc(avatar(m.profileShareId))+'" alt=""><div class="profile-card-body"><div class="profile-card-name">'+esc(m.profileShareId.fullName)+'</div><div class="profile-card-bio">'+esc(m.profileShareId.bio||'Blogify profile')+'</div></div></div>'+(m.text?'<div style="margin-top:7px">'+esc(m.text)+'</div>':'');}
        else bubble.textContent=m.text||'';
        content.appendChild(bubble);
        const meta=document.createElement('div');meta.className='message-meta';meta.innerHTML='<span>'+timeLabel(m.createdAt)+'</span>'+(m.edited&&!m.deleted?'<span class="edited">· edited</span>':'')+(mine?'<span class="read-status">'+(m.status==='read'||m.status==='delivered'?'✓✓':'✓')+'</span>':'');content.appendChild(meta);
        if(m.reactions?.length){const rl=document.createElement('div');rl.className='reaction-list';m.reactions.forEach(r=>{const b=document.createElement('span');b.className='reaction-badge';b.textContent=r.emoji;rl.appendChild(b)});content.appendChild(rl);}
        row.appendChild(content);area.appendChild(row);bubble.addEventListener('click',()=>{if(!m.deleted)openSheet(m)});return date;
      }
      async function load(){try{const r=await fetch('/messages/conversation',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({userId:targetUserId})});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to create conversation');conversationId=d.conversationId;setTarget(d.target);const h=await fetch('/messages/'+conversationId);const data=await h.json();if(!h.ok||!data.success)throw new Error(data.message||'Unable to load messages');setTarget(data.conversation?.participants?.find(p=>!sameId(p._id,myId))||d.target);renderMessages(data.messages||[]);initSocket();}catch(e){area.innerHTML='<div class="empty-state"><div class="empty-inner"><strong>Unable to load chat</strong><p>'+esc(e.message)+'</p><button class="sheet-btn sheet-cancel" style="margin-top:12px" onclick="location.reload()">Try again</button></div></div>';toast(e.message)}}
      function initSocket(){if(typeof window.io!=='function'){toast('Chat connection is unavailable');return;}socket=window.io({withCredentials:true});socket.on('connect',()=>{socket.emit('conversation:join',conversationId);socket.emit('message:read',{conversationId})});socket.on('connect_error',()=>toast('Chat connection unavailable'));socket.on('user:online',d=>{if(target&&sameId(d.userId,target._id)){target.online=true;updateOnline()}});socket.on('user:offline',d=>{if(target&&sameId(d.userId,target._id)){target.online=false;updateOnline()}});socket.on('typing:start',d=>{if(target&&sameId(d.userId,target._id))$("typingIndicator").innerHTML='Typing <span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>'});socket.on('typing:stop',d=>{if(target&&sameId(d.userId,target._id))$("typingIndicator").innerHTML='' });socket.on('message:new',m=>{if(!sameId(m.conversationId,conversationId))return;let lastDate='';const last=area.querySelector('.message-row:last-of-type');if(last){const meta=last.querySelector('.message-meta span');lastDate=meta?dateLabel(m.createdAt):'';}renderMessage(m,true,lastDate);scrollBottom();if(!sameId(m.senderId?._id||m.senderId,myId))socket.emit('message:read',{conversationId})});socket.on('message:edited',m=>replaceMessage(m));socket.on('message:unsent',d=>{const r=area.querySelector('[data-id="'+d.messageId+'"]');if(r){const b=r.querySelector('.message-bubble');b.className='message-bubble deleted';b.textContent='Message deleted'}});socket.on('message:reactions',d=>{const r=area.querySelector('[data-id="'+d.messageId+'"]');if(!r)return;const old=r.querySelector('.reaction-list');if(old)old.remove();if(d.reactions?.length){const rl=document.createElement('div');rl.className='reaction-list';d.reactions.forEach(x=>{const b=document.createElement('span');b.className='reaction-badge';b.textContent=x.emoji;rl.appendChild(b)});r.querySelector('.message-content').appendChild(rl)}});socket.on('message:read',d=>{if(sameId(d.conversationId,conversationId))area.querySelectorAll('.read-status').forEach(x=>x.textContent='✓✓')});socket.on('message:error',d=>toast(d.message||'Unable to send message'));socket.on('message:action:error',d=>toast(d.message||'Action failed'));}
      function replaceMessage(m){const old=area.querySelector('[data-id="'+m._id+'"]');if(!old)return;old.remove();renderMessage(m,true,'');}
      async function upload(file){const fd=new FormData();fd.append('media',file);const r=await fetch('/messages/upload',{method:'POST',body:fd});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Upload failed');return d;}
      async function sendMessage(text='',audioData=null){if(!socket||!socket.connected)return toast('Chat connection is unavailable');if(!conversationId)return;try{let url='',type='';if(audioData){const d=await upload(audioData);url=d.mediaUrl;type='audio';}else if(mediaFile){const d=await upload(mediaFile);url=d.mediaUrl;type=d.mediaType;clearAttachment();}socket.emit('message:send',{conversationId,text:text.trim(),mediaUrl:url,mediaType:type,replyTo:replyTo?replyTo._id:null});replyTo=null;$("replyBar").classList.remove('show');input.value='';resizeInput();updateSendState();}catch(e){toast(e.message)}}
      function updateSendState(){const hasText=!!input.value.trim();send.style.display=hasText||mediaFile?'grid':'none';voice.style.display=hasText||mediaFile?'none':'grid';}
      function resizeInput(){input.style.height='auto';input.style.height=Math.min(input.scrollHeight,110)+'px';}
      function clearAttachment(){mediaFile=null;$("attachmentPreview").classList.remove('show');$("attachmentThumb").innerHTML='';$("attachmentName").textContent='';$("mediaInput").value='';updateSendState();}
      function openSheet(m){selectedMessage=m;$("overlay").classList.add('open');$("actionSheet").classList.add('open');$("editAction").style.display=sameId(m.senderId?._id||m.senderId,myId)&&!m.mediaUrl?'flex':'none';$("unsendAction").style.display=sameId(m.senderId?._id||m.senderId,myId)?'flex':'none';}
      function closeSheet(){selectedMessage=null;$("overlay").classList.remove('open');$("actionSheet").classList.remove('open');}

      function resetRecordingUI(){clearInterval(recordTimer);recordTimer=null;voice.classList.remove('recording');voice.innerHTML='<i class="fas fa-microphone"></i>';stopRecord.style.display='inline-block';sendRecord.style.display='none';recordTitle.innerHTML='<i class="fas fa-microphone"></i> Recording voice message';recordBar.classList.remove('show');recordTime.textContent='0:00';}
      function showRecordedVoice(){recordBar.classList.add('show');recordTitle.innerHTML='<i class="fas fa-check-circle"></i> Voice message ready';stopRecord.style.display='none';sendRecord.style.display='inline-block';recordTime.textContent=recordedVoice?.duration||'0:00';}
      async function startRecording(){if(recording||recordedVoice)return;if(!navigator.mediaDevices?.getUserMedia||typeof MediaRecorder==='undefined')return toast('Voice recording is not supported on this browser');try{const stream=await navigator.mediaDevices.getUserMedia({audio:true});const preferred=['audio/webm;codecs=opus','audio/webm','audio/ogg'].find(x=>MediaRecorder.isTypeSupported(x));recording=preferred?new MediaRecorder(stream,{mimeType:preferred}):new MediaRecorder(stream);recordChunks=[];recordStarted=Date.now();recording.ondataavailable=e=>{if(e.data.size)recordChunks.push(e.data)};recording.onerror=()=>toast('Voice recording failed');recording.onstop=()=>{stream.getTracks().forEach(t=>t.stop());clearInterval(recordTimer);recordTimer=null;const type=recording?.mimeType||'audio/webm';const blob=new Blob(recordChunks,{type});const seconds=Math.max(1,Math.floor((Date.now()-recordStarted)/1000));const duration=Math.floor(seconds/60)+':'+String(seconds%60).padStart(2,'0');recordedVoice=blob.size?{blob,duration,type}:null;recording=null;recordStarted=0;voice.classList.remove('recording');voice.innerHTML='<i class="fas fa-microphone"></i>';if(recordedVoice)showRecordedVoice();else resetRecordingUI();};recording.start();recordBar.classList.add('show');recordTitle.innerHTML='<i class="fas fa-microphone"></i> Recording voice message';voice.classList.add('recording');voice.innerHTML='<i class="fas fa-circle"></i>';recordTimer=setInterval(()=>{const s=Math.floor((Date.now()-recordStarted)/1000);recordTime.textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0')},250);}catch(e){toast('Microphone permission is required for voice messages');}}
      function stopRecording(){if(recording&&recording.state!=='inactive')recording.stop();}
      function cancelVoice(){if(recording){recordedVoice=null;recordStarted=0;try{recording.stop()}catch(e){resetRecordingUI();}}else{recordedVoice=null;resetRecordingUI();}}
      async function sendRecordedVoice(){if(!recordedVoice)return;sendRecord.disabled=true;try{const file=new File([recordedVoice.blob],'voice-message.webm',{type:recordedVoice.type||'audio/webm'});await sendMessage('',file);recordedVoice=null;resetRecordingUI();}finally{sendRecord.disabled=false;}}

      $("composer").addEventListener('submit',e=>{e.preventDefault();if(input.value.trim()||mediaFile)sendMessage(input.value);});
      input.addEventListener('input',()=>{resizeInput();updateSendState();if(socket&&socket.connected&&conversationId){socket.emit('typing:start',{conversationId});clearTimeout(typingTimer);typingTimer=setTimeout(()=>socket.emit('typing:stop',{conversationId}),900)}});
      input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();if(input.value.trim()||mediaFile)send.click();}});
      voice.addEventListener('click',()=>{if(recording)stopRecording();else if(!recordedVoice)startRecording();});
      stopRecord.addEventListener('click',stopRecording);
      cancelRecord.addEventListener('click',cancelVoice);
      sendRecord.addEventListener('click',sendRecordedVoice);
      $("attachmentButton").addEventListener('click',()=>$("mediaInput").click());
      $("mediaInput").addEventListener('change',()=>{const f=$("mediaInput").files[0];if(!f)return;if(f.size>60*1024*1024){$("mediaInput").value='';return toast('File is too large');}mediaFile=f;$("attachmentPreview").classList.add('show');$("attachmentName").textContent=f.name;$("attachmentThumb").innerHTML=f.type.startsWith('image/')?'<img src="'+URL.createObjectURL(f)+'" alt="">':f.type.startsWith('video/')?'<video muted src="'+URL.createObjectURL(f)+'"></video>':'<i class="fas fa-file" style="display:grid;place-items:center;height:100%;color:#fff"></i>';updateSendState();});
      $("removeAttachment").addEventListener('click',clearAttachment);
      $("backButton").addEventListener('click',()=>history.length>1?history.back():location.href='/messages/chatlog');
      $("menuButton").addEventListener('click',e=>{e.stopPropagation();$("userMenu").classList.toggle('open')});
      document.addEventListener('click',e=>{if(!e.target.closest('.header-actions'))$("userMenu").classList.remove('open')});
      $("muteMenu").addEventListener('click',()=>{const key='blogify-muted-'+targetUserId;const muted=localStorage.getItem(key)==='1';localStorage.setItem(key,muted?'0':'1');$("muteText").textContent=muted?'Mute':'Unmute';toast(muted?'Notifications unmuted':'Notifications muted');});
      $("blockMenu").addEventListener('click',async()=>{if(!targetUserId)return;try{const r=await fetch('/messages/block/'+targetUserId,{method:'POST'});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to block');toast('User blocked');setTimeout(()=>location.href='/messages/chatlog',500);}catch(e){toast(e.message);}});
      $("overlay").addEventListener('click',closeSheet);$("closeSheet").addEventListener('click',closeSheet);
      document.querySelectorAll('.reaction-btn').forEach(b=>b.addEventListener('click',()=>{if(selectedMessage&&socket){socket.emit('message:react',{conversationId,messageId:selectedMessage._id,emoji:b.dataset.reaction});closeSheet();}}));
      $("replyAction").addEventListener('click',()=>{if(selectedMessage){replyTo=selectedMessage;$("replyText").textContent=selectedMessage.text||'Voice/media message';$("replyBar").classList.add('show');input.focus();}closeSheet();});
      $("copyAction").addEventListener('click',async()=>{if(selectedMessage?.text){try{await navigator.clipboard.writeText(selectedMessage.text);toast('Copied')}catch(e){toast('Unable to copy')}}closeSheet();});
      $("editAction").addEventListener('click',()=>{if(selectedMessage){input.value=selectedMessage.text||'';input.focus();resizeInput();const oldSubmit=$("composer").onsubmit;$("composer").onsubmit=e=>{e.preventDefault();if(socket&&selectedMessage)socket.emit('message:edit',{conversationId,messageId:selectedMessage._id,text:input.value});$("composer").onsubmit=oldSubmit;input.value='';updateSendState();closeSheet();}}});
      $("unsendAction").addEventListener('click',()=>{if(selectedMessage&&socket)socket.emit('message:unsend',{conversationId,messageId:selectedMessage._id});closeSheet();});
      $("cancelReply").addEventListener('click',()=>{replyTo=null;$("replyBar").classList.remove('show');});
      window.addEventListener('beforeunload',()=>{if(recording){try{recording.stop()}catch(e){}}recordedVoice=null;});
      load();
    })();
  </script>
</body>
</html>
