<!doctype html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Messages | Blogify</title>
  <style>
    :root{--bg:#fff;--surface:#fff;--input:#f3f3f5;--received:#efeff1;--sent:#3797f0;--text:#111;--muted:#737373;--line:#e5e5e7;--danger:#ed4956;--online:#20b15a}
    body.dark,body.dark-mode,body[data-theme="dark"],html.dark body,html.dark-mode body,html[data-theme="dark"] body{--bg:#000;--surface:#000;--input:#171717;--received:#262626;--text:#fff;--muted:#a8a8a8;--line:#292929}
    *{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:var(--bg);color:var(--text)}body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;overflow:hidden}button,input,textarea{font:inherit}button{-webkit-tap-highlight-color:transparent}
    .messages-page{width:100%;height:calc(100dvh - 78px);margin-top:38px;display:flex;justify-content:center;overflow:hidden}
    .chat-shell{width:min(1080px,100%);height:100%;display:grid;grid-template-rows:64px minmax(0,1fr) auto;background:var(--bg);overflow:hidden}
    @media(min-width:700px){.messages-page{margin-top:42px;height:calc(100dvh - 54px);padding:0 12px 12px}.chat-shell{border:1px solid var(--line);border-radius:18px;box-shadow:0 12px 40px rgba(0,0,0,.1)}}
    .chat-header{height:64px;display:flex;align-items:center;gap:8px;padding:7px 12px;border-bottom:1px solid var(--line);background:var(--surface);position:relative;z-index:50}
    .header-btn{width:42px;height:42px;border:0;border-radius:50%;background:transparent;color:var(--text);display:grid;place-items:center;cursor:pointer;flex:none}.header-btn:hover{background:var(--input)}
    .chat-user{flex:1;min-width:0;display:flex;align-items:center;gap:9px;padding:2px 4px;border-radius:10px;cursor:pointer}.chat-user:hover{background:var(--input)}
    .avatar-wrap{position:relative;flex:none}.header-avatar{width:42px;height:42px;border-radius:50%;object-fit:cover;background:var(--input);border:1px solid var(--line)}.online-dot{display:none;position:absolute;right:0;bottom:0;width:11px;height:11px;border:2px solid var(--bg);background:var(--online);border-radius:50%}.online-dot.show{display:block}
    .user-copy{min-width:0}.header-name{font-size:15px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.header-status{font-size:11px;color:var(--muted);margin-top:2px}.header-status.online{color:var(--online)}
    .header-actions{position:relative}.user-menu{display:none;position:absolute;right:0;top:48px;width:190px;padding:6px;background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:0 18px 50px rgba(0,0,0,.22);z-index:100}.user-menu.open{display:block}.user-menu button{width:100%;height:42px;border:0;border-radius:9px;background:transparent;color:var(--text);display:flex;align-items:center;gap:10px;text-align:left;padding:0 11px;cursor:pointer;font-size:13px}.user-menu button:hover{background:var(--input)}.user-menu .danger{color:var(--danger)}
    .messages-area{min-height:0;overflow-y:auto;overflow-x:hidden;padding:14px 18px 24px;display:flex;flex-direction:column;background:var(--bg);scroll-behavior:smooth;overscroll-behavior:contain;scrollbar-width:thin}.messages-area::-webkit-scrollbar{width:5px}.messages-area::-webkit-scrollbar-thumb{background:var(--line);border-radius:20px}
    .date-divider{align-self:center;margin:12px 0 8px;padding:4px 9px;border-radius:999px;background:var(--input);color:var(--muted);font-size:9px;font-weight:600}
    .message-row{width:100%;display:flex;align-items:flex-end;margin:0 0 5px}.message-row.received{justify-content:flex-start;padding-right:18px}.message-row.sent{justify-content:flex-end;padding-left:18px}.message-content{min-width:0;max-width:min(70%,560px);display:flex;flex-direction:column}.message-row.sent .message-content{align-items:flex-end}.message-row.received .message-content{align-items:flex-start}
    .message-avatar{width:28px;height:28px;border-radius:50%;object-fit:cover;margin-right:7px;background:var(--input);border:1px solid var(--line);flex:none}.avatar-spacer{width:35px;flex:none}
    .sender-name{font-size:10px;font-weight:600;color:var(--muted);margin:0 0 3px 3px;max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .message-bubble{padding:8px 12px;border-radius:18px;font-size:14px;line-height:1.45;min-height:35px;word-break:break-word;overflow-wrap:anywhere;white-space:pre-wrap;max-width:100%}.received .message-bubble{background:var(--received);color:var(--text);border-bottom-left-radius:5px}.sent .message-bubble{background:var(--sent);color:#fff;border-bottom-right-radius:5px}.message-bubble.deleted{background:var(--input)!important;color:var(--muted)!important;border:1px solid var(--line);font-style:italic}
    .message-media{display:block;max-width:min(330px,68vw);max-height:390px;border-radius:14px;object-fit:cover;margin:1px}.message-media.video{background:#000}.voice-player{width:min(260px,65vw);height:38px}.message-meta{display:flex;align-items:center;gap:4px;padding:0 3px;margin-top:3px;color:var(--muted);font-size:9px;line-height:1.2}.sent .message-meta{justify-content:flex-end}.read-status{color:#3797f0;font-weight:700}.edited{opacity:.75}
    .reaction-list{display:flex;gap:3px;margin-top:-1px}.sent .reaction-list{justify-content:flex-end}.reaction-badge{min-width:24px;height:21px;padding:1px 6px;border-radius:999px;background:var(--surface);border:1px solid var(--line);box-shadow:0 2px 6px rgba(0,0,0,.1);display:grid;place-items:center;font-size:12px}
    .empty-state{flex:1;display:grid;place-items:center;text-align:center;padding:30px}.empty-inner{max-width:300px;color:var(--muted)}.empty-avatar{width:74px;height:74px;border-radius:50%;object-fit:cover;border:1px solid var(--line);margin-bottom:10px}.empty-inner strong{display:block;color:var(--text);font-size:15px;margin-bottom:5px}.empty-inner p{font-size:12px;line-height:1.5;margin:0}
    .typing{height:18px;padding:0 18px;color:var(--muted);font-size:10px;display:flex;align-items:center}.typing:empty{visibility:hidden}
    .attachment-preview,.reply-bar,.edit-bar{display:none;align-items:center;gap:8px;padding:7px 12px;background:var(--input);border-top:1px solid var(--line)}.attachment-preview.show,.reply-bar.show,.edit-bar.show{display:flex}.attachment-thumb{width:44px;height:44px;border-radius:8px;overflow:hidden;background:#111;flex:none}.attachment-thumb img,.attachment-thumb video{width:100%;height:100%;object-fit:cover}.attachment-name,.reply-copy,.edit-copy{flex:1;min-width:0}.attachment-name{font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.reply-line{width:3px;height:30px;background:#3797f0;border-radius:4px}.reply-title,.edit-title{font-size:11px;font-weight:700}.reply-text,.edit-text{font-size:10px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cancel{border:0;background:transparent;color:var(--muted);font-size:11px;padding:7px;cursor:pointer}
    .composer{min-height:61px;padding:7px 10px max(9px,env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--surface);display:flex;align-items:flex-end;gap:6px;position:relative;z-index:50}.composer-btn{width:41px;height:41px;border:0;border-radius:50%;background:transparent;color:var(--text);display:grid;place-items:center;cursor:pointer;flex:none}.composer-btn:hover{background:var(--input)}.composer-btn.recording{color:var(--danger);background:rgba(237,73,86,.12)}.input-box{flex:1;min-width:0;min-height:41px;border:1px solid var(--line);border-radius:22px;background:var(--input);display:flex;align-items:flex-end;padding:0 10px}.message-input{width:100%;min-height:39px;max-height:110px;resize:none;border:0;outline:0;background:transparent;color:var(--text);padding:9px 2px;line-height:1.4;overflow-y:auto}.message-input::placeholder{color:var(--muted)}.send-btn{width:41px;height:41px;border:0;border-radius:50%;background:#3797f0;color:#fff;display:grid;place-items:center;cursor:pointer;flex:none}.send-btn:disabled{opacity:.45}#mediaInput{display:none}
    .overlay{position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:90;opacity:0;visibility:hidden;pointer-events:none;transition:.18s}.overlay.open{opacity:1;visibility:visible;pointer-events:auto}.action-sheet{position:fixed;left:50%;bottom:10px;transform:translate(-50%,20px);width:min(450px,calc(100vw - 18px));padding:8px;background:var(--surface);border-radius:19px;box-shadow:0 25px 70px rgba(0,0,0,.3);z-index:91;opacity:0;visibility:hidden;pointer-events:none;transition:.2s}.action-sheet.open{opacity:1;visibility:visible;pointer-events:auto;transform:translate(-50%,0)}.reaction-row{display:flex;gap:4px;padding-bottom:8px;border-bottom:1px solid var(--line)}.reaction-btn{flex:1;height:42px;border:0;border-radius:12px;background:var(--input);font-size:18px;cursor:pointer}.more-emojis{display:none;flex-wrap:wrap;gap:4px;padding:7px 0}.more-emojis.open{display:flex}.more-emojis button{width:39px;height:35px;border:0;border-radius:9px;background:var(--input);cursor:pointer}.sheet-btn{width:100%;height:42px;border:0;border-radius:10px;background:transparent;color:var(--text);display:flex;align-items:center;gap:10px;padding:0 11px;text-align:left;cursor:pointer;font-size:12px;font-weight:600}.sheet-btn:hover{background:var(--input)}.sheet-btn.danger{color:var(--danger)}.sheet-btn.disabled{opacity:.35;pointer-events:none}.sheet-cancel{justify-content:center;background:var(--input);margin-top:3px}
    .toast{position:fixed;left:50%;bottom:76px;transform:translate(-50%,10px);background:#222;color:#fff;padding:8px 13px;border-radius:999px;font-size:10px;opacity:0;visibility:hidden;transition:.2s;z-index:200}.toast.show{opacity:1;visibility:visible;transform:translate(-50%,0)}
    @media(max-width:699px){.messages-page{margin-top:38px;height:calc(100dvh - 38px)}.chat-shell{border-radius:0}.chat-header{height:62px;min-height:62px;padding:6px 7px}.header-btn{width:40px;height:40px}.header-avatar{width:40px;height:40px}.messages-area{padding:12px 8px 20px}.message-row.received{padding-right:10px}.message-row.sent{padding-left:10px}.message-content{max-width:82%}.message-bubble{font-size:14px;padding:8px 11px}.action-sheet{left:0;bottom:0;width:100%;border-radius:19px 19px 0 0;padding-bottom:max(8px,env(safe-area-inset-bottom));transform:translateY(20px)}.action-sheet.open{transform:translateY(0)}}
    @media(min-width:900px){.messages-area{padding-left:48px;padding-right:48px}.message-content{max-width:62%}}
  </style>
</head>
<body>
  <%- include('./partials/nave') %>
  <main class="messages-page">
    <section class="chat-shell" aria-label="Conversation">
      <header class="chat-header">
        <button type="button" class="header-btn" id="backButton" aria-label="Back"><i class="fas fa-arrow-left"></i></button>
        <div class="chat-user" id="profileButton" role="button" tabindex="0">
          <div class="avatar-wrap"><img class="header-avatar" id="headerAvatar" src="/imgs/default.png" alt="Profile"><span class="online-dot" id="onlineDot"></span></div>
          <div class="user-copy"><div class="header-name" id="headerName">Loading…</div><div class="header-status" id="headerStatus">Message</div></div>
        </div>
        <div class="header-actions">
          <button type="button" class="header-btn" id="menuButton" aria-label="More options"><i class="fas fa-ellipsis-v"></i></button>
          <div class="user-menu" id="userMenu">
            <button type="button" id="profileMenu"><i class="fas fa-user"></i><span>Profile</span></button>
            <button type="button" id="muteMenu"><i class="fas fa-bell-slash"></i><span id="muteText">Mute</span></button>
            <button type="button" class="danger" id="blockMenu"><i class="fas fa-ban"></i><span>Block</span></button>
          </div>
        </div>
      </header>

      <div class="messages-area" id="messagesArea" aria-live="polite">
        <div class="empty-state"><div class="empty-inner"><img class="empty-avatar" id="emptyAvatar" src="/imgs/default.png" alt="Profile"><strong id="emptyName">Loading conversation…</strong><p>Please wait while your messages load.</p></div></div>
      </div>
      <div class="typing" id="typingIndicator"></div>
      <div class="attachment-preview" id="attachmentPreview"><div class="attachment-thumb" id="attachmentThumb"></div><div class="attachment-name" id="attachmentName"></div><button type="button" class="cancel" id="removeAttachment">×</button></div>
      <div class="reply-bar" id="replyBar"><div class="reply-line"></div><div class="reply-copy"><div class="reply-title">Replying to message</div><div class="reply-text" id="replyText"></div></div><button type="button" class="cancel" id="cancelReply">Cancel</button></div>
      <div class="edit-bar" id="editBar"><div class="reply-line"></div><div class="edit-copy"><div class="edit-title">Editing message</div><div class="edit-text" id="editText"></div></div><button type="button" class="cancel" id="cancelEdit">Cancel</button></div>
      <form class="composer" id="composer">
        <button type="button" class="composer-btn" id="attachmentButton" aria-label="Add photo or video"><i class="fas fa-plus"></i></button>
        <input type="file" id="mediaInput" accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime">
        <div class="input-box"><textarea id="messageInput" class="message-input" rows="1" maxlength="5000" placeholder="Message…" autocomplete="off"></textarea></div>
        <button type="button" class="composer-btn" id="voiceButton" aria-label="Record voice"><i class="fas fa-microphone"></i></button>
        <button type="submit" class="send-btn" id="sendButton" aria-label="Send"><i class="fas fa-paper-plane"></i></button>
      </form>
    </section>
  </main>

  <div class="overlay" id="actionOverlay"></div>
  <div class="action-sheet" id="actionSheet">
    <div class="reaction-row"><button class="reaction-btn" data-reaction="❤️">❤️</button><button class="reaction-btn" data-reaction="😂">😂</button><button class="reaction-btn" data-reaction="😮">😮</button><button class="reaction-btn" data-reaction="😢">😢</button><button class="reaction-btn" data-reaction="👍">👍</button><button class="reaction-btn" id="moreEmojiButton">＋</button></div>
    <div class="more-emojis" id="moreEmojis"><button data-reaction="😍">😍</button><button data-reaction="🔥">🔥</button><button data-reaction="👏">👏</button><button data-reaction="🙏">🙏</button><button data-reaction="🎉">🎉</button><button data-reaction="💯">💯</button><button data-reaction="😡">😡</button><button data-reaction="🤣">🤣</button></div>
    <button type="button" class="sheet-btn" id="replyAction"><i class="fas fa-reply"></i> Reply</button>
    <button type="button" class="sheet-btn" id="forwardAction"><i class="fas fa-share"></i> Forward</button>
    <button type="button" class="sheet-btn" id="editAction"><i class="fas fa-pen"></i> Edit <small id="editCountdown"></small></button>
    <button type="button" class="sheet-btn" id="copyAction"><i class="far fa-copy"></i> Copy</button>
    <button type="button" class="sheet-btn danger" id="unsendAction"><i class="fas fa-trash-alt"></i> Unsend</button>
    <button type="button" class="sheet-btn sheet-cancel" id="closeActionSheet">Cancel</button>
  </div>
  <div class="toast" id="chatToast"></div>

  <%- include('./partials/scripts') %>
  <script src="/socket.io/socket.io.js"></script>
  <script>
  (()=>{
    'use strict';
    const CURRENT_USER_ID='<%= user._id %>';
    const TARGET_USER_ID='<%= targetUserId %>';
    const EDIT_WINDOW=60000;
    let conversationId=null,targetUser=null,socket=null,messages=[],activeMessageId=null,editingMessageId=null,replyingMessageId=null,selectedFile=null,typingTimer=null,longPressTimer=null,editTimer=null,mediaRecorder=null,voiceChunks=[],recording=false;
    const $=id=>document.getElementById(id);
    const escapeHtml=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
    const imageUrl=v=>v&&String(v).trim()?String(v):'/imgs/default.png';
    const api=(url,options={})=>{const headers={Accept:'application/json',...(options.headers||{})};if(options.body&&!(options.body instanceof FormData))headers['Content-Type']='application/json';return fetch(url,{credentials:'same-origin',...options,headers})};
    const messageTime=v=>v?new Date(v).toLocaleTimeString([],{hour:'numeric',minute:'2-digit'}):'';
    const dateKey=v=>{const d=new Date(v);return [d.getFullYear(),d.getMonth(),d.getDate()].join('-')};
    const dateLabel=v=>new Date(v).toLocaleDateString([],{day:'numeric',month:'short',year:'numeric'});
    const isMine=m=>String(m.senderId?._id||m.senderId)===String(CURRENT_USER_ID);
    const canEdit=m=>!!m&&!m.deleted&&isMine(m)&&(Date.now()-new Date(m.createdAt).getTime()<=EDIT_WINDOW);
    const editRemaining=m=>Math.max(0,EDIT_WINDOW-(Date.now()-new Date(m.createdAt).getTime()));
    function toast(text){const t=$('chatToast');t.textContent=text;t.classList.add('show');clearTimeout(window.__blogifyToast);window.__blogifyToast=setTimeout(()=>t.classList.remove('show'),2200)}
    function scrollBottom(smooth=false){requestAnimationFrame(()=>{$('messagesArea').scrollTo({top:$('messagesArea').scrollHeight,behavior:smooth?'smooth':'auto'})})}
    function updateProfile(){if(!targetUser)return;const name=targetUser.fullName||'User',avatar=imageUrl(targetUser.profileImageURL);$('headerName').textContent=name;$('headerAvatar').src=avatar;$('emptyName').textContent=name;$('emptyAvatar').src=avatar;$('headerAvatar').onerror=()=>$('headerAvatar').src='/imgs/default.png';$('emptyAvatar').onerror=()=>$('emptyAvatar').src='/imgs/default.png';$('headerStatus').textContent=targetUser.isPrivate?'Private account':'Message'}
    function openProfile(){location.href='/user/profile/'+encodeURIComponent(TARGET_USER_ID)}
    function renderReactions(m){if(!Array.isArray(m.reactions)||!m.reactions.length)return '';const c={};m.reactions.forEach(r=>c[r.emoji]=(c[r.emoji]||0)+1);return '<div class="reaction-list">'+Object.entries(c).map(([e,n])=>'<span class="reaction-badge">'+escapeHtml(e)+(n>1?'<small>'+n+'</small>':'')+'</span>').join('')+'</div>'}
    function createMessageElement(m){const mine=isMine(m),deleted=!!m.deleted,row=document.createElement('div');row.className='message-row '+(mine?'sent':'received');row.dataset.messageId=m._id;const avatar=!mine?'<img class="message-avatar" src="'+escapeHtml(imageUrl(m.senderId?.profileImageURL||targetUser?.profileImageURL))+'" alt="" loading="lazy">':'<div class="avatar-spacer"></div>';let media='';if(!deleted&&m.mediaUrl){if(m.mediaType==='image')media='<img class="message-media" src="'+escapeHtml(m.mediaUrl)+'" alt="Photo" loading="lazy">';else if(m.mediaType==='video')media='<video class="message-media video" src="'+escapeHtml(m.mediaUrl)+'" controls playsinline preload="metadata"></video>';else if(m.mediaType==='audio')media='<audio class="voice-player" controls><source src="'+escapeHtml(m.mediaUrl)+'"></audio>'}const sender=!mine&&!deleted?'<div class="sender-name">'+escapeHtml(m.senderId?.fullName||targetUser?.fullName||'User')+'</div>':'';const text=deleted?'Message unsent':(m.text||'');const edited=m.edited&&!deleted?'<span class="edited">edited</span>':'';const status=mine&&!deleted?'<span class="read-status">'+(m.status==='read'||m.status==='delivered'?'✓✓':'✓')+'</span>':'';row.innerHTML=(!mine?avatar:'')+'<div class="message-content">'+sender+'<div class="message-bubble '+(deleted?'deleted':'')+'">'+media+(text?'<div>'+escapeHtml(text)+edited+'</div>':'')+'</div><div class="message-meta"><span>'+messageTime(m.createdAt)+'</span>'+status+'</div>'+renderReactions(m)+'</div>'+(mine?avatar:'');bindGesture(row);return row}
    function renderMessages(){const box=$('messagesArea');box.innerHTML='';if(!messages.length){box.innerHTML='<div class="empty-state"><div class="empty-inner"><img class="empty-avatar" src="'+escapeHtml(imageUrl(targetUser?.profileImageURL))+'" alt=""><strong>'+escapeHtml(targetUser?.fullName||'User')+'</strong><p>Start a conversation by sending a message.</p></div></div>';return}let prev=null;messages.forEach(m=>{const d=dateKey(m.createdAt);if(d!==prev){const divider=document.createElement('div');divider.className='date-divider';divider.textContent=dateLabel(m.createdAt);box.appendChild(divider);prev=d}box.appendChild(createMessageElement(m))});scrollBottom(false)}
    function addMessage(m){const box=$('messagesArea');const empty=box.querySelector('.empty-state');if(empty)empty.remove();const last=messages[messages.length-1];if(!last||dateKey(last.createdAt)!==dateKey(m.createdAt)){const d=document.createElement('div');d.className='date-divider';d.textContent=dateLabel(m.createdAt);box.appendChild(d)}messages.push(m);box.appendChild(createMessageElement(m));scrollBottom(true);socket?.emit('message:read',{conversationId})}
    function replaceMessage(m){const old=document.querySelector('[data-message-id="'+CSS.escape(String(m._id))+'"]');if(old)old.replaceWith(createMessageElement(m))}
    function bindGesture(row){const bubble=row.querySelector('.message-bubble');if(!bubble)return;bubble.addEventListener('dblclick',()=>react(activeMessageId=row.dataset.messageId,'❤️'));const start=e=>{if(e.target.closest('video,audio'))return;clearTimeout(longPressTimer);longPressTimer=setTimeout(()=>openSheet(row.dataset.messageId),520)};const cancel=()=>clearTimeout(longPressTimer);bubble.addEventListener('pointerdown',start);bubble.addEventListener('pointerup',cancel);bubble.addEventListener('pointercancel',cancel);bubble.addEventListener('pointerleave',cancel);bubble.addEventListener('contextmenu',e=>{e.preventDefault();openSheet(row.dataset.messageId)})}
    function react(id,emoji){if(!socket||!conversationId)return;socket.emit('message:react',{conversationId,messageId:id,emoji});closeSheet()}
    function openSheet(id){const m=messages.find(x=>String(x._id)===String(id));if(!m)return;activeMessageId=id;const editable=canEdit(m);$('editAction').classList.toggle('disabled',!editable);$('editCountdown').textContent=editable?Math.ceil(editRemaining(m)/1000)+'s':'';$('actionOverlay').classList.add('open');$('actionSheet').classList.add('open')}
    function closeSheet(){activeMessageId=null;$('actionOverlay').classList.remove('open');$('actionSheet').classList.remove('open');$('moreEmojis').classList.remove('open');document.body.style.overflow=''}
    function active(){return messages.find(m=>String(m._id)===String(activeMessageId))}
    function startReply(){const m=active();if(!m){closeSheet();return}replyingMessageId=m._id;$('replyText').textContent=m.text||'Media message';$('replyBar').classList.add('show');$('messageInput').focus();closeSheet()}
    function cancelReply(){replyingMessageId=null;$('replyBar').classList.remove('show');$('replyText').textContent=''}
    function startEdit(){const m=active();if(!m||!canEdit(m)){toast('You can edit a message for 1 minute.');closeSheet();return}editingMessageId=m._id;$('messageInput').value=m.text||'';$('editText').textContent=m.text||'Empty message';$('editBar').classList.add('show');$('messageInput').focus();resizeInput();closeSheet();updateEditTimer()}
    function cancelEdit(){editingMessageId=null;clearTimeout(editTimer);$('editBar').classList.remove('show');$('editText').textContent=''}
    function updateEditTimer(){clearTimeout(editTimer);if(!editingMessageId)return;const m=messages.find(x=>String(x._id)===String(editingMessageId));if(!m||editRemaining(m)<=0){cancelEdit();return}editTimer=setTimeout(updateEditTimer,1000)}
    function submitEdit(){const text=$('messageInput').value.trim();if(!editingMessageId||!text)return;if(!socket)return toast('Chat connection unavailable.');socket.emit('message:edit',{conversationId,messageId:editingMessageId,text});cancelEdit();$('messageInput').value='';resizeInput()}
    function unsend(){const m=active();if(!m){closeSheet();return}if(!isMine(m)){toast('You can only unsend your own messages.');closeSheet();return}if(confirm('Unsend this message for everyone?'))socket?.emit('message:unsend',{conversationId,messageId:m._id});closeSheet()}
    async function copyMessage(){const m=active();if(!m||m.deleted){closeSheet();return}try{await navigator.clipboard.writeText(m.text||'');toast('Message copied.')}catch(e){toast('Unable to copy message.')}closeSheet()}
    function forwardMessage(){const m=active();if(!m){closeSheet();return}toast('Forward feature is ready for your chat selector.');closeSheet()}
    async function sendMessage(){if(editingMessageId){submitEdit();return}const text=$('messageInput').value.trim();if(!text&&!selectedFile)return;if(!socket||!conversationId)return toast('Chat is still loading.');$('sendButton').disabled=true;try{let mediaUrl='',mediaType='';if(selectedFile){const fd=new FormData();fd.append('media',selectedFile);const r=await api('/messages/upload',{method:'POST',body:fd}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to upload media.');mediaUrl=d.mediaUrl;mediaType=d.mediaType}socket.emit('message:send',{conversationId,text,mediaUrl,mediaType,replyTo:replyingMessageId||null});$('messageInput').value='';cancelReply();clearAttachment();resizeInput()}catch(e){toast(e.message||'Unable to send message.')}finally{$('sendButton').disabled=false}}
    function resizeInput(){const x=$('messageInput');x.style.height='auto';x.style.height=Math.min(x.scrollHeight,110)+'px'}
    function clearAttachment(){$('mediaInput').value='';selectedFile=null;$('attachmentPreview').classList.remove('show');$('attachmentThumb').innerHTML='';$('attachmentName').textContent=''}
    function previewAttachment(file){if(!file)return;selectedFile=file;const url=URL.createObjectURL(file);$('attachmentName').textContent=file.name;$('attachmentThumb').innerHTML=file.type.startsWith('video/')?'<video src="'+url+'" muted></video>':'<img src="'+url+'" alt="">';$('attachmentPreview').classList.add('show')}
    async function toggleVoice(){if(recording){mediaRecorder?.stop();return}if(!navigator.mediaDevices?.getUserMedia)return toast('Voice recording is not supported by this browser.');try{const stream=await navigator.mediaDevices.getUserMedia({audio:true});voiceChunks=[];mediaRecorder=new MediaRecorder(stream);mediaRecorder.ondataavailable=e=>{if(e.data.size)voiceChunks.push(e.data)};mediaRecorder.onstop=async()=>{stream.getTracks().forEach(t=>t.stop());const blob=new Blob(voiceChunks,{type:mediaRecorder.mimeType||'audio/webm'});try{const fd=new FormData();fd.append('media',blob,'voice-message.webm');const r=await api('/messages/upload',{method:'POST',body:fd}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Voice upload failed.');socket?.emit('message:send',{conversationId,text:'',mediaUrl:d.mediaUrl,mediaType:'audio'})}catch(e){toast(e.message)}};mediaRecorder.start();recording=true;$('voiceButton').classList.add('recording');$('voiceButton').innerHTML='<i class="fas fa-stop"></i>';toast('Recording… tap again to send.')}catch(e){toast('Microphone permission was denied.')}}
    function connectSocket(){if(typeof window.io!=='function'){toast('Real-time chat connection unavailable.');return}socket=window.io({transports:['websocket','polling']});socket.on('connect',()=>{if(conversationId){socket.emit('conversation:join',conversationId);socket.emit('message:read',{conversationId})}});socket.on('connect_error',()=>toast('Chat connection failed. Retrying…'));socket.on('user:online',d=>{if(String(d.userId)===String(TARGET_USER_ID)){$('headerStatus').textContent='Active now';$('headerStatus').classList.add('online');$('onlineDot').classList.add('show')}});socket.on('user:offline',d=>{if(String(d.userId)===String(TARGET_USER_ID)){$('headerStatus').textContent=targetUser?.isPrivate?'Private account':'Message';$('headerStatus').classList.remove('online');$('onlineDot').classList.remove('show')}});socket.on('typing:start',d=>{if(String(d.userId)===String(TARGET_USER_ID))$('typingIndicator').textContent=(targetUser?.fullName||'User')+' is typing…'});socket.on('typing:stop',d=>{if(String(d.userId)===String(TARGET_USER_ID))$('typingIndicator').textContent=''});socket.on('message:new',m=>{if(String(m.conversationId)===String(conversationId))addMessage(m)});socket.on('message:edited',m=>{const i=messages.findIndex(x=>String(x._id)===String(m._id));if(i>=0)messages[i]=m;replaceMessage(m)});socket.on('message:unsent',d=>{const m=messages.find(x=>String(x._id)===String(d.messageId));if(m){m.deleted=true;m.text='';m.mediaUrl='';replaceMessage(m)}});socket.on('message:reactions',d=>{const m=messages.find(x=>String(x._id)===String(d.messageId));if(m){m.reactions=d.reactions||[];replaceMessage(m)}});socket.on('message:read',d=>{if(String(d.conversationId)!==String(conversationId))return;messages.filter(isMine).forEach(m=>m.status='read');document.querySelectorAll('.sent .read-status').forEach(s=>s.textContent='✓✓')});socket.on('message:error',d=>toast(d.message||'Unable to send message.'));socket.on('message:action:error',d=>toast(d.message||'Unable to update message.'))}
    async function initialize(){try{const r=await api('/messages/conversation',{method:'POST',body:JSON.stringify({userId:TARGET_USER_ID})}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to open conversation.');conversationId=d.conversationId;targetUser=d.target;updateProfile();const h=await api('/messages/'+encodeURIComponent(conversationId)),data=await h.json();if(!h.ok||!data.success)throw new Error(data.message||'Unable to load messages.');messages=data.messages||[];renderMessages();connectSocket()}catch(e){$('messagesArea').innerHTML='<div class="empty-state"><div class="empty-inner"><i class="fas fa-exclamation-circle" style="font-size:34px;margin-bottom:10px"></i><strong>Unable to load chat</strong><p>'+escapeHtml(e.message||'Something went wrong.')+'</p><button type="button" class="sheet-btn sheet-cancel" style="margin-top:12px" onclick="location.reload()">Try again</button></div></div>'}}
    $('backButton').onclick=()=>history.length>1?history.back():location.href='/messages/chatlog';$('profileButton').onclick=openProfile;$('profileButton').onkeydown=e=>{if(e.key==='Enter'||e.key===' ')openProfile()};$('menuButton').onclick=e=>{e.stopPropagation();$('userMenu').classList.toggle('open')};$('profileMenu').onclick=openProfile;$('muteMenu').onclick=()=>{$('muteText').textContent=$('muteText').textContent==='Unmute'?'Mute':'Unmute';toast($('muteText').textContent==='Unmute'?'Notifications muted.':'Notifications unmuted.');$('userMenu').classList.remove('open')};$('blockMenu').onclick=async()=>{if(!confirm('Block this user?'))return;try{const r=await api('/messages/block/'+encodeURIComponent(TARGET_USER_ID),{method:'POST'}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to block user.');toast(d.message||'User blocked.');setTimeout(()=>location.href='/messages/chatlog',700)}catch(e){toast(e.message)}};
    $('attachmentButton').onclick=()=>$('mediaInput').click();$('mediaInput').onchange=e=>previewAttachment(e.target.files?.[0]);$('removeAttachment').onclick=clearAttachment;$('composer').onsubmit=e=>{e.preventDefault();sendMessage()};$('messageInput').oninput=()=>{resizeInput();if(socket&&conversationId){socket.emit('typing:start',{conversationId});clearTimeout(typingTimer);typingTimer=setTimeout(()=>socket.emit('typing:stop',{conversationId}),900)}};$('messageInput').onkeydown=e=>{if(e.key==='Enter'&&!e.shiftKey&&window.innerWidth>650){e.preventDefault();sendMessage()}};$('voiceButton').onclick=toggleVoice;$('cancelReply').onclick=cancelReply;$('cancelEdit').onclick=cancelEdit;$('replyAction').onclick=startReply;$('forwardAction').onclick=forwardMessage;$('editAction').onclick=startEdit;$('copyAction').onclick=copyMessage;$('unsendAction').onclick=unsend;$('moreEmojiButton').onclick=()=>$('moreEmojis').classList.toggle('open');document.querySelectorAll('[data-reaction]').forEach(b=>b.onclick=()=>{if(activeMessageId)react(activeMessageId,b.dataset.reaction)});$('actionOverlay').onclick=closeSheet;$('closeActionSheet').onclick=closeSheet;document.addEventListener('click',e=>{if(!e.target.closest('.header-actions'))$('userMenu').classList.remove('open');if(!e.target.closest('.action-sheet')&&!e.target.closest('.message-bubble'))closeSheet()});window.addEventListener('resize',()=>setTimeout(()=>scrollBottom(false),100));initialize();
  })();
  </script>
</body>
</html>
