```html
<!doctype html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Messages | Blogify</title>

  <style>
    :root{
      --bg:#fff;
      --soft:#f5f5f5;
      --line:#e9e9e9;
      --text:#111;
      --muted:#737373;
      --accent:#635bff;
      --danger:#ed4956;
      --green:#31a24c;
    }

    *{box-sizing:border-box}

    html,body{
      margin:0;
      width:100%;
      height:100%;
      background:var(--bg);
      color:var(--text);
      font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    }

    body{overflow:hidden}

    button,input,textarea{font:inherit}
    button{-webkit-tap-highlight-color:transparent}

    .page{
      height:calc(100dvh - 70px);
      display:flex;
      justify-content:center;
      background:#fff;
    }

    .chat{
      width:100%;
      max-width:1080px;
      height:100%;
      display:grid;
      grid-template-rows:64px minmax(0,1fr) auto;
      background:#fff;
      overflow:hidden;
    }

    @media(min-width:900px){
      .page{padding:12px}
      .chat{
        border:1px solid var(--line);
        border-radius:16px;
        overflow:hidden;
      }
    }

    /* HEADER */

    .topbar{
      height:64px;
      display:flex;
      align-items:center;
      gap:8px;
      padding:7px 12px;
      border-bottom:1px solid var(--line);
      background:#fff;
      z-index:20;
    }

    .icon-btn{
      width:42px;
      height:42px;
      border:0;
      border-radius:50%;
      background:transparent;
      display:grid;
      place-items:center;
      cursor:pointer;
      color:var(--text);
      flex:none;
    }

    .icon-btn:hover{background:#f5f5f5}

    .person{
      flex:1;
      min-width:0;
      display:flex;
      align-items:center;
      gap:10px;
      cursor:pointer;
    }

    .avatar{
      width:42px;
      height:42px;
      border-radius:50%;
      object-fit:cover;
      background:#eee;
      border:1px solid #ddd;
      flex:none;
    }

    .person-copy{
      min-width:0;
    }

    .person-name{
      font-size:.95rem;
      font-weight:750;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .person-status{
      margin-top:2px;
      color:var(--muted);
      font-size:.68rem;
    }

    .person-status.online{color:var(--green)}

    .top-actions{
      position:relative;
      display:flex;
      align-items:center;
    }

    .top-menu{
      position:absolute;
      top:48px;
      right:0;
      width:215px;
      display:none;
      padding:5px;
      background:#fff;
      border:1px solid var(--line);
      border-radius:12px;
      box-shadow:0 15px 40px rgba(0,0,0,.15);
      z-index:80;
    }

    .top-menu.open{display:block}

    .top-menu button{
      width:100%;
      border:0;
      background:transparent;
      padding:11px 12px;
      border-radius:8px;
      text-align:left;
      display:flex;
      align-items:center;
      gap:10px;
      cursor:pointer;
      font-weight:650;
    }

    .top-menu button:hover{background:#f5f5f5}
    .top-menu .danger{color:var(--danger)}

    /* MESSAGE AREA */

    .messages{
      min-height:0;
      overflow-y:auto;
      overflow-x:hidden;
      padding:20px 14px 30px;
      background:#fff;
      display:flex;
      flex-direction:column;
      gap:3px;
      overscroll-behavior:contain;
      scroll-behavior:smooth;
      -webkit-overflow-scrolling:touch;
    }

    .messages::-webkit-scrollbar{width:6px}
    .messages::-webkit-scrollbar-thumb{
      background:#d5d5d5;
      border-radius:20px;
    }

    @media(min-width:900px){
      .messages{
        padding-left:clamp(30px,7vw,90px);
        padding-right:clamp(30px,7vw,90px);
      }
    }

    .welcome{
      margin:auto;
      text-align:center;
      width:min(320px,90%);
      color:var(--muted);
      padding:30px 10px;
    }

    .welcome img{
      width:78px;
      height:78px;
      border-radius:50%;
      object-fit:cover;
      margin-bottom:10px;
    }

    .welcome strong{
      display:block;
      color:var(--text);
      font-size:1.05rem;
      margin-bottom:4px;
    }

    .welcome p{
      margin:0;
      font-size:.8rem;
      line-height:1.5;
    }

    .date-divider{
      align-self:center;
      margin:14px 0 8px;
      color:#8a8a8a;
      font-size:.63rem;
      font-weight:650;
    }

    /* SENDER */

    .sender-info{
      display:flex;
      align-items:center;
      gap:7px;
      margin:8px 0 4px 4px;
      max-width:300px;
    }

    .sender-avatar{
      width:25px;
      height:25px;
      border-radius:50%;
      object-fit:cover;
      background:#eee;
      flex:none;
    }

    .sender-name{
      font-size:.68rem;
      color:#555;
      font-weight:700;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    /* ROW */

    .row{
      width:100%;
      display:flex;
      align-items:flex-end;
      gap:7px;
      position:relative;
    }

    .row.mine{
      justify-content:flex-end;
    }

    .row-avatar{
      width:28px;
      height:28px;
      border-radius:50%;
      object-fit:cover;
      flex:none;
      margin-bottom:2px;
    }

    .row.mine .row-avatar{
      display:none;
    }

    .bubble-wrap{
      max-width:min(72%,560px);
      min-width:0;
    }

    .bubble{
      position:relative;
      width:max-content;
      max-width:100%;
      padding:8px 12px;
      background:#efefef;
      color:#111;
      border-radius:18px;
      line-height:1.42;
      word-break:break-word;
      user-select:none;
      -webkit-user-select:none;
      touch-action:manipulation;
    }

    .row:not(.mine) .bubble{
      border-bottom-left-radius:5px;
    }

    .row.mine .bubble{
      background:#635bff;
      color:#fff;
      border-bottom-right-radius:5px;
    }

    .bubble.deleted{
      background:#f1f1f1!important;
      color:#888!important;
      font-style:italic;
    }

    .text{
      white-space:pre-wrap;
      font-size:.9rem;
    }

    .edited{
      margin-left:4px;
      font-size:.58rem;
      opacity:.6;
    }

    .meta{
      display:flex;
      justify-content:flex-end;
      align-items:center;
      gap:3px;
      margin-top:3px;
      font-size:.56rem;
      opacity:.6;
      white-space:nowrap;
    }

    .status.read{
      color:#d8faff;
    }

    .media{
      display:block;
      width:min(300px,70vw);
      max-height:390px;
      object-fit:cover;
      border-radius:13px;
      background:#111;
      margin-bottom:4px;
    }

    .media.video{
      background:#000;
    }

    /* PROFILE SHARED MESSAGE */

    .profile-share{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:220px;
      color:inherit;
      text-decoration:none;
    }

    .profile-share-avatar{
      width:48px;
      height:48px;
      border-radius:50%;
      object-fit:cover;
      background:#ddd;
      flex:none;
    }

    .profile-share-name{
      font-weight:750;
      font-size:.88rem;
    }

    .profile-share-label{
      font-size:.65rem;
      opacity:.7;
      margin-top:2px;
    }

    /* REACTIONS */

    .reaction-badges{
      display:flex;
      gap:3px;
      position:absolute;
      left:7px;
      bottom:-10px;
      z-index:4;
    }

    .row.mine .reaction-badges{
      left:auto;
      right:7px;
    }

    .reaction-badge{
      min-width:25px;
      height:22px;
      padding:1px 6px;
      border-radius:999px;
      border:1px solid #ddd;
      background:#fff;
      color:#222;
      display:grid;
      place-items:center;
      font-size:.73rem;
      box-shadow:0 2px 8px rgba(0,0,0,.1);
    }

    /* TYPING */

    .typing{
      height:20px;
      padding:0 16px;
      color:var(--muted);
      font-size:.65rem;
      background:#fff;
    }

    .typing:empty{visibility:hidden}

    /* ATTACHMENT / EDIT */

    .preview,
    .edit-bar{
      display:none;
      align-items:center;
      gap:9px;
      padding:7px 11px;
      border-top:1px solid var(--line);
      background:#fafafa;
    }

    .preview.show,
    .edit-bar.show{
      display:flex;
    }

    .preview-thumb{
      width:48px;
      height:48px;
      overflow:hidden;
      border-radius:8px;
      background:#111;
      flex:none;
    }

    .preview-thumb img,
    .preview-thumb video{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .preview-name,
    .edit-copy{
      flex:1;
      min-width:0;
      font-size:.7rem;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .edit-bar{
      background:#f1efff;
      color:#5148cc;
    }

    .edit-copy small{
      display:block;
      font-size:.59rem;
      opacity:.7;
      margin-top:1px;
    }

    .edit-time{
      margin-left:auto;
      color:var(--muted);
      font-size:.6rem;
    }

    .remove,
    .cancel{
      border:0;
      background:transparent;
      color:var(--muted);
      cursor:pointer;
      font-weight:700;
    }

    /* COMPOSER */

    .composer{
      display:flex;
      align-items:flex-end;
      gap:7px;
      padding:8px 10px max(9px,env(safe-area-inset-bottom));
      border-top:1px solid var(--line);
      background:#fff;
      z-index:20;
    }

    .attach{
      width:42px;
      height:42px;
      border:0;
      border-radius:50%;
      background:transparent;
      color:var(--text);
      display:grid;
      place-items:center;
      cursor:pointer;
      font-size:1.15rem;
    }

    .attach:hover{background:#f4f4f4}

    .input-wrap{
      flex:1;
      min-width:0;
      display:flex;
      align-items:flex-end;
      border:1px solid #ddd;
      background:#fafafa;
      border-radius:22px;
      padding:0 11px;
    }

    .input-wrap:focus-within{
      border-color:#b8b3ff;
    }

    .input{
      width:100%;
      min-height:40px;
      max-height:120px;
      border:0;
      outline:0;
      resize:none;
      background:transparent;
      padding:9px 2px;
      line-height:1.4;
      color:var(--text);
    }

    .send{
      width:42px;
      height:42px;
      border:0;
      border-radius:50%;
      background:var(--accent);
      color:#fff;
      display:grid;
      place-items:center;
      cursor:pointer;
    }

    .send:disabled{
      opacity:.45;
      cursor:not-allowed;
    }

    #mediaInput{display:none}

    /* ACTION SHEET */

    .overlay{
      position:fixed;
      inset:0;
      background:rgba(0,0,0,.35);
      opacity:0;
      visibility:hidden;
      pointer-events:none;
      transition:.18s;
      z-index:90;
    }

    .overlay.open{
      opacity:1;
      visibility:visible;
      pointer-events:auto;
    }

    .action-sheet{
      position:fixed;
      left:50%;
      bottom:10px;
      transform:translate(-50%,20px);
      width:min(500px,calc(100vw - 18px));
      padding:8px;
      background:#fff;
      border-radius:20px;
      box-shadow:0 25px 70px rgba(0,0,0,.25);
      opacity:0;
      visibility:hidden;
      pointer-events:none;
      transition:.2s;
      z-index:91;
    }

    .action-sheet.open{
      opacity:1;
      visibility:visible;
      pointer-events:auto;
      transform:translate(-50%,0);
    }

    .react-row{
      display:flex;
      gap:4px;
      padding:2px 2px 8px;
      border-bottom:1px solid var(--line);
    }

    .react{
      flex:1;
      height:45px;
      border:0;
      border-radius:13px;
      background:#f4f4f4;
      cursor:pointer;
      font-size:1.25rem;
    }

    .react.add{font-size:1rem}

    .emoji-more{
      display:none;
      flex-wrap:wrap;
      gap:5px;
      padding:8px 2px 2px;
    }

    .emoji-more.open{display:flex}

    .emoji-more button{
      width:40px;
      height:37px;
      border:0;
      border-radius:9px;
      background:#f3f3f3;
      cursor:pointer;
      font-size:1.05rem;
    }

    .action{
      width:100%;
      height:44px;
      border:0;
      border-radius:10px;
      background:transparent;
      padding:0 12px;
      display:flex;
      align-items:center;
      gap:11px;
      cursor:pointer;
      text-align:left;
      font-weight:650;
    }

    .action:hover{background:#f3f3f3}

    .action.danger{color:var(--danger)}

    .action.disabled{
      opacity:.4;
      pointer-events:none;
    }

    .sheet-close{
      margin-top:3px;
      background:#f2f2f2;
      justify-content:center;
    }

    /* TOAST */

    .toast{
      position:fixed;
      left:50%;
      bottom:78px;
      transform:translateX(-50%);
      background:#191919;
      color:#fff;
      padding:9px 14px;
      border-radius:999px;
      font-size:.7rem;
      opacity:0;
      pointer-events:none;
      transition:.2s;
      z-index:120;
    }

    .toast.show{opacity:1}

    @media(max-width:600px){
      .page{
        height:calc(100dvh - 56px);
      }

      .chat{
        border-radius:0;
      }

      .topbar{
        height:58px;
        padding:6px 8px;
      }

      .avatar{
        width:39px;
        height:39px;
      }

      .icon-btn{
        width:39px;
        height:39px;
      }

      .messages{
        padding:15px 8px 25px;
      }

      .bubble-wrap{
        max-width:82%;
      }

      .text{
        font-size:.88rem;
      }

      .action-sheet{
        width:100%;
        left:0;
        bottom:0;
        transform:translateY(20px);
        border-radius:20px 20px 0 0;
        padding-bottom:max(9px,env(safe-area-inset-bottom));
      }

      .action-sheet.open{
        transform:translateY(0);
      }
    }
  </style>
</head>

<body>

  <%- include('./partials/nave') %>

  <main class="page">
    <section class="chat" aria-label="Conversation">

      <!-- HEADER -->
      <header class="topbar">

        <button class="icon-btn" id="backBtn" aria-label="Back">
          <i class="fas fa-arrow-left"></i>
        </button>

        <div class="person" id="profileBtn" role="button" tabindex="0">

          <img
            class="avatar"
            id="avatar"
            src="/imgs/default.png"
            alt=""
          >

          <div class="person-copy">
            <div class="person-name" id="personName">Loading…</div>
            <div class="person-status" id="personStatus">Message</div>
          </div>

        </div>

        <div class="top-actions">

          <button class="icon-btn" id="menuBtn" aria-label="More options">
            <i class="fas fa-ellipsis-v"></i>
          </button>

          <div class="top-menu" id="topMenu">

            <button id="profileAction">
              <i class="fas fa-user"></i>
              View profile
            </button>

            <button id="blockAction" class="danger">
              <i class="fas fa-ban"></i>
              Block user
            </button>

          </div>

        </div>

      </header>

      <!-- MESSAGES -->
      <div class="messages" id="messages" aria-live="polite">

        <div class="welcome" id="welcome">

          <img id="welcomeAvatar" src="/imgs/default.png" alt="">

          <strong id="welcomeName">Starting chat…</strong>

          <p>
            Send a message to start your conversation.
          </p>

        </div>

      </div>

      <div class="typing" id="typing"></div>

      <!-- MEDIA PREVIEW -->
      <div class="preview" id="preview">

        <div class="preview-thumb" id="previewThumb"></div>

        <div class="preview-name" id="previewName"></div>

        <button
          class="remove"
          id="removeMedia"
          type="button"
          aria-label="Remove attachment"
        >
          ×
        </button>

      </div>

      <!-- EDIT BAR -->
      <div class="edit-bar" id="editBar">

        <i class="fas fa-pen"></i>

        <div class="edit-copy">
          <strong>Editing message</strong>
          <small id="editText"></small>
        </div>

        <span class="edit-time" id="editTime"></span>

        <button class="cancel" id="cancelEdit" type="button">
          Cancel
        </button>

      </div>

      <!-- COMPOSER -->
      <form class="composer" id="composer">

        <button
          type="button"
          class="attach"
          id="mediaBtn"
          aria-label="Attach photo or video"
        >
          <i class="fas fa-plus"></i>
        </button>

        <input
          id="mediaInput"
          type="file"
          accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime"
        >

        <div class="input-wrap">

          <textarea
            id="input"
            class="input"
            rows="1"
            maxlength="5000"
            placeholder="Message…"
            autocomplete="off"
          ></textarea>

        </div>

        <button
          class="send"
          id="sendBtn"
          type="submit"
          aria-label="Send"
        >
          <i class="fas fa-paper-plane"></i>
        </button>

      </form>

    </section>
  </main>


  <!-- MESSAGE ACTIONS -->
  <div class="overlay" id="overlay"></div>

  <div class="action-sheet" id="actionSheet">

    <div class="react-row">

      <button class="react" data-emoji="❤️">❤️</button>
      <button class="react" data-emoji="😂">😂</button>
      <button class="react" data-emoji="😮">😮</button>
      <button class="react" data-emoji="😢">😢</button>
      <button class="react add" id="moreEmoji">＋</button>

    </div>

    <div class="emoji-more" id="emojiMore">

      <button data-emoji="👍">👍</button>
      <button data-emoji="😍">😍</button>
      <button data-emoji="🔥">🔥</button>
      <button data-emoji="👏">👏</button>
      <button data-emoji="😡">😡</button>
      <button data-emoji="🙏">🙏</button>
      <button data-emoji="🎉">🎉</button>
      <button data-emoji="💯">💯</button>

    </div>

    <button class="action" id="replyAction">
      <i class="fas fa-reply"></i>
      Reply
    </button>

    <button class="action" id="forwardAction">
      <i class="fas fa-share"></i>
      Forward
    </button>

    <button class="action" id="editAction">
      <i class="fas fa-pen"></i>
      Edit
      <span class="edit-time" id="sheetEditTime"></span>
    </button>

    <button class="action" id="copyAction">
      <i class="far fa-copy"></i>
      Copy
    </button>

    <button class="action danger" id="unsendAction">
      <i class="fas fa-trash-alt"></i>
      Unsend
    </button>

    <button class="action sheet-close" id="closeSheet">
      Cancel
    </button>

  </div>

  <div class="toast" id="toast"></div>

  <%- include('./partials/scripts') %>

  <script src="/socket.io/socket.io.js"></script>

  <script>
    const CURRENT = '<%= user._id %>';
    const TARGET = '<%= targetUserId %>';

    const EDIT_WINDOW_MS = 60 * 1000;

    let conversationId = null;
    let other = null;
    let socket = null;

    let selectedFile = null;
    let activeMessageId = null;
    let editingMessageId = null;
    let replyingMessageId = null;

    let typingTimer = null;
    let longPressTimer = null;

    const $ = id => document.getElementById(id);

    const escapeHtml = value =>
      String(value ?? '').replace(/[&<>"']/g, c => ({
        '&':'&amp;',
        '<':'&lt;',
        '>':'&gt;',
        '"':'&quot;',
        "'":'&#039;'
      }[c]));

    function img(value){
      return value && String(value).trim()
        ? String(value)
        : '/imgs/default.png';
    }

    function toast(text){
      const el = $('toast');

      el.textContent = text;
      el.classList.add('show');

      clearTimeout(window.__toast);

      window.__toast = setTimeout(() => {
        el.classList.remove('show');
      }, 2400);
    }

    function api(url, opts = {}){
      return fetch(url, {
        credentials:'same-origin',
        headers:{
          Accept:'application/json',
          ...(opts.body instanceof FormData
            ? {}
            : {'Content-Type':'application/json'}),
          ...(opts.headers || {})
        },
        ...opts
      });
    }

    function time(value){
      if(!value) return '';

      return new Date(value).toLocaleTimeString([], {
        hour:'numeric',
        minute:'2-digit'
      });
    }

    function day(value){
      return new Date(value).toLocaleDateString([], {
        day:'numeric',
        month:'short',
        year:'numeric'
      });
    }

    function senderId(message){
      return String(
        message?.senderId?._id ||
        message?.senderId ||
        ''
      );
    }

    function canEdit(message){
      return Boolean(
        message &&
        !message.deleted &&
        senderId(message) === String(CURRENT) &&
        Date.now() - new Date(message.createdAt).getTime() <= EDIT_WINDOW_MS
      );
    }

    function remaining(message){
      return Math.max(
        0,
        EDIT_WINDOW_MS -
        (Date.now() - new Date(message.createdAt).getTime())
      );
    }

    function scrollBottom(smooth = true){
      const box = $('messages');

      requestAnimationFrame(() => {
        box.scrollTo({
          top:box.scrollHeight,
          behavior:smooth ? 'smooth' : 'auto'
        });
      });
    }

    function renderWelcome(){
      if(!other) return;

      $('welcomeAvatar').src = img(other.profileImageURL);
      $('welcomeName').textContent = other.fullName || 'User';
    }

    function reactionBadges(message){

      const reactions = Array.isArray(message.reactions)
        ? message.reactions
        : [];

      if(!reactions.length) return '';

      const counts = {};

      reactions.forEach(reaction => {
        if(!reaction?.emoji) return;

        counts[reaction.emoji] =
          (counts[reaction.emoji] || 0) + 1;
      });

      return `
        <div class="reaction-badges">
          ${Object.entries(counts).map(([emoji,count]) => `
            <span class="reaction-badge">
              ${escapeHtml(emoji)}
              ${count > 1 ? `<small>${count}</small>` : ''}
            </span>
          `).join('')}
        </div>
      `;
    }

    function senderProfile(message){

      if(senderId(message) === String(CURRENT)){
        return '';
      }

      const sender = message.senderId;

      if(!sender || typeof sender !== 'object'){
        return '';
      }

      return `
        <div class="sender-info">
          <img
            class="sender-avatar"
            src="${escapeHtml(img(sender.profileImageURL))}"
            alt=""
            onerror="this.src='/imgs/default.png'"
          >
          <span class="sender-name">
            ${escapeHtml(sender.fullName || 'User')}
          </span>
        </div>
      `;
    }

    function profileShare(message){

      if(
        message.mediaType !== 'profile' ||
        !message.profileShareId
      ){
        return '';
      }

      const profile = message.profileShareId;

      return `
        <a
          class="profile-share"
          href="/user/profile/${escapeHtml(profile._id)}"
        >
          <img
            class="profile-share-avatar"
            src="${escapeHtml(img(profile.profileImageURL))}"
            alt=""
            onerror="this.src='/imgs/default.png'"
          >

          <div>
            <div class="profile-share-name">
              ${escapeHtml(profile.fullName || 'Profile')}
            </div>

            <div class="profile-share-label">
              Shared profile
            </div>
          </div>
        </a>
      `;
    }

    function bubble(message){

      const mine =
        senderId(message) === String(CURRENT);

      const deleted = Boolean(message.deleted);

      const row = document.createElement('div');

      row.className =
        'row ' +
        (mine ? 'mine' : 'theirs');

      row.dataset.message = message._id;

      let media = '';

      if(
        !deleted &&
        message.mediaUrl &&
        message.mediaType === 'image'
      ){
        media = `
          <img
            class="media"
            src="${escapeHtml(message.mediaUrl)}"
            alt="Photo"
            loading="lazy"
          >
        `;
      }

      if(
        !deleted &&
        message.mediaUrl &&
        message.mediaType === 'video'
      ){
        media = `
          <video
            class="media video"
            src="${escapeHtml(message.mediaUrl)}"
            controls
            playsinline
            preload="metadata"
          ></video>
        `;
      }

      let text =
        deleted
          ? 'Message unsent'
          : (message.text || '');

      const edited =
        message.edited && !deleted
          ? '<span class="edited">edited</span>'
          : '';

      const status =
        mine && !deleted
          ? `
            <span class="status ${
              message.status === 'read' ? 'read' : ''
            }">
              ${
                message.status === 'read'
                  ? '✓✓'
                  : message.status === 'delivered'
                    ? '✓✓'
                    : '✓'
              }
            </span>
          `
          : '';

      row.innerHTML = `

        ${!mine ? `
          <img
            class="row-avatar"
            src="${escapeHtml(
              img(
                typeof message.senderId === 'object'
                  ? message.senderId.profileImageURL
                  : other?.profileImageURL
              )
            )}"
            alt=""
            onerror="this.src='/imgs/default.png'"
          >
        ` : ''}

        <div class="bubble-wrap">

          ${senderProfile(message)}

          <div
            class="bubble ${deleted ? 'deleted' : ''}"
            data-bubble="${escapeHtml(message._id)}"
          >

            ${media}

            ${profileShare(message)}

            ${
              text
                ? `<div class="text">
                    ${escapeHtml(text)}
                    ${edited}
                   </div>`
                : ''
            }

            <div class="meta">
              ${time(message.createdAt)}
              ${status}
            </div>

            ${reactionBadges(message)}

          </div>

        </div>
      `;

      return row;
    }

    function appendDateIfNeeded(message){

      const box = $('messages');

      const dividers =
        box.querySelectorAll('.date-divider');

      const last =
        dividers.length
          ? dividers[dividers.length - 1]
          : null;

      const currentDay = day(message.createdAt);

      if(last && last.dataset.day === currentDay){
        return;
      }

      const divider =
        document.createElement('div');

      divider.className = 'date-divider';
      divider.dataset.day = currentDay;
      divider.textContent = currentDay;

      box.appendChild(divider);
    }

    function renderMessages(list){

      const box = $('messages');

      box.innerHTML = '';

      if(!list || !list.length){

        const welcome =
          document.createElement('div');

        welcome.className = 'welcome';

        welcome.innerHTML = `
          <img
            src="${escapeHtml(
              img(other?.profileImageURL)
            )}"
            alt=""
          >

          <strong>
            ${escapeHtml(
              other?.fullName || 'User'
            )}
          </strong>

          <p>
            Send a message to start your conversation.
          </p>
        `;

        box.appendChild(welcome);

        return;
      }

      list.forEach(message => {

        appendDateIfNeeded(message);

        const element = bubble(message);

        box.appendChild(element);

        bindGesture(element);
      });

      scrollBottom(false);
    }

    function replaceMessage(message){

      const old =
        document.querySelector(
          `[data-message="${CSS.escape(String(message._id))}"]`
        );

      if(!old) return;

      const fresh = bubble(message);

      old.replaceWith(fresh);

      bindGesture(fresh);
    }

    function patchDeleted(id){

      const element =
        document.querySelector(
          `[data-message="${CSS.escape(String(id))}"]`
        );

      if(!element) return;

      const bubbleEl =
        element.querySelector('.bubble');

      if(!bubbleEl) return;

      bubbleEl.className = 'bubble deleted';

      bubbleEl.innerHTML = `
        <div class="text">
          Message unsent
        </div>

        <div class="meta">
          ${time(new Date())}
        </div>
      `;
    }

    /* ACTION SHEET */

    function closeSheet(){

      activeMessageId = null;

      $('overlay').classList.remove('open');
      $('actionSheet').classList.remove('open');
      $('emojiMore').classList.remove('open');

      document.body.style.overflow = '';
    }

    function openSheet(id){

      const message =
        window.__messages?.find(
          m => String(m._id) === String(id)
        );

      if(!message) return;

      activeMessageId = id;

      const editable = canEdit(message);

      $('editAction')
        .classList
        .toggle('disabled', !editable);

      $('sheetEditTime').textContent =
        editable
          ? Math.ceil(remaining(message) / 1000) + 's'
          : '';

      $('overlay').classList.add('open');
      $('actionSheet').classList.add('open');

      document.body.style.overflow = 'hidden';
    }

    function bindGesture(row){

      const bubbleElement =
        row.querySelector('.bubble');

      if(!bubbleElement) return;

      bubbleElement.addEventListener(
        'dblclick',
        () => {
          if(activeMessageId) return;

          react(
            row.dataset.message,
            '❤️'
          );
        }
      );

      const start = event => {

        if(event.target.closest('video')){
          return;
        }

        clearTimeout(longPressTimer);

        longPressTimer =
          setTimeout(() => {

            openSheet(
              row.dataset.message
            );

          }, 520);
      };

      const end = () => {
        clearTimeout(longPressTimer);
      };

      bubbleElement.addEventListener(
        'pointerdown',
        start
      );

      bubbleElement.addEventListener(
        'pointerup',
        end
      );

      bubbleElement.addEventListener(
        'pointercancel',
        end
      );

      bubbleElement.addEventListener(
        'pointerleave',
        end
      );

      bubbleElement.addEventListener(
        'contextmenu',
        event => {
          event.preventDefault();

          openSheet(
            row.dataset.message
          );
        }
      );
    }

    async function react(id, emoji){

      if(!socket || !conversationId){
        return;
      }

      socket.emit(
        'message:react',
        {
          conversationId,
          messageId:id,
          emoji
        }
      );

      closeSheet();
    }

    /* EDIT */

    function startEdit(){

      const message =
        window.__messages?.find(
          m => String(m._id) === String(activeMessageId)
        );

      if(!message){
        closeSheet();
        return;
      }

      if(!canEdit(message)){
        toast(
          'Edit is available for only 1 minute.'
        );

        closeSheet();

        return;
      }

      editingMessageId = message._id;

      $('input').value =
        message.text || '';

      $('editText').textContent =
        message.text || 'Empty message';

      $('editBar').classList.add('show');

      $('input').focus();

      resizeInput();

      closeSheet();

      updateEditTimer();
    }

    function cancelEdit(){

      editingMessageId = null;

      $('editBar').classList.remove('show');

      $('editText').textContent = '';
      $('editTime').textContent = '';
    }

    function updateEditTimer(){

      if(!editingMessageId){
        return;
      }

      const message =
        window.__messages?.find(
          m => String(m._id) === String(editingMessageId)
        );

      if(!message){
        cancelEdit();
        return;
      }

      const left = remaining(message);

      if(left <= 0){

        cancelEdit();

        return;
      }

      $('editTime').textContent =
        Math.ceil(left / 1000) + 's';

      setTimeout(
        updateEditTimer,
        1000
      );
    }

    function submitEdit(){

      const text =
        $('input').value.trim();

      if(!text || !editingMessageId){
        return;
      }

      if(!socket){
        return;
      }

      socket.emit(
        'message:edit',
        {
          conversationId,
          messageId:editingMessageId,
          text
        }
      );

      cancelEdit();

      $('input').value = '';

      resizeInput();
    }

    /* REPLY */

    function startReply(){

      const message =
        window.__messages?.find(
          m => String(m._id) === String(activeMessageId)
        );

      if(!message){
        closeSheet();
        return;
      }

      replyingMessageId = message._id;

      $('input').placeholder =
        'Reply to message…';

      $('input').focus();

      toast('Replying to message');

      closeSheet();
    }

    function clearReply(){

      replyingMessageId = null;

      $('input').placeholder =
        'Message…';
    }

    /* FORWARD */

    function forwardMessage(){

      const message =
        window.__messages?.find(
          m => String(m._id) === String(activeMessageId)
        );

      if(!message){
        closeSheet();
        return;
      }

      try{
        sessionStorage.setItem(
          'forwardMessage',
          JSON.stringify({
            text:message.text || '',
            mediaUrl:message.mediaUrl || '',
            mediaType:message.mediaType || ''
          })
        );

        location.href =
          '/messages/chatlog?forward=1';

      }catch(error){
        toast(
          'Unable to forward message'
        );

        closeSheet();
      }
    }

    /* UNSEND */

    async function unsend(){

      const message =
        window.__messages?.find(
          m => String(m._id) === String(activeMessageId)
        );

      if(!message){
        closeSheet();
        return;
      }

      if(
        senderId(message) !==
        String(CURRENT)
      ){
        toast(
          'You can only unsend your own message.'
        );

        closeSheet();

        return;
      }

      if(!confirm(
        'Unsend this message for everyone?'
      )){
        closeSheet();
        return;
      }

      socket?.emit(
        'message:unsend',
        {
          conversationId,
          messageId:message._id
        }
      );

      closeSheet();
    }

    /* COPY */

    async function copyActive(){

      const message =
        window.__messages?.find(
          m => String(m._id) === String(activeMessageId)
        );

      if(!message || message.deleted){
        closeSheet();
        return;
      }

      try{

        await navigator.clipboard.writeText(
          message.text || ''
        );

        toast('Message copied');

      }catch(error){

        toast(
          'Unable to copy message'
        );
      }

      closeSheet();
    }

    /* INIT */

    async function init(){

      try{

        const response =
          await api(
            '/messages/conversation',
            {
              method:'POST',
              body:JSON.stringify({
                userId:TARGET
              })
            }
          );

        const data =
          await response.json();

        if(!response.ok || !data.success){
          throw new Error(
            data.message ||
            'Unable to open conversation'
          );
        }

        conversationId =
          data.conversationId;

        other =
          data.target;

        setPerson();

        const history =
          await api(
            '/messages/' +
            encodeURIComponent(
              conversationId
            )
          );

        const historyData =
          await history.json();

        if(
          !history.ok ||
          !historyData.success
        ){
          throw new Error(
            historyData.message ||
            'Unable to load messages'
          );
        }

        window.__messages =
          historyData.messages || [];

        renderMessages(
          window.__messages
        );

        socket = io();

        bindSocket();

        socket.emit(
          'conversation:join',
          conversationId
        );

        socket.emit(
          'message:read',
          {conversationId}
        );

      }catch(error){

        $('messages').innerHTML = `
          <div class="welcome">

            <i
              class="fas fa-exclamation-circle"
              style="font-size:2rem"
            ></i>

            <strong>
              Unable to load chat
            </strong>

            <p>
              ${escapeHtml(error.message)}
            </p>

            <button
              class="action"
              style="background:#f1f1f1;justify-content:center;margin-top:10px"
              onclick="location.reload()"
            >
              Try again
            </button>

          </div>
        `;
      }
    }

    function setPerson(){

      const name =
        other?.fullName || 'User';

      $('personName').textContent =
        name;

      $('avatar').src =
        img(other?.profileImageURL);

      $('welcomeName').textContent =
        name;

      $('welcomeAvatar').src =
        img(other?.profileImageURL);

      $('avatar').onerror =
        () => {
          $('avatar').src =
            '/imgs/default.png';
        };

      $('personStatus').textContent =
        other?.isPrivate
          ? 'Private account'
          : 'Message';

      $('profileAction').onclick =
        viewProfile;

      $('profileBtn').onclick =
        viewProfile;

      $('profileBtn').onkeydown =
        event => {
          if(event.key === 'Enter'){
            viewProfile();
          }
        };
    }

    function viewProfile(){

      location.href =
        '/user/profile/' +
        encodeURIComponent(TARGET);
    }

    /* SOCKET */

    function bindSocket(){

      socket.on(
        'user:online',
        data => {

          if(
            String(data.userId) ===
            String(TARGET)
          ){

            $('personStatus').textContent =
              'Active now';

            $('personStatus')
              .classList
              .add('online');
          }
        }
      );

      socket.on(
        'user:offline',
        data => {

          if(
            String(data.userId) ===
            String(TARGET)
          ){

            $('personStatus').textContent =
              other?.isPrivate
                ? 'Private account'
                : 'Message';

            $('personStatus')
              .classList
              .remove('online');
          }
        }
      );

      socket.on(
        'typing:start',
        data => {

          if(
            String(data.userId) ===
            String(TARGET)
          ){

            $('typing').textContent =
              (other?.fullName || 'User') +
              ' is typing…';
          }
        }
      );

      socket.on(
        'typing:stop',
        data => {

          if(
            String(data.userId) ===
            String(TARGET)
          ){

            $('typing').textContent = '';
          }
        }
      );

      socket.on(
        'message:new',
        message => {

          if(
            String(message.conversationId) !==
            String(conversationId)
          ){
            return;
          }

          window.__messages =
            window.__messages || [];

          window.__messages.push(
            message
          );

          const welcome =
            $('welcome');

          if(
            welcome &&
            welcome.parentNode
          ){
            welcome.remove();
          }

          appendDateIfNeeded(
            message
          );

          const element =
            bubble(message);

          $('messages')
            .appendChild(element);

          bindGesture(element);

          scrollBottom();

          socket.emit(
            'message:read',
            {conversationId}
          );
        }
      );

      socket.on(
        'message:edited',
        message => {

          const index =
            window.__messages.findIndex(
              x =>
                String(x._id) ===
                String(message._id)
            );

          if(index >= 0){
            window.__messages[index] =
              message;
          }

          replaceMessage(
            message
          );
        }
      );

      socket.on(
        'message:unsent',
        data => {

          const index =
            window.__messages.findIndex(
              x =>
                String(x._id) ===
                String(data.messageId)
            );

          if(index >= 0){

            window.__messages[index].deleted =
              true;

            window.__messages[index].text =
              '';

            window.__messages[index].mediaUrl =
              '';
          }

          patchDeleted(
            data.messageId
          );
        }
      );

      socket.on(
        'message:reactions',
        data => {

          const message =
            window.__messages.find(
              x =>
                String(x._id) ===
                String(data.messageId)
            );

          if(message){
            message.reactions =
              data.reactions;
          }

          if(!message){
            return;
          }

          replaceMessage(
            message
          );
        }
      );

      socket.on(
        'message:read',
        data => {

          if(
            String(data.conversationId) !==
            String(conversationId)
          ){
            return;
          }

          window.__messages
            .filter(
              message =>
                senderId(message) ===
                String(CURRENT)
            )
            .forEach(
              message =>
                message.status = 'read'
            );

          document
            .querySelectorAll(
              '.row.mine .status'
            )
            .forEach(status => {

              status.textContent =
                '✓✓';

              status.classList.add(
                'read'
              );
            });
        }
      );

      socket.on(
        'message:error',
        data => {

          toast(
            data.message ||
            'Unable to send message'
          );
        }
      );

      socket.on(
        'message:action:error',
        data => {

          toast(
            data.message ||
            'Unable to update message'
          );
        }
      );
    }

    /* SEND */

    async function send(){

      if(editingMessageId){
        submitEdit();
        return;
      }

      const text =
        $('input').value.trim();

      if(!text && !selectedFile){
        return;
      }

      if(!socket || !conversationId){
        toast(
          'Chat is still loading'
        );
        return;
      }

      $('sendBtn').disabled =
        true;

      try{

        let mediaUrl = '';
        let mediaType = '';

        if(selectedFile){

          const formData =
            new FormData();

          formData.append(
            'media',
            selectedFile
          );

          const response =
            await api(
              '/messages/upload',
              {
                method:'POST',
                body:formData
              }
            );

          const data =
            await response.json();

          if(
            !response.ok ||
            !data.success
          ){
            throw new Error(
              data.message ||
              'Unable to upload media'
            );
          }

          mediaUrl =
            data.mediaUrl;

          mediaType =
            data.mediaType;
        }

        socket.emit(
          'message:send',
          {
            conversationId,
            text,
            mediaUrl,
            mediaType,
            replyTo:replyingMessageId || null
          }
        );

        $('input').value = '';

        clearMedia();

        clearReply();

        resizeInput();

      }catch(error){

        toast(
          error.message
        );

      }finally{

        $('sendBtn').disabled =
          false;
      }
    }

    function resizeInput(){

      const input =
        $('input');

      input.style.height =
        'auto';

      input.style.height =
        Math.min(
          input.scrollHeight,
          120
        ) + 'px';
    }

    /* MEDIA */

    function clearMedia(){

      $('mediaInput').value =
        '';

      selectedFile =
        null;

      $('preview')
        .classList
        .remove('show');

      $('previewThumb')
        .innerHTML =
        '';

      $('previewName')
        .textContent =
        '';
    }

    function previewFile(file){

      selectedFile =
        file;

      if(!file){
        return;
      }

      const url =
        URL.createObjectURL(file);

      $('previewName')
        .textContent =
        file.name;

      $('previewThumb')
        .innerHTML =
        file.type.startsWith('video/')
          ? `
            <video
              src="${url}"
              muted
            ></video>
          `
          : `
            <img
              src="${url}"
              alt=""
            >
          `;

      $('preview')
        .classList
        .add('show');
    }

    /* EVENTS */

    $('composer')
      .addEventListener(
        'submit',
        event => {
          event.preventDefault();
          send();
        }
      );

    $('input')
      .addEventListener(
        'input',
        () => {

          resizeInput();

          if(
            socket &&
            conversationId
          ){

            socket.emit(
              'typing:start',
              {conversationId}
            );

            clearTimeout(
              typingTimer
            );

            typingTimer =
              setTimeout(
                () => {

                  socket.emit(
                    'typing:stop',
                    {conversationId}
                  );

                },
                900
              );
          }
        }
      );

    $('input')
      .addEventListener(
        'keydown',
        event => {

          if(
            event.key === 'Enter' &&
            !event.shiftKey &&
            window.innerWidth > 650
          ){

            event.preventDefault();

            send();
          }
        }
      );

    $('mediaBtn').onclick =
      () => $('mediaInput').click();

    $('mediaInput').onchange =
      event =>
        previewFile(
          event.target.files?.[0]
        );

    $('removeMedia').onclick =
      clearMedia;

    $('cancelEdit').onclick =
      cancelEdit;

    $('replyAction').onclick =
      startReply;

    $('forwardAction').onclick =
      forwardMessage;

    $('editAction').onclick =
      startEdit;

    $('copyAction').onclick =
      copyActive;

    $('unsendAction').onclick =
      unsend;

    $('moreEmoji').onclick =
      () => {
        $('emojiMore')
          .classList
          .toggle('open');
      };

    document
      .querySelectorAll(
        '[data-emoji]'
      )
      .forEach(button => {

        button.addEventListener(
          'click',
          () => {

            if(activeMessageId){

              react(
                activeMessageId,
                button.dataset.emoji
              );
            }
          }
        );
      });

    $('backBtn').onclick =
      () =>
        history.length > 1
          ? history.back()
          : location.href =
              '/messages/chatlog';

    $('menuBtn').onclick =
      event => {

        event.stopPropagation();

        $('topMenu')
          .classList
          .toggle('open');
      };

    $('blockAction').onclick =
      async () => {

        if(!confirm(
          'Block this user?'
        )){
          return;
        }

        try{

          const response =
            await api(
              '/messages/block/' +
              TARGET,
              {
                method:'POST'
              }
            );

          const data =
            await response.json();

          if(
            !response.ok ||
            !data.success
          ){
            throw new Error(
              data.message ||
              'Unable to block'
            );
          }

          toast(
            data.message ||
            'User blocked'
          );

          setTimeout(
            () =>
              location.href =
                '/messages/chatlog',
            700
          );

        }catch(error){

          toast(
            error.message
          );
        }
      };

    $('profileAction').onclick =
      viewProfile;

    document.addEventListener(
      'click',
      event => {

        if(
          !event.target.closest(
            '.top-actions'
          )
        ){
          $('topMenu')
            .classList
            .remove('open');
        }

        if(
          !event.target.closest(
            '.action-sheet'
          ) &&
          !event.target.closest(
            '.bubble'
          )
        ){
          closeSheet();
        }
      }
    );

    $('overlay').onclick =
      closeSheet;

    $('closeSheet').onclick =
      closeSheet;

    /* INITIAL LOAD */

    init();
  </script>

</body>
</html>
