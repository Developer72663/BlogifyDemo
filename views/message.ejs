```html
<!doctype html>
<html lang="en">
<head>
  <%- include('./partials/head') %>

  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

  <title>Messages | Blogify</title>

  <style>
    :root{
      --bg:#fff;
      --chat-bg:#fff;
      --text:#111;
      --muted:#737373;
      --line:#e9e9e9;
      --soft:#f4f4f4;
      --primary:#635bff;
      --danger:#ed4956;
      --green:#18a058;
    }

    *{
      box-sizing:border-box;
    }

    html,
    body{
      margin:0;
      width:100%;
      height:100%;
      background:var(--bg);
      color:var(--text);
    }

    body{
      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;
    }

    button,
    input,
    textarea{
      font:inherit;
    }

    button{
      -webkit-tap-highlight-color:transparent;
    }

    /* =========================
       PAGE
    ========================= */

    .messages-page{
      width:100%;
      height:calc(100dvh - 70px);
      min-height:520px;
      display:flex;
      justify-content:center;
      background:#fff;
    }

    .chat{
      width:min(100%,1080px);
      height:100%;
      background:var(--chat-bg);
      display:grid;
      grid-template-rows:62px minmax(0,1fr) auto;
      overflow:hidden;
      position:relative;
    }

    @media(min-width:900px){
      .messages-page{
        padding:14px;
        background:#f6f6f7;
      }

      .chat{
        border:1px solid var(--line);
        border-radius:18px;
        overflow:hidden;
      }
    }

    /* =========================
       TOP BAR
    ========================= */

    .chat-header{
      height:62px;
      display:flex;
      align-items:center;
      gap:8px;
      padding:7px 12px;
      border-bottom:1px solid var(--line);
      background:#fff;
      z-index:30;
    }

    .header-btn{
      width:42px;
      height:42px;
      border:0;
      border-radius:50%;
      background:transparent;
      display:grid;
      place-items:center;
      cursor:pointer;
      color:#111;
      flex:none;
    }

    .header-btn:hover{
      background:#f4f4f4;
    }

    .header-user{
      flex:1;
      min-width:0;
      display:flex;
      align-items:center;
      gap:10px;
      cursor:pointer;
    }

    .header-avatar{
      width:40px;
      height:40px;
      border-radius:50%;
      object-fit:cover;
      flex:none;
      background:#eee;
    }

    .header-info{
      min-width:0;
    }

    .header-name{
      font-size:15px;
      font-weight:700;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .header-status{
      margin-top:2px;
      font-size:11px;
      color:var(--muted);
    }

    .header-status.online{
      color:var(--green);
    }

    .header-actions{
      display:flex;
      align-items:center;
      position:relative;
    }

    /* =========================
       MESSAGE AREA
    ========================= */

    .messages{
      min-height:0;
      overflow-y:auto;
      overflow-x:hidden;

      display:flex;
      flex-direction:column;

      padding:22px 16px 28px;

      background:#fff;

      scroll-behavior:smooth;
      overscroll-behavior:contain;

      scrollbar-width:thin;
      scrollbar-color:#ccc transparent;
    }

    .messages::-webkit-scrollbar{
      width:5px;
    }

    .messages::-webkit-scrollbar-track{
      background:transparent;
    }

    .messages::-webkit-scrollbar-thumb{
      background:#ccc;
      border-radius:20px;
    }

    /* =========================
       WELCOME
    ========================= */

    .welcome{
      margin:auto;
      width:min(320px,90%);
      text-align:center;
      color:var(--muted);
      padding:30px 10px;
    }

    .welcome-avatar{
      width:78px;
      height:78px;
      border-radius:50%;
      object-fit:cover;
      margin-bottom:12px;
    }

    .welcome strong{
      display:block;
      color:#111;
      font-size:16px;
    }

    .welcome p{
      margin:6px 0 0;
      font-size:13px;
      line-height:1.5;
    }

    /* =========================
       DATE
    ========================= */

    .date-divider{
      align-self:center;
      margin:16px 0 10px;
      color:#999;
      font-size:11px;
      font-weight:600;
    }

    /* =========================
       MESSAGE ROW
    ========================= */

    .message-row{
      width:100%;
      display:flex;
      align-items:flex-end;
      gap:7px;
      margin:2px 0;
      position:relative;
    }

    .message-row.mine{
      justify-content:flex-end;
    }

    .message-row.theirs{
      justify-content:flex-start;
    }

    /* =========================
       SENDER AVATAR
    ========================= */

    .sender-avatar-wrap{
      width:30px;
      min-width:30px;
      height:30px;
      display:flex;
      align-items:flex-end;
      justify-content:center;
    }

    .sender-avatar{
      width:28px;
      height:28px;
      border-radius:50%;
      object-fit:cover;
      background:#eee;
    }

    .sender-avatar.hidden{
      visibility:hidden;
    }

    /* =========================
       MESSAGE CONTENT
    ========================= */

    .message-content{
      max-width:min(70%,620px);
      min-width:0;
    }

    .sender-name{
      font-size:11px;
      color:#777;
      font-weight:600;
      margin:0 0 3px 4px;
    }

    .sender-name.hidden{
      visibility:hidden;
      height:0;
      margin:0;
    }

    .message-bubble{
      position:relative;
      display:inline-block;

      max-width:100%;

      padding:8px 12px;

      background:#efefef;
      color:#111;

      border-radius:19px;

      line-height:1.42;
      font-size:14px;

      word-break:break-word;
      white-space:pre-wrap;

      user-select:none;
      -webkit-user-select:none;

      touch-action:manipulation;
    }

    .mine .message-bubble{
      background:#635bff;
      color:#fff;
    }

    .message-bubble.deleted{
      background:#f2f2f2 !important;
      color:#999 !important;
      font-style:italic;
    }

    .message-text{
      white-space:pre-wrap;
    }

    .message-meta{
      margin-top:3px;
      font-size:9px;
      opacity:.55;
      text-align:right;
      white-space:nowrap;
    }

    .message-edited{
      margin-left:4px;
      font-size:9px;
      opacity:.65;
    }

    .message-status{
      margin-left:4px;
    }

    .message-status.read{
      color:#c8f9ff;
    }

    /* =========================
       MEDIA
    ========================= */

    .message-media{
      display:block;

      width:min(300px,70vw);
      max-height:390px;

      object-fit:cover;

      border-radius:14px;

      background:#111;

      margin-bottom:3px;
    }

    .message-media.video{
      background:#000;
    }

    /* =========================
       REPLY PREVIEW IN MESSAGE
    ========================= */

    .reply-preview{
      border-left:3px solid rgba(0,0,0,.22);
      padding-left:8px;
      margin-bottom:6px;
      font-size:11px;
      opacity:.72;
    }

    .mine .reply-preview{
      border-left-color:rgba(255,255,255,.65);
    }

    .reply-preview strong{
      display:block;
      font-size:10px;
      margin-bottom:2px;
    }

    /* =========================
       REACTIONS
    ========================= */

    .reaction-list{
      display:flex;
      gap:3px;

      position:absolute;
      bottom:-12px;
      left:5px;

      z-index:5;
    }

    .mine .reaction-list{
      left:auto;
      right:5px;
    }

    .reaction{
      min-width:25px;
      height:23px;

      padding:2px 6px;

      border:1px solid #ddd;
      border-radius:999px;

      background:#fff;

      box-shadow:0 2px 8px rgba(0,0,0,.12);

      display:grid;
      place-items:center;

      font-size:12px;
    }

    /* =========================
       COMPOSER
    ========================= */

    .typing{
      height:18px;
      padding:0 16px;

      background:#fff;

      color:#888;

      font-size:10px;
    }

    .typing:empty{
      visibility:hidden;
    }

    .composer-area{
      border-top:1px solid var(--line);
      background:#fff;
    }

    /* =========================
       ATTACHMENT PREVIEW
    ========================= */

    .attachment-preview{
      display:none;
      align-items:center;
      gap:9px;

      padding:8px 12px;

      background:#fafafa;
      border-bottom:1px solid var(--line);
    }

    .attachment-preview.show{
      display:flex;
    }

    .attachment-thumb{
      width:48px;
      height:48px;

      border-radius:9px;
      overflow:hidden;

      background:#111;
      flex:none;
    }

    .attachment-thumb img,
    .attachment-thumb video{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .attachment-name{
      flex:1;
      min-width:0;

      font-size:11px;

      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .remove-attachment{
      border:0;
      background:transparent;
      color:#888;
      font-size:20px;
      cursor:pointer;
    }

    /* =========================
       REPLY / EDIT BAR
    ========================= */

    .reply-bar,
    .edit-bar{
      display:none;
      align-items:center;
      gap:9px;

      padding:8px 12px;

      background:#fafafa;

      border-bottom:1px solid var(--line);
    }

    .reply-bar.show,
    .edit-bar.show{
      display:flex;
    }

    .reply-icon,
    .edit-icon{
      width:32px;
      height:32px;
      border-radius:50%;
      background:#eee;
      display:grid;
      place-items:center;
      flex:none;
    }

    .reply-copy,
    .edit-copy{
      flex:1;
      min-width:0;

      font-size:11px;

      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
    }

    .reply-copy strong,
    .edit-copy strong{
      display:block;
      font-size:11px;
      margin-bottom:2px;
    }

    .reply-copy span,
    .edit-copy span{
      color:#888;
    }

    .cancel-action{
      border:0;
      background:transparent;
      color:#777;
      cursor:pointer;
      font-weight:600;
    }

    /* =========================
       COMPOSER
    ========================= */

    .composer{
      display:flex;
      align-items:flex-end;
      gap:7px;

      padding:
        8px
        10px
        max(9px,env(safe-area-inset-bottom));
    }

    .attach-btn,
    .voice-btn{
      width:42px;
      height:42px;

      border:0;
      border-radius:50%;

      background:transparent;

      display:grid;
      place-items:center;

      cursor:pointer;

      flex:none;
    }

    .attach-btn{
      color:#635bff;
      font-size:19px;
    }

    .voice-btn{
      color:#111;
      font-size:17px;
    }

    .attach-btn:hover,
    .voice-btn:hover{
      background:#f3f3f3;
    }

    .input-container{
      flex:1;
      min-width:0;

      border:1px solid #ddd;

      background:#f6f6f6;

      border-radius:22px;

      display:flex;
      align-items:flex-end;

      padding:0 11px;
    }

    .message-input{
      width:100%;

      min-height:40px;
      max-height:120px;

      padding:10px 0;

      border:0;
      outline:0;

      resize:none;

      background:transparent;

      color:#111;

      line-height:1.4;

      font-size:14px;
    }

    .send-btn{
      width:42px;
      height:42px;

      border:0;
      border-radius:50%;

      background:#635bff;

      color:#fff;

      display:grid;
      place-items:center;

      cursor:pointer;

      flex:none;
    }

    .send-btn:disabled{
      opacity:.45;
      cursor:not-allowed;
    }

    #mediaInput{
      display:none;
    }

    /* =========================
       TOP MENU
    ========================= */

    .top-menu{
      display:none;

      position:absolute;

      right:0;
      top:49px;

      width:210px;

      background:#fff;

      border:1px solid var(--line);

      border-radius:13px;

      box-shadow:0 15px 40px rgba(0,0,0,.16);

      padding:5px;

      z-index:100;
    }

    .top-menu.open{
      display:block;
    }

    .top-menu button{
      width:100%;

      border:0;

      background:transparent;

      padding:11px 12px;

      border-radius:9px;

      text-align:left;

      display:flex;

      align-items:center;

      gap:10px;

      cursor:pointer;
    }

    .top-menu button:hover{
      background:#f4f4f4;
    }

    .top-menu .danger{
      color:var(--danger);
    }

    /* =========================
       ACTION SHEET
    ========================= */

    .overlay{
      position:fixed;
      inset:0;

      background:rgba(0,0,0,.35);

      opacity:0;
      visibility:hidden;

      pointer-events:none;

      transition:.18s;

      z-index:200;
    }

    .overlay.open{
      opacity:1;
      visibility:visible;
      pointer-events:auto;
    }

    .action-sheet{
      position:fixed;

      left:50%;
      bottom:10px;

      transform:translate(-50%,20px);

      width:min(500px,calc(100vw - 16px));

      background:#fff;

      border-radius:20px;

      padding:8px;

      box-shadow:0 25px 70px rgba(0,0,0,.25);

      opacity:0;
      visibility:hidden;

      pointer-events:none;

      transition:.2s;

      z-index:201;
    }

    .action-sheet.open{
      opacity:1;
      visibility:visible;
      pointer-events:auto;

      transform:translate(-50%,0);
    }

    .reaction-picker{
      display:flex;
      gap:4px;

      padding:3px 2px 9px;

      border-bottom:1px solid var(--line);
    }

    .emoji-btn{
      flex:1;

      height:44px;

      border:0;

      border-radius:12px;

      background:#f3f3f3;

      cursor:pointer;

      font-size:20px;
    }

    .emoji-btn:hover{
      background:#e9e9e9;
    }

    .more-emojis{
      display:none;

      flex-wrap:wrap;

      gap:5px;

      padding:8px 2px 3px;
    }

    .more-emojis.open{
      display:flex;
    }

    .more-emojis button{
      width:39px;
      height:37px;

      border:0;
      border-radius:9px;

      background:#f3f3f3;

      cursor:pointer;

      font-size:17px;
    }

    .sheet-action{
      width:100%;

      height:43px;

      border:0;

      border-radius:10px;

      background:transparent;

      display:flex;

      align-items:center;

      gap:11px;

      padding:0 12px;

      cursor:pointer;

      font-weight:600;

      text-align:left;
    }

    .sheet-action:hover{
      background:#f3f3f3;
    }

    .sheet-action.danger{
      color:var(--danger);
    }

    .sheet-action.disabled{
      opacity:.4;
      pointer-events:none;
    }

    .sheet-close{
      background:#f3f3f3;
      margin-top:4px;
    }

    .action-time{
      margin-left:auto;
      font-size:10px;
      color:#888;
    }

    /* =========================
       TOAST
    ========================= */

    .toast{
      position:fixed;

      left:50%;
      bottom:78px;

      transform:translateX(-50%);

      background:#111;
      color:#fff;

      padding:9px 14px;

      border-radius:999px;

      font-size:11px;

      opacity:0;

      pointer-events:none;

      transition:.2s;

      z-index:300;
    }

    .toast.show{
      opacity:1;
    }

    /* =========================
       MOBILE
    ========================= */

    @media(max-width:600px){

      .messages-page{
        height:calc(100dvh - 56px);
        min-height:0;
      }

      .chat{
        width:100%;
      }

      .chat-header{
        height:58px;
        padding:6px 9px;
      }

      .header-avatar{
        width:38px;
        height:38px;
      }

      .header-btn{
        width:39px;
        height:39px;
      }

      .messages{
        padding:
          15px
          8px
          22px;
      }

      .message-content{
        max-width:82%;
      }

      .sender-avatar-wrap{
        width:28px;
        min-width:28px;
      }

      .sender-avatar{
        width:27px;
        height:27px;
      }

      .message-bubble{
        font-size:14px;
        padding:8px 11px;
      }

      .message-media{
        width:min(290px,72vw);
      }

      .action-sheet{
        left:0;
        right:0;
        bottom:0;

        width:100%;

        transform:translateY(20px);

        border-radius:20px 20px 0 0;

        padding-bottom:max(9px,env(safe-area-inset-bottom));
      }

      .action-sheet.open{
        transform:translateY(0);
      }
    }

    @media(min-width:900px){

      .messages{
        padding-left:clamp(30px,7vw,90px);
        padding-right:clamp(30px,7vw,90px);
      }

      .message-content{
        max-width:65%;
      }
    }
  </style>
</head>

<body>

  <%- include('./partials/nave') %>

  <main class="messages-page">

    <section class="chat">

      <!-- =========================
           HEADER
      ========================== -->

      <header class="chat-header">

        <button
          class="header-btn"
          id="backBtn"
          aria-label="Back">
          <i class="fas fa-arrow-left"></i>
        </button>

        <div
          class="header-user"
          id="profileBtn"
          role="button"
          tabindex="0">

          <img
            class="header-avatar"
            id="avatar"
            src="/imgs/default.png"
            alt="">

          <div class="header-info">

            <div
              class="header-name"
              id="personName">
              Loading…
            </div>

            <div
              class="header-status"
              id="personStatus">
              Message
            </div>

          </div>

        </div>

        <div class="header-actions">

          <button
            class="header-btn"
            id="menuBtn"
            aria-label="More options">
            <i class="fas fa-ellipsis-v"></i>
          </button>

          <div
            class="top-menu"
            id="topMenu">

            <button id="profileAction">
              <i class="fas fa-user"></i>
              View profile
            </button>

            <button
              id="blockAction"
              class="danger">
              <i class="fas fa-ban"></i>
              Block user
            </button>

          </div>

        </div>

      </header>


      <!-- =========================
           MESSAGES
      ========================== -->

      <div
        class="messages"
        id="messages"
        aria-live="polite">

        <div
          class="welcome"
          id="welcome">

          <img
            class="welcome-avatar"
            id="welcomeAvatar"
            src="/imgs/default.png"
            alt="">

          <strong id="welcomeName">
            Starting chat…
          </strong>

          <p>
            Send a message to start your conversation.
          </p>

        </div>

      </div>


      <!-- =========================
           TYPING
      ========================== -->

      <div
        class="typing"
        id="typing">
      </div>


      <div class="composer-area">

        <!-- ATTACHMENT -->

        <div
          class="attachment-preview"
          id="preview">

          <div
            class="attachment-thumb"
            id="previewThumb">
          </div>

          <div
            class="attachment-name"
            id="previewName">
          </div>

          <button
            class="remove-attachment"
            id="removeMedia"
            type="button">
            ×
          </button>

        </div>


        <!-- REPLY -->

        <div
          class="reply-bar"
          id="replyBar">

          <div class="reply-icon">
            <i class="fas fa-reply"></i>
          </div>

          <div class="reply-copy">

            <strong id="replyName">
              Reply
            </strong>

            <span id="replyText">
            </span>

          </div>

          <button
            class="cancel-action"
            id="cancelReply"
            type="button">
            ×
          </button>

        </div>


        <!-- EDIT -->

        <div
          class="edit-bar"
          id="editBar">

          <div class="edit-icon">
            <i class="fas fa-pen"></i>
          </div>

          <div class="edit-copy">

            <strong>
              Editing message
            </strong>

            <span id="editText">
            </span>

          </div>

          <span
            class="action-time"
            id="editTime">
          </span>

          <button
            class="cancel-action"
            id="cancelEdit"
            type="button">
            Cancel
          </button>

        </div>


        <!-- COMPOSER -->

        <form
          class="composer"
          id="composer">

          <button
            type="button"
            class="attach-btn"
            id="mediaBtn"
            aria-label="Add photo or video">

            <i class="fas fa-plus-circle"></i>

          </button>

          <input
            id="mediaInput"
            type="file"
            accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime">


          <div class="input-container">

            <textarea
              id="input"
              class="message-input"
              rows="1"
              maxlength="5000"
              placeholder="Message…"
              autocomplete="off"></textarea>

          </div>


          <button
            class="voice-btn"
            id="voiceBtn"
            type="button"
            aria-label="Voice message">

            <i class="fas fa-microphone"></i>

          </button>


          <button
            class="send-btn"
            id="sendBtn"
            type="submit"
            aria-label="Send">

            <i class="fas fa-paper-plane"></i>

          </button>

        </form>

      </div>

    </section>

  </main>


  <!-- =========================
       ACTION SHEET
  ========================== -->

  <div
    class="overlay"
    id="overlay">
  </div>


  <div
    class="action-sheet"
    id="actionSheet">

    <div class="reaction-picker">

      <button
        class="emoji-btn"
        data-emoji="❤️">
        ❤️
      </button>

      <button
        class="emoji-btn"
        data-emoji="😂">
        😂
      </button>

      <button
        class="emoji-btn"
        data-emoji="😮">
        😮
      </button>

      <button
        class="emoji-btn"
        data-emoji="😢">
        😢
      </button>

      <button
        class="emoji-btn"
        id="moreEmoji"
        type="button">
        ＋
      </button>

    </div>


    <div
      class="more-emojis"
      id="emojiMore">

      <button data-emoji="👍">👍</button>
      <button data-emoji="😍">😍</button>
      <button data-emoji="🔥">🔥</button>
      <button data-emoji="👏">👏</button>
      <button data-emoji="😡">😡</button>
      <button data-emoji="🙏">🙏</button>
      <button data-emoji="🎉">🎉</button>
      <button data-emoji="💯">💯</button>
      <button data-emoji="🤣">🤣</button>
      <button data-emoji="🥰">🥰</button>
      <button data-emoji="😎">😎</button>
      <button data-emoji="💔">💔</button>

    </div>


    <button
      class="sheet-action"
      id="replyAction"
      type="button">

      <i class="fas fa-reply"></i>

      Reply

    </button>


    <button
      class="sheet-action"
      id="forwardAction"
      type="button">

      <i class="fas fa-share"></i>

      Forward

    </button>


    <button
      class="sheet-action"
      id="editAction"
      type="button">

      <i class="fas fa-pen"></i>

      Edit

      <span
        class="action-time"
        id="sheetEditTime">
      </span>

    </button>


    <button
      class="sheet-action"
      id="copyAction"
      type="button">

      <i class="far fa-copy"></i>

      Copy

    </button>


    <button
      class="sheet-action danger"
      id="unsendAction"
      type="button">

      <i class="fas fa-trash-alt"></i>

      Unsend

    </button>


    <button
      class="sheet-action sheet-close"
      id="closeSheet"
      type="button">

      <i class="fas fa-times"></i>

      Cancel

    </button>

  </div>


  <div
    class="toast"
    id="toast">
  </div>


  <%- include('./partials/scripts') %>

  <script src="/socket.io/socket.io.js"></script>

  <script>

    /* ==========================================
       DATA
    ========================================== */

    const CURRENT = '<%= user._id %>';
    const CURRENT_NAME = '<%= user.fullName || "You" %>';
    const CURRENT_AVATAR = '<%= user.profileImageURL || "/imgs/default.png" %>';

    const TARGET = '<%= targetUserId %>';

    const EDIT_WINDOW_MS = 60 * 1000;


    let conversationId = null;
    let other = null;

    let socket = null;

    let selectedFile = null;

    let activeMessageId = null;

    let editingMessageId = null;

    let replyingMessageId = null;

    let typingTimer = null;

    let longPressTimer = null;


    const $ = id => document.getElementById(id);


    /* ==========================================
       HELPERS
    ========================================== */

    const escapeHtml = value =>
      String(value ?? '')
        .replace(/[&<>"']/g, char => ({
          '&':'&amp;',
          '<':'&lt;',
          '>':'&gt;',
          '"':'&quot;',
          "'":'&#039;'
        }[char]));


    function imageUrl(value){
      return value &&
             String(value).trim()
        ? String(value)
        : '/imgs/default.png';
    }


    function toast(text){

      const el = $('toast');

      el.textContent = text;

      el.classList.add('show');

      clearTimeout(window.__toastTimer);

      window.__toastTimer = setTimeout(() => {

        el.classList.remove('show');

      },2400);

    }


    function api(url, options = {}){

      return fetch(url,{
        credentials:'same-origin',
        headers:{
          Accept:'application/json',

          ...(options.body instanceof FormData
            ? {}
            : {'Content-Type':'application/json'}),

          ...(options.headers || {})
        },

        ...options
      });

    }


    function messageTime(value){

      if(!value) return '';

      return new Date(value).toLocaleTimeString([],{
        hour:'numeric',
        minute:'2-digit'
      });

    }


    function messageDay(value){

      return new Date(value).toLocaleDateString([],{
        day:'numeric',
        month:'short',
        year:'numeric'
      });

    }


    function isMine(message){

      return String(
        message.senderId?._id ||
        message.senderId
      ) === String(CURRENT);

    }


    function canEdit(message){

      return (
        !message.deleted &&
        isMine(message) &&
        Date.now() -
          new Date(message.createdAt).getTime()
          <= EDIT_WINDOW_MS
      );

    }


    function editRemaining(message){

      return Math.max(
        0,
        EDIT_WINDOW_MS -
        (
          Date.now() -
          new Date(message.createdAt).getTime()
        )
      );

    }


    /* ==========================================
       SCROLL
    ========================================== */

    function scrollBottom(smooth = true){

      const box = $('messages');

      requestAnimationFrame(() => {

        box.scrollTo({
          top:box.scrollHeight,
          behavior:smooth ? 'smooth' : 'auto'
        });

      });

    }


    /* ==========================================
       SENDER INFORMATION
    ========================================== */

    function senderInfo(message){

      if(isMine(message)){

        return {
          name:CURRENT_NAME,
          avatar:CURRENT_AVATAR
        };

      }

      const sender = message.senderId;

      if(sender && typeof sender === 'object'){

        return {
          name:sender.fullName || other?.fullName || 'User',

          avatar:imageUrl(
            sender.profileImageURL ||
            sender.profileImage ||
            other?.profileImageURL
          )
        };

      }

      return {
        name:other?.fullName || 'User',
        avatar:imageUrl(other?.profileImageURL)
      };

    }


    /* ==========================================
       WELCOME
    ========================================== */

    function renderWelcome(){

      if(!other) return;

      $('welcomeAvatar').src =
        imageUrl(other.profileImageURL);

      $('welcomeName').textContent =
        other.fullName || 'User';

    }


    /* ==========================================
       REACTIONS
    ========================================== */

    function renderReactions(message){

      const reactions =
        Array.isArray(message.reactions)
          ? message.reactions
          : [];

      if(!reactions.length){
        return '';
      }

      const counts = {};

      reactions.forEach(reaction => {

        const emoji = reaction.emoji;

        counts[emoji] =
          (counts[emoji] || 0) + 1;

      });


      return `
        <div class="reaction-list">
          ${
            Object.entries(counts)
              .map(([emoji,count]) => `
                <span class="reaction">
                  ${escapeHtml(emoji)}
                  ${count > 1
                    ? `<small>${count}</small>`
                    : ''}
                </span>
              `)
              .join('')
          }
        </div>
      `;

    }


    /* ==========================================
       MESSAGE BUBBLE
    ========================================== */

    function createMessageElement(message, previousMessage){

      const mine = isMine(message);

      const sender = senderInfo(message);

      const row =
        document.createElement('div');

      row.className =
        'message-row ' +
        (mine ? 'mine' : 'theirs');

      row.dataset.message =
        message._id;


      const sameSender =
        previousMessage &&
        String(
          previousMessage.senderId?._id ||
          previousMessage.senderId
        ) ===
        String(
          message.senderId?._id ||
          message.senderId
        );


      let media = '';

      if(
        !message.deleted &&
        message.mediaUrl &&
        message.mediaType === 'image'
      ){

        media = `
          <img
            class="message-media"
            src="${escapeHtml(message.mediaUrl)}"
            alt="Photo"
            loading="lazy">
        `;

      }


      if(
        !message.deleted &&
        message.mediaUrl &&
        message.mediaType === 'video'
      ){

        media = `
          <video
            class="message-media video"
            src="${escapeHtml(message.mediaUrl)}"
            controls
            playsinline
            preload="metadata">
          </video>
        `;

      }


      let replyPreview = '';

      if(
        !message.deleted &&
        message.replyTo
      ){

        replyPreview = `
          <div class="reply-preview">

            <strong>
              ${escapeHtml(
                message.replyTo.senderName ||
                'Reply'
              )}
            </strong>

            ${escapeHtml(
              message.replyTo.text ||
              'Message'
            )}

          </div>
        `;

      }


      let text = '';

      if(message.deleted){

        text = `
          <div class="message-text">
            Message unsent
          </div>
        `;

      }
      else if(message.text){

        text = `
          <div class="message-text">
            ${escapeHtml(message.text)}
            ${
              message.edited
                ? `<span class="message-edited">edited</span>`
                : ''
            }
          </div>
        `;

      }


      const status =
        mine && !message.deleted
          ? `
            <span
              class="message-status ${
                message.status === 'read'
                  ? 'read'
                  : ''
              }">

              ${
                message.status === 'read'
                  ? '✓✓'
                  : message.status === 'delivered'
                    ? '✓✓'
                    : '✓'
              }

            </span>
          `
          : '';


      const avatar =
        !mine
          ? `
            <div class="sender-avatar-wrap">

              <img
                class="sender-avatar ${
                  sameSender ? 'hidden' : ''
                }"
                src="${escapeHtml(sender.avatar)}"
                alt="${escapeHtml(sender.name)}"
                onerror="this.src='/imgs/default.png'">

            </div>
          `
          : `
            <div class="sender-avatar-wrap"></div>
          `;


      const senderName =
        !mine
          ? `
            <div
              class="sender-name ${
                sameSender ? 'hidden' : ''
              }">

              ${escapeHtml(sender.name)}

            </div>
          `
          : '';


      row.innerHTML = `

        ${avatar}

        <div class="message-content">

          ${senderName}

          <div
            class="message-bubble ${
              message.deleted
                ? 'deleted'
                : ''
            }">

            ${replyPreview}

            ${media}

            ${text}

            <div class="message-meta">

              ${messageTime(message.createdAt)}

              ${status}

            </div>

            ${renderReactions(message)}

          </div>

        </div>

      `;


      return row;

    }


    /* ==========================================
       DATE DIVIDER
    ========================================== */

    function addDateDivider(container,message){

      const last =
        container.querySelector(
          '.date-divider:last-of-type'
        );

      const currentDay =
        messageDay(message.createdAt);

      if(
        last &&
        last.dataset.day === currentDay
      ){

        return;

      }


      const divider =
        document.createElement('div');

      divider.className =
        'date-divider';

      divider.dataset.day =
        currentDay;

      divider.textContent =
        currentDay;

      container.appendChild(divider);

    }


    /* ==========================================
       RENDER ALL MESSAGES
    ========================================== */

    function renderMessages(list){

      const box = $('messages');

      box.innerHTML = '';


      if(!list || !list.length){

        box.appendChild(
          $('welcome')
        );

        renderWelcome();

        return;

      }


      list.forEach((message,index) => {

        const previous =
          index > 0
            ? list[index - 1]
            : null;

        addDateDivider(
          box,
          message
        );


        const element =
          createMessageElement(
            message,
            previous
          );


        box.appendChild(element);

        bindMessageGesture(element);

      });


      scrollBottom(false);

    }


    /* ==========================================
       REPLACE MESSAGE
    ========================================== */

    function replaceMessage(message){

      const old =
        document.querySelector(
          `[data-message="${CSS.escape(
            String(message._id)
          )}"]`
        );

      if(!old) return;


      const index =
        window.__messages.findIndex(
          item =>
            String(item._id) ===
            String(message._id)
        );


      const previous =
        index > 0
          ? window.__messages[index - 1]
          : null;


      const fresh =
        createMessageElement(
          message,
          previous
        );


      old.replaceWith(fresh);

      bindMessageGesture(fresh);

    }


    /* ==========================================
       LONG PRESS / CONTEXT MENU
    ========================================== */

    function bindMessageGesture(row){

      const bubble =
        row.querySelector(
          '.message-bubble'
        );

      if(!bubble) return;


      bubble.addEventListener(
        'dblclick',
        () => {

          react(
            row.dataset.message,
            '❤️'
          );

        }
      );


      const start = event => {

        if(
          event.target.closest('video')
        ){

          return;

        }


        clearTimeout(longPressTimer);


        longPressTimer =
          setTimeout(() => {

            openActionSheet(
              row.dataset.message
            );

          },520);

      };


      const end = () => {

        clearTimeout(longPressTimer);

      };


      bubble.addEventListener(
        'pointerdown',
        start
      );

      bubble.addEventListener(
        'pointerup',
        end
      );

      bubble.addEventListener(
        'pointercancel',
        end
      );

      bubble.addEventListener(
        'pointerleave',
        end
      );


      bubble.addEventListener(
        'contextmenu',
        event => {

          event.preventDefault();

          openActionSheet(
            row.dataset.message
          );

        }
      );

    }


    /* ==========================================
       ACTION SHEET
    ========================================== */

    function openActionSheet(id){

      const message =
        window.__messages?.find(
          item =>
            String(item._id) ===
            String(id)
        );


      if(!message) return;


      activeMessageId = id;


      const editable =
        canEdit(message);


      $('editAction')
        .classList
        .toggle(
          'disabled',
          !editable
        );


      $('sheetEditTime').textContent =
        editable
          ? Math.ceil(
              editRemaining(message) / 1000
            ) + 's left'
          : '';


      $('overlay')
        .classList
        .add('open');

      $('actionSheet')
        .classList
        .add('open');


      document.body.style.overflow =
        'hidden';

    }


    function closeActionSheet(){

      activeMessageId = null;

      $('overlay')
        .classList
        .remove('open');

      $('actionSheet')
        .classList
        .remove('open');

      $('emojiMore')
        .classList
        .remove('open');

      document.body.style.overflow =
        '';

    }


    /* ==========================================
       REACTION
    ========================================== */

    function react(id,emoji){

      if(
        !socket ||
        !conversationId
      ){

        return;

      }


      socket.emit(
        'message:react',
        {
          conversationId,
          messageId:id,
          emoji
        }
      );


      closeActionSheet();

    }


    /* ==========================================
       REPLY
    ========================================== */

    function startReply(){

      const message =
        window.__messages?.find(
          item =>
            String(item._id) ===
            String(activeMessageId)
        );


      if(!message){

        closeActionSheet();

        return;

      }


      replyingMessageId =
        message._id;


      const sender =
        senderInfo(message);


      $('replyName').textContent =
        isMine(message)
          ? 'You'
          : sender.name;


      $('replyText').textContent =
        message.text ||
        (
          message.mediaType === 'image'
            ? 'Photo'
            : message.mediaType === 'video'
              ? 'Video'
              : 'Message'
        );


      $('replyBar')
        .classList
        .add('show');


      $('input').focus();

      closeActionSheet();

    }


    function cancelReply(){

      replyingMessageId = null;

      $('replyBar')
        .classList
        .remove('show');

    }


    /* ==========================================
       EDIT
    ========================================== */

    function startEdit(){

      const message =
        window.__messages?.find(
          item =>
            String(item._id) ===
            String(activeMessageId)
        );


      if(
        !message ||
        !canEdit(message)
      ){

        toast(
          'Edit is available for only 1 minute.'
        );

        closeActionSheet();

        return;

      }


      editingMessageId =
        message._id;


      $('input').value =
        message.text || '';


      $('editText').textContent =
        message.text ||
        'Empty message';


      $('editBar')
        .classList
        .add('show');


      $('input').focus();

      resizeInput();

      closeActionSheet();

      updateEditTimer();

    }


    function cancelEdit(){

      editingMessageId = null;

      $('editBar')
        .classList
        .remove('show');

      $('editText').textContent =
        '';

      $('editTime').textContent =
        '';

    }


    function updateEditTimer(){

      if(!editingMessageId) return;


      const message =
        window.__messages?.find(
          item =>
            String(item._id) ===
            String(editingMessageId)
        );


      if(!message){

        cancelEdit();

        return;

      }


      const left =
        editRemaining(message);


      if(left <= 0){

        cancelEdit();

        toast(
          'Edit window expired.'
        );

        return;

      }


      $('editTime').textContent =
        Math.ceil(left / 1000) +
        's';


      setTimeout(
        updateEditTimer,
        1000
      );

    }


    function submitEdit(){

      const text =
        $('input').value.trim();


      if(
        !text ||
        !editingMessageId
      ){

        return;

      }


      if(!socket){

        return;

      }


      socket.emit(
        'message:edit',
        {
          conversationId,
          messageId:editingMessageId,
          text
        }
      );


      cancelEdit();

      $('input').value = '';

      resizeInput();

    }


    /* ==========================================
       COPY
    ========================================== */

    async function copyMessage(){

      const message =
        window.__messages?.find(
          item =>
            String(item._id) ===
            String(activeMessageId)
        );


      if(
        !message ||
        message.deleted
      ){

        closeActionSheet();

        return;

      }


      try{

        await navigator.clipboard.writeText(
          message.text || ''
        );

        toast(
          'Message copied'
        );

      }
      catch(error){

        toast(
          'Unable to copy message'
        );

      }


      closeActionSheet();

    }


    /* ==========================================
       UNSEND
    ========================================== */

    function unsendMessage(){

      const message =
        window.__messages?.find(
          item =>
            String(item._id) ===
            String(activeMessageId)
        );


      if(!message){

        closeActionSheet();

        return;

      }


      if(!isMine(message)){

        toast(
          'You can only unsend your own message.'
        );

        closeActionSheet();

        return;

      }


      if(
        !confirm(
          'Unsend this message for everyone?'
        )
      ){

        closeActionSheet();

        return;

      }


      socket?.emit(
        'message:unsend',
        {
          conversationId,
          messageId:message._id
        }
      );


      closeActionSheet();

    }


    /* ==========================================
       FORWARD
    ========================================== */

    function forwardMessage(){

      const message =
        window.__messages?.find(
          item =>
            String(item._id) ===
            String(activeMessageId)
        );


      if(!message){

        closeActionSheet();

        return;

      }


      closeActionSheet();


      const text =
        message.text ||
        (
          message.mediaType === 'image'
            ? 'Photo'
            : message.mediaType === 'video'
              ? 'Video'
              : 'Message'
        );


      toast(
        'Forward: ' + text.substring(0,50)
      );

      /*
        Your existing backend does not expose
        a confirmed forward endpoint in the
        supplied file, so this UI action does
        not invent one.
      */

    }


    /* ==========================================
       SEND
    ========================================== */

    async function send(){

      const text =
        $('input').value.trim();


      /* EDIT */

      if(editingMessageId){

        submitEdit();

        return;

      }


      if(
        !text &&
        !selectedFile
      ){

        return;

      }


      if(
        !socket ||
        !conversationId
      ){

        toast(
          'Chat is still loading.'
        );

        return;

      }


      $('sendBtn').disabled =
        true;


      try{

        let mediaUrl = '';
        let mediaType = '';


        /* UPLOAD */

        if(selectedFile){

          const form =
            new FormData();

          form.append(
            'media',
            selectedFile
          );


          const response =
            await api(
              '/messages/upload',
              {
                method:'POST',
                body:form
              }
            );


          const data =
            await response.json();


          if(
            !response.ok ||
            !data.success
          ){

            throw new Error(
              data.message ||
              'Unable to upload media'
            );

          }


          mediaUrl =
            data.mediaUrl;

          mediaType =
            data.mediaType;

        }


        /* SEND SOCKET */

        socket.emit(
          'message:send',
          {
            conversationId,
            text,
            mediaUrl,
            mediaType,

            ...(replyingMessageId
              ? {
                  replyTo:
                    replyingMessageId
                }
              : {})
          }
        );


        $('input').value = '';

        cancelReply();

        clearMedia();

        resizeInput();

      }
      catch(error){

        toast(
          error.message
        );

      }
      finally{

        $('sendBtn').disabled =
          false;

      }

    }


    /* ==========================================
       RESIZE INPUT
    ========================================== */

    function resizeInput(){

      const input =
        $('input');

      input.style.height =
        'auto';


      input.style.height =
        Math.min(
          input.scrollHeight,
          120
        ) + 'px';

    }


    /* ==========================================
       MEDIA
    ========================================== */

    function clearMedia(){

      $('mediaInput').value =
        '';

      selectedFile =
        null;


      $('preview')
        .classList
        .remove('show');


      $('previewThumb').innerHTML =
        '';

      $('previewName').textContent =
        '';

    }


    function previewFile(file){

      if(!file) return;


      selectedFile =
        file;


      const url =
        URL.createObjectURL(file);


      $('previewName').textContent =
        file.name;


      $('previewThumb').innerHTML =
        file.type.startsWith('video/')
          ? `
            <video
              src="${url}"
              muted>
            </video>
          `
          : `
            <img
              src="${url}"
              alt="">
          `;


      $('preview')
        .classList
        .add('show');

    }


    /* ==========================================
       INITIALIZE
    ========================================== */

    async function init(){

      try{

        const response =
          await api(
            '/messages/conversation',
            {
              method:'POST',

              body:JSON.stringify({
                userId:TARGET
              })
            }
          );


        const data =
          await response.json();


        if(
          !response.ok ||
          !data.success
        ){

          throw new Error(
            data.message ||
            'Unable to open conversation'
          );

        }


        conversationId =
          data.conversationId;

        other =
          data.target;


        setPerson();


        const history =
          await api(
            '/messages/' +
            encodeURIComponent(
              conversationId
            )
          );


        const historyData =
          await history.json();


        if(
          !history.ok ||
          !historyData.success
        ){

          throw new Error(
            historyData.message ||
            'Unable to load messages'
          );

        }


        window.__messages =
          historyData.messages || [];


        renderMessages(
          window.__messages
        );


        socket =
          io();


        bindSocket();


        socket.emit(
          'conversation:join',
          conversationId
        );


        socket.emit(
          'message:read',
          {
            conversationId
          }
        );

      }
      catch(error){

        $('messages').innerHTML = `

          <div class="welcome">

            <i
              class="fas fa-exclamation-circle"
              style="font-size:30px">
            </i>

            <strong>
              Unable to load chat
            </strong>

            <p>
              ${escapeHtml(
                error.message
              )}
            </p>

            <button
              class="sheet-action"
              style="
                background:#f3f3f3;
                justify-content:center;
                margin-top:10px
              "
              onclick="location.reload()">

              Try again

            </button>

          </div>

        `;

      }

    }


    /* ==========================================
       USER HEADER
    ========================================== */

    function setPerson(){

      const name =
        other?.fullName ||
        'User';


      $('personName').textContent =
        name;


      $('avatar').src =
        imageUrl(
          other?.profileImageURL
        );


      $('welcomeName').textContent =
        name;


      $('welcomeAvatar').src =
        imageUrl(
          other?.profileImageURL
        );


      $('avatar').onerror =
        () => {

          $('avatar').src =
            '/imgs/default.png';

        };


      $('personStatus').textContent =
        other?.isPrivate
          ? 'Private account'
          : 'Message';


      $('profileAction').onclick =
        viewProfile;


      $('profileBtn').onclick =
        viewProfile;


      $('profileBtn').onkeydown =
        event => {

          if(
            event.key === 'Enter'
          ){

            viewProfile();

          }

        };

    }


    function viewProfile(){

      location.href =
        '/user/profile/' +
        encodeURIComponent(
          TARGET
        );

    }


    /* ==========================================
       SOCKET
    ========================================== */

    function bindSocket(){

      socket.on(
        'user:online',
        data => {

          if(
            String(data.userId) ===
            String(TARGET)
          ){

            $('personStatus').textContent =
              'Active now';

            $('personStatus')
              .classList
              .add('online');

          }

        }
      );


      socket.on(
        'user:offline',
        data => {

          if(
            String(data.userId) ===
            String(TARGET)
          ){

            $('personStatus').textContent =
              other?.isPrivate
                ? 'Private account'
                : 'Message';

            $('personStatus')
              .classList
              .remove('online');

          }

        }
      );


      socket.on(
        'typing:start',
        data => {

          if(
            String(data.userId) ===
            String(TARGET)
          ){

            $('typing').textContent =
              (
                other?.fullName ||
                'User'
              ) +
              ' is typing…';

          }

        }
      );


      socket.on(
        'typing:stop',
        data => {

          if(
            String(data.userId) ===
            String(TARGET)
          ){

            $('typing').textContent =
              '';

          }

        }
      );


      /* NEW MESSAGE */

      socket.on(
        'message:new',
        message => {

          if(
            String(message.conversationId) !==
            String(conversationId)
          ){

            return;

          }


          window.__messages =
            window.__messages || [];


          const previous =
            window.__messages[
              window.__messages.length - 1
            ];


          window.__messages.push(
            message
          );


          const welcome =
            $('welcome');


          if(
            welcome &&
            welcome.parentNode
          ){

            welcome.remove();

          }


          addDateDivider(
            $('messages'),
            message
          );


          const element =
            createMessageElement(
              message,
              previous
            );


          $('messages')
            .appendChild(
              element
            );


          bindMessageGesture(
            element
          );


          scrollBottom();


          socket.emit(
            'message:read',
            {
              conversationId
            }
          );

        }
      );


      /* EDIT */

      socket.on(
        'message:edited',
        message => {

          const index =
            window.__messages.findIndex(
              item =>
                String(item._id) ===
                String(message._id)
            );


          if(index >= 0){

            window.__messages[index] =
              message;

          }


          replaceMessage(
            message
          );

        }
      );


      /* UNSEND */

      socket.on(
        'message:unsent',
        data => {

          const index =
            window.__messages.findIndex(
              item =>
                String(item._id) ===
                String(data.messageId)
            );


          if(index >= 0){

            window.__messages[index].deleted =
              true;

            window.__messages[index].text =
              '';

            window.__messages[index].mediaUrl =
              '';

          }


          const row =
            document.querySelector(
              `[data-message="${CSS.escape(
                String(data.messageId)
              )}"]`
            );


          if(!row) return;


          const bubble =
            row.querySelector(
              '.message-bubble'
            );


          bubble.className =
            'message-bubble deleted';


          bubble.innerHTML = `

            <div class="message-text">
              Message unsent
            </div>

            <div class="message-meta">
              ${messageTime(new Date())}
            </div>

          `;

        }
      );


      /* REACTIONS */

      socket.on(
        'message:reactions',
        data => {

          const message =
            window.__messages.find(
              item =>
                String(item._id) ===
                String(data.messageId)
            );


          if(message){

            message.reactions =
              data.reactions;

            replaceMessage(
              message
            );

          }

        }
      );


      /* READ */

      socket.on(
        'message:read',
        data => {

          if(
            String(data.conversationId) !==
            String(conversationId)
          ){

            return;

          }


          window.__messages
            .filter(
              message =>
                isMine(message)
            )
            .forEach(
              message =>
                message.status = 'read'
            );


          document
            .querySelectorAll(
              '.mine .message-status'
            )
            .forEach(
              status => {

                status.textContent =
                  '✓✓';

                status.classList.add(
                  'read'
                );

              }
            );

        }
      );


      socket.on(
        'message:error',
        data => {

          toast(
            data.message ||
            'Unable to send message'
          );

        }
      );


      socket.on(
        'message:action:error',
        data => {

          toast(
            data.message ||
            'Unable to update message'
          );

        }
      );

    }


    /* ==========================================
       EVENTS
    ========================================== */

    $('composer')
      .addEventListener(
        'submit',
        event => {

          event.preventDefault();

          send();

        }
      );


    $('input')
      .addEventListener(
        'input',
        () => {

          resizeInput();


          if(
            socket &&
            conversationId
          ){

            socket.emit(
              'typing:start',
              {
                conversationId
              }
            );


            clearTimeout(
              typingTimer
            );


            typingTimer =
              setTimeout(
                () => {

                  socket.emit(
                    'typing:stop',
                    {
                      conversationId
                    }
                  );

                },
                900
              );

          }

        }
      );


    $('input')
      .addEventListener(
        'keydown',
        event => {

          if(
            event.key === 'Enter' &&
            !event.shiftKey &&
            window.innerWidth > 650
          ){

            event.preventDefault();

            send();

          }

        }
      );


    $('mediaBtn').onclick =
      () => {

        $('mediaInput').click();

      };


    $('mediaInput').onchange =
      event => {

        previewFile(
          event.target.files?.[0]
        );

      };


    $('removeMedia').onclick =
      clearMedia;


    $('cancelEdit').onclick =
      cancelEdit;


    $('cancelReply').onclick =
      cancelReply;


    $('backBtn').onclick =
      () => {

        if(history.length > 1){

          history.back();

        }
        else{

          location.href =
            '/messages/chatlog';

        }

      };


    /* TOP MENU */

    $('menuBtn').onclick =
      event => {

        event.stopPropagation();

        $('topMenu')
          .classList
          .toggle('open');

      };


    $('blockAction').onclick =
      async () => {

        if(
          !confirm(
            'Block this user?'
          )
        ){

          return;

        }


        try{

          const response =
            await api(
              '/messages/block/' +
              TARGET,
              {
                method:'POST'
              }
            );


          const data =
            await response.json();


          if(
            !response.ok ||
            !data.success
          ){

            throw new Error(
              data.message ||
              'Unable to block user'
            );

          }


          toast(
            data.message ||
            'User blocked'
          );


          setTimeout(
            () => {

              location.href =
                '/messages/chatlog';

            },
            700
          );

        }
        catch(error){

          toast(
            error.message
          );

        }

      };


    /* ACTION SHEET */

    $('overlay').onclick =
      closeActionSheet;


    $('closeSheet').onclick =
      closeActionSheet;


    $('replyAction').onclick =
      startReply;


    $('forwardAction').onclick =
      forwardMessage;


    $('editAction').onclick =
      startEdit;


    $('copyAction').onclick =
      copyMessage;


    $('unsendAction').onclick =
      unsendMessage;


    $('moreEmoji').onclick =
      event => {

        event.stopPropagation();

        $('emojiMore')
          .classList
          .toggle('open');

      };


    document
      .querySelectorAll(
        '[data-emoji]'
      )
      .forEach(
        button => {

          button.addEventListener(
            'click',
            () => {

              if(activeMessageId){

                react(
                  activeMessageId,
                  button.dataset.emoji
                );

              }

            }
          );

        }
      );


    /* OUTSIDE CLICK */

    document.addEventListener(
      'click',
      event => {

        if(
          !event.target.closest(
            '.header-actions'
          )
        ){

          $('topMenu')
            .classList
            .remove('open');

        }


        if(
          !event.target.closest(
            '.action-sheet'
          ) &&
          !event.target.closest(
            '.message-bubble'
          )
        ){

          closeActionSheet();

        }

      }
    );


    /* VOICE BUTTON */

    $('voiceBtn').onclick =
      () => {

        toast(
          'Voice messages are ready for backend integration.'
        );

      };


    /* START */

    init();

  </script>

</body>
</html>
```

