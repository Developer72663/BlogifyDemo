<!doctype html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Messages | Blogify</title>
  <style>
    :root{--bg:#fff;--text:#111;--muted:#8a8a8f;--line:#ededed;--soft:#f5f5f7;--incoming:#efefef;--brand:#635bff;--brand2:#7c3aed;--danger:#ed4956;--green:#31c45a;--voice:#ff315c}
    *{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:#fff;color:var(--text)}body{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}button,input,textarea{font:inherit}button{-webkit-tap-highlight-color:transparent}
    .page{height:calc(100dvh - 70px);min-height:520px;display:flex;justify-content:center;background:#fff}.chat{width:100%;height:100%;display:grid;grid-template-rows:62px minmax(0,1fr) auto;background:#fff;overflow:hidden;position:relative}
    @media(min-width:601px) and (max-width:899px){.page{height:calc(100dvh - 84px);min-height:560px;padding:14px 18px 20px;background:#f7f7f8}.chat{border:1px solid var(--line);border-radius:20px;box-shadow:0 8px 30px rgba(0,0,0,.06)}}
    @media(min-width:900px){.page{height:calc(100dvh - 98px);min-height:600px;padding:18px 24px 24px;background:#f7f7f8}.chat{width:min(980px,100%);border:1px solid var(--line);border-radius:22px;box-shadow:0 10px 40px rgba(0,0,0,.07)}}
    .header{height:62px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px;padding:7px 12px;background:rgba(255,255,255,.98);z-index:30}.icon{width:42px;height:42px;border:0;border-radius:50%;background:transparent;display:grid;place-items:center;cursor:pointer;color:#111}.icon:hover{background:#f5f5f5}.user-head{flex:1;min-width:0;display:flex;align-items:center;gap:10px;cursor:pointer}.head-avatar{width:40px;height:40px;border-radius:50%;object-fit:cover;background:#eee}.head-info{min-width:0}.head-name{font-size:15px;font-weight:780;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.head-status{font-size:11px;color:var(--muted);margin-top:2px}.head-status.online{color:var(--green)}.head-actions{position:relative;display:flex}.menu{display:none;position:absolute;right:0;top:48px;width:215px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:5px;box-shadow:0 16px 45px rgba(0,0,0,.16);z-index:80}.menu.open{display:block}.menu button{width:100%;border:0;background:transparent;border-radius:9px;padding:11px;text-align:left;display:flex;gap:10px;align-items:center;cursor:pointer}.menu button:hover{background:#f5f5f5}.menu .danger{color:var(--danger)}
    .messages{min-height:0;overflow-y:auto;overflow-x:hidden;display:flex;flex-direction:column;justify-content:flex-start;padding:12px 12px 18px;background:#fff;scroll-behavior:smooth;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#d5d5d8 transparent}.messages::-webkit-scrollbar{width:5px}.messages::-webkit-scrollbar-thumb{background:#d5d5d8;border-radius:99px}
    .welcome{margin:auto;text-align:center;color:var(--muted);width:min(320px,90%);padding:30px}.welcome-avatar{width:82px;height:82px;border-radius:50%;object-fit:cover;margin-bottom:12px}.welcome strong{display:block;color:#111;font-size:16px}.welcome p{font-size:13px;line-height:1.5;margin:6px 0}.date{align-self:center;color:#999;font-size:10px;font-weight:650;margin:10px 0 5px;padding:4px 8px}
    .row{display:flex;align-items:flex-end;gap:6px;width:100%;margin:1px 0;position:relative}.row.mine{justify-content:flex-end}.row.theirs{justify-content:flex-start}.sender{width:28px;min-width:28px;height:28px;display:flex;align-items:flex-end;justify-content:center}.sender img{width:27px;height:27px;border-radius:50%;object-fit:cover;background:#eee}.sender img.hidden{visibility:hidden}.content{max-width:min(72%,620px);min-width:0}.name{font-size:10px;color:#777;font-weight:650;margin:0 0 2px 5px}.name.hidden{height:0;visibility:hidden;margin:0}.bubble{display:inline-block;max-width:100%;padding:8px 11px;border-radius:18px;background:var(--incoming);color:#111;font-size:14px;line-height:1.42;word-break:break-word;overflow-wrap:anywhere;white-space:pre-wrap;position:relative;user-select:none;-webkit-user-select:none;touch-action:manipulation}.theirs .bubble{border-bottom-left-radius:5px}.mine .bubble{background:linear-gradient(135deg,var(--brand),var(--brand2));color:#fff;border-bottom-right-radius:5px}.bubble.deleted{background:#f1f1f1!important;color:#999!important;font-style:italic}.meta{font-size:9px;opacity:.5;text-align:right;margin-top:3px;white-space:nowrap;line-height:1.2}.status{margin-left:4px}.status.read{color:#c9faff}.edited{font-size:9px;opacity:.65;margin-left:4px}.media{display:block;width:min(300px,70vw);max-height:390px;object-fit:cover;border-radius:15px;margin-bottom:4px;background:#111}.media.video{background:#000}.media.audio{width:min(290px,70vw);height:42px;border-radius:18px}.reply-preview{border-left:3px solid #aaa;padding-left:7px;margin-bottom:6px;font-size:11px;opacity:.72;line-height:1.3}.mine .reply-preview{border-left-color:rgba(255,255,255,.65)}.reply-preview strong{display:block;font-size:10px;margin-bottom:2px}.reactions{position:absolute;left:5px;bottom:-10px;display:flex;gap:3px;z-index:5}.mine .reactions{left:auto;right:5px}.reaction{min-width:25px;height:22px;padding:2px 6px;border:1px solid #ddd;border-radius:99px;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.12);display:grid;place-items:center;font-size:12px;color:#111}.reaction small{font-size:9px;margin-left:2px}
    .typing{height:18px;padding:0 16px;background:#fff;color:#888;font-size:10px}.typing:empty{visibility:hidden}.composer-area{border-top:1px solid var(--line);background:#fff}.preview,.replybar,.editbar{display:none;align-items:center;gap:9px;padding:8px 12px;background:#fafafa;border-bottom:1px solid var(--line)}.preview.show,.replybar.show,.editbar.show{display:flex}.thumb{width:48px;height:48px;border-radius:9px;overflow:hidden;background:#111;flex:none}.thumb img,.thumb video{width:100%;height:100%;object-fit:cover}.preview-name,.bar-copy{flex:1;min-width:0;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bar-copy strong{display:block;font-size:11px;margin-bottom:2px}.bar-copy span{color:#888}.cancel{border:0;background:transparent;color:#777;cursor:pointer;font-weight:650}.bar-icon{width:32px;height:32px;border-radius:50%;background:#eee;display:grid;place-items:center;flex:none}.bar-time{margin-left:auto;color:#888;font-size:10px}.composer{display:flex;align-items:flex-end;gap:5px;padding:8px 9px max(9px,env(safe-area-inset-bottom));background:#fff}.add,.voice,.send{width:42px;height:42px;border:0;border-radius:50%;display:grid;place-items:center;cursor:pointer;flex:none}.add{background:transparent;color:var(--brand);font-size:19px}.voice{background:transparent;color:#111}.send{background:var(--brand);color:#fff}.add:hover,.voice:hover{background:#f5f5f5}.send:hover{background:#5148e5}.send:disabled{opacity:.45}.voice.recording{background:#fff0f3;color:var(--voice);animation:pulse 1s infinite}.voice.recording i{transform:scale(1.15)}@keyframes pulse{50%{box-shadow:0 0 0 7px rgba(255,49,92,.10)}}.input-wrap{flex:1;min-width:0;border:1px solid #ddd;background:#f6f6f6;border-radius:22px;padding:0 11px;display:flex;align-items:flex-end}.input-wrap:focus-within{background:#fff;border-color:#b8b3ff;box-shadow:0 0 0 3px rgba(99,91,255,.07)}.input{width:100%;min-height:40px;max-height:120px;border:0;outline:0;resize:none;background:transparent;padding:10px 0;color:#111;line-height:1.4;font-size:14px}#mediaInput{display:none}
    .recording-bar{display:none;align-items:center;gap:10px;padding:8px 12px;background:#fff4f6;border-bottom:1px solid #ffd9e0;color:#c51f42;font-size:11px}.recording-bar.show{display:flex}.record-dot{width:8px;height:8px;border-radius:50%;background:var(--voice);animation:blink 1s infinite}.record-time{font-variant-numeric:tabular-nums;font-weight:800}.record-hint{margin-left:auto;color:#888}.record-stop{border:0;background:#fff;color:var(--voice);font-weight:800;cursor:pointer;border-radius:9px;padding:5px 9px}
    .overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);opacity:0;visibility:hidden;pointer-events:none;transition:.18s;z-index:100}.overlay.open{opacity:1;visibility:visible;pointer-events:auto}.sheet{position:fixed;left:50%;bottom:10px;transform:translate(-50%,20px);width:min(500px,calc(100vw - 16px));background:#fff;border-radius:20px;padding:8px;box-shadow:0 25px 70px rgba(0,0,0,.25);opacity:0;visibility:hidden;pointer-events:none;transition:.2s;z-index:101}.sheet.open{opacity:1;visibility:visible;pointer-events:auto;transform:translate(-50%,0)}.react-row{display:flex;gap:4px;padding:3px 2px 9px;border-bottom:1px solid var(--line)}.emoji{flex:1;height:44px;border:0;border-radius:12px;background:#f3f3f3;font-size:20px;cursor:pointer}.emoji:hover{background:#e8e8e8}.more{display:none;flex-wrap:wrap;gap:5px;padding:8px 2px 3px}.more.open{display:flex}.more button{width:39px;height:37px;border:0;border-radius:9px;background:#f3f3f3;cursor:pointer;font-size:17px}.action{width:100%;height:43px;border:0;border-radius:10px;background:transparent;display:flex;align-items:center;gap:11px;padding:0 12px;cursor:pointer;font-weight:650;text-align:left}.action:hover{background:#f3f3f3}.action.danger{color:var(--danger)}.action.disabled{opacity:.4;pointer-events:none}.action.close{background:#f3f3f3;margin-top:4px}.action-time{margin-left:auto;font-size:10px;color:#888}.toast{position:fixed;left:50%;bottom:78px;transform:translateX(-50%);background:#111;color:#fff;padding:9px 14px;border-radius:99px;font-size:11px;opacity:0;pointer-events:none;transition:.2s;z-index:150}.toast.show{opacity:1}@keyframes blink{50%{opacity:.35}}
    @media(max-width:600px){.page{height:calc(100dvh - 56px);min-height:0}.header{height:58px;padding:6px 8px}.head-avatar{width:38px;height:38px}.icon{width:39px;height:39px}.messages{padding:10px 7px 16px}.content{max-width:84%}.bubble{font-size:14px;padding:8px 10px}.media{width:min(290px,72vw)}.sheet{left:0;right:0;bottom:0;width:100%;transform:translateY(20px);border-radius:20px 20px 0 0;padding-bottom:max(9px,env(safe-area-inset-bottom))}.sheet.open{transform:translateY(0)}}
    @media(min-width:900px){.messages{padding-left:clamp(28px,6vw,80px);padding-right:clamp(28px,6vw,80px)}.content{max-width:65%}}
  </style>
</head>
<body>
  <%- include('./partials/nave') %>
  <main class="page"><section class="chat">
    <header class="header"><button class="icon" id="backBtn" aria-label="Back"><i class="fas fa-arrow-left"></i></button><div class="user-head" id="profileBtn" role="button" tabindex="0"><img class="head-avatar" id="avatar" src="/imgs/default.png" alt=""><div class="head-info"><div class="head-name" id="personName">Loading…</div><div class="head-status" id="personStatus">Message</div></div></div><div class="head-actions"><button class="icon" id="menuBtn" aria-label="More"><i class="fas fa-ellipsis-v"></i></button><div class="menu" id="topMenu"><button id="profileAction"><i class="fas fa-user"></i> View profile</button><button id="blockAction" class="danger"><i class="fas fa-ban"></i> Block user</button></div></div></header>
    <div class="messages" id="messages" aria-live="polite"><div class="welcome" id="welcome"><img class="welcome-avatar" id="welcomeAvatar" src="/imgs/default.png" alt=""><strong id="welcomeName">Starting chat…</strong><p>Send a message to start your conversation.</p></div></div><div class="typing" id="typing"></div>
    <div class="composer-area"><div class="preview" id="preview"><div class="thumb" id="previewThumb"></div><div class="preview-name" id="previewName"></div><button class="cancel" id="removeMedia" type="button">×</button></div><div class="replybar" id="replyBar"><div class="bar-icon"><i class="fas fa-reply"></i></div><div class="bar-copy"><strong id="replyName">Reply</strong><span id="replyText"></span></div><button class="cancel" id="cancelReply" type="button">×</button></div><div class="editbar" id="editBar"><div class="bar-icon"><i class="fas fa-pen"></i></div><div class="bar-copy"><strong>Editing message</strong><span id="editText"></span></div><span class="bar-time" id="editTime"></span><button class="cancel" id="cancelEdit" type="button">Cancel</button></div><div class="recording-bar" id="recordingBar"><span class="record-dot"></span><span>Recording</span><span class="record-time" id="recordTime">0:00</span><span class="record-hint">Tap microphone to stop</span><button class="record-stop" id="recordStop" type="button">Stop</button></div><form class="composer" id="composer"><button type="button" class="add" id="mediaBtn" aria-label="Add photo or video"><i class="fas fa-plus-circle"></i></button><input id="mediaInput" type="file" accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime"><div class="input-wrap"><textarea id="input" class="input" rows="1" maxlength="5000" placeholder="Message…" autocomplete="off"></textarea></div><button class="voice" id="voiceBtn" type="button" aria-label="Record voice"><i class="fas fa-microphone"></i></button><button class="send" id="sendBtn" type="submit" aria-label="Send"><i class="fas fa-paper-plane"></i></button></form></div>
  </section></main>
  <div class="overlay" id="overlay"></div><div class="sheet" id="sheet"><div class="react-row"><button class="emoji" data-emoji="❤️">❤️</button><button class="emoji" data-emoji="😂">😂</button><button class="emoji" data-emoji="😮">😮</button><button class="emoji" data-emoji="😢">😢</button><button class="emoji" id="moreEmoji" type="button">＋</button></div><div class="more" id="moreEmojis"><button data-emoji="👍">👍</button><button data-emoji="😍">😍</button><button data-emoji="🔥">🔥</button><button data-emoji="👏">👏</button><button data-emoji="😡">😡</button><button data-emoji="🙏">🙏</button><button data-emoji="🎉">🎉</button><button data-emoji="💯">💯</button></div><button class="action" id="replyAction" type="button"><i class="fas fa-reply"></i> Reply</button><button class="action" id="forwardAction" type="button"><i class="fas fa-share"></i> Forward</button><button class="action" id="editAction" type="button"><i class="fas fa-pen"></i> Edit <span class="action-time" id="sheetEditTime"></span></button><button class="action" id="copyAction" type="button"><i class="far fa-copy"></i> Copy</button><button class="action danger" id="unsendAction" type="button"><i class="fas fa-trash-alt"></i> Unsend</button><button class="action close" id="closeSheet" type="button"><i class="fas fa-times"></i> Cancel</button></div><div class="toast" id="toast"></div>
  <%- include('./partials/scripts') %><script src="/socket.io/socket.io.js"></script>
  <script>
    const CURRENT='<%=user._id%>',CURRENT_NAME='<%=user.fullName||"You"%>',CURRENT_AVATAR='<%=user.profileImageURL||"/imgs/default.png"%>',TARGET='<%=targetUserId%>',EDIT_WINDOW=60000;let conversationId=null,other=null,socket=null,selectedFile=null,activeId=null,editingId=null,replyingId=null,typingTimer=null,longTimer=null,mediaRecorder=null,recordChunks=[],recordStartedAt=0,recordTimer=null;const $=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));const img=v=>v&&String(v).trim()?String(v):'/imgs/default.png';const mine=m=>String(m.senderId?._id||m.senderId)===String(CURRENT);const time=v=>v?new Date(v).toLocaleTimeString([],{hour:'numeric',minute:'2-digit'}):'';const day=v=>new Date(v).toLocaleDateString([],{day:'numeric',month:'short',year:'numeric'});const left=m=>Math.max(0,EDIT_WINDOW-(Date.now()-new Date(m.createdAt).getTime()));const canEdit=m=>!m.deleted&&mine(m)&&left(m)>0;
    function toast(t){const e=$('toast');e.textContent=t;e.classList.add('show');clearTimeout(window.__toast);window.__toast=setTimeout(()=>e.classList.remove('show'),2300)}function api(u,o={}){return fetch(u,{credentials:'same-origin',headers:{Accept:'application/json',...(o.body instanceof FormData?{}:{'Content-Type':'application/json'}),...(o.headers||{})},...o})}function scrollBottom(s=true){requestAnimationFrame(()=>$('messages').scrollTo({top:$('messages').scrollHeight,behavior:s?'smooth':'auto'}))}
    function sender(m){if(mine(m))return{name:CURRENT_NAME,avatar:img(CURRENT_AVATAR)};const s=m.senderId&&typeof m.senderId==='object'?m.senderId:null;return{name:s?.fullName||other?.fullName||'User',avatar:img(s?.profileImageURL||s?.profileImage||other?.profileImageURL)}}function reactions(m){const rs=Array.isArray(m.reactions)?m.reactions:[],c={};rs.forEach(r=>c[r.emoji]=(c[r.emoji]||0)+1);if(!Object.keys(c).length)return'';return'<div class="reactions">'+Object.entries(c).map(([e,n])=>`<span class="reaction">${esc(e)}${n>1?`<small>${n}</small>`:''}</span>`).join('')+'</div>'}
    function make(m,prev){const isM=mine(m),s=sender(m),same=prev&&String(prev.senderId?._id||prev.senderId)===String(m.senderId?._id||m.senderId);let media='';if(!m.deleted&&m.mediaUrl&&m.mediaType==='image')media=`<img class="media" src="${esc(m.mediaUrl)}" alt="Photo" loading="lazy">`;if(!m.deleted&&m.mediaUrl&&m.mediaType==='video')media=`<video class="media video" src="${esc(m.mediaUrl)}" controls playsinline preload="metadata"></video>`;if(!m.deleted&&m.mediaUrl&&m.mediaType==='audio')media=`<audio class="media audio" src="${esc(m.mediaUrl)}" controls preload="metadata"></audio>`;let rp='';if(!m.deleted&&m.replyTo)rp=`<div class="reply-preview"><strong>${esc(m.replyTo.senderName||'Reply')}</strong>${esc(m.replyTo.text||'Message')}</div>`;let text=m.deleted?'<div>Message unsent</div>':m.text?`<div>${esc(m.text)}${m.edited?'<span class="edited">edited</span>':''}</div>`:'';const status=isM&&!m.deleted?`<span class="status ${m.status==='read'?'read':''}">${m.status==='read'||m.status==='delivered'?'✓✓':'✓'}</span>`:'';const row=document.createElement('div');row.className='row '+(isM?'mine':'theirs');row.dataset.message=m._id;row.innerHTML=!isM?`<div class="sender"><img class="${same?'hidden':''}" src="${esc(s.avatar)}" alt="${esc(s.name)}" onerror="this.src='/imgs/default.png'"></div><div class="content"><div class="name ${same?'hidden':''}">${esc(s.name)}</div><div class="bubble ${m.deleted?'deleted':''}">${rp}${media}${text}<div class="meta">${time(m.createdAt)}${status}</div>${reactions(m)}</div></div>`:`<div class="content"><div class="bubble ${m.deleted?'deleted':''}">${rp}${media}${text}<div class="meta">${time(m.createdAt)}${status}</div>${reactions(m)}</div></div>`;bind(row);return row}
    function addDate(box,m){const last=box.querySelector('.date:last-of-type'),d=day(m.createdAt);if(last&&last.dataset.day===d)return;const x=document.createElement('div');x.className='date';x.dataset.day=d;x.textContent=d;box.appendChild(x)}function render(list){const box=$('messages');box.innerHTML='';if(!list.length){box.innerHTML='<div class="welcome"><img class="welcome-avatar" src="'+esc(img(other?.profileImageURL))+'" alt=""><strong>'+esc(other?.fullName||'User')+'</strong><p>Send a message to start your conversation.</p></div>';return}list.forEach((m,i)=>{addDate(box,m);box.appendChild(make(m,i?list[i-1]:null))});scrollBottom(false)}
    function bind(row){const b=row.querySelector('.bubble');if(!b)return;b.ondblclick=()=>react(row.dataset.message,'❤️');const start=e=>{if(e.target.closest('video,audio'))return;clearTimeout(longTimer);longTimer=setTimeout(()=>openSheet(row.dataset.message),520)};const end=()=>clearTimeout(longTimer);b.addEventListener('pointerdown',start);b.addEventListener('pointerup',end);b.addEventListener('pointercancel',end);b.addEventListener('pointerleave',end);b.oncontextmenu=e=>{e.preventDefault();openSheet(row.dataset.message)}}function openSheet(id){const m=window.__messages?.find(x=>String(x._id)===String(id));if(!m)return;activeId=id;$('editAction').classList.toggle('disabled',!canEdit(m));$('sheetEditTime').textContent=canEdit(m)?Math.ceil(left(m)/1000)+'s left':'';$('overlay').classList.add('open');$('sheet').classList.add('open');document.body.style.overflow=''}function closeSheet(){activeId=null;$('overlay').classList.remove('open');$('sheet').classList.remove('open');$('moreEmojis').classList.remove('open');document.body.style.overflow=''}function react(id,emoji){if(socket&&conversationId)socket.emit('message:react',{conversationId,messageId:id,emoji});closeSheet()}
    function startReply(){const m=window.__messages?.find(x=>String(x._id)===String(activeId));if(!m)return closeSheet();const s=sender(m);replyingId=m._id;$('replyName').textContent=mine(m)?'You':s.name;$('replyText').textContent=m.text||(m.mediaType==='image'?'Photo':m.mediaType==='video'?'Video':m.mediaType==='audio'?'Voice message':'Message');$('replyBar').classList.add('show');$('input').focus();closeSheet()}function cancelReply(){$('replyBar').classList.remove('show');replyingId=null}function startEdit(){const m=window.__messages?.find(x=>String(x._id)===String(activeId));if(!m||!canEdit(m)){toast('Edit is available for only 1 minute.');return closeSheet()}editingId=m._id;$('input').value=m.text||'';$('editText').textContent=m.text||'Empty message';$('editBar').classList.add('show');$('input').focus();resize();closeSheet();editTimer()}function cancelEdit(){editingId=null;$('editBar').classList.remove('show');$('editText').textContent='';$('editTime').textContent=''}function editTimer(){if(!editingId)return;const m=window.__messages?.find(x=>String(x._id)===String(editingId));if(!m)return cancelEdit();const n=left(m);if(n<=0){cancelEdit();toast('Edit window expired.');return}$('editTime').textContent=Math.ceil(n/1000)+'s';setTimeout(editTimer,1000)}
    function copyMessage(){const m=window.__messages?.find(x=>String(x._id)===String(activeId));if(!m||m.deleted)return closeSheet();navigator.clipboard?.writeText(m.text||'').then(()=>toast('Message copied')).catch(()=>toast('Unable to copy message'));closeSheet()}function unsend(){const m=window.__messages?.find(x=>String(x._id)===String(activeId));if(!m)return closeSheet();if(!mine(m)){toast('You can only unsend your own message.');return closeSheet()}if(confirm('Unsend this message for everyone?'))socket?.emit('message:unsend',{conversationId,messageId:m._id});closeSheet()}function forward(){const m=window.__messages?.find(x=>String(x._id)===String(activeId));closeSheet();if(m)toast('Forward: '+(m.text||'Message').slice(0,45))}
    function resize(){const x=$('input');x.style.height='auto';x.style.height=Math.min(x.scrollHeight,120)+'px'}function clearMedia(){$('mediaInput').value='';selectedFile=null;$('preview').classList.remove('show');$('previewThumb').innerHTML='';$('previewName').textContent=''}function previewFile(f){if(!f)return;selectedFile=f;const u=URL.createObjectURL(f);$('previewName').textContent=f.name;$('previewThumb').innerHTML=f.type.startsWith('video/')?`<video src="${u}" muted></video>`:`<img src="${u}" alt="">`;$('preview').classList.add('show')}
    async function send(){const text=$('input').value.trim();if(editingId){if(text)socket?.emit('message:edit',{conversationId,messageId:editingId,text});cancelEdit();$('input').value='';resize();return}if(!text&&!selectedFile)return;if(!socket||!conversationId)return toast('Chat is still loading');$('sendBtn').disabled=true;try{let mediaUrl='',mediaType='';if(selectedFile){const fd=new FormData();fd.append('media',selectedFile);const r=await api('/messages/upload',{method:'POST',body:fd}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to upload media');mediaUrl=d.mediaUrl;mediaType=d.mediaType}socket.emit('message:send',{conversationId,text,mediaUrl,mediaType,...(replyingId?{replyTo:replyingId}:{})});$('input').value='';cancelReply();clearMedia();resize()}catch(e){toast(e.message)}finally{$('sendBtn').disabled=false}}
    function startRecording(){if(!navigator.mediaDevices?.getUserMedia||!window.MediaRecorder)return toast('Voice recording is not supported on this device/browser.');navigator.mediaDevices.getUserMedia({audio:true}).then(stream=>{recordChunks=[];mediaRecorder=new MediaRecorder(stream);recordStartedAt=Date.now();$('recordingBar').classList.add('show');$('voiceBtn').classList.add('recording');mediaRecorder.ondataavailable=e=>{if(e.data.size)recordChunks.push(e.data)};mediaRecorder.onstop=finishRecording;mediaRecorder.start();updateRecordTimer()}).catch(()=>toast('Microphone permission was denied.'))}function updateRecordTimer(){if(!mediaRecorder||mediaRecorder.state!=='recording')return;const sec=Math.floor((Date.now()-recordStartedAt)/1000);$('recordTime').textContent=Math.floor(sec/60)+':'+String(sec%60).padStart(2,'0');recordTimer=setTimeout(updateRecordTimer,500)}function stopRecording(){if(mediaRecorder&&mediaRecorder.state==='recording')mediaRecorder.stop()}async function finishRecording(){clearTimeout(recordTimer);$('recordingBar').classList.remove('show');$('voiceBtn').classList.remove('recording');mediaRecorder.stream?.getTracks().forEach(t=>t.stop());const type=mediaRecorder.mimeType||'audio/webm';const blob=new Blob(recordChunks,{type});mediaRecorder=null;if(blob.size<1000)return toast('Recording was too short.');try{const ext=type.includes('mp4')?'m4a':type.includes('ogg')?'ogg':'webm';const file=new File([blob],'voice-'+Date.now()+'.'+ext,{type});const fd=new FormData();fd.append('media',file);const r=await api('/messages/upload',{method:'POST',body:fd}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Voice upload is not supported by the server yet.');socket?.emit('message:send',{conversationId,text:'',mediaUrl:d.mediaUrl,mediaType:d.mediaType||'audio'});toast('Voice message sent')}catch(e){toast(e.message)}}
    function setPerson(){if(!other)return;const n=other.fullName||'User';$('personName').textContent=n;$('avatar').src=img(other.profileImageURL);$('welcomeName').textContent=n;$('welcomeAvatar').src=img(other.profileImageURL);$('personStatus').textContent=other.isPrivate?'Private account':'Message';$('profileAction').onclick=()=>location.href='/user/profile/'+encodeURIComponent(TARGET);$('profileBtn').onclick=()=>location.href='/user/profile/'+encodeURIComponent(TARGET)}
    async function init(){try{const r=await api('/messages/conversation',{method:'POST',body:JSON.stringify({userId:TARGET})}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to open conversation');conversationId=d.conversationId;other=d.target;setPerson();const h=await api('/messages/'+encodeURIComponent(conversationId)),hd=await h.json();if(!h.ok||!hd.success)throw new Error(hd.message||'Unable to load messages');window.__messages=hd.messages||[];render(window.__messages);socket=io({withCredentials:true});bindSocket();socket.emit('conversation:join',conversationId);socket.emit('message:read',{conversationId})}catch(e){$('messages').innerHTML='<div class="welcome"><i class="fas fa-exclamation-circle" style="font-size:30px"></i><strong>Unable to load chat</strong><p>'+esc(e.message)+'</p><button class="action" onclick="location.reload()">Try again</button></div>'}}
    function bindSocket(){socket.on('user:online',d=>{if(String(d.userId)===String(TARGET)){$('personStatus').textContent='Active now';$('personStatus').classList.add('online')}});socket.on('user:offline',d=>{if(String(d.userId)===String(TARGET)){$('personStatus').textContent=other?.isPrivate?'Private account':'Message';$('personStatus').classList.remove('online')}});socket.on('typing:start',d=>{if(String(d.userId)===String(TARGET))$('typing').textContent=(other?.fullName||'User')+' is typing…'});socket.on('typing:stop',d=>{if(String(d.userId)===String(TARGET))$('typing').textContent=''});socket.on('message:new',m=>{if(String(m.conversationId)!==String(conversationId))return;window.__messages.push(m);const w=$('welcome');if(w?.parentNode)w.remove();addDate($('messages'),m);$('messages').appendChild(make(m,window.__messages[window.__messages.length-2]));scrollBottom();socket.emit('message:read',{conversationId})});socket.on('message:edited',m=>{const i=window.__messages.findIndex(x=>String(x._id)===String(m._id));if(i>=0)window.__messages[i]=m;const old=document.querySelector(`[data-message="${CSS.escape(String(m._id))}"]`);if(old)old.replaceWith(make(m,i?window.__messages[i-1]:null))});socket.on('message:unsent',d=>{const m=window.__messages.find(x=>String(x._id)===String(d.messageId));if(m){m.deleted=true;m.text='';m.mediaUrl=''}const row=document.querySelector(`[data-message="${CSS.escape(String(d.messageId))}"]`);if(row){const b=row.querySelector('.bubble');b.className='bubble deleted';b.innerHTML='<div>Message unsent</div><div class="meta">'+time(new Date())+'</div>'}});socket.on('message:reactions',d=>{const m=window.__messages.find(x=>String(x._id)===String(d.messageId));if(m){m.reactions=d.reactions;const row=document.querySelector(`[data-message="${CSS.escape(String(d.messageId))}"]`);if(row)row.replaceWith(make(m,window.__messages[window.__messages.indexOf(m)-1]))}});socket.on('message:read',d=>{if(String(d.conversationId)!==String(conversationId))return;window.__messages.filter(m=>mine(m)).forEach(m=>m.status='read');document.querySelectorAll('.mine .status').forEach(s=>{s.textContent='✓✓';s.classList.add('read')})});socket.on('message:error',d=>toast(d.message||'Unable to send message'));socket.on('message:action:error',d=>toast(d.message||'Unable to update message'))}
    $('composer').onsubmit=e=>{e.preventDefault();send()};$('input').oninput=()=>{resize();if(socket&&conversationId){socket.emit('typing:start',{conversationId});clearTimeout(typingTimer);typingTimer=setTimeout(()=>socket.emit('typing:stop',{conversationId}),900)}};$('input').onkeydown=e=>{if(e.key==='Enter'&&!e.shiftKey&&innerWidth>650){e.preventDefault();send()}};$('mediaBtn').onclick=()=>$('mediaInput').click();$('mediaInput').onchange=e=>previewFile(e.target.files?.[0]);$('removeMedia').onclick=clearMedia;$('cancelReply').onclick=cancelReply;$('cancelEdit').onclick=cancelEdit;$('backBtn').onclick=()=>history.length>1?history.back():location.href='/messages/chatlog';$('menuBtn').onclick=e=>{e.stopPropagation();$('topMenu').classList.toggle('open')};$('blockAction').onclick=async()=>{if(!confirm('Block this user?'))return;try{const r=await api('/messages/block/'+TARGET,{method:'POST'}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to block');toast(d.message||'User blocked');setTimeout(()=>location.href='/messages/chatlog',600)}catch(e){toast(e.message)}};$('overlay').onclick=closeSheet;$('closeSheet').onclick=closeSheet;$('replyAction').onclick=startReply;$('forwardAction').onclick=forward;$('editAction').onclick=startEdit;$('copyAction').onclick=copyMessage;$('unsendAction').onclick=unsend;$('moreEmoji').onclick=e=>{e.stopPropagation();$('moreEmojis').classList.toggle('open')};document.querySelectorAll('[data-emoji]').forEach(b=>b.onclick=()=>{if(activeId)react(activeId,b.dataset.emoji)});$('voiceBtn').onclick=()=>mediaRecorder?.state==='recording'?stopRecording():startRecording();$('recordStop').onclick=stopRecording;document.addEventListener('click',e=>{if(!e.target.closest('.head-actions'))$('topMenu').classList.remove('open');if(!e.target.closest('.sheet')&&!e.target.closest('.bubble'))closeSheet()});init();
  </script>
</body>
