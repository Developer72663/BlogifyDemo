<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Messages | Blogify</title>
  <style>
    :root{--bg:#000;--surface:#000;--surface2:#121212;--surface3:#262626;--text:#fff;--muted:#a8a8a8;--border:#262626;--blue:#0095f6;--green:#1eb053;--danger:#ed4956;--menu:#1c1c1c}
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{width:100%;height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
    body{overflow:hidden}
    button,input,textarea{font:inherit}button{cursor:pointer}
    .messages-page{width:100%;height:calc(100dvh - 60px);display:flex;justify-content:center;background:var(--bg)}
    .chat-container{width:100%;height:100%;max-width:1100px;display:grid;grid-template-rows:64px minmax(0,1fr) auto;background:var(--surface);overflow:hidden}
    @media(min-width:900px){.messages-page{padding:18px;height:calc(100dvh - 60px)}.chat-container{border:1px solid var(--border);border-radius:14px}}

    .chat-header{height:64px;display:flex;align-items:center;padding:8px 14px;border-bottom:1px solid var(--border);background:var(--surface);z-index:30}
    .back-button,.header-action{width:40px;height:40px;display:grid;place-items:center;border:0;background:transparent;color:var(--text);border-radius:50%}
    .back-button{margin-right:7px;font-size:19px}.back-button:hover,.header-action:hover{background:var(--surface2)}
    .chat-user{display:flex;align-items:center;min-width:0;flex:1;cursor:pointer}
    .header-avatar{width:40px;height:40px;border-radius:50%;object-fit:cover;margin-right:11px;background:var(--surface3)}
    .header-user-info{min-width:0}.header-name{font-size:15px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.header-status{margin-top:2px;font-size:12px;color:var(--muted)}.header-status.online{color:var(--green)}
    .header-actions{position:relative;display:flex;align-items:center}

    .conversation-menu{position:absolute;right:0;top:47px;width:220px;padding:6px;background:var(--menu);border:1px solid var(--border);border-radius:14px;box-shadow:0 16px 45px rgba(0,0,0,.42);opacity:0;visibility:hidden;transform:translateY(-5px);transition:.16s;z-index:80}
    .conversation-menu.open{opacity:1;visibility:visible;transform:translateY(0)}
    .conversation-menu button{width:100%;height:44px;border:0;background:transparent;color:var(--text);border-radius:9px;display:flex;align-items:center;gap:12px;padding:0 12px;text-align:left;font-size:14px}
    .conversation-menu button:hover{background:var(--surface3)}.conversation-menu button i{width:18px;text-align:center}.conversation-menu .danger{color:var(--danger)}

    .messages-area{min-height:0;overflow-y:auto;overflow-x:hidden;padding:18px 20px 28px;display:flex;flex-direction:column;background:var(--bg);scroll-behavior:smooth;overscroll-behavior:contain}
    .messages-area::-webkit-scrollbar{width:5px}.messages-area::-webkit-scrollbar-thumb{background:#333;border-radius:20px}
    .message-row{width:100%;display:flex;align-items:flex-end;position:relative;margin-bottom:7px}
    .message-row.received{justify-content:flex-start;padding-right:200px}.message-row.sent{justify-content:flex-end;padding-left:200px}
    .message-row.received+.message-row.sent,.message-row.sent+.message-row.received{margin-top:10px}
    .message-avatar{width:28px;height:28px;border-radius:50%;object-fit:cover;flex:0 0 28px;margin-right:8px;background:var(--surface3)}
    .message-avatar-spacer{width:36px;flex:0 0 36px}
    .message-content{min-width:0;max-width:430px;display:flex;flex-direction:column}.message-row.sent .message-content{align-items:flex-end}
    .sender-name{color:var(--muted);font-size:11px;font-weight:600;margin:0 0 4px 5px}
    .message-bubble{max-width:100%;padding:9px 14px;border-radius:20px;font-size:14px;line-height:1.45;word-break:break-word;overflow-wrap:anywhere;white-space:pre-wrap;background:var(--surface3);color:var(--text);border:1px solid #303030}
    .message-row.received .message-bubble{border-bottom-left-radius:6px}.message-row.sent .message-bubble{background:linear-gradient(135deg,#3797f0,#5851db 45%,#833ab4);border:0;border-bottom-right-radius:6px}
    .message-bubble.deleted{background:var(--surface2)!important;border:1px solid var(--border)!important;color:#737373!important;font-style:italic}
    .message-meta{display:flex;align-items:center;gap:4px;margin-top:4px;padding:0 5px;color:#737373;font-size:10px;line-height:14px}.message-row.sent .message-meta{justify-content:flex-end}.edited{font-size:9px;color:#737373}.read-status{color:#737373}.read-status.read{color:var(--blue)}
    .message-media{display:block;width:min(330px,70vw);max-height:420px;object-fit:cover;border-radius:16px;background:#111;margin-bottom:3px}.message-video{background:#000}
    .reaction-list{display:flex;gap:3px;margin-top:3px}.message-row.sent .reaction-list{justify-content:flex-end}.reaction{min-width:25px;height:22px;padding:2px 6px;display:flex;align-items:center;justify-content:center;border-radius:999px;background:var(--surface3);border:1px solid #3a3a3a;font-size:12px}
    .date-divider{align-self:center;margin:18px 0 14px;padding:4px 10px;border-radius:999px;background:var(--surface2);color:#737373;font-size:10px;font-weight:600}
    .welcome{margin:auto;width:min(300px,90%);text-align:center;color:#737373}.welcome-avatar{width:78px;height:78px;border-radius:50%;object-fit:cover;margin-bottom:12px}.welcome-name{color:var(--text);font-size:16px;font-weight:600;margin-bottom:5px}.welcome-text{font-size:12px;line-height:1.5}
    .typing-indicator{min-height:18px;padding:0 22px;color:#737373;background:var(--surface);font-size:11px}
    .composer{width:100%;padding:9px 12px max(9px,env(safe-area-inset-bottom));border-top:1px solid var(--border);background:var(--surface);display:flex;align-items:flex-end;gap:8px}
    .composer-button,.send-button{width:40px;height:40px;flex:0 0 40px;display:grid;place-items:center;border:0;background:transparent;color:var(--text);border-radius:50%;font-size:18px}.composer-button:hover{background:var(--surface2)}.send-button{color:var(--blue);font-size:17px}.send-button:disabled{opacity:.35}
    .input-container{min-width:0;flex:1;display:flex;align-items:flex-end;padding:0 12px;background:var(--surface2);border:1px solid var(--border);border-radius:22px}.message-input{width:100%;min-height:40px;max-height:110px;resize:none;padding:9px 0;outline:0;border:0;background:transparent;color:var(--text);font-size:14px;line-height:1.4}.message-input::placeholder{color:#737373}
    .attachment-preview{display:none;align-items:center;gap:10px;padding:8px 12px;border-top:1px solid var(--border);background:var(--surface2)}.attachment-preview.show{display:flex}.attachment-thumb{width:48px;height:48px;border-radius:8px;object-fit:cover;background:#222}.attachment-name{flex:1;min-width:0;font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.remove-attachment{border:0;background:transparent;color:var(--muted);font-size:18px}

    .overlay{position:fixed;inset:0;background:rgba(0,0,0,.68);opacity:0;visibility:hidden;pointer-events:none;transition:.2s;z-index:100}.overlay.open{opacity:1;visibility:visible;pointer-events:auto}
    .message-actions{position:fixed;left:50%;bottom:12px;transform:translate(-50%,20px);width:min(420px,calc(100vw - 20px));padding:8px;background:var(--menu);border:1px solid var(--border);border-radius:16px;opacity:0;visibility:hidden;pointer-events:none;transition:.2s;z-index:101}.message-actions.open{opacity:1;visibility:visible;pointer-events:auto;transform:translate(-50%,0)}
    .reaction-row{display:flex;gap:5px;padding-bottom:8px;border-bottom:1px solid var(--border)}.reaction-button{flex:1;height:42px;border:0;border-radius:10px;background:var(--surface3);color:var(--text);font-size:20px}.action-button{width:100%;height:42px;border:0;background:transparent;color:var(--text);border-radius:10px;display:flex;align-items:center;gap:10px;padding:0 12px;text-align:left}.action-button:hover{background:var(--surface3)}.action-button.danger{color:var(--danger)}
    .toast{position:fixed;left:50%;bottom:80px;transform:translateX(-50%);background:var(--surface3);color:var(--text);padding:9px 14px;border-radius:999px;font-size:12px;z-index:999}
    @media(max-width:700px){.messages-page{height:calc(100dvh - 55px)}.chat-header{height:58px;padding:7px 10px}.header-avatar{width:38px;height:38px}.messages-area{padding:14px 10px 22px}.message-row.received{padding-right:80px}.message-row.sent{padding-left:80px}.message-content{max-width:min(78vw,360px)}.message-bubble{padding:8px 12px}.message-media{width:min(290px,70vw)}.composer{padding-left:8px;padding-right:8px}}
    @media(max-width:420px){.message-row.received{padding-right:35px}.message-row.sent{padding-left:35px}.message-content{max-width:80vw}.message-avatar{width:26px;height:26px;flex-basis:26px}.message-avatar-spacer{width:30px;flex-basis:30px}.conversation-menu{right:-4px;width:205px}}
    @media(min-width:701px) and (max-width:1100px){.message-row.received{padding-right:150px}.message-row.sent{padding-left:150px}}
  </style>
</head>
<body>
  <%- include('./partials/nave') %>
  <main class="messages-page">
    <section class="chat-container">
      <header class="chat-header">
        <button class="back-button" id="backButton" aria-label="Back" type="button"><i class="fas fa-arrow-left"></i></button>
        <div class="chat-user" id="profileButton" role="button" tabindex="0">
          <img class="header-avatar" id="headerAvatar" src="/imgs/default.png" alt="">
          <div class="header-user-info"><div class="header-name" id="headerName">Loading…</div><div class="header-status" id="headerStatus">Message</div></div>
        </div>
        <div class="header-actions">
          <button class="header-action" type="button" id="moreButton" aria-label="Conversation options" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></button>
          <div class="conversation-menu" id="conversationMenu" role="menu">
            <button type="button" id="profileMenuAction"><i class="fas fa-user"></i><span>Profile</span></button>
            <button type="button" id="muteMenuAction"><i class="fas fa-bell-slash"></i><span id="muteMenuLabel">Mute</span></button>
            <button type="button" id="blockMenuAction" class="danger"><i class="fas fa-ban"></i><span>Block</span></button>
          </div>
        </div>
      </header>

      <div class="messages-area" id="messagesArea" aria-live="polite">
        <div class="welcome" id="welcome">
          <img class="welcome-avatar" id="welcomeAvatar" src="/imgs/default.png" alt="">
          <div class="welcome-name" id="welcomeName">Starting chat…</div>
          <div class="welcome-text">Send a message to start your conversation.</div>
        </div>
      </div>

      <div class="typing-indicator" id="typingIndicator"></div>
      <div class="attachment-preview" id="attachmentPreview">
        <img class="attachment-thumb" id="attachmentThumb" src="" alt="">
        <div class="attachment-name" id="attachmentName"></div>
        <button class="remove-attachment" id="removeAttachment" type="button" aria-label="Remove attachment">×</button>
      </div>

      <form class="composer" id="composer">
        <button class="composer-button" type="button" id="attachmentButton" aria-label="Add attachment"><i class="fas fa-plus"></i></button>
        <input type="file" id="mediaInput" hidden accept="image/*,video/*">
        <div class="input-container"><textarea class="message-input" id="messageInput" rows="1" maxlength="5000" placeholder="Message..." autocomplete="off"></textarea></div>
        <button class="send-button" id="sendButton" type="submit" aria-label="Send message"><i class="fas fa-paper-plane"></i></button>
      </form>
    </section>
  </main>

  <div class="overlay" id="overlay"></div>
  <div class="message-actions" id="messageActions">
    <div class="reaction-row">
      <button class="reaction-button" data-reaction="❤️" type="button">❤️</button>
      <button class="reaction-button" data-reaction="😂" type="button">😂</button>
      <button class="reaction-button" data-reaction="😮" type="button">😮</button>
      <button class="reaction-button" data-reaction="😢" type="button">😢</button>
      <button class="reaction-button" data-reaction="👍" type="button">👍</button>
    </div>
    <button class="action-button" id="replyAction" type="button"><i class="fas fa-reply"></i>Reply</button>
    <button class="action-button" id="forwardAction" type="button"><i class="fas fa-share"></i>Forward</button>
    <button class="action-button" id="copyAction" type="button"><i class="far fa-copy"></i>Copy</button>
    <button class="action-button" id="editAction" type="button"><i class="fas fa-pen"></i>Edit</button>
    <button class="action-button danger" id="unsendAction" type="button"><i class="fas fa-trash"></i>Unsend</button>
  </div>

  <%- include('./partials/scripts') %>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const CURRENT_USER_ID='<%= user._id %>';
    const TARGET_USER_ID='<%= targetUserId %>';
    const EDIT_WINDOW=60*1000;
    let conversationId=null,targetUser=null,socket=null,selectedFile=null,activeMessageId=null,typingTimer=null,longPressTimer=null;
    const $=id=>document.getElementById(id);
    const escapeHtml=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
    const avatarUrl=v=>v&&String(v).trim()?String(v):'/imgs/default.png';
    const formatTime=v=>v?new Date(v).toLocaleTimeString([],{hour:'numeric',minute:'2-digit'}):'';
    const formatDate=v=>v?new Date(v).toLocaleDateString([],{day:'numeric',month:'short',year:'numeric'}):'';
    const isMine=m=>String(m.senderId?._id||m.senderId)===String(CURRENT_USER_ID);
    const canEdit=m=>!!m&&!m.deleted&&isMine(m)&&(Date.now()-new Date(m.createdAt).getTime()<=EDIT_WINDOW);
    function scrollToBottom(smooth=true){const a=$('messagesArea');a?.scrollTo({top:a.scrollHeight,behavior:smooth?'smooth':'auto'})}
    function toast(text){let e=$('chatToast');if(!e){e=document.createElement('div');e.id='chatToast';e.className='toast';document.body.appendChild(e)}e.textContent=text;clearTimeout(window.__toast);window.__toast=setTimeout(()=>e.remove(),2200)}
    function api(url,options={}){return fetch(url,{credentials:'same-origin',...options,headers:{Accept:'application/json',...(options.body instanceof FormData?{'':undefined}:{'Content-Type':'application/json'}),...(options.headers||{})}})}
    function updateUserUI(){if(!targetUser)return;const name=targetUser.fullName||targetUser.username||'User';const avatar=avatarUrl(targetUser.profileImageURL);$('headerName').textContent=name;$('headerAvatar').src=avatar;$('welcomeName').textContent=name;$('welcomeAvatar').src=avatar;$('headerAvatar').onerror=()=>{$('headerAvatar').src='/imgs/default.png'};$('welcomeAvatar').onerror=()=>{$('welcomeAvatar').src='/imgs/default.png'};$('headerStatus').textContent=targetUser.isPrivate?'Private account':'Message'}
    function openProfile(){location.href='/user/profile/'+encodeURIComponent(TARGET_USER_ID)}

    function menuKey(){return 'blogify:muted:'+String(CURRENT_USER_ID)+':'+String(TARGET_USER_ID)}
    function isMuted(){return localStorage.getItem(menuKey())==='1'}
    function updateMuteLabel(){$('muteMenuLabel').textContent=isMuted()?'Unmute':'Mute'}
    function closeConversationMenu(){$('conversationMenu').classList.remove('open');$('moreButton').setAttribute('aria-expanded','false')}
    function toggleConversationMenu(){const open=$('conversationMenu').classList.toggle('open');$('moreButton').setAttribute('aria-expanded',String(open));updateMuteLabel()}
    function toggleMute(){const next=!isMuted();if(next)localStorage.setItem(menuKey(),'1');else localStorage.removeItem(menuKey());updateMuteLabel();closeConversationMenu();toast(next?'Notifications muted for this chat':'Notifications unmuted for this chat')}
    async function blockUser(){closeConversationMenu();if(!confirm('Block this user?'))return;try{const r=await api('/messages/block/'+encodeURIComponent(TARGET_USER_ID),{method:'POST'});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to block user');toast(d.message||'User blocked');setTimeout(()=>location.href='/messages/chatlog',700)}catch(e){toast(e.message)}}

    function renderReactions(m){if(!Array.isArray(m.reactions)||!m.reactions.length)return '';const c={};m.reactions.forEach(r=>{if(r?.emoji)c[r.emoji]=(c[r.emoji]||0)+1});return '<div class="reaction-list">'+Object.entries(c).map(([e,n])=>'<span class="reaction">'+escapeHtml(e)+(n>1?'<small>'+n+'</small>':'')+'</span>').join('')+'</div>'}
    function createMessageElement(m){const mine=isMine(m),row=document.createElement('div');row.className='message-row '+(mine?'sent':'received');row.dataset.messageId=m._id;const content=document.createElement('div');content.className='message-content';if(!mine){const a=document.createElement('img');a.className='message-avatar';a.src=avatarUrl(m.senderId?.profileImageURL||targetUser?.profileImageURL);a.alt='';a.onerror=()=>a.src='/imgs/default.png';row.appendChild(a)}else{const s=document.createElement('div');s.className='message-avatar-spacer';row.appendChild(s)}if(!mine&&m.senderId?.fullName){const n=document.createElement('div');n.className='sender-name';n.textContent=m.senderId.fullName;content.appendChild(n)}const bubble=document.createElement('div');bubble.className='message-bubble';if(m.deleted){bubble.classList.add('deleted');bubble.textContent='Message unsent'}else{if(m.mediaUrl&&m.mediaType==='image'){const im=document.createElement('img');im.className='message-media';im.src=m.mediaUrl;im.alt='Photo';im.loading='lazy';bubble.appendChild(im)}if(m.mediaUrl&&m.mediaType==='video'){const v=document.createElement('video');v.className='message-media message-video';v.src=m.mediaUrl;v.controls=true;v.playsInline=true;bubble.appendChild(v)}if(m.text){const t=document.createElement('span');t.textContent=m.text;bubble.appendChild(t)}}content.appendChild(bubble);const meta=document.createElement('div');meta.className='message-meta';meta.innerHTML='<span>'+escapeHtml(formatTime(m.createdAt))+'</span>'+(m.edited&&!m.deleted?'<span class="edited">edited</span>':'')+(mine&&!m.deleted?'<span class="read-status '+(m.status==='read'?'read':'')+'">'+(m.status==='delivered'||m.status==='read'?'✓✓':'✓')+'</span>':'');content.appendChild(meta);if(!m.deleted){const reactions=renderReactions(m);if(reactions)content.insertAdjacentHTML('beforeend',reactions)}row.appendChild(content);bindMessageGesture(row);return row}
    function renderMessages(messages){const area=$('messagesArea');area.innerHTML='';if(!messages.length){area.appendChild($('welcome'));updateUserUI();return}let previousDate=null;messages.forEach(m=>{const d=formatDate(m.createdAt);if(d!==previousDate){const divider=document.createElement('div');divider.className='date-divider';divider.textContent=d;area.appendChild(divider);previousDate=d}area.appendChild(createMessageElement(m))});requestAnimationFrame(()=>scrollToBottom(false))}
    function bindMessageGesture(row){const bubble=row.querySelector('.message-bubble');if(!bubble)return;bubble.addEventListener('dblclick',()=>react(row.dataset.messageId,'❤️'));const start=e=>{if(e.target.closest('video'))return;clearTimeout(longPressTimer);longPressTimer=setTimeout(()=>openActions(row.dataset.messageId),500)};const cancel=()=>clearTimeout(longPressTimer);bubble.addEventListener('pointerdown',start);bubble.addEventListener('pointerup',cancel);bubble.addEventListener('pointercancel',cancel);bubble.addEventListener('pointerleave',cancel);bubble.addEventListener('contextmenu',e=>{e.preventDefault();openActions(row.dataset.messageId)})}
    function openActions(id){activeMessageId=id;$('overlay').classList.add('open');$('messageActions').classList.add('open')}
    function closeActions(){activeMessageId=null;$('overlay').classList.remove('open');$('messageActions').classList.remove('open')}
    function react(messageId,emoji){if(!socket||!conversationId)return;socket.emit('message:react',{conversationId,messageId,emoji});closeActions()}
    async function copyMessage(){const m=window.__messages?.find(x=>String(x._id)===String(activeMessageId));if(!m||m.deleted)return closeActions();try{await navigator.clipboard.writeText(m.text||'');toast('Message copied')}catch{toast('Unable to copy message')}closeActions()}
    function editMessage(){const m=window.__messages?.find(x=>String(x._id)===String(activeMessageId));if(!m)return closeActions();if(!canEdit(m)){toast('Messages can only be edited for 1 minute.');return closeActions()}window.__editingMessageId=m._id;$('messageInput').value=m.text||'';$('messageInput').dispatchEvent(new Event('input'));$('messageInput').focus();closeActions()}
    function unsendMessage(){const m=window.__messages?.find(x=>String(x._id)===String(activeMessageId));if(!m)return closeActions();if(!isMine(m)){toast('You can only unsend your own messages.');return closeActions()}if(!confirm('Unsend this message for everyone?'))return closeActions();socket?.emit('message:unsend',{conversationId,messageId:m._id});closeActions()}
    function replyMessage(){if(!activeMessageId)return;window.__replyMessageId=activeMessageId;$('messageInput').focus();toast('Replying to message');closeActions()}
    function forwardMessage(){toast('Forward feature ready');closeActions()}
    function resizeInput(){const i=$('messageInput');i.style.height='auto';i.style.height=Math.min(i.scrollHeight,110)+'px'}
    function clearAttachment(){selectedFile=null;$('mediaInput').value='';$('attachmentPreview').classList.remove('show');$('attachmentThumb').src='';$('attachmentName').textContent=''}
    function previewAttachment(file){if(!file)return;selectedFile=file;const url=URL.createObjectURL(file);$('attachmentThumb').src=url;$('attachmentName').textContent=file.name;$('attachmentPreview').classList.add('show')}

    async function sendMessage(){const input=$('messageInput'),text=input.value.trim();if(window.__editingMessageId){const m=window.__messages?.find(x=>String(x._id)===String(window.__editingMessageId));if(!m||!canEdit(m)){toast('Edit window expired.');window.__editingMessageId=null;input.value='';resizeInput();return}socket?.emit('message:edit',{conversationId,messageId:window.__editingMessageId,text});window.__editingMessageId=null;input.value='';resizeInput();return}if(!text&&!selectedFile)return;if(!socket||!conversationId)return toast('Chat is still loading.');$('sendButton').disabled=true;try{let mediaUrl='',mediaType='';if(selectedFile){const form=new FormData();form.append('media',selectedFile);const r=await api('/messages/upload',{method:'POST',body:form});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to upload media');mediaUrl=d.mediaUrl;mediaType=d.mediaType}socket.emit('message:send',{conversationId,text,mediaUrl,mediaType});input.value='';clearAttachment();resizeInput()}catch(e){toast(e.message)}finally{$('sendButton').disabled=false}}

    function bindSocket(){socket.on('user:online',d=>{if(String(d.userId)===String(TARGET_USER_ID)){$('headerStatus').textContent='Active now';$('headerStatus').classList.add('online')}});socket.on('user:offline',d=>{if(String(d.userId)===String(TARGET_USER_ID)){$('headerStatus').textContent=targetUser?.isPrivate?'Private account':'Message';$('headerStatus').classList.remove('online')}});socket.on('typing:start',d=>{if(String(d.userId)===String(TARGET_USER_ID))$('typingIndicator').textContent=(targetUser?.fullName||'User')+' is typing…'});socket.on('typing:stop',d=>{if(String(d.userId)===String(TARGET_USER_ID))$('typingIndicator').textContent=''});socket.on('message:new',m=>{if(String(m.conversationId)!==String(conversationId))return;window.__messages=window.__messages||[];window.__messages.push(m);$('welcome')?.remove();const area=$('messagesArea'),d=formatDate(m.createdAt),last=area.querySelector('.date-divider:last-of-type');if(!last||last.textContent!==d){const divider=document.createElement('div');divider.className='date-divider';divider.textContent=d;area.appendChild(divider)}area.appendChild(createMessageElement(m));scrollToBottom();socket.emit('message:read',{conversationId})});socket.on('message:edited',m=>{const i=window.__messages.findIndex(x=>String(x._id)===String(m._id));if(i>=0)window.__messages[i]=m;const old=document.querySelector('[data-message-id="'+CSS.escape(String(m._id))+'"]');if(old)old.replaceWith(createMessageElement(m))});socket.on('message:unsent',d=>{const m=window.__messages.find(x=>String(x._id)===String(d.messageId));if(!m)return;m.deleted=true;m.text='';m.mediaUrl='';const old=document.querySelector('[data-message-id="'+CSS.escape(String(d.messageId))+'"]');if(old)old.replaceWith(createMessageElement(m))});socket.on('message:reactions',d=>{const m=window.__messages.find(x=>String(x._id)===String(d.messageId));if(!m)return;m.reactions=d.reactions;const old=document.querySelector('[data-message-id="'+CSS.escape(String(d.messageId))+'"]');if(old)old.replaceWith(createMessageElement(m))});socket.on('message:read',d=>{if(String(d.conversationId)!==String(conversationId))return;window.__messages.filter(isMine).forEach(m=>m.status='read');document.querySelectorAll('.message-row.sent .read-status').forEach(e=>{e.textContent='✓✓';e.classList.add('read')})});socket.on('message:error',d=>toast(d.message||'Unable to send message'));socket.on('message:action:error',d=>toast(d.message||'Unable to update message'))}

    async function initializeChat(){try{const r=await api('/messages/conversation',{method:'POST',body:JSON.stringify({userId:TARGET_USER_ID})});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to open conversation');conversationId=d.conversationId;targetUser=d.target;updateUserUI();const mr=await api('/messages/'+encodeURIComponent(conversationId));const md=await mr.json();if(!mr.ok||!md.success)throw new Error(md.message||'Unable to load messages');window.__messages=md.messages||[];renderMessages(window.__messages);socket=io();bindSocket();socket.emit('conversation:join',conversationId);socket.emit('message:read',{conversationId})}catch(error){$('messagesArea').innerHTML='<div class="welcome"><div style="font-size:36px;margin-bottom:12px">⚠️</div><div class="welcome-name">Unable to load chat</div><div class="welcome-text">'+escapeHtml(error.message)+'</div><button type="button" onclick="location.reload()" style="margin-top:15px;padding:9px 16px;border:0;border-radius:8px;background:#0095f6;color:white">Try again</button></div>'}}

    $('composer').addEventListener('submit',e=>{e.preventDefault();sendMessage()});
    $('messageInput').addEventListener('input',()=>{resizeInput();if(socket&&conversationId){socket.emit('typing:start',{conversationId});clearTimeout(typingTimer);typingTimer=setTimeout(()=>socket.emit('typing:stop',{conversationId}),900)}});
    $('messageInput').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey&&window.innerWidth>650){e.preventDefault();sendMessage()}});
    $('attachmentButton').onclick=()=>$('mediaInput').click();$('mediaInput').onchange=e=>previewAttachment(e.target.files?.[0]);$('removeAttachment').onclick=clearAttachment;
    $('backButton').onclick=()=>history.length>1?history.back():location.href='/messages/chatlog';$('profileButton').onclick=openProfile;$('profileButton').onkeydown=e=>{if(e.key==='Enter')openProfile()};
    $('moreButton').onclick=e=>{e.stopPropagation();toggleConversationMenu()};$('profileMenuAction').onclick=openProfile;$('muteMenuAction').onclick=toggleMute;$('blockMenuAction').onclick=blockUser;
    document.addEventListener('click',e=>{if(!e.target.closest('.header-actions'))closeConversationMenu();if(!e.target.closest('.message-actions')&&!e.target.closest('.message-bubble'))closeActions()});$('overlay').onclick=closeActions;
    $('replyAction').onclick=replyMessage;$('forwardAction').onclick=forwardMessage;$('copyAction').onclick=copyMessage;$('editAction').onclick=editMessage;$('unsendAction').onclick=unsendMessage;
    document.querySelectorAll('[data-reaction]').forEach(b=>b.onclick=()=>{if(activeMessageId)react(activeMessageId,b.dataset.reaction)});
    updateMuteLabel();initializeChat();
  </script>
</body>
</html>
