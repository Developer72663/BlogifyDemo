<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>

  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

  <title>Messages | Blogify</title>

  <style>
    :root {
      --bg: #000;
      --surface: #000;
      --surface-2: #121212;
      --surface-3: #262626;
      --text: #fff;
      --muted: #a8a8a8;
      --blue: #0095f6;
      --purple: #833ab4;
      --border: #262626;
      --green: #1eb053;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;
    }

    body {
      overflow: hidden;
    }

    button,
    input,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    /* =========================================================
       MAIN CHAT
    ========================================================= */

    .messages-page {
      width: 100%;
      height: calc(100dvh - 60px);
      display: flex;
      justify-content: center;
      background: #000;
    }

    .chat-container {
      width: 100%;
      height: 100%;
      max-width: 1100px;

      display: grid;
      grid-template-rows: 64px minmax(0, 1fr) auto;

      background: #000;
      overflow: hidden;
    }

    @media (min-width: 900px) {
      .messages-page {
        padding: 18px;
        height: calc(100dvh - 60px);
      }

      .chat-container {
        border: 1px solid var(--border);
        border-radius: 14px;
        max-width: 1100px;
      }
    }

    /* =========================================================
       HEADER
    ========================================================= */

    .chat-header {
      height: 64px;

      display: flex;
      align-items: center;

      padding: 8px 16px;

      border-bottom: 1px solid var(--border);
      background: #000;

      z-index: 10;
    }

    .back-button {
      width: 40px;
      height: 40px;

      display: grid;
      place-items: center;

      border: 0;
      background: transparent;
      color: #fff;

      border-radius: 50%;

      font-size: 20px;
      margin-right: 8px;
    }

    .back-button:hover {
      background: #121212;
    }

    .chat-user {
      display: flex;
      align-items: center;

      min-width: 0;
      flex: 1;

      cursor: pointer;
    }

    .header-avatar {
      width: 40px;
      height: 40px;

      border-radius: 50%;
      object-fit: cover;

      margin-right: 11px;

      background: #262626;
    }

    .header-user-info {
      min-width: 0;
    }

    .header-name {
      font-size: 15px;
      font-weight: 600;

      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .header-status {
      margin-top: 2px;

      font-size: 12px;
      color: var(--muted);
    }

    .header-status.online {
      color: var(--green);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .header-action {
      width: 40px;
      height: 40px;

      border: 0;
      background: transparent;
      color: #fff;

      border-radius: 50%;
    }

    .header-action:hover {
      background: #121212;
    }

    /* =========================================================
       MESSAGE AREA
    ========================================================= */

    .messages-area {
      min-height: 0;

      overflow-y: auto;
      overflow-x: hidden;

      padding: 20px 20px 28px;

      display: flex;
      flex-direction: column;

      background: #000;

      scroll-behavior: smooth;
      overscroll-behavior: contain;
    }

    .messages-area::-webkit-scrollbar {
      width: 5px;
    }

    .messages-area::-webkit-scrollbar-thumb {
      background: #333;
      border-radius: 20px;
    }

    /* =========================================================
       MESSAGE ROW
    ========================================================= */

    /*
      IMPORTANT:

      Every message uses the full available width.

      Incoming:
      [avatar] [bubble]                        

      Outgoing:
                              [bubble]

      The "200px gap" is created by allowing the two sides
      to use opposite ends of the conversation width rather
      than placing them beside each other.
    */

    .message-row {
      width: 100%;

      display: flex;
      align-items: flex-end;

      margin-bottom: 7px;

      position: relative;
    }

    .message-row.received {
      justify-content: flex-start;

      padding-right: 200px;
    }

    .message-row.sent {
      justify-content: flex-end;

      padding-left: 200px;
    }

    /*
      Keep consecutive messages close together.
    */

    .message-row + .message-row {
      margin-top: 0;
    }

    .message-row.received + .message-row.sent {
      margin-top: 10px;
    }

    .message-row.sent + .message-row.received {
      margin-top: 10px;
    }

    /* =========================================================
       AVATAR
    ========================================================= */

    .message-avatar {
      width: 28px;
      height: 28px;

      border-radius: 50%;

      object-fit: cover;

      flex: 0 0 28px;

      margin-right: 8px;

      background: #262626;
    }

    .message-avatar-spacer {
      width: 36px;
      flex: 0 0 36px;
    }

    /* =========================================================
       MESSAGE CONTENT
    ========================================================= */

    .message-content {
      min-width: 0;
      max-width: 430px;

      display: flex;
      flex-direction: column;
    }

    .message-row.sent .message-content {
      align-items: flex-end;
    }

    .sender-name {
      color: #a8a8a8;

      font-size: 11px;
      font-weight: 600;

      margin: 0 0 4px 5px;
    }

    /* =========================================================
       BUBBLE
    ========================================================= */

    .message-bubble {
      max-width: 100%;

      padding: 9px 14px;

      border-radius: 20px;

      font-size: 14px;
      line-height: 1.45;

      word-break: break-word;
      overflow-wrap: anywhere;

      white-space: pre-wrap;

      background: #262626;
      color: #fff;

      border: 1px solid #303030;
    }

    .message-row.received .message-bubble {
      border-bottom-left-radius: 6px;
    }

    .message-row.sent .message-bubble {
      color: #fff;

      background:
        linear-gradient(
          135deg,
          #3797f0 0%,
          #5851db 45%,
          #833ab4 100%
        );

      border: 0;

      border-bottom-right-radius: 6px;
    }

    .message-bubble.deleted {
      background: #181818 !important;
      border: 1px solid #303030 !important;

      color: #737373 !important;

      font-style: italic;
    }

    /* =========================================================
       MESSAGE TIME
    ========================================================= */

    .message-meta {
      display: flex;
      align-items: center;
      gap: 4px;

      margin-top: 4px;
      padding: 0 5px;

      color: #737373;

      font-size: 10px;
      line-height: 14px;
    }

    .message-row.sent .message-meta {
      justify-content: flex-end;
    }

    .edited {
      font-size: 9px;
      color: #737373;
    }

    .read-status {
      color: #737373;
      font-size: 10px;
    }

    .read-status.read {
      color: #0095f6;
    }

    /* =========================================================
       MEDIA
    ========================================================= */

    .message-media {
      display: block;

      width: min(330px, 70vw);
      max-height: 420px;

      object-fit: cover;

      border-radius: 16px;

      background: #111;

      margin-bottom: 3px;
    }

    .message-video {
      background: #000;
    }

    /* =========================================================
       REACTIONS
    ========================================================= */

    .reaction-list {
      display: flex;
      gap: 3px;

      margin-top: 3px;
    }

    .message-row.sent .reaction-list {
      justify-content: flex-end;
    }

    .reaction {
      min-width: 25px;
      height: 22px;

      padding: 2px 6px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 999px;

      background: #262626;
      border: 1px solid #3a3a3a;

      font-size: 12px;
    }

    /* =========================================================
       DATE DIVIDER
    ========================================================= */

    .date-divider {
      align-self: center;

      margin: 18px 0 14px;

      padding: 4px 10px;

      border-radius: 999px;

      background: #121212;

      color: #737373;

      font-size: 10px;
      font-weight: 600;
    }

    /* =========================================================
       WELCOME
    ========================================================= */

    .welcome {
      margin: auto;

      width: min(300px, 90%);

      text-align: center;

      color: #737373;
    }

    .welcome-avatar {
      width: 78px;
      height: 78px;

      border-radius: 50%;

      object-fit: cover;

      margin-bottom: 12px;
    }

    .welcome-name {
      color: #fff;

      font-size: 16px;
      font-weight: 600;

      margin-bottom: 5px;
    }

    .welcome-text {
      font-size: 12px;
      line-height: 1.5;
    }

    /* =========================================================
       TYPING
    ========================================================= */

    .typing-indicator {
      min-height: 18px;

      padding: 0 22px;

      color: #737373;

      background: #000;

      font-size: 11px;
    }

    /* =========================================================
       COMPOSER
    ========================================================= */

    .composer {
      width: 100%;

      padding:
        9px
        12px
        max(9px, env(safe-area-inset-bottom));

      border-top: 1px solid var(--border);

      background: #000;

      display: flex;
      align-items: flex-end;

      gap: 8px;
    }

    .composer-button {
      width: 40px;
      height: 40px;

      flex: 0 0 40px;

      display: grid;
      place-items: center;

      border: 0;

      background: transparent;

      color: #fff;

      border-radius: 50%;

      font-size: 18px;
    }

    .composer-button:hover {
      background: #121212;
    }

    .input-container {
      min-width: 0;
      flex: 1;

      display: flex;
      align-items: flex-end;

      padding: 0 12px;

      background: #121212;

      border: 1px solid #262626;

      border-radius: 22px;
    }

    .message-input {
      width: 100%;

      min-height: 40px;
      max-height: 110px;

      resize: none;

      padding: 9px 0;

      outline: none;
      border: 0;

      background: transparent;

      color: #fff;

      font-size: 14px;

      line-height: 1.4;
    }

    .message-input::placeholder {
      color: #737373;
    }

    .send-button {
      width: 40px;
      height: 40px;

      flex: 0 0 40px;

      display: grid;
      place-items: center;

      border: 0;

      background: transparent;

      color: var(--blue);

      border-radius: 50%;

      font-size: 17px;
    }

    .send-button:disabled {
      opacity: .35;
    }

    /* =========================================================
       ATTACHMENT PREVIEW
    ========================================================= */

    .attachment-preview {
      display: none;

      align-items: center;
      gap: 10px;

      padding: 8px 12px;

      border-top: 1px solid var(--border);

      background: #0b0b0b;
    }

    .attachment-preview.show {
      display: flex;
    }

    .attachment-thumb {
      width: 48px;
      height: 48px;

      border-radius: 8px;

      object-fit: cover;

      background: #222;
    }

    .attachment-name {
      flex: 1;

      min-width: 0;

      font-size: 11px;

      color: #a8a8a8;

      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .remove-attachment {
      border: 0;

      background: transparent;

      color: #a8a8a8;

      font-size: 18px;
    }

    /* =========================================================
       ACTION SHEET
    ========================================================= */

    .overlay {
      position: fixed;
      inset: 0;

      background: rgba(0,0,0,.65);

      opacity: 0;
      visibility: hidden;

      pointer-events: none;

      transition: .2s;

      z-index: 100;
    }

    .overlay.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .message-actions {
      position: fixed;

      left: 50%;
      bottom: 12px;

      transform: translate(-50%, 20px);

      width: min(420px, calc(100vw - 20px));

      padding: 8px;

      background: #1a1a1a;

      border: 1px solid #303030;

      border-radius: 16px;

      opacity: 0;
      visibility: hidden;

      pointer-events: none;

      transition: .2s;

      z-index: 101;
    }

    .message-actions.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;

      transform: translate(-50%, 0);
    }

    .reaction-row {
      display: flex;
      gap: 5px;

      padding-bottom: 8px;

      border-bottom: 1px solid #303030;
    }

    .reaction-button {
      flex: 1;

      height: 42px;

      border: 0;

      border-radius: 10px;

      background: #262626;

      color: #fff;

      font-size: 20px;
    }

    .action-button {
      width: 100%;
      height: 42px;

      border: 0;

      background: transparent;

      color: #fff;

      border-radius: 10px;

      display: flex;
      align-items: center;

      gap: 10px;

      padding: 0 12px;

      text-align: left;
    }

    .action-button:hover {
      background: #262626;
    }

    .action-button.danger {
      color: #ed4956;
    }

    /* =========================================================
       MOBILE
    ========================================================= */

    @media (max-width: 700px) {

      .messages-page {
        height: calc(100dvh - 55px);
      }

      .chat-container {
        height: 100%;
      }

      .chat-header {
        height: 58px;
        padding: 7px 10px;
      }

      .header-avatar {
        width: 38px;
        height: 38px;
      }

      .messages-area {
        padding: 14px 10px 22px;
      }

      /*
        Mobile keeps the same visual separation,
        but avoids forcing bubbles too narrow.
      */

      .message-row.received {
        padding-right: 80px;
      }

      .message-row.sent {
        padding-left: 80px;
      }

      .message-content {
        max-width: min(78vw, 360px);
      }

      .message-bubble {
        padding: 8px 12px;

        font-size: 14px;

        line-height: 1.45;
      }

      .message-media {
        width: min(290px, 70vw);
      }

      .composer {
        padding-left: 8px;
        padding-right: 8px;
      }
    }

    @media (max-width: 420px) {

      .message-row.received {
        padding-right: 35px;
      }

      .message-row.sent {
        padding-left: 35px;
      }

      .message-content {
        max-width: 80vw;
      }

      .message-avatar {
        width: 26px;
        height: 26px;
        flex-basis: 26px;
      }

      .message-avatar-spacer {
        width: 30px;
        flex-basis: 30px;
      }
    }

    /* =========================================================
       TABLET
    ========================================================= */

    @media (min-width: 701px) and (max-width: 1100px) {

      .message-row.received {
        padding-right: 150px;
      }

      .message-row.sent {
        padding-left: 150px;
      }
    }
  </style>
</head>

<body>

  <%- include('./partials/nave') %>

  <main class="messages-page">

    <section class="chat-container">

      <!-- =====================================================
           HEADER
      ====================================================== -->

      <header class="chat-header">

        <button
          class="back-button"
          id="backButton"
          aria-label="Back"
          type="button"
        >
          <i class="fas fa-arrow-left"></i>
        </button>

        <div
          class="chat-user"
          id="profileButton"
          role="button"
          tabindex="0"
        >

          <img
            class="header-avatar"
            id="headerAvatar"
            src="/imgs/default.png"
            alt=""
          >

          <div class="header-user-info">

            <div
              class="header-name"
              id="headerName"
            >
              Loading…
            </div>

            <div
              class="header-status"
              id="headerStatus"
            >
              Message
            </div>

          </div>

        </div>

        <div class="header-actions">

          <button
            class="header-action"
            type="button"
            id="callButton"
            aria-label="Call"
          >
            <i class="fas fa-phone"></i>
          </button>

          <button
            class="header-action"
            type="button"
            id="moreButton"
            aria-label="More"
          >
            <i class="fas fa-ellipsis-v"></i>
          </button>

        </div>

      </header>


      <!-- =====================================================
           MESSAGES
      ====================================================== -->

      <div
        class="messages-area"
        id="messagesArea"
        aria-live="polite"
      >

        <div
          class="welcome"
          id="welcome"
        >

          <img
            class="welcome-avatar"
            id="welcomeAvatar"
            src="/imgs/default.png"
            alt=""
          >

          <div
            class="welcome-name"
            id="welcomeName"
          >
            Starting chat…
          </div>

          <div class="welcome-text">
            Send a message to start your conversation.
          </div>

        </div>

      </div>


      <!-- =====================================================
           TYPING
      ====================================================== -->

      <div
        class="typing-indicator"
        id="typingIndicator"
      ></div>


      <!-- =====================================================
           ATTACHMENT PREVIEW
      ====================================================== -->

      <div
        class="attachment-preview"
        id="attachmentPreview"
      >

        <img
          class="attachment-thumb"
          id="attachmentThumb"
          src=""
          alt=""
        >

        <div
          class="attachment-name"
          id="attachmentName"
        ></div>

        <button
          class="remove-attachment"
          id="removeAttachment"
          type="button"
          aria-label="Remove attachment"
        >
          ×
        </button>

      </div>


      <!-- =====================================================
           COMPOSER
      ====================================================== -->

      <form
        class="composer"
        id="composer"
      >

        <button
          class="composer-button"
          type="button"
          id="attachmentButton"
          aria-label="Add attachment"
        >
          <i class="fas fa-plus"></i>
        </button>

        <input
          type="file"
          id="mediaInput"
          hidden
          accept="image/*,video/*"
        >

        <div class="input-container">

          <textarea
            class="message-input"
            id="messageInput"
            rows="1"
            maxlength="5000"
            placeholder="Message..."
            autocomplete="off"
          ></textarea>

        </div>

        <button
          class="send-button"
          id="sendButton"
          type="submit"
          aria-label="Send message"
        >
          <i class="fas fa-paper-plane"></i>
        </button>

      </form>

    </section>

  </main>


  <!-- =========================================================
       ACTION SHEET
  ========================================================== -->

  <div
    class="overlay"
    id="overlay"
  ></div>

  <div
    class="message-actions"
    id="messageActions"
  >

    <div class="reaction-row">

      <button
        class="reaction-button"
        data-reaction="❤️"
        type="button"
      >
        ❤️
      </button>

      <button
        class="reaction-button"
        data-reaction="😂"
        type="button"
      >
        😂
      </button>

      <button
        class="reaction-button"
        data-reaction="😮"
        type="button"
      >
        😮
      </button>

      <button
        class="reaction-button"
        data-reaction="😢"
        type="button"
      >
        😢
      </button>

      <button
        class="reaction-button"
        data-reaction="👍"
        type="button"
      >
        👍
      </button>

    </div>

    <button
      class="action-button"
      id="replyAction"
      type="button"
    >
      <i class="fas fa-reply"></i>
      Reply
    </button>

    <button
      class="action-button"
      id="forwardAction"
      type="button"
    >
      <i class="fas fa-share"></i>
      Forward
    </button>

    <button
      class="action-button"
      id="copyAction"
      type="button"
    >
      <i class="far fa-copy"></i>
      Copy
    </button>

    <button
      class="action-button"
      id="editAction"
      type="button"
    >
      <i class="fas fa-pen"></i>
      Edit
    </button>

    <button
      class="action-button danger"
      id="unsendAction"
      type="button"
    >
      <i class="fas fa-trash"></i>
      Unsend
    </button>

  </div>


  <%- include('./partials/scripts') %>

  <script src="/socket.io/socket.io.js"></script>

  <script>

    const CURRENT_USER_ID = '<%= user._id %>';
    const TARGET_USER_ID = '<%= targetUserId %>';

    const EDIT_WINDOW = 60 * 1000;

    let conversationId = null;
    let targetUser = null;
    let socket = null;

    let selectedFile = null;
    let activeMessageId = null;

    let typingTimer = null;
    let longPressTimer = null;

    const $ = id => document.getElementById(id);


    /* =========================================================
       HELPERS
    ========================================================== */

    function escapeHtml(value) {

      return String(value ?? '').replace(
        /[&<>"']/g,
        character => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#039;'
        }[character])
      );

    }


    function avatarUrl(value) {

      if (value && String(value).trim()) {
        return String(value);
      }

      return '/imgs/default.png';
    }


    function formatTime(value) {

      if (!value) return '';

      return new Date(value).toLocaleTimeString(
        [],
        {
          hour: 'numeric',
          minute: '2-digit'
        }
      );

    }


    function formatDate(value) {

      if (!value) return '';

      return new Date(value).toLocaleDateString(
        [],
        {
          day: 'numeric',
          month: 'short',
          year: 'numeric'
        }
      );

    }


    function isMine(message) {

      return String(
        message.senderId?._id || message.senderId
      ) === String(CURRENT_USER_ID);

    }


    function canEdit(message) {

      if (!message) return false;

      if (!isMine(message)) return false;

      if (message.deleted) return false;

      return (
        Date.now() -
        new Date(message.createdAt).getTime()
      ) <= EDIT_WINDOW;

    }


    function scrollToBottom(smooth = true) {

      const area = $('messagesArea');

      if (!area) return;

      area.scrollTo({
        top: area.scrollHeight,
        behavior: smooth ? 'smooth' : 'auto'
      });

    }


    function toast(message) {

      let element = document.getElementById('chatToast');

      if (!element) {

        element = document.createElement('div');

        element.id = 'chatToast';

        element.style.cssText = `
          position:fixed;
          left:50%;
          bottom:80px;
          transform:translateX(-50%);
          background:#262626;
          color:#fff;
          padding:9px 14px;
          border-radius:999px;
          font-size:12px;
          z-index:999;
        `;

        document.body.appendChild(element);

      }

      element.textContent = message;

      clearTimeout(window.__chatToastTimer);

      window.__chatToastTimer = setTimeout(() => {
        element.remove();
      }, 2200);

    }


    async function api(url, options = {}) {

      const headers = {
        Accept: 'application/json',
        ...(options.body instanceof FormData
          ? {}
          : {
              'Content-Type': 'application/json'
            }),
        ...(options.headers || {})
      };

      return fetch(url, {
        credentials: 'same-origin',
        ...options,
        headers
      });

    }


    /* =========================================================
       USER
    ========================================================== */

    function updateUserUI() {

      if (!targetUser) return;

      const name =
        targetUser.fullName ||
        targetUser.username ||
        'User';

      const avatar =
        avatarUrl(targetUser.profileImageURL);

      $('headerName').textContent = name;

      $('headerAvatar').src = avatar;

      $('welcomeName').textContent = name;

      $('welcomeAvatar').src = avatar;

      $('headerAvatar').onerror = () => {
        $('headerAvatar').src = '/imgs/default.png';
      };

      $('welcomeAvatar').onerror = () => {
        $('welcomeAvatar').src = '/imgs/default.png';
      };

      $('headerStatus').textContent =
        targetUser.isPrivate
          ? 'Private account'
          : 'Message';

    }


    function openProfile() {

      location.href =
        '/user/profile/' +
        encodeURIComponent(TARGET_USER_ID);

    }


    /* =========================================================
       REACTIONS
    ========================================================== */

    function renderReactions(message) {

      if (!Array.isArray(message.reactions)) {
        return '';
      }

      if (!message.reactions.length) {
        return '';
      }

      const counts = {};

      message.reactions.forEach(reaction => {

        if (!reaction?.emoji) return;

        counts[reaction.emoji] =
          (counts[reaction.emoji] || 0) + 1;

      });

      const html = Object.entries(counts)
        .map(
          ([emoji, count]) =>
            `<span class="reaction">
              ${escapeHtml(emoji)}
              ${count > 1 ? `<small>${count}</small>` : ''}
            </span>`
        )
        .join('');

      return `<div class="reaction-list">${html}</div>`;

    }


    /* =========================================================
       MESSAGE HTML
    ========================================================== */

    function createMessageElement(message) {

      const mine = isMine(message);

      const row = document.createElement('div');

      row.className =
        'message-row ' +
        (mine ? 'sent' : 'received');

      row.dataset.messageId = message._id;


      const content =
        document.createElement('div');

      content.className = 'message-content';


      /*
        RECEIVED MESSAGE

        avatar -> bubble

        SENT MESSAGE

        spacer -> bubble
      */

      if (!mine) {

        const avatar =
          document.createElement('img');

        avatar.className = 'message-avatar';

        avatar.src =
          avatarUrl(
            message.senderId?.profileImageURL ||
            targetUser?.profileImageURL
          );

        avatar.alt = '';

        avatar.onerror = () => {
          avatar.src = '/imgs/default.png';
        };

        row.appendChild(avatar);

      } else {

        const spacer =
          document.createElement('div');

        spacer.className =
          'message-avatar-spacer';

        row.appendChild(spacer);

      }


      if (!mine && message.senderId?.fullName) {

        const senderName =
          document.createElement('div');

        senderName.className = 'sender-name';

        senderName.textContent =
          message.senderId.fullName;

        content.appendChild(senderName);

      }


      const bubble =
        document.createElement('div');

      bubble.className = 'message-bubble';


      if (message.deleted) {

        bubble.classList.add('deleted');

        bubble.textContent =
          'Message unsent';

      } else {

        if (
          message.mediaUrl &&
          message.mediaType === 'image'
        ) {

          const image =
            document.createElement('img');

          image.className =
            'message-media';

          image.src = message.mediaUrl;

          image.alt = 'Photo';

          image.loading = 'lazy';

          bubble.appendChild(image);

        }


        if (
          message.mediaUrl &&
          message.mediaType === 'video'
        ) {

          const video =
            document.createElement('video');

          video.className =
            'message-media message-video';

          video.src = message.mediaUrl;

          video.controls = true;

          video.playsInline = true;

          bubble.appendChild(video);

        }


        if (message.text) {

          const text =
            document.createElement('span');

          text.textContent =
            message.text;

          bubble.appendChild(text);

        }

      }


      content.appendChild(bubble);


      /* =======================================================
         META
      ======================================================== */

      const meta =
        document.createElement('div');

      meta.className = 'message-meta';

      meta.innerHTML =
        `<span>${escapeHtml(
          formatTime(message.createdAt)
        )}</span>`;


      if (message.edited && !message.deleted) {

        meta.innerHTML +=
          `<span class="edited">edited</span>`;

      }


      if (mine && !message.deleted) {

        let status = '✓';

        if (message.status === 'delivered') {
          status = '✓✓';
        }

        if (message.status === 'read') {
          status = '✓✓';
        }

        meta.innerHTML +=
          `<span class="read-status ${
            message.status === 'read'
              ? 'read'
              : ''
          }">${status}</span>`;

      }


      content.appendChild(meta);

      row.appendChild(content);


      if (!message.deleted) {

        const reactions =
          renderReactions(message);

        if (reactions) {

          content.insertAdjacentHTML(
            'beforeend',
            reactions
          );

        }

      }


      bindMessageGesture(row);

      return row;

    }


    /* =========================================================
       DATE GROUPING
    ========================================================== */

    function renderMessages(messages) {

      const area = $('messagesArea');

      area.innerHTML = '';

      if (!messages.length) {

        area.appendChild(
          $('welcome')
        );

        updateUserUI();

        return;

      }


      let previousDate = null;


      messages.forEach(message => {

        const currentDate =
          formatDate(message.createdAt);


        if (currentDate !== previousDate) {

          const divider =
            document.createElement('div');

          divider.className =
            'date-divider';

          divider.textContent =
            currentDate;

          area.appendChild(divider);

          previousDate = currentDate;

        }


        area.appendChild(
          createMessageElement(message)
        );

      });


      requestAnimationFrame(
        () => scrollToBottom(false)
      );

    }


    /* =========================================================
       LONG PRESS
    ========================================================== */

    function bindMessageGesture(row) {

      const bubble =
        row.querySelector(
          '.message-bubble'
        );

      if (!bubble) return;


      bubble.addEventListener(
        'dblclick',
        () => {

          react(
            row.dataset.messageId,
            '❤️'
          );

        }
      );


      const startLongPress = event => {

        if (
          event.target.closest('video')
        ) {
          return;
        }

        clearTimeout(longPressTimer);

        longPressTimer =
          setTimeout(() => {

            openActions(
              row.dataset.messageId
            );

          }, 500);

      };


      const cancelLongPress = () => {

        clearTimeout(longPressTimer);

      };


      bubble.addEventListener(
        'pointerdown',
        startLongPress
      );

      bubble.addEventListener(
        'pointerup',
        cancelLongPress
      );

      bubble.addEventListener(
        'pointercancel',
        cancelLongPress
      );

      bubble.addEventListener(
        'pointerleave',
        cancelLongPress
      );


      bubble.addEventListener(
        'contextmenu',
        event => {

          event.preventDefault();

          openActions(
            row.dataset.messageId
          );

        }
      );

    }


    /* =========================================================
       ACTION SHEET
    ========================================================== */

    function openActions(messageId) {

      activeMessageId =
        messageId;

      $('overlay')
        .classList.add('open');

      $('messageActions')
        .classList.add('open');

    }


    function closeActions() {

      activeMessageId = null;

      $('overlay')
        .classList.remove('open');

      $('messageActions')
        .classList.remove('open');

    }


    /* =========================================================
       REACT
    ========================================================== */

    function react(messageId, emoji) {

      if (!socket || !conversationId) {
        return;
      }

      socket.emit(
        'message:react',
        {
          conversationId,
          messageId,
          emoji
        }
      );

      closeActions();

    }


    /* =========================================================
       COPY
    ========================================================== */

    async function copyMessage() {

      const message =
        window.__messages?.find(
          item =>
            String(item._id) ===
            String(activeMessageId)
        );

      if (!message || message.deleted) {

        closeActions();

        return;

      }

      try {

        await navigator.clipboard.writeText(
          message.text || ''
        );

        toast('Message copied');

      } catch {

        toast('Unable to copy message');

      }

      closeActions();

    }


    /* =========================================================
       EDIT
    ========================================================== */

    function editMessage() {

      const message =
        window.__messages?.find(
          item =>
            String(item._id) ===
            String(activeMessageId)
        );

      if (!message) {

        closeActions();

        return;

      }

      if (!canEdit(message)) {

        toast(
          'Messages can only be edited for 1 minute.'
        );

        closeActions();

        return;

      }


      $('messageInput').value =
        message.text || '';

      $('messageInput').focus();

      $('messageInput').dispatchEvent(
        new Event('input')
      );


      window.__editingMessageId =
        message._id;


      closeActions();

    }


    /* =========================================================
       UNSEND
    ========================================================== */

    function unsendMessage() {

      const message =
        window.__messages?.find(
          item =>
            String(item._id) ===
            String(activeMessageId)
        );

      if (!message) {

        closeActions();

        return;

      }

      if (!isMine(message)) {

        toast(
          'You can only unsend your own messages.'
        );

        closeActions();

        return;

      }


      if (
        !confirm(
          'Unsend this message for everyone?'
        )
      ) {

        closeActions();

        return;

      }


      socket?.emit(
        'message:unsend',
        {
          conversationId,
          messageId: message._id
        }
      );

      closeActions();

    }


    /* =========================================================
       REPLY
    ========================================================== */

    function replyMessage() {

      const message =
        window.__messages?.find(
          item =>
            String(item._id) ===
            String(activeMessageId)
        );

      if (!message) {

        closeActions();

        return;

      }

      window.__replyMessageId =
        message._id;

      $('messageInput').focus();

      toast(
        'Replying to message'
      );

      closeActions();

    }


    /* =========================================================
       FORWARD
    ========================================================== */

    function forwardMessage() {

      const message =
        window.__messages?.find(
          item =>
            String(item._id) ===
            String(activeMessageId)
        );

      if (!message) {

        closeActions();

        return;

      }

      /*
        Keep this ready for the existing
        forward-message socket/API.
      */

      toast(
        'Forward feature ready'
      );

      closeActions();

    }


    /* =========================================================
       SEND
    ========================================================== */

    async function sendMessage() {

      const input =
        $('messageInput');

      const text =
        input.value.trim();


      /* EDIT */

      if (window.__editingMessageId) {

        const message =
          window.__messages?.find(
            item =>
              String(item._id) ===
              String(window.__editingMessageId)
          );

        if (
          !message ||
          !canEdit(message)
        ) {

          toast(
            'Edit window expired.'
          );

          window.__editingMessageId =
            null;

          input.value = '';

          resizeInput();

          return;

        }


        socket?.emit(
          'message:edit',
          {
            conversationId,
            messageId:
              window.__editingMessageId,
            text
          }
        );


        window.__editingMessageId =
          null;

        input.value = '';

        resizeInput();

        return;

      }


      if (
        !text &&
        !selectedFile
      ) {
        return;
      }


      if (
        !socket ||
        !conversationId
      ) {

        toast(
          'Chat is still loading.'
        );

        return;

      }


      $('sendButton').disabled =
        true;


      try {

        let mediaUrl = '';
        let mediaType = '';


        if (selectedFile) {

          const form =
            new FormData();

          form.append(
            'media',
            selectedFile
          );


          const response =
            await api(
              '/messages/upload',
              {
                method: 'POST',
                body: form
              }
            );


          const data =
            await response.json();


          if (
            !response.ok ||
            !data.success
          ) {

            throw new Error(
              data.message ||
              'Unable to upload media'
            );

          }


          mediaUrl =
            data.mediaUrl;

          mediaType =
            data.mediaType;

        }


        socket.emit(
          'message:send',
          {
            conversationId,
            text,
            mediaUrl,
            mediaType
          }
        );


        input.value = '';

        clearAttachment();

        resizeInput();

      } catch (error) {

        toast(
          error.message
        );

      } finally {

        $('sendButton').disabled =
          false;

      }

    }


    /* =========================================================
       INPUT RESIZE
    ========================================================== */

    function resizeInput() {

      const input =
        $('messageInput');

      input.style.height =
        'auto';

      input.style.height =
        Math.min(
          input.scrollHeight,
          110
        ) + 'px';

    }


    /* =========================================================
       ATTACHMENTS
    ========================================================== */

    function clearAttachment() {

      selectedFile = null;

      $('mediaInput').value = '';

      $('attachmentPreview')
        .classList.remove('show');

      $('attachmentThumb').src = '';

      $('attachmentName')
        .textContent = '';

    }


    function previewAttachment(file) {

      if (!file) return;

      selectedFile = file;


      const url =
        URL.createObjectURL(file);


      $('attachmentThumb').src =
        url;

      $('attachmentName')
        .textContent =
        file.name;


      $('attachmentPreview')
        .classList.add('show');

    }


    /* =========================================================
       SOCKET
    ========================================================== */

    function bindSocket() {

      socket.on(
        'user:online',
        data => {

          if (
            String(data.userId) !==
            String(TARGET_USER_ID)
          ) {
            return;
          }

          $('headerStatus')
            .textContent =
            'Active now';

          $('headerStatus')
            .classList.add(
              'online'
            );

        }
      );


      socket.on(
        'user:offline',
        data => {

          if (
            String(data.userId) !==
            String(TARGET_USER_ID)
          ) {
            return;
          }

          $('headerStatus')
            .textContent =
            targetUser?.isPrivate
              ? 'Private account'
              : 'Message';

          $('headerStatus')
            .classList.remove(
              'online'
            );

        }
      );


      socket.on(
        'typing:start',
        data => {

          if (
            String(data.userId) !==
            String(TARGET_USER_ID)
          ) {
            return;
          }

          $('typingIndicator')
            .textContent =
            (
              targetUser?.fullName ||
              'User'
            ) +
            ' is typing…';

        }
      );


      socket.on(
        'typing:stop',
        data => {

          if (
            String(data.userId) !==
            String(TARGET_USER_ID)
          ) {
            return;
          }

          $('typingIndicator')
            .textContent = '';

        }
      );


      socket.on(
        'message:new',
        message => {

          if (
            String(message.conversationId) !==
            String(conversationId)
          ) {
            return;
          }


          window.__messages =
            window.__messages || [];


          window.__messages.push(
            message
          );


          const welcome =
            $('welcome');

          if (
            welcome &&
            welcome.parentNode
          ) {
            welcome.remove();
          }


          const area =
            $('messagesArea');


          const date =
            formatDate(
              message.createdAt
            );


          const lastDivider =
            area.querySelector(
              '.date-divider:last-of-type'
            );


          if (
            !lastDivider ||
            lastDivider.textContent !== date
          ) {

            const divider =
              document.createElement(
                'div'
              );

            divider.className =
              'date-divider';

            divider.textContent =
              date;

            area.appendChild(
              divider
            );

          }


          area.appendChild(
            createMessageElement(
              message
            )
          );


          scrollToBottom();

          socket.emit(
            'message:read',
            {
              conversationId
            }
          );

        }
      );


      socket.on(
        'message:edited',
        message => {

          const index =
            window.__messages.findIndex(
              item =>
                String(item._id) ===
                String(message._id)
            );


          if (index >= 0) {

            window.__messages[index] =
              message;

          }


          const old =
            document.querySelector(
              `[data-message-id="${CSS.escape(
                String(message._id)
              )}"]`
            );


          if (!old) return;


          old.replaceWith(
            createMessageElement(
              message
            )
          );

        }
      );


      socket.on(
        'message:unsent',
        data => {

          const message =
            window.__messages.find(
              item =>
                String(item._id) ===
                String(data.messageId)
            );


          if (message) {

            message.deleted = true;

            message.text = '';

            message.mediaUrl = '';

          }


          const old =
            document.querySelector(
              `[data-message-id="${CSS.escape(
                String(data.messageId)
              )}"]`
            );


          if (!old) return;


          old.replaceWith(
            createMessageElement(
              message
            )
          );

        }
      );


      socket.on(
        'message:reactions',
        data => {

          const message =
            window.__messages.find(
              item =>
                String(item._id) ===
                String(data.messageId)
            );


          if (!message) return;


          message.reactions =
            data.reactions;


          const old =
            document.querySelector(
              `[data-message-id="${CSS.escape(
                String(data.messageId)
              )}"]`
            );


          if (!old) return;


          old.replaceWith(
            createMessageElement(
              message
            )
          );

        }
      );


      socket.on(
        'message:read',
        data => {

          if (
            String(data.conversationId) !==
            String(conversationId)
          ) {
            return;
          }


          window.__messages
            .filter(
              message =>
                isMine(message)
            )
            .forEach(
              message =>
                message.status =
                  'read'
            );


          document
            .querySelectorAll(
              '.message-row.sent .read-status'
            )
            .forEach(
              element => {

                element.textContent =
                  '✓✓';

                element.classList.add(
                  'read'
                );

              }
            );

        }
      );


      socket.on(
        'message:error',
        data => {

          toast(
            data.message ||
            'Unable to send message'
          );

        }
      );


      socket.on(
        'message:action:error',
        data => {

          toast(
            data.message ||
            'Unable to update message'
          );

        }
      );

    }


    /* =========================================================
       INITIALIZE
    ========================================================== */

    async function initializeChat() {

      try {

        const response =
          await api(
            '/messages/conversation',
            {
              method: 'POST',
              body: JSON.stringify({
                userId:
                  TARGET_USER_ID
              })
            }
          );


        const data =
          await response.json();


        if (
          !response.ok ||
          !data.success
        ) {

          throw new Error(
            data.message ||
            'Unable to open conversation'
          );

        }


        conversationId =
          data.conversationId;

        targetUser =
          data.target;


        updateUserUI();


        const messagesResponse =
          await api(
            '/messages/' +
            encodeURIComponent(
              conversationId
            )
          );


        const messagesData =
          await messagesResponse.json();


        if (
          !messagesResponse.ok ||
          !messagesData.success
        ) {

          throw new Error(
            messagesData.message ||
            'Unable to load messages'
          );

        }


        window.__messages =
          messagesData.messages || [];


        renderMessages(
          window.__messages
        );


        socket = io();

        bindSocket();


        socket.emit(
          'conversation:join',
          conversationId
        );


        socket.emit(
          'message:read',
          {
            conversationId
          }
        );


      } catch (error) {

        $('messagesArea').innerHTML = `
          <div class="welcome">
            <div style="
              font-size:36px;
              margin-bottom:12px;
            ">
              ⚠️
            </div>

            <div class="welcome-name">
              Unable to load chat
            </div>

            <div class="welcome-text">
              ${escapeHtml(error.message)}
            </div>

            <button
              type="button"
              onclick="location.reload()"
              style="
                margin-top:15px;
                padding:9px 16px;
                border:0;
                border-radius:8px;
                background:#0095f6;
                color:white;
              "
            >
              Try again
            </button>
          </div>
        `;

      }

    }


    /* =========================================================
       EVENTS
    ========================================================== */

    $('composer')
      .addEventListener(
        'submit',
        event => {

          event.preventDefault();

          sendMessage();

        }
      );


    $('messageInput')
      .addEventListener(
        'input',
        () => {

          resizeInput();


          if (
            socket &&
            conversationId
          ) {

            socket.emit(
              'typing:start',
              {
                conversationId
              }
            );


            clearTimeout(
              typingTimer
            );


            typingTimer =
              setTimeout(
                () => {

                  socket.emit(
                    'typing:stop',
                    {
                      conversationId
                    }
                  );

                },
                900
              );

          }

        }
      );


    $('messageInput')
      .addEventListener(
        'keydown',
        event => {

          if (
            event.key === 'Enter' &&
            !event.shiftKey &&
            window.innerWidth > 650
          ) {

            event.preventDefault();

            sendMessage();

          }

        }
      );


    $('attachmentButton')
      .addEventListener(
        'click',
        () => {

          $('mediaInput').click();

        }
      );


    $('mediaInput')
      .addEventListener(
        'change',
        event => {

          previewAttachment(
            event.target.files?.[0]
          );

        }
      );


    $('removeAttachment')
      .addEventListener(
        'click',
        clearAttachment
      );


    $('backButton')
      .addEventListener(
        'click',
        () => {

          if (history.length > 1) {

            history.back();

          } else {

            location.href =
              '/messages/chatlog';

          }

        }
      );


    $('profileButton')
      .addEventListener(
        'click',
        openProfile
      );


    $('profileButton')
      .addEventListener(
        'keydown',
        event => {

          if (event.key === 'Enter') {
            openProfile();
          }

        }
      );


    $('overlay')
      .addEventListener(
        'click',
        closeActions
      );


    $('replyAction')
      .addEventListener(
        'click',
        replyMessage
      );


    $('forwardAction')
      .addEventListener(
        'click',
        forwardMessage
      );


    $('copyAction')
      .addEventListener(
        'click',
        copyMessage
      );


    $('editAction')
      .addEventListener(
        'click',
        editMessage
      );


    $('unsendAction')
      .addEventListener(
        'click',
        unsendMessage
      );


    document
      .querySelectorAll(
        '[data-reaction]'
      )
      .forEach(
        button => {

          button.addEventListener(
            'click',
            () => {

              if (!activeMessageId) {
                return;
              }

              react(
                activeMessageId,
                button.dataset.reaction
              );

            }
          );

        }
      );


    $('moreButton')
      .addEventListener(
        'click',
        () => {

          toast('Conversation options');

