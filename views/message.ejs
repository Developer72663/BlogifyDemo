<!doctype html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <title>Messages | Blogify</title>
  <style>
    :root{--m-bg:#f5f7fb;--m-card:#fff;--m-text:#172033;--m-muted:#748096;--m-line:#e7ebf2;--m-soft:#f0f2f7;--m-brand:#635bff;--m-brand2:#5148ee;--m-green:#16a36d;--m-shadow:0 18px 55px rgba(28,35,52,.10)}
    body{margin:0;background:var(--m-bg);color:var(--m-text)}
    .dm-page{max-width:1180px;height:calc(100vh - 76px);min-height:620px;margin:auto;padding:18px;display:grid;grid-template-columns:330px minmax(0,1fr);gap:14px}
    .dm-panel{background:var(--m-card);border:1px solid var(--m-line);box-shadow:var(--m-shadow);overflow:hidden}
    .dm-sidebar{border-radius:22px;display:flex;flex-direction:column;min-width:0}.dm-sidebar-head{padding:20px;border-bottom:1px solid var(--m-line)}
    .dm-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}.dm-title h1{font-size:1.45rem;margin:0;font-weight:850;letter-spacing:-.03em}.dm-title span{font-size:.72rem;color:var(--m-muted)}
    .dm-search{width:100%;border:1px solid var(--m-line);background:var(--m-soft);color:var(--m-text);border-radius:12px;padding:11px 13px;outline:none}.dm-search:focus{border-color:var(--m-brand);box-shadow:0 0 0 3px rgba(99,91,255,.1)}
    .dm-list{overflow:auto;flex:1}.dm-item{width:100%;border:0;border-bottom:1px solid var(--m-line);background:transparent;color:var(--m-text);padding:14px 16px;display:flex;gap:11px;text-align:left;cursor:pointer;transition:.15s}.dm-item:hover{background:var(--m-soft)}.dm-item.active{background:#eeedff}.dm-avatar{width:48px;height:48px;border-radius:50%;object-fit:cover;flex:none;background:#ddd}.dm-item-body{min-width:0;flex:1}.dm-item-top{display:flex;justify-content:space-between;gap:8px}.dm-item-name{font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dm-time{font-size:.66rem;color:var(--m-muted);white-space:nowrap}.dm-preview{font-size:.76rem;color:var(--m-muted);margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dm-empty{margin:auto;text-align:center;color:var(--m-muted);padding:35px 20px}.dm-empty-icon{font-size:2.5rem;margin-bottom:10px;color:var(--m-brand)}
    .dm-chat{border-radius:22px;display:grid;grid-template-rows:auto minmax(0,1fr) auto;min-width:0}.dm-chat-head{display:flex;align-items:center;gap:12px;padding:15px 18px;border-bottom:1px solid var(--m-line)}.dm-back{display:none;border:0;background:var(--m-soft);width:36px;height:36px;border-radius:10px}.dm-head-avatar{width:44px;height:44px;border-radius:50%;object-fit:cover;background:#ddd}.dm-head-info{min-width:0;flex:1}.dm-head-name{font-weight:850}.dm-status{font-size:.72rem;color:var(--m-muted);margin-top:2px}.dm-status.online{color:var(--m-green)}.dm-head-action{border:0;background:var(--m-soft);width:38px;height:38px;border-radius:10px;color:var(--m-text)}
    .dm-messages{overflow:auto;padding:24px 22px;display:flex;flex-direction:column;gap:7px;background:linear-gradient(180deg,#fafbfe 0%,#f6f8fc 100%)}.dm-day{text-align:center;font-size:.68rem;color:var(--m-muted);margin:8px 0}.dm-bubble{max-width:min(72%,580px);padding:10px 13px;border-radius:16px 16px 16px 5px;background:#fff;border:1px solid var(--m-line);box-shadow:0 3px 12px rgba(20,28,45,.04);align-self:flex-start;word-break:break-word;line-height:1.45}.dm-bubble.mine{align-self:flex-end;background:var(--m-brand);border-color:var(--m-brand);color:#fff;border-radius:16px 16px 5px 16px}.dm-bubble.deleted{font-style:italic;opacity:.72}.dm-meta{font-size:.62rem;opacity:.62;margin-top:4px;text-align:right}.dm-typing{min-height:20px;padding:0 22px;font-size:.7rem;color:var(--m-muted);background:#f6f8fc}.dm-composer{border-top:1px solid var(--m-line);padding:13px;display:flex;gap:9px;background:var(--m-card)}.dm-input-wrap{display:flex;align-items:center;gap:8px;flex:1;border:1px solid var(--m-line);border-radius:14px;background:var(--m-soft);padding:0 12px}.dm-input{border:0;outline:0;background:transparent;color:var(--m-text);width:100%;padding:12px 2px;font:inherit}.dm-attach{border:0;background:transparent;color:var(--m-muted)}.dm-send{border:0;width:46px;height:46px;border-radius:13px;background:var(--m-brand);color:#fff;font-size:1.05rem}.dm-send:hover{background:var(--m-brand2)}.dm-send:disabled{opacity:.5;cursor:not-allowed}.dm-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:var(--m-muted);padding:30px}.dm-placeholder .icon{width:72px;height:72px;border-radius:22px;background:#eeedff;color:var(--m-brand);display:grid;place-items:center;font-size:2rem;margin-bottom:15px}.dm-placeholder h2{color:var(--m-text);font-size:1.25rem;margin:0 0 7px}.dm-placeholder p{max-width:390px;margin:0;line-height:1.55;font-size:.86rem}
    @media(max-width:780px){.dm-page{height:calc(100vh - 64px);min-height:0;padding:8px;display:block}.dm-sidebar,.dm-chat{height:100%;border-radius:16px}.dm-chat{display:none}.dm-page.chat-open .dm-sidebar{display:none}.dm-page.chat-open .dm-chat{display:grid}.dm-back{display:block}.dm-bubble{max-width:86%}}
  </style>
</head>
<body>
<%- include('./partials/nave') %>
<main class="dm-page" id="dmPage">
  <aside class="dm-panel dm-sidebar">
    <div class="dm-sidebar-head">
      <div class="dm-title"><h1>Messages</h1><span id="onlineCount">Real-time chat</span></div>
      <input class="dm-search" id="search" type="search" placeholder="Search conversations..." autocomplete="off">
    </div>
    <div class="dm-list" id="conversationList"><div class="dm-empty">Loading conversations...</div></div>
  </aside>

  <section class="dm-panel dm-chat">
    <header class="dm-chat-head">
      <button class="dm-back" id="back" aria-label="Back"><i class="fas fa-arrow-left"></i></button>
      <img class="dm-head-avatar" id="chatAvatar" src="/imgs/default.png" alt="">
      <div class="dm-head-info"><div class="dm-head-name" id="chatName">Messages</div><div class="dm-status" id="chatStatus">Select a conversation</div></div>
      <button class="dm-head-action" id="profileBtn" title="View profile" hidden><i class="fas fa-user"></i></button>
    </header>
    <div class="dm-messages" id="messagesList">
      <div class="dm-placeholder"><div class="icon"><i class="fas fa-comments"></i></div><h2>Your messages</h2><p>Choose a conversation from the left, or open a user's profile and tap Message to start a chat.</p></div>
    </div>
    <div>
      <div class="dm-typing" id="typing"></div>
      <form class="dm-composer" id="composer">
        <div class="dm-input-wrap"><button class="dm-attach" type="button" title="Attachments coming soon"><i class="fas fa-paperclip"></i></button><input class="dm-input" id="messageInput" autocomplete="off" maxlength="5000" placeholder="Write a message..." disabled></div>
        <button class="dm-send" id="send" type="submit" disabled><i class="fas fa-paper-plane"></i></button>
      </form>
    </div>
  </section>
</main>
<%- include('./partials/scripts') %>
<script src="/socket.io/socket.io.js"></script>
<script>
const CURRENT_USER='<%= user?._id %>';
const state={conversations:[],current:null,other:null,online:new Set()};
const page=document.getElementById('dmPage'),list=document.getElementById('conversationList'),msgs=document.getElementById('messagesList'),input=document.getElementById('messageInput'),send=document.getElementById('send'),nameEl=document.getElementById('chatName'),avatar=document.getElementById('chatAvatar'),statusEl=document.getElementById('chatStatus'),typingEl=document.getElementById('typing'),search=document.getElementById('search');
let socket=null,typingTimer=null;
function esc(v){const d=document.createElement('div');d.textContent=v??'';return d.innerHTML}
function avatarUrl(v){return v&&String(v).trim()?String(v):'/imgs/default.png'}
function otherUser(c){return (c.participants||[]).find(p=>String(p._id)!==String(CURRENT_USER))||c.participants?.[0]}
function formatTime(v){if(!v)return'';const d=new Date(v);return d.toLocaleDateString()===new Date().toLocaleDateString()?d.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}):d.toLocaleDateString([], {day:'numeric',month:'short'})}
function renderList(){const q=search.value.trim().toLowerCase();const items=state.conversations.filter(c=>{const o=otherUser(c);return !q||(o?.fullName||'').toLowerCase().includes(q)||(c.lastMessage?.text||'').toLowerCase().includes(q)});list.innerHTML=items.length?items.map(c=>{const o=otherUser(c);return `<button class="dm-item ${String(c._id)===String(state.current)?'active':''}" data-id="${c._id}"><img class="dm-avatar" src="${esc(avatarUrl(o?.profileImageURL))}" onerror="this.src='/imgs/default.png'"><span class="dm-item-body"><span class="dm-item-top"><span class="dm-item-name">${esc(o?.fullName||'User')}</span><span class="dm-time">${formatTime(c.lastMessageAt||c.updatedAt)}</span></span><span class="dm-preview">${esc(c.lastMessage?.text||'Start a conversation')}</span></span></button>`}).join(''):'<div class="dm-empty"><div class="dm-empty-icon"><i class="fas fa-search"></i></div><p>No conversations found.</p></div>';list.querySelectorAll('.dm-item').forEach(b=>b.onclick=()=>openConversation(b.dataset.id))}
async function api(url,opts={}){const r=await fetch(url,{credentials:'same-origin',headers:{'Content-Type':'application/json',...(opts.headers||{})},...opts});let d={};try{d=await r.json()}catch{}if(!r.ok||d.success===false)throw new Error(d.message||'Request failed');return d}
async function load(){const d=await api('/messages');state.conversations=d.conversations||[];renderList()}
function setHeader(o){state.other=o;nameEl.textContent=o?.fullName||'User';avatar.src=avatarUrl(o?.profileImageURL);statusEl.textContent=state.online.has(String(o?._id))?'Online':'Offline';statusEl.className='dm-status'+(state.online.has(String(o?._id))?' online':'');const btn=document.getElementById('profileBtn');if(o?._id){btn.hidden=false;btn.onclick=()=>location.href='/user/profile/'+o._id}else btn.hidden=true}
async function openConversation(id){const c=state.conversations.find(x=>String(x._id)===String(id));if(!c)return;state.current=id;const o=otherUser(c);setHeader(o);renderList();page.classList.add('chat-open');input.disabled=false;send.disabled=false;msgs.innerHTML='<div class="dm-empty">Loading messages...</div>';try{const d=await api('/messages/'+id);msgs.innerHTML=(d.messages||[]).map(renderMessage).join('')||'<div class="dm-empty">No messages yet. Say hello 👋</div>';scrollBottom();socket?.emit('conversation:join',id);socket?.emit('message:read',{conversationId:id})}catch(e){msgs.innerHTML=`<div class="dm-empty">${esc(e.message)}</div>`}}
function renderMessage(m){const sid=m.senderId?._id||m.senderId;const mine=String(sid)===String(CURRENT_USER);const status=m.status==='read'?'✓✓':m.status==='delivered'?'✓✓':'✓';return `<div class="dm-bubble ${mine?'mine':''} ${m.deleted?'deleted':''}">${m.deleted?'Message deleted':esc(m.text)}<div class="dm-meta">${formatTime(m.createdAt)} ${mine?status:''}</div></div>`}
function appendMessage(m){if(String(m.conversationId)!==String(state.current))return;msgs.insertAdjacentHTML('beforeend',renderMessage(m));scrollBottom();if(socket)socket.emit('message:read',{conversationId:state.current})}
function scrollBottom(){msgs.scrollTop=msgs.scrollHeight}
function updateOnline(id,isOnline){if(isOnline)state.online.add(String(id));else state.online.delete(String(id));if(state.other&&String(state.other._id)===String(id))setHeader(state.other);}
search.addEventListener('input',renderList);
document.getElementById('back').onclick=()=>page.classList.remove('chat-open');
document.getElementById('composer').addEventListener('submit',e=>{e.preventDefault();const text=input.value.trim();if(!text||!state.current||!socket)return;send.disabled=true;socket.emit('message:send',{conversationId:state.current,text});input.value='';setTimeout(()=>send.disabled=false,250)});
input.addEventListener('input',()=>{if(!state.current||!socket)return;socket.emit('typing:start',{conversationId:state.current});clearTimeout(typingTimer);typingTimer=setTimeout(()=>socket.emit('typing:stop',{conversationId:state.current}),700)});
(async()=>{try{await load();socket=io({withCredentials:true});socket.on('connect',()=>{if(state.current)socket.emit('conversation:join',state.current)});socket.on('connect_error',e=>{statusEl.textContent='Real-time connection unavailable';console.warn(e.message)});socket.on('user:online',d=>updateOnline(d.userId,true));socket.on('user:offline',d=>updateOnline(d.userId,false));socket.on('message:new',m=>{appendMessage(m);load().catch(()=>{});});socket.on('message:read',()=>load().catch(()=>{}));socket.on('typing:start',d=>{if(state.other&&String(d.userId)===String(state.other._id))typingEl.textContent=`${state.other.fullName||'User'} is typing...`});socket.on('typing:stop',d=>{if(!state.other||String(d.userId)===String(state.other._id))typingEl.textContent=''});
const target=new URLSearchParams(location.search).get('user');if(target){try{const d=await api('/messages/conversation',{method:'POST',body:JSON.stringify({userId:target})});await load();await openConversation(d.conversationId)}catch(e){console.warn('Unable to open DM:',e.message)}}
}catch(e){list.innerHTML=`<div class="dm-empty"><div class="dm-empty-icon"><i class="fas fa-exclamation-circle"></i></div><p>${esc(e.message)}</p></div>`}})();
</script>
</body>
</html>