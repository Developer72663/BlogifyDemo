<!doctype html><html lang="en"><head><%- include('./partials/head') %><title>Chat | Blogify</title><style>:root{--bg:#f5f7fb;--card:#fff;--text:#172033;--muted:#778197;--line:#e6eaf1;--soft:#f1f3f8;--brand:#635bff;--green:#19a66f}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}.chat-page{height:calc(100vh - 70px);max-width:900px;margin:auto;padding:10px}.chat{height:100%;background:var(--card);border:1px solid var(--line);border-radius:22px;overflow:hidden;display:grid;grid-template-rows:auto 1fr auto;box-shadow:0 18px 55px rgba(25,32,50,.1)}.head{display:flex;align-items:center;gap:11px;padding:12px 15px;border-bottom:1px solid var(--line)}.back,.profile{border:0;background:var(--soft);color:var(--text);width:38px;height:38px;border-radius:11px}.back{cursor:pointer}.avatar{width:43px;height:43px;border-radius:50%;object-fit:cover;background:#ddd}.info{flex:1;min-width:0}.name{font-weight:850}.status{font-size:.72rem;color:var(--muted);margin-top:2px}.status.online{color:var(--green)}.messages{overflow:auto;padding:22px 18px;display:flex;flex-direction:column;gap:7px;background:linear-gradient(180deg,#fafbfe,#f5f7fb)}.bubble{max-width:min(75%,600px);padding:10px 13px;background:#fff;border:1px solid var(--line);border-radius:17px 17px 17px 5px;line-height:1.45;word-break:break-word;align-self:flex-start;box-shadow:0 2px 10px rgba(20,28,45,.04)}.bubble.mine{align-self:flex-end;background:var(--brand);border-color:var(--brand);color:#fff;border-radius:17px 17px 5px 17px}.meta{font-size:.61rem;opacity:.65;text-align:right;margin-top:4px}.typing{min-height:19px;padding:0 18px;font-size:.7rem;color:var(--muted)}.composer{padding:11px;border-top:1px solid var(--line);display:flex;gap:8px;background:var(--card)}.input-wrap{flex:1;display:flex;align-items:center;border:1px solid var(--line);background:var(--soft);border-radius:15px;padding:0 13px}.input{width:100%;border:0;outline:0;background:transparent;color:var(--text);padding:12px 2px;font:inherit}.send{width:46px;height:46px;border:0;border-radius:14px;background:var(--brand);color:#fff;cursor:pointer}.send:disabled{opacity:.45}.empty{text-align:center;color:var(--muted);margin:auto;padding:35px}.empty i{font-size:2.5rem;color:var(--brand);margin-bottom:12px}.error{color:#c24141}@media(max-width:600px){.chat-page{height:calc(100vh - 60px);padding:0}.chat{border-radius:0;border-left:0;border-right:0}.messages{padding:18px 12px}.bubble{max-width:88%}}</style></head><body><%- include('./partials/nave') %><main class="chat-page"><section class="chat"><header class="head"><button class="back" id="back" aria-label="Back to messages"><i class="fas fa-arrow-left"></i></button><img id="avatar" class="avatar" src="/imgs/default.png" alt=""><div class="info"><div id="name" class="name">Opening chat...</div><div id="status" class="status">Loading conversation</div></div><button id="profile" class="profile" hidden title="View profile"><i class="fas fa-user"></i></button></header><div class="messages" id="messages"><div class="empty"><i class="fas fa-spinner fa-spin"></i><div>Opening conversation...</div></div></div><div><div id="typing" class="typing"></div><form class="composer" id="composer"><div class="input-wrap"><input id="input" class="input" maxlength="5000" autocomplete="off" enterkeyhint="send" placeholder="Message..." disabled></div><button id="send" class="send" type="submit" disabled aria-label="Send"><i class="fas fa-paper-plane"></i></button></form></div></section></main><%- include('./partials/scripts') %><script src="/socket.io/socket.io.js"></script><script>const CURRENT='<%= user._id %>';const TARGET='<%= targetUserId %>';let conversationId=null,other=null,socket=null,typingTimer=null;const $=id=>document.getElementById(id),messages=$('messages'),input=$('input'),send=$('send');function esc(v){const d=document.createElement('div');d.textContent=v??'';return d.innerHTML}function img(v){return v&&String(v).trim()?String(v):'/imgs/default.png'}function tm(v){if(!v)return'';return new Date(v).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}async function api(url,opts={}){const r=await fetch(url,{credentials:'same-origin',headers:{'Content-Type':'application/json'},...opts});let d={};try{d=await r.json()}catch{}if(!r.ok||d.success===false)throw new Error(d.message||'Request failed');return d}function header(){if(!other)return;$('name').textContent=other.fullName||'User';$('avatar').src=img(other.profileImageURL);$('avatar').onerror=()=>{$('avatar').src='/imgs/default.png'};$('profile').hidden=false;$('profile').onclick=()=>location.href='/user/profile/'+other._id;$('status').textContent=other.isPrivate?'Private account':'Message';}function bubble(m){const sid=m.senderId?._id||m.senderId;const mine=String(sid)===String(CURRENT);const st=m.status==='read'?'✓✓':m.status==='delivered'?'✓✓':'✓';return `<div class="bubble ${mine?'mine':''}">${m.deleted?'Message deleted':esc(m.text)}<div class="meta">${tm(m.createdAt)} ${mine?st:''}</div></div>`}function scroll(){messages.scrollTop=messages.scrollHeight}function add(m){if(String(m.conversationId)!==String(conversationId))return;messages.insertAdjacentHTML('beforeend',bubble(m));scroll();socket?.emit('message:read',{conversationId})}async function start(){if(!TARGET)throw new Error('No user selected');const d=await api('/messages/conversation',{method:'POST',body:JSON.stringify({userId:TARGET})});conversationId=d.conversationId;other=d.target;header();const h=await api('/messages/'+conversationId);other=(h.conversation?.participants||[]).find(p=>String(p._id)!==String(CURRENT))||other;header();const list=h.messages||[];messages.innerHTML=list.length?list.map(bubble).join(''):'<div class="empty"><i class="fas fa-comment-dots"></i><div>No messages yet. Say hello 👋</div></div>';scroll();input.disabled=false;send.disabled=false;socket=io({withCredentials:true});socket.on('connect',()=>{socket.emit('conversation:join',conversationId);socket.emit('message:read',{conversationId})});socket.on('message:new',add);socket.on('message:error',e=>{send.disabled=false;alert(e.message||'Unable to send message')});socket.on('typing:start',d=>{if(other&&String(d.userId)===String(other._id))$('typing').textContent=(other.fullName||'User')+' is typing...'});socket.on('typing:stop',d=>{if(!other||String(d.userId)===String(other._id))$('typing').textContent=''});socket.on('user:online',d=>{if(other&&String(d.userId)===String(other._id)){$('status').textContent='Online';$('status').className='status online'}});socket.on('user:offline',d=>{if(other&&String(d.userId)===String(other._id)){$('status').textContent='Offline';$('status').className='status'}})}$('back').onclick=()=>location.href='/messages/chatlog';$('composer').onsubmit=e=>{e.preventDefault();const text=input.value.trim();if(!text||!conversationId||!socket)return;send.disabled=true;socket.emit('message:send',{conversationId,text});input.value='';input.focus();setTimeout(()=>send.disabled=false,300)};input.oninput=()=>{if(!conversationId||!socket)return;socket.emit('typing:start',{conversationId});clearTimeout(typingTimer);typingTimer=setTimeout(()=>socket.emit('typing:stop',{conversationId}),700)};start().catch(e=>{messages.innerHTML='<div class="empty error"><i class="fas fa-lock"></i><div>'+esc(e.message)+'</div><br><button onclick="location.href=\'/messages/chatlog\'" class="send">Back</button></div>'});</script></body></html>