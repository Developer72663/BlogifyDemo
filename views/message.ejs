<!doctype html><html lang="en"><head><%- include('./partials/head') %><title>Chat | Blogify</title><style>:root{--bg:#f4f6fb;--card:#fff;--text:#172033;--muted:#788299;--line:#e5e9f1;--soft:#f0f2f7;--brand:#635bff;--like:#ef3f72;--green:#18a56f;--danger:#ef4444}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}.chat-page{height:calc(100vh - 70px);max-width:920px;margin:auto;padding:10px}.chat{height:100%;background:var(--card);border:1px solid var(--line);border-radius:22px;overflow:hidden;display:grid;grid-template-rows:auto 1fr auto;box-shadow:0 18px 55px rgba(25,32,50,.1)}.head{display:flex;align-items:center;gap:11px;padding:12px 15px;border-bottom:1px solid var(--line)}.back,.profile,.attach,.more{border:0;background:var(--soft);color:var(--text);width:38px;height:38px;border-radius:11px;cursor:pointer}.avatar{width:43px;height:43px;border-radius:50%;object-fit:cover;background:#ddd}.info{flex:1;min-width:0}.name{font-weight:850}.status{font-size:.72rem;color:var(--muted);margin-top:2px}.status.online{color:var(--green)}.head-actions{position:relative;display:flex;gap:6px}.safety-menu{display:none;position:absolute;right:0;top:46px;z-index:50;width:230px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:7px;box-shadow:0 16px 45px rgba(15,23,42,.18)}.safety-menu.open{display:block}.safety-menu button{width:100%;display:flex;gap:9px;padding:10px;border:0;background:none;color:var(--text);border-radius:9px;text-align:left;cursor:pointer}.safety-menu button:hover{background:var(--soft)}.safety-menu .danger{color:var(--danger)}.messages{overflow:auto;padding:22px 18px;display:flex;flex-direction:column;gap:9px;background:linear-gradient(180deg,#fafbfe,#f4f6fb)}.row{display:flex;align-items:flex-end;gap:6px}.row.mine{justify-content:flex-end}.bubble{position:relative;max-width:min(75%,600px);padding:9px 11px;background:#fff;border:1px solid var(--line);border-radius:17px 17px 17px 5px;line-height:1.45;word-break:break-word;align-self:flex-start;box-shadow:0 2px 10px rgba(20,28,45,.04);user-select:none}.row.mine .bubble{background:var(--brand);border-color:var(--brand);color:#fff;border-radius:17px 17px 5px 17px}.media{display:block;max-width:min(360px,70vw);max-height:420px;border-radius:13px;object-fit:cover;margin-bottom:5px}.media.video{background:#000}.meta{font-size:.61rem;opacity:.65;text-align:right;margin-top:4px}.reaction{min-width:22px;height:22px;border:0;border-radius:50%;background:var(--card);box-shadow:0 2px 7px rgba(0,0,0,.12);color:var(--like);font-size:.72rem;padding:0;cursor:pointer}.like-count{font-size:.68rem;margin-left:4px;color:var(--like)}.typing{min-height:19px;padding:0 18px;font-size:.7rem;color:var(--muted)}.preview{display:none;padding:8px 11px;border-top:1px solid var(--line);background:var(--soft);align-items:center;gap:9px}.preview.show{display:flex}.preview-box{width:54px;height:54px;border-radius:10px;overflow:hidden;background:#111;flex:none}.preview-box img,.preview-box video{width:100%;height:100%;object-fit:cover}.preview-name{flex:1;min-width:0;font-size:.78rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.remove{border:0;background:transparent;color:var(--muted);font-size:1.1rem;cursor:pointer}.composer{padding:11px;border-top:1px solid var(--line);display:flex;gap:7px;background:var(--card)}.input-wrap{flex:1;display:flex;align-items:center;border:1px solid var(--line);background:var(--soft);border-radius:15px;padding:0 12px}.input{width:100%;border:0;outline:0;background:transparent;color:var(--text);padding:12px 2px;font:inherit}.send{width:46px;height:46px;border:0;border-radius:14px;background:var(--brand);color:#fff;cursor:pointer}.send:disabled{opacity:.45}.attach{flex:none}.empty{text-align:center;color:var(--muted);margin:auto;padding:35px}.empty i{font-size:2.5rem;color:var(--brand);margin-bottom:12px}.error{color:#c24141}.hint{font-size:.66rem;color:var(--muted);padding:0 14px 7px}@media(max-width:600px){.chat-page{height:calc(100vh - 60px);padding:0}.chat{border-radius:0;border-left:0;border-right:0}.messages{padding:18px 10px}.bubble{max-width:88%}.media{max-width:76vw}.hint{display:none}}</style></head><body><%- include('./partials/nave') %><main class="chat-page"><section class="chat"><header class="head"><button class="back" id="back" aria-label="Back to messages"><i class="fas fa-arrow-left"></i></button><img id="avatar" class="avatar" src="/imgs/default.png" alt=""><div class="info"><div id="name" class="name">Opening chat...</div><div id="status" class="status">Loading conversation</div></div><div class="head-actions"><button id="profile" class="profile" hidden title="View profile"><i class="fas fa-user"></i></button><button class="more" id="more" type="button" title="Chat options"><i class="fas fa-ellipsis-h"></i></button><div class="safety-menu" id="safetyMenu"><button onclick="viewTargetProfile()"><i class="fas fa-user"></i> View profile</button><button onclick="shareTargetProfile()"><i class="fas fa-share"></i> Share profile</button><button onclick="restrictTarget()"><i class="fas fa-user-shield"></i> Restrict</button><button class="danger" onclick="blockTarget()"><i class="fas fa-ban"></i> Block</button><button onclick="openTargetReport()"><i class="fas fa-flag"></i> Report</button></div></div></header><div class="messages" id="messages"><div class="empty"><i class="fas fa-spinner fa-spin"></i><div>Opening conversation...</div></div></div><div><div id="typing" class="typing"></div><div id="preview" class="preview"><div class="preview-box" id="previewBox"></div><div class="preview-name" id="previewName"></div><button class="remove" id="removeMedia" type="button" aria-label="Remove attachment">×</button></div><div class="hint">Double-tap a message to ❤️ like it</div><form class="composer" id="composer"><input id="file" type="file" accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime,video/x-msvideo" hidden><button class="attach" id="attach" type="button" disabled title="Photo or video"><i class="fas fa-paperclip"></i></button><div class="input-wrap"><input id="input" class="input" maxlength="5000" autocomplete="off" enterkeyhint="send" placeholder="Message..." disabled></div><button id="send" class="send" type="submit" disabled aria-label="Send"><i class="fas fa-paper-plane"></i></button></form></div></section></main><%- include('./partials/scripts') %><script src="/socket.io/socket.io.js"></script><script>const CURRENT='<%= user._id %>';const TARGET='<%= targetUserId %>';let conversationId=null,other=null,socket=null,typingTimer=null,selectedFile=null,uploading=false;const $=id=>document.getElementById(id),messages=$('messages'),input=$('input'),send=$('send'),file=$('file'),attach=$('attach'),preview=$('preview');function esc(v){const d=document.createElement('div');d.textContent=v??'';return d.innerHTML}function img(v){return v&&String(v).trim()?String(v):'/imgs/default.png'}function tm(v){if(!v)return'';return new Date(v).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}async function api(url,opts={}){const r=await fetch(url,{credentials:'same-origin',headers:{Accept:'application/json',...(opts.headers||{})},...opts});let d={};try{d=await r.json()}catch{}if(!r.ok||d.success===false)throw new Error(d.message||'Request failed');return d}function header(){if(!other)return;$('name').textContent=other.fullName||'User';$('avatar').src=img(other.profileImageURL);$('avatar').onerror=()=>{$('avatar').src='/imgs/default.png'};$('profile').hidden=false;$('profile').onclick=viewTargetProfile;$('status').textContent=other.isPrivate?'Private account':'Message';}function mediaHtml(m){if(!m.mediaUrl)return'';if(m.mediaType==='video')return `<video class="media video" src="${esc(m.mediaUrl)}" controls playsinline preload="metadata"></video>`;return `<img class="media" src="${esc(m.mediaUrl)}" alt="Photo" loading="lazy">`}function bubble(m){const sid=m.senderId?._id||m.senderId;const mine=String(sid)===String(CURRENT);const st=m.status==='read'?'✓✓':m.status==='delivered'?'✓✓':'✓';const liked=(m.likes||[]).some(x=>String(x?._id||x)===String(CURRENT));const count=(m.likes||[]).length;return `<div class="row ${mine?'mine':''}" data-message="${esc(m._id)}"><div class="bubble" data-like="${esc(m._id)}">${mediaHtml(m)}${m.deleted?'Message deleted':esc(m.text)}<div class="meta">${tm(m.createdAt)} ${mine?st:''}${count?` <span class="like-count">♥ ${count}</span>`:''}</div></div><button class="reaction" type="button" data-like="${esc(m._id)}" aria-label="Like message">${liked?'♥':'♡'}</button></div>`}function scroll(){messages.scrollTop=messages.scrollHeight}function add(m){if(String(m.conversationId)!==String(conversationId))return;const empty=messages.querySelector('.empty');if(empty)messages.innerHTML='';messages.insertAdjacentHTML('beforeend',bubble(m));scroll();socket?.emit('message:read',{conversationId});bindLikes(messages.lastElementChild)}async function likeMessage(id){try{const d=await api('/messages/'+encodeURIComponent(id)+'/like',{method:'POST'});const row=document.querySelector(`[data-message="${CSS.escape(id)}"]`);if(!row)return;const btn=row.querySelector('.reaction');if(btn)btn.textContent=d.liked?'♥':'♡';let count=row.querySelector('.like-count');if(d.likes>0){if(!count){const meta=row.querySelector('.meta');count=document.createElement('span');count.className='like-count';meta.appendChild(count)}count.textContent='♥ '+d.likes}else if(count)count.remove()}catch(e){console.warn('like:',e.message)}}function bindLikes(root=document){root.querySelectorAll('[data-like]').forEach(el=>{if(el.dataset.bound)return;el.dataset.bound='1';let last=0;el.addEventListener('dblclick',()=>likeMessage(el.dataset.like));el.addEventListener('click',e=>{if(el.classList.contains('reaction'))likeMessage(el.dataset.like);else{const now=Date.now();if(now-last<330){e.preventDefault();likeMessage(el.dataset.like)}last=now}})})}function setPreview(){if(!selectedFile){preview.classList.remove('show');$('previewBox').innerHTML='';$('previewName').textContent='';return}const url=URL.createObjectURL(selectedFile);$('previewBox').innerHTML=selectedFile.type.startsWith('video/')?`<video src="${url}" muted playsinline></video>`:`<img src="${url}" alt="Preview">`;$('previewName').textContent=selectedFile.name;preview.classList.add('show')}file.onchange=()=>{selectedFile=file.files?.[0]||null;if(selectedFile&&selectedFile.size>60*1024*1024){alert('Maximum file size is 60 MB');selectedFile=null;file.value=''}setPreview()};$('removeMedia').onclick=()=>{selectedFile=null;file.value='';setPreview()};attach.onclick=()=>file.click();async function uploadMedia(){const fd=new FormData();fd.append('media',selectedFile);const r=await fetch('/messages/upload',{method:'POST',credentials:'same-origin',body:fd});const d=await r.json().catch(()=>({}));if(!r.ok||!d.success)throw new Error(d.message||'Unable to upload media');return d}async function start(){if(!TARGET)throw new Error('No user selected');const d=await api('/messages/conversation',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({userId:TARGET})});conversationId=d.conversationId;other=d.target;header();const h=await api('/messages/'+conversationId);other=(h.conversation?.participants||[]).find(p=>String(p._id)!==String(CURRENT))||other;header();const list=h.messages||[];messages.innerHTML=list.length?list.map(bubble).join(''):'<div class="empty"><i class="fas fa-comment-dots"></i><div>No messages yet. Say hello 👋</div></div>';scroll();bindLikes();input.disabled=false;send.disabled=false;attach.disabled=false;socket=io({withCredentials:true});socket.on('connect',()=>{socket.emit('conversation:join',conversationId);socket.emit('message:read',{conversationId})});socket.on('message:new',add);socket.on('message:error',e=>{send.disabled=false;uploading=false;alert(e.message||'Unable to send message')});socket.on('typing:start',d=>{if(other&&String(d.userId)===String(other._id))$('typing').textContent=(other.fullName||'User')+' is typing...'});socket.on('typing:stop',d=>{if(!other||String(d.userId)===String(other._id))$('typing').textContent=''});socket.on('user:online',d=>{if(other&&String(d.userId)===String(other._id)){$('status').textContent='Online';$('status').className='status online'}});socket.on('user:offline',d=>{if(other&&String(d.userId)===String(other._id)){$('status').textContent='Offline';$('status').className='status'}})}$('back').onclick=()=>location.href='/messages/chatlog';$('more').onclick=e=>{e.stopPropagation();$('safetyMenu').classList.toggle('open')};document.addEventListener('click',e=>{if(!e.target.closest('.head-actions'))$('safetyMenu')?.classList.remove('open')});function viewTargetProfile(){if(other)location.href='/profile/'+other._id}function shareTargetProfile(){if(other)location.href='/messages/chatlog?share='+encodeURIComponent(other._id)}async function blockTarget(){if(!other||!confirm('Block this account?'))return;try{const d=await api('/safety/'+other._id+'/block',{method:'POST'});if(d.success){alert('User blocked.');location.href='/messages/chatlog'}}catch(e){alert(e.message)}}async function restrictTarget(){if(!other)return;try{const d=await api('/safety/'+other._id+'/restrict',{method:'POST'});alert(d.message||'User restricted.')}catch(e){alert(e.message)}}function openTargetReport(){if(!other)return;const reason=prompt('Report reason: spam, harassment, hate, scam, inappropriate, impersonation, other','spam');if(!reason)return;api('/safety/'+other._id+'/report',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reason})}).then(()=>alert('Report submitted.')).catch(e=>alert(e.message))}$('composer').onsubmit=async e=>{e.preventDefault();if(!conversationId||!socket||uploading)return;const text=input.value.trim();if(!text&&!selectedFile)return;uploading=true;send.disabled=true;try{let mediaUrl='',mediaType='';if(selectedFile){const d=await uploadMedia();mediaUrl=d.mediaUrl;mediaType=d.mediaType}socket.emit('message:send',{conversationId,text,mediaUrl,mediaType});input.value='';selectedFile=null;file.value='';setPreview();setTimeout(()=>{send.disabled=false;uploading=false},450)}catch(err){uploading=false;send.disabled=false;alert(err.message||'Unable to send media')}};input.oninput=()=>{if(!conversationId||!socket)return;socket.emit('typing:start',{conversationId});clearTimeout(typingTimer);typingTimer=setTimeout(()=>socket.emit('typing:stop',{conversationId}),700)};start().catch(e=>{messages.innerHTML='<div class="empty error"><i class="fas fa-lock"></i><div>'+esc(e.message)+'</div><br><button onclick="location.href=\'/messages/chatlog\'" class="send">Back</button></div>'});</script></body></html>