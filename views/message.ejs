```ejs
<!doctype html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Messages | Blogify</title>

  <style>
    :root {
      --bg: #f5f6fa;
      --surface: #fff;
      --surface-soft: #f0f1f5;
      --text: #171923;
      --muted: #737887;
      --line: #e4e6ec;
      --primary: #635bff;
      --primary-dark: #5148e8;
      --received: #fff;
      --sent: #635bff;
      --danger: #ef4444;
      --green: #20a56a;
      --shadow: 0 12px 40px rgba(20, 25, 40, .10);
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      margin: 0;
      background: var(--bg);
      color: var(--text);
    }

    body {
      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    button,
    input,
    textarea {
      font: inherit;
    }

    button {
      -webkit-tap-highlight-color: transparent;
    }

    .page {
      height: calc(100dvh - 70px);
      min-height: 520px;
      display: flex;
      justify-content: center;
    }

    .chat-shell {
      width: min(1100px, 100%);
      height: 100%;
      background: var(--surface);
      display: grid;
      grid-template-rows: 68px minmax(0, 1fr) auto;
      overflow: hidden;
      position: relative;
    }

    @media (min-width: 900px) {
      .page {
        padding: 14px;
      }

      .chat-shell {
        border: 1px solid var(--line);
        border-radius: 24px;
        box-shadow: var(--shadow);
      }
    }

    /* HEADER */

    .chat-header {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 13px;
      border-bottom: 1px solid var(--line);
      background: rgba(255, 255, 255, .97);
      z-index: 20;
    }

    .icon-btn {
      width: 43px;
      height: 43px;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: var(--text);
      display: grid;
      place-items: center;
      cursor: pointer;
    }

    .icon-btn:hover {
      background: var(--surface-soft);
    }

    .back-btn {
      font-size: 1.1rem;
    }

    .chat-user {
      flex: 1;
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 11px;
      cursor: pointer;
    }

    .header-avatar {
      width: 45px;
      height: 45px;
      border-radius: 50%;
      object-fit: cover;
      background: #ddd;
      border: 1px solid var(--line);
      flex: none;
    }

    .header-user-info {
      min-width: 0;
    }

    .header-name {
      font-size: .96rem;
      font-weight: 800;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .header-status {
      margin-top: 2px;
      font-size: .69rem;
      color: var(--muted);
    }

    .header-status.online {
      color: var(--green);
    }

    .header-actions {
      display: flex;
      gap: 2px;
      position: relative;
    }

    .header-menu {
      display: none;
      position: absolute;
      top: 51px;
      right: 0;
      width: 225px;
      padding: 6px;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 15px;
      box-shadow: 0 20px 55px rgba(0, 0, 0, .17);
      z-index: 80;
    }

    .header-menu.open {
      display: block;
    }

    .header-menu button {
      width: 100%;
      border: 0;
      background: transparent;
      border-radius: 10px;
      padding: 11px 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      text-align: left;
      cursor: pointer;
      color: var(--text);
      font-weight: 700;
    }

    .header-menu button:hover {
      background: var(--surface-soft);
    }

    .header-menu .danger {
      color: var(--danger);
    }

    /* MESSAGE AREA */

    .messages {
      min-height: 0;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 20px 14px 28px;
      background: #fafbfc;
      display: flex;
      flex-direction: column;
      gap: 4px;
      scroll-behavior: smooth;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }

    .messages::-webkit-scrollbar {
      width: 7px;
    }

    .messages::-webkit-scrollbar-thumb {
      background: #d1d4dc;
      border-radius: 20px;
    }

    @media (min-width: 900px) {
      .messages {
        padding-left: clamp(35px, 7vw, 90px);
        padding-right: clamp(35px, 7vw, 90px);
      }
    }

    /* DATE */

    .date-divider {
      align-self: center;
      margin: 14px 0 8px;
      padding: 5px 12px;
      background: #e9eaf0;
      border-radius: 999px;
      color: #737783;
      font-size: .63rem;
      font-weight: 750;
    }

    /* MESSAGE GROUP */

    .message-group {
      width: 100%;
      display: flex;
      align-items: flex-end;
      gap: 8px;
      margin-top: 2px;
    }

    .message-group.received {
      justify-content: flex-start;
    }

    .message-group.sent {
      justify-content: flex-end;
    }

    .sender-avatar-wrap {
      width: 34px;
      height: 34px;
      flex: none;
      display: flex;
      align-items: flex-end;
    }

    .sender-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: cover;
      background: #ddd;
    }

    .sender-avatar.hidden {
      visibility: hidden;
    }

    .message-content {
      min-width: 0;
      max-width: min(76%, 640px);
      display: flex;
      flex-direction: column;
    }

    .message-group.sent .message-content {
      align-items: flex-end;
    }

    @media (max-width: 600px) {
      .message-content {
        max-width: 83%;
      }
    }

    .sender-name {
      margin: 0 0 4px 3px;
      color: #666b79;
      font-size: .66rem;
      font-weight: 800;
    }

    .message-bubble {
      position: relative;
      width: fit-content;
      max-width: 100%;
      min-width: 45px;
      padding: 9px 12px 7px;
      border: 1px solid var(--line);
      border-radius: 17px 17px 17px 5px;
      background: var(--received);
      color: var(--text);
      box-shadow: 0 1px 3px rgba(0, 0, 0, .035);
      word-break: break-word;
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
    }

    .message-group.sent .message-bubble {
      background: var(--sent);
      color: #fff;
      border-color: transparent;
      border-radius: 17px 17px 5px 17px;
    }

    .message-bubble.first.received {
      border-top-left-radius: 5px;
    }

    .message-bubble.last.received {
      border-bottom-left-radius: 5px;
    }

    .message-bubble.first.sent {
      border-top-right-radius: 5px;
    }

    .message-bubble.last.sent {
      border-bottom-right-radius: 5px;
    }

    .message-bubble.deleted {
      background: #eeeeF1 !important;
      border-color: #dedee4 !important;
      color: #858995 !important;
      font-style: italic;
    }

    .message-text {
      white-space: pre-wrap;
      line-height: 1.45;
      font-size: .91rem;
    }

    .message-footer {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 4px;
      margin-top: 4px;
      min-height: 12px;
    }

    .message-time {
      font-size: .56rem;
      opacity: .58;
      white-space: nowrap;
    }

    .message-status {
      font-size: .62rem;
      opacity: .65;
    }

    .message-status.read {
      color: #bdf5ff;
      opacity: 1;
    }

    .edited-label {
      font-size: .55rem;
      opacity: .6;
      margin-left: 3px;
    }

    /* MEDIA */

    .message-media {
      display: block;
      width: min(340px, 70vw);
      max-height: 410px;
      object-fit: cover;
      border-radius: 13px;
      background: #111;
      margin-bottom: 5px;
    }

    .message-video {
      background: #000;
    }

    /* SHARED PROFILE */

    .shared-profile {
      min-width: 230px;
      max-width: 300px;
      padding: 11px;
      border-radius: 14px;
      background: rgba(0, 0, 0, .05);
    }

    .message-group.sent .shared-profile {
      background: rgba(255, 255, 255, .13);
    }

    .shared-profile-link {
      display: flex;
      align-items: center;
      gap: 10px;
      color: inherit;
      text-decoration: none;
    }

    .shared-profile-avatar {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      object-fit: cover;
      flex: none;
    }

    .shared-profile-name {
      font-weight: 800;
      font-size: .85rem;
    }

    .shared-profile-label {
      margin-top: 2px;
      font-size: .62rem;
      opacity: .65;
    }

    /* REACTIONS */

    .reaction-row {
      display: flex;
      gap: 3px;
      position: absolute;
      bottom: -10px;
      left: 7px;
      z-index: 4;
    }

    .message-group.sent .reaction-row {
      left: auto;
      right: 7px;
    }

    .reaction {
      min-width: 26px;
      height: 23px;
      padding: 2px 6px;
      border: 1px solid #dddfe5;
      border-radius: 999px;
      background: #fff;
      color: #222;
      box-shadow: 0 3px 11px rgba(0, 0, 0, .12);
      display: grid;
      place-items: center;
      font-size: .72rem;
    }

    /* WELCOME */

    .welcome {
      margin: auto;
      text-align: center;
      max-width: 330px;
      color: var(--muted);
      padding: 35px 12px;
    }

    .welcome-avatar {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      object-fit: cover;
      margin-bottom: 12px;
    }

    .welcome strong {
      display: block;
      color: var(--text);
      font-size: 1.05rem;
    }

    .welcome p {
      font-size: .8rem;
      line-height: 1.5;
    }

    /* TYPING */

    .typing {
      min-height: 20px;
      padding: 1px 17px;
      background: #fff;
      color: var(--muted);
      font-size: .67rem;
    }

    .typing:empty {
      visibility: hidden;
    }

    /* PREVIEW / EDIT */

    .preview,
    .edit-bar {
      display: none;
      align-items: center;
      gap: 9px;
      padding: 7px 11px;
      border-top: 1px solid var(--line);
      background: #f8f8fa;
    }

    .preview.show,
    .edit-bar.show {
      display: flex;
    }

    .preview-thumb {
      width: 50px;
      height: 50px;
      overflow: hidden;
      border-radius: 9px;
      background: #111;
      flex: none;
    }

    .preview-thumb img,
    .preview-thumb video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .preview-name,
    .edit-copy {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: .72rem;
    }

    .edit-bar {
      background: #f1efff;
      color: #554ad8;
    }

    .edit-copy small {
      display: block;
      margin-top: 1px;
      font-size: .59rem;
      opacity: .7;
    }

    .remove,
    .cancel {
      border: 0;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-weight: 700;
    }

    /* COMPOSER */

    .composer {
      display: flex;
      align-items: flex-end;
      gap: 7px;
      padding: 8px 9px max(9px, env(safe-area-inset-bottom));
      background: #fff;
      border-top: 1px solid var(--line);
      z-index: 20;
    }

    .attach-btn {
      width: 43px;
      height: 43px;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: var(--primary);
      cursor: pointer;
      display: grid;
      place-items: center;
      font-size: 1.05rem;
    }

    .attach-btn:hover {
      background: var(--surface-soft);
    }

    .input-wrap {
      flex: 1;
      min-width: 0;
      display: flex;
      align-items: flex-end;
      border: 1px solid #dedfe5;
      border-radius: 22px;
      padding: 0 11px;
      background: #f5f5f7;
    }

    .input-wrap:focus-within {
      border-color: #b7b1ff;
      box-shadow: 0 0 0 3px rgba(99, 91, 255, .08);
    }

    .message-input {
      width: 100%;
      min-height: 41px;
      max-height: 120px;
      resize: none;
      outline: 0;
      border: 0;
      background: transparent;
      color: var(--text);
      padding: 10px 2px;
      line-height: 1.4;
    }

    .send-btn {
      width: 43px;
      height: 43px;
      border: 0;
      border-radius: 50%;
      background: var(--primary);
      color: #fff;
      display: grid;
      place-items: center;
      cursor: pointer;
    }

    .send-btn:hover {
      background: var(--primary-dark);
    }

    .send-btn:disabled {
      opacity: .45;
      cursor: not-allowed;
    }

    #mediaInput {
      display: none;
    }

    /* ACTION SHEET */

    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .4);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: .2s;
      z-index: 90;
    }

    .overlay.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .message-sheet {
      position: fixed;
      left: 50%;
      bottom: 0;
      transform: translate(-50%, 110%);
      width: min(520px, 100vw);
      background: #fff;
      border-radius: 22px 22px 0 0;
      padding: 10px;
      box-shadow: 0 -15px 55px rgba(0, 0, 0, .2);
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transition: .22s;
      z-index: 91;
    }

    .message-sheet.open {
      transform: translate(-50%, 0);
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
    }

    .sheet-handle {
      width: 40px;
      height: 4px;
      background: #d8d9df;
      border-radius: 999px;
      margin: 2px auto 10px;
    }

    .reaction-picker {
      display: flex;
      gap: 4px;
      padding-bottom: 9px;
      border-bottom: 1px solid var(--line);
    }

    .reaction-picker button {
      flex: 1;
      height: 45px;
      border: 0;
      border-radius: 13px;
      background: #f2f3f6;
      cursor: pointer;
      font-size: 1.2rem;
    }

    .emoji-more {
      display: none;
      flex-wrap: wrap;
      gap: 5px;
      padding: 9px 0;
    }

    .emoji-more.open {
      display: flex;
    }

    .emoji-more button {
      width: 42px;
      height: 38px;
      border: 0;
      border-radius: 10px;
      background: #f1f2f5;
      cursor: pointer;
      font-size: 1.1rem;
    }

    .sheet-action {
      width: 100%;
      height: 45px;
      border: 0;
      background: transparent;
      border-radius: 11px;
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 0 12px;
      text-align: left;
      cursor: pointer;
      font-weight: 700;
    }

    .sheet-action:hover {
      background: #f2f3f6;
    }

    .sheet-action.danger {
      color: var(--danger);
    }

    .sheet-action.disabled {
      opacity: .4;
      pointer-events: none;
    }

    .sheet-action .remaining {
      margin-left: auto;
      color: var(--muted);
      font-size: .59rem;
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: 78px;
      transform: translateX(-50%);
      background: #191919;
      color: #fff;
      padding: 9px 14px;
      border-radius: 999px;
      font-size: .72rem;
      opacity: 0;
      pointer-events: none;
      transition: .2s;
      z-index: 120;
    }

    .toast.show {
      opacity: 1;
    }

    @media (max-width: 600px) {
      .page {
        height: calc(100dvh - 56px);
        min-height: 0;
      }

      .chat-shell {
        border-radius: 0;
      }

      .chat-header {
        height: 59px;
      }

      .header-avatar {
        width: 40px;
        height: 40px;
      }

      .icon-btn {
        width: 39px;
        height: 39px;
      }

      .messages {
        padding: 14px 8px 22px;
      }

      .sender-avatar-wrap {
        width: 31px;
      }

      .sender-avatar {
        width: 29px;
        height: 29px;
      }

      .message-content {
        max-width: 83%;
      }

      .message-text {
        font-size: .88rem;
      }

      .message-sheet {
        padding-bottom: max(10px, env(safe-area-inset-bottom));
      }
    }
  </style>
</head>

<body>

  <%- include('./partials/nave') %>

  <main class="page">
    <section class="chat-shell" aria-label="Conversation">

      <!-- HEADER -->
      <header class="chat-header">

        <button
          class="icon-btn back-btn"
          id="backBtn"
          aria-label="Back">
          <i class="fas fa-arrow-left"></i>
        </button>

        <div
          class="chat-user"
          id="profileBtn"
          role="button"
          tabindex="0">

          <img
            class="header-avatar"
            id="headerAvatar"
            src="/imgs/default.png"
            alt="">

          <div class="header-user-info">
            <div
              class="header-name"
              id="headerName">
              Loading…
            </div>

            <div
              class="header-status"
              id="headerStatus">
              Message
            </div>
          </div>

        </div>

        <div class="header-actions">

          <button
            class="icon-btn"
            id="menuBtn"
            aria-label="More options">
            <i class="fas fa-ellipsis-v"></i>
          </button>

          <div
            class="header-menu"
            id="headerMenu">

            <button id="profileAction">
              <i class="fas fa-user"></i>
              View profile
            </button>

            <button
              id="blockAction"
              class="danger">
              <i class="fas fa-ban"></i>
              Block user
            </button>

          </div>

        </div>

      </header>


      <!-- MESSAGES -->
      <div
        class="messages"
        id="messages"
        aria-live="polite">

        <div
          class="welcome"
          id="welcome">

          <img
            class="welcome-avatar"
            id="welcomeAvatar"
            src="/imgs/default.png"
            alt="">

          <strong id="welcomeName">
            Starting chat…
          </strong>

          <p>
            Send a message to start your conversation.
          </p>

        </div>

      </div>


      <!-- TYPING -->
      <div
        class="typing"
        id="typing">
      </div>


      <!-- MEDIA PREVIEW -->
      <div
        class="preview"
        id="preview">

        <div
          class="preview-thumb"
          id="previewThumb">
        </div>

        <div
          class="preview-name"
          id="previewName">
        </div>

        <button
          class="remove"
          id="removeMedia">
          ×
        </button>

      </div>


      <!-- EDIT BAR -->
      <div
        class="edit-bar"
        id="editBar">

        <i class="fas fa-pen"></i>

        <div class="edit-copy">
          <strong>Editing message</strong>
          <small id="editText"></small>
        </div>

        <span
          class="remaining"
          id="editTime">
        </span>

        <button
          class="cancel"
          id="cancelEdit">
          Cancel
        </button>

      </div>


      <!-- COMPOSER -->
      <form
        class="composer"
        id="composer">

        <button
          type="button"
          class="attach-btn"
          id="mediaBtn"
          aria-label="Photo or video">
          <i class="fas fa-plus"></i>
        </button>

        <input
          id="mediaInput"
          type="file"
          accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime">

        <div class="input-wrap">

          <textarea
            id="input"
            class="message-input"
            rows="1"
            maxlength="5000"
            placeholder="Message…"
            autocomplete="off"></textarea>

        </div>

        <button
          class="send-btn"
          id="sendBtn"
          type="submit"
          aria-label="Send">
          <i class="fas fa-paper-plane"></i>
        </button>

      </form>

    </section>
  </main>


  <!-- OVERLAY -->
  <div
    class="overlay"
    id="overlay">
  </div>


  <!-- MESSAGE ACTION SHEET -->
  <div
    class="message-sheet"
    id="messageSheet">

    <div class="sheet-handle"></div>

    <div class="reaction-picker">

      <button data-emoji="❤️">❤️</button>
      <button data-emoji="😂">😂</button>
      <button data-emoji="😮">😮</button>
      <button data-emoji="😢">😢</button>

      <button id="moreEmoji">
        ＋
      </button>

    </div>

    <div
      class="emoji-more"
      id="emojiMore">

      <button data-emoji="👍">👍</button>
      <button data-emoji="😍">😍</button>
      <button data-emoji="🔥">🔥</button>
      <button data-emoji="👏">👏</button>
      <button data-emoji="😡">😡</button>
      <button data-emoji="🙏">🙏</button>
      <button data-emoji="🎉">🎉</button>
      <button data-emoji="💯">💯</button>

    </div>

    <button
      class="sheet-action"
      id="replyAction">
      <i class="fas fa-reply"></i>
      Reply
    </button>

    <button
      class="sheet-action"
      id="forwardAction">
      <i class="fas fa-share"></i>
      Forward
    </button>

    <button
      class="sheet-action"
      id="editAction">
      <i class="fas fa-pen"></i>
      Edit

      <span
        class="remaining"
        id="sheetEditTime">
      </span>
    </button>

    <button
      class="sheet-action"
      id="copyAction">
      <i class="far fa-copy"></i>
      Copy
    </button>

    <button
      class="sheet-action danger"
      id="unsendAction">
      <i class="fas fa-trash-alt"></i>
      Unsend
    </button>

    <button
      class="sheet-action"
      id="closeSheet">
      <i class="fas fa-times"></i>
      Cancel
    </button>

  </div>


  <div
    class="toast"
    id="toast">
  </div>


  <%- include('./partials/scripts') %>

  <script src="/socket.io/socket.io.js"></script>

  <script>
    const CURRENT = '<%= user._id %>';
    const TARGET = '<%= targetUserId %>';

    const EDIT_WINDOW_MS = 60 * 1000;

    let conversationId = null;
    let other = null;
    let socket = null;

    let selectedFile = null;
    let activeMessageId = null;
    let editingMessageId = null;
    let replyingMessageId = null;

    let typingTimer = null;
    let longPressTimer = null;

    const $ = id => document.getElementById(id);

    const escapeHtml = value =>
      String(value ?? '').replace(/[&<>"']/g, c => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      }[c]));

    function image(value) {
      return value && String(value).trim()
        ? String(value)
        : '/imgs/default.png';
    }

    function toast(message) {
      const el = $('toast');

      el.textContent = message;
      el.classList.add('show');

      clearTimeout(window.__toastTimer);

      window.__toastTimer = setTimeout(() => {
        el.classList.remove('show');
      }, 2400);
    }

    function api(url, options = {}) {
      return fetch(url, {
        credentials: 'same-origin',
        headers: {
          Accept: 'application/json',
          ...(options.body instanceof FormData
            ? {}
            : { 'Content-Type': 'application/json' }),
          ...(options.headers || {})
        },
        ...options
      });
    }

    function messageTime(value) {
      if (!value) return '';

      return new Date(value).toLocaleTimeString([], {
        hour: 'numeric',
        minute: '2-digit'
      });
    }

    function messageDay(value) {
      return new Date(value).toLocaleDateString([], {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      });
    }

    function senderId(message) {
      return String(
        message?.senderId?._id ||
        message?.senderId ||
        ''
      );
    }

    function isMine(message) {
      return senderId(message) === String(CURRENT);
    }

    function canEdit(message) {
      return (
        !message.deleted &&
        isMine(message) &&
        Date.now() -
          new Date(message.createdAt).getTime() <=
          EDIT_WINDOW_MS
      );
    }

    function editRemaining(message) {
      return Math.max(
        0,
        EDIT_WINDOW_MS -
        (Date.now() -
        new Date(message.createdAt).getTime())
      );
    }

    function scrollToBottom(smooth = true) {
      const box = $('messages');

      box.scrollTo({
        top: box.scrollHeight,
        behavior: smooth ? 'smooth' : 'auto'
      });
    }

    function renderWelcome() {
      if (!other) return;

      $('welcomeAvatar').src =
        image(other.profileImageURL);

      $('welcomeName').textContent =
        other.fullName || 'User';
    }


    /*
     * ---------------------------------------------------------
     * MESSAGE HTML
     * ---------------------------------------------------------
     */

    function buildReactionHtml(message) {
      const reactions =
        Array.isArray(message.reactions)
          ? message.reactions
          : [];

      if (!reactions.length) return '';

      const counts = {};

      reactions.forEach(reaction => {
        if (!reaction?.emoji) return;

        counts[reaction.emoji] =
          (counts[reaction.emoji] || 0) + 1;
      });

      return `
        <div class="reaction-row">
          ${Object.entries(counts)
            .map(([emoji, count]) => `
              <span class="reaction">
                ${escapeHtml(emoji)}
                ${count > 1
                  ? `<small>${count}</small>`
                  : ''}
              </span>
            `)
            .join('')}
        </div>
      `;
    }


    function buildSharedProfile(message) {
      if (
        message.mediaType !== 'profile' ||
        !message.profileShareId
      ) {
        return '';
      }

      const profile =
        message.profileShareId;

      return `
        <div class="shared-profile">

          <a
            class="shared-profile-link"
            href="/user/profile/${escapeHtml(profile._id)}">

            <img
              class="shared-profile-avatar"
              src="${escapeHtml(
                image(profile.profileImageURL)
              )}"
              alt="">

            <div>
              <div class="shared-profile-name">
                ${escapeHtml(
                  profile.fullName || 'Profile'
                )}
              </div>

              <div class="shared-profile-label">
                Shared profile
              </div>
            </div>

          </a>

        </div>
      `;
    }


    function buildMessage(message, index, list) {

      const mine = isMine(message);
      const deleted = !!message.deleted;

      const previous =
        list[index - 1];

      const next =
        list[index + 1];

      const samePrevious =
        previous &&
        senderId(previous) === senderId(message) &&
        !previous.deleted &&
        !deleted;

      const sameNext =
        next &&
        senderId(next) === senderId(message) &&
        !next.deleted &&
        !deleted;

      const first = !samePrevious;
      const last = !sameNext;

      const row =
        document.createElement('div');

      row.className =
        `message-group ${
          mine ? 'sent' : 'received'
        }`;

      row.dataset.message =
        message._id;


      /*
       * Avatar is shown beside the final
       * received message in a group.
       */
      const showAvatar =
        !mine && last;

      const avatarHtml = !mine
        ? `
          <div class="sender-avatar-wrap">

            <img
              class="sender-avatar ${
                showAvatar ? '' : 'hidden'
              }"
              src="${escapeHtml(
                image(
                  message.senderId?.profileImageURL ||
                  other?.profileImageURL
                )
              )}"
              alt="">

          </div>
        `
        : `
          <div
            class="sender-avatar-wrap"
            style="width:0">
          </div>
        `;


      const senderName =
        !mine && first
          ? `
            <div class="sender-name">
              ${escapeHtml(
                message.senderId?.fullName ||
                other?.fullName ||
                'User'
              )}
            </div>
          `
          : '';


      let mediaHtml = '';

      if (
        !deleted &&
        message.mediaUrl &&
        message.mediaType === 'image'
      ) {
        mediaHtml = `
          <img
            class="message-media"
            src="${escapeHtml(message.mediaUrl)}"
            alt="Photo"
            loading="lazy">
        `;
      }

      if (
        !deleted &&
        message.mediaUrl &&
        message.mediaType === 'video'
      ) {
        mediaHtml = `
          <video
            class="message-media message-video"
            src="${escapeHtml(message.mediaUrl)}"
            controls
            playsinline
            preload="metadata">
          </video>
        `;
      }


      const profileHtml =
        buildSharedProfile(message);


      const text =
        deleted
          ? 'Message unsent'
          : (message.text || '');


      const edited =
        message.edited && !deleted
          ? `<span class="edited-label">edited</span>`
          : '';


      let statusHtml = '';

      if (mine && !deleted) {

        const status =
          message.status === 'read'
            ? '✓✓'
            : message.status === 'delivered'
              ? '✓✓'
              : '✓';

        statusHtml = `
          <span
            class="message-status ${
              message.status === 'read'
                ? 'read'
                : ''
            }">
            ${status}
          </span>
        `;
      }


      row.innerHTML = `

        ${avatarHtml}

        <div class="message-content">

          ${senderName}

          <div
            class="
              message-bubble
              ${deleted ? 'deleted' : ''}
              ${first ? 'first' : ''}
              ${last ? 'last' : ''}
              ${mine ? 'sent' : 'received'}
            "
            data-bubble="${escapeHtml(message._id)}">

            ${mediaHtml}

            ${profileHtml}

            ${
              text
                ? `
                  <div class="message-text">
                    ${escapeHtml(text)}
                    ${edited}
                  </div>
                `
                : ''
            }

            <div class="message-footer">

              <span class="message-time">
                ${messageTime(message.createdAt)}
              </span>

              ${statusHtml}

            </div>

            ${buildReactionHtml(message)}

          </div>

        </div>
      `;

      return row;
    }


    function appendDateDividerIfNeeded(
      message,
      index,
      list
    ) {
      if (index === 0) {
        const divider =
          document.createElement('div');

        divider.className =
          'date-divider';

        divider.dataset.day =
          messageDay(message.createdAt);

        divider.textContent =
          messageDay(message.createdAt);

        $('messages').appendChild(divider);

        return;
      }

      const previous =
        list[index - 1];

      if (
        messageDay(previous.createdAt) !==
        messageDay(message.createdAt)
      ) {
        const divider =
          document.createElement('div');

        divider.className =
          'date-divider';

        divider.dataset.day =
          messageDay(message.createdAt);

        divider.textContent =
          messageDay(message.createdAt);

        $('messages').appendChild(divider);
      }
    }


    function bindMessageGesture(row) {

      const bubble =
        row.querySelector('.message-bubble');

      if (!bubble) return;

      bubble.addEventListener(
        'dblclick',
        () => {
          react(
            row.dataset.message,
            '❤️'
          );
        }
      );


      const startLongPress = event => {

        if (
          event.target.closest('video')
        ) {
          return;
        }

        clearTimeout(longPressTimer);

        longPressTimer =
          setTimeout(() => {

            openMessageSheet(
              row.dataset.message
            );

          }, 520);
      };


      const cancelLongPress = () => {
        clearTimeout(longPressTimer);
      };


      bubble.addEventListener(
        'pointerdown',
        startLongPress
      );

      bubble.addEventListener(
        'pointerup',
        cancelLongPress
      );

      bubble.addEventListener(
        'pointercancel',
        cancelLongPress
      );

      bubble.addEventListener(
        'pointerleave',
        cancelLongPress
      );

      bubble.addEventListener(
        'contextmenu',
        event => {

          event.preventDefault();

          openMessageSheet(
            row.dataset.message
          );
        }
      );
    }


    function renderMessages(list) {

      const box =
        $('messages');

      box.innerHTML = '';

      if (!list || !list.length) {

        box.appendChild(
          $('welcome')
        );

        renderWelcome();

        return;
      }


      list.forEach(
        (message, index) => {

          appendDateDividerIfNeeded(
            message,
            index,
            list
          );

          const row =
            buildMessage(
              message,
              index,
              list
            );

          box.appendChild(row);

          bindMessageGesture(row);
        }
      );


      scrollToBottom(false);
    }


    function replaceMessage(message) {

      const old =
        document.querySelector(
          `[data-message="${CSS.escape(
            String(message._id)
          )}"]`
        );

      if (!old) {
        renderMessages(
          window.__messages || []
        );

        return;
      }

      renderMessages(
        window.__messages || []
      );
    }


    /*
     * ---------------------------------------------------------
     * MESSAGE ACTION SHEET
     * ---------------------------------------------------------
     */

    function closeMessageSheet() {

      activeMessageId = null;

      $('overlay')
        .classList
        .remove('open');

      $('messageSheet')
        .classList
        .remove('open');

      $('emojiMore')
        .classList
        .remove('open');

      document.body.style.overflow = '';
    }


    function openMessageSheet(id) {

      const message =
        window.__messages?.find(
          m => String(m._id) === String(id)
        );

      if (!message) return;

      activeMessageId = id;

      const editable =
        canEdit(message);


      $('editAction')
        .classList
        .toggle(
          'disabled',
          !editable
        );


      $('sheetEditTime')
        .textContent =
          editable
            ? `${Math.ceil(
                editRemaining(message) / 1000
              )}s`
            : '';


      $('overlay')
        .classList
        .add('open');

      $('messageSheet')
        .classList
        .add('open');

      document.body.style.overflow =
        'hidden';
    }


    async function react(
      messageId,
      emoji
    ) {

      if (
        !socket ||
        !conversationId
      ) {
        return;
      }

      socket.emit(
        'message:react',
        {
          conversationId,
          messageId,
          emoji
        }
      );

      closeMessageSheet();
    }


    function startEdit() {

      const message =
        window.__messages?.find(
          m =>
            String(m._id) ===
            String(activeMessageId)
        );

      if (
        !message ||
        !canEdit(message)
      ) {
        toast(
          'Edit is available for only 1 minute.'
        );

        closeMessageSheet();

        return;
      }


      editingMessageId =
        message._id;

      $('input').value =
        message.text || '';

      $('input')
        .dispatchEvent(
          new Event('input')
        );

      $('editText').textContent =
        message.text ||
        'Empty message';

      $('editBar')
        .classList
        .add('show');

      $('input').focus();

      closeMessageSheet();

      updateEditTimer();
    }


    function updateEditTimer() {

      if (!editingMessageId) {
        return;
      }

      const message =
        window.__messages?.find(
          m =>
            String(m._id) ===
            String(editingMessageId)
        );

      if (!message) {
        cancelEdit();
        return;
      }


      const remaining =
        editRemaining(message);


      if (remaining <= 0) {

        cancelEdit();

        toast(
          'Edit window expired'
        );

        return;
      }


      $('editTime').textContent =
        `${Math.ceil(
          remaining / 1000
        )}s`;


      setTimeout(
        updateEditTimer,
        1000
      );
    }


    function cancelEdit() {

      editingMessageId = null;

      $('editBar')
        .classList
        .remove('show');

      $('editText').textContent = '';

      $('editTime').textContent = '';
    }


    function submitEdit() {

      const text =
        $('input')
          .value
          .trim();

      if (
        !text ||
        !editingMessageId ||
        !socket
      ) {
        return;
      }


      socket.emit(
        'message:edit',
        {
          conversationId,
          messageId:
            editingMessageId,
          text
        }
      );


      cancelEdit();

      $('input').value = '';

      resizeInput();
    }


    async function copyActiveMessage() {

      const message =
        window.__messages?.find(
          m =>
            String(m._id) ===
            String(activeMessageId)
        );

      if (
        !message ||
        message.deleted
      ) {
        closeMessageSheet();
        return;
      }


      try {

        await navigator.clipboard.writeText(
          message.text || ''
        );

        toast(
          'Message copied'
        );

      } catch {

        toast(
          'Unable to copy message'
        );
      }


      closeMessageSheet();
    }


    function replyToMessage() {

      const message =
        window.__messages?.find(
          m =>
            String(m._id) ===
            String(activeMessageId)
        );

      if (!message) {
        closeMessageSheet();
        return;
      }


      replyingMessageId =
        message._id;


      $('input').placeholder =
        `Reply to ${
          message.senderId?.fullName ||
          other?.fullName ||
          'message'
        }`;


      $('input').focus();

      toast(
        'Reply mode enabled'
      );

      closeMessageSheet();
    }


    function forwardMessage() {

      const message =
        window.__messages?.find(
          m =>
            String(m._id) ===
            String(activeMessageId)
        );

      if (!message) {
        closeMessageSheet();
        return;
      }


      /*
       * This keeps the existing forward UI
       * compatible with projects that implement
       * a forward endpoint/page.
       */
      window.location.href =
        `/messages/chatlog?forward=${encodeURIComponent(
          message._id
        )}`;
    }


    function unsendMessage() {

      const message =
        window.__messages?.find(
          m =>
            String(m._id) ===
            String(activeMessageId)
        );

      if (!message) {
        closeMessageSheet();
        return;
      }


      if (!isMine(message)) {

        toast(
          'You can only unsend your own message.'
        );

        closeMessageSheet();

        return;
      }


      if (
        !confirm(
          'Unsend this message for everyone?'
        )
      ) {
        closeMessageSheet();
        return;
      }


      socket?.emit(
        'message:unsend',
        {
          conversationId,
          messageId: message._id
        }
      );


      closeMessageSheet();
    }


    /*
     * ---------------------------------------------------------
     * PROFILE
     * ---------------------------------------------------------
     */

    function setProfileHeader() {

      const name =
        other?.fullName ||
        'User';

      $('headerName').textContent =
        name;

      $('headerAvatar').src =
        image(
          other?.profileImageURL
        );

      $('welcomeName').textContent =
        name;

      $('welcomeAvatar').src =
        image(
          other?.profileImageURL
        );


      $('headerAvatar').onerror =
        () => {
          $('headerAvatar').src =
            '/imgs/default.png';
        };


      $('headerStatus').textContent =
        other?.isPrivate
          ? 'Private account'
          : 'Message';


      $('profileAction').onclick =
        viewProfile;

      $('profileBtn').onclick =
        viewProfile;


      $('profileBtn').onkeydown =
        event => {

          if (
            event.key === 'Enter' ||
            event.key === ' '
          ) {
            event.preventDefault();
            viewProfile();
          }
        };
    }


    function viewProfile() {

      location.href =
        '/user/profile/' +
        encodeURIComponent(TARGET);
    }


    /*
     * ---------------------------------------------------------
     * SOCKET
     * ---------------------------------------------------------
     */

    function bindSocket() {

      socket.on(
        'user:online',
        data => {

          if (
            String(data.userId) !==
            String(TARGET)
          ) {
            return;
          }

          $('headerStatus')
            .textContent =
            'Active now';

          $('headerStatus')
            .classList
            .add('online');
        }
      );


      socket.on(
        'user:offline',
        data => {

          if (
            String(data.userId) !==
            String(TARGET)
          ) {
            return;
          }

          $('headerStatus')
            .textContent =
            other?.isPrivate
              ? 'Private account'
              : 'Message';

          $('headerStatus')
            .classList
            .remove('online');
        }
      );


      socket.on(
        'typing:start',
        data => {

          if (
            String(data.userId) !==
            String(TARGET)
          ) {
            return;
          }

          $('typing').textContent =
            `${
              other?.fullName ||
              'User'
            } is typing…`;
        }
      );


      socket.on(
        'typing:stop',
        data => {

          if (
            String(data.userId) !==
            String(TARGET)
          ) {
            return;
          }

          $('typing').textContent =
            '';
        }
      );


      socket.on(
        'message:new',
        message => {

          if (
            String(
              message.conversationId
            ) !==
            String(conversationId)
          ) {
            return;
          }


          window.__messages =
            window.__messages || [];


          window.__messages.push(
            message
          );


          renderMessages(
            window.__messages
          );


          socket.emit(
            'message:read',
            {
              conversationId
            }
          );
        }
      );


      socket.on(
        'message:edited',
        message => {

          const index =
            window.__messages.findIndex(
              m =>
                String(m._id) ===
                String(message._id)
            );


          if (index >= 0) {

            window.__messages[index] =
              message;
          }


          renderMessages(
            window.__messages
          );
        }
      );


      socket.on(
        'message:unsent',
        data => {

          const index =
            window.__messages.findIndex(
              m =>
                String(m._id) ===
                String(data.messageId)
            );


          if (index >= 0) {

            window.__messages[index].deleted =
              true;

            window.__messages[index].text =
              '';

            window.__messages[index].mediaUrl =
              '';
          }


          renderMessages(
            window.__messages
          );
        }
      );


      socket.on(
        'message:reactions',
        data => {

          const message =
            window.__messages.find(
              m =>
                String(m._id) ===
                String(data.messageId)
            );


          if (message) {
            message.reactions =
              data.reactions;
          }


          renderMessages(
            window.__messages
          );
        }
      );


      socket.on(
        'message:read',
        data => {

          if (
            String(data.conversationId) !==
            String(conversationId)
          ) {
            return;
          }


          window.__messages
            .filter(
              message =>
                isMine(message)
            )
            .forEach(
              message =>
                message.status = 'read'
            );


          renderMessages(
            window.__messages
          );
        }
      );


      socket.on(
        'message:error',
        data => {

          toast(
            data.message ||
            'Unable to send message'
          );
        }
      );


      socket.on(
        'message:action:error',
        data => {

          toast(
            data.message ||
            'Unable to update message'
          );
        }
      );
    }


    /*
     * ---------------------------------------------------------
     * INIT
     * ---------------------------------------------------------
     */

    async function init() {

      try {

        const response =
          await api(
            '/messages/conversation',
            {
              method: 'POST',
              body: JSON.stringify({
                userId: TARGET
              })
            }
          );


        const data =
          await response.json();


        if (
          !response.ok ||
          !data.success
        ) {
          throw new Error(
            data.message ||
            'Unable to open conversation'
          );
        }


        conversationId =
          data.conversationId;

        other =
          data.target;


        setProfileHeader();


        const historyResponse =
          await api(
            '/messages/' +
            encodeURIComponent(
              conversationId
            )
          );


        const history =
          await historyResponse.json();


        if (
          !historyResponse.ok ||
          !history.success
        ) {
          throw new Error(
            history.message ||
            'Unable to load messages'
          );
        }


        window.__messages =
          history.messages || [];


        renderMessages(
          window.__messages
        );


        socket =
          io();


        bindSocket();


        socket.emit(
          'conversation:join',
          conversationId
        );


        socket.emit(
          'message:read',
          {
            conversationId
          }
        );


      } catch (error) {

        $('messages').innerHTML = `

          <div class="welcome">

            <i
              class="fas fa-exclamation-circle"
              style="font-size:2rem">
            </i>

            <strong>
              Unable to load chat
            </strong>

            <p>
              ${escapeHtml(
                error.message
              )}
            </p>

            <button
              class="sheet-action"
              style="
                background:#f0f1f4;
                justify-content:center;
                margin-top:10px;
              "
              onclick="location.reload()">

              Try again

            </button>

          </div>
        `;
      }
    }


    /*
     * ---------------------------------------------------------
     * SEND
     * ---------------------------------------------------------
     */

    async function sendMessage() {

      if (editingMessageId) {

        submitEdit();

        return;
      }


      const text =
        $('input')
          .value
          .trim();


      if (
        !text &&
        !selectedFile
      ) {
        return;
      }


      if (
        !socket ||
        !conversationId
      ) {

        toast(
          'Chat is still loading'
        );

        return;
      }


      $('sendBtn').disabled =
        true;


      try {

        let mediaUrl = '';
        let mediaType = '';


        if (selectedFile) {

          const formData =
            new FormData();

          formData.append(
            'media',
            selectedFile
          );


          const response =
            await api(
              '/messages/upload',
              {
                method: 'POST',
                body: formData
              }
            );


          const data =
            await response.json();


          if (
            !response.ok ||
            !data.success
          ) {
            throw new Error(
              data.message ||
              'Unable to upload media'
            );
          }


          mediaUrl =
            data.mediaUrl;

          mediaType =
            data.mediaType;
        }


        socket.emit(
          'message:send',
          {
            conversationId,
            text,
            mediaUrl,
            mediaType,
            replyTo:
              replyingMessageId ||
              null
          }
        );


        $('input').value =
          '';

        replyingMessageId =
          null;

        $('input').placeholder =
          'Message…';

        clearMedia();

        resizeInput();


      } catch (error) {

        toast(
          error.message
        );

      } finally {

        $('sendBtn').disabled =
          false;
      }
    }


    function resizeInput() {

      const input =
        $('input');

      input.style.height =
        'auto';

      input.style.height =
        Math.min(
          input.scrollHeight,
          120
        ) + 'px';
    }


    function clearMedia() {

      $('mediaInput').value =
        '';

      selectedFile =
        null;

      $('preview')
        .classList
        .remove('show');

      $('previewThumb')
        .innerHTML =
        '';

      $('previewName')
        .textContent =
        '';
    }


    function previewFile(file) {

      selectedFile =
        file;

      if (!file) {
        return;
      }


      const url =
        URL.createObjectURL(file);


      $('previewName')
        .textContent =
        file.name;


      $('previewThumb')
        .innerHTML =
        file.type.startsWith(
          'video/'
        )
          ? `
            <video
              src="${url}"
              muted>
            </video>
          `
          : `
            <img
              src="${url}"
              alt="">
          `;


      $('preview')
        .classList
        .add('show');
    }


    /*
     * ---------------------------------------------------------
     * UI EVENTS
     * ---------------------------------------------------------
     */

    $('composer')
      .addEventListener(
        'submit',
        event => {

          event.preventDefault();

          sendMessage();
        }
      );


    $('input')
      .addEventListener(
        'input',
        () => {

          resizeInput();


          if (
            socket &&
            conversationId
          ) {

            socket.emit(
              'typing:start',
              {
                conversationId
              }
            );


            clearTimeout(
              typingTimer
            );


            typingTimer =
              setTimeout(
                () => {

                  socket.emit(
                    'typing:stop',
                    {
                      conversationId
                    }
                  );

                },
                900
              );
          }
        }
      );


    $('input')
      .addEventListener(
        'keydown',
        event => {

          if (
            event.key === 'Enter' &&
            !event.shiftKey &&
            window.innerWidth > 650
          ) {

            event.preventDefault();

            sendMessage();
          }
        }
      );


    $('mediaBtn').onclick =
      () => {
        $('mediaInput').click();
      };


    $('mediaInput').onchange =
      event => {

        previewFile(
          event.target.files?.[0]
        );
      };


    $('removeMedia').onclick =
      clearMedia;


    $('cancelEdit').onclick =
      cancelEdit;


    $('backBtn').onclick =
      () => {

        if (history.length > 1) {
          history.back();
        } else {
          location.href =
            '/messages/chatlog';
        }
      };


    $('menuBtn').onclick =
      event => {

        event.stopPropagation();

        $('headerMenu')
          .classList
          .toggle('open');
      };


    $('blockAction').onclick =
      async () => {

        if (
          !confirm(
            'Block this user?'
          )
        ) {
          return;
        }


        try {

          const response =
            await api(
              '/messages/block/' +
              TARGET,
              {
                method: 'POST'
              }
            );


          const data =
            await response.json();


          if (
            !response.ok ||
            !data.success
          ) {
            throw new Error(
              data.message ||
              'Unable to block'
            );
          }


          toast(
            data.message ||
            'User blocked'
          );


          setTimeout(
            () => {
              location.href =
                '/messages/chatlog';
            },
            700
          );


        } catch (error) {

          toast(
            error.message
          );
        }
      };


    document.addEventListener(
      'click',
      event => {

        if (
          !event.target.closest(
            '.header-actions'
          )
        ) {
          $('headerMenu')
            .classList
            .remove('open');
        }


        if (
          !event.target.closest(
            '.message-sheet'
          ) &&
          !event.target.closest(
            '.message-bubble'
          )
        ) {
          closeMessageSheet();
        }
      }
    );


    $('overlay').onclick =
      closeMessageSheet;


    $('closeSheet').onclick =
      closeMessageSheet;


    $('editAction').onclick =
      startEdit;


    $('copyAction').onclick =
      copyActiveMessage;


    $('replyAction').onclick =
      replyToMessage;


    $('forwardAction').onclick =
      forwardMessage;


    $('unsendAction').onclick =
      unsendMessage;


    $('moreEmoji').onclick =
      () => {

        $('emojiMore')
          .classList
          .toggle('open');
      };


    document
      .querySelectorAll(
        '[data-emoji]'
      )
      .forEach(
        button => {

          button.addEventListener(
            'click',
            () => {

              if (
                activeMessageId
              ) {

                react(
                  activeMessageId,
                  button.dataset.emoji
                );
              }
            }
          );
        }
      );


    /*
     * Keep conversation anchored
     * at the bottom when keyboard opens
     * or viewport changes on Android.
     */
    if (window.visualViewport) {

      window.visualViewport.addEventListener(
        'resize',
        () => {

          setTimeout(
            () => scrollToBottom(false),
            80
          );
        }
      );
    }


    init();
  </script>

</body>
</html>
