<!doctype html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Messages | Blogify</title>

  <style>
    :root{
      --bg:#f7f7f8;
      --surface:#fff;
      --surface2:#f2f2f4;
      --text:#171717;
      --muted:#737373;
      --line:#e8e8eb;
      --accent:#635bff;
      --accent2:#7c3aed;
      --danger:#ef4444;
      --green:#22a06b;
      --shadow:0 12px 45px rgba(0,0,0,.10);
    }

    *{box-sizing:border-box}

    html,body{
      margin:0;
      width:100%;
      height:100%;
      background:var(--bg);
      color:var(--text);
    }

    body{
      font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    }

    button,input,textarea{font:inherit}
    button{-webkit-tap-highlight-color:transparent}

    .page{
      height:calc(100dvh - 70px);
      min-height:520px;
      padding:0;
      display:flex;
      justify-content:center;
    }

    .chat{
      width:min(1080px,100%);
      height:100%;
      background:var(--surface);
      display:grid;
      grid-template-rows:64px minmax(0,1fr) auto;
      overflow:hidden;
      position:relative;
    }

    @media(min-width:900px){
      .page{padding:14px}
      .chat{
        border:1px solid var(--line);
        border-radius:22px;
        box-shadow:var(--shadow);
      }
    }

    /* ================= HEADER ================= */

    .topbar{
      height:64px;
      display:flex;
      align-items:center;
      gap:10px;
      padding:8px 12px;
      border-bottom:1px solid var(--line);
      background:rgba(255,255,255,.96);
      z-index:20;
    }

    .icon-btn{
      width:42px;
      height:42px;
      border:0;
      border-radius:50%;
      background:transparent;
      color:var(--text);
      display:grid;
      place-items:center;
      cursor:pointer;
    }

    .icon-btn:hover{background:var(--surface2)}

    .back{font-size:1.2rem}

    .person{
      display:flex;
      align-items:center;
      gap:10px;
      min-width:0;
      flex:1;
      cursor:pointer;
    }

    .avatar{
      width:42px;
      height:42px;
      border-radius:50%;
      object-fit:cover;
      background:#ddd;
      border:1px solid var(--line);
      flex:none;
    }

    .person-copy{min-width:0}

    .person-name{
      font-size:.96rem;
      font-weight:800;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    .person-status{
      font-size:.7rem;
      color:var(--muted);
      margin-top:2px;
    }

    .person-status.online{color:var(--green)}

    .top-actions{
      display:flex;
      align-items:center;
      gap:2px;
      position:relative;
    }

    .top-menu{
      display:none;
      position:absolute;
      right:0;
      top:50px;
      width:220px;
      padding:6px;
      background:#fff;
      border:1px solid var(--line);
      border-radius:14px;
      box-shadow:0 18px 50px rgba(0,0,0,.16);
      z-index:80;
    }

    .top-menu.open{display:block}

    .top-menu button{
      width:100%;
      border:0;
      background:transparent;
      padding:11px 12px;
      border-radius:9px;
      text-align:left;
      display:flex;
      gap:10px;
      align-items:center;
      cursor:pointer;
    }

    .top-menu button:hover{background:var(--surface2)}
    .top-menu .danger{color:var(--danger)}

    /* ================= MESSAGE SCROLL ================= */

    .messages{
      min-height:0;
      overflow-y:auto;
      overflow-x:hidden;
      padding:18px 12px 24px;
      display:flex;
      flex-direction:column;
      gap:10px;
      background:#fafafa;
      scroll-behavior:smooth;
      overscroll-behavior:contain;
      -webkit-overflow-scrolling:touch;
      scrollbar-width:thin;
    }

    .messages::-webkit-scrollbar{width:6px}

    .messages::-webkit-scrollbar-thumb{
      background:#d2d2d6;
      border-radius:20px;
    }

    /* ================= WELCOME ================= */

    .welcome{
      margin:auto;
      text-align:center;
      max-width:320px;
      color:var(--muted);
      padding:30px 10px;
    }

    .welcome img{
      width:74px;
      height:74px;
      border-radius:50%;
      object-fit:cover;
      margin-bottom:10px;
    }

    .welcome strong{
      display:block;
      color:var(--text);
      font-size:1.05rem;
    }

    .welcome p{
      font-size:.82rem;
      line-height:1.5;
    }

    .date-divider{
      align-self:center;
      margin:12px 0 4px;
      padding:5px 10px;
      border-radius:999px;
      background:#ededf0;
      color:#777;
      font-size:.64rem;
      font-weight:700;
    }

    /* ================= MESSAGE ROW ================= */

    .row{
      display:flex;
      align-items:flex-end;
      gap:7px;
      width:100%;
      position:relative;
    }

    .row.mine{
      justify-content:flex-end;
    }

    .row.theirs{
      justify-content:flex-start;
    }

    /*
      Sender identity shown beside every incoming message.
    */

    .sender-avatar-wrap{
      width:34px;
      flex:0 0 34px;
      display:flex;
      align-items:flex-end;
      justify-content:center;
    }

    .sender-avatar{
      width:32px;
      height:32px;
      border-radius:50%;
      object-fit:cover;
      border:1px solid var(--line);
      background:#ddd;
      box-shadow:0 2px 7px rgba(0,0,0,.08);
    }

    .sender-message{
      min-width:0;
      max-width:min(76%,620px);
    }

    .sender-name{
      display:flex;
      align-items:center;
      gap:5px;
      margin:0 0 4px 5px;
      font-size:.72rem;
      font-weight:800;
      color:#4f46a5;
      max-width:100%;
      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
    }

    .sender-name i{
      font-size:.6rem;
      opacity:.75;
    }

    .bubble-wrap{
      max-width:min(76%,620px);
      min-width:0;
      position:relative;
    }

    .row.mine .bubble-wrap{
      display:flex;
      justify-content:flex-end;
    }

    .bubble{
      position:relative;
      max-width:100%;
      padding:9px 11px;
      border:1px solid var(--line);
      background:#fff;
      border-radius:18px 18px 18px 5px;
      box-shadow:0 1px 4px rgba(0,0,0,.035);
      word-break:break-word;
      line-height:1.43;
      user-select:none;
      -webkit-user-select:none;
      touch-action:manipulation;
    }

    .row.mine .bubble{
      background:linear-gradient(135deg,var(--accent),var(--accent2));
      border-color:transparent;
      color:#fff;
      border-radius:18px 18px 5px 18px;
    }

    .bubble.deleted{
      background:#f0f0f2!important;
      color:#888!important;
      border-color:#e1e1e4!important;
      font-style:italic;
    }

    .text{
      white-space:pre-wrap;
    }

    .edited{
      font-size:.58rem;
      opacity:.62;
      margin-left:4px;
    }

    .meta{
      font-size:.58rem;
      opacity:.62;
      text-align:right;
      margin-top:4px;
      white-space:nowrap;
    }

    .status{margin-left:3px}
    .status.read{color:#c7f7ff}

    /* ================= MEDIA ================= */

    .media{
      display:block;
      width:min(330px,68vw);
      max-height:390px;
      object-fit:cover;
      border-radius:13px;
      background:#111;
      margin-bottom:5px;
    }

    .media.video{background:#000}

    /* ================= REACTIONS ================= */

    .reaction-badges{
      display:flex;
      gap:3px;
      position:absolute;
      bottom:-10px;
      left:7px;
      z-index:3;
    }

    .row.mine .reaction-badges{
      left:auto;
      right:7px;
    }

    .reaction-badge{
      height:23px;
      min-width:27px;
      padding:2px 6px;
      border:1px solid #ddd;
      border-radius:999px;
      background:#fff;
      box-shadow:0 3px 10px rgba(0,0,0,.12);
      font-size:.75rem;
      display:grid;
      place-items:center;
      color:#222;
    }

    .reaction-badge small{
      margin-left:2px;
      font-size:.6rem;
      color:#666;
    }

    .like-pill{
      font-size:.62rem;
      margin-left:4px;
      color:#ff3b67;
    }

    /* ================= TYPING ================= */

    .typing{
      height:20px;
      padding:1px 15px;
      color:var(--muted);
      font-size:.67rem;
      background:#fff;
    }

    .typing:empty{visibility:hidden}

    /* ================= PREVIEW / EDIT ================= */

    .preview,
    .edit-bar{
      display:none;
      border-top:1px solid var(--line);
      padding:7px 11px;
      background:#f8f8fa;
      align-items:center;
      gap:9px;
    }

    .preview.show,
    .edit-bar.show{
      display:flex;
    }

    .preview-thumb{
      width:50px;
      height:50px;
      border-radius:9px;
      overflow:hidden;
      background:#111;
      flex:none;
    }

    .preview-thumb img,
    .preview-thumb video{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .preview-name,
    .edit-copy{
      flex:1;
      min-width:0;
      font-size:.72rem;
      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
    }

    .remove,
    .cancel{
      border:0;
      background:transparent;
      color:var(--muted);
      cursor:pointer;
      font-weight:700;
    }

    .edit-bar{
      background:#f1efff;
      color:#554ad8;
    }

    .edit-copy small{
      display:block;
      font-size:.6rem;
      opacity:.7;
      margin-top:1px;
    }

    /* ================= COMPOSER ================= */

    .composer{
      display:flex;
      align-items:flex-end;
      gap:7px;
      padding:8px 9px max(9px,env(safe-area-inset-bottom));
      background:#fff;
      border-top:1px solid var(--line);
      z-index:20;
    }

    .attach{
      width:43px;
      height:43px;
      border:0;
      border-radius:50%;
      background:transparent;
      color:var(--accent);
      cursor:pointer;
      font-size:1.1rem;
      display:grid;
      place-items:center;
    }

    .attach:hover{background:var(--surface2)}

    .input-wrap{
      flex:1;
      min-width:0;
      display:flex;
      align-items:flex-end;
      border:1px solid #dddde2;
      background:#f5f5f7;
      border-radius:22px;
      padding:0 10px;
    }

    .input-wrap:focus-within{
      border-color:#b5afff;
      box-shadow:0 0 0 3px rgba(99,91,255,.08);
    }

    .input{
      width:100%;
      border:0;
      outline:0;
      resize:none;
      background:transparent;
      color:var(--text);
      padding:10px 2px;
      line-height:1.4;
      max-height:120px;
      min-height:41px;
    }

    .send{
      width:43px;
      height:43px;
      border:0;
      border-radius:50%;
      background:var(--accent);
      color:#fff;
      display:grid;
      place-items:center;
      cursor:pointer;
    }

    .send:disabled{
      opacity:.45;
      cursor:not-allowed;
    }

    #mediaInput{display:none}

    /* ================= ACTION SHEET ================= */

    .overlay{
      position:fixed;
      inset:0;
      background:rgba(0,0,0,.36);
      opacity:0;
      visibility:hidden;
      pointer-events:none;
      transition:.18s;
      z-index:90;
    }

    .overlay.open{
      opacity:1;
      visibility:visible;
      pointer-events:auto;
    }

    .action-sheet{
      position:fixed;
      left:50%;
      bottom:10px;
      transform:translate(-50%,18px);
      width:min(520px,calc(100vw - 18px));
      background:#fff;
      border-radius:22px;
      padding:9px;
      box-shadow:0 24px 70px rgba(0,0,0,.24);
      opacity:0;
      visibility:hidden;
      pointer-events:none;
      transition:.2s;
      z-index:91;
    }

    .action-sheet.open{
      opacity:1;
      visibility:visible;
      pointer-events:auto;
      transform:translate(-50%,0);
    }

    .react-row{
      display:flex;
      gap:4px;
      padding:2px 2px 9px;
      border-bottom:1px solid var(--line);
    }

    .react{
      flex:1;
      height:46px;
      border:0;
      border-radius:14px;
      background:#f3f3f5;
      font-size:1.25rem;
      cursor:pointer;
    }

    .react:hover{
      background:#e8e8eb;
      transform:translateY(-1px);
    }

    .react.add{font-size:1rem}

    .emoji-more{
      display:none;
      flex-wrap:wrap;
      gap:5px;
      padding:9px 2px 2px;
    }

    .emoji-more.open{display:flex}

    .emoji-more button{
      width:42px;
      height:38px;
      border:0;
      border-radius:10px;
      background:#f3f3f5;
      cursor:pointer;
      font-size:1.1rem;
    }

    .action{
      width:100%;
      height:44px;
      border:0;
      background:transparent;
      border-radius:11px;
      text-align:left;
      padding:0 12px;
      display:flex;
      align-items:center;
      gap:11px;
      cursor:pointer;
      font-weight:700;
    }

    .action:hover{background:#f3f3f5}

    .action.danger{color:var(--danger)}

    .action.disabled{
      opacity:.4;
      pointer-events:none;
    }

    .sheet-close{
      margin-top:4px;
      background:#f1f1f3;
    }

    .edit-time{
      font-size:.6rem;
      color:var(--muted);
      margin-left:auto;
    }

    .toast{
      position:fixed;
      left:50%;
      bottom:78px;
      transform:translateX(-50%);
      background:#191919;
      color:#fff;
      padding:9px 13px;
      border-radius:999px;
      font-size:.72rem;
      opacity:0;
      pointer-events:none;
      transition:.2s;
      z-index:120;
    }

    .toast.show{opacity:1}

    /* ================= MOBILE ================= */

    @media(max-width:600px){
      .page{
        height:calc(100dvh - 56px);
        min-height:0;
      }

      .chat{border-radius:0}

      .topbar{height:58px}

      .avatar{
        width:39px;
        height:39px;
      }

      .icon-btn{
        width:39px;
        height:39px;
      }

      .messages{
        padding:13px 8px 20px;
        gap:9px;
      }

      .bubble-wrap{
        max-width:82%;
      }

      .sender-message{
        max-width:82%;
      }

      .sender-avatar-wrap{
        width:31px;
        flex-basis:31px;
      }

      .sender-avatar{
        width:29px;
        height:29px;
      }

      .sender-name{
        font-size:.68rem;
      }

      .media{
        width:min(300px,72vw);
      }

      .action-sheet{
        bottom:0;
        border-radius:22px 22px 0 0;
        padding-bottom:max(9px,env(safe-area-inset-bottom));
      }

      .react{height:44px}

      .composer{padding-top:7px}
    }

    @media(min-width:900px){
      .messages{
        padding-left:clamp(28px,6vw,70px);
        padding-right:clamp(28px,6vw,70px);
      }

      .bubble-wrap,
      .sender-message{
        max-width:68%;
      }
    }
  </style>
</head>

<body>

  <%- include('./partials/nave') %>

  <main class="page">

    <section class="chat" aria-label="Conversation">

      <!-- HEADER -->
      <header class="topbar">

        <button class="icon-btn back" id="backBtn" aria-label="Back">
          <i class="fas fa-arrow-left"></i>
        </button>

        <div class="person" id="profileBtn" role="button" tabindex="0">

          <img
            class="avatar"
            id="avatar"
            src="/imgs/default.png"
            alt=""
          >

          <div class="person-copy">
            <div class="person-name" id="personName">Loading…</div>
            <div class="person-status" id="personStatus">Message</div>
          </div>

        </div>

        <div class="top-actions">

          <button class="icon-btn" id="menuBtn" aria-label="More">
            <i class="fas fa-ellipsis-v"></i>
          </button>

          <div class="top-menu" id="topMenu">

            <button id="profileAction">
              <i class="fas fa-user"></i>
              View profile
            </button>

            <button id="blockAction" class="danger">
              <i class="fas fa-ban"></i>
              Block user
            </button>

          </div>

        </div>

      </header>


      <!-- MESSAGES -->
      <div class="messages" id="messages" aria-live="polite">

        <div class="welcome" id="welcome">

          <img
            id="welcomeAvatar"
            src="/imgs/default.png"
            alt=""
          >

          <strong id="welcomeName">
            Starting chat…
          </strong>

          <p>
            Send a message to start your conversation.
          </p>

        </div>

      </div>


      <div class="typing" id="typing"></div>


      <!-- MEDIA PREVIEW -->
      <div class="preview" id="preview">

        <div class="preview-thumb" id="previewThumb"></div>

        <div class="preview-name" id="previewName"></div>

        <button
          class="remove"
          id="removeMedia"
          aria-label="Remove attachment"
        >
          ×
        </button>

      </div>


      <!-- EDIT BAR -->
      <div class="edit-bar" id="editBar">

        <i class="fas fa-pen"></i>

        <div class="edit-copy">

          <strong>Editing message</strong>

          <small id="editText"></small>

        </div>

        <span class="edit-time" id="editTime"></span>

        <button class="cancel" id="cancelEdit">
          Cancel
        </button>

      </div>


      <!-- COMPOSER -->
      <form class="composer" id="composer">

        <button
          type="button"
          class="attach"
          id="mediaBtn"
          aria-label="Photo or video"
        >
          <i class="fas fa-plus"></i>
        </button>

        <input
          id="mediaInput"
          type="file"
          accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime"
        >

        <div class="input-wrap">

          <textarea
            id="input"
            class="input"
            rows="1"
            maxlength="5000"
            placeholder="Message…"
            autocomplete="off"
          ></textarea>

        </div>

        <button
          class="send"
          id="sendBtn"
          type="submit"
          aria-label="Send"
        >
          <i class="fas fa-paper-plane"></i>
        </button>

      </form>

    </section>

  </main>


  <!-- ACTION SHEET -->
  <div class="overlay" id="overlay"></div>

  <div
    class="action-sheet"
    id="actionSheet"
    aria-label="Message actions"
  >

    <div class="react-row">

      <button class="react" data-emoji="❤️">❤️</button>
      <button class="react" data-emoji="😂">😂</button>
      <button class="react" data-emoji="😮">😮</button>
      <button class="react" data-emoji="😢">😢</button>

      <button class="react add" id="moreEmoji">
        ＋
      </button>

    </div>


    <div class="emoji-more" id="emojiMore">

      <button data-emoji="👍">👍</button>
      <button data-emoji="😍">😍</button>
      <button data-emoji="🔥">🔥</button>
      <button data-emoji="👏">👏</button>
      <button data-emoji="😡">😡</button>
      <button data-emoji="🙏">🙏</button>
      <button data-emoji="🎉">🎉</button>
      <button data-emoji="💯">💯</button>

    </div>


    <button class="action" id="editAction">

      <i class="fas fa-pen"></i>

      Edit

      <span
        class="edit-time"
        id="sheetEditTime"
      ></span>

    </button>


    <button class="action" id="copyAction">

      <i class="far fa-copy"></i>

      Copy

    </button>


    <button class="action danger" id="unsendAction">

      <i class="fas fa-trash-alt"></i>

      Unsend

    </button>


    <button class="action sheet-close" id="closeSheet">

      <i class="fas fa-times"></i>

      Cancel

    </button>

  </div>


  <div class="toast" id="toast"></div>


  <%- include('./partials/scripts') %>

  <script src="/socket.io/socket.io.js"></script>

  <script>

    const CURRENT='<%= user._id %>';
    const TARGET='<%= targetUserId %>';

    const EDIT_WINDOW_MS=60*1000;

    let conversationId=null;
    let other=null;
    let socket=null;
    let selectedFile=null;
    let activeMessageId=null;
    let editingMessageId=null;
    let typingTimer=null;
    let longPressTimer=null;
    let longPressTriggered=false;


    const $=id=>document.getElementById(id);


    const escapeHtml=value=>
      String(value??'').replace(
        /[&<>"']/g,
        c=>({
          '&':'&amp;',
          '<':'&lt;',
          '>':'&gt;',
          '"':'&quot;',
          "'":'&#039;'
        }[c])
      );


    const img=v=>
      v&&String(v).trim()
        ?String(v)
        :'/imgs/default.png';


    function toast(text){

      const el=$('toast');

      el.textContent=text;

      el.classList.add('show');

      clearTimeout(window.__toast);

      window.__toast=setTimeout(
        ()=>el.classList.remove('show'),
        2400
      );

    }


    function api(url,opts={}){

      return fetch(
        url,
        {
          credentials:'same-origin',

          headers:{
            Accept:'application/json',

            ...(opts.body instanceof FormData
              ?{}
              :{'Content-Type':'application/json'}),

            ...(opts.headers||{})
          },

          ...opts
        }
      );

    }


    function time(v){

      return v
        ?new Date(v).toLocaleTimeString(
            [],
            {
              hour:'numeric',
              minute:'2-digit'
            }
          )
        :'';

    }


    function day(v){

      return new Date(v).toLocaleDateString(
        [],
        {
          day:'numeric',
          month:'short',
          year:'numeric'
        }
      );

    }


    function canEdit(m){

      return !m.deleted &&
        String(m.senderId?._id||m.senderId)===String(CURRENT) &&
        Date.now()-new Date(m.createdAt).getTime()<=EDIT_WINDOW_MS;

    }


    function remaining(m){

      return Math.max(
        0,
        EDIT_WINDOW_MS-
        (Date.now()-new Date(m.createdAt).getTime())
      );

    }


    /*
      Always start the conversation from the newest message.
    */

    function scrollBottom(smooth=true){

      const box=$('messages');

      if(!box)return;

      requestAnimationFrame(()=>{

        box.scrollTo({
          top:box.scrollHeight,
          behavior:smooth?'smooth':'auto'
        });

      });

    }


    function renderWelcome(){

      if(!other)return;

      $('welcomeAvatar').src=
        img(other.profileImageURL);

      $('welcomeName').textContent=
        other.fullName||'User';

    }


    function reactionBadges(m){

      const rs=
        Array.isArray(m.reactions)
          ?m.reactions
          :[];

      if(!rs.length)return '';

      const counts={};

      rs.forEach(r=>{
        counts[r.emoji]=
          (counts[r.emoji]||0)+1;
      });

      return `
        <div class="reaction-badges">
          ${
            Object.entries(counts)
              .map(([e,n])=>`
                <span class="reaction-badge">
                  ${escapeHtml(e)}
                  ${n>1?`<small>${n}</small>`:''}
                </span>
              `)
              .join('')
          }
        </div>
      `;

    }


    /*
      IMPORTANT:
      Every incoming message now contains:
      1. sender avatar
      2. sender fullName
      3. message content
    */

    function bubble(m){

      const mine=
        String(m.senderId?._id||m.senderId)===
        String(CURRENT);

      const deleted=Boolean(m.deleted);

      const row=document.createElement('div');

      row.className=
        'row '+(mine?'mine':'theirs');

      row.dataset.message=m._id;


      let media='';


      if(
        !deleted &&
        m.mediaUrl &&
        m.mediaType==='image'
      ){

        media=`
          <img
            class="media"
            src="${escapeHtml(m.mediaUrl)}"
            alt="Photo"
            loading="lazy"
          >
        `;

      }


      if(
        !deleted &&
        m.mediaUrl &&
        m.mediaType==='video'
      ){

        media=`
          <video
            class="media video"
            src="${escapeHtml(m.mediaUrl)}"
            controls
            playsinline
            preload="metadata"
          ></video>
        `;

      }


      let profile='';


      if(
        !deleted &&
        m.mediaType==='profile' &&
        m.profileShareId
      ){

        const p=m.profileShareId;

        profile=`
          <a
            href="/user/profile/${escapeHtml(p._id)}"
            style="
              display:block;
              color:inherit;
              text-decoration:none;
            "
          >

            <strong>
              ${escapeHtml(p.fullName||'Profile')}
            </strong>

            <div
              style="
                font-size:.7rem;
                opacity:.7;
                margin-top:3px;
              "
            >
              Shared profile
            </div>

          </a>
        `;

      }


      const text=
        deleted
          ?'Message unsent'
          :(m.text||'');


      const edited=
        m.edited&&!deleted
          ?'<span class="edited">edited</span>'
          :'';


      const likes=
        Array.isArray(m.likes)
          ?m.likes.length
          :0;


      /*
        Get sender information.

        The conversation API may return senderId
        either as a populated object or as an ID.
        For incoming messages we use `other`, which
        is already loaded from the conversation endpoint.
      */

      const senderObject=
        m.senderId &&
        typeof m.senderId==='object'
          ?m.senderId
          :null;


      const senderName=
        senderObject?.fullName ||
        (!mine?other?.fullName:'') ||
        'User';


      const senderAvatar=
        senderObject?.profileImageURL ||
        (!mine?other?.profileImageURL:'') ||
        '/imgs/default.png';


      /*
        Incoming message identity.
      */

      let senderIdentity='';


      if(!mine){

        senderIdentity=`

          <div class="sender-avatar-wrap">

            <img
              class="sender-avatar"
              src="${escapeHtml(img(senderAvatar))}"
              alt="${escapeHtml(senderName)}"
              loading="lazy"
              onerror="this.onerror=null;this.src='/imgs/default.png'"
            >

          </div>

          <div class="sender-message">

            <div class="sender-name">

              <i class="fas fa-user"></i>

              ${escapeHtml(senderName)}

            </div>

            <div class="bubble ${deleted?'deleted':''}" data-bubble="${escapeHtml(m._id)}">

              ${media}

              ${profile}

              ${
                text
                  ?`<div class="text">
                      ${escapeHtml(text)}
                      ${edited}
                    </div>`
                  :''
              }

              <div class="meta">

                ${time(m.createdAt)}

                ${
                  likes
                    ?`<span class="like-pill">
                        ♥ ${likes}
                      </span>`
                    :''
                }

              </div>

              ${reactionBadges(m)}

            </div>

          </div>

        `;

      }else{

        senderIdentity=`

          <div class="bubble-wrap">

            <div
              class="bubble ${deleted?'deleted':''}"
              data-bubble="${escapeHtml(m._id)}"
            >

              ${media}

              ${profile}

              ${
                text
                  ?`<div class="text">
                      ${escapeHtml(text)}
                      ${edited}
                    </div>`
                  :''
              }

              <div class="meta">

                ${time(m.createdAt)}

                ${
                  !deleted
                    ?`
                      <span
                        class="status ${
                          m.status==='read'
                            ?'read'
                            :''
                        }"
                      >
                        ${
                          m.status==='read'
                            ?'✓✓'
                            :m.status==='delivered'
                              ?'✓✓'
                              :'✓'
                        }
                      </span>
                    `
                    :''
                }

                ${
                  likes
                    ?`<span class="like-pill">
                        ♥ ${likes}
                      </span>`
                    :''
                }

              </div>

              ${reactionBadges(m)}

            </div>

          </div>

        `;

      }


      row.innerHTML=senderIdentity;

      return row;

    }


    function appendDateIfNeeded(m){

      const box=$('messages');

      const last=
        box.querySelector(
          '.date-divider:last-of-type'
        );

      const d=day(m.createdAt);


      if(last&&last.dataset.day===d)return;


      const x=document.createElement('div');

      x.className='date-divider';

      x.dataset.day=d;

      x.textContent=d;

      box.appendChild(x);

    }


    function renderMessages(list){

      const box=$('messages');

      box.innerHTML='';


      if(!list||!list.length){

        box.appendChild($('welcome'));

        renderWelcome();

        return;

      }


      list.forEach(m=>{

        appendDateIfNeeded(m);

        const el=bubble(m);

        box.appendChild(el);

        bindGesture(el);

      });


      /*
        Start at bottom so latest message is visible.
      */

      scrollBottom(false);

    }


    function replaceMessage(m){

      const old=
        document.querySelector(
          '[data-message="'+
          CSS.escape(String(m._id))+
          '"]'
        );


      if(!old)return;


      const fresh=bubble(m);

      old.replaceWith(fresh);

      bindGesture(fresh);

    }


    function patchDeleted(id){

      const el=
        document.querySelector(
          '[data-message="'+
          CSS.escape(String(id))+
          '"]'
        );


      if(!el)return;


      const bubbleEl=
        el.querySelector('.bubble');


      bubbleEl.className='bubble deleted';


      bubbleEl.innerHTML=`

        <div class="text">
          Message unsent
        </div>

        <div class="meta">
          ${time(new Date())}
        </div>

      `;

    }


    function closeSheet(){

      activeMessageId=null;

      $('overlay').classList.remove('open');

      $('actionSheet').classList.remove('open');

      $('emojiMore').classList.remove('open');

      document.body.style.overflow='';

    }


    function openSheet(id){

      const el=
        document.querySelector(
          '[data-message="'+
          CSS.escape(String(id))+
          '"]'
        );


      if(!el)return;


      activeMessageId=id;


      const m=
        window.__messages?.find(
          m=>String(m._id)===String(id)
        );


      const editable=
        m&&canEdit(m);


      $('editAction')
        .classList
        .toggle('disabled',!editable);


      $('sheetEditTime').textContent=
        editable
          ?Math.ceil(
              remaining(m)/1000
            )+'s left'
          :'';


      $('overlay').classList.add('open');

      $('actionSheet').classList.add('open');

      document.body.style.overflow='hidden';

    }


    function bindGesture(row){

      const b=
        row.querySelector('.bubble');


      if(!b)return;


      /* Double tap to like */

      b.addEventListener(
        'dblclick',
        ()=>{
          if(activeMessageId)return;

          const id=row.dataset.message;

          react(id,'❤️');
        }
      );


      /* Long press */

      const start=e=>{

        if(e.target.closest('video'))return;

        longPressTriggered=false;

        clearTimeout(longPressTimer);


        longPressTimer=
          setTimeout(
            ()=>{
              longPressTriggered=true;

              openSheet(row.dataset.message);
            },
            520
          );

      };


      const end=()=>{
        clearTimeout(longPressTimer);
      };


      b.addEventListener(
        'pointerdown',
        start
      );

      b.addEventListener(
        'pointerup',
        end
      );

      b.addEventListener(
        'pointercancel',
        end
      );

      b.addEventListener(
        'pointerleave',
        end
      );


      b.addEventListener(
        'contextmenu',
        e=>{
          e.preventDefault();

          openSheet(row.dataset.message);
        }
      );

    }


    async function react(id,emoji){

      if(!socket||!conversationId)return;


      socket.emit(
        'message:react',
        {
          conversationId,
          messageId:id,
          emoji
        }
      );


      closeSheet();

    }


    function startEdit(){

      const m=
        window.__messages?.find(
          x=>String(x._id)===
             String(activeMessageId)
        );


      if(!m||!canEdit(m)){

        toast(
          'Edit is available for only 1 minute.'
        );

        closeSheet();

        return;

      }


      editingMessageId=m._id;

      $('input').value=m.text||'';

      $('input')
        .dispatchEvent(
          new Event('input')
        );


      $('editText').textContent=
        m.text||'Empty message';


      $('editBar').classList.add('show');

      $('input').focus();

      closeSheet();

      updateEditTimer();

    }


    function cancelEdit(){

      editingMessageId=null;

      $('editBar').classList.remove('show');

      $('editText').textContent='';

    }


    function updateEditTimer(){

      if(!editingMessageId)return;


      const m=
        window.__messages?.find(
          x=>String(x._id)===
             String(editingMessageId)
        );


      if(!m){

        cancelEdit();

        return;

      }


      const left=remaining(m);


      if(left<=0){

        cancelEdit();

        toast('Edit window expired');

        return;

      }


      $('editTime').textContent=
        Math.ceil(left/1000)+'s';


      setTimeout(
        updateEditTimer,
        1000
      );

    }


    function submitEdit(){

      const text=
        $('input').value.trim();


      if(!text||!editingMessageId)return;

      if(!socket)return;


      socket.emit(
        'message:edit',
        {
          conversationId,
          messageId:editingMessageId,
          text
        }
      );


      cancelEdit();

      $('input').value='';

      resizeInput();

    }


    async function unsend(){

      const m=
        window.__messages?.find(
          x=>String(x._id)===
             String(activeMessageId)
        );


      if(!m){

        closeSheet();

        return;

      }


      if(
        String(m.senderId?._id||m.senderId)!==
        String(CURRENT)
      ){

        toast(
          'You can only unsend your own message.'
        );

        closeSheet();

        return;

      }


      if(
        !confirm(
          'Unsend this message for everyone?'
        )
      ){

        closeSheet();

        return;

      }


      socket?.emit(
        'message:unsend',
        {
          conversationId,
          messageId:m._id
        }
      );


      closeSheet();

    }


    async function copyActive(){

      const m=
        window.__messages?.find(
          x=>String(x._id)===
             String(activeMessageId)
        );


      if(!m||m.deleted){

        closeSheet();

        return;

      }


      try{

        await navigator.clipboard.writeText(
          m.text||''
        );

        toast('Message copied');

      }catch(e){

        toast(
          'Unable to copy message'
        );

      }


      closeSheet();

    }


    async function init(){

      try{

        const r=
          await api(
            '/messages/conversation',
            {
              method:'POST',
              body:JSON.stringify({
                userId:TARGET
              })
            }
          );


        const d=await r.json();


        if(!r.ok||!d.success){

          throw new Error(
            d.message||
            'Unable to open conversation'
          );

        }


        conversationId=d.conversationId;

        other=d.target;

        setPerson();


        const h=
          await api(
            '/messages/'+
            encodeURIComponent(conversationId)
          );


        const data=await h.json();


        if(!h.ok||!data.success){

          throw new Error(
            data.message||
            'Unable to load messages'
          );

        }


        window.__messages=
          data.messages||[];


        renderMessages(
          window.__messages
        );


        socket=io();

        bindSocket();

        socket.emit(
          'conversation:join',
          conversationId
        );

        socket.emit(
          'message:read',
          {
            conversationId
          }
        );


        /*
          Ensure latest message is visible
          after socket and layout are ready.
        */

        setTimeout(
          ()=>scrollBottom(false),
          80
        );


      }catch(e){

        $('messages').innerHTML=`

          <div class="welcome">

            <i
              class="fas fa-exclamation-circle"
              style="font-size:2rem"
            ></i>

            <strong>
              Unable to load chat
            </strong>

            <p>
              ${escapeHtml(e.message)}
            </p>

            <button
              class="action"
              style="
                background:#f1f1f3;
                justify-content:center;
                margin-top:10px;
              "
              onclick="location.reload()"
            >
              Try again
            </button>

          </div>

        `;

      }

    }


    function setPerson(){

      const name=
        other?.fullName||
        'User';


      $('personName').textContent=name;

      $('avatar').src=
        img(other?.profileImageURL);

      $('welcomeName').textContent=name;

      $('welcomeAvatar').src=
        img(other?.profileImageURL);


      $('avatar').onerror=()=>{
        $('avatar').src=
          '/imgs/default.png';
      };


      $('welcomeAvatar').onerror=()=>{
        $('welcomeAvatar').src=
          '/imgs/default.png';
      };


      $('personStatus').textContent=
        other?.isPrivate
          ?'Private account'
          :'Message';


      $('profileAction').onclick=
        viewProfile;


      $('profileBtn').onclick=
        viewProfile;


      $('profileBtn').onkeydown=e=>{

        if(e.key==='Enter')
          viewProfile();

      };

    }


    function viewProfile(){

      location.href=
        '/user/profile/'+
        encodeURIComponent(TARGET);

    }


    function bindSocket(){

      socket.on(
        'user:online',
        d=>{

          if(
            String(d.userId)===
            String(TARGET)
          ){

            $('personStatus').textContent=
              'Active now';

            $('personStatus')
              .classList
              .add('online');

          }

        }
      );


      socket.on(
        'user:offline',
        d=>{

          if(
            String(d.userId)===
            String(TARGET)
          ){

            $('personStatus').textContent=
              other?.isPrivate
                ?'Private account'
                :'Message';

            $('personStatus')
              .classList
              .remove('online');

          }

        }
      );


      socket.on(
        'typing:start',
        d=>{

          if(
            String(d.userId)===
            String(TARGET)
          ){

            $('typing').textContent=
              (other?.fullName||'User')+
              ' is typing…';

          }

        }
      );


      socket.on(
        'typing:stop',
        d=>{

          if(
            String(d.userId)===
            String(TARGET)
          ){

            $('typing').textContent='';

          }

        }
      );


      socket.on(
        'message:new',
        m=>{

          if(
            String(m.conversationId)!==
            String(conversationId)
          )return;


          const box=$('messages');


          /*
            Only auto-scroll if the user is already
            near the bottom.
          */

          const nearBottom=
            box.scrollHeight-
            box.scrollTop-
            box.clientHeight<
            140;


          window.__messages=
            window.__messages||[];


          window.__messages.push(m);


          const w=$('welcome');


          if(w?.parentNode)
            w.remove();


          appendDateIfNeeded(m);


          const el=bubble(m);


          box.appendChild(el);


          bindGesture(el);


          if(nearBottom)
            scrollBottom();


          socket.emit(
            'message:read',
            {
              conversationId
            }
          );

        }
      );


      socket.on(
        'message:edited',
        m=>{

          const i=
            window.__messages.findIndex(
              x=>String(x._id)===
                 String(m._id)
            );


          if(i>=0)
            window.__messages[i]=m;


          replaceMessage(m);

        }
      );


      socket.on(
        'message:unsent',
        d=>{

          const i=
            window.__messages.findIndex(
              x=>String(x._id)===
                 String(d.messageId)
            );


          if(i>=0){

            window.__messages[i].deleted=true;

            window.__messages[i].text='';

            window.__messages[i].mediaUrl='';

          }


          patchDeleted(
            d.messageId
          );

        }
      );


      socket.on(
        'message:reactions',
        d=>{

          const m=
            window.__messages.find(
              x=>String(x._id)===
                 String(d.messageId)
            );


          if(m)
            m.reactions=d.reactions;


          const el=
            document.querySelector(
              '[data-message="'+
              CSS.escape(
                String(d.messageId)
              )+
              '"]'
            );


          if(el){

            const fresh=bubble(m);

            el.replaceWith(fresh);

            bindGesture(fresh);

          }

        }
      );


      socket.on(
        'message:read',
        d=>{

          if(
            String(d.conversationId)!==
            String(conversationId)
          )return;


          window.__messages
            .filter(
              m=>
                String(
                  m.senderId?._id||
                  m.senderId
                )===
                String(CURRENT)
            )
            .forEach(
              m=>m.status='read'
            );


          document
            .querySelectorAll(
              '.row.mine .status'
            )
            .forEach(x=>{

              x.textContent='✓✓';

              x.classList.add('read');

            });

        }
      );


      socket.on(
        'message:error',
        d=>
          toast(
            d.message||
            'Unable to send message'
          )
      );


      socket.on(
        'message:action:error',
        d=>
          toast(
            d.message||
            'Unable to update message'
          )
      );

    }


    async function send(){

      const text=
        $('input').value.trim();


      if(editingMessageId){

        submitEdit();

        return;

      }


      if(!text&&!selectedFile)return;


      if(!socket||!conversationId){

        return toast(
          'Chat is still loading'
        );

      }


      $('sendBtn').disabled=true;


      try{

        let mediaUrl='';
        let mediaType='';


        if(selectedFile){

          const fd=new FormData();

          fd.append(
            'media',
            selectedFile
          );


          const r=
            await api(
              '/messages/upload',
              {
                method:'POST',
                body:fd
              }
            );


          const d=await r.json();


          if(!r.ok||!d.success){

            throw new Error(
              d.message||
              'Unable to upload media'
            );

          }


          mediaUrl=d.mediaUrl;

          mediaType=d.mediaType;

        }


        socket.emit(
          'message:send',
          {
            conversationId,
            text,
            mediaUrl,
            mediaType
          }
        );


        $('input').value='';

        clearMedia();

        resizeInput();


      }catch(e){

        toast(e.message);

      }finally{

        $('sendBtn').disabled=false;

      }

    }


    function resizeInput(){

      const x=$('input');

      x.style.height='auto';

      x.style.height=
        Math.min(
          x.scrollHeight,
          120
        )+'px';

    }


    function clearMedia(){

      $('mediaInput').value='';

      selectedFile=null;

      $('preview')
        .classList
        .remove('show');

      $('previewThumb').innerHTML='';

      $('previewName').textContent='';

    }


    function previewFile(file){

      selectedFile=file;

      if(!file)return;


      const url=
        URL.createObjectURL(file);


      $('previewName').textContent=
        file.name;


      $('previewThumb').innerHTML=
        file.type.startsWith('video/')
          ?`
            <video
              src="${url}"
              muted
            ></video>
          `
          :`
            <img
              src="${url}"
              alt=""
            >
          `;


      $('preview').classList.add('show');

    }


    /* ================= EVENTS ================= */


    $('composer').addEventListener(
      'submit',
      e=>{
        e.preventDefault();
        send();
      }
    );


    $('input').addEventListener(
      'input',
      ()=>{

        resizeInput();


        if(socket&&conversationId){

          socket.emit(
            'typing:start',
            {
              conversationId
            }
          );


          clearTimeout(
            typingTimer
          );


          typingTimer=
            setTimeout(
              ()=>{
                socket.emit(
                  'typing:stop',
                  {
                    conversationId
                  }
                );
              },
              900
            );

        }

      }
    );


    $('input').addEventListener(
      'keydown',
      e=>{

        if(
          e.key==='Enter' &&
          !e.shiftKey &&
          window.innerWidth>650
        ){

          e.preventDefault();

          send();

        }

      }
    );


    $('mediaBtn').onclick=
      ()=>$('mediaInput').click();


    $('mediaInput').onchange=
      e=>
        previewFile(
          e.target.files?.[0]
        );


    $('removeMedia').onclick=
      clearMedia;


    $('cancelEdit').onclick=
      cancelEdit;


    $('backBtn').onclick=
      ()=>{
        history.length>1
          ?history.back()
          :location.href='/messages/chatlog';
      };


    $('menuBtn').onclick=
      e=>{

        e.stopPropagation();

        $('topMenu')
          .classList
          .toggle('open');

      };


    $('blockAction').onclick=
      async()=>{

        if(
          !confirm(
            'Block this user?'
          )
        )return;


        try{

          const r=
            await api(
              '/messages/block/'+TARGET,
              {
                method:'POST'
              }
            );


          const d=await r.json();


          if(
            !r.ok||
            !d.success
          ){

            throw new Error(
              d.message||
              'Unable to block'
            );

          }


          toast(
            d.message||
            'User blocked'
          );


          setTimeout(
            ()=>{
              location.href=
                '/messages/chatlog';
            },
            700
          );


        }catch(e){

          toast(e.message);

        }

      };


    document.addEventListener(
      'click',
      e=>{

        if(
          !e.target.closest('.top-actions')
        ){

          $('topMenu')
            .classList
            .remove('open');

        }


        if(
          !e.target.closest('.action-sheet') &&
          !e.target.closest('.bubble')
        ){

          closeSheet();

        }

      }
    );


    $('overlay').onclick=
      closeSheet;


    $('closeSheet').onclick=
      closeSheet;


    $('editAction').onclick=
      startEdit;


    $('copyAction').onclick=
      copyActive;


    $('unsendAction').onclick=
      unsend;


    $('moreEmoji').onclick=
      ()=>
        $('emojiMore')
          .classList
          .toggle('open');


    document
      .querySelectorAll('[data-emoji]')
      .forEach(
        b=>
          b.addEventListener(
            'click',
            ()=>{
              if(activeMessageId)
                react(
                  activeMessageId,
                  b.dataset.emoji
                );
            }
          )
      );


    /*
      Keep chat at the newest message on
      initial page load and after browser
      layout changes.
    */

    window.addEventListener(
      'load',
      ()=>{
        setTimeout(
          ()=>scrollBottom(false),
          100
        );
      }
    );


    window.addEventListener(
      'resize',
      ()=>{
        if(
          $('messages').scrollHeight-
          $('messages').scrollTop-
          $('messages').clientHeight<
          160
        ){

          scrollBottom(false);

        }
      }
    );


    init();

  </script>

</body>
</html>
