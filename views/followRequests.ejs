<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Follow Requests | Blogify</title><style>body{font-family:system-ui,sans-serif;background:#f6f7fb;color:#172033;margin:0}.wrap{max-width:720px;margin:80px auto;padding:20px}.card{background:#fff;border:1px solid #e6e8ef;border-radius:16px;padding:18px;margin:12px 0;display:flex;align-items:center;gap:14px}.avatar{width:52px;height:52px;border-radius:50%;object-fit:cover}.info{flex:1}.info strong{display:block}.info span{color:#718096;font-size:.85rem}.actions{display:flex;gap:8px}.btn{border:0;border-radius:10px;padding:9px 13px;font-weight:700;cursor:pointer}.accept{background:#159570;color:#fff}.reject{background:#f1f3f7;color:#172033}.empty{text-align:center;color:#718096;padding:60px 10px}</style></head><body><main class="wrap"><h1>Follow requests</h1><p>People who want to follow your private account.</p><div id="list"><div class="empty">Loading…</div></div></main><script>async function load(){const r=await fetch('/follow/requests');const d=await r.json();const list=document.getElementById('list');if(!d.success||!d.requests.length){list.innerHTML='<div class="empty">No pending follow requests.</div>';return}list.innerHTML=d.requests.map(x=>`<div class="card" data-id="${x._id}"><img class="avatar" src="${x.requester.profileImageURL||'/imgs/default.png'}" onerror="this.src='/imgs/default.png'"><div class="info"><strong>${escapeHtml(x.requester.fullName)}</strong><span>${escapeHtml(x.requester.bio||'Wants to follow you')}</span></div><div class="actions"><button class="btn accept" onclick="respond('${x._id}','accept',this)">Accept</button><button class="btn reject" onclick="respond('${x._id}','reject',this)">Reject</button></div></div>`).join('')}async function respond(id,action,btn){btn.disabled=true;const r=await fetch('/follow/requests/'+id+'/'+action,{method:'POST',headers:{'Content-Type':'application/json'}});const d=await r.json();if(d.success){btn.closest('.card').remove();if(!document.querySelector('.card'))document.getElementById('list').innerHTML='<div class="empty">No pending follow requests.</div>'}else{alert(d.message||'Request failed');btn.disabled=false}}function escapeHtml(v){return String(v).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}load();</script></body></html>
