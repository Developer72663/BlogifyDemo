<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/toastr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
<script>
    toastr.options = { closeButton:true, newestOnTop:true, progressBar:true, positionClass:'toast-top-right', preventDuplicates:true, timeOut:5000 };
    const notify = { success:(m)=>toastr.success(m), error:(m)=>toastr.error(m), info:(m)=>toastr.info(m), warning:(m)=>toastr.warning(m) };
    axios.defaults.headers.common['Content-Type'] = 'application/json';
    axios.interceptors.response.use(r=>r,e=>{ if(e.response?.status===401){ notify.error('Session expired. Please login again.'); window.location.href='/user/signin'; } return Promise.reject(e); });

    function formatDate(dateString) { return new Date(dateString).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}); }
    function timeAgo(dateString) {
        const seconds=Math.floor((new Date()-new Date(dateString))/1000); let interval=seconds/31536000;
        if(interval>1)return Math.floor(interval)+' years ago'; interval=seconds/2592000;
        if(interval>1)return Math.floor(interval)+' months ago'; interval=seconds/86400;
        if(interval>1)return Math.floor(interval)+' days ago'; interval=seconds/3600;
        if(interval>1)return Math.floor(interval)+' hours ago'; interval=seconds/60;
        if(interval>1)return Math.floor(interval)+' minutes ago'; return Math.floor(seconds)+' seconds ago';
    }
    function truncate(str,length=60){ if(!str)return ''; str=String(str); return str.length<=length?str:str.substring(0,length).trim()+'...'; }

    const scrollToTopBtn=document.createElement('button');
    scrollToTopBtn.className='btn btn-primary rounded-circle position-fixed bottom-0 end-0 m-4 shadow';
    scrollToTopBtn.style.cssText='width:50px;height:50px;display:none;z-index:999;';
    scrollToTopBtn.innerHTML='<i class="fas fa-arrow-up"></i>'; document.body.appendChild(scrollToTopBtn);
    window.addEventListener('scroll',()=>scrollToTopBtn.style.display=window.pageYOffset>300?'block':'none');
    scrollToTopBtn.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));

    window.toggleFollow=async function(userId,buttonElement){
        if(!userId){notify.error('Invalid user');return;} buttonElement.disabled=true;
        try{const {data}=await axios.post(`/follow/${userId}/follow`); if(data.success){
            buttonElement.innerHTML=data.following?'<i class="fas fa-user-check"></i> Following':'<i class="fas fa-user-plus"></i> Follow';
            buttonElement.classList.toggle('btn-success',data.following); buttonElement.classList.toggle('btn-outline-primary',!data.following); notify.success(data.message);
        }else notify.error(data.message||'Action failed');}catch(err){console.error('Follow Error:',err);notify.error(err.response?.data?.message||'Failed to follow user');}finally{buttonElement.disabled=false;}
    };

    function showLoader(){const loader=document.createElement('div');loader.className='spinner-border text-primary position-fixed';loader.style.cssText='top:50%;left:50%;transform:translate(-50%,-50%);z-index:9999;';loader.id='globalLoader';document.body.appendChild(loader);}
    function hideLoader(){document.getElementById('globalLoader')?.remove();}

    window.confirmAction=function(message){return new Promise(resolve=>{
        document.getElementById('confirmModal')?.remove();
        document.body.insertAdjacentHTML('beforeend',`<div class="modal fade" id="confirmModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Confirm Action</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">${message}</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-danger" id="confirmYesBtn">Yes, Proceed</button></div></div></div></div>`);
        const modal=new bootstrap.Modal(document.getElementById('confirmModal')); modal.show();
        document.getElementById('confirmYesBtn').addEventListener('click',()=>{resolve(true);modal.hide();});
        document.getElementById('confirmModal').addEventListener('hidden.bs.modal',()=>{resolve(false);document.getElementById('confirmModal')?.remove();});
    });};

    document.addEventListener('click',(event)=>{
        const settingsTrigger=event.target.closest('#settingsBtn, #mobileSettings');
        if(settingsTrigger){event.preventDefault();window.location.href='/user/profile/settings';}
    });

    /* Profile three-dot bottom-sheet menu */
    (function(){
        const STYLE_ID='blogify-profile-sheet-style';
        if(!document.getElementById(STYLE_ID)){
            const style=document.createElement('style');
            style.id=STYLE_ID;
            style.textContent=`
                #profileMenu.blogify-sheet{position:fixed!important;left:0!important;right:0!important;bottom:0!important;top:auto!important;width:100%!important;max-width:100%!important;margin:0!important;padding:10px 12px calc(12px + env(safe-area-inset-bottom))!important;border:0!important;border-top:1px solid var(--line,#e7eaf1)!important;border-radius:22px 22px 0 0!important;box-shadow:0 -18px 55px rgba(0,0,0,.22)!important;background:var(--card,#fff)!important;transform:translateY(105%)!important;opacity:0!important;display:block!important;visibility:hidden!important;z-index:10001!important;max-height:min(78vh,620px)!important;overflow-y:auto!important;overscroll-behavior:contain!important;transition:transform .24s ease,opacity .2s ease,visibility 0s linear .24s!important}
                #profileMenu.blogify-sheet.open{transform:translateY(0)!important;opacity:1!important;visibility:visible!important;transition:transform .24s ease,opacity .2s ease!important}
                #profileMenu.blogify-sheet::before{content:'';display:block;width:42px;height:5px;border-radius:99px;background:var(--line,#e7eaf1);margin:2px auto 10px}
                #profileMenu.blogify-sheet button,#profileMenu.blogify-sheet a{min-height:48px;padding:13px 14px!important;border-radius:12px!important;font-size:.96rem!important}
                #profileMenu.blogify-sheet .danger{color:var(--danger,#e5484d)!important}
                #blogify-profile-sheet-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:10000;opacity:0;visibility:hidden;transition:opacity .2s ease,visibility 0s linear .2s;backdrop-filter:blur(2px)}
                #blogify-profile-sheet-backdrop.open{opacity:1;visibility:visible;transition:opacity .2s ease}
                body.blogify-sheet-open{overflow:hidden!important;touch-action:none}
            `;
            document.head.appendChild(style);
        }
        function getParts(){return {menu:document.getElementById('profileMenu'),trigger:document.getElementById('moreBtn'),actions:document.querySelector('.actions')};}
        function ensureBackdrop(){
            let b=document.getElementById('blogify-profile-sheet-backdrop');
            if(!b){b=document.createElement('div');b.id='blogify-profile-sheet-backdrop';b.setAttribute('aria-hidden','true');document.body.appendChild(b);b.addEventListener('click',closeProfileSheet);}
            return b;
        }
        function openProfileSheet(){
            const {menu,trigger}=getParts(); if(!menu||!trigger)return;
            const backdrop=ensureBackdrop();
            menu.classList.add('blogify-sheet','open');
            trigger.setAttribute('aria-expanded','true');
            menu.setAttribute('aria-hidden','false');
            backdrop.classList.add('open');
            document.body.classList.add('blogify-sheet-open');
        }
        function closeProfileSheet(){
            const {menu,trigger}=getParts();
            if(!menu)return;
            menu.classList.remove('open');
            trigger?.setAttribute('aria-expanded','false');
            menu.setAttribute('aria-hidden','true');
            document.getElementById('blogify-profile-sheet-backdrop')?.classList.remove('open');
            document.body.classList.remove('blogify-sheet-open');
        }
        window.closeProfileSheet=closeProfileSheet;

        /* Capture phase guarantees the button works even if an older inline handler exists. */
        document.addEventListener('click',function(event){
            const trigger=event.target.closest('#moreBtn');
            const menu=document.getElementById('profileMenu');
            if(!trigger||!menu)return;
            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();
            if(menu.classList.contains('open')) closeProfileSheet(); else openProfileSheet();
        },true);

        document.addEventListener('click',function(event){
            const menu=document.getElementById('profileMenu');
            if(!menu?.classList.contains('open'))return;
            if(event.target.closest('#profileMenu')||event.target.closest('#moreBtn'))return;
            closeProfileSheet();
        });
        document.addEventListener('keydown',function(event){
            if(event.key==='Escape'&&document.getElementById('profileMenu')?.classList.contains('open'))closeProfileSheet();
        });

        /* Make the existing inline toggle harmless: the capture listener above owns the state. */
        window.toggleMenu=function(event){
            event?.preventDefault();
            event?.stopPropagation();
            const menu=document.getElementById('profileMenu');
            if(menu?.classList.contains('open'))closeProfileSheet();else openProfileSheet();
        };

        /* Keep the sheet usable after orientation/resize without changing its bottom position. */
        window.addEventListener('resize',()=>{
            if(document.getElementById('profileMenu')?.classList.contains('open'))document.getElementById('profileMenu').style.maxHeight=Math.min(window.innerHeight*.78,620)+'px';
        });
    })();

    (function(){
        const saved=document.documentElement.dataset.theme || localStorage.getItem('blogify-theme');
        const theme=saved || 'system';
        const dark=theme==='dark' || (theme==='system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme=dark?'dark':'light';
        if(theme==='system') window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',e=>document.documentElement.dataset.theme=e.matches?'dark':'light');
    })();
</script>
