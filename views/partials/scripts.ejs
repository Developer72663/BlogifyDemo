<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/toastr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
<script>
    toastr.options = { closeButton:true, newestOnTop:true, progressBar:true, positionClass:'toast-top-right', preventDuplicates:true, timeOut:5000 };
    const notify = { success:(m)=>toastr.success(m), error:(m)=>toastr.error(m), info:(m)=>toastr.info(m), warning:(m)=>toastr.warning(m) };
    axios.defaults.headers.common['Content-Type'] = 'application/json';
    axios.interceptors.response.use(r=>r,e=>{ if(e.response?.status===401){ notify.error('Session expired. Please login again.'); window.location.href='/user/signin'; } return Promise.reject(e); });
    function formatDate(dateString) { return new Date(dateString).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}); }
    function timeAgo(dateString) { const seconds=Math.floor((new Date()-new Date(dateString))/1000); let interval=seconds/31536000; if(interval>1)return Math.floor(interval)+' years ago'; interval=seconds/2592000; if(interval>1)return Math.floor(interval)+' months ago'; interval=seconds/86400; if(interval>1)return Math.floor(interval)+' days ago'; interval=seconds/3600; if(interval>1)return Math.floor(interval)+' hours ago'; interval=seconds/60; if(interval>1)return Math.floor(interval)+' minutes ago'; return Math.floor(seconds)+' seconds ago'; }
    function truncate(str,length=60){ if(!str)return ''; str=String(str); return str.length<=length?str:str.substring(0,length).trim()+'...'; }
    const scrollToTopBtn=document.createElement('button'); scrollToTopBtn.className='btn btn-primary rounded-circle position-fixed bottom-0 end-0 m-4 shadow'; scrollToTopBtn.style.cssText='width:50px;height:50px;display:none;z-index:999;'; scrollToTopBtn.innerHTML='<i class="fas fa-arrow-up"></i>'; document.body.appendChild(scrollToTopBtn); document.addEventListener('scroll',()=>scrollToTopBtn.style.display=window.pageYOffset>300?'block':'none'); scrollToTopBtn.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));

    /* Message page: floating up/down scroll controls for the conversation. */
    (function(){
        function setupChatScroll(){
            const box=document.querySelector('.messages');
            if(!box || document.getElementById('blogify-chat-scroll-controls')) return;
            const style=document.createElement('style'); style.id='blogify-chat-scroll-style'; style.textContent=`#blogify-chat-scroll-controls{position:absolute;right:14px;bottom:78px;display:flex;flex-direction:column;gap:7px;z-index:25;pointer-events:none}#blogify-chat-scroll-controls button{width:38px;height:38px;border:1px solid rgba(0,0,0,.10);border-radius:50%;background:rgba(255,255,255,.94);color:#303039;box-shadow:0 5px 18px rgba(0,0,0,.14);display:grid;place-items:center;cursor:pointer;pointer-events:auto;opacity:0;visibility:hidden;transform:scale(.9);transition:opacity .16s ease,visibility .16s ease,transform .16s ease}#blogify-chat-scroll-controls button.show{opacity:1;visibility:visible;transform:scale(1)}#blogify-chat-scroll-controls button:hover{background:#f1f1f4}@media(max-width:600px){#blogify-chat-scroll-controls{right:8px;bottom:74px}#blogify-chat-scroll-controls button{width:36px;height:36px}}`;
            document.head.appendChild(style);
            const controls=document.createElement('div'); controls.id='blogify-chat-scroll-controls'; controls.innerHTML='<button type="button" id="chatScrollUp" aria-label="Scroll messages up"><i class="fas fa-chevron-up"></i></button><button type="button" id="chatScrollDown" aria-label="Scroll messages down"><i class="fas fa-chevron-down"></i></button>'; box.parentElement.appendChild(controls);
            const up=document.getElementById('chatScrollUp'),down=document.getElementById('chatScrollDown');
            function refresh(){const max=Math.max(0,box.scrollHeight-box.clientHeight),top=box.scrollTop;up.classList.toggle('show',top>100);down.classList.toggle('show',max-top>100)}
            up.addEventListener('click',()=>box.scrollBy({top:-Math.max(280,box.clientHeight*.75),behavior:'smooth'})); down.addEventListener('click',()=>box.scrollBy({top:Math.max(280,box.clientHeight*.75),behavior:'smooth'})); box.addEventListener('scroll',refresh,{passive:true}); new ResizeObserver(refresh).observe(box); refresh();
        }
        if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',setupChatScroll); else setupChatScroll(); new MutationObserver(setupChatScroll).observe(document.body,{childList:true,subtree:true});
    })();

    window.toggleFollow=async function(userId,buttonElement){ if(!userId){notify.error('Invalid user');return;} buttonElement.disabled=true; try{const {data}=await axios.post(`/follow/${userId}/follow`); if(data.success){buttonElement.innerHTML=data.following?'<i class="fas fa-user-check"></i> Following':'<i class="fas fa-user-plus"></i> Follow'; buttonElement.classList.toggle('btn-success',data.following); buttonElement.classList.toggle('btn-outline-primary',!data.following); notify.success(data.message);}else notify.error(data.message||'Action failed');}catch(err){console.error('Follow Error:',err);notify.error(err.response?.data?.message||'Failed to follow user');}finally{buttonElement.disabled=false;} };
    function showLoader(){const loader=document.createElement('div');loader.className='spinner-border text-primary position-fixed';loader.style.cssText='top:50%;left:50%;transform:translate(-50%,-50%);z-index:9999;';loader.id='globalLoader';document.body.appendChild(loader);}
    function hideLoader(){document.getElementById('globalLoader')?.remove();}
    window.confirmAction=function(message){return new Promise(resolve=>{document.getElementById('confirmModal')?.remove();document.body.insertAdjacentHTML('beforeend',`<div class="modal fade" id="confirmModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Confirm Action</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">${message}</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-danger" id="confirmYesBtn">Yes, Proceed</button></div></div></div></div>`); const modal=new bootstrap.Modal(document.getElementById('confirmModal')); modal.show(); document.getElementById('confirmYesBtn').addEventListener('click',()=>{resolve(true);modal.hide();}); document.getElementById('confirmModal').addEventListener('hidden.bs.modal',()=>{resolve(false);document.getElementById('confirmModal')?.remove();});});};
    document.addEventListener('click',(event)=>{const settingsTrigger=event.target.closest('#settingsBtn, #mobileSettings'); if(settingsTrigger){event.preventDefault();window.location.href='/user/profile/settings';}});

    /* Profile three-dot menu: one reliable full-width bottom action sheet. */
    (function(){
        const style=document.createElement('style'); style.id='blogify-profile-sheet-style'; style.textContent=`#profileMenu.blogify-sheet{position:fixed!important;left:0!important;right:0!important;bottom:0!important;top:auto!important;width:100vw!important;max-width:none!important;box-sizing:border-box!important;margin:0!important;padding:10px 12px calc(12px + env(safe-area-inset-bottom))!important;background:var(--card,#fff)!important;color:var(--text,#182033)!important;border:0!important;border-top:1px solid var(--line,#e7eaf1)!important;border-radius:22px 22px 0 0!important;box-shadow:0 -18px 55px rgba(0,0,0,.22)!important;z-index:2147483001!important;display:block!important;visibility:hidden!important;opacity:0!important;transform:translateY(105%)!important;pointer-events:none!important;max-height:82vh!important;overflow-y:auto!important;transition:transform .24s ease,opacity .2s ease!important}#profileMenu.blogify-sheet.open{visibility:visible!important;opacity:1!important;transform:translateY(0)!important;pointer-events:auto!important}#profileMenu.blogify-sheet::before{content:'';display:block!important;width:42px!important;height:5px!important;border-radius:99px!important;background:#c9ced8!important;margin:2px auto 10px!important}#profileMenu.blogify-sheet button,#profileMenu.blogify-sheet a{appearance:none!important;-webkit-appearance:none!important;width:100%!important;min-height:52px!important;box-sizing:border-box!important;margin:2px 0!important;padding:13px 14px!important;border:0!important;border-radius:12px!important;background:transparent!important;color:var(--text,#182033)!important;text-decoration:none!important;text-align:left!important;display:flex!important;align-items:center!important;gap:12px!important;cursor:pointer!important;font-family:inherit!important;font-size:16px!important;font-weight:700!important;line-height:1.25!important;opacity:1!important;visibility:visible!important}#profileMenu.blogify-sheet button i,#profileMenu.blogify-sheet a i{display:inline-flex!important;width:24px!important;min-width:24px!important;justify-content:center!important;color:currentColor!important;opacity:1!important;visibility:visible!important}#profileMenu.blogify-sheet button:hover,#profileMenu.blogify-sheet a:hover,#profileMenu.blogify-sheet button:active,#profileMenu.blogify-sheet a:active{background:var(--soft,#efedff)!important}#profileMenu.blogify-sheet .danger{color:var(--danger,#e5484d)!important}#blogify-profile-sheet-backdrop{position:fixed!important;inset:0!important;width:100vw!important;height:100vh!important;background:rgba(0,0,0,.45)!important;z-index:2147483000!important;opacity:0!important;visibility:hidden!important;pointer-events:none!important;transition:opacity .2s ease!important}#blogify-profile-sheet-backdrop.open{opacity:1!important;visibility:visible!important;pointer-events:auto!important}body.blogify-sheet-open{overflow:hidden!important}`;
        document.head.appendChild(style);
        function parts(){return {menu:document.getElementById('profileMenu'),trigger:document.getElementById('moreBtn')}} function backdrop(){let b=document.getElementById('blogify-profile-sheet-backdrop');if(!b){b=document.createElement('div');b.id='blogify-profile-sheet-backdrop';document.body.appendChild(b);b.addEventListener('click',close)}return b} function open(){const {menu,trigger}=parts();if(!menu)return;const b=backdrop();menu.classList.add('blogify-sheet','open');menu.setAttribute('aria-hidden','false');trigger?.setAttribute('aria-expanded','true');b.classList.add('open');document.body.classList.add('blogify-sheet-open')} function close(){const {menu,trigger}=parts();if(!menu)return;menu.classList.remove('open');menu.setAttribute('aria-hidden','true');trigger?.setAttribute('aria-expanded','false');document.getElementById('blogify-profile-sheet-backdrop')?.classList.remove('open');document.body.classList.remove('blogify-sheet-open')}
        window.closeProfileSheet=close; window.toggleMenu=function(event){event?.preventDefault();event?.stopPropagation();if(document.getElementById('profileMenu')?.classList.contains('open'))close();else open()}; document.addEventListener('click',function(event){const trigger=event.target.closest('#moreBtn');if(trigger){event.preventDefault();event.stopImmediatePropagation();window.toggleMenu(event)}},true); document.addEventListener('keydown',e=>{if(e.key==='Escape')close()}); document.addEventListener('click',e=>{if(e.target.closest('#profileMenu')){if(e.target.closest('button,a'))setTimeout(close,0)}});
    })();

    /* Message page: Reply + Forward. */
    (function(){
      function setup(){
        const sheet=document.getElementById('actionSheet'),messages=document.getElementById('messages');
        if(!sheet||!messages||sheet.dataset.replyForwardReady==='1') return !!sheet;
        sheet.dataset.replyForwardReady='1';
        const close=()=>{document.getElementById('overlay')?.classList.remove('open');sheet.classList.remove('open');document.body.style.overflow=''};
        const row=document.createElement('div'); row.innerHTML='<button class="action" id="replyAction"><i class="fas fa-reply"></i> Reply</button><button class="action" id="forwardAction"><i class="fas fa-share"></i> Forward</button>';
        const edit=document.getElementById('editAction'); edit?.parentNode.insertBefore(row,edit);
        let selected=null;
        messages.addEventListener('pointerdown',e=>{const r=e.target.closest('.row[data-message]');if(r)selected=r.dataset.message},{capture:true});
        document.addEventListener('contextmenu',e=>{const r=e.target.closest('.row[data-message]');if(r)selected=r.dataset.message});
        function getMessage(){return (window.__messages||[]).find(m=>String(m._id)===String(selected))}
        function quoteText(m){if(!m)return '';if(m.deleted)return 'Message unsent';if(m.text)return m.text;return m.mediaType==='video'?'Video':m.mediaType==='image'?'Photo':m.mediaType==='profile'?'Shared profile':'Message'}
        function addReplyPreview(m){let bar=document.getElementById('replyBar');if(!bar){bar=document.createElement('div');bar.id='replyBar';bar.innerHTML='<i class="fas fa-reply"></i><div><strong>Replying to <span id="replyName">message</span></strong><small id="replyQuote"></small></div><button type="button" id="cancelReply">×</button>';const anchor=document.getElementById('editBar');anchor?.parentNode.insertBefore(bar,anchor);const st=document.createElement('style');st.textContent='#replyBar{display:flex;align-items:center;gap:10px;padding:8px 11px;border-top:1px solid var(--line);background:#f3f1ff;color:#554ad8;font-size:.72rem}#replyBar>div{min-width:0;flex:1}#replyBar small{display:block;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}#replyBar button{border:0;background:transparent;color:inherit;font-size:1.2rem;cursor:pointer}';document.head.appendChild(st);document.getElementById('cancelReply').onclick=()=>{window.__replyTo=null;bar.style.display='none'}}window.__replyTo=m._id;bar.style.display='flex';document.getElementById('replyName').textContent=m.senderId?.fullName||'message';document.getElementById('replyQuote').textContent=quoteText(m);document.getElementById('input')?.focus()}
        document.getElementById('replyAction').onclick=()=>{const m=getMessage();if(m){addReplyPreview(m);close()}};
        document.getElementById('forwardAction').onclick=async()=>{const m=getMessage();if(!m)return;close();openForward(m)};
        async function openForward(message){let modal=document.getElementById('forwardModal');if(!modal){modal=document.createElement('div');modal.id='forwardModal';modal.innerHTML='<div class="forward-card"><div class="forward-head"><strong>Forward message</strong><button id="forwardClose">×</button></div><div class="forward-preview" id="forwardPreview"></div><input id="forwardSearch" placeholder="Search chats…"><div id="forwardList" class="forward-list"><div class="forward-loading">Loading chats…</div></div></div>';document.body.appendChild(modal);const st=document.createElement('style');st.textContent='#forwardModal{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:2147483640;display:grid;place-items:end center}#forwardModal .forward-card{width:min(560px,100%);max-height:82dvh;background:#fff;border-radius:22px 22px 0 0;padding:14px;box-shadow:0 -20px 60px rgba(0,0,0,.2);display:flex;flex-direction:column;gap:10px}#forwardModal .forward-head{display:flex;justify-content:space-between;align-items:center;font-size:1rem}#forwardModal .forward-head button{border:0;background:#f1f1f3;border-radius:50%;width:34px;height:34px;font-size:1.2rem;cursor:pointer}#forwardSearch{border:1px solid #dddde2;background:#f5f5f7;border-radius:12px;padding:11px 13px;outline:0}.forward-preview{font-size:.75rem;color:#666;padding:8px 10px;background:#f5f5f7;border-radius:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.forward-list{overflow:auto;min-height:100px}.forward-user{width:100%;display:flex;align-items:center;gap:10px;border:0;background:transparent;padding:10px 6px;border-radius:12px;text-align:left;cursor:pointer}.forward-user:hover{background:#f3f3f5}.forward-user img{width:42px;height:42px;border-radius:50%;object-fit:cover}.forward-user strong{display:block}.forward-user small{color:#777}.forward-loading{text-align:center;color:#777;padding:30px}';document.head.appendChild(st);document.getElementById('forwardClose').onclick=()=>modal.remove();modal.addEventListener('click',e=>{if(e.target===modal)modal.remove()})}document.getElementById('forwardPreview').textContent=quoteText(message);const list=document.getElementById('forwardList');try{const r=await fetch('/messages/history',{credentials:'same-origin',headers:{Accept:'application/json'}}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to load chats');const users=(d.conversations||[]).map(c=>(c.participants||[]).find(p=>String(p._id)!==String(CURRENT))).filter(Boolean);renderUsers(users,message);document.getElementById('forwardSearch').oninput=e=>{const q=e.target.value.toLowerCase();renderUsers(users.filter(u=>(u.fullName||'').toLowerCase().includes(q)),message)}}catch(e){list.innerHTML='<div class="forward-loading">'+String(e.message||'Unable to load chats').replace(/[<>&]/g,'')+'</div>'}}
        function renderUsers(users,message){const list=document.getElementById('forwardList');list.innerHTML=users.length?users.map(u=>'<button class="forward-user" data-user="'+String(u._id).replace(/[^a-zA-Z0-9_-]/g,'')+'"><img src="'+String(u.profileImageURL||'/imgs/default.png').replace(/"/g,'&quot;')+'"><span><strong>'+String(u.fullName||'User').replace(/[<>&]/g,'')+'</strong><small>Send this message</small></span></button>').join(''):'<div class="forward-loading">No chats found.</div>';list.querySelectorAll('.forward-user').forEach(b=>b.onclick=()=>forwardTo(b.dataset.user,message))}
        async function forwardTo(recipientId,message){try{const r=await fetch('/messages/conversation',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({userId:recipientId})}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to open chat');const s=io();s.emit('conversation:join',d.conversationId);setTimeout(()=>{s.emit('message:send',{conversationId:d.conversationId,text:message.deleted?'':(message.text||''),mediaUrl:message.mediaUrl||'',mediaType:message.mediaType||'',profileShareId:message.profileShareId?._id||message.profileShareId||null});setTimeout(()=>s.disconnect(),700)},100);document.getElementById('forwardModal')?.remove();notify.success('Message forwarded')}catch(e){notify.error(e.message||'Unable to forward message')}}
        document.addEventListener('submit',e=>{if(!window.__replyTo||!e.target.matches('#composer'))return;const input=document.getElementById('input'),text=input?.value.trim();if(!text)return;e.preventDefault();e.stopImmediatePropagation();const target=new URLSearchParams(location.search).get('user');if(!target){notify.error('Unable to reply');return}(async()=>{try{const r=await fetch('/messages/conversation',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({userId:target})}),d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to open chat');const s=io();s.emit('conversation:join',d.conversationId);setTimeout(()=>{s.emit('message:send',{conversationId:d.conversationId,text,replyTo:window.__replyTo});setTimeout(()=>s.disconnect(),700)},100);input.value='';input.dispatchEvent(new Event('input'));document.getElementById('replyBar').style.display='none';window.__replyTo=null;notify.success('Reply sent')}catch(err){notify.error(err.message||'Unable to reply')}})()},true);
      }
      const timer=setInterval(()=>{if(setup())clearInterval(timer)},250); if(document.readyState!=='loading')setup();else document.addEventListener('DOMContentLoaded',setup);
    })();

    (function(){ const saved=document.documentElement.dataset.theme || localStorage.getItem('blogify-theme'); const theme=saved || 'system'; const dark=theme==='dark' || (theme==='system' && window.matchMedia('(prefers-color-scheme: dark)').matches); document.documentElement.dataset.theme=dark?'dark':'light'; if(theme==='system') window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',e=>document.documentElement.dataset.theme=e.matches?'dark':'light'); })();
</script>