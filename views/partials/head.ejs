<!-- views/partials/head.ejs -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : 'Blogify' %></title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.css" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}:root{--primary:#6366f1;--primary-dark:#4f46e5;--secondary:#764ba2;--dark:#0f172a;--light:#f8fafc;--muted:#64748b;--border:#e2e8f0;--page:#fff;--surface:#fff;--soft:#f8fafc;--text:#1e293b;--heading:#0f172a;--input:#fff;--shadow:rgba(0,0,0,.08)}
html{scroll-behavior:smooth}html[data-theme="dark"]{color-scheme:dark;--page:#0b0c10;--surface:#15171d;--soft:#1d2028;--text:#e5e7eb;--heading:#f8fafc;--muted:#a1a8b3;--border:#30343d;--input:#171a20;--shadow:rgba(0,0,0,.35)}
body{margin-top:30px;font-family:'Inter',sans-serif;background:var(--page);color:var(--text);transition:background-color .25s ease,color .25s ease}.text-body{color:var(--text)!important}.text-dark{color:var(--heading)!important}.bg-white{background-color:var(--surface)!important}.bg-light{background-color:var(--soft)!important}
.card,.modal-content,.dropdown-menu,.list-group-item,.offcanvas,.popover,.accordion-item{background-color:var(--surface);color:var(--text);border-color:var(--border)}
.card{border:1px solid var(--border);border-radius:12px;transition:all .3s ease;box-shadow:0 2px 8px var(--shadow)}.card:hover{transform:translateY(-4px);box-shadow:0 12px 24px var(--shadow)}
.navbar{background:rgba(255,255,255,.95)!important;backdrop-filter:blur(12px);box-shadow:0 2px 15px var(--shadow);padding:1rem 0}.nav-link{font-weight:500;color:#475569!important}.navbar-brand{font-weight:700;font-size:1.5rem;color:var(--primary)!important}.navbar-toggler{border-color:var(--border)}
html[data-theme="dark"] .navbar{background:rgba(15,17,23,.96)!important}.navbar .text-dark{color:var(--text)!important}
.form-control,.form-select{border:2px solid var(--border);border-radius:8px;padding:.75rem 1rem;font-weight:500;background-color:var(--input);color:var(--text);transition:all .3s ease}.form-control::placeholder{color:var(--muted)}.form-control:focus,.form-select:focus{background-color:var(--input);color:var(--text);border-color:var(--primary);box-shadow:0 0 0 4px rgba(99,102,241,.15);outline:none}
.form-label{font-weight:600;color:var(--heading);margin-bottom:.5rem}.text-muted{color:var(--muted)!important}.border,.border-top,.border-bottom{border-color:var(--border)!important}.shadow-sm{box-shadow:0 2px 8px var(--shadow)!important}.shadow{box-shadow:0 4px 12px var(--shadow)!important}.shadow-lg{box-shadow:0 12px 24px var(--shadow)!important}
.btn-light{background:var(--surface);border-color:var(--border);color:var(--text)}.btn-light:hover{background:var(--soft);color:var(--text)}.btn-close{filter:none}html[data-theme="dark"] .btn-close{filter:invert(1) grayscale(100%) brightness(200%)}
.blog-card{border-radius:12px;overflow:hidden;width:100%;transition:all .3s ease}.blog-card-image{height:200px;object-fit:cover;transition:transform .3s ease}.badge{padding:.4rem .8rem;border-radius:20px;font-weight:600;font-size:.75rem}.spinner-border{color:var(--primary)}
@media(max-width:768px){.navbar{padding:.8rem 0}.navbar-brand{font-size:1.3rem}.display-4{font-size:2rem}.blog-card-image{height:150px}}
@keyframes slideIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}.animate-in{animation:slideIn .3s ease-out}#toast-container>div{border-radius:8px;font-weight:500}

/* Blogify DM / message.ejs refresh */
.chat-page{background:radial-gradient(circle at 15% 10%,rgba(99,102,241,.10),transparent 32%),radial-gradient(circle at 90% 90%,rgba(118,75,162,.09),transparent 34%);padding:18px!important}
.chat-page .chat{border:1px solid rgba(99,102,241,.14)!important;border-radius:26px!important;box-shadow:0 24px 80px rgba(15,23,42,.16)!important;background:var(--surface)!important}
.chat-page .head{padding:14px 18px!important;background:color-mix(in srgb,var(--surface) 88%,var(--primary) 12%);backdrop-filter:blur(18px);border-bottom:1px solid var(--border)!important}
.chat-page .back,.chat-page .profile,.chat-page .attach{width:42px!important;height:42px!important;border-radius:14px!important;background:var(--soft)!important;border:1px solid var(--border)!important;transition:.2s ease}
.chat-page .back:hover,.chat-page .profile:hover,.chat-page .attach:hover:not(:disabled){transform:translateY(-1px);background:rgba(99,102,241,.12)!important;color:var(--primary)!important}
.chat-page .avatar{width:48px!important;height:48px!important;border:2px solid var(--surface);box-shadow:0 0 0 2px rgba(99,102,241,.22)}
.chat-page .name{font-size:.98rem;letter-spacing:-.01em}.chat-page .status{font-size:.73rem}.chat-page .status.online{font-weight:700}
.chat-page .messages{padding:26px 22px!important;background:linear-gradient(180deg,var(--soft),var(--page))!important;scrollbar-width:thin}
.chat-page .row{animation:chatIn .18s ease-out}.chat-page .bubble{padding:10px 13px!important;border-radius:20px 20px 20px 6px!important;box-shadow:0 5px 18px rgba(15,23,42,.06)!important}.chat-page .row.mine .bubble{border-radius:20px 20px 6px 20px!important;box-shadow:0 6px 20px rgba(99,102,241,.22)!important}
.chat-page .reaction{width:28px;height:28px;border:1px solid var(--border);transition:.18s ease}.chat-page .reaction:hover{transform:scale(1.1);color:#ef3f72}.chat-page .media{max-width:min(390px,72vw)!important;max-height:440px!important;border:1px solid rgba(255,255,255,.12)}
.chat-page .composer{padding:13px!important;background:var(--surface)!important;gap:9px!important}.chat-page .input-wrap{min-height:48px;border-radius:17px!important;background:var(--soft)!important;border:1px solid var(--border)!important;transition:.2s}.chat-page .input-wrap:focus-within{border-color:var(--primary)!important;box-shadow:0 0 0 4px rgba(99,102,241,.10)}.chat-page .input{padding:13px 4px!important}.chat-page .send{height:48px!important;width:48px!important;border-radius:16px!important;box-shadow:0 8px 18px rgba(99,102,241,.25);transition:.2s}.chat-page .send:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 10px 24px rgba(99,102,241,.34)}
.chat-page .preview{padding:9px 13px!important;background:var(--soft)!important}.chat-page .preview-box{width:58px;height:58px;border-radius:13px}.chat-page .hint{text-align:center;padding-bottom:8px!important}.chat-page .typing{font-weight:600}
@keyframes chatIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
html[data-theme="dark"] .chat-page{background:radial-gradient(circle at 15% 10%,rgba(99,102,241,.16),transparent 32%),radial-gradient(circle at 90% 90%,rgba(118,75,162,.13),transparent 34%)}
html[data-theme="dark"] .chat-page .head{background:color-mix(in srgb,var(--surface) 90%,#6366f1 10%)}
@media(max-width:600px){.chat-page{padding:0!important}.chat-page .chat{border-radius:0!important;box-shadow:none!important}.chat-page .head{padding:11px 12px!important}.chat-page .messages{padding:20px 10px!important}.chat-page .composer{padding:9px!important}.chat-page .avatar{width:44px!important;height:44px!important}.chat-page .bubble{max-width:88%!important}.chat-page .media{max-width:78vw!important}.chat-page .back,.chat-page .profile,.chat-page .attach{width:40px!important;height:40px!important}.chat-page .send{width:46px!important;height:46px!important}}

/* Profile three-dot popup: follow the global Light/Dark theme. */
html[data-theme="dark"] .profile-page .profile-menu-overlay{background:rgba(0,0,0,.72)!important}
html[data-theme="dark"] .profile-page .profile-menu-sheet{background:#111!important;color:#f5f5f5!important;border-color:#2b2b2b!important;box-shadow:0 -20px 70px rgba(0,0,0,.65)!important}
html[data-theme="dark"] .profile-page .profile-sheet-grip{background:#555!important}
html[data-theme="dark"] .profile-page .profile-sheet-header{border-color:#2b2b2b!important}
html[data-theme="dark"] .profile-page .profile-sheet-title{color:#f5f5f5!important}
html[data-theme="dark"] .profile-page .profile-sheet-title i{color:#a9a3ff!important}
html[data-theme="dark"] .profile-page .profile-sheet-close{background:#202020!important;color:#f5f5f5!important}
html[data-theme="dark"] .profile-page .profile-sheet-close:hover{background:#303030!important}
html[data-theme="dark"] .profile-page .profile-sheet-user{background:#181818!important;border-color:#303030!important;color:#f5f5f5!important}
html[data-theme="dark"] .profile-page .profile-sheet-user-info strong{color:#f5f5f5!important}
html[data-theme="dark"] .profile-page .profile-menu-option{color:#f5f5f5!important}
html[data-theme="dark"] .profile-page .profile-menu-option:hover{background:#202020!important}
html[data-theme="dark"] .profile-page .profile-menu-option-icon{background:#211f43!important;color:#a9a3ff!important}
html[data-theme="dark"] .profile-page .profile-menu-option-content strong{color:#f5f5f5!important}
html[data-theme="dark"] .profile-page .profile-menu-option-content span{color:#a3a3a3!important}
html[data-theme="dark"] .profile-page .profile-menu-option-arrow{color:#777!important}
html[data-theme="dark"] .profile-page .profile-menu-option.danger{color:#ff6b70!important}
html[data-theme="dark"] .profile-page .profile-menu-option.danger .profile-menu-option-icon{background:rgba(229,72,77,.16)!important;color:#ff6b70!important}
</style>
<script>(function(){try{const t=localStorage.getItem('blogify-theme')||'system';const d=t==='dark'||(t==='system'&&matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.dataset.theme=d?'dark':'light'}catch(e){}})();</script>

<!-- Global Blogify theme system: every page follows the selected Light/Dark mode. -->
<style id="blogify-global-theme">
html,body{min-height:100%;background:var(--page)!important;color:var(--text)!important}
body{transition:background-color .2s ease,color .2s ease}
html[data-theme="dark"] body{background:#000!important;color:#f5f5f5!important}
html[data-theme="light"] body{background:#fff!important;color:#171717!important}
html[data-theme="dark"] .main-nav{background:rgba(10,10,10,.96)!important;border-bottom-color:#262626!important;box-shadow:0 6px 24px rgba(0,0,0,.35)!important}
html[data-theme="dark"] .nav-brand{color:#f5f5f5!important}
html[data-theme="dark"] .nav-icon-btn,html[data-theme="dark"] .profile-trigger{background:#171717!important;border-color:#303030!important;color:#f5f5f5!important}
html[data-theme="dark"] .profile-dropdown{background:#111!important;border-color:#2c2c2c!important;color:#f5f5f5!important}
html[data-theme="dark"] .profile-item{color:#e5e5e5!important}
html[data-theme="dark"] .profile-item:hover{background:#202020!important;color:#fff!important}
html[data-theme="dark"] .profile-summary small{color:#a3a3a3!important}
html[data-theme="dark"] .dropdown-divider{background:#2a2a2a!important}
html[data-theme="dark"] .dropdown-menu,html[data-theme="dark"] .modal-content,html[data-theme="dark"] .list-group-item,html[data-theme="dark"] .offcanvas{background:#111!important;color:#f5f5f5!important;border-color:#303030!important}
html[data-theme="dark"] .table{--bs-table-bg:#111;--bs-table-color:#e5e5e5;--bs-table-border-color:#303030}
html[data-theme="dark"] .alert-light{background:#1a1a1a!important;color:#e5e5e5!important;border-color:#303030!important}
html[data-theme="dark"] input,html[data-theme="dark"] textarea,html[data-theme="dark"] select{color-scheme:dark}
html[data-theme="dark"] ::-webkit-scrollbar{width:9px;height:9px}html[data-theme="dark"] ::-webkit-scrollbar-track{background:#0b0b0b}html[data-theme="dark"] ::-webkit-scrollbar-thumb{background:#3a3a3a;border-radius:99px}

/* Pages that define their own light variables must still follow the global theme. */
html[data-theme="dark"] .profile-page{background:#000!important;color:#f5f5f5!important}
html[data-theme="dark"] .profile-card,html[data-theme="dark"] .content-card,html[data-theme="dark"] .blog,html[data-theme="dark"] .person,html[data-theme="dark"] .tabs,html[data-theme="dark"] .secondary,html[data-theme="dark"] .more-btn,html[data-theme="dark"] .profile-action-sheet,html[data-theme="dark"] .modal-card{background:#111!important;color:#f5f5f5!important;border-color:#2b2b2b!important}
html[data-theme="dark"] .profile-page .identity h1,html[data-theme="dark"] .profile-page .stat,html[data-theme="dark"] .profile-page .blog h3,html[data-theme="dark"] .profile-page .modal-close{color:#f5f5f5!important}
html[data-theme="dark"] .profile-page .email,html[data-theme="dark"] .profile-page .meta,html[data-theme="dark"] .profile-page .blog p,html[data-theme="dark"] .profile-page .blog-meta,html[data-theme="dark"] .profile-page .stat span,html[data-theme="dark"] .profile-page .person small,html[data-theme="dark"] .profile-page .empty{color:#a3a3a3!important}
html[data-theme="dark"] .profile-page .tabs .tab{color:#a3a3a3!important}
html[data-theme="dark"] .profile-page .tabs .tab.active{background:#211f43!important;color:#a9a3ff!important}
html[data-theme="dark"] .profile-page .badge,html[data-theme="dark"] .profile-page .lock{background:#211f43!important;color:#b8b2ff!important}
html[data-theme="dark"] .profile-page .profile-action-sheet button{color:#f5f5f5!important}
html[data-theme="dark"] .profile-page .share-url{background:#0b0b0b!important;color:#f5f5f5!important;border-color:#303030!important}
html[data-theme="dark"] .profile-page .cover{background:#0b0b0b!important}
</style>
<script id="blogify-theme-manager">
(function(){
  const KEY='blogify-theme';
  function normalize(value){value=String(value||'').toLowerCase();if(value==='dark'||value==='black')return'dark';if(value==='light'||value==='white')return'light';return'system'}
  function apply(value,save){const mode=normalize(value);const dark=mode==='dark'||(mode==='system'&&window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.dataset.theme=dark?'dark':'light';document.documentElement.dataset.themeMode=mode;document.body&&document.body.classList.toggle('dark-mode',dark);if(save){try{localStorage.setItem(KEY,mode);localStorage.setItem('theme',mode)}catch(e){}}window.dispatchEvent(new CustomEvent('blogify:themechange',{detail:{mode,theme:dark?'dark':'light'}}))}
  let saved='system';try{saved=localStorage.getItem(KEY)||localStorage.getItem('theme')||localStorage.getItem('appearance')||'system'}catch(e){}apply(saved,false);
  window.BlogifyTheme={get:function(){return document.documentElement.dataset.themeMode||'system'},set:function(mode){apply(mode,true)},toggle:function(){apply(document.documentElement.dataset.theme==='dark'?'light':'dark',true)}};
  const media=window.matchMedia?matchMedia('(prefers-color-scheme: dark)'):null;if(media){const fn=function(){let mode='system';try{mode=localStorage.getItem(KEY)||'system'}catch(e){}if(normalize(mode)==='system')apply('system',false)};media.addEventListener?media.addEventListener('change',fn):media.addListener(fn)}
  window.addEventListener('storage',function(e){if(e.key===KEY||e.key==='theme'||e.key==='appearance')apply(e.newValue||'system',false)});
  const observer=new MutationObserver(function(){const hasDark=document.body&&document.body.classList.contains('dark-mode');const current=document.documentElement.dataset.theme==='dark';if(hasDark!==current&&document.documentElement.dataset.themeMode!=='system')document.documentElement.dataset.theme=hasDark?'dark':'light'});if(document.body)observer.observe(document.body,{attributes:true,attributeFilter:['class']});
  document.addEventListener('DOMContentLoaded',function(){apply(saved,false)});
})();
</script>
