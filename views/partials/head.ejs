<!-- views/partials/head.ejs -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : 'Blogify' %></title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.css" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}:root{--primary:#6366f1;--primary-dark:#4f46e5;--secondary:#764ba2;--dark:#0f172a;--light:#f8fafc;--muted:#64748b;--border:#e2e8f0;--page:#fff;--surface:#fff;--soft:#f8fafc;--text:#1e293b;--heading:#0f172a;--input:#fff;--shadow:rgba(0,0,0,.08)}
html{scroll-behavior:smooth}html[data-theme="dark"]{color-scheme:dark;--page:#0b0c10;--surface:#15171d;--soft:#1d2028;--text:#e5e7eb;--heading:#f8fafc;--muted:#a1a8b3;--border:#30343d;--input:#171a20;--shadow:rgba(0,0,0,.35)}
body{margin-top:30px;font-family:'Inter',sans-serif;background:var(--page);color:var(--text);transition:background-color .25s ease,color .25s ease}.text-body{color:var(--text)!important}.text-dark{color:var(--heading)!important}.bg-white{background-color:var(--surface)!important}.bg-light{background-color:var(--soft)!important}
.card,.modal-content,.dropdown-menu,.list-group-item,.offcanvas,.popover,.accordion-item{background-color:var(--surface);color:var(--text);border-color:var(--border)}
.card{border:1px solid var(--border);border-radius:12px;transition:all .3s ease;box-shadow:0 2px 8px var(--shadow)}.card:hover{transform:translateY(-4px);box-shadow:0 12px 24px var(--shadow)}
.navbar{background:rgba(255,255,255,.95)!important;backdrop-filter:blur(12px);box-shadow:0 2px 15px var(--shadow);padding:1rem 0}.nav-link{font-weight:500;color:#475569!important}.navbar-brand{font-weight:700;font-size:1.5rem;color:var(--primary)!important}.navbar-toggler{border-color:var(--border)}
html[data-theme="dark"] .navbar{background:rgba(15,17,23,.96)!important}.navbar .text-dark{color:var(--text)!important}
.form-control,.form-select{border:2px solid var(--border);border-radius:8px;padding:.75rem 1rem;font-weight:500;background-color:var(--input);color:var(--text);transition:all .3s ease}.form-control::placeholder{color:var(--muted)}.form-control:focus,.form-select:focus{background-color:var(--input);color:var(--text);border-color:var(--primary);box-shadow:0 0 0 4px rgba(99,102,241,.15);outline:none}
.form-label{font-weight:600;color:var(--heading);margin-bottom:.5rem}.text-muted{color:var(--muted)!important}.border,.border-top,.border-bottom{border-color:var(--border)!important}.shadow-sm{box-shadow:0 2px 8px var(--shadow)!important}.shadow{box-shadow:0 4px 12px var(--shadow)!important}.shadow-lg{box-shadow:0 12px 24px var(--shadow)!important}
.btn-light{background:var(--surface);border-color:var(--border);color:var(--text)}.btn-light:hover{background:var(--soft);color:var(--text)}.btn-close{filter:none}html[data-theme="dark"] .btn-close{filter:invert(1) grayscale(100%) brightness(200%)}
.blog-card{border-radius:12px;overflow:hidden;width:100%;transition:all .3s ease}.blog-card-image{height:200px;object-fit:cover;transition:transform .3s ease}.badge{padding:.4rem .8rem;border-radius:20px;font-weight:600;font-size:.75rem}.spinner-border{color:var(--primary)}
@media(max-width:768px){.navbar{padding:.8rem 0}.navbar-brand{font-size:1.3rem}.display-4{font-size:2rem}.blog-card-image{height:150px}}
@keyframes slideIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}.animate-in{animation:slideIn .3s ease-out}#toast-container>div{border-radius:8px;font-weight:500}
</style>
<script>(function(){try{const t=localStorage.getItem('blogify-theme')||'system';const d=t==='dark'||(t==='system'&&matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.dataset.theme=d?'dark':'light'}catch(e){}})();</script>
