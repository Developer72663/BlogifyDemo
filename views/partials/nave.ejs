<nav class="main-nav" id="mainNav">
  <div class="nav-container">
    <a href="/" class="nav-brand"><span class="brand-mark">B</span><span>Blogify</span></a>
    <% if (locals.user) { %>
      <div class="nav-actions">
        <a href="/blogs/add-new" class="nav-add-blog" aria-label="Add Blog" title="Add Blog"><i class="fas fa-plus"></i><span>Add Blog</span></a>
        <a href="/notifications" class="nav-icon-btn" aria-label="Notifications" title="Notifications"><i class="far fa-bell"></i><span class="nav-badge" id="notificationBadge" style="display:none"><span id="notificationCount">0</span></span></a>
        <div class="profile-menu" id="profileMenu">
          <button class="profile-trigger" id="profileTrigger" type="button" aria-expanded="false">
            <img src="<%= locals.user.profileImageURL || '/imgs/default.png' %>" alt="<%= locals.user.fullName %>" onerror="this.src='/imgs/default.png';">
            <span class="profile-name"><%= locals.user.fullName %></span><i class="fas fa-chevron-down profile-chevron"></i>
          </button>
          <div class="profile-dropdown" id="profileDropdown">
            <div class="profile-summary"><img src="<%= locals.user.profileImageURL || '/imgs/default.png' %>" alt="<%= locals.user.fullName %>" onerror="this.src='/imgs/default.png';"><div><strong><%= locals.user.fullName %></strong><small><%= locals.user.email %></small></div></div>
            <div class="dropdown-divider"></div>
            <a href="/user/profile" class="profile-item"><span class="menu-icon profile-icon"><i class="fas fa-user"></i></span><span>Profile</span></a>
            <a href="/notifications" class="profile-item"><span class="menu-icon notification-icon"><i class="fas fa-bell"></i></span><span>Notifications</span></a>
            <a href="/user/profile/settings" class="profile-item"><span class="menu-icon settings-icon"><i class="fas fa-cog"></i></span><span>Settings</span></a>
            <div class="dropdown-divider"></div>
            <a href="/user/logout" class="profile-item logout-item"><span class="menu-icon logout-icon"><i class="fas fa-right-from-bracket"></i></span><span>Logout</span></a>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</nav>
<style>
.main-nav{position:fixed;top:0;left:0;right:0;z-index:1100;background:rgba(255,255,255,.92);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-bottom:1px solid #e8eaf0;box-shadow:0 6px 24px rgba(15,23,42,.06)}
.nav-container{height:70px;max-width:1280px;margin:auto;padding:0 22px;display:flex;align-items:center;justify-content:space-between}.nav-brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-size:1.35rem;font-weight:800;color:#111827}.brand-mark{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,#6366f1,#8b5cf6);box-shadow:0 7px 18px rgba(99,102,241,.28)}
.nav-actions{display:flex;align-items:center;gap:10px}.nav-add-blog{height:42px;padding:0 15px;display:flex;align-items:center;gap:8px;border-radius:12px;background:linear-gradient(135deg,#6366f1,#7c3aed);color:#fff;text-decoration:none;font-size:.88rem;font-weight:700;box-shadow:0 7px 18px rgba(99,102,241,.22);transition:.2s}.nav-add-blog:hover{color:#fff;transform:translateY(-1px);box-shadow:0 10px 22px rgba(99,102,241,.3)}.nav-add-blog i{font-size:.8rem}.nav-icon-btn{position:relative;width:42px;height:42px;border:1px solid #e5e7eb;border-radius:12px;background:#fff;color:#4b5563;display:grid;place-items:center;text-decoration:none;transition:.2s}.nav-icon-btn:hover{color:#6366f1;border-color:#c7d2fe;transform:translateY(-1px)}.nav-badge{position:absolute;top:5px;right:5px;width:8px;height:8px;border-radius:50%;background:#ef4444;border:2px solid #fff}.nav-badge span{display:none}
.profile-menu{position:relative}.profile-trigger{display:flex;align-items:center;gap:10px;padding:5px 9px 5px 5px;border:1px solid #e5e7eb;border-radius:14px;background:#fff;color:#111827;cursor:pointer;transition:.2s}.profile-trigger:hover,.profile-trigger[aria-expanded=true]{border-color:#c7d2fe;box-shadow:0 5px 18px rgba(99,102,241,.12)}.profile-trigger img{width:34px;height:34px;border-radius:10px;object-fit:cover}.profile-name{font-weight:650;max-width:150px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.profile-chevron{font-size:.7rem;color:#9ca3af;transition:transform .2s}.profile-trigger[aria-expanded=true] .profile-chevron{transform:rotate(180deg)}
.profile-dropdown{position:absolute;right:0;top:calc(100% + 10px);width:280px;padding:8px;background:#fff;border:1px solid #e5e7eb;border-radius:16px;box-shadow:0 18px 45px rgba(15,23,42,.14);opacity:0;visibility:hidden;transform:translateY(-7px) scale(.98);transition:.18s;transform-origin:top right}.profile-dropdown.open{opacity:1;visibility:visible;transform:translateY(0) scale(1)}.profile-summary{display:flex;align-items:center;gap:11px;padding:12px}.profile-summary img{width:42px;height:42px;border-radius:12px;object-fit:cover}.profile-summary div{min-width:0}.profile-summary strong,.profile-summary small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.profile-summary strong{font-size:.92rem;color:#111827}.profile-summary small{font-size:.75rem;color:#6b7280;margin-top:2px}.dropdown-divider{height:1px;background:#eef0f4;margin:6px 4px}.profile-item{display:flex;align-items:center;gap:11px;padding:10px;border-radius:11px;text-decoration:none;color:#374151;font-size:.9rem;font-weight:550;transition:.15s}.profile-item:hover{background:#f5f7ff;color:#4f46e5}.menu-icon{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-size:.85rem}.profile-icon{background:#eef2ff;color:#4f46e5}.notification-icon{background:#f3e8ff;color:#9333ea}.settings-icon{background:#f1f5f9;color:#475569}.logout-icon{background:#fef2f2;color:#dc2626}.logout-item{color:#dc2626}.logout-item:hover{background:#fff1f2;color:#b91c1c}
@media(max-width:600px){.nav-container{height:62px;padding:0 14px}.profile-name{display:none}.profile-trigger{padding-right:7px}.profile-dropdown{right:-4px;width:min(280px,calc(100vw - 28px))}.nav-brand{font-size:1.15rem}.brand-mark{width:34px;height:34px}.nav-icon-btn{width:40px;height:40px}.nav-add-blog{width:40px;height:40px;padding:0;justify-content:center;border-radius:12px}.nav-add-blog span{display:none}}
body.dark-mode .main-nav{background:rgba(15,23,42,.94);border-color:#263244}.dark-mode .nav-brand,.dark-mode .profile-trigger{color:#f8fafc}.dark-mode .nav-icon-btn,.dark-mode .profile-trigger,.dark-mode .profile-dropdown{background:#111827;border-color:#263244;color:#f8fafc}.dark-mode .profile-summary strong{color:#f8fafc}.dark-mode .profile-summary small{color:#94a3b8}.dark-mode .dropdown-divider{background:#263244}.dark-mode .profile-item{color:#cbd5e1}.dark-mode .profile-item:hover{background:#1e293b}.dark-mode .nav-badge{border-color:#111827}
</style>
<script>
(function(){const t=document.getElementById('profileTrigger'),d=document.getElementById('profileDropdown');if(!t||!d)return;const close=()=>{t.setAttribute('aria-expanded','false');d.classList.remove('open')};t.addEventListener('click',e=>{e.stopPropagation();const o=d.classList.toggle('open');t.setAttribute('aria-expanded',String(o))});document.addEventListener('click',e=>{if(!e.target.closest('#profileMenu'))close()});document.addEventListener('keydown',e=>{if(e.key==='Escape')close()})})();
</script>
