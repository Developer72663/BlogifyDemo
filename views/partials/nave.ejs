<nav class="main-nav" id="mainNav"><div class="nav-container"><a href="/" class="nav-brand"><span class="brand-mark">B</span><span>Blogify</span></a><% if (locals.user) { %><div class="nav-actions"><a href="/blogs/add-new" class="nav-add-blog" aria-label="Add Blog" title="Add Blog"><i class="fas fa-plus"></i><span>Add Blog</span></a><a href="/messages/chatlog" class="nav-icon-btn" aria-label="Messages" title="Messages"><i class="far fa-comment-dots"></i><span class="nav-badge" id="messageBadge" style="display:none"><span id="messageCount">0</span></span></a><a href="/notifications" class="nav-icon-btn" aria-label="Notifications" title="Notifications"><i class="far fa-bell"></i><span class="nav-badge" id="notificationBadge" style="display:none"><span id="notificationCount">0</span></span></a><div class="profile-menu" id="profileMenu"><button class="profile-trigger" id="profileTrigger" type="button" aria-expanded="false"><img src="<%= locals.user.profileImageURL || '/imgs/default.png' %>" alt="<%= locals.user.fullName %>" onerror="this.src='/imgs/default.png';"><span class="profile-name"><%= locals.user.fullName %></span><i class="fas fa-chevron-down profile-chevron"></i></button><div class="profile-dropdown" id="profileDropdown"><div class="profile-summary"><img src="<%= locals.user.profileImageURL || '/imgs/default.png' %>" alt="<%= locals.user.fullName %>" onerror="this.src='/imgs/default.png';"><div><strong><%= locals.user.fullName %></strong><small><%= locals.user.email %></small></div></div><div class="dropdown-divider"></div><a href="/user/profile" class="profile-item"><span class="menu-icon profile-icon"><i class="fas fa-user"></i></span><span>Profile</span></a><a href="/messages/chatlog" class="profile-item"><span class="menu-icon message-icon"><i class="fas fa-comment-dots"></i></span><span>Messages <b id="dropdownMessageCount" class="dropdown-count" style="display:none">0</b></span></a><a href="/notifications" class="profile-item"><span class="menu-icon notification-icon"><i class="fas fa-bell"></i></span><span>Notifications <b id="dropdownNotificationCount" class="dropdown-count" style="display:none">0</b></span></a><a href="/user/profile/settings" class="profile-item"><span class="menu-icon settings-icon"><i class="fas fa-cog"></i></span><span>Settings</span></a><div class="dropdown-divider"></div><a href="/user/logout" class="profile-item logout-item"><span class="menu-icon logout-icon"><i class="fas fa-right-from-bracket"></i></span><span>Logout</span></a></div></div></div><% } %></div></nav>
<style>.main-nav{position:fixed;top:0;left:0;right:0;z-index:1100;background:rgba(255,255,255,.94);backdrop-filter:blur(18px);border-bottom:1px solid #e8eaf0;box-shadow:0 6px 24px rgba(15,23,42,.06)}.nav-container{height:70px;max-width:1280px;margin:auto;padding:0 22px;display:flex;align-items:center;justify-content:space-between}.nav-brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-size:1.35rem;font-weight:800;color:#111827}.brand-mark{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,#6366f1,#8b5cf6);box-shadow:0 7px 18px rgba(99,102,241,.28)}.nav-actions{display:flex;align-items:center;gap:10px}.nav-add-blog{height:42px;padding:0 15px;display:flex;align-items:center;gap:8px;border-radius:12px;background:linear-gradient(135deg,#6366f1,#7c3aed);color:#fff;text-decoration:none;font-size:.88rem;font-weight:700}.nav-icon-btn{position:relative;width:42px;height:42px;border:1px solid #e5e7eb;border-radius:12px;background:#fff;color:#4b5563;display:grid;place-items:center;text-decoration:none}.nav-icon-btn:hover{color:#6366f1;border-color:#c7d2fe}.nav-badge{position:absolute;top:2px;right:2px;min-width:17px;height:17px;padding:0 4px;border-radius:99px;background:#ef4444;color:#fff;border:2px solid #fff;font:700 9px/13px Arial;text-align:center}.dropdown-count{display:inline-grid;place-items:center;min-width:18px;height:18px;padding:0 5px;margin-left:auto;border-radius:99px;background:#ef4444;color:#fff;font-size:.68rem}.profile-menu{position:relative}.profile-trigger{display:flex;align-items:center;gap:10px;padding:5px 9px 5px 5px;border:1px solid #e5e7eb;border-radius:14px;background:#fff;color:#111827;cursor:pointer}.profile-trigger img{width:34px;height:34px;border-radius:10px;object-fit:cover}.profile-name{font-weight:650;max-width:150px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.profile-chevron{font-size:.7rem;color:#9ca3af}.profile-trigger[aria-expanded=true] .profile-chevron{transform:rotate(180deg)}.profile-dropdown{position:absolute;right:0;top:calc(100% + 10px);width:280px;padding:8px;background:#fff;border:1px solid #e5e7eb;border-radius:16px;box-shadow:0 18px 45px rgba(15,23,42,.14);opacity:0;visibility:hidden;transform:translateY(-7px);transition:.18s}.profile-dropdown.open{opacity:1;visibility:visible;transform:translateY(0)}.profile-summary{display:flex;align-items:center;gap:11px;padding:12px}.profile-summary img{width:42px;height:42px;border-radius:12px;object-fit:cover}.profile-summary strong,.profile-summary small{display:block}.profile-summary small{font-size:.75rem;color:#6b7280;margin-top:2px}.dropdown-divider{height:1px;background:#eef0f4;margin:6px 4px}.profile-item{display:flex;align-items:center;gap:11px;padding:10px;border-radius:11px;text-decoration:none;color:#374151;font-size:.9rem;font-weight:550}.profile-item:hover{background:#f5f7ff;color:#4f46e5}.menu-icon{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-size:.85rem}.profile-icon{background:#eef2ff;color:#4f46e5}.message-icon{background:#ecfeff;color:#0891b2}.notification-icon{background:#f3e8ff;color:#9333ea}.settings-icon{background:#f1f5f9;color:#475569}.logout-icon{background:#fef2f2;color:#dc2626}.logout-item{color:#dc2626}.dark-mode .main-nav{background:rgba(15,23,42,.94);border-color:#263244}.dark-mode .nav-brand,.dark-mode .profile-trigger{color:#f8fafc}.dark-mode .nav-icon-btn,.dark-mode .profile-trigger,.dark-mode .profile-dropdown{background:#111827;border-color:#263244;color:#f8fafc}.dark-mode .profile-summary strong{color:#f8fafc}.dark-mode .profile-summary small{color:#94a3b8}.dark-mode .dropdown-divider{background:#263244}.dark-mode .profile-item{color:#cbd5e1}.dark-mode .profile-item:hover{background:#1e293b}.dark-mode .nav-badge{border-color:#111827}@media(max-width:600px){.nav-container{height:62px;padding:0 14px}.profile-name{display:none}.profile-trigger{padding-right:7px}.profile-dropdown{right:-4px;width:min(280px,calc(100vw - 28px))}.nav-brand{font-size:1.15rem}.brand-mark{width:34px;height:34px}.nav-icon-btn{width:40px;height:40px}.nav-add-blog{width:40px;height:40px;padding:0;justify-content:center}.nav-add-blog span{display:none}}</style>
<script>(function(){const t=document.getElementById('profileTrigger'),d=document.getElementById('profileDropdown');if(t&&d){t.addEventListener('click',e=>{e.stopPropagation();const o=d.classList.toggle('open');t.setAttribute('aria-expanded',String(o))});document.addEventListener('click',e=>{if(!e.target.closest('#profileMenu')){d.classList.remove('open');t.setAttribute('aria-expanded','false')}});document.addEventListener('keydown',e=>{if(e.key==='Escape'){d.classList.remove('open');t.setAttribute('aria-expanded','false')}})}
async function refreshBadges(){try{const [m,n]=await Promise.all([fetch('/messages/unread/count'),fetch('/notifications/unread/count')]);const md=await m.json(),nd=await n.json();setBadge('messageBadge','messageCount','dropdownMessageCount',md.unreadCount||0);setBadge('notificationBadge','notificationCount','dropdownNotificationCount',nd.unreadCount||0)}catch(e){}}
function setBadge(id,countId,dropId,count){const b=document.getElementById(id),c=document.getElementById(countId),d=document.getElementById(dropId);[c,d].forEach(x=>{if(x)x.textContent=count});if(b)b.style.display=count>0?'grid':'none';if(d)d.style.display=count>0?'inline-grid':'none'}
refreshBadges();window.addEventListener('focus',refreshBadges);if(window.io){const s=io();s.on('notification:message',refreshBadges);s.on('message:read',refreshBadges)}else{const sc=document.createElement('script');sc.src='/socket.io/socket.io.js';sc.onload=()=>{try{const s=io();s.on('notification:message',refreshBadges)}catch(e){}};document.head.appendChild(sc)}})();</script>

<!-- Blogify theme selector -->
<style id="blogify-theme-nav-style">
.blogify-theme-item .menu-icon{background:#fef3c7;color:#b45309}.blogify-theme-item .theme-mode-label{margin-left:auto;font-size:.72rem;color:#6b7280;font-weight:700}.blogify-theme-item:hover .theme-mode-label{color:currentColor}
html[data-theme="dark"] .blogify-theme-item .menu-icon{background:#27272a;color:#fbbf24}.blogify-theme-item button{border:0!important;background:transparent!important;width:100%;font:inherit;text-align:left;cursor:pointer}
</style>
<script>
(function(){
  function setupThemeMenu(){
    const dropdown=document.getElementById('profileDropdown');
    if(!dropdown||document.getElementById('blogifyThemeItem'))return;
    const item=document.createElement('div');
    item.className='profile-item blogify-theme-item';item.id='blogifyThemeItem';
    item.innerHTML='<span class="menu-icon"><i class="fas fa-moon"></i></span><span>Appearance</span><span class="theme-mode-label" id="blogifyThemeLabel">Light</span>';
    const settings=dropdown.querySelector('a[href="/user/profile/settings"]');
    if(settings)settings.parentNode.insertBefore(item,settings);else dropdown.appendChild(item);
    item.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();if(window.BlogifyTheme)window.BlogifyTheme.toggle();updateLabel();});
    updateLabel();
  }
  function updateLabel(){const label=document.getElementById('blogifyThemeLabel'),icon=document.querySelector('#blogifyThemeItem i');if(!label)return;const dark=document.documentElement.dataset.theme==='dark';label.textContent=dark?'Dark':'Light';if(icon)icon.className=dark?'fas fa-sun':'fas fa-moon'}
  document.addEventListener('blogify:themechange',updateLabel);window.addEventListener('blogify:themechange',updateLabel);
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',setupThemeMenu);else setupThemeMenu();
})();
</script>

<!-- Ensure hard-coded chat UIs follow Blogify's global theme. This is intentionally loaded after page styles because message.ejs and chatlog.ejs define their own dark defaults. -->
