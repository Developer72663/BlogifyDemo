<script>

/* =========================================================
   BLOGIFY NAVIGATION SCRIPT
   ========================================================= */

(function () {

  const trigger =
    document.getElementById('profileTrigger');

  const dropdown =
    document.getElementById('profileDropdown');

  const menu =
    document.getElementById('profileMenu');


  /* -------------------------------------------------------
     PROFILE DROPDOWN
     ------------------------------------------------------- */

  function openMenu() {

    if (!trigger || !dropdown) return;

    dropdown.classList.add('open');

    trigger.setAttribute(
      'aria-expanded',
      'true'
    );

    dropdown.setAttribute(
      'aria-hidden',
      'false'
    );
  }


  function closeMenu() {

    if (!trigger || !dropdown) return;

    dropdown.classList.remove('open');

    trigger.setAttribute(
      'aria-expanded',
      'false'
    );

    dropdown.setAttribute(
      'aria-hidden',
      'true'
    );
  }


  function toggleMenu() {

    if (!dropdown) return;

    if (dropdown.classList.contains('open')) {
      closeMenu();
    } else {
      openMenu();
    }
  }


  if (trigger && dropdown) {

    trigger.addEventListener(
      'click',
      function (event) {

        event.preventDefault();
        event.stopPropagation();

        toggleMenu();
      }
    );


    document.addEventListener(
      'click',
      function (event) {

        if (
          menu &&
          !menu.contains(event.target)
        ) {
          closeMenu();
        }

      }
    );


    document.addEventListener(
      'keydown',
      function (event) {

        if (event.key === 'Escape') {

          closeMenu();

          trigger.focus();
        }

      }
    );


    dropdown.addEventListener(
      'click',
      function (event) {

        /*
         * Do not close when clicking
         * Appearance.
         */
        if (
          event.target.closest(
            '#blogifyThemeItem'
          )
        ) {
          return;
        }

        /*
         * Close after selecting a
         * navigation item.
         */
        if (
          event.target.closest(
            'a.profile-item'
          )
        ) {
          closeMenu();
        }

      }
    );

  }


  /* -------------------------------------------------------
     BADGES
     ------------------------------------------------------- */

  function setBadge(
    badgeId,
    countId,
    dropdownId,
    count
  ) {

    const badge =
      document.getElementById(badgeId);

    const counter =
      document.getElementById(countId);

    const dropdownCounter =
      document.getElementById(dropdownId);


    const safeCount =
      Number.isFinite(Number(count))
        ? Math.max(0, Number(count))
        : 0;


    if (counter) {
      counter.textContent =
        safeCount > 99
          ? '99+'
          : String(safeCount);
    }


    if (dropdownCounter) {
      dropdownCounter.textContent =
        safeCount > 99
          ? '99+'
          : String(safeCount);
    }


    if (badge) {
      badge.style.display =
        safeCount > 0
          ? 'grid'
          : 'none';
    }


    if (dropdownCounter) {
      dropdownCounter.style.display =
        safeCount > 0
          ? 'inline-grid'
          : 'none';
    }

  }


  /* -------------------------------------------------------
     REFRESH MESSAGE + NOTIFICATION COUNTS
     ------------------------------------------------------- */

  let badgeRefreshing = false;


  async function refreshBadges() {

    if (badgeRefreshing) return;

    badgeRefreshing = true;


    try {

      const responses =
        await Promise.allSettled([

          fetch(
            '/messages/unread/count',
            {
              method: 'GET',
              credentials: 'same-origin',
              headers: {
                'Accept':
                  'application/json'
              },
              cache: 'no-store'
            }
          ),

          fetch(
            '/notifications/unread/count',
            {
              method: 'GET',
              credentials: 'same-origin',
              headers: {
                'Accept':
                  'application/json'
              },
              cache: 'no-store'
            }
          )

        ]);


      /* Messages */

      if (
        responses[0].status ===
        'fulfilled'
      ) {

        const response =
          responses[0].value;

        if (response.ok) {

          const data =
            await response.json();

          setBadge(
            'messageBadge',
            'messageCount',
            'dropdownMessageCount',
            data.unreadCount || 0
          );

        }

      }


      /* Notifications */

      if (
        responses[1].status ===
        'fulfilled'
      ) {

        const response =
          responses[1].value;

        if (response.ok) {

          const data =
            await response.json();

          setBadge(
            'notificationBadge',
            'notificationCount',
            'dropdownNotificationCount',
            data.unreadCount || 0
          );

        }

      }

    } catch (error) {

      /*
       * Badge failure should never
       * break navigation.
       */

      console.debug(
        'Blogify badge refresh failed:',
        error
      );

    } finally {

      badgeRefreshing = false;
    }

  }


  /* -------------------------------------------------------
     REAL-TIME SOCKET BADGES
     ------------------------------------------------------- */

  function connectRealtimeBadges() {

    try {

      if (
        typeof window.io ===
        'function'
      ) {

        const socket =
          window.io({
            transports: [
              'websocket',
              'polling'
            ],
            withCredentials: true
          });


        socket.on(
          'connect',
          refreshBadges
        );


        socket.on(
          'notification:message',
          refreshBadges
        );


        socket.on(
          'message:read',
          refreshBadges
        );


        socket.on(
          'notification:new',
          refreshBadges
        );


        socket.on(
          'notification:read',
          refreshBadges
        );


        socket.on(
          'connect_error',
          function () {
            /*
             * Socket failure must not
             * affect normal navigation.
             */
          }
        );


        return;

      }


      /*
       * Fallback: load Socket.IO
       * client from the current server.
       */

      const existing =
        document.querySelector(
          'script[src="/socket.io/socket.io.js"]'
        );


      if (existing) return;


      const script =
        document.createElement('script');

      script.src =
        '/socket.io/socket.io.js';

      script.async = true;


      script.onload =
        function () {

          try {

            if (
              typeof window.io !==
              'function'
            ) return;


            const socket =
              window.io({
                transports: [
                  'websocket',
                  'polling'
                ],
                withCredentials: true
              });


            socket.on(
              'connect',
              refreshBadges
            );


            socket.on(
              'notification:message',
              refreshBadges
            );


            socket.on(
              'message:read',
              refreshBadges
            );


            socket.on(
              'notification:new',
              refreshBadges
            );

          } catch (error) {

            console.debug(
              'Blogify socket initialization failed:',
              error
            );

          }

        };


      script.onerror =
        function () {
          /*
           * Socket.IO is optional for
           * navigation functionality.
           */
        };


      document.head.appendChild(
        script
      );

    } catch (error) {

      console.debug(
        'Blogify realtime setup failed:',
        error
      );

    }

  }


  /* -------------------------------------------------------
     APPEARANCE
     ------------------------------------------------------- */

  function updateThemeLabel() {

    const label =
      document.getElementById(
        'blogifyThemeLabel'
      );

    const icon =
      document.getElementById(
        'blogifyThemeIcon'
      );


    if (!label) return;


    const dark =
      document.documentElement
        .dataset
        .theme === 'dark';


    label.textContent =
      dark
        ? 'Dark'
        : 'Light';


    if (icon) {

      icon.className =
        dark
          ? 'fas fa-sun'
          : 'fas fa-moon';

    }

  }


  function setupThemeMenu() {

    const item =
      document.getElementById(
        'blogifyThemeItem'
      );


    if (!item) return;


    const activate =
      function (event) {

        if (
          event.type ===
          'keydown' &&
          event.key !== 'Enter' &&
          event.key !== ' '
        ) {
          return;
        }


        event.preventDefault();
        event.stopPropagation();


        if (
          window.BlogifyTheme &&
          typeof window.BlogifyTheme.toggle ===
            'function'
        ) {

          window.BlogifyTheme.toggle();

        } else {

          /*
           * Safe fallback if the global
           * theme helper isn't available.
           */

          const root =
            document.documentElement;

          const dark =
            root.dataset.theme ===
            'dark';


          root.dataset.theme =
            dark
              ? 'light'
              : 'dark';


          try {

            localStorage.setItem(
              'blogify-theme',
              root.dataset.theme
            );

          } catch (error) {}

        }


        updateThemeLabel();

      };


    item.addEventListener(
      'click',
      activate
    );


    item.addEventListener(
      'keydown',
      activate
    );


    updateThemeLabel();

  }


  document.addEventListener(
    'blogify:themechange',
    updateThemeLabel
  );


  window.addEventListener(
    'blogify:themechange',
    updateThemeLabel
  );


  /* -------------------------------------------------------
     INITIALIZE
     ------------------------------------------------------- */

  function initialize() {

    setupThemeMenu();

    refreshBadges();

    connectRealtimeBadges();


    /*
     * Refresh after returning to
     * the browser/app.
     */

    window.addEventListener(
      'focus',
      refreshBadges
    );


    document.addEventListener(
      'visibilitychange',
      function () {

        if (
          document.visibilityState ===
          'visible'
        ) {
          refreshBadges();
        }

      }
    );


    /*
     * Small periodic fallback.
     * Keeps badges working even if
     * Socket.IO is unavailable.
     */

    setInterval(
      function () {

        if (
          document.visibilityState ===
          'visible'
        ) {
          refreshBadges();
        }

      },
      30000
    );

  }


  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initialize
    );

  } else {

    initialize();

  }

})();

</script>


