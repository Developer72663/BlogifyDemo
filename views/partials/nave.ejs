<nav class="blogify-nav" id="mainNav">
    <div class="nav-shell">
        <a href="/" class="nav-brand" aria-label="Blogify home">
            <span class="brand-mark"><i class="fas fa-pen-nib"></i></span>
            <span class="brand-name">Blogify</span>
        </a>

        <div class="nav-center">
            <a href="/" class="nav-link <%= locals.activePage === 'home' ? 'active' : '' %>"><i class="fas fa-compass"></i> Explore</a>
            <% if (locals.user) { %>
                <a href="/blogs/add-new" class="nav-link"><i class="fas fa-plus"></i> Write</a>
                <a href="/profile/<%= locals.user._id %>" class="nav-link"><i class="fas fa-layer-group"></i> My Blogs</a>
            <% } %>
        </div>

        <div class="nav-actions">
            <button class="nav-icon" id="searchToggle" type="button" title="Search"><i class="fas fa-search"></i></button>
            <% if (locals.user) { %>
                <a class="nav-icon" href="/notifications" title="Notifications">
                    <i class="far fa-bell"></i><span class="nav-badge" id="notificationBadge" style="display:none"><span id="notificationCount">0</span></span>
                </a>
                <button class="nav-icon" id="themeToggle" type="button" title="Toggle theme"><i class="fas fa-moon" id="themeIcon"></i></button>

                <div class="account-menu" id="accountMenu">
                    <button class="account-trigger" id="userMenuTrigger" type="button" aria-expanded="false">
                        <img src="<%= locals.user.profileImageURL || '/imgs/default.png' %>" alt="<%= locals.user.fullName %>" onerror="this.src='/imgs/default.png';">
                        <span><%= locals.user.fullName.split(' ')[0] %></span><i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="account-dropdown" id="userDropdown">
                        <div class="account-summary">
                            <img src="<%= locals.user.profileImageURL || '/imgs/default.png' %>" alt="" onerror="this.src='/imgs/default.png';">
                            <div><strong><%= locals.user.fullName %></strong><small><%= locals.user.email %></small></div>
                        </div>
                        <div class="dropdown-links">
                            <a href="/profile/<%= locals.user._id %>"><i class="fas fa-user"></i><span>Profile</span></a>
                            <a href="/notifications"><i class="fas fa-bell"></i><span>Notifications</span><b id="dropdownNotifBadge" style="display:none">0</b></a>
                            <a href="/profile/<%= locals.user._id %>?tab=followers"><i class="fas fa-users"></i><span>Followers</span><em><%= locals.user.followers ? locals.user.followers.length : 0 %></em></a>
                            <a href="/profile/<%= locals.user._id %>?tab=following"><i class="fas fa-heart"></i><span>Following</span><em><%= locals.user.following ? locals.user.following.length : 0 %></em></a>
                            <div class="dropdown-rule"></div>
                            <a href="/analytics"><i class="fas fa-chart-line"></i><span>Analytics</span></a>
                            <a href="/user/profile/settings"><i class="fas fa-sliders-h"></i><span>Settings</span></a>
                            <% if (locals.user.role === 'ADMIN') { %>
                                <a href="/admin/users"><i class="fas fa-shield-alt"></i><span>Admin Panel</span></a>
                            <% } %>
                        </div>
                        <a href="/user/logout" class="signout"><i class="fas fa-sign-out-alt"></i> Sign out</a>
                    </div>
                </div>
            <% else { %>
                <a href="/user/signin" class="signin-link">Sign in</a>
                <a href="/user/signup" class="signup-link">Get started</a>
            <% } %>
            <button class="mobile-nav-toggle" id="mobileToggle" type="button" aria-label="Open menu"><i class="fas fa-bars"></i></button>
        </div>
    </div>

    <div class="search-popover" id="searchOverlay">
        <form action="/" method="GET">
            <i class="fas fa-search"></i>
            <input type="search" name="search" placeholder="Search articles, topics, authors..." autocomplete="off">
            <button type="button" id="searchClose" aria-label="Close search"><i class="fas fa-times"></i></button>
        </form>
    </div>
</nav>

<div class="mobile-drawer" id="mobileMenu">
    <div class="mobile-drawer-head"><strong>Menu</strong><button id="mobileClose" type="button"><i class="fas fa-times"></i></button></div>
    <div class="mobile-drawer-links">
        <a href="/"><i class="fas fa-compass"></i> Explore</a>
        <% if (locals.user) { %>
            <a href="/blogs/add-new"><i class="fas fa-plus"></i> Write</a>
            <a href="/profile/<%= locals.user._id %>"><i class="fas fa-layer-group"></i> My Blogs</a>
            <a href="/notifications"><i class="fas fa-bell"></i> Notifications</a>
            <a href="/profile/<%= locals.user._id %>"><i class="fas fa-user"></i> Profile</a>
            <a href="/analytics"><i class="fas fa-chart-line"></i> Analytics</a>
            <a href="/user/profile/settings"><i class="fas fa-sliders-h"></i> Settings</a>
            <% if (locals.user.role === 'ADMIN') { %><a href="/admin/users"><i class="fas fa-shield-alt"></i> Admin Panel</a><% } %>
            <div class="mobile-rule"></div>
            <a href="/user/logout" class="danger-link"><i class="fas fa-sign-out-alt"></i> Sign out</a>
        <% } else { %>
            <div class="mobile-rule"></div>
            <a href="/user/signin"><i class="fas fa-sign-in-alt"></i> Sign in</a>
            <a href="/user/signup" class="primary-link"><i class="fas fa-rocket"></i> Get started</a>
        <% } %>
    </div>
</div>
<div class="nav-backdrop" id="navBackdrop"></div>

<style>
    :root { --nav-bg:#fff; --nav-text:#111827; --nav-muted:#6b7280; --nav-border:#e8eaf0; --nav-soft:#f5f5ff; --nav-primary:#635bff; }
    [data-theme="dark"] { --nav-bg:#0f172a; --nav-text:#f8fafc; --nav-muted:#94a3b8; --nav-border:#243047; --nav-soft:rgba(99,91,255,.15); --nav-primary:#8b83ff; }
    .blogify-nav { position:fixed; top:0; left:0; right:0; z-index:1000; background:rgba(255,255,255,.82); border-bottom:1px solid var(--nav-border); backdrop-filter:blur(18px); }
    [data-theme="dark"] .blogify-nav { background:rgba(15,23,42,.86); }
    .nav-shell { max-width:1280px; height:70px; margin:auto; padding:0 22px; display:flex; align-items:center; gap:24px; }
    .nav-brand { display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--nav-text); font-weight:900; letter-spacing:-.04em; font-size:1.25rem; }
    .brand-mark { width:38px; height:38px; border-radius:12px; display:grid; place-items:center; color:#fff; background:linear-gradient(135deg,#635bff,#8b5cf6); box-shadow:0 8px 20px rgba(99,91,255,.24); }
    .nav-center { display:flex; justify-content:center; align-items:center; gap:4px; flex:1; }
    .nav-link { display:flex; align-items:center; gap:8px; padding:10px 13px; border-radius:11px; color:var(--nav-muted); text-decoration:none; font-size:.88rem; font-weight:750; transition:.18s; }
    .nav-link:hover,.nav-link.active { background:var(--nav-soft); color:var(--nav-primary); }
    .nav-actions { display:flex; align-items:center; gap:7px; }
    .nav-icon,.mobile-nav-toggle { position:relative; width:40px; height:40px; border:0; border-radius:11px; background:transparent; color:var(--nav-muted); display:grid; place-items:center; cursor:pointer; font-size:1rem; text-decoration:none; }
    .nav-icon:hover,.mobile-nav-toggle:hover { background:var(--nav-soft); color:var(--nav-primary); }
    .nav-badge { position:absolute; top:3px; right:2px; min-width:17px; height:17px; padding:0 4px; border-radius:20px; display:grid; place-items:center; background:#ef4444; color:#fff; border:2px solid var(--nav-bg); font-size:.58rem; font-weight:900; }
    .account-menu { position:relative; }
    .account-trigger { display:flex; align-items:center; gap:8px; border:1px solid var(--nav-border); background:var(--nav-bg); color:var(--nav-text); border-radius:99px; padding:4px 10px 4px 4px; cursor:pointer; font:inherit; font-weight:800; }
    .account-trigger img { width:31px; height:31px; border-radius:50%; object-fit:cover; }
    .account-trigger i { color:var(--nav-muted); font-size:.65rem; transition:.2s; }
    .account-menu.open .account-trigger i { transform:rotate(180deg); }
    .account-dropdown { position:absolute; top:calc(100% + 10px); right:0; width:300px; padding:9px; background:var(--nav-bg); border:1px solid var(--nav-border); border-radius:18px; box-shadow:0 24px 70px rgba(15,23,42,.16); opacity:0; visibility:hidden; transform:translateY(-6px); transition:.18s; }
    .account-menu.open .account-dropdown { opacity:1; visibility:visible; transform:none; }
    .account-summary { display:flex; gap:11px; align-items:center; padding:11px; margin-bottom:5px; }
    .account-summary img { width:44px; height:44px; border-radius:13px; object-fit:cover; }
    .account-summary strong,.account-summary small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .account-summary strong { color:var(--nav-text); font-size:.9rem; }
    .account-summary small { color:var(--nav-muted); margin-top:3px; max-width:205px; }
    .dropdown-links a { display:flex; align-items:center; gap:11px; padding:10px; border-radius:11px; color:var(--nav-text); text-decoration:none; font-size:.86rem; font-weight:700; }
    .dropdown-links a:hover { background:var(--nav-soft); color:var(--nav-primary); }
    .dropdown-links a i { width:29px; height:29px; border-radius:9px; display:grid; place-items:center; background:var(--nav-soft); color:var(--nav-primary); }
    .dropdown-links b,.dropdown-links em { margin-left:auto; font-style:normal; font-size:.68rem; border-radius:99px; padding:2px 8px; background:var(--nav-soft); color:var(--nav-primary); }
    .dropdown-links b { background:#ef4444; color:#fff; }
    .dropdown-rule,.mobile-rule { height:1px; background:var(--nav-border); margin:7px 4px; }
    .signout { display:flex; justify-content:center; gap:7px; padding:10px; margin-top:5px; border-radius:11px; color:#ef4444; text-decoration:none; font-size:.86rem; font-weight:800; }
    .signout:hover { background:#fef2f2; }
    .signin-link,.signup-link { text-decoration:none; font-size:.86rem; font-weight:800; }
    .signin-link { color:var(--nav-text); padding:9px 11px; }
    .signup-link { color:#fff; padding:10px 14px; border-radius:11px; background:linear-gradient(135deg,#635bff,#8b5cf6); box-shadow:0 7px 18px rgba(99,91,255,.22); }
    .mobile-nav-toggle { display:none; }
    .search-popover { position:absolute; left:0; right:0; top:70px; padding:14px 22px 16px; background:var(--nav-bg); border-bottom:1px solid var(--nav-border); box-shadow:0 15px 30px rgba(15,23,42,.08); display:none; }
    .search-popover.open { display:block; }
    .search-popover form { max-width:850px; margin:auto; display:flex; align-items:center; gap:12px; padding:12px 14px; border:1px solid var(--nav-border); border-radius:13px; background:var(--nav-soft); }
    .search-popover i { color:var(--nav-muted); }
    .search-popover input { flex:1; border:0; outline:0; background:transparent; color:var(--nav-text); font:inherit; }
    .search-popover button { border:0; background:transparent; color:var(--nav-muted); cursor:pointer; }
    .mobile-drawer { position:fixed; top:0; right:0; bottom:0; width:330px; max-width:88vw; z-index:1100; background:var(--nav-bg); transform:translateX(100%); transition:.24s; box-shadow:-25px 0 60px rgba(15,23,42,.16); }
    .mobile-drawer.open { transform:none; }
    .mobile-drawer-head { height:70px; padding:0 18px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--nav-border); color:var(--nav-text); font-size:1.05rem; }
    .mobile-drawer-head button { width:38px; height:38px; border:0; border-radius:11px; background:var(--nav-soft); color:var(--nav-text); cursor:pointer; }
    .mobile-drawer-links { padding:15px; }
    .mobile-drawer-links a { display:flex; align-items:center; gap:13px; padding:13px; border-radius:12px; color:var(--nav-text); text-decoration:none; font-weight:750; }
    .mobile-drawer-links a:hover { background:var(--nav-soft); color:var(--nav-primary); }
    .mobile-drawer-links a i { width:33px; height:33px; border-radius:10px; display:grid; place-items:center; background:var(--nav-soft); color:var(--nav-primary); }
    .mobile-drawer-links .danger-link { color:#ef4444; }
    .mobile-drawer-links .primary-link { color:var(--nav-primary); }
    .nav-backdrop { position:fixed; inset:0; z-index:1050; background:rgba(15,23,42,.35); backdrop-filter:blur(3px); opacity:0; visibility:hidden; transition:.2s; }
    .nav-backdrop.open { opacity:1; visibility:visible; }
    @media (max-width:900px) { .nav-center,.account-trigger span,.account-trigger i { display:none; } .mobile-nav-toggle { display:grid; } .account-trigger { padding:4px; } }
    @media (max-width:560px) { .nav-shell { height:60px; padding:0 14px; } .brand-name { display:none; } .search-popover { top:60px; padding:10px 12px; } .signin-link { display:none; } }
</style>

<script>
(function () {
    const html = document.documentElement;
    const accountMenu = document.getElementById('accountMenu');
    const userTrigger = document.getElementById('userMenuTrigger');
    const searchToggle = document.getElementById('searchToggle');
    const searchOverlay = document.getElementById('searchOverlay');
    const searchClose = document.getElementById('searchClose');
    const mobileToggle = document.getElementById('mobileToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileClose = document.getElementById('mobileClose');
    const backdrop = document.getElementById('navBackdrop');
    const themeToggle = document.getElementById('themeToggle');
    const themeIcon = document.getElementById('themeIcon');

    function systemTheme() { return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
    function applyTheme(theme) {
        const actual = theme === 'system' ? systemTheme() : theme;
        html.dataset.theme = actual;
        if (themeIcon) themeIcon.className = actual === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
    }
    const savedTheme = localStorage.getItem('blogify-theme') || localStorage.getItem('theme') || 'light';
    applyTheme(savedTheme);
    if (themeToggle) themeToggle.addEventListener('click', async () => {
        const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('blogify-theme', next);
        localStorage.setItem('theme', next);
        applyTheme(next);
        if (document.body.dataset.settingsPage === 'true') return;
        try { await fetch('/user/profile/settings/theme', { method:'PATCH', headers:{'Content-Type':'application/json'}, body:JSON.stringify({theme:next}) }); } catch (_) {}
    });

    if (userTrigger) userTrigger.addEventListener('click', e => { e.stopPropagation(); accountMenu.classList.toggle('open'); });
    document.addEventListener('click', e => { if (accountMenu && !accountMenu.contains(e.target)) accountMenu.classList.remove('open'); });

    if (searchToggle) searchToggle.addEventListener('click', () => { searchOverlay.classList.toggle('open'); if (searchOverlay.classList.contains('open')) searchOverlay.querySelector('input').focus(); });
    if (searchClose) searchClose.addEventListener('click', () => searchOverlay.classList.remove('open'));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') { searchOverlay?.classList.remove('open'); accountMenu?.classList.remove('open'); closeMobile(); } });

    function openMobile() { mobileMenu?.classList.add('open'); backdrop?.classList.add('open'); }
    function closeMobile() { mobileMenu?.classList.remove('open'); backdrop?.classList.remove('open'); }
    mobileToggle?.addEventListener('click', openMobile);
    mobileClose?.addEventListener('click', closeMobile);
    backdrop?.addEventListener('click', closeMobile);

    <% if (locals.user) { %>
    async function loadUnreadCount() {
        try {
            const res = await fetch('/notifications/unread/count');
            const data = await res.json();
            if (!data.success) return;
            const display = data.unreadCount > 99 ? '99+' : data.unreadCount;
            const badge = document.getElementById('notificationBadge');
            const count = document.getElementById('notificationCount');
            const dropdown = document.getElementById('dropdownNotifBadge');
            if (data.unreadCount > 0) { badge.style.display='grid'; count.textContent=display; if(dropdown){dropdown.style.display='inline-block';dropdown.textContent=display;} }
            else { badge.style.display='none'; if(dropdown) dropdown.style.display='none'; }
        } catch (_) {}
    }
    loadUnreadCount();
    setInterval(loadUnreadCount, 30000);
    <% } %>
})();
</script>
