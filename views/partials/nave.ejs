<nav class="main-nav" id="mainNav">
  <div class="nav-container">

    <!-- Brand -->
    <a href="/" class="nav-brand" aria-label="Blogify Home">
      <span class="brand-mark">B</span>
      <span class="brand-name">Blogify</span>
    </a>

    <% if (locals.user) { %>

      <div class="nav-actions">

        <!-- Add Blog -->
        <a
          href="/blogs/add-new"
          class="nav-add-blog"
          aria-label="Add Blog"
          title="Add Blog"
        >
          <i class="fas fa-plus"></i>
          <span>Add Blog</span>
        </a>

        <!-- Messages -->
        <a
          href="/messages/chatlog"
          class="nav-icon-btn"
          aria-label="Messages"
          title="Messages"
        >
          <i class="far fa-comment-dots"></i>

          <span
            class="nav-badge"
            id="messageBadge"
            style="display:none"
          >
            <span id="messageCount">0</span>
          </span>
        </a>

        <!-- Notifications -->
        <a
          href="/notifications"
          class="nav-icon-btn"
          aria-label="Notifications"
          title="Notifications"
        >
          <i class="far fa-bell"></i>

          <span
            class="nav-badge"
            id="notificationBadge"
            style="display:none"
          >
            <span id="notificationCount">0</span>
          </span>
        </a>

        <!-- Profile -->
        <div class="profile-menu" id="profileMenu">

          <button
            class="profile-trigger"
            id="profileTrigger"
            type="button"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="profileDropdown"
          >

            <img
              src="<%= locals.user.profileImageURL || '/imgs/default.png' %>"
              alt="<%= locals.user.fullName || 'Profile' %>"
              onerror="this.src='/imgs/default.png';"
            >

            <span class="profile-name">
              <%= locals.user.fullName || 'User' %>
            </span>

            <i class="fas fa-chevron-down profile-chevron"></i>
          </button>


          <!-- Profile Dropdown -->
          <div
            class="profile-dropdown"
            id="profileDropdown"
            role="menu"
            aria-hidden="true"
          >

            <!-- Profile Summary -->
            <div class="profile-summary">

              <img
                src="<%= locals.user.profileImageURL || '/imgs/default.png' %>"
                alt=""
                onerror="this.src='/imgs/default.png';"
              >

              <div class="profile-summary-info">
                <strong>
                  <%= locals.user.fullName || 'User' %>
                </strong>

                <small>
                  <%= locals.user.email || '' %>
                </small>
              </div>

            </div>


            <div class="dropdown-divider"></div>


            <!-- Profile -->
            <a
              href="/user/profile"
              class="profile-item"
              role="menuitem"
            >
              <span class="menu-icon profile-icon">
                <i class="fas fa-user"></i>
              </span>

              <span>Profile</span>
            </a>


            <!-- Messages -->
            <a
              href="/messages/chatlog"
              class="profile-item"
              role="menuitem"
            >
              <span class="menu-icon message-icon">
                <i class="fas fa-comment-dots"></i>
              </span>

              <span>Messages</span>

              <b
                id="dropdownMessageCount"
                class="dropdown-count"
                style="display:none"
              >
                0
              </b>
            </a>


            <!-- Notifications -->
            <a
              href="/notifications"
              class="profile-item"
              role="menuitem"
            >
              <span class="menu-icon notification-icon">
                <i class="fas fa-bell"></i>
              </span>

              <span>Notifications</span>

              <b
                id="dropdownNotificationCount"
                class="dropdown-count"
                style="display:none"
              >
                0
              </b>
            </a>


            <!-- Settings -->
            <a
              href="/user/profile/settings"
              class="profile-item"
              role="menuitem"
            >
              <span class="menu-icon settings-icon">
                <i class="fas fa-cog"></i>
              </span>

              <span>Settings</span>
            </a>


            <% /*
              Admin detection.

              This supports common admin values:
              - user.isAdmin === true
              - user.role === 'admin'
              - user.is_admin === true
            */ %>

            <% if (
              locals.user &&
              (
                locals.user.isAdmin === true ||
                locals.user.role === 'admin' ||
                locals.user.is_admin === true
              )
            ) { %>

              <a
                href="/admin"
                class="profile-item admin-item"
                role="menuitem"
              >
                <span class="menu-icon admin-icon">
                  <i class="fas fa-shield-halved"></i>
                </span>

                <span>Admin Panel</span>

                <i class="fas fa-chevron-right admin-arrow"></i>
              </a>

            <% } %>


            <!-- Appearance -->
            <div
              class="profile-item blogify-theme-item"
              id="blogifyThemeItem"
              role="button"
              tabindex="0"
            >
              <span class="menu-icon theme-icon">
                <i
                  id="blogifyThemeIcon"
                  class="fas fa-moon"
                ></i>
              </span>

              <span>Appearance</span>

              <span
                class="theme-mode-label"
                id="blogifyThemeLabel"
              >
                Light
              </span>
            </div>


            <div class="dropdown-divider"></div>


            <!-- Logout -->
            <a
              href="/user/logout"
              class="profile-item logout-item"
              role="menuitem"
            >
              <span class="menu-icon logout-icon">
                <i class="fas fa-right-from-bracket"></i>
              </span>

              <span>Logout</span>
            </a>

          </div>
        </div>

      </div>

    <% } %>

  </div>
</nav>


<style>

/* =========================================================
   BLOGIFY NAVIGATION
   ========================================================= */

