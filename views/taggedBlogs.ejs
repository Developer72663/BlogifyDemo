<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head") %>
    <title>#<%= tag %> | Blogify</title>
    <style>
        :root{--ink:#17181c;--muted:#70737b;--line:#e7e8eb;--surface:#fff;--soft:#f6f7f9;--page:#fafaf9;--accent:#6366f1}
        body{background:var(--page);color:var(--ink)}
        .tag-page{max-width:1180px;margin:auto;padding:35px 18px 80px}
        .tag-head{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:28px;margin-bottom:24px}
        .eyebrow{font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-weight:800}
        h1{font-size:clamp(2rem,5vw,3.4rem);letter-spacing:-.045em;margin:7px 0 8px;font-weight:850}
        .muted{color:var(--muted)}
        .card{height:100%;background:var(--surface);border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:transform .18s ease,box-shadow .18s ease}
        .card:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(0,0,0,.08)}
        .cover{width:100%;height:190px;object-fit:cover;background:var(--soft)}
        .card-body{padding:18px}
        .title{font-weight:800;font-size:1.08rem;line-height:1.3;color:var(--ink);text-decoration:none}
        .title:hover{color:var(--accent)}
        .author{font-size:.78rem;color:var(--muted);margin-top:12px}
        .empty{padding:55px 20px;text-align:center;background:var(--surface);border:1px dashed var(--line);border-radius:18px;color:var(--muted)}
        .pagination a{border:1px solid var(--line);color:var(--ink);background:var(--surface);border-radius:10px;padding:8px 12px;text-decoration:none}
        .pagination .active{background:var(--ink);color:var(--surface)}
        html[data-theme="dark"],html.dark,body.dark,[data-bs-theme="dark"]{--ink:#f1f3f5;--muted:#a8adb7;--line:#343842;--surface:#181b21;--soft:#242832;--page:#101216;--accent:#818cf8}
        @media(prefers-color-scheme:dark){html:not([data-theme="light"]){--ink:#f1f3f5;--muted:#a8adb7;--line:#343842;--surface:#181b21;--soft:#242832;--page:#101216;--accent:#818cf8}}
    </style>
</head>
<body>
    <%- include("./partials/nave") %>
    <main class="tag-page">
        <section class="tag-head">
            <div class="eyebrow">Topic</div>
            <h1>#<%= tag %></h1>
            <div class="muted"><%= blogs.length %> post<%= blogs.length === 1 ? '' : 's' %> on this topic</div>
        </section>

        <% if (!blogs.length) { %>
            <div class="empty">
                <h3>No posts found</h3>
                <p class="mb-0">There are no published posts for this topic yet.</p>
            </div>
        <% } else { %>
            <div class="row g-4">
                <% blogs.forEach(blog => { %>
                    <div class="col-12 col-md-6 col-lg-4">
                        <article class="card">
                            <% if (blog.coverImageURL) { %>
                                <a href="/blogs/<%= blog._id %>"><img class="cover" src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" loading="lazy" onerror="this.style.display='none'"></a>
                            <% } %>
                            <div class="card-body">
                                <a class="title d-block" href="/blogs/<%= blog._id %>"><%= blog.title %></a>
                                <% if (blog.excerpt) { %>
                                    <p class="muted small mt-2 mb-0"><%= blog.excerpt.length > 120 ? blog.excerpt.slice(0,120) + '…' : blog.excerpt %></p>
                                <% } %>
                                <% if (blog.createdBy) { %>
                                    <div class="author">By <%= blog.createdBy.fullName || 'Unknown author' %> · <%= blog.createdAt ? new Date(blog.createdAt).toLocaleDateString() : '' %></div>
                                <% } %>
                            </div>
                        </article>
                    </div>
                <% }) %>
            </div>

            <% if (totalPages > 1) { %>
                <nav class="pagination d-flex justify-content-center gap-2 mt-5" aria-label="Topic pagination">
                    <% if (currentPage > 1) { %><a href="/blogs/tags/<%= encodeURIComponent(tag) %>?page=<%= currentPage - 1 %>">Previous</a><% } %>
                    <% for(let p=1;p<=totalPages;p++){ %><a class="<%= p===currentPage?'active':'' %>" href="/blogs/tags/<%= encodeURIComponent(tag) %>?page=<%= p %>"><%= p %></a><% } %>
                    <% if (currentPage < totalPages) { %><a href="/blogs/tags/<%= encodeURIComponent(tag) %>?page=<%= currentPage + 1 %>">Next</a><% } %>
                </nav>
            <% } %>
        <% } %>
    </main>
</body>
</html>
