<!doctype html><html lang="en"><head><%- include("./partials/head") %><title>Messages & Privacy | Blogify</title><style>
.ms{max-width:900px;margin:auto;padding:28px 16px 80px}.ms-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}.ms-head h1{margin:0;font-size:2rem}.ms-head p{margin:5px 0;color:var(--muted)}.back{border:1px solid var(--border);background:var(--surface);color:var(--heading);padding:9px 14px;border-radius:11px;text-decoration:none;font-weight:700}.card{background:var(--surface);border:1px solid var(--border);border-radius:17px;overflow:hidden;margin-bottom:16px}.card h2{font-size:1.05rem;margin:0;padding:18px 19px 7px}.card>p{margin:0;padding:0 19px 12px;color:var(--muted);font-size:.82rem}.row{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:16px 19px;border-top:1px solid var(--border)}.title{font-weight:750}.desc{font-size:.78rem;color:var(--muted);margin-top:4px;line-height:1.4}.select{min-width:180px;padding:10px;border-radius:10px;border:1px solid var(--border);background:var(--surface);color:var(--heading)}.switch{position:relative;width:44px;height:25px;flex:none}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;background:#9299a6;border-radius:20px}.slider:before{content:"";position:absolute;width:19px;height:19px;left:3px;top:3px;background:white;border-radius:50%;transition:.2s}.switch input:checked+.slider{background:var(--primary)}.switch input:checked+.slider:before{transform:translateX(19px)}.saved{position:fixed;right:18px;bottom:18px;background:#111827;color:#fff;padding:10px 15px;border-radius:12px;opacity:0;transform:translateY(10px);transition:.2s;pointer-events:none}.saved.show{opacity:1;transform:none}@media(max-width:620px){.ms{padding:20px 11px 70px}.ms-head h1{font-size:1.6rem}.row{align-items:flex-start}.select{min-width:145px}.desc{max-width:240px}}
</style></head><body><%- include("./partials/nave") %><main class="ms"><header class="ms-head"><div><h1>Messages & Privacy</h1><p>Control who can contact you and how chats behave.</p></div><a class="back" href="/user/profile/settings#messaging">← Settings</a></header>
<section class="card"><h2>💬 Messaging</h2><p>Choose who can start a conversation with you.</p><div class="row"><div><div class="title">Who can message me</div><div class="desc">Controls who can start a new conversation.</div></div><select class="select" data-key="whoCanMessage"><option value="everyone">Everyone</option><option value="followers">Followers</option><option value="no_one">No one</option></select></div><div class="row"><div><div class="title">Message requests</div><div class="desc">Allow people outside your normal audience to send requests.</div></div><label class="switch"><input type="checkbox" data-key="messageRequests"><span class="slider"></span></label></div><div class="row"><div><div class="title">Allow photo messages</div><div class="desc">Allow images to be sent in conversations.</div></div><label class="switch"><input type="checkbox" data-key="allowPhotoMessages"><span class="slider"></span></label></div><div class="row"><div><div class="title">Allow video messages</div><div class="desc">Allow videos up to your application's media limit.</div></div><label class="switch"><input type="checkbox" data-key="allowVideoMessages"><span class="slider"></span></label></div><div class="row"><div><div class="title">Message likes</div><div class="desc">Allow reactions/likes on messages.</div></div><label class="switch"><input type="checkbox" data-key="messageLikes"><span class="slider"></span></label></div></section>
<section class="card"><h2>🔔 Chat notifications</h2><p>Control real-time chat indicators and alerts.</p><div class="row"><div><div class="title">Message notifications</div><div class="desc">Notify you when a new DM arrives.</div></div><label class="switch"><input type="checkbox" data-key="messageNotifications"><span class="slider"></span></label></div><div class="row"><div><div class="title">Message preview</div><div class="desc">Show message text in notification cards.</div></div><label class="switch"><input type="checkbox" data-key="messagePreview"><span class="slider"></span></label></div><div class="row"><div><div class="title">Notification sound</div><div class="desc">Play a sound for new messages.</div></div><label class="switch"><input type="checkbox" data-key="notificationSound"><span class="slider"></span></label></div><div class="row"><div><div class="title">Read receipts</div><div class="desc">Let people know when you have read their message.</div></div><label class="switch"><input type="checkbox" data-key="readReceipts"><span class="slider"></span></label></div><div class="row"><div><div class="title">Typing indicator</div><div class="desc">Show when you are typing.</div></div><label class="switch"><input type="checkbox" data-key="typingIndicator"><span class="slider"></span></label></div><div class="row"><div><div class="title">Online status</div><div class="desc">Control who can see when you are online.</div></div><select class="select" data-key="onlineStatus"><option value="everyone">Everyone</option><option value="followers">Followers</option><option value="off">Off</option></select></div></section>
<section class="card"><h2>📷 Media</h2><p>Control how media behaves in your chats.</p><div class="row"><div><div class="title">Media auto-download</div><div class="desc">Choose when received photos and videos may load automatically.</div></div><select class="select" data-key="mediaAutoDownload"><option value="wifi_mobile">Wi-Fi + Mobile</option><option value="wifi_only">Wi-Fi only</option><option value="never">Never</option></select></div></section>
<section class="card"><h2>🛡️ Privacy & safety</h2><p>Extra controls for conversations and requests.</p><div class="row"><div><div class="title">Group invitations</div><div class="desc">Choose who can invite you to group chats.</div></div><select class="select" data-key="groupInvites"><option value="everyone">Everyone</option><option value="followers">Followers</option><option value="no_one">No one</option></select></div><div class="row"><div><div class="title">Hidden words</div><div class="desc">Hide messages that may contain unwanted words or spam.</div></div><label class="switch"><input type="checkbox" data-key="hiddenWords"><span class="slider"></span></label></div><div class="row"><div><div class="title">Auto-delete messages</div><div class="desc">Automatically expire message history after the selected period.</div></div><select class="select" data-key="autoDelete"><option value="never">Never</option><option value="24h">24 hours</option><option value="7d">7 days</option><option value="30d">30 days</option></select></div></section></main><div id="saved" class="saved">✓ Settings saved</div><%- include("./partials/scripts") %><script>
(async()=>{const els=[...document.querySelectorAll('[data-key]')],saved=document.getElementById('saved');const get=async()=>{const r=await fetch('/messages/settings/api');if(!r.ok)throw new Error();const d=await r.json();const s=d.messageSettings||{};els.forEach(el=>{const v=s[el.dataset.key];if(el.type==='checkbox')el.checked=v!==false;else if(v!==undefined)el.value=v;});};const save=async(el)=>{const key=el.dataset.key;const value=el.type==='checkbox'?el.checked:el.value;const r=await fetch('/messages/settings/api',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({[key]:value})});if(!r.ok)throw new Error();saved.classList.add('show');setTimeout(()=>saved.classList.remove('show'),1200);};els.forEach(el=>el.addEventListener('change',()=>save(el).catch(()=>alert('Unable to save this setting.'))));try{await get();}catch(e){console.error(e);}})();
</script></body></html>