<!doctype html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <title><%= blog.title %> | Blogify</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    :root{--bg:#f7f8fb;--card:#fff;--text:#15171c;--muted:#707783;--line:#e5e7eb;--soft:#f1f3f7;--accent:#635bff;--danger:#e11d48;--dangerbg:#fff1f2;--shadow:0 14px 45px rgba(15,23,42,.08)}
    html[data-theme="dark"],html.dark,body.dark,[data-bs-theme="dark"]{--bg:#0b0d11;--card:#151820;--text:#f5f7fa;--muted:#9ca3af;--line:#2b303b;--soft:#1d212b;--accent:#818cf8;--danger:#fb7185;--dangerbg:#351923;--shadow:0 15px 45px rgba(0,0,0,.35)}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}button,input,textarea{font:inherit}.page{width:min(1240px,calc(100% - 28px));margin:auto;padding:28px 0 100px}.layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:32px}.article{min-width:0}.back{display:inline-flex;gap:7px;color:var(--muted);text-decoration:none;font-size:.85rem;margin-bottom:20px}.back:hover{color:var(--accent)}.category{display:inline-block;background:var(--soft);color:var(--accent);padding:7px 12px;border-radius:999px;font-size:.7rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.title{font-size:clamp(2.5rem,6vw,5.2rem);line-height:.98;letter-spacing:-.055em;margin:14px 0 18px;font-weight:900}.excerpt{font-size:1.12rem;line-height:1.75;color:var(--muted);max-width:820px}.authorbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:22px 0;border-bottom:1px solid var(--line);margin-bottom:28px}.author{display:flex;align-items:center;gap:11px;color:var(--text);text-decoration:none}.avatar{width:48px;height:48px;border-radius:50%;object-fit:cover;background:var(--soft)}.author strong{display:block;font-size:.9rem}.author small{color:var(--muted)}.actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:999px;padding:9px 14px;cursor:pointer;font-weight:800;text-decoration:none}.btn:hover{background:var(--soft)}.btn.danger{color:var(--danger)}.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}.cover{display:block;width:100%;max-height:650px;object-fit:cover;border-radius:22px;margin:0 0 30px;box-shadow:var(--shadow)}.video{width:100%;max-height:650px;border-radius:22px;background:#000;margin-bottom:30px}.body{font-size:1.12rem;line-height:1.95;overflow-wrap:anywhere}.body p{margin:0 0 1.5em}.body h1,.body h2,.body h3{line-height:1.2;margin:2em 0 .7em}.body img{max-width:100%;height:auto;border-radius:15px}.body a{color:var(--accent)}.body blockquote{padding:17px 20px;border-left:4px solid var(--accent);background:var(--soft);border-radius:0 12px 12px 0}.body pre{background:#0b0d10!important;color:#fff;padding:17px;border-radius:14px;overflow:auto}.tags{display:flex;gap:7px;flex-wrap:wrap;margin:30px 0}.tag{padding:7px 11px;border-radius:999px;background:var(--soft);border:1px solid var(--line);color:var(--text);text-decoration:none;font-size:.76rem}.engage{display:flex;gap:9px;flex-wrap:wrap;padding:18px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.engage button{border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:999px;padding:10px 15px;cursor:pointer;font-weight:850}.engage button:hover{background:var(--soft)}.engage .liked{color:var(--danger);background:var(--dangerbg);border-color:#fda4af}.engage button:disabled{opacity:.55;cursor:wait}.side{position:sticky;top:20px}.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:20px;margin-bottom:15px;box-shadow:var(--shadow)}.profile{text-align:center}.profile .avatar{width:82px;height:82px}.profile h3{margin:7px 0;font-size:1rem}.bio{color:var(--muted);font-size:.8rem;line-height:1.6}.stats{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:14px 0;margin:15px 0}.stats strong{display:block}.stats small{color:var(--muted)}.side h4{margin:0 0 10px}.row{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid var(--line);font-size:.82rem}.row span{color:var(--muted)}.story{display:block;text-decoration:none;color:var(--text);padding:10px 0;border-bottom:1px solid var(--line)}.story:last-child{border:0}.story strong{display:block;font-size:.82rem}.story small{color:var(--muted)}
    #commentsOverlay{position:fixed;inset:0;background:rgba(0,0,0,.58);backdrop-filter:blur(5px);z-index:5000;opacity:0;visibility:hidden;transition:.2s}#commentsOverlay.open{opacity:1;visibility:visible}#commentsPanel{position:fixed;z-index:5001;top:0;right:0;bottom:0;width:min(620px,100%);background:var(--card);color:var(--text);border-left:1px solid var(--line);transform:translateX(100%);transition:transform .3s cubic-bezier(.16,1,.3,1);display:flex;flex-direction:column}#commentsPanel.open{transform:translateX(0)}.chead{display:flex;align-items:center;justify-content:space-between;padding:17px 18px;border-bottom:1px solid var(--line)}.chead h3{margin:0;font-size:1rem}.close{width:38px;height:38px;border:0;border-radius:50%;background:var(--soft);color:var(--text);cursor:pointer}.ctool{padding:9px 18px;border-bottom:1px solid var(--line);color:var(--muted);font-size:.75rem}.clist{flex:1;overflow:auto;padding:5px 18px 20px}.comment{padding:15px 2px;border-bottom:1px solid var(--line)}.crow{display:flex;gap:10px}.cavatar{width:38px;height:38px;border-radius:50%;object-fit:cover;background:var(--soft);flex:0 0 auto}.cbody{min-width:0;flex:1}.ctop{display:flex;gap:7px;align-items:baseline;flex-wrap:wrap}.cauthor{font-size:.82rem;font-weight:900}.ctime{font-size:.7rem;color:var(--muted)}.ctext{white-space:pre-wrap;word-break:break-word;line-height:1.55;font-size:.88rem;margin:5px 0 7px}.cactions{display:flex;gap:12px}.caction{border:0;background:transparent;color:var(--muted);padding:2px 0;cursor:pointer;font-size:.74rem}.caction:hover,.caction.liked{color:var(--accent)}.replies{margin:10px 0 0 46px;padding-left:12px;border-left:2px solid var(--line)}.replybox{display:none;margin:8px 0 0 46px;gap:7px}.replybox.open{display:flex}.replybox textarea,.composer textarea{flex:1;border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:10px;padding:9px;resize:none;outline:0}.replybox button,.composer button{border:0;background:var(--accent);color:#fff;border-radius:10px;padding:0 13px;cursor:pointer}.composer{border-top:1px solid var(--line);padding:12px 15px;display:flex;gap:8px}.composer img{width:38px;height:38px;border-radius:50%;object-fit:cover}.composer textarea{min-height:42px;max-height:110px}.loginbox{text-align:center;padding:15px;color:var(--muted);border-top:1px solid var(--line)}.loginbox a{color:var(--accent)}.state{text-align:center;color:var(--muted);padding:55px 10px}.fab{position:fixed;right:22px;bottom:22px;z-index:4900;width:56px;height:56px;border:0;border-radius:50%;background:var(--text);color:var(--card);box-shadow:0 10px 35px rgba(0,0,0,.2);cursor:pointer}.badge{position:absolute;right:-4px;top:-4px;min-width:21px;height:21px;padding:0 5px;display:grid;place-items:center;background:var(--danger);color:#fff;border:2px solid var(--card);border-radius:99px;font-size:.65rem}.toastmsg{position:fixed;right:18px;top:18px;z-index:9999;padding:12px 15px;border-radius:12px;background:var(--text);color:var(--card);box-shadow:var(--shadow);display:none;max-width:330px}.toastmsg.show{display:block}@media(max-width:950px){.layout{grid-template-columns:1fr}.side{position:static}.page{width:min(900px,calc(100% - 22px))}}@media(max-width:600px){.page{padding-top:18px}.title{font-size:2.7rem}.authorbar{align-items:flex-start;flex-direction:column}.actions{width:100%}.actions .btn{flex:1}.fab{right:15px;bottom:15px}.comments-panel{width:100%}.replies,.replybox{margin-left:30px}}
  </style>
</head>
<body>
  <%- include("./partials/nave") %>
  <main class="page">
    <div class="layout">
      <article class="article">
        <a class="back" href="/"><i class="fas fa-arrow-left"></i> Back to stories</a>
        <% if (blog.category) { %><div class="category"><%= blog.category %></div><% } %>
        <h1 class="title"><%= blog.title %></h1>
        <% if (blog.excerpt) { %><p class="excerpt"><%= blog.excerpt %></p><% } %>
        <div class="authorbar">
          <a class="author" href="/user/profile/<%= blog.createdBy._id %>"><img class="avatar" src="<%= blog.createdBy.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'" alt=""><span><strong><%= blog.createdBy.fullName %></strong><small><%= formatDate(blog.createdAt) %> · <%= blog.readingTime || 1 %> min read</small></span></a>
          <% if (user && String(user._id) === String(blog.createdBy._id)) { %><div class="actions"><a class="btn" href="/blogs/<%= blog._id %>/edit"><i class="fas fa-pen"></i> Edit</a><button id="deleteBlogBtn" class="btn danger" type="button"><i class="fas fa-trash"></i> Delete</button></div><% } %>
        </div>
        <% if (blog.mediaType === 'video' && blog.videoURL) { %><video class="video" controls playsinline preload="metadata" src="<%= blog.videoURL %>"></video><% } else if (blog.coverImageURL) { %><img class="cover" src="<%= blog.coverImageURL %>" onerror="this.style.display='none'" alt="<%= blog.title %>"><% } %>
        <div class="body"><%- renderMarkdown(blog.body) %></div>
        <% if (blog.tags && blog.tags.length) { %><div class="tags"><% blog.tags.forEach(function(tag){ %><a class="tag" href="/blogs/tags/<%= tag %>">#<%= tag %></a><% }) %></div><% } %>
        <div class="engage"><button id="likeBtn" type="button" class="<%= hasLiked ? 'liked' : '' %>"><i id="likeIcon" class="<%= hasLiked ? 'fas' : 'far' %> fa-heart"></i> <span id="likeCount"><%= blog.likes ? blog.likes.length : 0 %></span> Likes</button><button id="commentBtn" type="button"><i class="far fa-comment"></i> <span id="commentCount">0</span> Comments</button><button id="shareBtn" type="button"><i class="fas fa-share-nodes"></i> Share</button></div>
      </article>
      <aside class="side">
        <div class="card profile"><img class="avatar" src="<%= blog.createdBy.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'" alt=""><h3><%= blog.createdBy.fullName %></h3><p class="bio"><%= blog.createdBy.bio || 'Writer on Blogify' %></p><div class="stats"><div><strong><%= blog.createdBy.followers ? blog.createdBy.followers.length : 0 %></strong><small>Followers</small></div><div><strong><%= authorBlogs ? authorBlogs.length : 0 %></strong><small>Posts</small></div></div><% if (user && String(user._id) !== String(blog.createdBy._id)) { %><button id="followBtn" class="btn primary" type="button" style="width:100%"><i class="fas fa-user-plus"></i> Follow</button><% } %></div>
        <div class="card"><h4>Article</h4><div class="row"><span>Views</span><strong><%= blog.viewCount || 0 %></strong></div><div class="row"><span>Likes</span><strong id="sideLikes"><%= blog.likes ? blog.likes.length : 0 %></strong></div></div>
        <% if (authorBlogs && authorBlogs.length) { %><div class="card"><h4>More from <%= blog.createdBy.fullName %></h4><% authorBlogs.slice(0,5).forEach(function(b){ %><a class="story" href="/blogs/<%= b._id %>"><strong><%= truncate(b.title,55) %></strong><small><%= formatDate(b.createdAt) %></small></a><% }) %></div><% } %>
        <% if (relatedBlogs && relatedBlogs.length) { %><div class="card"><h4>Related stories</h4><% relatedBlogs.slice(0,5).forEach(function(b){ %><a class="story" href="/blogs/<%= b._id %>"><strong><%= truncate(b.title,55) %></strong><small><%= formatDate(b.createdAt) %></small></a><% }) %></div><% } %>
      </aside>
    </div>
  </main>
  <button id="commentFab" class="fab" type="button" aria-label="Open comments"><i class="far fa-comment"></i><span id="commentBadge" class="badge">0</span></button>
  <div id="commentsOverlay"></div>
  <section id="commentsPanel" aria-label="Comments" aria-hidden="true"><header class="chead"><h3><i class="fas fa-comments"></i> Comments <span id="panelCount">0</span></h3><button id="closeComments" class="close" type="button"><i class="fas fa-times"></i></button></header><div class="ctool"><span id="commentStatus">Loading conversation…</span></div><div id="commentsList" class="clist"><div class="state"><i class="fas fa-spinner fa-spin fa-2x"></i><p>Loading comments…</p></div></div><% if (user) { %><form id="commentForm" class="composer"><img src="<%= user.profileImageURL || '/imgs/default.png' %>" onerror="this.src='/imgs/default.png'" alt=""><textarea id="commentInput" maxlength="5000" required placeholder="Write a comment…"></textarea><button id="commentSend" type="submit"><i class="fas fa-paper-plane"></i></button></form><% } else { %><div class="loginbox"><a href="/user/signin">Sign in</a> to join the conversation.</div><% } %></section>
  <div id="toast" class="toastmsg"></div>
  <%- include("./partials/scripts") %>
  <script>
  (function(){
    'use strict';
    const blogId=<%- JSON.stringify(String(blog._id)) %>,userId=<%- JSON.stringify(user?String(user._id):'') %>,authorId=<%- JSON.stringify(String(blog.createdBy._id)) %>;
    let comments=[];const $=id=>document.getElementById(id);
    const toast=t=>{const e=$('toast');if(!e)return;e.textContent=t;e.classList.add('show');clearTimeout(window.__bt);window.__bt=setTimeout(()=>e.classList.remove('show'),2800)};
    const err=(e,f)=>e?.response?.data?.message||e?.message||f;
    const esc=v=>{const d=document.createElement('div');d.textContent=v==null?'':String(v);return d.innerHTML};
    const ago=v=>{const n=new Date(v).getTime();if(!n)return'';let s=Math.max(0,Math.floor((Date.now()-n)/1000));return s<60?'just now':s<3600?Math.floor(s/60)+'m':s<86400?Math.floor(s/3600)+'h':s<2592000?Math.floor(s/86400)+'d':Math.floor(s/2592000)+'mo'};
    const find=id=>{let out=null;const walk=a=>{for(const c of a||[]){if(String(c._id)===String(id)){out=c;return}walk(c.replies)}};walk(comments);return out};
    const isLiked=c=>(c.likes||[]).some(x=>String(x)===userId);
    function render(c){if(!c||c.isDeleted)return'';const own=userId&&c.author&&String(c.author._id)===userId,liked=isLiked(c),replies=(c.replies||[]).filter(x=>!x.isDeleted);let h='<div class="comment" id="comment-'+esc(c._id)+'"><div class="crow"><img class="cavatar" src="'+esc(c.author?.profileImageURL||'/imgs/default.png')+'" onerror="this.src=\'/imgs/default.png\'" alt=""><div class="cbody"><div class="ctop"><span class="cauthor">'+esc(c.author?.fullName||'User')+'</span><span class="ctime">'+ago(c.createdAt)+'</span></div><div class="ctext">'+esc(c.content)+'</div><div class="cactions"><button class="caction '+(liked?'liked':'')+'" type="button" data-action="like" data-id="'+esc(c._id)+'"><i class="'+(liked?'fas':'far')+' fa-heart"></i> '+(c.likes||[]).length+'</button>';
      if(userId)h+='<button class="caction" type="button" data-action="reply" data-id="'+esc(c._id)+'"><i class="fas fa-reply"></i> Reply</button>';
      if(own)h+='<button class="caction" type="button" data-action="edit" data-id="'+esc(c._id)+'"><i class="fas fa-pen"></i> Edit</button><button class="caction" type="button" data-action="delete" data-id="'+esc(c._id)+'"><i class="fas fa-trash"></i> Delete</button>';
      h+='</div></div></div>';
      if(userId)h+='<div class="replybox" id="replybox-'+esc(c._id)+'"><textarea id="reply-'+esc(c._id)+'" maxlength="5000" rows="1" placeholder="Write a reply…"></textarea><button type="button" data-action="send-reply" data-id="'+esc(c._id)+'"><i class="fas fa-paper-plane"></i></button></div>';
      if(replies.length)h+='<div class="replies">'+replies.map(render).join('')+'</div>';
      return h+'</div>';
    }
    const setCount=n=>['commentCount','commentBadge','panelCount'].forEach(id=>$(id)&&($(id).textContent=Number(n)||0));
    async function loadComments(){const list=$('commentsList');try{list.innerHTML='<div class="state"><i class="fas fa-spinner fa-spin fa-2x"></i><p>Loading comments…</p></div>';const r=await axios.get('/comments/blog/'+encodeURIComponent(blogId),{params:{limit:50}});if(!r.data?.success)throw new Error(r.data?.message||'Failed to load comments');comments=Array.isArray(r.data.comments)?r.data.comments:[];setCount(r.data.total);$('commentStatus').textContent=comments.length?'Join the conversation':'Be the first to comment';list.innerHTML=comments.length?comments.map(render).join(''):'<div class="state"><i class="far fa-comments fa-3x"></i><p>No comments yet.</p></div>'}catch(e){console.error('comments:',e);$('commentStatus').textContent='Could not load comments';list.innerHTML='<div class="state"><i class="fas fa-triangle-exclamation fa-2x"></i><p>Unable to load comments.</p><button id="retryComments" class="btn" type="button">Retry</button></div>';$('retryComments')?.addEventListener('click',loadComments)}}
    function openComments(){const p=$('commentsPanel'),o=$('commentsOverlay');p.classList.add('open');o.classList.add('open');p.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';loadComments()}
    function closeComments(){const p=$('commentsPanel'),o=$('commentsOverlay');p.classList.remove('open');o.classList.remove('open');p.setAttribute('aria-hidden','true');document.body.style.overflow=''}
    async function post(content,parent){if(!userId){location.href='/user/signin';return}const r=await axios.post('/comments/blog/'+encodeURIComponent(blogId),{content:content,parentCommentId:parent||undefined});if(!r.data?.success)throw new Error(r.data?.message||'Failed to post comment')}
    async function blogLike(){if(!userId){location.href='/user/signin';return}const b=$('likeBtn');b.disabled=true;try{const r=await axios.post('/blogs/'+encodeURIComponent(blogId)+'/like');if(!r.data?.success)throw new Error(r.data?.message||'Failed to like blog');const liked=!!r.data.liked,n=Number(r.data.likeCount)||0;b.classList.toggle('liked',liked);$('likeIcon').className=(liked?'fas':'far')+' fa-heart';$('likeCount').textContent=n;$('sideLikes').textContent=n}catch(e){console.error(e);toast(err(e,'Failed to like blog'))}finally{b.disabled=false}}
    async function deleteBlog(){if(!userId||userId!==authorId)return toast('You are not allowed to delete this blog');if(!confirm('Delete this blog?'))return;const b=$('deleteBlogBtn');b.disabled=true;try{const r=await axios.delete('/blogs/'+encodeURIComponent(blogId));if(!r.data?.success)throw new Error(r.data?.message||'Failed to delete blog');toast('Blog deleted');setTimeout(()=>location.href='/',500)}catch(e){console.error(e);toast(err(e,'Failed to delete blog'));b.disabled=false}}
    async function likeComment(id){if(!userId){location.href='/user/signin';return}try{const r=await axios.post('/comments/'+encodeURIComponent(id)+'/like');if(!r.data?.success)throw new Error(r.data?.message);const c=find(id);if(c){c.likes=c.likes||[];if(r.data.liked&&!isLiked(c))c.likes.push(userId);if(!r.data.liked)c.likes=c.likes.filter(x=>String(x)!==userId)}await loadComments()}catch(e){toast(err(e,'Failed to like comment'))}}
    async function editComment(id){const c=find(id);if(!c)return;const value=prompt('Edit comment',c.content||'');if(value===null||!value.trim())return;try{const r=await axios.put('/comments/'+encodeURIComponent(id),{content:value.trim()});if(!r.data?.success)throw new Error(r.data?.message);await loadComments();toast('Comment updated')}catch(e){toast(err(e,'Failed to edit comment'))}}
    async function deleteComment(id){if(!confirm('Delete this comment?'))return;try{const r=await axios.delete('/comments/'+encodeURIComponent(id));if(!r.data?.success)throw new Error(r.data?.message);await loadComments();toast('Comment deleted')}catch(e){toast(err(e,'Failed to delete comment'))}}
    async function follow(){if(!userId){location.href='/user/signin';return}const b=$('followBtn');b.disabled=true;try{const r=await axios.post('/follow/'+encodeURIComponent(authorId)+'/follow');if(!r.data?.success)throw new Error(r.data?.message);b.innerHTML=r.data.following?'<i class="fas fa-user-check"></i> Following':'<i class="fas fa-user-plus"></i> '+(r.data.pending?'Requested':'Follow');toast(r.data.message||'Follow updated')}catch(e){toast(err(e,'Failed to update follow'))}finally{b.disabled=false}}
    async function share(){try{if(navigator.share)await navigator.share({title:<%- JSON.stringify(blog.title) %>,url:location.href});else{await navigator.clipboard.writeText(location.href);toast('Link copied')}}catch(e){if(e.name!=='AbortError')toast('Unable to share')}}
    document.addEventListener('DOMContentLoaded',()=>{
      $('commentBtn')?.addEventListener('click',openComments);$('commentFab')?.addEventListener('click',openComments);$('closeComments')?.addEventListener('click',closeComments);$('commentsOverlay')?.addEventListener('click',closeComments);$('likeBtn')?.addEventListener('click',blogLike);$('deleteBlogBtn')?.addEventListener('click',deleteBlog);$('followBtn')?.addEventListener('click',follow);$('shareBtn')?.addEventListener('click',share);
      $('commentForm')?.addEventListener('submit',async e=>{e.preventDefault();const input=$('commentInput'),send=$('commentSend'),content=input.value.trim();if(!content)return;send.disabled=true;try{await post(content);input.value='';await loadComments();toast('Comment posted')}catch(x){console.error(x);toast(err(x,'Failed to post comment'))}finally{send.disabled=false}});
      $('commentsList').addEventListener('click',async e=>{const b=e.target.closest('[data-action]');if(!b)return;const id=b.dataset.id,a=b.dataset.action;if(a==='like')return likeComment(id);if(a==='edit')return editComment(id);if(a==='delete')return deleteComment(id);if(a==='reply'){document.querySelectorAll('.replybox').forEach(x=>x.classList.remove('open'));$('replybox-'+id)?.classList.add('open');$('reply-'+id)?.focus();return}if(a==='send-reply'){const input=$('reply-'+id),content=input?.value.trim();if(!content)return;b.disabled=true;try{await post(content,id);input.value='';await loadComments();toast('Reply posted')}catch(x){toast(err(x,'Failed to post reply'))}finally{b.disabled=false}}});
      document.addEventListener('keydown',e=>{if(e.key==='Escape')closeComments()});
    });
  })();
  </script>
</body>
</html>
