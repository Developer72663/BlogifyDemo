<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head") %>
    <title><%= blog.title %> | Blogify</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root{--ink:#17181c;--muted:#70737b;--line:#e7e8eb;--surface:#fff;--soft:#f6f7f9;--accent:#6366f1;--page:#fafaf9;--input:#fff;--code:#17181c;--code-inline:#f0f1f3;--danger-soft:#fff1f2;--danger-border:#fecdd3;--comment-line:#f0f1f3;--reply-line:#eceef2}
        body{background:var(--page);color:var(--ink)}.reader{max-width:1180px;margin:auto;padding:28px 18px 90px}.article-shell{max-width:820px;margin:auto}.article-head{padding:25px 0 28px;border-bottom:1px solid var(--line)}.back{color:var(--muted);text-decoration:none;font-size:.85rem}.back:hover{color:var(--accent)}.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:.7rem;font-weight:800;color:var(--muted);margin-top:20px}.article-title{font-size:clamp(2.2rem,5vw,4.2rem);line-height:1.02;letter-spacing:-.055em;font-weight:850;margin:10px 0 20px;color:var(--ink)}.article-excerpt{font-size:1.1rem;line-height:1.7;color:var(--muted);max-width:720px}.author-row{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:24px}.author{display:flex;align-items:center;gap:11px;text-decoration:none;color:inherit}.author img{width:44px;height:44px;border-radius:50%;object-fit:cover}.author-name{font-weight:800;font-size:.9rem}.author-meta{font-size:.76rem;color:var(--muted)}.hero{width:100%;max-height:560px;object-fit:cover;border-radius:20px;margin:30px 0;background:var(--soft)}.article-body{font-size:1.13rem;line-height:1.95;color:var(--ink);overflow-wrap:anywhere}.article-body p{margin:0 0 1.6em}.article-body h1,.article-body h2,.article-body h3{line-height:1.2;letter-spacing:-.025em;margin:2.2em 0 .8em;color:var(--ink)}.article-body h1{font-size:2.3rem}.article-body h2{font-size:1.8rem;border-top:1px solid var(--line);padding-top:1.3em}.article-body h3{font-size:1.4rem}.article-body a{color:var(--accent)}.article-body strong,.article-body b{color:var(--ink)}.article-body img{max-width:100%;height:auto;border-radius:14px;margin:1.8em 0}.article-body blockquote{border-left:4px solid var(--accent);background:var(--soft);color:var(--ink);padding:18px 22px;margin:1.8em 0;border-radius:0 12px 12px 0}.article-body table{width:100%;border-collapse:collapse;margin:1.8em 0;color:var(--ink)}.article-body th,.article-body td{padding:11px;border-bottom:1px solid var(--line);text-align:left}.article-body th{font-weight:800}.article-body pre{background:var(--code)!important;color:#f8fafc;border-radius:14px;padding:18px;overflow:auto;max-height:600px}.article-body pre code{color:inherit;background:transparent}.article-body code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.article-body p code,.article-body li code{background:var(--code-inline);padding:2px 6px;border-radius:5px;color:#b4235a}.engagement{display:flex;align-items:center;gap:10px;padding:22px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:35px}.engage-btn{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:10px 16px;font-weight:750;color:var(--ink);cursor:pointer}.engage-btn:hover{background:var(--soft)}.engage-btn.liked{color:#e11d48;border-color:var(--danger-border);background:var(--danger-soft)}.engage-btn i{margin-right:6px}.tags{padding:22px 0;border-bottom:1px solid var(--line)}.tag{display:inline-block;background:var(--soft);color:var(--ink);text-decoration:none;border-radius:999px;padding:7px 11px;font-size:.75rem;margin:4px;border:1px solid transparent}.tag:hover{color:var(--accent);border-color:var(--line)}.side{position:sticky;top:20px}.side-card{background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:18px;padding:20px;margin-bottom:15px}.side-avatar{width:72px;height:72px;border-radius:50%;object-fit:cover}.side-title{font-weight:800;color:var(--ink)}.stat{font-weight:800;color:var(--ink)}.muted{color:var(--muted);font-size:.8rem}.mini-link{display:block;padding:11px 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--ink)}.mini-link:last-child{border:0}.mini-link strong{color:inherit}.mini-link:hover{color:var(--accent)}.comment-fab{position:fixed;right:24px;bottom:24px;width:58px;height:58px;border:0;border-radius:50%;background:var(--ink);color:var(--surface);box-shadow:0 10px 30px rgba(0,0,0,.2);z-index:900;cursor:pointer}.comment-fab:hover{transform:translateY(-2px)}.comment-badge{position:absolute;right:-3px;top:-3px;background:#e11d48;color:#fff;border:2px solid var(--surface);border-radius:999px;min-width:22px;height:22px;font-size:.68rem;display:grid;place-items:center}.overlay{position:fixed;inset:0;background:rgba(15,18,25,.52);backdrop-filter:blur(4px);z-index:1000;opacity:0;visibility:hidden;transition:.25s}.overlay.open{opacity:1;visibility:visible}.comment-sheet{position:fixed;z-index:1001;right:0;bottom:0;width:min(620px,100%);height:min(88vh,780px);background:var(--surface);color:var(--ink);border-radius:22px 22px 0 0;transform:translateY(100%);transition:.35s cubic-bezier(.16,1,.3,1);display:flex;flex-direction:column;box-shadow:0 -20px 60px rgba(0,0,0,.18)}.comment-sheet.open{transform:translateY(0)}.sheet-head{display:flex;justify-content:space-between;align-items:center;padding:18px 20px;border-bottom:1px solid var(--line)}.sheet-head h3{font-size:1rem;margin:0;font-weight:850;color:var(--ink)}.close{width:36px;height:36px;border:0;border-radius:50%;background:var(--soft);color:var(--ink);cursor:pointer}.comments-scroll{flex:1;overflow:auto;padding:12px 18px}.comment{padding:14px 4px;border-bottom:1px solid var(--comment-line)}.comment-main{display:flex;gap:10px}.comment-avatar{width:36px;height:36px;border-radius:50%;object-fit:cover;flex:0 0 auto}.comment-author{font-size:.85rem;font-weight:800;color:var(--ink)}.comment-time{font-size:.7rem;color:var(--muted)}.comment-text{font-size:.88rem;line-height:1.55;margin:5px 0 7px;white-space:pre-wrap;word-break:break-word;color:var(--ink)}.comment-actions{display:flex;gap:12px}.comment-action{border:0;background:none;padding:3px 0;color:var(--muted);font-size:.75rem;cursor:pointer}.comment-action:hover{color:var(--accent)}.comment-action.liked{color:#e11d48}.replies{margin:10px 0 0 45px;padding-left:12px;border-left:2px solid var(--reply-line)}.reply-box{display:none;margin:9px 0 0 45px;gap:7px}.reply-box.open{display:flex}.reply-box textarea,.composer textarea{border:1px solid var(--line);border-radius:11px;padding:9px 11px;resize:none;outline:0;font:inherit;flex:1;background:var(--input);color:var(--ink)}.reply-box textarea::placeholder,.composer textarea::placeholder{color:var(--muted);opacity:1}.reply-box button,.composer button{border:0;border-radius:10px;background:var(--ink);color:var(--surface);padding:0 13px;cursor:pointer}.composer{border-top:1px solid var(--line);padding:13px 18px;display:flex;gap:9px;background:var(--surface);color:var(--ink)}.composer img{width:38px;height:38px;border-radius:50%;object-fit:cover}.composer textarea{min-height:42px;max-height:110px}.login-comment{text-align:center;padding:12px;color:var(--muted)}.login-comment a{color:var(--accent)}.empty-comments{text-align:center;color:var(--muted);padding:60px 10px}.empty-comments h5,.empty-comments p{color:inherit}.loading{text-align:center;padding:50px;color:var(--muted)}
        /* Blogify dark-theme compatibility. Supports common data-theme/class based theme switches. */
        html[data-theme="dark"],html.dark,body.dark,[data-bs-theme="dark"]{--ink:#f1f3f5;--muted:#a8adb7;--line:#343842;--surface:#181b21;--soft:#242832;--page:#101216;--input:#20242c;--code:#0b0d10;--code-inline:#2a2e37;--comment-line:#30343d;--reply-line:#3a3f49;--danger-soft:#351923;--danger-border:#70263a}
        @media(prefers-color-scheme:dark){html:not([data-theme="light"]){--ink:#f1f3f5;--muted:#a8adb7;--line:#343842;--surface:#181b21;--soft:#242832;--page:#101216;--input:#20242c;--code:#0b0d10;--code-inline:#2a2e37;--comment-line:#30343d;--reply-line:#3a3f49;--danger-soft:#351923;--danger-border:#70263a}}
        @media(max-width:991px){.side{position:static;margin-top:30px}}
        @media(max-width:600px){.reader{padding:15px 13px 80px}.article-title{font-size:2.5rem}.author-row{align-items:flex-start}.hero{border-radius:13px;margin:20px 0}.article-body{font-size:1.03rem}.comment-fab{right:16px;bottom:16px}.comment-sheet{height:92vh;border-radius:18px 18px 0 0}.replies{margin-left:30px}.reply-box{margin-left:30px}}
    </style>
</head>
<body>
    <%- include("./partials/nave") %>
    <main class="reader"><div class="row g-5"><div class="col-lg-8"><article class="article-shell"><a class="back" href="/"><i class="fas fa-arrow-left me-1"></i> Back to stories</a><header class="article-head"><% if (blog.category) { %><div class="eyebrow"><%= blog.category %></div><% } %><h1 class="article-title"><%= blog.title %></h1><% if (blog.excerpt) { %><p class="article-excerpt"><%= blog.excerpt %></p><% } %><div class="author-row"><a class="author" href="/user/profile/<%= blog.createdBy._id %>"><img src="<%= blog.createdBy.profileImageURL || '/imgs/default.png' %>" alt="" onerror="this.src='/imgs/default.png'"><span><span class="author-name d-block"><%= blog.createdBy.fullName %></span><span class="author-meta"><%= formatDate(blog.createdAt) %> · <%= blog.readingTime || 1 %> min read</span></span></a><% if (locals.user && locals.user._id.toString() === blog.createdBy._id.toString()) { %><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-secondary rounded-pill" href="/blogs/<%= blog._id %>/edit">Edit</a><button class="btn btn-sm btn-outline-danger rounded-pill" onclick="deleteBlog()">Delete</button></div><% } %></div></header><% if (blog.coverImageURL) { %><img class="hero" src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" onerror="this.style.display='none'"><% } %><div class="article-body"><%- renderMarkdown(blog.body) %></div><% if (blog.tags?.length) { %><div class="tags"><strong class="small d-block mb-2">Topics</strong><% blog.tags.forEach(tag=>{ %><a class="tag" href="/blogs/tags/<%= tag %>">#<%= tag %></a><% }) %></div><% } %><div class="engagement"><button id="likeBtn" class="engage-btn <%= hasLiked ? 'liked':'' %>" onclick="toggleBlogLike()"><i class="<%= hasLiked ? 'fas':'far' %> fa-heart"></i><span id="likeCount"><%= blog.likes?.length || 0 %></span> Likes</button><button class="engage-btn" onclick="openComments()"><i class="far fa-comment"></i><span id="commentCount">0</span> Comments</button><button class="engage-btn" onclick="shareBlog()"><i class="fas fa-share-nodes"></i> Share</button></div></article></div><aside class="col-lg-4"><div class="side"><div class="side-card text-center"><img class="side-avatar mb-3" src="<%= blog.createdBy.profileImageURL || '/imgs/default.png' %>" alt="" onerror="this.src='/imgs/default.png'"><div class="side-title"><%= blog.createdBy.fullName %></div><p class="muted mt-1"><%= blog.createdBy.bio || 'Writer on Blogify' %></p><div class="row border-top border-bottom py-3 my-3"><div class="col"><div class="stat"><%= blog.createdBy.followers?.length || 0 %></div><div class="muted">Followers</div></div><div class="col"><div class="stat"><%= authorBlogs?.length || 0 %></div><div class="muted">Posts</div></div></div><% if (locals.user && locals.user._id.toString() !== blog.createdBy._id.toString()) { %><button id="followBtn" class="btn btn-dark rounded-pill w-100" onclick="toggleFollow()"><i class="fas fa-user-plus me-1"></i><span>Follow</span></button><% } %></div><div class="side-card"><div class="side-title mb-3">Article</div><div class="d-flex justify-content-between mb-2"><span class="muted">Views</span><strong><%= blog.viewCount || 0 %></strong></div><div class="d-flex justify-content-between"><span class="muted">Likes</span><strong id="sideLikes"><%= blog.likes?.length || 0 %></strong></div></div><% if (authorBlogs?.length) { %><div class="side-card"><div class="side-title mb-2">More from <%= blog.createdBy.fullName %></div><% authorBlogs.slice(0,5).forEach(b=>{ %><a class="mini-link" href="/blogs/<%= b._id %>"><strong class="small d-block"><%= truncate(b.title,55) %></strong><span class="muted"><%= formatDate(b.createdAt) %></span></a><% }) %></div><% } %><% if (relatedBlogs?.length) { %><div class="side-card"><div class="side-title mb-2">Related stories</div><% relatedBlogs.slice(0,5).forEach(b=>{ %><a class="mini-link" href="/blogs/<%= b._id %>"><strong class="small d-block"><%= truncate(b.title,55) %></strong><span class="muted"><%= formatDate(b.createdAt) %></span></a><% }) %></div><% } %></div></aside></div></main>
    <button class="comment-fab" onclick="openComments()" aria-label="Open comments"><i class="far fa-comment"></i><span class="comment-badge" id="fabCount">0</span></button><div class="overlay" id="overlay" onclick="closeComments()"></div><section class="comment-sheet" id="commentSheet" aria-label="Comments"><header class="sheet-head"><h3><i class="fas fa-comments me-2"></i>Comments <span id="sheetCount">0</span></h3><button class="close" onclick="closeComments()"><i class="fas fa-times"></i></button></header><div class="comments-scroll" id="commentsList"><div class="loading"><i class="fas fa-spinner fa-spin fa-2x"></i></div></div><% if (locals.user) { %><div class="composer"><img src="<%= locals.user.profileImageURL || '/imgs/default.png' %>" alt=""><textarea id="commentInput" placeholder="Share your thoughts..." maxlength="5000"></textarea><button id="commentSend" onclick="postComment()"><i class="fas fa-paper-plane"></i></button></div><% } else { %><div class="login-comment"><a href="/user/signin">Sign in</a> to join the conversation.</div><% } %></section>
    <%- include("./partials/scripts") %>
    <script>
        const blogId='<%= blog._id %>',userId='<%= locals.user ? locals.user._id : "" %>',authorId='<%= blog.createdBy._id %>';let comments=[];
        const esc=v=>{const d=document.createElement('div');d.textContent=v??'';return d.innerHTML};const ago=d=>{const s=Math.max(0,(Date.now()-new Date(d).getTime())/1000);if(s<60)return'Just now';if(s<3600)return Math.floor(s/60)+'m';if(s<86400)return Math.floor(s/3600)+'h';if(s<2592000)return Math.floor(s/86400)+'d';return Math.floor(s/2592000)+'mo'};const findComment=id=>{let f=null;const walk=a=>{for(const c of a){if(String(c._id)===String(id)){f=c;return}walk(c.replies||[]);if(f)return}};walk(comments);return f};
        function renderComment(c,reply=false){if(!c||c.isDeleted)return'';const liked=(c.likes||[]).some(x=>String(x)===String(userId)),own=userId&&String(c.author?._id)===String(userId),replies=(c.replies||[]).filter(x=>!x.isDeleted);return `<div class="comment" id="comment-${c._id}"><div class="comment-main"><img class="comment-avatar" src="${c.author?.profileImageURL||'/imgs/default.png'}" onerror="this.src='/imgs/default.png'" alt=""><div class="flex-grow-1"><div><span class="comment-author">${esc(c.author?.fullName||'User')}</span> <span class="comment-time">${ago(c.createdAt)}</span></div><div class="comment-text" id="comment-text-${c._id}">${esc(c.content)}</div><div class="comment-actions"><button class="comment-action ${liked?'liked':''}" onclick="likeComment('${c._id}')"><i class="${liked?'fas':'far'} fa-heart"></i> <span>${(c.likes||[]).length}</span></button>${userId?`<button class="comment-action" onclick="showReply('${c._id}')"><i class="fas fa-reply"></i> Reply</button>`:''}${own?`<button class="comment-action" onclick="editComment('${c._id}')"><i class="fas fa-pen"></i> Edit</button><button class="comment-action" onclick="deleteComment('${c._id}')"><i class="fas fa-trash"></i> Delete</button>`:''}</div></div></div>${userId?`<div class="reply-box" id="reply-box-${c._id}"><textarea id="reply-${c._id}" rows="1" maxlength="5000" placeholder="Write a reply..."></textarea><button onclick="postReply('${c._id}')"><i class="fas fa-paper-plane"></i></button></div>`:''}${replies.length?`<div class="replies">${replies.map(r=>renderComment(r,true)).join('')}</div>`:''}</div>`}
        async function loadComments(){const list=document.getElementById('commentsList');list.innerHTML='<div class="loading"><i class="fas fa-spinner fa-spin fa-2x"></i></div>';try{const r=await axios.get('/comments/blog/'+blogId+'?limit=50');if(!r.data.success)throw new Error(r.data.message);comments=r.data.comments||[];const count=r.data.total||0;['commentCount','fabCount','sheetCount'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent=count});list.innerHTML=comments.length?comments.map(c=>renderComment(c)).join(''):'<div class="empty-comments"><i class="far fa-comments fa-3x mb-3"></i><h5>No comments yet</h5><p>Be the first to share your thoughts.</p></div>'}catch(e){console.error(e);list.innerHTML='<div class="alert alert-danger">Unable to load comments. <button class="btn btn-sm btn-link" onclick="loadComments()">Retry</button></div>'}}
        function openComments(){document.getElementById('overlay').classList.add('open');document.getElementById('commentSheet').classList.add('open');document.body.style.overflow='hidden';loadComments()}function closeComments(){document.getElementById('overlay').classList.remove('open');document.getElementById('commentSheet').classList.remove('open');document.body.style.overflow=''}function showReply(id){document.querySelectorAll('.reply-box').forEach(x=>x.classList.remove('open'));const b=document.getElementById('reply-box-'+id);if(b){b.classList.add('open');document.getElementById('reply-'+id).focus()}}
        async function postComment(){const i=document.getElementById('commentInput'),content=i.value.trim();if(!content)return;const b=document.getElementById('commentSend');b.disabled=true;try{const r=await axios.post('/comments/blog/'+blogId,{content});if(!r.data.success)throw new Error(r.data.message);i.value='';await loadComments();if(window.notify)notify.success('Comment posted')}catch(e){if(window.notify)notify.error(e.response?.data?.message||'Failed to post comment')}finally{b.disabled=false}}
        async function postReply(parentCommentId){const i=document.getElementById('reply-'+parentCommentId),content=i.value.trim();if(!content)return;try{const r=await axios.post('/comments/blog/'+blogId,{content,parentCommentId});if(!r.data.success)throw new Error(r.data.message);i.value='';await loadComments();if(window.notify)notify.success('Reply posted')}catch(e){if(window.notify)notify.error(e.response?.data?.message||'Failed to post reply')}}
        async function likeComment(id){if(!userId){location.href='/user/signin';return}try{const r=await axios.post('/comments/'+id+'/like');if(!r.data.success)throw new Error(r.data.message);const c=findComment(id);if(c){if(r.data.liked&&!c.likes.some(x=>String(x)===String(userId)))c.likes.push(userId);if(!r.data.liked)c.likes=c.likes.filter(x=>String(x)!==String(userId));const card=document.getElementById('comment-'+id),btn=card?.querySelector('.comment-action');if(btn){btn.classList.toggle('liked',r.data.liked);btn.innerHTML=`<i class="${r.data.liked?'fas':'far'} fa-heart"></i> <span>${r.data.likeCount}</span>`}}}catch(e){if(window.notify)notify.error(e.response?.data?.message||'Failed to like comment')}}
        async function editComment(id){const c=findComment(id);if(!c)return;const next=prompt('Edit comment:',c.content);if(next===null||!next.trim())return;try{const r=await axios.put('/comments/'+id,{content:next.trim()});if(!r.data.success)throw new Error(r.data.message);c.content=next.trim();document.getElementById('comment-text-'+id).textContent=c.content;if(window.notify)notify.success('Comment updated')}catch(e){if(window.notify)notify.error(e.response?.data?.message||'Failed to edit comment')}}
        async function deleteComment(id){if(!confirm('Delete this comment?'))return;try{const r=await axios.delete('/comments/'+id);if(!r.data.success)throw new Error(r.data.message);await loadComments();if(window.notify)notify.success('Comment deleted')}catch(e){if(window.notify)notify.error(e.response?.data?.message||'Failed to delete comment')}}
        async function toggleBlogLike(){if(!userId){location.href='/user/signin';return}const b=document.getElementById('likeBtn');b.disabled=true;try{const r=await axios.post('/blogs/'+blogId+'/like');if(!r.data.success)throw new Error(r.data.message);b.classList.toggle('liked',r.data.liked);b.innerHTML=`<i class="${r.data.liked?'fas':'far'} fa-heart"></i><span id="likeCount">${r.data.likeCount}</span> Likes`;document.getElementById('sideLikes').textContent=r.data.likeCount}catch(e){if(window.notify)notify.error(e.response?.data?.message||'Failed to like blog')}finally{b.disabled=false}}
        async function toggleFollow(){const b=document.getElementById('followBtn');if(!b)return;if(!userId){location.href='/user/signin';return}b.disabled=true;try{const r=await axios.post('/follow/'+authorId+'/follow');if(!r.data.success)throw new Error(r.data.message);b.querySelector('span').textContent=r.data.following?'Following':(r.data.pending?'Requested':'Follow');if(window.notify)notify.success(r.data.message||'Follow updated')}catch(e){if(window.notify)notify.error(e.response?.data?.message||'Failed to update follow')}finally{b.disabled=false}}
        async function deleteBlog(){if(!confirm('Delete this blog?'))return;try{const r=await axios.delete('/blogs/'+blogId);if(r.data.success)location.href='/'}catch(e){if(window.notify)notify.error('Failed to delete blog')}}
        async function shareBlog(){try{if(navigator.share){await navigator.share({title:<%- JSON.stringify(blog.title) %>,url:location.href})}else{await navigator.clipboard.writeText(location.href);if(window.notify)notify.success('Link copied')}}catch(e){if(e.name!=='AbortError'&&window.notify)notify.error('Unable to share')}}
        document.addEventListener('keydown',e=>{if(e.key==='Escape')closeComments()});document.addEventListener('DOMContentLoaded',loadComments);
    </script>
</body>
</html>
