<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head") %>

    <title><%= blog.title %> | Blogify</title>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >

    <style>
        :root {
            --bg: #f7f8fa;
            --surface: #ffffff;
            --surface-2: #f1f3f6;
            --text: #111318;
            --muted: #6b7280;
            --border: #e5e7eb;
            --accent: #635bff;
            --accent-2: #4f46e5;
            --danger: #e11d48;
            --danger-bg: #fff1f2;
            --success: #16a34a;
            --shadow: 0 12px 40px rgba(15, 23, 42, .08);
            --radius: 20px;
        }

        html[data-theme="dark"],
        html.dark,
        body.dark,
        [data-bs-theme="dark"] {
            --bg: #0b0d11;
            --surface: #151820;
            --surface-2: #1d212b;
            --text: #f5f7fa;
            --muted: #9ca3af;
            --border: #2b303b;
            --accent: #818cf8;
            --accent-2: #6366f1;
            --danger: #fb7185;
            --danger-bg: #351923;
            --shadow: 0 15px 45px rgba(0,0,0,.35);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
        }

        button,
        textarea,
        input {
            font: inherit;
        }

        button {
            -webkit-tap-highlight-color: transparent;
        }

        .blog-page {
            width: min(1250px, calc(100% - 32px));
            margin: 0 auto;
            padding: 30px 0 100px;
        }

        .reader-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 330px;
            gap: 34px;
            align-items: start;
        }

        .article {
            min-width: 0;
        }

        .breadcrumb {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--muted);
            text-decoration: none;
            font-size: .85rem;
            margin-bottom: 22px;
        }

        .breadcrumb:hover {
            color: var(--accent);
        }

        .category {
            display: inline-flex;
            padding: 7px 12px;
            border-radius: 999px;
            background: var(--surface-2);
            color: var(--accent);
            font-weight: 800;
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .title {
            margin: 14px 0 16px;
            max-width: 950px;
            font-size: clamp(2.4rem, 6vw, 5.2rem);
            line-height: .98;
            letter-spacing: -.055em;
            font-weight: 900;
            color: var(--text);
        }

        .excerpt {
            max-width: 820px;
            margin: 0;
            color: var(--muted);
            font-size: 1.12rem;
            line-height: 1.75;
        }

        .author-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin: 28px 0;
            padding-bottom: 25px;
            border-bottom: 1px solid var(--border);
        }

        .author-link {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text);
            text-decoration: none;
            min-width: 0;
        }

        .author-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            background: var(--surface-2);
            flex: 0 0 auto;
        }

        .author-name {
            display: block;
            font-size: .92rem;
            font-weight: 850;
        }

        .author-meta {
            display: block;
            margin-top: 3px;
            color: var(--muted);
            font-size: .76rem;
        }

        .author-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-ui {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 38px;
            padding: 8px 14px;
            border-radius: 999px;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text);
            text-decoration: none;
            cursor: pointer;
            font-weight: 750;
            transition: .18s ease;
        }

        .btn-ui:hover {
            background: var(--surface-2);
            transform: translateY(-1px);
        }

        .btn-ui.primary {
            border-color: var(--accent);
            background: var(--accent);
            color: #fff;
        }

        .btn-ui.danger {
            color: var(--danger);
        }

        .btn-ui:disabled {
            opacity: .55;
            cursor: not-allowed;
            transform: none;
        }

        .cover {
            width: 100%;
            max-height: 650px;
            object-fit: cover;
            display: block;
            border-radius: 24px;
            background: var(--surface-2);
            box-shadow: var(--shadow);
            margin-bottom: 34px;
        }

        .video-wrap {
            margin-bottom: 34px;
            border-radius: 24px;
            overflow: hidden;
            background: #000;
            box-shadow: var(--shadow);
        }

        .video-wrap video {
            width: 100%;
            display: block;
            max-height: 650px;
        }

        .article-content {
            color: var(--text);
            font-size: 1.14rem;
            line-height: 1.95;
            overflow-wrap: anywhere;
        }

        .article-content p {
            margin: 0 0 1.5em;
        }

        .article-content h1,
        .article-content h2,
        .article-content h3 {
            line-height: 1.2;
            letter-spacing: -.03em;
            margin: 2em 0 .8em;
        }

        .article-content h1 {
            font-size: 2.25rem;
        }

        .article-content h2 {
            font-size: 1.8rem;
        }

        .article-content h3 {
            font-size: 1.45rem;
        }

        .article-content img {
            max-width: 100%;
            height: auto;
            border-radius: 16px;
            margin: 1.5em 0;
        }

        .article-content a {
            color: var(--accent);
        }

        .article-content blockquote {
            margin: 1.7em 0;
            padding: 18px 22px;
            border-left: 4px solid var(--accent);
            background: var(--surface-2);
            border-radius: 0 14px 14px 0;
        }

        .article-content pre {
            background: #0b0d10 !important;
            color: #f8fafc;
            padding: 18px;
            border-radius: 15px;
            overflow: auto;
        }

        .article-content code {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        }

        .article-content p code,
        .article-content li code {
            background: var(--surface-2);
            padding: 3px 6px;
            border-radius: 6px;
        }

        .tags {
            display: flex;
            gap: 7px;
            flex-wrap: wrap;
            margin: 30px 0;
        }

        .tag {
            text-decoration: none;
            color: var(--text);
            background: var(--surface-2);
            border: 1px solid var(--border);
            padding: 7px 11px;
            border-radius: 999px;
            font-size: .78rem;
        }

        .tag:hover {
            color: var(--accent);
        }

        .engagement {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            padding: 18px 0;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .engage {
            min-height: 44px;
            padding: 9px 15px;
            border-radius: 999px;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text);
            cursor: pointer;
            font-weight: 800;
            transition: .18s ease;
        }

        .engage:hover {
            background: var(--surface-2);
        }

        .engage.liked {
            color: var(--danger);
            border-color: rgba(225,29,72,.3);
            background: var(--danger-bg);
        }

        .engage:disabled {
            opacity: .6;
            cursor: wait;
        }

        .sidebar {
            position: sticky;
            top: 20px;
        }

        .card {
            padding: 20px;
            margin-bottom: 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .profile-card {
            text-align: center;
        }

        .profile-avatar {
            width: 82px;
            height: 82px;
            object-fit: cover;
            border-radius: 50%;
            margin-bottom: 12px;
        }

        .profile-name {
            font-weight: 900;
            font-size: 1rem;
        }

        .profile-bio {
            color: var(--muted);
            font-size: .82rem;
            line-height: 1.6;
            margin: 8px 0 18px;
        }

        .profile-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            padding: 15px 0;
            margin-bottom: 15px;
        }

        .stat strong {
            display: block;
            font-size: 1.05rem;
        }

        .stat span {
            color: var(--muted);
            font-size: .72rem;
        }

        .side-heading {
            font-weight: 900;
            margin-bottom: 10px;
        }

        .side-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 9px 0;
            border-bottom: 1px solid var(--border);
        }

        .side-row:last-child {
            border-bottom: 0;
        }

        .side-row span {
            color: var(--muted);
            font-size: .8rem;
        }

        .side-row strong {
            font-size: .82rem;
        }

        .story-link {
            display: block;
            text-decoration: none;
            color: var(--text);
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
        }

        .story-link:last-child {
            border-bottom: 0;
        }

        .story-link strong {
            display: block;
            line-height: 1.4;
            font-size: .85rem;
        }

        .story-link span {
            display: block;
            margin-top: 4px;
            color: var(--muted);
            font-size: .72rem;
        }

        .story-link:hover {
            color: var(--accent);
        }

        /* COMMENT DRAWER */

        .comments-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.58);
            backdrop-filter: blur(5px);
            z-index: 3000;
            opacity: 0;
            visibility: hidden;
            transition: .22s ease;
        }

        .comments-overlay.open {
            opacity: 1;
            visibility: visible;
        }

        .comments-panel {
            position: fixed;
            z-index: 3001;
            right: 0;
            top: 0;
            bottom: 0;
            width: min(620px, 100%);
            background: var(--surface);
            color: var(--text);
            border-left: 1px solid var(--border);
            transform: translateX(100%);
            transition: transform .32s cubic-bezier(.16,1,.3,1);
            display: flex;
            flex-direction: column;
        }

        .comments-panel.open {
            transform: translateX(0);
        }

        .comments-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 17px 20px;
            border-bottom: 1px solid var(--border);
            flex: 0 0 auto;
        }

        .comments-title {
            margin: 0;
            font-size: 1rem;
            font-weight: 900;
        }

        .comments-close {
            width: 38px;
            height: 38px;
            border: 0;
            border-radius: 50%;
            background: var(--surface-2);
            color: var(--text);
            cursor: pointer;
        }

        .comments-toolbar {
            padding: 10px 18px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--muted);
            font-size: .75rem;
        }

        .comments-list {
            flex: 1;
            overflow-y: auto;
            padding: 8px 18px 20px;
            overscroll-behavior: contain;
        }

        .comment {
            padding: 16px 3px;
            border-bottom: 1px solid var(--border);
        }

        .comment-row {
            display: flex;
            gap: 10px;
        }

        .comment-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            flex: 0 0 auto;
            background: var(--surface-2);
        }

        .comment-body {
            min-width: 0;
            flex: 1;
        }

        .comment-top {
            display: flex;
            gap: 7px;
            align-items: baseline;
            flex-wrap: wrap;
        }

        .comment-author {
            font-size: .82rem;
            font-weight: 900;
        }

        .comment-time {
            color: var(--muted);
            font-size: .68rem;
        }

        .comment-content {
            margin: 6px 0 8px;
            color: var(--text);
            white-space: pre-wrap;
            word-break: break-word;
            font-size: .87rem;
            line-height: 1.6;
        }

        .comment-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .comment-action {
            border: 0;
            background: transparent;
            color: var(--muted);
            padding: 2px 0;
            cursor: pointer;
            font-size: .73rem;
        }

        .comment-action:hover {
            color: var(--accent);
        }

        .comment-action.liked {
            color: var(--danger);
        }

        .comment-action:disabled {
            opacity: .5;
            cursor: wait;
        }

        .replies {
            margin: 12px 0 0 49px;
            padding-left: 13px;
            border-left: 2px solid var(--border);
        }

        .reply-composer {
            display: none;
            gap: 7px;
            margin: 10px 0 0 49px;
        }

        .reply-composer.open {
            display: flex;
        }

        .reply-composer textarea,
        .comment-composer textarea {
            width: 100%;
            min-height: 43px;
            max-height: 120px;
            resize: vertical;
            padding: 10px 12px;
            border: 1px solid var(--border);
            border-radius: 12px;
            outline: none;
            background: var(--surface);
            color: var(--text);
        }

        .reply-composer textarea:focus,
        .comment-composer textarea:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(99,102,241,.12);
        }

        .reply-send {
            border: 0;
            border-radius: 11px;
            background: var(--accent);
            color: #fff;
            min-width: 43px;
            cursor: pointer;
        }

        .comment-composer {
            display: flex;
            gap: 9px;
            padding: 12px 18px;
            border-top: 1px solid var(--border);
            background: var(--surface);
            flex: 0 0 auto;
        }

        .composer-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            flex: 0 0 auto;
        }

        .composer-main {
            flex: 1;
            display: flex;
            gap: 8px;
        }

        .comment-send {
            align-self: stretch;
            min-width: 45px;
            border: 0;
            border-radius: 11px;
            background: var(--text);
            color: var(--surface);
            cursor: pointer;
        }

        .comment-send:disabled {
            opacity: .5;
            cursor: wait;
        }

        .login-box {
            padding: 18px;
            text-align: center;
            border-top: 1px solid var(--border);
            color: var(--muted);
            font-size: .82rem;
        }

        .login-box a {
            color: var(--accent);
            font-weight: 800;
        }

        .comment-empty,
        .comment-loading,
        .comment-error {
            text-align: center;
            padding: 60px 20px;
            color: var(--muted);
        }

        .comment-error {
            color: var(--danger);
        }

        .retry-btn {
            display: inline-flex;
            margin-top: 12px;
            padding: 8px 13px;
            border: 1px solid var(--border);
            border-radius: 999px;
            background: var(--surface);
            color: var(--text);
            cursor: pointer;
        }

        .comment-fab {
            position: fixed;
            right: 22px;
            bottom: 22px;
            z-index: 2500;
            width: 58px;
            height: 58px;
            border: 0;
            border-radius: 50%;
            background: var(--text);
            color: var(--surface);
            box-shadow: 0 12px 35px rgba(0,0,0,.25);
            cursor: pointer;
            transition: .18s ease;
        }

        .comment-fab:hover {
            transform: translateY(-2px);
        }

        .comment-fab-count {
            position: absolute;
            top: -4px;
            right: -4px;
            min-width: 22px;
            height: 22px;
            padding: 0 5px;
            display: grid;
            place-items: center;
            border-radius: 999px;
            background: var(--danger);
            color: #fff;
            border: 2px solid var(--surface);
            font-size: .65rem;
            font-weight: 900;
        }

        .toast {
            position: fixed;
            right: 20px;
            bottom: 90px;
            z-index: 5000;
            max-width: min(380px, calc(100% - 40px));
            padding: 12px 15px;
            border-radius: 13px;
            background: var(--text);
            color: var(--surface);
            box-shadow: var(--shadow);
            opacity: 0;
            transform: translateY(12px);
            pointer-events: none;
            transition: .2s ease;
            font-size: .82rem;
        }

        .toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        .toast.error {
            background: var(--danger);
            color: #fff;
        }

        @media (max-width: 1000px) {
            .reader-layout {
                grid-template-columns: 1fr;
            }

            .sidebar {
                position: static;
            }

            .sidebar-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 15px;
            }
        }

        @media (max-width: 650px) {
            .blog-page {
                width: min(100% - 22px, 1250px);
                padding-top: 18px;
            }

            .title {
                font-size: clamp(2.35rem, 13vw, 3.8rem);
            }

            .author-bar {
                align-items: flex-start;
                flex-direction: column;
            }

            .cover,
            .video-wrap {
                border-radius: 16px;
            }

            .engagement {
                gap: 7px;
            }

            .engage {
                flex: 1;
                min-width: 100px;
                padding: 9px 10px;
                font-size: .78rem;
            }

            .sidebar-grid {
                display: block;
            }

            .comments-panel {
                width: 100%;
            }

            .replies {
                margin-left: 27px;
            }

            .reply-composer {
                margin-left: 27px;
            }

            .comment-fab {
                right: 15px;
                bottom: 15px;
            }
        }
    </style>
</head>

<body>

<%- include("./partials/nave") %>

<main class="blog-page">

    <div class="reader-layout">

        <!-- ================= ARTICLE ================= -->

        <article class="article">

            <a href="/" class="breadcrumb">
                <i class="fa-solid fa-arrow-left"></i>
                Back to stories
            </a>

            <% if (blog.category) { %>
                <div class="category">
                    <%= blog.category %>
                </div>
            <% } %>

            <h1 class="title">
                <%= blog.title %>
            </h1>

            <% if (blog.excerpt) { %>
                <p class="excerpt">
                    <%= blog.excerpt %>
                </p>
            <% } %>

            <div class="author-bar">

                <a
                    href="/user/profile/<%= blog.createdBy._id %>"
                    class="author-link"
                >
                    <img
                        class="author-avatar"
                        src="<%= blog.createdBy.profileImageURL || '/imgs/default.png' %>"
                        alt="<%= blog.createdBy.fullName %>"
                        onerror="this.src='/imgs/default.png'"
                    >

                    <span>
                        <span class="author-name">
                            <%= blog.createdBy.fullName %>
                        </span>

                        <span class="author-meta">
                            <%= formatDate(blog.createdAt) %>
                            ·
                            <%= blog.readingTime || 1 %> min read
                        </span>
                    </span>
                </a>

                <% if (
                    locals.user &&
                    blog.createdBy &&
                    locals.user._id.toString() === blog.createdBy._id.toString()
                ) { %>

                    <div class="author-actions">

                        <a
                            href="/blogs/<%= blog._id %>/edit"
                            class="btn-ui"
                        >
                            <i class="fa-solid fa-pen"></i>
                            Edit
                        </a>

                        <button
                            type="button"
                            class="btn-ui danger"
                            id="deleteBlogButton"
                        >
                            <i class="fa-solid fa-trash"></i>
                            Delete
                        </button>

                    </div>

                <% } %>

            </div>


            <!-- MEDIA -->

            <% if (blog.mediaType === "video" && blog.videoURL) { %>

                <div class="video-wrap">
                    <video
                        controls
                        preload="metadata"
                        playsinline
                    >
                        <source src="<%= blog.videoURL %>">
                        Your browser does not support video playback.
                    </video>
                </div>

            <% } else if (blog.coverImageURL) { %>

                <img
                    class="cover"
                    src="<%= blog.coverImageURL %>"
                    alt="<%= blog.title %>"
                    loading="eager"
                    onerror="this.style.display='none'"
                >

            <% } %>


            <!-- ARTICLE BODY -->

            <div class="article-content">
                <%- renderMarkdown(blog.body) %>
            </div>


            <!-- TAGS -->

            <% if (blog.tags && blog.tags.length) { %>

                <div class="tags">

                    <% blog.tags.forEach(tag => { %>

                        <a
                            class="tag"
                            href="/blogs/tags/<%= encodeURIComponent(tag) %>"
                        >
                            #<%= tag %>
                        </a>

                    <% }) %>

                </div>

            <% } %>


            <!-- ENGAGEMENT -->

            <div class="engagement">

                <button
                    type="button"
                    id="likeBtn"
                    class="engage <%= hasLiked ? 'liked' : '' %>"
                    aria-pressed="<%= hasLiked ? 'true' : 'false' %>"
                >
                    <i class="<%= hasLiked ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>

                    <span id="likeCount">
                        <%= blog.likes ? blog.likes.length : 0 %>
                    </span>

                    <span>Likes</span>
                </button>


                <button
                    type="button"
                    class="engage"
                    id="openCommentsButton"
                >
                    <i class="fa-regular fa-comment"></i>

                    <span id="commentCount">
                        0
                    </span>

                    <span>Comments</span>
                </button>


                <button
                    type="button"
                    class="engage"
                    id="shareButton"
                >
                    <i class="fa-solid fa-arrow-up-from-bracket"></i>
                    <span>Share</span>
                </button>

            </div>

        </article>


        <!-- ================= SIDEBAR ================= -->

        <aside class="sidebar">

            <div class="sidebar-grid">

                <!-- AUTHOR -->

                <div class="card profile-card">

                    <img
                        class="profile-avatar"
                        src="<%= blog.createdBy.profileImageURL || '/imgs/default.png' %>"
                        alt="<%= blog.createdBy.fullName %>"
                        onerror="this.src='/imgs/default.png'"
                    >

                    <div class="profile-name">
                        <%= blog.createdBy.fullName %>
                    </div>

                    <div class="profile-bio">
                        <%= blog.createdBy.bio || "Writer on Blogify" %>
                    </div>


                    <div class="profile-stats">

                        <div class="stat">
                            <strong>
                                <%= blog.createdBy.followers ? blog.createdBy.followers.length : 0 %>
                            </strong>
                            <span>Followers</span>
                        </div>

                        <div class="stat">
                            <strong>
                                <%= authorBlogs ? authorBlogs.length : 0 %>
                            </strong>
                            <span>Posts</span>
                        </div>

                    </div>


                    <% if (
                        locals.user &&
                        blog.createdBy &&
                        locals.user._id.toString() !== blog.createdBy._id.toString()
                    ) { %>

                        <button
                            type="button"
                            class="btn-ui primary"
                            id="followBtn"
                            style="width:100%;"
                        >
                            <i class="fa-solid fa-user-plus"></i>
                            <span>Follow</span>
                        </button>

                    <% } %>

                </div>


                <!-- ARTICLE STATS -->

                <div class="card">

                    <div class="side-heading">
                        Article
                    </div>

                    <div class="side-row">
                        <span>Views</span>
                        <strong>
                            <%= blog.viewCount || 0 %>
                        </strong>
                    </div>

                    <div class="side-row">
                        <span>Likes</span>
                        <strong id="sideLikes">
                            <%= blog.likes ? blog.likes.length : 0 %>
                        </strong>
                    </div>

                    <div class="side-row">
                        <span>Comments</span>
                        <strong id="sideCommentCount">
                            0
                        </strong>
                    </div>

                </div>


                <!-- MORE FROM AUTHOR -->

                <% if (authorBlogs && authorBlogs.length) { %>

                    <div class="card">

                        <div class="side-heading">
                            More from <%= blog.createdBy.fullName %>
                        </div>

                        <% authorBlogs.slice(0, 5).forEach(item => { %>

                            <a
                                href="/blogs/<%= item._id %>"
                                class="story-link"
                            >
                                <strong>
                                    <%= truncate(item.title, 60) %>
                                </strong>

                                <span>
                                    <%= formatDate(item.createdAt) %>
                                </span>
                            </a>

                        <% }) %>

                    </div>

                <% } %>


                <!-- RELATED -->

                <% if (relatedBlogs && relatedBlogs.length) { %>

                    <div class="card">

                        <div class="side-heading">
                            Related stories
                        </div>

                        <% relatedBlogs.slice(0, 5).forEach(item => { %>

                            <a
                                href="/blogs/<%= item._id %>"
                                class="story-link"
                            >
                                <strong>
                                    <%= truncate(item.title, 60) %>
                                </strong>

                                <span>
                                    <%= formatDate(item.createdAt) %>
                                </span>
                            </a>

                        <% }) %>

                    </div>

                <% } %>

            </div>

        </aside>

    </div>

</main>


<!-- ================= COMMENT FAB ================= -->

<button
    type="button"
    class="comment-fab"
    id="commentFab"
    aria-label="Open comments"
>
    <i class="fa-regular fa-comment"></i>

    <span
        class="comment-fab-count"
        id="fabCount"
    >
        0
    </span>
</button>


<!-- ================= COMMENT OVERLAY ================= -->

<div
    class="comments-overlay"
    id="commentsOverlay"
></div>


<!-- ================= COMMENT PANEL ================= -->

<section
    class="comments-panel"
    id="commentsPanel"
    aria-label="Comments"
>

    <header class="comments-header">

        <h2 class="comments-title">
            <i class="fa-solid fa-comments"></i>

            Comments

            <span id="commentsTitleCount">
                0
            </span>
        </h2>

        <button
            type="button"
            class="comments-close"
            id="closeCommentsButton"
            aria-label="Close comments"
        >
            <i class="fa-solid fa-xmark"></i>
        </button>

    </header>


    <div class="comments-toolbar">

        <span id="commentsStatus">
            Loading comments...
        </span>

        <button
            type="button"
            class="retry-btn"
            id="reloadCommentsButton"
            style="display:none;margin:0;padding:5px 10px;"
        >
            Retry
        </button>

    </div>


    <div
        class="comments-list"
        id="commentsList"
    >

        <div class="comment-loading">
            <i class="fa-solid fa-spinner fa-spin fa-2x"></i>
            <p>Loading comments...</p>
        </div>

    </div>


    <% if (locals.user) { %>

        <div class="comment-composer">

            <img
                class="composer-avatar"
                src="<%= locals.user.profileImageURL || '/imgs/default.png' %>"
                alt=""
                onerror="this.src='/imgs/default.png'"
            >

            <div class="composer-main">

                <textarea
                    id="commentInput"
                    maxlength="5000"
                    placeholder="Share your thoughts..."
                ></textarea>

                <button
                    type="button"
                    class="comment-send"
                    id="commentSend"
                    aria-label="Post comment"
                >
                    <i class="fa-solid fa-paper-plane"></i>
                </button>

            </div>

        </div>

    <% } else { %>

        <div class="login-box">

            <a href="/user/signin">
                Sign in
            </a>

            to join the conversation.

        </div>

    <% } %>

</section>


<div
    class="toast"
    id="blogifyToast"
></div>


<%- include("./partials/scripts") %>


<script>
(function () {
    "use strict";

    /*
     * ============================================================
     * BLOGIFY VIEW PAGE
     * ============================================================
     *
     * Backend routes verified against current BlogifyDemo:
     *
     * GET    /comments/blog/:blogId
     * POST   /comments/blog/:blogId
     * POST   /comments/:commentId/like
     * PUT    /comments/:commentId
     * DELETE /comments/:commentId
     *
     * POST   /blogs/:blogId/like
     * DELETE /blogs/:blogId
     *
     * ============================================================
     */

    const BLOG_ID = <%- JSON.stringify(String(blog._id)) %>;
    const USER_ID = <%- JSON.stringify(
        locals.user ? String(locals.user._id) : ""
    ) %>;
    const AUTHOR_ID = <%- JSON.stringify(String(blog.createdBy._id)) %>;

    let comments = [];
    let commentsLoaded = false;
    let commentsLoading = false;
    let commentsOpened = false;

    let likeLoading = false;
    let commentPosting = false;

    let toastTimer = null;


    /* ============================================================
       DOM
    ============================================================ */

    const $ = (selector) => document.querySelector(selector);

    const likeButton = $("#likeBtn");
    const likeCount = $("#likeCount");
    const sideLikes = $("#sideLikes");

    const commentsPanel = $("#commentsPanel");
    const commentsOverlay = $("#commentsOverlay");
    const commentsList = $("#commentsList");

    const commentInput = $("#commentInput");
    const commentSend = $("#commentSend");

    const commentCount = $("#commentCount");
    const sideCommentCount = $("#sideCommentCount");
    const fabCount = $("#fabCount");
    const commentsTitleCount = $("#commentsTitleCount");

    const commentsStatus = $("#commentsStatus");
    const reloadCommentsButton = $("#reloadCommentsButton");

    const toast = $("#blogifyToast");


    /* ============================================================
       UTILITIES
    ============================================================ */

    function escapeHTML(value) {

        const div = document.createElement("div");

        div.textContent = value == null
            ? ""
            : String(value);

        return div.innerHTML;
    }


    function escapeAttribute(value) {

        return escapeHTML(value)
            .replace(/`/g, "&#96;");
    }


    function timeAgo(date) {

        const timestamp = new Date(date).getTime();

        if (!Number.isFinite(timestamp)) {
            return "";
        }

        const seconds = Math.max(
            0,
            Math.floor((Date.now() - timestamp) / 1000)
        );

        if (seconds < 60) {
            return "Just now";
        }

        if (seconds < 3600) {
            return Math.floor(seconds / 60) + "m";
        }

        if (seconds < 86400) {
            return Math.floor(seconds / 3600) + "h";
        }

        if (seconds < 2592000) {
            return Math.floor(seconds / 86400) + "d";
        }

        if (seconds < 31536000) {
            return Math.floor(seconds / 2592000) + "mo";
        }

        return Math.floor(seconds / 31536000) + "y";
    }


    function showToast(message, type) {

        if (!toast) {
            return;
        }

        clearTimeout(toastTimer);

        toast.textContent = message || "Something went wrong.";

        toast.classList.remove("error");

        if (type === "error") {
            toast.classList.add("error");
        }

        toast.classList.add("show");

        toastTimer = setTimeout(function () {
            toast.classList.remove("show");
        }, 3000);
    }


    async function apiRequest(url, options) {

        const config = {
            credentials: "same-origin",
            ...options
        };

        config.headers = {
            Accept: "application/json",
            ...(options && options.headers ? options.headers : {})
        };


        let response;

        try {

            response = await fetch(url, config);

        } catch (networkError) {

            const error = new Error(
                "Network error. Please check your connection."
            );

            error.network = true;

            throw error;
        }


        let data = null;

        const contentType =
            response.headers.get("content-type") || "";


        if (contentType.includes("application/json")) {

            try {
                data = await response.json();
            } catch (_) {
                data = null;
            }

        } else {

            try {
                const text = await response.text();

                data = text
                    ? { message: text }
                    : null;

            } catch (_) {
                data = null;
            }

        }


        if (!response.ok) {

            let message =
                data &&
                (
                    data.message ||
                    data.error ||
                    (
                        Array.isArray(data.errors)
                            ? data.errors[0]
                            : null
                    )
                );


            if (!message) {

                if (response.status === 401) {
                    message = "Please sign in to continue.";
                }

                else if (response.status === 403) {
                    message = "You are not allowed to perform this action.";
                }

                else if (response.status === 404) {
                    message = "The requested resource was not found.";
                }

                else if (response.status === 429) {
                    message = "Too many requests. Please try again later.";
                }

                else {
                    message = "Server error. Please try again.";
                }
            }


            const error = new Error(message);

            error.status = response.status;
            error.data = data;

            throw error;
        }


        return data || {};
    }


    function setCommentCount(count) {

        const safeCount =
            Number.isFinite(Number(count))
                ? Number(count)
                : 0;


        if (commentCount) {
            commentCount.textContent = safeCount;
        }

        if (sideCommentCount) {
            sideCommentCount.textContent = safeCount;
        }

        if (fabCount) {
            fabCount.textContent = safeCount;
        }

        if (commentsTitleCount) {
            commentsTitleCount.textContent = safeCount;
        }
    }


    function updateCommentsStatus(text) {

        if (commentsStatus) {
            commentsStatus.textContent = text;
        }
    }


    /* ============================================================
       COMMENT TREE
    ============================================================ */

    function findComment(commentId, list) {

        const source = list || comments;

        for (const comment of source) {

            if (
                comment &&
                String(comment._id) === String(commentId)
            ) {
                return comment;
            }


            if (
                comment &&
                Array.isArray(comment.replies)
            ) {

                const result = findComment(
                    commentId,
                    comment.replies
                );

                if (result) {
                    return result;
                }
            }
        }

        return null;
    }


    function renderComment(comment) {

        if (!comment) {
            return "";
        }

        if (comment.isDeleted) {
            return "";
        }


        const id = String(comment._id);

        const author = comment.author || {};

        const authorId =
            author._id
                ? String(author._id)
                : "";


        const authorName =
            author.fullName ||
            "User";


        const avatar =
            author.profileImageURL ||
            "/imgs/default.png";


        const content =
            comment.content ||
            "";


        const likes =
            Array.isArray(comment.likes)
                ? comment.likes
                : [];


        const liked =
            USER_ID &&
            likes.some(function (idValue) {
                return String(idValue) === String(USER_ID);
            });


        const ownComment =
            USER_ID &&
            authorId === String(USER_ID);


        const replies =
            Array.isArray(comment.replies)
                ? comment.replies.filter(function (reply) {
                    return reply && !reply.isDeleted;
                })
                : [];


        const safeId =
            escapeAttribute(id);


        let html = "";

        html += '<div class="comment" data-comment-id="' +
            safeId +
            '">';


        html += '<div class="comment-row">';


        html += '<img class="comment-avatar" src="' +
            escapeAttribute(avatar) +
            '" alt="" onerror="this.src=\\'/imgs/default.png\\'">';


        html += '<div class="comment-body">';


        html += '<div class="comment-top">';

        html += '<span class="comment-author">' +
            escapeHTML(authorName) +
            '</span>';

        html += '<span class="comment-time">' +
            escapeHTML(timeAgo(comment.createdAt)) +
            '</span>';

        html += '</div>';


        html += '<div class="comment-content">' +
            escapeHTML(content) +
            '</div>';


        html += '<div class="comment-actions">';


        if (USER_ID) {

            html +=
                '<button type="button" ' +
                'class="comment-action ' +
                (liked ? "liked" : "") +
                '" data-action="like-comment" ' +
                'data-id="' +
                safeId +
                '">' +

                '<i class="' +
                (liked ? "fa-solid" : "fa-regular") +
                ' fa-heart"></i> ' +

                '<span>' +
                likes.length +
                '</span>' +

                '</button>';


            html +=
                '<button type="button" ' +
                'class="comment-action" ' +
                'data-action="reply" ' +
                'data-id="' +
                safeId +
                '">' +

                '<i class="fa-solid fa-reply"></i> Reply' +

                '</button>';

        } else {

            html +=
                '<a href="/user/signin" ' +
                'class="comment-action">' +
                '<i class="fa-regular fa-heart"></i> ' +
                likes.length +
                '</a>';

        }


        if (ownComment) {

            html +=
                '<button type="button" ' +
                'class="comment-action" ' +
                'data-action="edit-comment" ' +
                'data-id="' +
                safeId +
                '">' +

                '<i class="fa-solid fa-pen"></i> Edit' +

                '</button>';


            html +=
                '<button type="button" ' +
                'class="comment-action" ' +
                'data-action="delete-comment" ' +
                'data-id="' +
                safeId +
                '">' +

                '<i class="fa-solid fa-trash"></i> Delete' +

                '</button>';

        }


        html += "</div>";

        html += "</div>";

        html += "</div>";


        if (USER_ID) {

            html +=
                '<div class="reply-composer" ' +
                'id="reply-box-' +
                safeId +
                '">' +

                '<textarea ' +
                'id="reply-input-' +
                safeId +
                '" ' +
                'maxlength="5000" ' +
                'placeholder="Write a reply..."></textarea>' +

                '<button type="button" ' +
                'class="reply-send" ' +
                'data-action="send-reply" ' +
                'data-id="' +
                safeId +
                '">' +

                '<i class="fa-solid fa-paper-plane"></i>' +

                '</button>' +

                '</div>';

        }


        if (replies.length) {

            html += '<div class="replies">';

            replies.forEach(function (reply) {
                html += renderComment(reply);
            });

            html += "</div>";
        }


        html += "</div>";

        return html;
    }


    /* ============================================================
       LOAD COMMENTS
    ============================================================ */

    async function loadComments(force) {

        if (commentsLoading) {
            return;
        }

        if (commentsLoaded && !force) {
            return;
        }


        commentsLoading = true;


        if (commentsList) {

            commentsList.innerHTML =
                '<div class="comment-loading">' +
                '<i class="fa-solid fa-spinner fa-spin fa-2x"></i>' +
                '<p>Loading comments...</p>' +
                '</div>';

        }


        updateCommentsStatus("Loading comments...");


        if (reloadCommentsButton) {
            reloadCommentsButton.style.display = "none";
        }


        try {

            const data = await apiRequest(
                "/comments/blog/" +
                encodeURIComponent(BLOG_ID) +
                "?page=1&limit=50",
                {
                    method: "GET"
                }
            );


            if (!data.success) {

                throw new Error(
                    data.message ||
                    "Unable to load comments."
                );
            }


            comments =
                Array.isArray(data.comments)
                    ? data.comments
                    : [];


            const total =
                Number(data.total) ||
                0;


            setCommentCount(total);


            commentsLoaded = true;


            updateCommentsStatus(
                total === 0
                    ? "Be the first to comment"
                    : total + (
                        total === 1
                            ? " comment"
                            : " comments"
                    )
            );


            if (!commentsList) {
                return;
            }


            if (!comments.length) {

                commentsList.innerHTML =
                    '<div class="comment-empty">' +

                    '<i class="fa-regular fa-comments fa-3x"></i>' +

                    '<h3>No comments yet</h3>' +

                    '<p>Start the conversation.</p>' +

                    '</div>';

                return;
            }


            commentsList.innerHTML =
                comments
                    .map(renderComment)
                    .join("");


        } catch (error) {

            console.error(
                "Blogify comments loading error:",
                error
            );


            commentsLoaded = false;


            updateCommentsStatus(
                error.message ||
                "Unable to load comments."
            );


            if (commentsList) {

                commentsList.innerHTML =
                    '<div class="comment-error">' +

                    '<i class="fa-solid fa-triangle-exclamation fa-2x"></i>' +

                    '<p>' +
                    escapeHTML(
                        error.message ||
                        "Unable to load comments."
                    ) +
                    '</p>' +

                    '<button type="button" ' +
                    'class="retry-btn" ' +
                    'id="inlineRetryComments">' +
                    'Try again' +
                    '</button>' +

                    '</div>';


                const retry =
                    document.getElementById(
                        "inlineRetryComments"
                    );


                if (retry) {

                    retry.addEventListener(
                        "click",
                        function () {
                            loadComments(true);
                        }
                    );

                }

            }


            if (reloadCommentsButton) {
                reloadCommentsButton.style.display =
                    "inline-flex";
            }

        } finally {

            commentsLoading = false;

        }
    }


    /* ============================================================
       OPEN / CLOSE COMMENTS
    ============================================================ */

    function openComments() {

        if (!commentsPanel || !commentsOverlay) {
            return;
        }


        commentsOpened = true;

        commentsPanel.classList.add("open");
        commentsOverlay.classList.add("open");

        document.body.style.overflow = "hidden";


        loadComments(false);
    }


    function closeComments() {

        if (!commentsPanel || !commentsOverlay) {
            return;
        }


        commentsOpened = false;

        commentsPanel.classList.remove("open");
        commentsOverlay.classList.remove("open");

        document.body.style.overflow = "";
    }


    /* ============================================================
       POST COMMENT
    ============================================================ */

    async function postComment() {

        if (!USER_ID) {

            window.location.href =
                "/user/signin";

            return;
        }


        if (commentPosting) {
            return;
        }


        const content =
            commentInput
                ? commentInput.value.trim()
                : "";


        if (!content) {

            showToast(
                "Write a comment first.",
                "error"
            );

            return;
        }


        if (content.length > 5000) {

            showToast(
                "Comment is too long.",
                "error"
            );

            return;
        }


        commentPosting = true;


        if (commentSend) {
            commentSend.disabled = true;
        }


        try {

            const data = await apiRequest(
                "/comments/blog/" +
                encodeURIComponent(BLOG_ID),
                {
                    method: "POST",
                    headers: {
                        "Content-Type":
                            "application/json"
                    },
                    body: JSON.stringify({
                        content: content
                    })
                }
            );


            if (!data.success) {

                throw new Error(
                    data.message ||
                    "Failed to post comment."
                );
            }


            if (commentInput) {
                commentInput.value = "";
            }


            commentsLoaded = false;

            await loadComments(true);


            showToast(
                data.message ||
                "Comment posted successfully."
            );


        } catch (error) {

            console.error(
                "Blogify post comment error:",
                error
            );


            if (error.status === 401) {

                window.location.href =
                    "/user/signin";

                return;
            }


            showToast(
                error.message ||
                "Failed to post comment.",
                "error"
            );


        } finally {

            commentPosting = false;

            if (commentSend) {
                commentSend.disabled = false;
            }

        }
    }


    /* ============================================================
       POST REPLY
    ============================================================ */

    async function postReply(parentCommentId) {

        if (!USER_ID) {

            window.location.href =
                "/user/signin";

            return;
        }


        const input =
            document.getElementById(
                "reply-input-" +
                parentCommentId
            );


        if (!input) {
            return;
        }


        const content =
            input.value.trim();


        if (!content) {

            showToast(
                "Write a reply first.",
                "error"
            );

            return;
        }


        try {

            const data = await apiRequest(
                "/comments/blog/" +
                encodeURIComponent(BLOG_ID),
                {
                    method: "POST",
                    headers: {
                        "Content-Type":
                            "application/json"
                    },
                    body: JSON.stringify({
                        content: content,
                        parentCommentId:
                            parentCommentId
                    })
                }
            );


            if (!data.success) {

                throw new Error(
                    data.message ||
                    "Failed to post reply."
                );
            }


            input.value = "";

            commentsLoaded = false;

            await loadComments(true);


            showToast(
                data.message ||
                "Reply posted successfully."
            );


        } catch (error) {

            console.error(
                "Blogify reply error:",
                error
            );


            if (error.status === 401) {

                window.location.href =
                    "/user/signin";

                return;
            }


            showToast(
                error.message ||
                "Failed to post reply.",
                "error"
            );
        }
    }


    /* ============================================================
       COMMENT LIKE
    ============================================================ */

    async function likeComment(commentId, button) {

        if (!USER_ID) {

            window.location.href =
                "/user/signin";

            return;
        }


        if (!button || button.disabled) {
            return;
        }


        button.disabled = true;


        try {

            const data = await apiRequest(
                "/comments/" +
                encodeURIComponent(commentId) +
                "/like",
                {
                    method: "POST"
                }
            );


            if (!data.success) {

                throw new Error(
                    data.message ||
                    "Failed to like comment."
                );
            }


            const comment =
                findComment(commentId);


            if (comment) {

                let likes =
                    Array.isArray(comment.likes)
                        ? comment.likes
                        : [];


                if (data.liked) {

                    if (
                        !likes.some(function (id) {
                            return String(id) ===
                                String(USER_ID);
                        })
                    ) {
                        likes.push(USER_ID);
                    }

                } else {

                    likes =
                        likes.filter(function (id) {
                            return String(id) !==
                                String(USER_ID);
                        });

                }


                comment.likes = likes;
            }


            button.classList.toggle(
                "liked",
                !!data.liked
            );


            const icon =
                button.querySelector("i");


            if (icon) {

                icon.className =
                    (
                        data.liked
                            ? "fa-solid"
                            : "fa-regular"
                    ) +
                    " fa-heart";

            }


            const count =
                button.querySelector("span");


            if (count) {

                count.textContent =
                    Number(data.likeCount) || 0;

            }


        } catch (error) {

            console.error(
                "Blogify comment like error:",
                error
            );


            if (error.status === 401) {

                window.location.href =
                    "/user/signin";

                return;
            }


            showToast(
                error.message ||
                "Failed to like comment.",
                "error"
            );


        } finally {

            button.disabled = false;

        }
    }


    /* ============================================================
       EDIT COMMENT
    ============================================================ */

    async function editComment(commentId) {

        if (!USER_ID) {
            window.location.href =
                "/user/signin";
            return;
        }


        const comment =
            findComment(commentId);


        if (!comment) {
            return;
        }


        const next =
            window.prompt(
                "Edit your comment:",
                comment.content || ""
            );


        if (next === null) {
            return;
        }


        const content =
            next.trim();


        if (!content) {

            showToast(
                "Comment cannot be empty.",
                "error"
            );

            return;
        }


        try {

            const data = await apiRequest(
                "/comments/" +
                encodeURIComponent(commentId),
                {
                    method: "PUT",
                    headers: {
                        "Content-Type":
                            "application/json"
                    },
                    body: JSON.stringify({
                        content: content
                    })
                }
            );


            if (!data.success) {

                throw new Error(
                    data.message ||
                    "Failed to update comment."
                );
            }


            comment.content = content;


            const card =
                commentsList.querySelector(
                    '[data-comment-id="' +
                    CSS.escape(commentId) +
                    '"]'
                );


            if (card) {

                const contentNode =
                    card.querySelector(
                        ".comment-content"
                    );


                if (contentNode) {
                    contentNode.textContent =
                        content;
                }

            }


            showToast(
                "Comment updated successfully."
            );


        } catch (error) {

            console.error(
                "Blogify edit comment error:",
                error
            );


            showToast(
                error.message ||
                "Failed to update comment.",
                "error"
            );
        }
    }


    /* ============================================================
       DELETE COMMENT
    ============================================================ */

    async function deleteComment(commentId) {

        if (!USER_ID) {
            window.location.href =
                "/user/signin";
            return;
        }


        if (
            !window.confirm(
                "Delete this comment?"
            )
        ) {
            return;
        }


        try {

            const data = await apiRequest(
                "/comments/" +
                encodeURIComponent(commentId),
                {
                    method: "DELETE"
                }
            );


            if (!data.success) {

                throw new Error(
                    data.message ||
                    "Failed to delete comment."
                );
            }


            commentsLoaded = false;

            await loadComments(true);


            showToast(
                data.message ||
                "Comment deleted."
            );


        } catch (error) {

            console.error(
                "Blogify delete comment error:",
                error
            );


            showToast(
                error.message ||
                "Failed to delete comment.",
                "error"
            );
        }
    }


    /* ============================================================
       BLOG LIKE
    ============================================================ */

    async function toggleBlogLike() {

        if (!USER_ID) {

            window.location.href =
                "/user/signin";

            return;
        }


        if (likeLoading || !likeButton) {
            return;
        }


        likeLoading = true;

        likeButton.disabled = true;


        try {

            const data = await apiRequest(
                "/blogs/" +
                encodeURIComponent(BLOG_ID) +
                "/like",
                {
                    method: "POST"
                }
            );


            if (!data.success) {

                throw new Error(
                    data.message ||
                    "Failed to like blog."
                );
            }


            const liked =
                !!data.liked;


            const count =
                Number(data.likeCount) || 0;


            likeButton.classList.toggle(
                "liked",
                liked
            );


            likeButton.setAttribute(
                "aria-pressed",
                liked ? "true" : "false"
            );


            if (likeCount) {
                likeCount.textContent = count;
            }


            if (sideLikes) {
                sideLikes.textContent = count;
            }


            const icon =
                likeButton.querySelector("i");


            if (icon) {

                icon.className =
                    (
                        liked
                            ? "fa-solid"
                            : "fa-regular"
                    ) +
                    " fa-heart";

            }


        } catch (error) {

            console.error(
                "Blogify blog like error:",
                error
            );


            if (error.status === 401) {

                window.location.href =
                    "/user/signin";

                return;
            }


            showToast(
                error.message ||
                "Failed to like blog.",
                "error"
            );


        } finally {

            likeLoading = false;

            likeButton.disabled = false;

        }
    }


    /* ============================================================
       FOLLOW
    ============================================================ */

    async function toggleFollow() {

        const button =
            $("#followBtn");


        if (!button) {
            return;
        }


        if (!USER_ID) {

            window.location.href =
                "/user/signin";

            return;
        }


        button.disabled = true;


        try {

            const data = await apiRequest(
                "/follow/" +
                encodeURIComponent(AUTHOR_ID) +
                "/follow",
                {
                    method: "POST"
                }
            );


            if (!data.success) {

                throw new Error(
                    data.message ||
                    "Failed to update follow."
                );
            }


            const label =
                button.querySelector("span");


            if (label) {

                if (data.following) {

                    label.textContent =
                        "Following";

                } else if (data.pending) {

                    label.textContent =
                        "Requested";

                } else {

                    label.textContent =
                        "Follow";

                }

            }


            showToast(
                data.message ||
                "Follow status updated."
            );


        } catch (error) {

            console.error(
                "Blogify follow error:",
                error
            );


            if (error.status === 401) {

                window.location.href =
                    "/user/signin";

                return;
            }


            showToast(
                error.message ||
                "Failed to update follow.",
                "error"
            );


        } finally {

            button.disabled = false;

        }
    }


    /* ============================================================
       DELETE BLOG
    ============================================================ */

    async function deleteBlog() {

        if (!USER_ID) {

            window.location.href =
                "/user/signin";

            return;
        }


        if (
            !window.confirm(
                "Delete this blog permanently?"
            )
        ) {
            return;
        }


        const button =
            $("#deleteBlogButton");


        if (button) {
            button.disabled = true;
        }


        try {

            const data = await apiRequest(
                "/blogs/" +
                encodeURIComponent(BLOG_ID),
                {
                    method: "DELETE"
                }
            );


            if (!data.success) {

                throw new Error(
                    data.message ||
                    "Failed to delete blog."
                );
            }


            window.location.href = "/";


        } catch (error) {

            console.error(
                "Blogify delete blog error:",
                error
            );


            showToast(
                error.message ||
                "Failed to delete blog.",
                "error"
            );


            if (button) {
                button.disabled = false;
            }
        }
    }


    /* ============================================================
       SHARE
    ============================================================ */

    async function shareBlog() {

        const url =
            window.location.href;


        const title =
            <%- JSON.stringify(blog.title) %>;


        try {

            if (
                navigator.share &&
                typeof navigator.share === "function"
            ) {

                await navigator.share({
                    title: title,
                    text: title,
                    url: url
                });

                return;
            }


            if (
                navigator.clipboard &&
                navigator.clipboard.writeText
            ) {

                await navigator.clipboard.writeText(
                    url
                );

                showToast(
                    "Blog link copied."
                );

                return;
            }


            window.prompt(
                "Copy this link:",
                url
            );


        } catch (error) {

            if (
                error &&
                error.name === "AbortError"
            ) {
                return;
            }


            showToast(
                "Unable to share this blog.",
                "error"
            );
        }
    }


    /* ============================================================
       EVENT DELEGATION
    ============================================================ */

    if (commentsList) {

        commentsList.addEventListener(
            "click",
            function (event) {

                const button =
                    event.target.closest(
                        "[data-action]"
                    );


                if (!button) {
                    return;
                }


                const action =
                    button.dataset.action;


                const id =
                    button.dataset.id;


                if (!id) {
                    return;
                }


                if (action === "like-comment") {

                    likeComment(
                        id,
                        button
                    );

                }


                else if (action === "reply") {

                    document
                        .querySelectorAll(
                            ".reply-composer"
                        )
                        .forEach(function (box) {
                            box.classList.remove(
                                "open"
                            );
                        });


                    const box =
                        document.getElementById(
                            "reply-box-" + id
                        );


                    if (box) {

                        box.classList.add(
                            "open"
                        );


                        const input =
                            document.getElementById(
                                "reply-input-" + id
                            );


                        if (input) {
                            input.focus();
                        }

                    }

                }


                else if (
                    action === "send-reply"
                ) {

                    postReply(id);

                }


                else if (
                    action === "edit-comment"
                ) {

                    editComment(id);

                }


                else if (
                    action === "delete-comment"
                ) {

                    deleteComment(id);

                }

            }
        );

    }


    /* ============================================================
       BUTTON EVENTS
    ============================================================ */

    if (likeButton) {

        likeButton.addEventListener(
            "click",
            toggleBlogLike
        );

    }


    const openCommentsButton =
        $("#openCommentsButton");


    const commentFab =
        $("#commentFab");


    const closeCommentsButton =
        $("#closeCommentsButton");


    if (openCommentsButton) {

        openCommentsButton.addEventListener(
            "click",
            openComments
        );

    }


    if (commentFab) {

        commentFab.addEventListener(
            "click",
            openComments
        );

    }


    if (closeCommentsButton) {

        closeCommentsButton.addEventListener(
            "click",
            closeComments
        );

    }


    if (commentsOverlay) {

        commentsOverlay.addEventListener(
            "click",
            closeComments
        );

    }


    if (reloadCommentsButton) {

        reloadCommentsButton.addEventListener(
            "click",
            function () {
                loadComments(true);
            }
        );

    }


    if (commentSend) {

        commentSend.addEventListener(
            "click",
            postComment
        );

    }


    if (commentInput) {

        commentInput.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" &&
                    (event.ctrlKey || event.metaKey)
                ) {

                    event.preventDefault();

                    postComment();
                }

            }
        );

    }


    const followButton =
        $("#followBtn");


    if (followButton) {

        followButton.addEventListener(
            "click",
            toggleFollow
        );

    }


    const deleteButton =
        $("#deleteBlogButton");


    if (deleteButton) {

        deleteButton.addEventListener(
            "click",
            deleteBlog
        );

    }


    const shareButton =
        $("#shareButton");


    if (shareButton) {

        shareButton.addEventListener(
            "click",
            shareBlog
        );

    }


    /* ============================================================
       KEYBOARD
    ============================================================ */

    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Escape") {

                closeComments();

            }

        }
    );


    /* ============================================================
       INITIALIZATION
    ============================================================ */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            /*
             * We deliberately do NOT fetch comments immediately.
             *
             * Comments are loaded when the user opens the drawer.
             * This prevents an unnecessary API call on every blog
             * page visit and makes the page resilient if comments
             * temporarily fail.
             */

            setCommentCount(0);

        }
    );


    /* ============================================================
       EXPOSE ONLY WHAT OTHER BLOGIFY CODE MAY NEED
    ============================================================ */

    window.BlogifyView = {
        openComments: openComments,
        closeComments: closeComments,
        loadComments: loadComments,
        toggleBlogLike: toggleBlogLike
    };

})();
</script>

</body>
</html>
