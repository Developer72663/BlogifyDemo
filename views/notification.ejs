<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1"><title>Notifications | Blogify</title><link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet"><style>:root{--bg:#f6f7fb;--card:#fff;--text:#172033;--muted:#738096;--line:#e6eaf1;--primary:#635bff;--soft:#efedff;--danger:#dc3545;--ok:#149b72}[data-theme=dark]{--bg:#0c0f17;--card:#151a24;--text:#f4f7fb;--muted:#98a3b5;--line:#293142;--primary:#8b84ff;--soft:#211f43}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}.top{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--card) 92%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.topin{max-width:760px;margin:auto;padding:16px;display:flex;justify-content:space-between;align-items:center}.title{font-weight:850;font-size:1.25rem;display:flex;gap:9px;align-items:center}.count{font-size:.7rem;background:var(--primary);color:#fff;border-radius:99px;padding:3px 8px}.mark{border:0;background:var(--soft);color:var(--primary);border-radius:99px;padding:9px 13px;font-weight:750}.wrap{max-width:760px;margin:auto;padding:16px}.tabs{display:flex;gap:7px;overflow:auto;margin-bottom:14px}.tab{white-space:nowrap;border:1px solid var(--line);background:var(--card);color:var(--muted);border-radius:99px;padding:8px 13px;font-weight:700}.tab.active{background:var(--primary);color:#fff;border-color:var(--primary)}.item{display:flex;gap:12px;padding:14px;border:1px solid var(--line);background:var(--card);border-radius:18px;margin-bottom:10px}.item.unread{background:var(--soft);border-color:var(--primary)}.avatar{width:48px;height:48px;border-radius:50%;object-fit:cover;flex:0 0 48px}.body{min-width:0;flex:1}.text{line-height:1.45}.text strong{color:var(--primary)}.meta{font-size:.75rem;color:var(--muted);margin-top:5px}.message-box{margin-top:10px;padding:12px;border:1px solid var(--line);border-radius:14px;background:var(--bg)}.message-content{white-space:pre-wrap;word-break:break-word}.actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}.action{border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:10px;padding:7px 11px;font-weight:750;text-decoration:none;cursor:pointer}.action.primary{background:var(--primary);border-color:var(--primary);color:#fff}.action.liked{color:#e33;background:#fff0f2;border-color:#ffc6cf}.request-actions{display:flex;gap:8px;margin-top:10px}.accept,.reject{border:0;border-radius:10px;padding:8px 13px;font-weight:800;cursor:pointer}.accept{background:var(--ok);color:#fff}.reject{background:#fee2e2;color:#b42318}.empty{text-align:center;padding:70px 20px;color:var(--muted)}.empty i{font-size:3rem;display:block;margin-bottom:10px}@media(max-width:600px){.wrap{padding:10px}.item{padding:12px}.topin{padding:13px}.title{font-size:1.05rem}}</style></head><body data-theme="<%= user && user.theme === 'dark' ? 'dark' : 'light' %>"><header class="top"><div class="topin"><div class="title"><i class="ri-notification-3-line"></i> Notifications <% if(notifications.some(n=>!n.isRead)){%><span class="count" id="count"><%=notifications.filter(n=>!n.isRead).length%></span><%}%></div><button class="mark" onclick="markAll()"><i class="ri-check-double-line"></i> Mark all read</button></div></header><main class="wrap"><div class="tabs"><button class="tab active" onclick="filterType('all',this)">All</button><button class="tab" onclick="filterType('message',this)">Messages</button><button class="tab" onclick="filterType('follow',this)">Follows</button><button class="tab" onclick="filterType('like',this)">Likes</button><button class="tab" onclick="filterType('comment',this)">Comments</button><button class="tab" onclick="filterType('blog_post',this)">Posts</button></div><section id="list"><% if(notifications&&notifications.length){notifications.forEach(n=>{const actor=n.actor;const isMessage=n.type==='message';const targetUser=actor?actor._id:'';const convo=n.conversationId||'';%><article class="item <%=n.isRead?'':'unread'%>" data-type="<%=n.type%>" data-id="<%=n._id%>"><img class="avatar" src="<%=actor&&actor.profileImageURL?actor.profileImageURL:'/imgs/default.png'%>" onerror="this.src='/imgs/default.png'" alt=""><div class="body"><div class="text"><%if(isMessage){%><strong><%=actor?actor.fullName:'Someone'%></strong> sent you a message<%}else if(n.type==='blog_post'){%><strong><%=actor?actor.fullName:'Someone'%></strong> published a new blog<%}else if(n.type==='like'){%><strong><%=actor?actor.fullName:'Someone'%></strong> liked your blog<%}else if(n.type==='comment'){%><strong><%=actor?actor.fullName:'Someone'%></strong> commented on your blog<%}else if(n.type==='reply'){%><strong><%=actor?actor.fullName:'Someone'%></strong> replied to your comment<%}else if(n.type==='follow'){%><strong><%=actor?actor.fullName:'Someone'%></strong> started following you<%}else if(n.type==='follow_request'){%><strong><%=actor?actor.fullName:'Someone'%></strong> wants to follow you<%}else{%><strong><%=actor?actor.fullName:'Someone'%></strong> mentioned you<%}%></div><div class="meta"><i class="ri-time-line"></i> <%=new Date(n.createdAt).toLocaleString()%></div><%if(isMessage){%><div class="message-box"><div class="message-content"><%=n.message||n.messageRef?.text||'New message'%></div><div class="actions"><a class="action primary" href="/messages?user=<%=targetUser%>&conversation=<%=convo%>" onclick="readNotif('<%=n._id%>')"><i class="ri-reply-line"></i> Reply</a><button class="action <%=n.messageRef&&n.messageRef.likes&&n.messageRef.likes.map(String).includes(String(user._id))?'liked':''%>" onclick="likeMessage('<%=n.messageRef?._id||''%>',this)"><i class="ri-heart-<%=n.messageRef&&n.messageRef.likes&&n.messageRef.likes.map(String).includes(String(user._id))?'fill':'line'%>"></i> Like <span><%=n.messageRef?.likes?.length||0%></span></button></div></div><%}else if(n.blog){%><div class="actions"><a class="action primary" href="/blogs/<%=n.blog._id%>" onclick="readNotif('<%=n._id%>')">View blog</a></div><%}else if(n.type==='follow_request'){%><div class="request-actions"><button class="accept" onclick="respondRequest('<%=n.request%>','accept',this)">Accept</button><button class="reject" onclick="respondRequest('<%=n.request%>','reject',this)">Reject</button></div><%}else if(actor){%><div class="actions"><a class="action" href="/user/profile/<%=actor._id%>" onclick="readNotif('<%=n._id%>')">View profile</a></div><%}%></div></article><%})}else{%><div class="empty"><i class="ri-notification-off-line"></i><h3>No notifications</h3><p>New activity will appear here.</p></div><%}%></section></main><script>async function readNotif(id){try{await fetch('/notifications/'+id+'/read',{method:'PUT'})}catch(e){}}async function markAll(){try{const r=await fetch('/notifications/all/read',{method:'PUT'});if(r.ok)location.reload()}catch(e){}}function filterType(type,btn){document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));btn.classList.add('active');document.querySelectorAll('.item').forEach(x=>x.style.display=type==='all'||x.dataset.type===type?'flex':'none')}async function likeMessage(id,btn){if(!id)return alert('This message is not available to like.');btn.disabled=true;try{const r=await fetch('/messages/'+id+'/like',{method:'POST',headers:{'Content-Type':'application/json'}});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to like');btn.classList.toggle('liked',d.liked);btn.innerHTML='<i class="ri-heart-'+(d.liked?'fill':'line')+'"></i> Like <span>'+d.likes+'</span>'}catch(e){alert(e.message)}finally{btn.disabled=false}}async function respondRequest(id,action,btn){btn.disabled=true;try{const urls=action==='accept'?['/follow/requests/'+id+'/accept','/follow/request/'+id+'/accept']:['/follow/requests/'+id+'/reject','/follow/request/'+id+'/reject'];let r;for(const u of urls){r=await fetch(u,{method:'POST'});if(r.status!==404)break}if(!r.ok)throw new Error('Unable to '+action+' request');btn.parentElement.innerHTML='<span style="color:var(--muted);font-weight:700">Request '+(action==='accept'?'accepted':'rejected')+'</span>'}catch(e){btn.disabled=false;alert(e.message)}}</script></body></html>