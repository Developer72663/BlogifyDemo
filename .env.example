# Runtime
NODE_ENV=production
PORT=8000
APP_URL=https://your-production-domain.example
FRONTEND_URL=https://your-production-domain.example
SOCKET_URL=https://your-realtime-server.example

# Database
MONGODB_URI=mongodb+srv://...
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=0

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
RESET_PASSWORD_SECRET=replace-with-a-different-long-random-secret
OTP_SECRET=replace-with-a-different-long-random-secret
BCRYPT_ROUNDS=12

# Distributed rate limiting / OTP infrastructure
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# OAuth / email / media / push variables used by the application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Email
# HTTPS provider (recommended for Render Free). If set, it takes priority over SMTP.
RESEND_API_KEY=
EMAIL_FROM=Blogify <noreply@your-verified-domain.example>

# Existing SMTP configuration (useful on Render paid services or other hosts that allow SMTP egress).
EMAIL_USER=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
